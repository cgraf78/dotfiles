// Append-only exact bindings retired by focus-aware routing migrations.
//
// Keep these records indefinitely. They are source-only retirement directives,
// not active shortcuts: the merge hook strips "dotfiles.retire" before matching
// and never writes the records to VS Code. Co-locating this history with the
// binding sources keeps the retirement logic free of Termnav keys, commands,
// platform lists, or focus-policy knowledge.
//
// Match the complete historical object, including args and any extra fields.
// Never add a merely similar binding: exactness is what prevents this deletion
// authority from consuming an independent local shortcut. Tests require every
// addition to have existed in prior landed active source, proving that dotfiles
// owned the exact object before granting deletion authority. Sealed
// dotfiles.retire-proof labels cover the review build known to have reached
// live profiles before landing and the two legacy local tab handlers recorded
// by PR #45; the development-time history guard locks each proof to its exact
// objects while runtime parsing allowlists only their labels.
[
  {
    "key": "ctrl+p",
    "command": "workbench.action.quickOpen",
    "when": "terminalFocus",
    "dotfiles.retire": true
  },
  {
    "key": "ctrl+v",
    "command": "workbench.action.terminal.paste",
    "when": "terminalFocus",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+a",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0001" },
    "when": "terminalFocus",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+b",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0002" },
    "when": "terminalFocus",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+l",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000c" },
    "when": "terminalFocus",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+n",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000e" },
    "when": "terminalFocus",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+p",
    "command": "workbench.action.quickOpen",
    "when": "terminalFocus",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+r",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0012" },
    "when": "terminalFocus",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+u",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0015" },
    "when": "terminalFocus",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+v",
    "command": "workbench.action.terminal.paste",
    "when": "terminalFocus",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+w",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0017" },
    "when": "terminalFocus",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+z",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001a" },
    "when": "terminalFocus",
    "dotfiles.retire": true
  },

  // Native editor defaults now remain untouched, while common focus policy
  // adds only positively gated terminal routes. Keeping the earlier exact
  // forms here removes synchronized copies on every variant.
  {
    "key": "ctrl+shift+tab",
    "command": "workbench.action.quickOpenLeastRecentlyUsedEditorInGroup",
    "when": "!activeEditorGroupEmpty && !terminalFocus",
    "dotfiles.retire": true
  },
  {
    "key": "ctrl+shift+tab",
    "command": "-workbench.action.quickOpenLeastRecentlyUsedEditorInGroup",
    "when": "!activeEditorGroupEmpty",
    "dotfiles.retire": true
  },
  {
    "key": "ctrl+tab",
    "command": "workbench.action.quickOpenPreviousRecentlyUsedEditorInGroup",
    "when": "!activeEditorGroupEmpty && !terminalFocus",
    "dotfiles.retire": true
  },
  {
    "key": "ctrl+tab",
    "command": "-workbench.action.quickOpenPreviousRecentlyUsedEditorInGroup",
    "when": "!activeEditorGroupEmpty",
    "dotfiles.retire": true
  },
  {
    "key": "ctrl+tab",
    "command": "workbench.action.quickOpenNavigateNextInEditorPicker",
    "when": "inEditorsPicker && inQuickOpen && !terminalFocus",
    "dotfiles.retire": true
  },
  {
    "key": "ctrl+tab",
    "command": "-workbench.action.quickOpenNavigateNextInEditorPicker",
    "when": "inEditorsPicker && inQuickOpen",
    "dotfiles.retire": true
  },
  {
    "key": "ctrl+shift+tab",
    "command": "workbench.action.quickOpenNavigatePreviousInEditorPicker",
    "when": "inEditorsPicker && inQuickOpen && !terminalFocus",
    "dotfiles.retire": true
  },
  {
    "key": "ctrl+shift+tab",
    "command": "-workbench.action.quickOpenNavigatePreviousInEditorPicker",
    "when": "inEditorsPicker && inQuickOpen",
    "dotfiles.retire": true
  },
  {
    "key": "ctrl+tab",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[9;5u" },
    "when": "terminalFocus",
    "dotfiles.retire": true
  },
  {
    "key": "ctrl+shift+tab",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[9;6u" },
    "when": "terminalFocus",
    "dotfiles.retire": true
  },

  {
    "key": "ctrl+b",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0002" },
    "when": "terminalFocus && termnav.nvimFocused",
    "dotfiles.retire": true
  },

  // Exact forms replaced while restoring terminal-native controls and making
  // the Ctrl+backtick host routes disjoint from focused Neovim.
  {
    "key": "ctrl+`",
    "command": "workbench.action.terminal.focus",
    "when": "terminalIsOpen",
    "dotfiles.retire": true
  },
  {
    "key": "ctrl+`",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus && terminalIsOpen",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+r",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0012" },
    "when": "terminalFocus && termnav.nvimFocused",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+b",
    "command": "-workbench.action.toggleSidebarVisibility",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+b",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "terminalFocus && !termnav.nvimFocused",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+b",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0002" },
    "when": "terminalFocus && termnav.nvimFocused",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+a",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0001" },
    "when": "terminalFocus && termnav.nvimFocused",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+l",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000c" },
    "when": "terminalFocus && termnav.nvimFocused",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+n",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000e" },
    "when": "terminalFocus && termnav.nvimFocused",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+u",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0015" },
    "when": "terminalFocus && termnav.nvimFocused",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+w",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0017" },
    "when": "terminalFocus && termnav.nvimFocused",
    "dotfiles.retire": true
  },
  {
    "key": "cmd+z",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001a" },
    "when": "terminalFocus && termnav.nvimFocused",
    "dotfiles.retire": true
  },

  // PR #90 was exercised against live profiles before its negative host
  // fallbacks were removed. This sealed proof label is accepted only for the
  // exact review generation; tests lock both its value and canonical contents.
  {
    "key": "ctrl+.",
    "command": "editor.action.quickFix",
    "when": "terminalFocus && !termnav.nvimFocused",
    "dotfiles.retire": true,
    "dotfiles.retire-proof": "review-build:7030e8e"
  },
  {
    "key": "ctrl+/",
    "command": "editor.action.commentLine",
    "when": "terminalFocus && !termnav.nvimFocused",
    "dotfiles.retire": true,
    "dotfiles.retire-proof": "review-build:7030e8e"
  },
  {
    "key": "ctrl+\\",
    "command": "workbench.action.splitEditor",
    "when": "terminalFocus && !termnav.nvimFocused",
    "dotfiles.retire": true,
    "dotfiles.retire-proof": "review-build:7030e8e"
  },
  {
    "key": "ctrl+shift+e",
    "command": "workbench.view.explorer",
    "when": "terminalFocus && !termnav.nvimFocused",
    "dotfiles.retire": true,
    "dotfiles.retire-proof": "review-build:7030e8e"
  },
  {
    "key": "ctrl+shift+f",
    "command": "workbench.view.search",
    "when": "terminalFocus && !termnav.nvimFocused",
    "dotfiles.retire": true,
    "dotfiles.retire-proof": "review-build:7030e8e"
  },
  {
    "key": "ctrl+shift+m",
    "command": "workbench.actions.view.problems",
    "when": "terminalFocus && !termnav.nvimFocused",
    "dotfiles.retire": true,
    "dotfiles.retire-proof": "review-build:7030e8e"
  },
  {
    "key": "ctrl+shift+p",
    "command": "workbench.action.showCommands",
    "when": "terminalFocus && !termnav.nvimFocused",
    "dotfiles.retire": true,
    "dotfiles.retire-proof": "review-build:7030e8e"
  },
  {
    "key": "shift+cmd+f",
    "command": "workbench.view.search",
    "when": "terminalFocus && !termnav.nvimFocused",
    "dotfiles.retire": true,
    "dotfiles.retire-proof": "review-build:7030e8e"
  },
  {
    "key": "shift+cmd+p",
    "command": "workbench.action.showCommands",
    "when": "terminalFocus && !termnav.nvimFocused",
    "dotfiles.retire": true,
    "dotfiles.retire-proof": "review-build:7030e8e"
  },
  {
    "key": "ctrl+shift+v",
    "command": "workbench.action.terminal.paste",
    "when": "terminalFocus && !termnav.nvimFocused",
    "dotfiles.retire": true,
    "dotfiles.retire-proof": "review-build:7030e8e"
  },
  {
    "key": "ctrl+shift+v",
    "command": "editor.action.clipboardPasteAction",
    "when": "textInputFocus && !editorReadonly && !terminalFocus",
    "dotfiles.retire": true,
    "dotfiles.retire-proof": "review-build:7030e8e"
  },
  {
    "key": "cmd+/",
    "command": "editor.action.commentLine",
    "when": "terminalFocus && !termnav.nvimFocused",
    "dotfiles.retire": true,
    "dotfiles.retire-proof": "review-build:7030e8e"
  },

  // PR #45 recorded these exact local handlers because they competed with the
  // managed terminal-tab bridge. They are intentionally obsolete everywhere:
  // the positive bridge owns focused Neovim, while native VS Code owns shell,
  // non-Neovim, and adapter-absent states. This is explicit deletion authority
  // over the known local pair, not a general rule for similar user bindings.
  {
    "key": "ctrl+tab",
    "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus",
    "dotfiles.retire": true,
    "dotfiles.retire-proof": "legacy-local:280f7f8"
  },
  {
    "key": "ctrl+shift+tab",
    "command": "workbench.action.terminal.focusPrevious",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus",
    "dotfiles.retire": true,
    "dotfiles.retire-proof": "legacy-local:280f7f8"
  }
]
