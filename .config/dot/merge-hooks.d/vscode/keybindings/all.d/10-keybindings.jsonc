// Common VS Code keybindings (all platforms).
//
// Put baseline workbench/client policy here. A terminal-owned chord that must
// reach the pty whenever terminalFocus is true also belongs here and must not
// depend on Termnav. Do not add a sendSequence merely because Neovim maps the
// key: if normal VS Code/xterm resolution already transports it correctly,
// leave it unmanaged. Neovim-only overrides belong in 20-nvim-focus.jsonc;
// platform translations of either policy belong under <platform>.d/.
[
  // Goto line
  {
    "key": "alt+g",
    "command": "workbench.action.gotoLine"
  },

  // Find-related stuff
  {
    "key": "enter",
    "command": "-editor.action.nextMatchFindAction",
    "when": "editorFocus && findInputFocussed"
  },
  {
    "key": "enter",
    "command": "extension.multiCommand.execute",
    "args": { "command": "multiCommand.focusEditor" },
    "when": "editorFocus && findInputFocussed"
  },

  // Terminal stuff
  {
    "key": "ctrl+`",
    "command": "workbench.action.terminal.focus",
    "when": "terminalIsOpen && !terminalFocus"
  },
  {
    "key": "ctrl+`",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus && terminalIsOpen && !termnav.nvimFocused"
  },
  {
    "key": "ctrl+`",
    "command": "-workbench.action.terminal.toggleTerminal",
    "when": "terminal.active"
  },
  {
    "key": "ctrl+shift+`",
    "command": "-workbench.action.terminal.new",
    "when": "terminalProcessSupported || terminalWebExtensionContributedProfile"
  },
  // The VS Code client owns its clipboard even when the pty is remote. Keep
  // Ctrl+C as the terminal interrupt unless xterm.js has an actual selection;
  // tmux copy-mode selections are not xterm.js selections and still receive
  // the key for tmux's OSC 52 path.
  {
    "key": "ctrl+c",
    "command": "workbench.action.terminal.copySelection",
    "when": "terminalFocus && terminalTextSelected"
  },
  // These are terminal-native controls and must reach the pty in every terminal
  // pane, including shells and extensionless variants. VS Code keeps its normal
  // sidebar and editor-tab shortcuts whenever terminal focus is absent. Ctrl+J
  // is deliberately absent: sendSequence normalizes its LF byte to CR, so the
  // commandsToSkipShell exception in settings lets xterm encode it natively.
  {
    "key": "ctrl+b",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0002" },
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+h",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0008" },
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000b" },
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000c" },
    "when": "terminalFocus"
  },
  // Ctrl+backslash is tmux/Neovim's local previous-pane operation. VS Code's
  // default split-editor shortcut would otherwise consume it before xterm.js.
  // Scope the override to terminal focus so the editor keeps its native split
  // command, and use the legacy C0 file-separator byte that WezTerm and tmux
  // already recognize without a terminal-specific protocol.
  {
    "key": "ctrl+\\",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001c" },
    "when": "terminalFocus"
  },
  // Legacy terminal protocols encode Ctrl+/ as Ctrl-_ (US, 0x1f). Neovim
  // maps both spellings so this remains useful without the Termnav sensor and
  // keeps its conventional readline undo meaning in ordinary shells.
  {
    "key": "ctrl+/",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001f" },
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+tab",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[9;5u" },
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+shift+tab",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[9;6u" },
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+v",
    "command": "workbench.action.terminal.paste",
    "when": "terminalFocus && !termnav.nvimFocused"
  },

  // Diff stuff
  {
    "key": "f8",
    "command": "-editor.action.marker.nextInFiles",
    "when": "editorFocus"
  },
  {
    "key": "f7",
    "command": "-editor.action.diffReview.next",
    "when": "isInDiffEditor"
  },
  {
    "key": "f7",
    "command": "-editor.action.wordHighlight.next",
    "when": "editorTextFocus && hasWordHighlights"
  },
  {
    "key": "f8",
    "command": "workbench.action.compareEditor.nextChange",
    "when": "textCompareEditorVisible"
  },
  {
    "key": "alt+f5",
    "command": "-workbench.action.compareEditor.nextChange",
    "when": "textCompareEditorVisible"
  },
  {
    "key": "f7",
    "command": "workbench.action.compareEditor.previousChange",
    "when": "textCompareEditorVisible"
  },
  {
    "key": "shift+alt+f5",
    "command": "-workbench.action.compareEditor.previousChange",
    "when": "textCompareEditorVisible"
  },

  // Tab moves stop at the tmux layer: VS Code has no command to reorder
  // integrated-terminal tabs.
  {
    "key": "alt+shift+[",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b{" },
    "when": "terminalFocus"
  },
  {
    "key": "alt+shift+]",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b}" },
    "when": "terminalFocus"
  },
  {
    "key": "alt+shift+[",
    "command": "workbench.action.moveEditorLeftInGroup",
    "when": "!terminalFocus"
  },
  {
    "key": "alt+shift+]",
    "command": "workbench.action.moveEditorRightInGroup",
    "when": "!terminalFocus"
  },
  {
    "key": "alt+m",
    "command": "workbench.action.toggleLightDarkThemes"
  },

  // Shift+Enter in terminal: send Alt+Enter (ESC + newline) for Claude Code newline
  {
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b\n" },
    "when": "terminalFocus"
  },

  // Ctrl+P opens the host picker unless nvim owns the focused terminal pane.
  {
    "key": "ctrl+p",
    "command": "workbench.action.quickOpen",
    "when": "terminalFocus && !termnav.nvimFocused"
  }
]
