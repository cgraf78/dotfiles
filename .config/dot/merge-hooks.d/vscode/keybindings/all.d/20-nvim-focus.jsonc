    "args": { "text": "\u0019" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+z",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001a" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+/",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001f" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+`",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0000" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+.",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[46;5u" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+shift+g",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[103;6u" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+shift+v",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[118;6u" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+left",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;5D" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+right",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;5C" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+up",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;5A" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
