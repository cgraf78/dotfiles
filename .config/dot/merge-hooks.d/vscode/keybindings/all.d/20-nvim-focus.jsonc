// Pass VS Code-style chords through only while Termnav proves that the active
// terminal and tmux pane are owned by nvim. Missing or expired context leaves
// the normal VS Code command active.
[
  {
    "key": "ctrl+a",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0001" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+b",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0002" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+c",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0003" },
    "when": "terminalFocus && termnav.nvimFocused && !terminalTextSelected"
  },
  {
    "key": "ctrl+d",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0004" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+e",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0005" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+f",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0006" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+g",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0007" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+h",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0008" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+i",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0009" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000a" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000b" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000c" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+m",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000d" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+n",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000e" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+o",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000f" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+p",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0010" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+q",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0011" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+r",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0012" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+s",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0013" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+t",
    "command": "workbench.action.terminal.sendSequence",
