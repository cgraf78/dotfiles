// Pass VS Code-style chords through only while Termnav proves that the active
// terminal and tmux pane are owned by nvim. Terminal-native tmux controls live
// in common policy instead of depending on this lease.
[
  {
    "key": "ctrl+a",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0001" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+c",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0003" },
    "when": "terminalFocus && termnav.nvimFocused && !terminalTextSelected"
  },
  {
    "key": "ctrl+d",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0004" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+e",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0005" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+f",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0006" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+g",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0007" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+i",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0009" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+m",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000d" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+n",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000e" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+o",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000f" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+p",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0010" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+q",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0011" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+r",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0012" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+s",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0013" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+t",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0014" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+u",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0015" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+v",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0016" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+w",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0017" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+x",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0018" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+y",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0019" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+z",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001a" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+/",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001f" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+`",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0000" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  // Ctrl+\ is Neovim's terminal-mode escape prefix. Keep VS Code's normal
  // editor-split ownership outside Neovim, but deliver the C0 file separator
  // while Neovim owns the pane so terminal escape sequences remain usable.
  {
    "key": "ctrl+\\",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001c" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+.",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[46;5u" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  // Shifted letters need CSI-u rather than their plain Ctrl C0 bytes. CSI-u
  // preserves Shift so Neovim can distinguish its VS Code-style Explorer,
  // Search, Problems, and Command Palette maps from Ctrl+E/F/M/P. The numeric
  // key codes are lowercase ASCII and modifier value 6 means Ctrl+Shift.
  {
    "key": "ctrl+shift+e",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[101;6u" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+shift+f",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[102;6u" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+shift+g",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[103;6u" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+shift+m",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[109;6u" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+shift+p",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[112;6u" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+shift+v",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[118;6u" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  // VS Code normally owns Shift+PageUp/Down for terminal viewport scrolling.
  // While Neovim owns the pane, pass the xterm sequences through so its
  // VSCode-style page-selection mappings remain reachable.
  {
    "key": "shift+pageup",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[5;2~" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "shift+pagedown",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[6;2~" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+left",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;5D" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+right",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;5C" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+up",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;5A" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+down",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;5B" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+shift+left",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;6D" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+shift+right",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;6C" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+shift+up",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;6A" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "ctrl+shift+down",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;6B" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "alt+up",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;3A" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "alt+down",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;3B" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "shift+alt+up",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;4A" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "shift+alt+down",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;4B" },
    "when": "terminalFocus && termnav.nvimFocused"
  }
]
