// macOS/Karabiner transport adapters plus genuinely macOS-only workbench
// policy. This file does not choose ownership independently: mirror the common
// classification. A translated terminal-owned chord uses plain terminalFocus;
// a translated Neovim-only override keeps the positive Termnav gate; a chord
// that Karabiner exempts and xterm already transports needs no entry here.
// Common keybindings live in vscode/keybindings/all.d/.
[
  // Remap redo to Cmd+Y (Windows-style), move omni-search to Alt+Y
  {
    "key": "alt+y",
    "command": "omni-search-ui:quick-search"
  },
  {
    "key": "cmd+y",
    "command": "-omni-search-ui:quick-search"
  },
  {
    "key": "cmd+y",
    "command": "redo"
  },
  {
    "key": "shift+cmd+z",
    "command": "-redo"
  },

  // Remove default reopen-closed-editor, use for new terminal
  {
    "key": "shift+cmd+t",
    "command": "-workbench.action.reopenClosedEditor"
  },
  {
    "key": "shift+cmd+t",
    "command": "workbench.action.terminal.new",
    "when": "terminalProcessSupported || terminalWebExtensionContributedProfile"
  },

  {
    "key": "f11",
    "command": "workbench.action.toggleFullScreen",
    "when": "!isIOS"
  },

  // Karabiner exempts VS Code from Ctrl+Arrow rewrites so the integrated
  // terminal receives raw Ctrl+Arrow sequences. Restore the editor-side word
  // movement that used to come from Ctrl+Arrow -> Option+Arrow.
  {
    "key": "ctrl+left",
    "command": "cursorWordStartLeft",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+right",
    "command": "cursorWordEndRight",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+left",
    "command": "cursorWordStartLeftSelect",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+right",
    "command": "cursorWordEndRightSelect",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+up",
    "command": "cursorUpSelect",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+down",
    "command": "cursorDownSelect",
    "when": "editorTextFocus"
  },

  // Cmd+R → Ctrl+R in terminal (bash reverse-search)
  {
    "key": "cmd+r",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0012" },
    "when": "terminalFocus"
  },

  // Find prev/next (Cmd variants)
  {
    "key": "cmd+shift+g",
    "command": "-workbench.view.scm"
  },
  {
    "key": "cmd+shift+g",
    "command": "editor.action.previousMatchFindAction",
    "when": "editorFocus"
  },

  // Karabiner owns Windows-style physical remapping and translates Ctrl+key
  // to Cmd+key. Shell and tmux controls must remain terminal-native even when
  // Termnav is unavailable; VS Code's normal Cmd bindings remain active when
  // the terminal is not focused.
  {
    "key": "cmd+b",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0002" },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+a",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0001" },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+c",
    "command": "workbench.action.terminal.copySelection",
    "when": "terminalFocus && terminalTextSelected"
  },
  {
    "key": "cmd+c",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0003" },
    "when": "terminalFocus && !terminalTextSelected"
  },
  {
    "key": "cmd+l",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000c" },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+n",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000e" },
    "when": "terminalFocus"
  },
  // Ctrl+P (seen as Cmd+P via Karabiner) keeps host behavior outside nvim.
  {
    "key": "cmd+p",
    "command": "workbench.action.quickOpen",
    "when": "terminalFocus && !termnav.nvimFocused"
  },
  // Karabiner translates physical Ctrl+Shift+F/P to Cmd+Shift+F/P. Add only
  // the focused Neovim overrides; normal VS Code bindings remain untouched.
  {
    "key": "shift+cmd+f",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[102;6u" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "shift+cmd+p",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[112;6u" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  // Karabiner transports physical Ctrl+Shift+V as F20 so Neovim can
  // distinguish yank history from plain Ctrl+V without consuming VS Code's
  // native Shift+Cmd+V. Reconstruct paste outside focused Neovim.
  {
    "key": "f20",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[118;6u" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "f20",
    "command": "workbench.action.terminal.paste",
    "when": "terminalFocus && !termnav.nvimFocused"
  },
  {
    "key": "f20",
    "command": "editor.action.clipboardPasteAction",
    "when": "textInputFocus && !editorReadonly && !terminalFocus"
  },
  {
    "key": "cmd+u",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0015" },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+v",
    "command": "workbench.action.terminal.paste",
    "when": "terminalFocus && !termnav.nvimFocused"
  },
  {
    "key": "cmd+w",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0017" },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+z",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001a" },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+f",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0006" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+g",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0007" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+i",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0009" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+o",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000f" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+p",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0010" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+s",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0013" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+t",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0014" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+v",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0016" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+x",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0018" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+y",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0019" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  // Karabiner translates physical Ctrl+/ to Cmd+/. Restore the conventional
  // terminal Ctrl-_ byte under terminal focus; editor Cmd+/ remains native.
  {
    "key": "cmd+/",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001f" },
    "when": "terminalFocus"
  },
  {
    "key": "shift+cmd+g",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[103;6u" },
    "when": "terminalFocus && termnav.nvimFocused"
  }
]
