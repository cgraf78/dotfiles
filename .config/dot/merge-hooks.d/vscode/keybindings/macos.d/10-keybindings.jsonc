// macOS-specific VS Code keybindings.
// Common keybindings live in vscode/keybindings/all.d/.
[
  // Remap redo to Cmd+Y (Windows-style), move omni-search to Alt+Y
  {
    "key": "alt+y",
    "command": "omni-search-ui:quick-search"
  },
  {
    "key": "cmd+y",
    "command": "-omni-search-ui:quick-search"
  },
  {
    "key": "cmd+y",
    "command": "redo"
  },
  {
    "key": "shift+cmd+z",
    "command": "-redo"
  },

  // Remove default reopen-closed-editor, use for new terminal
  {
    "key": "shift+cmd+t",
    "command": "-workbench.action.reopenClosedEditor"
  },
  {
    "key": "shift+cmd+t",
    "command": "workbench.action.terminal.new",
    "when": "terminalProcessSupported || terminalWebExtensionContributedProfile"
  },

  {
    "key": "f11",
    "command": "workbench.action.toggleFullScreen",
    "when": "!isIOS"
  },

  // Karabiner exempts VS Code from Ctrl+Arrow rewrites so the integrated
  // terminal receives raw Ctrl+Arrow sequences. Restore the editor-side word
  // movement that used to come from Ctrl+Arrow -> Option+Arrow.
  {
    "key": "ctrl+left",
    "command": "cursorWordStartLeft",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+right",
    "command": "cursorWordEndRight",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+left",
    "command": "cursorWordStartLeftSelect",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+right",
    "command": "cursorWordEndRightSelect",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+up",
    "command": "cursorUpSelect",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+down",
    "command": "cursorDownSelect",
    "when": "editorTextFocus"
  },

  // Cmd+R → Ctrl+R in terminal (bash reverse-search)
  {
    "key": "cmd+r",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0012" },
    "when": "terminalFocus && termnav.nvimFocused"
  },

  // Find prev/next (Cmd variants)
  {
    "key": "cmd+shift+g",
    "command": "-workbench.view.scm"
  },
  {
    "key": "cmd+shift+g",
    "command": "editor.action.previousMatchFindAction",
    "when": "editorFocus"
  },

  // Remove the unconditional Cmd+B sidebar toggle; restore it outside nvim.
  {
    "key": "cmd+b",
    "command": "-workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "cmd+b",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "terminalFocus && !termnav.nvimFocused"
  },

  // Karabiner owns Windows-style physical remapping and translates Ctrl+key
  // to Cmd+key. VS Code only resolves terminal context that Karabiner cannot
  // see: most chords send raw Ctrl characters, while clipboard chords stay
  // with the local client.
  {
    "key": "cmd+b",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0002" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+a",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0001" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+c",
    "command": "workbench.action.terminal.copySelection",
    "when": "terminalFocus && terminalTextSelected"
  },
  {
    "key": "cmd+c",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0003" },
    "when": "terminalFocus && !terminalTextSelected"
  },
  {
    "key": "cmd+l",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000c" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+n",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000e" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  // Ctrl+P (seen as Cmd+P via Karabiner) keeps host behavior outside nvim.
  {
    "key": "cmd+p",
    "command": "workbench.action.quickOpen",
    "when": "terminalFocus && !termnav.nvimFocused"
  },
  // Karabiner translates physical Ctrl+Shift+F/P to Cmd+Shift+F/P before VS
  // Code resolves them. Mirror both halves of the common focus policy under
  // those translated spellings. Cross-layer tests pin the Karabiner contract
  // because correct VS Code rules are useless if the keyboard layer drifts.
  {
    "key": "shift+cmd+f",
    "command": "workbench.view.search",
    "when": "terminalFocus && !termnav.nvimFocused"
  },
  {
    "key": "shift+cmd+f",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[102;6u" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "shift+cmd+p",
    "command": "workbench.action.showCommands",
    "when": "terminalFocus && !termnav.nvimFocused"
  },
  {
    "key": "shift+cmd+p",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[112;6u" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+u",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0015" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+v",
    "command": "workbench.action.terminal.paste",
    "when": "terminalFocus && !termnav.nvimFocused"
  },
  // Plain Ctrl+V, Ctrl+Shift+V, and native Cmd+Shift+V are three different
  // actions. Karabiner deliberately keeps physical Ctrl+Shift+V raw so VS Code
  // can route paste versus Neovim yank history without stealing macOS
  // Cmd+Shift+V (Markdown Preview). The common focus rule owns the nvim half.
  {
    "key": "ctrl+shift+v",
    "command": "workbench.action.terminal.paste",
    "when": "terminalFocus && !termnav.nvimFocused"
  },
  // Before this chord became raw, Karabiner emitted Cmd+V, which pasted in
  // writable VS Code inputs. Preserve that Windows-style behavior only where
  // paste is meaningful; narrower context avoids consuming the chord in
  // readonly views or unrelated workbench surfaces.
  {
    "key": "ctrl+shift+v",
    "command": "editor.action.clipboardPasteAction",
    "when": "textInputFocus && !editorReadonly && !terminalFocus"
  },
  {
    "key": "cmd+w",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0017" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+z",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001a" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+f",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0006" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+g",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0007" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+i",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0009" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+o",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000f" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+p",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0010" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+s",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0013" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+t",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0014" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+v",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0016" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+x",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0018" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "cmd+y",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0019" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  // Karabiner translates physical Ctrl+/ to Cmd+/. Restore the C0 unit
  // separator that Neovim recognizes as Ctrl+/ only while it owns the pane;
  // otherwise invoke the same Toggle Line Comment action explicitly because
  // VS Code's editor-only default is inactive while the terminal has focus.
  {
    "key": "cmd+/",
    "command": "editor.action.commentLine",
    "when": "terminalFocus && !termnav.nvimFocused"
  },
  {
    "key": "cmd+/",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001f" },
    "when": "terminalFocus && termnav.nvimFocused"
  },
  {
    "key": "shift+cmd+g",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[103;6u" },
    "when": "terminalFocus && termnav.nvimFocused"
  }
]
