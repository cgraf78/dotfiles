{
  "[python]": {
    "editor.tabSize": 4
  },
  "C_Cpp.commentContinuationPatterns": ["// ", "/**"],
  "C_Cpp.suggestSnippets": false,
  "accessibility.openChatEditedFiles": false,
  "accessibility.signals.terminalBell": {
    "sound": "on"
  },
  "bashIde.globPattern": "**/*@(.sh|.inc|.bash|.zsh|.command)",
  "bashIde.includeAllWorkspaceSymbols": true,
  "bashIde.shfmt.path": "",
  "cSpell.diagnosticLevel": "Hint",
  "debug.saveBeforeStart": "nonUntitledEditorsInActiveGroup",
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.copyWithSyntaxHighlighting": false,
  "editor.fontFamily": "JetBrainsMono Nerd Font, FiraCode Nerd Font, MesloLGM Nerd Font Mono, monospace",
  "editor.fontSize": 11,
  "editor.guides.bracketPairs": "active",
  "editor.indentSize": "tabSize",
  "editor.inlineSuggest.allowSuggestOnTriggerCharacters": true,
  "editor.letterSpacing": 0.2,
  "editor.lightbulb.enabled": "on",
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.rulers": [100],
  "editor.scrollBeyondLastLine": false,
  "editor.stickyScroll.enabled": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.tabSize": 2,
  "emmet.showAbbreviationSuggestions": false,
  "emmet.showExpandedAbbreviation": "never",
  "files.associations": {
    "**/.config/checkrun/*ignore*": "ignore",
    "**/.config/dot/merge-hooks.d/ignore*": "ignore",
    "**/.config/git/ignore": "ignore",
    "**/.fdignore": "ignore",
    "**/.ignore": "ignore",
    "**/.rgignore": "ignore"
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "multiCommand.commands": [
    {
      "command": "multiCommand.focusEditor",
      "sequence": ["workbench.action.focusActiveEditorGroup"]
    },
    {
      "command": "multiCommand.findNextAndFocusEditor",
      "sequence": ["editor.action.nextMatchFindAction", "workbench.action.focusActiveEditorGroup"]
    }
  ],
  "search.smartCase": true,
  "search.useGlobalIgnoreFiles": true,
  "settingsSync.ignoredSettings": [
    "evenBetterToml.schema.associations",
    "json.schemas",
    "vscode-mcp-server.authToken",
    "window.title",
    "yaml.schemas"
  ],
  "sleyTools.diagnosticExclude": [
    ".vscode/extensions/**",
    ".vscode-server/**",
    "Downloads/**",
    "**/node_modules/**"
  ],
  "terminal.explorerKind": "external",
  "terminal.external.osxExec": "WezTerm.app",
  "terminal.integrated.commandsToSkipShell": ["-workbench.action.togglePanel"],
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.defaultProfile.windows": "WSL",
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font, FiraCode Nerd Font, MesloLGM Nerd Font Mono, monospace",
  "terminal.integrated.fontSize": 11,
  "terminal.integrated.letterSpacing": 0,
  "terminal.integrated.profiles.linux": {
    "zsh": {
      "args": ["-l"],
      "path": "zsh"
    },
    "bash": {
      "args": ["-l"],
      "icon": "terminal-bash",
      "path": "bash"
    }
  },
  "terminal.integrated.profiles.osx": {
    "zsh": {
      "args": ["-l"],
      "path": "zsh"
    },
    "bash": {
      "args": ["-l"],
      "icon": "terminal-bash",
      "path": "bash"
    }
  },
  "terminal.integrated.profiles.windows": {
    "WSL": {
      "icon": "terminal-bash",
      "path": "wsl.exe"
    },
    "Command Prompt": {
      "icon": "terminal-cmd",
      "path": "cmd.exe"
    },
    "PowerShell": {
      "icon": "terminal-powershell",
      "path": "pwsh.exe"
    }
  },
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.shellIntegration.history": 10000,
  "terminal.integrated.systemd.shouldUse": true,
  "trailing-spaces.deleteModifiedLinesOnly": true,
  "trailing-spaces.trimOnSave": true,
  "vsicons.dontShowNewVersionMessage": true,
  "window.nativeTabs": true,
  "window.openNewWindowsInNativeTabs": true,
  "window.restoreWindows": "all",
  "workbench.colorTheme": "Night Owl (No Italics)",
  "workbench.editor.enablePreview": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.labelFormat": "default",
  "workbench.iconTheme": "vscode-icons",
  "workbench.panel.defaultLocation": "left",
  "workbench.preferredDarkColorTheme": "Night Owl (No Italics)",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.startupEditor": "none"
}
