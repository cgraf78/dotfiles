{
  "repos": [
    {
      "match": {
        "remotes": [
          "https://github.com/cgraf78/dotfiles.git",
          "git@github.com:cgraf78/dotfiles.git"
        ]
      },
      "rules": [
        {
          "enabled": false,
          "paths": ["*"],
          "commands": [
            {
              "cmd": "env -u GIT_DIR -u GIT_WORK_TREE -u SLEY_SKIP_UNTRACKED dot test",
              "kind": "test",
              "required": true,
              "tier": "fast",
              "cache": {
                "enabled": true,
                "salt": "dot-suite-all-tracked-v2",
                "identity": {
                  "commands": ["git ls-files"]
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
