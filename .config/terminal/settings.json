{
  "font": {
    "family": "JetBrainsMono Nerd Font",
    "weight": "Light",
    "postscript_name": "JetBrainsMonoNF-Light"
  },
  "macos_font_size": 11,
  "initial_cols": 140,
  "initial_rows": 36,
  "color_scheme": "Night Owl (Gogh)",
  "colors": {
    "background": "#011627",
    "foreground": "#d6deeb",
    "cursor_bg": "#d6deeb",
    "cursor_border": "#d6deeb",
