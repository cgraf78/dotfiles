# Files autoformat should skip while leaving autolint phases available.
#
# Pattern semantics match `ignore`: bash globs against the absolute file path,
# no `**`, no negations.

# Karabiner-Elements owns the native JSON shape. Reformatting either the live
# file or its merge source creates churn the next time the app saves it.
*/karabiner.json
*/.config/dot/merge-hooks.d/karabiner/profiles.d/*.json

# Generated by `mise lock`; contains per-platform checksums + URLs in
# a specific order. Running taplo over it re-emits differently and
# would churn on every lockfile refresh.
*/mise.lock

# Pinned public schema payloads are vendored runtime data. Keep schema/parser
# validation available, but avoid reformatting upstream payloads.
*/.local/share/checkrun/schemas/*.schema.json

# iTerm2 dynamic-profile file — iTerm reads this to configure the terminal.
# Reformatting could change key order in ways iTerm doesn't like.
*/iterm2-dotfiles-dyn-profile.json

# Checkrun JSON policy files are validated through schema associations. Running
# Biome over them can report nested-root errors because biome.json lives in this
# same policy directory.
*/.config/checkrun/*.json

# Managed by agent CLIs. These tools rewrite settings/config files on their own
# schedule, so any format we impose gets clobbered on next tool startup.
*/.claude/settings.json
*/.codex/config.toml
*/.gemini/settings.json

# Claude Code slash-command files are structured markdown with a front-matter
# metadata block. Formatting would be cosmetic churn.
*/.claude/commands/*
