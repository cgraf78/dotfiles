[core]
	pager = delta
	editor = nvim
	excludesFile = ~/.config/git/ignore
	untrackedcache = true
	hooksPath = ~/.local/lib/dot/git-hooks

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = false
	line-numbers = true
	dark = true
	hyperlinks = true

[diff]
	algorithm = histogram
	colorMoved = default

[merge]
	conflictstyle = zdiff3

[fetch]
	prune = true

[push]
	default = simple
	autoSetupRemote = true

[pull]
	rebase = true

[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true

[branch]
	sort = -committerdate

[commit]
	verbose = true
	template = ~/.config/git/gitmessage

[init]
	defaultBranch = main

[column]
	ui = auto

[rerere]
	enabled = true
	autoupdate = true

[transfer]
	fsckObjects = true

[alias]
	difft = "!f() { GIT_EXTERNAL_DIFF=difft git diff \"$@\"; }; f"

[include]
	path = ~/.config/git/config-personal
	path = ~/.config/git/config-work
	path = ~/.config/git/config-devserver
