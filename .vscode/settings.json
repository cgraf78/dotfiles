{
  "bashIde.globPattern": "{.bashrc,.bash_profile,.profile,.zshenv,.zprofile,.zshrc,.config/dot/merge-hooks.d/**/*@(.sh|.inc|.bash|.zsh|.command),.config/shdeps/hooks.d/**/*@(.sh|.inc|.bash|.zsh|.command),.config/shell/**/*@(.sh|.inc|.bash|.zsh|.command),.local/lib/dot/**/*@(.sh|.inc|.bash|.zsh|.command),.local/share/cgraf78/**/*@(.sh|.inc|.bash|.zsh|.command),.local/share/cgraf78/*/bin/*}",
  "cmake.ignoreCMakeListsMissing": true,
  "files.watcherExclude": {
    ".bun/install/cache/**": true,
    ".local/share/nvim/mason/packages/**": true,
    ".vscode/extensions/**": true,
    "**/node_modules/**": true,
    "Library/**": true
  },
  "git.ignoreLimitWarning": true,
  "git.repositoryScanIgnoredFolders": ["Library", "node_modules"],
  "git.untrackedChanges": "hidden",
  "Lua.diagnostics.globals": ["vim"],
  "Lua.misc.parameters": ["--force-accept-workspace"],
  "Lua.runtime.version": "LuaJIT",
  "Lua.workspace.checkThirdParty": false,
  "Lua.workspace.ignoreDir": [
    ".bun",
    ".local/share/nvim",
    ".vscode/extensions",
    "git",
    "Library",
    "node_modules"
  ],
  "python.terminal.activateEnvironment": false,
  "sleyTools.diagnosticExclude": [
    ".bun/**",
    ".local/share/nvim/**",
    ".vscode/extensions/**",
    ".vscode-server/**",
    "Downloads/**",
    "**/node_modules/**",
    "Library/**"
  ],
  "search.exclude": {
    ".bun/install/cache/**": true,
    ".local/share/nvim/mason/packages/**": true,
    ".vscode/extensions/**": true,
    "**/node_modules/**": true,
    "Library/**": true
  }
}
