#!/usr/bin/env bash
# clip-test - clipboard backend and history behavior.

set -o pipefail
export NO_COLOR=1

# shellcheck source=helpers.sh
. "$HOME/.local/lib/dot/tests/helpers.sh"

clip="$HOME/.local/bin/clip"
test_root=$(_tmpdir)
backend_bin="$test_root/bin"
runtime_bin=$(_mock_bin)
data_home="$test_root/data"
copy_log="$test_root/copied"
args_log="$test_root/args"
mkdir -p "$backend_bin" "$data_home"

# Keep each backend case independent of clipboard tools installed by the host.
# In particular, macOS provides pbcopy/pbpaste in /usr/bin, which must not win
# while the Wayland, X11, and missing-backend cases are under test.
for tool in bash cat cut date head ls mkdir rm tail tr wc; do
  ln -s "$(command -v "$tool")" "$runtime_bin/$tool"
done
test_path="$backend_bin:$runtime_bin"

echo "=== Clipboard backend selection ==="

cat >"$backend_bin/pbcopy" <<'EOF'
#!/usr/bin/env bash
cat >"$CLIP_TEST_COPY_LOG"
EOF
cat >"$backend_bin/pbpaste" <<'EOF'
#!/usr/bin/env bash
printf '%s' 'macOS clipboard'
EOF
chmod +x "$backend_bin/pbcopy" "$backend_bin/pbpaste"

printf '%s' 'macOS copy' |
  env PATH="$test_path" XDG_DATA_HOME="$data_home" \
    CLIP_TEST_COPY_LOG="$copy_log" "$clip" copy
_assert_file_content "clip copy uses pbcopy on macOS" "macOS copy" "$copy_log"
macos_paste=$(env PATH="$test_path" XDG_DATA_HOME="$data_home" \
  CLIP_TEST_COPY_LOG="$copy_log" "$clip" paste)
_assert_eq "clip paste uses pbpaste on macOS" "macOS clipboard" "$macos_paste"
rm -f "$backend_bin/pbcopy" "$backend_bin/pbpaste" "$copy_log"

cat >"$backend_bin/wl-copy" <<'EOF'
#!/usr/bin/env bash
cat >"$CLIP_TEST_COPY_LOG"
printf '%s\n' "$*" >"$CLIP_TEST_ARGS_LOG"
EOF
cat >"$backend_bin/wl-paste" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >"$CLIP_TEST_ARGS_LOG"
printf '%s' 'wayland clipboard'
EOF
chmod +x "$backend_bin/wl-copy" "$backend_bin/wl-paste"

printf '%s' 'wayland copy' |
  env PATH="$test_path" XDG_DATA_HOME="$data_home" \
    WAYLAND_DISPLAY=wayland-0 CLIP_TEST_COPY_LOG="$copy_log" \
    CLIP_TEST_ARGS_LOG="$args_log" "$clip" copy
_assert_file_content "clip copy uses wl-copy in a Wayland session" \
  "wayland copy" "$copy_log"
_assert_file_content "clip copy does not add unsupported wl-copy arguments" \
  "" "$args_log"

wayland_paste=$(env PATH="$test_path" XDG_DATA_HOME="$data_home" \
  WAYLAND_DISPLAY=wayland-0 CLIP_TEST_COPY_LOG="$copy_log" \
  CLIP_TEST_ARGS_LOG="$args_log" "$clip" paste)
_assert_eq "clip paste reads the Wayland clipboard" \
  "wayland clipboard" "$wayland_paste"
_assert_file_content "clip paste suppresses wl-paste's synthetic trailing newline" \
  "--no-newline" "$args_log"

rm -f "$backend_bin/wl-copy" "$backend_bin/wl-paste"
cat >"$backend_bin/xclip" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >"$CLIP_TEST_ARGS_LOG"
if [[ " $* " == *" -o "* ]]; then
  printf '%s' 'x11 clipboard'
else
  cat >"$CLIP_TEST_COPY_LOG"
fi
EOF
chmod +x "$backend_bin/xclip"

printf '%s' 'x11 copy' |
  env PATH="$test_path" XDG_DATA_HOME="$data_home" \
    DISPLAY=:0 CLIP_TEST_COPY_LOG="$copy_log" CLIP_TEST_ARGS_LOG="$args_log" \
    "$clip" copy
_assert_file_content "clip copy uses xclip in an X11 session" "x11 copy" "$copy_log"
_assert_file_content "clip copy selects the X11 clipboard" \
  "-selection clipboard" "$args_log"

x11_paste=$(env PATH="$test_path" XDG_DATA_HOME="$data_home" \
  DISPLAY=:0 CLIP_TEST_COPY_LOG="$copy_log" CLIP_TEST_ARGS_LOG="$args_log" \
  "$clip" paste)
_assert_eq "clip paste reads the X11 clipboard" "x11 clipboard" "$x11_paste"
_assert_file_content "clip paste selects the X11 clipboard" \
  "-o -selection clipboard" "$args_log"

echo
echo "=== tmux capture behavior ==="

rm -f "$backend_bin/xclip" "$copy_log" "$args_log"
remote_data="$test_root/remote-data"
capture_rc=0
printf '%s' 'remote selection' |
  env PATH="$runtime_bin" XDG_DATA_HOME="$remote_data" "$clip" capture || capture_rc=$?
_assert_exit "clip capture succeeds without a host clipboard backend" 0 "$capture_rc"
remote_history=$(printf '%s\n' "$remote_data/clip"/* | head -1)
_assert_file_content "clip capture preserves remote tmux selections in history" \
  "remote selection" "$remote_history"

cat >"$backend_bin/wl-copy" <<'EOF'
#!/usr/bin/env bash
exit 17
EOF
chmod +x "$backend_bin/wl-copy"
failed_backend_data="$test_root/failed-backend-data"
capture_rc=0
printf '%s' 'selection despite failed backend' |
  env PATH="$test_path" XDG_DATA_HOME="$failed_backend_data" \
    WAYLAND_DISPLAY=wayland-0 "$clip" capture >/dev/null 2>&1 || capture_rc=$?
_assert_exit "clip capture survives a broken optional host backend" 0 "$capture_rc"
failed_backend_history=$(printf '%s\n' "$failed_backend_data/clip"/* | head -1)
_assert_file_content "clip capture records history before an optional backend fails" \
  "selection despite failed backend" "$failed_backend_history"
rm -f "$backend_bin/wl-copy"

copy_rc=0
printf '%s' 'no backend' |
  env PATH="$runtime_bin" XDG_DATA_HOME="$test_root/no-backend-copy" \
    "$clip" copy >/dev/null 2>&1 || copy_rc=$?
_assert_exit "clip copy still reports a missing direct clipboard backend" 1 "$copy_rc"

paste_rc=0
env PATH="$runtime_bin" XDG_DATA_HOME="$test_root/no-backend-paste" \
  "$clip" paste >/dev/null 2>&1 || paste_rc=$?
_assert_exit "clip paste reports when no host clipboard is readable" 1 "$paste_rc"

_test_summary
