            try:
                os.killpg(child, signal.SIGKILL)
            except ProcessLookupError:
                pass
            reaped, status = reap_child(child, 1)
            if not reaped:
                try:
                    os.kill(child, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                reaped, status = reap_child(child, 1)
        os.close(master)

    exit_code = os.waitstatus_to_exitcode(status) if status is not None else None
    adapter_started = os.path.exists(adapter_pid_file)
    return exit_code, cancel_sent, adapter_started, reaped, output

