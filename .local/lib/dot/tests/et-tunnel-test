    output = b""
    status = None
    reaped = False
    cancel_sent = False
    deadline = time.monotonic() + 20
    try:
        while time.monotonic() < deadline:
            readable, _, _ = select.select([master], [], [], 0.05)
            if readable:
                try:
                    output += os.read(master, 4096)
                except OSError:
                    pass
            worker_pid = transport_worker_pid()
            if cancel and not cancel_sent and worker_pid is not None:
                try:
                    # Send terminal Ctrl-C only after the worker PGID is truly
                    # foreground; otherwise the byte would target the launcher
                    # and fail to cover pre-adapter gate cancellation.
                    if os.tcgetpgrp(master) == worker_pid:
                        os.write(master, b"\x03")
                        cancel_sent = True
                except OSError:
                    pass
            waited, candidate = os.waitpid(child, os.WNOHANG)
            if waited:
                status = candidate
                reaped = True
                break
    finally:
