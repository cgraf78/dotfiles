def reap_child(pid, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            waited, status = os.waitpid(pid, os.WNOHANG)
        except ChildProcessError:
            return True, None
        if waited:
            return True, status
        time.sleep(0.05)
    return False, None

def run_case(port, cancel):
    try:
        os.unlink(adapter_pid_file)
    except FileNotFoundError:
        pass
    # The gate is meaningful only with a controlling PTY: without one, the
    # worker deliberately skips foreground ownership and starts immediately.
    master, slave = pty.openpty()
    child = os.fork()
    if child == 0:
        os.setsid()
        fcntl.ioctl(slave, termios.TIOCSCTTY, 0)
        for fd in (0, 1, 2):
            os.dup2(slave, fd)
        os.close(master)
        os.close(slave)
        os.execv(
            bash,
            ["bash", script, "gateway.example", str(port), "service.internal", "443"],
        )

