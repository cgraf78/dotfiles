_run_et_tunnel gateway.example 10443 service.internal 443
commands=$(cat "$log")
transport_remote_command=$(cat "$remote_command_file")
transport_remote_payload=$(cat "$bootstrap_payload_file")
decoded_remote_command=$(_decode_remote_payload "$transport_remote_payload")
commands+=$'\n'"$decoded_remote_command"
output=$(cat "$stdout")
mapping=$(sed -n '/^<-t>$/{n;s/^<\(.*\)>$/\1/p;q;}' "$log")
ports=$(sed -n 's/^10443:\([0-9][0-9]*\),\([0-9][0-9]*\):\([0-9][0-9]*\)$/\1 \2 \3/p' <<<"$mapping")
read -r relay_port control_local_port control_remote_port <<<"$ports"

_assert_exit "default launch: succeeds" 0 "$run_exit"
_assert_contains "default launch: runs ET without a terminal" $'et\n<-N>' "$commands"
_assert_contains "default launch: enables ET keepalives" $'<--keepalive>\n<5>' "$commands"
expected_mapping=$(printf '<-t>\n<10443:%s,%s:%s>' \
  "$relay_port" "$control_local_port" "$control_remote_port")
_assert_contains "default launch: maps the requested local port" \
  "$expected_mapping" "$commands"
if [[ "$control_local_port" =~ ^[0-9]+$ ]] &&
  ((control_local_port >= 49152 && control_local_port <= 65535)); then
  _pass "default launch: chooses a private local control port"
else
  _fail "default launch: chooses a private local control port (got '$control_local_port')"
fi
_assert_contains "default launch: sends a remote relay command" "<--command>" "$commands"
_assert_contains "default launch: enters an explicit POSIX remote shell" \
  "exec /bin/sh -c '" \
  "$transport_remote_command"
_assert_contains "default launch: bootstrap uses a portable decoder" \
  "base64 -d" "$transport_remote_command"
_assert_contains "default launch: bootstrap decompresses the remote supervisor" \
  "gzip -dc" "$transport_remote_command"
_assert_contains "default launch: authenticates the exact bootstrap payload" \
  "sha256sum" "$transport_remote_command"
_assert_contains "default launch: bounds unauthenticated bootstrap input" \
  "ulimit -f" "$transport_remote_command"
