_report_remote_timeout() {
  local label="$1" supervisor="$2" owner_snapshot=""
  local observed_pid path
  local -a owner_fields=()

  [[ ! -r "$remote_owner" ]] || owner_snapshot=$(cat "$remote_owner")
  read -r -a owner_fields <<<"$owner_snapshot"
  printf 'remote supervisor timeout (%s): requested=%s owner=%s\n' \
    "$label" "$supervisor" "$owner_snapshot" >&2
  for observed_pid in "$supervisor" "${owner_fields[2]:-}" \
    "${owner_fields[3]:-}" "${owner_fields[6]:-}" "${owner_fields[7]:-}"; do
    [[ "$observed_pid" =~ ^[0-9]+$ ]] || continue
    ps -ww -o pid=,ppid=,stat=,command= -p "$observed_pid" >&2 || true
  done
  for path in "$remote_state/control" "$remote_state/stop"; do
    printf '%s: ' "$path" >&2
    if [[ -r "$path" ]]; then
      sed -n '1,3p' "$path" >&2
    else
      printf '<missing>\n' >&2
    fi
  done
  printf '%s\n' 'remote stderr:' >&2
  tail -n 20 "$tmp/remote.stderr" >&2 || true
  printf '%s\n' 'remote log:' >&2
  tail -n 20 "$remote_log" >&2 || true
}

_process_has_stopped() {
  local pid="$1" state

  state=$(ps -o stat= -p "$pid" 2>/dev/null || true)
  [[ -z "$state" || "$state" == *Z* ]]
}

_wait_for_processes_stopped() {
  local _ pid all_stopped

  for _ in {1..80}; do
    all_stopped=1
    for pid in "$@"; do
      if ! _process_has_stopped "$pid"; then
        all_stopped=0
      fi
    done
    ((all_stopped == 1)) && return
    sleep 0.1
  done
  return 1
}

_wait_for_owner_control() {
  local path="$1" expected="$2" token control _
  for _ in {1..80}; do
