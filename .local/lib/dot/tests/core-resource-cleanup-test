    DOT_TEST_BACKEND="$backend" DOT_TEST_DISABLE_DISCOVERY="$disable_discovery" \
    bash "$case_dir/fixture.sh" &
  fixture_pid=$!
  [[ "$had_monitor" == 1 ]] || set +m

  if ! _wait_for_file "$case_dir/ready"; then
    _fail "$label: external child becomes ready"
    kill -KILL -- "-$fixture_pid" 2>/dev/null || true
    wait "$fixture_pid" 2>/dev/null || true
    return
  fi
  leaf_pid=$(<"$case_dir/leaf.pid")
  unrelated_pid=$(<"$case_dir/unrelated.pid")
  kill -TERM "$fixture_pid"
  if _wait_for_pid_bounded "$fixture_pid"; then
    fixture_rc=$WAIT_PID_RC
  else
    _fail "$label: fixture exits within five seconds"
    kill -KILL "$leaf_pid" "$unrelated_pid" 2>/dev/null || true
    return
  fi

  for _ in {1..40}; do
    leaf_state=$(ps -o stat= -p "$leaf_pid" 2>/dev/null || true)
    if ! kill -0 "$leaf_pid" 2>/dev/null ||
      [[ "$leaf_state" =~ ^[[:space:]]*Z ]]; then
      break
    fi
    sleep 0.05
  done
  _assert_exit "$label: preserves TERM status" 143 "$fixture_rc"
  if ! kill -0 "$leaf_pid" 2>/dev/null ||
    [[ "$leaf_state" =~ ^[[:space:]]*Z ]]; then
    _pass "$label: removes TERM-ignoring external child"
  else
    _fail "$label: removes TERM-ignoring external child"
  fi
  if [[ ! -e "$case_dir/state/dot/update.lock.d" ]]; then
    _pass "$label: releases lock after child cleanup"
  else
    _fail "$label: releases lock after child cleanup"
  fi
  if kill -0 "$unrelated_pid" 2>/dev/null; then
    _pass "$label: unrelated sibling survives"
  else
    _fail "$label: unrelated sibling survives"
  fi
  kill -KILL "$leaf_pid" "$unrelated_pid" 2>/dev/null || true
  wait "$unrelated_pid" 2>/dev/null || true
}

_run_mktemp_fast_exit_stress_case() {
  local case_dir fixture_rc=0
  case_dir=$(_tmpdir)
  mkdir -p "$case_dir/tmp"

  cat >"$case_dir/fixture.sh" <<'FIXTURE'
#!/usr/bin/env bash
set -uT

# shellcheck source=/dev/null
. "$SOURCE_HOME/.local/lib/dot/core/resources.sh"

# Force the scheduler window that made the original unnamed coprocess unsafe:
# a tiny allocator may exit and let Bash unset COPROC_PID before the next
# command captures it. The production handshake must keep the child alive
# through that exact assignment, independent of ordinary scheduler luck.
delayed_capture=0
trap 'if [[ "$delayed_capture" == 0 &&
  "$BASH_COMMAND" == "allocator_pid=\$COPROC_PID" ]]; then
  delayed_capture=1
  trap - DEBUG
  sleep 0.1
fi' DEBUG
_dot_cleanup_mktemp -d "$TMPDIR/forced-fast.XXXXXX" || exit $?
path=$REPLY
[[ -d "$path" ]] || exit 90
_dot_cleanup_remove_path "$path" || exit $?

# Keep a repeated real-allocation check as a second line of defense against
# descriptor lifetime and nounset regressions that do not need forced timing.
for ((attempt = 0; attempt < 200; attempt++)); do
  _dot_cleanup_mktemp -d "$TMPDIR/fast.XXXXXX" || exit $?
  path=$REPLY
  [[ -d "$path" ]] || exit 91
  _dot_cleanup_remove_path "$path" || exit $?
done
[[ "${#DOT_CLEANUP_PATHS[@]}" -eq 0 ]]
FIXTURE
  chmod +x "$case_dir/fixture.sh"

  SOURCE_HOME="$SOURCE_HOME" TMPDIR="$case_dir/tmp" \
    bash "$case_dir/fixture.sh" 2>"$case_dir/stderr" || fixture_rc=$?
  _assert_exit "mktemp fast exit: repeated allocation stays nounset-safe" 0 "$fixture_rc"
  _assert_eq "mktemp fast exit: repeated allocation leaves no scratch" \
    0 "$(_scratch_entry_count "$case_dir/tmp")"
  _assert_eq "mktemp fast exit: repeated allocation emits no descriptor errors" \
    "" "$(cat "$case_dir/stderr")"
}

_run_owned_group_leader_exit_case() {
  local case_dir fixture_rc=0
  case_dir=$(_tmpdir)
  mkdir -p "$case_dir/tmp"

  cat >"$case_dir/leaf.py" <<'PY'
import os
import pathlib
import signal
import sys
import time

root = pathlib.Path(sys.argv[1])
signal.signal(signal.SIGTERM, signal.SIG_IGN)
(root / "leaf.pid").write_text(f"{os.getpid()}\n", encoding="ascii")
(root / "ready").touch()
while True:
    time.sleep(1)
PY

  cat >"$case_dir/fixture.sh" <<'FIXTURE'
#!/usr/bin/env bash
set -u

# shellcheck source=/dev/null
. "$SOURCE_HOME/.local/lib/dot/core/resources.sh"

had_monitor=0
[[ "$-" == *m* ]] && had_monitor=1
set -m
(
  # The leader is allowed to finish during graceful shutdown. Its external
  # child deliberately is not, so the owner must retain its already-validated
  # group claim through KILL escalation instead of keying it to leader liveness.
  set +m
  trap 'exit 0' TERM
  python3 "$CASE_DIR/leaf.py" "$CASE_DIR" &
  wait "$!"
) &
leader=$!
[[ "$had_monitor" == 1 ]] || set +m
_dot_cleanup_register_pid "$leader" "$leader"

for ((attempt = 0; attempt < 200; attempt++)); do
  [[ -f "$CASE_DIR/ready" ]] && break
  sleep 0.01
done
[[ -f "$CASE_DIR/ready" ]] || exit 91
leaf=$(<"$CASE_DIR/leaf.pid")

# Observe cleanup from outside the owned group. A safe escalation must keep an
# actual original member stopped in that PGID; a bare numeric group claim can
# become reusable after a cooperative leader exits.
(
  for ((attempt = 0; attempt < 200; attempt++)); do
    leader_state=$(ps -o stat= -p "$leader" 2>/dev/null || true)
    if [[ "$leader_state" =~ ^[[:space:]]*T ]]; then
      : >"$CASE_DIR/leader-anchored"
      exit 0
    fi
    kill -0 "$leader" 2>/dev/null || exit 0
    sleep 0.01
  done
) &
observer=$!

_dot_cleanup_all
wait "$observer" 2>/dev/null || true
leaf_state=$(ps -o stat= -p "$leaf" 2>/dev/null || true)
leaf_alive=0
if kill -0 "$leaf" 2>/dev/null &&
  [[ ! "$leaf_state" =~ ^[[:space:]]*Z ]]; then
  leaf_alive=1
fi
leader_anchored=0
[[ ! -f "$CASE_DIR/leader-anchored" ]] || leader_anchored=1
printf 'leader_anchored=%s\nleaf_alive=%s\npids=%s\ngroups=%s\n' \
  "$leader_anchored" "$leaf_alive" \
  "${#DOT_CLEANUP_PIDS[@]}" "${#DOT_CLEANUP_PID_GROUPS[@]}" \
  >"$CASE_DIR/report"

# The red version leaks this orphan. Keep the regression test itself bounded
# and leave no process behind even when the assertions below fail.
kill -KILL "$leaf" 2>/dev/null || true
FIXTURE
  chmod +x "$case_dir/fixture.sh"

  SOURCE_HOME="$SOURCE_HOME" CASE_DIR="$case_dir" TMPDIR="$case_dir/tmp" \
    bash "$case_dir/fixture.sh" || fixture_rc=$?
  _assert_exit "owned group leader exit: fixture completes" 0 "$fixture_rc"
  _assert_file_content "owned group leader exit: original leader anchors escalation" \
    $'leader_anchored=1\nleaf_alive=0\npids=0\ngroups=0' "$case_dir/report"
}

