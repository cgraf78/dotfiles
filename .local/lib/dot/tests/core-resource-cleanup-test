# cleanup installs ignored dispositions. The re-entrancy guard must keep TERM
# authoritative without recursively starting another cleanup.
eval "$(declare -f _dot_cleanup_ignore_signals | sed '1s/_dot_cleanup_ignore_signals/_dot_cleanup_ignore_signals_original/')"
