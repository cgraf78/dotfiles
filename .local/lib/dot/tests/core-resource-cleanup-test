(
  # shellcheck source=/dev/null
  . "$resources"
  [[ "${#DOT_CLEANUP_PATHS[@]}" -eq 0 ]]
)

_dot_cleanup_all
[[ ! -e "$owned" ]]
FIXTURE
  chmod +x "$case_dir/fixture.sh"

  SOURCE_HOME="$SOURCE_HOME" CASE_DIR="$case_dir" \
    bash "$case_dir/fixture.sh" || fixture_rc=$?
  _assert_exit "resource re-source: preserves only the current owner's registry" \
    0 "$fixture_rc"
}

