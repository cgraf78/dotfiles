    _pass "signal shield: later group signal cannot interrupt scratch removal"
  else
    _fail "signal shield: later group signal cannot interrupt scratch removal"
  fi
  if [[ ! -e "$case_dir/state/dot/update.lock.d" ]]; then
    _pass "signal shield: later group signal cannot interrupt lock removal"
  else
