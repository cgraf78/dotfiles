_check_bash4_nounset_array_guards() {
  local source
  source=$(<"$SOURCE_HOME/.local/lib/dot/core/resources.sh")
  # shellcheck disable=SC2016  # Literal source patterns for Bash 4 compatibility.
  _assert_contains "Bash 4 nounset: FD cleanup guards an empty array" \
    'for fd in "${fds[@]+"${fds[@]}"}"' "$source"
  # shellcheck disable=SC2016  # Literal source patterns for Bash 4 compatibility.
  _assert_contains "Bash 4 nounset: PID cleanup guards an empty array" \
    'for pid in "${pids[@]+"${pids[@]}"}"' "$source"
  # shellcheck disable=SC2016  # Literal source patterns for Bash 4 compatibility.
  _assert_contains "Bash 4 nounset: path cleanup guards an empty array" \
    'for path in "${paths[@]+"${paths[@]}"}"' "$source"
}

