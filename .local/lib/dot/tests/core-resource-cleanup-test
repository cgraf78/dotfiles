#!/usr/bin/env bash
# core-resource-cleanup-test - interruption cleanup for dot-owned async work.

set -o pipefail

SOURCE_HOME="$HOME"
# shellcheck source=helpers.sh
. "$HOME/.local/lib/dot/tests/helpers.sh"

_wait_for_file() {
  local path="$1" attempt
  for ((attempt = 0; attempt < 500; attempt++)); do
    [[ -f "$path" ]] && return 0
    sleep 0.01
  done
  return 1
}

_wait_for_pid_bounded() {
  local pid="$1" attempt state=""
  WAIT_PID_RC=0
  for ((attempt = 0; attempt < 500; attempt++)); do
    if ! kill -0 "$pid" 2>/dev/null; then
      wait "$pid" 2>/dev/null
      WAIT_PID_RC=$?
      return 0
    fi
    state=$(ps -o stat= -p "$pid" 2>/dev/null || true)
    if [[ "$state" =~ ^[[:space:]]*Z ]]; then
      wait "$pid" 2>/dev/null
      WAIT_PID_RC=$?
      return 0
    fi
    sleep 0.01
  done
  # Every caller launches its fixture as a job-control leader. Tear down that
  # exact test group on timeout so a deliberately stuck descendant cannot keep
  # the suite output pipe open or contaminate later cases.
  kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  return 1
}

_scratch_entry_count() {
  local dir="$1"
  local -a entries=()
  shopt -s nullglob dotglob
  entries=("$dir"/*)
  shopt -u nullglob dotglob
  printf '%s\n' "${#entries[@]}"
}

_run_resource_cancel_case() {
  local mode="$1" label="$2" signal="${3:-TERM}" expected_rc="${4:-143}"
  local ignore_term="${5:-0}" signal_scope="${6:-parent}"
  local case_dir fixture_pid fixture_rc=0 child_pid="" unrelated_pid
  local had_monitor=0
  case_dir=$(_tmpdir)
  mkdir -p "$case_dir/tmp"
  mkfifo "$case_dir/gate"

  cat >"$case_dir/fixture.sh" <<'FIXTURE'
#!/usr/bin/env bash
set -eu

# shellcheck source=/dev/null
. "$SOURCE_HOME/.local/lib/dot/core/init.sh"

if [[ "$IGNORE_TERM" == 3 ]]; then
  eval "$(declare -f _dot_cleanup_owned | sed '1s/_dot_cleanup_owned/_dot_cleanup_owned_original/')"
  _dot_cleanup_owned() {
    : >"$CASE_DIR/cleanup-started"
    _dot_cleanup_owned_original
  }
fi

_fixture_block() {
  if [[ "$IGNORE_TERM" == 1 ]]; then
    trap '' TERM
  elif [[ "$IGNORE_TERM" == 2 ]]; then
    _worker_term_seen() { : >"$CASE_DIR/worker-term-seen"; }
    trap _worker_term_seen TERM
  elif [[ "$IGNORE_TERM" == 3 ]]; then
    trap '' TERM HUP
  fi
  printf '%s\n' "$BASHPID" >"$CASE_DIR/child.pid"
  : >"$CASE_DIR/ready"
  if [[ "$IGNORE_TERM" == 2 ]]; then
    while :; do sleep 0.05; done
  elif [[ "$IGNORE_TERM" == 3 ]]; then
    while ! IFS= read -r _ <"$CASE_DIR/gate"; do :; done
    return 0
  fi
  IFS= read -r _ <"$CASE_DIR/gate"
}

trap '_dot_cleanup_all' EXIT
trap '_dot_cleanup_signal 129' HUP
trap '_dot_cleanup_signal 130' INT
trap '_dot_cleanup_signal 131' QUIT
trap '_dot_cleanup_signal 143' TERM

case "$MODE" in
  run)
    _ui_live_enabled() { return 0; }
    _ui_stage_tick() { :; }
    _run_to_log_with_ticks "$CASE_DIR/command.log" _fixture_block
    ;;
  merges)
    _hooks=(fixture)
    _merge_index=0
    DOT_UI_TOTAL=0
    DOT_MERGE_JOBS=1
    cat >"$CASE_DIR/hook.sh" <<'HOOK'
merge() {
  _fixture_block
}
HOOK
    _run_merge_hook_batch $'fixture\t'"$CASE_DIR/hook.sh"
    ;;
  overlays)
    _pull_overlay_active() { return 0; }
    _pull_overlay() {
      _fixture_block
      REPLY_STATUS=current
    }
    OVERLAYS=('fixture|/unused/fixture|unused||false|')
    DOT_UPDATE_JOBS=1
    _pull_overlays
    ;;
  shdeps)
    _run_shdeps_update_command() { _fixture_block; }
    _ui_stage_tick() { :; }
    _run_shdeps_update_ui
    ;;
  lock)
    mkdir -p "$CASE_DIR/home" "$CASE_DIR/state"
    export HOME="$CASE_DIR/home"
    export XDG_STATE_HOME="$CASE_DIR/state"
    _dot_update_lock_acquire
    _ui_live_enabled() { return 0; }
    _ui_stage_tick() { :; }
    _run_to_log_with_ticks "$CASE_DIR/command.log" _fixture_block
    ;;
  *) exit 2 ;;
esac
: >"$CASE_DIR/later-phase"
FIXTURE
  chmod +x "$case_dir/fixture.sh"

  [[ "$-" == *m* ]] && had_monitor=1
  set -m
  SOURCE_HOME="$SOURCE_HOME" CASE_DIR="$case_dir" MODE="$mode" \
    IGNORE_TERM="$ignore_term" TMPDIR="$case_dir/tmp" \
    bash "$case_dir/fixture.sh" &
  fixture_pid=$!
  [[ "$had_monitor" == 1 ]] || set +m

  if ! _wait_for_file "$case_dir/ready"; then
    _fail "$label: worker becomes ready"
    kill -KILL -- "-$fixture_pid" 2>/dev/null || true
    wait "$fixture_pid" 2>/dev/null || true
    return
  fi
  child_pid=$(<"$case_dir/child.pid")

  sleep 30 &
  unrelated_pid=$!
  if [[ "$signal_scope" == group ]]; then
    kill -"$signal" -- "-$fixture_pid"
  else
    kill -"$signal" "$fixture_pid"
  fi
  if [[ "$ignore_term" == 2 ]]; then
    if _wait_for_file "$case_dir/worker-term-seen"; then
      kill -HUP "$fixture_pid"
    else
      _fail "$label: worker observes cooperative TERM"
    fi
  elif [[ "$ignore_term" == 3 ]]; then
    if _wait_for_file "$case_dir/cleanup-started"; then
      kill -HUP -- "-$fixture_pid" 2>/dev/null || true
    else
      _fail "$label: first signal begins cleanup"
    fi
  fi
  if _wait_for_pid_bounded "$fixture_pid"; then
    fixture_rc=$WAIT_PID_RC
  else
    _fail "$label: fixture exits within five seconds"
    return
  fi

  _assert_exit "$label: top-level $signal status is preserved" "$expected_rc" "$fixture_rc"
  if kill -0 "$child_pid" 2>/dev/null; then
    _fail "$label: owned worker is reaped"
  else
    _pass "$label: owned worker is reaped"
  fi
  _assert_eq "$label: private scratch is removed" \
    0 "$(_scratch_entry_count "$case_dir/tmp")"
  if [[ "$mode" == lock ]]; then
    if [[ ! -e "$case_dir/state/dot/update.lock.d" ]]; then
      _pass "$label: update lock is released after resource cleanup"
    else
      _fail "$label: update lock is released after resource cleanup"
    fi
  fi
  if [[ ! -e "$case_dir/later-phase" ]]; then
    _pass "$label: cancellation prevents later phases"
  else
    _fail "$label: cancellation prevents later phases"
  fi
  if kill -0 "$unrelated_pid" 2>/dev/null; then
    _pass "$label: unrelated process is untouched"
  else
    _fail "$label: unrelated process is untouched"
  fi

  kill -KILL "$child_pid" "$unrelated_pid" 2>/dev/null || true
  wait "$unrelated_pid" 2>/dev/null || true
  [[ "$had_monitor" == 1 ]] && set -m
}

_run_registration_race_case() {
  local case_dir fixture_pid fixture_rc=0 child_pid=""
  local had_monitor=0
  case_dir=$(_tmpdir)
  mkdir -p "$case_dir/tmp"
  mkdir -p "$case_dir/gates"

  cat >"$case_dir/fixture.sh" <<'FIXTURE'
#!/usr/bin/env bash
set -u

# shellcheck source=/dev/null
. "$SOURCE_HOME/.local/lib/dot/core/init.sh"

trap '_dot_cleanup_all' EXIT
_on_hup() {
  _dot_cleanup_signal 129
  : >"$CASE_DIR/hup-seen"
}
trap _on_hup HUP
trap '_dot_cleanup_signal 130' INT
trap '_dot_cleanup_signal 131' QUIT
_on_term() {
  _dot_cleanup_signal 143
  : >"$CASE_DIR/term-seen"
}
trap _on_term TERM

_dot_cleanup_begin_registration
owned_dir=$(mktemp -d "$TMPDIR/race.XXXXXX") || exit 1
(
  while [[ ! -e "$CASE_DIR/gates/child-continue" ]]; do sleep 0.01; done
) &
child=$!
printf '%s\n' "$child" >"$CASE_DIR/child.pid"
: >"$CASE_DIR/ready"
while [[ ! -e "$CASE_DIR/gates/continue" ]]; do sleep 0.01; done
_dot_cleanup_register_path "$owned_dir"
_dot_cleanup_register_pid "$child"
_dot_cleanup_end_registration
exit 99
FIXTURE
  chmod +x "$case_dir/fixture.sh"

  [[ "$-" == *m* ]] && had_monitor=1
  set -m
  SOURCE_HOME="$SOURCE_HOME" CASE_DIR="$case_dir" TMPDIR="$case_dir/tmp" \
    bash "$case_dir/fixture.sh" &
  fixture_pid=$!
  [[ "$had_monitor" == 1 ]] || set +m

  if ! _wait_for_file "$case_dir/ready"; then
    _fail "registration race: fixture becomes ready"
    kill -KILL -- "-$fixture_pid" 2>/dev/null || true
    wait "$fixture_pid" 2>/dev/null || true
    return
  fi
  child_pid=$(<"$case_dir/child.pid")
  kill -TERM "$fixture_pid"
  if ! _wait_for_file "$case_dir/term-seen"; then
    _fail "registration race: deferred signal is observed"
    kill -KILL -- "-$fixture_pid" 2>/dev/null || true
    wait "$fixture_pid" 2>/dev/null || true
    return
  fi
  kill -HUP "$fixture_pid"
  if ! _wait_for_file "$case_dir/hup-seen"; then
    _fail "registration race: second signal is observed"
    kill -KILL -- "-$fixture_pid" 2>/dev/null || true
    wait "$fixture_pid" 2>/dev/null || true
    return
  fi
  : >"$case_dir/gates/continue"
  if _wait_for_pid_bounded "$fixture_pid"; then
    fixture_rc=$WAIT_PID_RC
  else
    _fail "registration race: fixture exits within five seconds"
    return
  fi

  _assert_exit "registration race: deferred TERM status is preserved" 143 "$fixture_rc"
  _pass "registration race: first signal wins"
  if kill -0 "$child_pid" 2>/dev/null; then
    _fail "registration race: worker launched before registration is reaped"
  else
    _pass "registration race: worker launched before registration is reaped"
  fi
  _assert_eq "registration race: scratch allocated before registration is removed" \
    0 "$(_scratch_entry_count "$case_dir/tmp")"

  kill -KILL "$child_pid" 2>/dev/null || true
  [[ "$had_monitor" == 1 ]] && set -m
}

_run_completed_job_case() {
  local case_dir fixture_rc=0
  case_dir=$(_tmpdir)

  cat >"$case_dir/fixture.sh" <<'FIXTURE'
#!/usr/bin/env bash
set -u

# shellcheck source=/dev/null
. "$SOURCE_HOME/.local/lib/dot/core/init.sh"

true &
child=$!
_dot_cleanup_register_pid "$child"
for ((attempt = 0; attempt < 500; attempt++)); do
  _dot_cleanup_job_matches "$child" active || break
  sleep 0.01
done
kill() {
  : >"$CASE_DIR/unexpected-kill"
  return 0
}
trap ': >"$CASE_DIR/unexpected-term"' TERM
trap_before=$(trap -p TERM)
_dot_cleanup_all
trap_after=$(trap -p TERM)
[[ ! -e "$CASE_DIR/unexpected-kill" ]] || exit 1
[[ "${#DOT_CLEANUP_PIDS[@]}" -eq 0 ]] || : >"$CASE_DIR/registry-not-empty"
[[ "$trap_after" == "$trap_before" ]] || : >"$CASE_DIR/trap-not-restored"
FIXTURE
  chmod +x "$case_dir/fixture.sh"

  SOURCE_HOME="$SOURCE_HOME" CASE_DIR="$case_dir" \
    bash "$case_dir/fixture.sh" || fixture_rc=$?
  _assert_exit "completed job: cleanup succeeds" 0 "$fixture_rc"
  if [[ ! -e "$case_dir/unexpected-kill" ]]; then
    _pass "completed job: retained status is reaped without signalling its PID"
  else
    _fail "completed job: retained status is reaped without signalling its PID"
  fi
  if [[ ! -e "$case_dir/registry-not-empty" ]]; then
    _pass "completed job: exact wait empties the PID registry"
  else
    _fail "completed job: exact wait empties the PID registry"
  fi
  if [[ ! -e "$case_dir/trap-not-restored" ]]; then
    _pass "completed job: explicit cleanup restores the caller's signal trap"
  else
    _fail "completed job: explicit cleanup restores the caller's signal trap"
  fi
}

_run_descendant_cleanup_case() {
  local case_dir fixture_rc=0
  case_dir=$(_tmpdir)
  mkfifo "$case_dir/descendant-gate"

  cat >"$case_dir/fixture.sh" <<'FIXTURE'
#!/usr/bin/env bash
set -eu

# shellcheck source=/dev/null
. "$SOURCE_HOME/.local/lib/dot/core/init.sh"

_dot_cleanup_process_backend cleanup_backend
printf '%s\n' "$cleanup_backend" >"$CASE_DIR/cleanup-backend"

(
  _dot_cleanup_prepare_subshell
  python3 - "$CASE_DIR" <<'PY' &
import os
import pathlib
import signal
import sys

case_dir = pathlib.Path(sys.argv[1])
signal.signal(signal.SIGTERM, signal.SIG_IGN)
signal.signal(signal.SIGHUP, signal.SIG_IGN)
(case_dir / "descendant.pid").write_text(f"{os.getpid()}\n", encoding="ascii")
(case_dir / "descendant-ready").touch()
with (case_dir / "descendant-gate").open("rb") as gate:
    gate.read(1)
PY
  wait "$!"
) &
wrapper=$!
_dot_cleanup_register_pid "$wrapper"

for ((attempt = 0; attempt < 500; attempt++)); do
  [[ -e "$CASE_DIR/descendant-ready" ]] && break
  sleep 0.01
done
[[ -e "$CASE_DIR/descendant-ready" ]]
descendant=$(<"$CASE_DIR/descendant.pid")

sleep 30 &
unrelated=$!
_dot_cleanup_all

for ((attempt = 0; attempt < 40; attempt++)); do
  descendant_state=$(ps -o stat= -p "$descendant" 2>/dev/null || true)
  if ! kill -0 "$descendant" 2>/dev/null ||
    [[ "$descendant_state" =~ ^[[:space:]]*Z ]]; then
    break
  fi
  sleep 0.05
done
if kill -0 "$descendant" 2>/dev/null &&
  [[ ! "$descendant_state" =~ ^[[:space:]]*Z ]]; then
  : >"$CASE_DIR/descendant-survived"
fi
kill -0 "$unrelated" 2>/dev/null && : >"$CASE_DIR/unrelated-survived"
kill -KILL "$descendant" "$unrelated" 2>/dev/null || true
wait "$unrelated" 2>/dev/null || true
FIXTURE
  chmod +x "$case_dir/fixture.sh"

  _with_timeout 15 env SOURCE_HOME="$SOURCE_HOME" CASE_DIR="$case_dir" \
    bash "$case_dir/fixture.sh" || fixture_rc=$?
  _assert_exit "descendant cleanup: fixture succeeds" 0 "$fixture_rc"
  if [[ "$(cat "$case_dir/cleanup-backend")" == proc ]]; then
    if [[ ! -e "$case_dir/descendant-survived" ]]; then
      _pass "descendant cleanup: strong identity removes external descendant"
    else
      _fail "descendant cleanup: strong identity removes external descendant"
    fi
  elif [[ -e "$case_dir/descendant-survived" ]]; then
    _pass "descendant cleanup: weak identity leaves external descendant untouched"
  else
    _fail "descendant cleanup: weak identity leaves external descendant untouched"
  fi
  if [[ -e "$case_dir/unrelated-survived" ]]; then
    _pass "descendant cleanup: unrelated sibling remains untouched"
  else
    _fail "descendant cleanup: unrelated sibling remains untouched"
  fi
}

