import os
import pty
import select
import signal
import sys
import time

fixture = sys.argv[1]
bash_bin = sys.argv[2]
pid, fd = pty.fork()
if pid == 0:
    os.execv(bash_bin, [bash_bin, fixture])

output = bytearray()
sent_input = False
status = None
deadline = time.monotonic() + 10
while time.monotonic() < deadline:
    readable, _, _ = select.select([fd], [], [], 0.1)
    if readable:
        try:
            chunk = os.read(fd, 4096)
        except OSError:
            chunk = b""
        output.extend(chunk)
        if not sent_input and b"DOT_PTY_READY" in output:
            os.write(fd, b"accepted\n")
