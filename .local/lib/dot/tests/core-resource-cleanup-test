    kill -KILL -- "-$fixture_pid" 2>/dev/null || true
    wait "$fixture_pid" 2>/dev/null || true
    [[ "$had_monitor" == 1 ]] && set -m
    return
  fi
  kill -HUP -- "-$fixture_pid" 2>/dev/null || true
  : >"$case_dir/rm-continue-1"

  if ! _wait_for_file "$case_dir/rm-ready-2"; then
    _fail "signal shield: EXIT cleanup reaches update-lock removal"
