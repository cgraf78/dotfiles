# shellcheck source=/dev/null
. "$resources"

owned="$CASE_DIR/owned"
: >"$owned"
_dot_cleanup_register_path "$owned"

# Re-sourcing in the same process must not discard an active registry.
# shellcheck source=/dev/null
. "$resources"
