  local case_dir pty_rc=0 pty_out bash_bin
  case_dir=$(_tmpdir)
  bash_bin=$(command -v bash)

  cat >"$case_dir/fixture.sh" <<'FIXTURE'
#!/usr/bin/env bash
set -u

# shellcheck source=/dev/null
. "$SOURCE_HOME/.local/lib/dot/core/init.sh"

_ui_live_enabled() { return 0; }
_ui_stage_tick() { :; }
_read_fixture_tty() {
  printf 'DOT_PTY_READY\n' >/dev/tty
  local reply=""
  IFS= read -r reply </dev/tty
  [[ "$reply" == accepted ]]
}

trap '_dot_cleanup_all' EXIT
trap '_dot_cleanup_signal 129' HUP
trap '_dot_cleanup_signal 130' INT
trap '_dot_cleanup_signal 131' QUIT
trap '_dot_cleanup_signal 143' TERM

_run_to_log_with_ticks "$CASE_DIR/command.log" _read_fixture_tty
printf 'DOT_PTY_OK\n'
FIXTURE
  chmod +x "$case_dir/fixture.sh"

  pty_out=$(
    SOURCE_HOME="$SOURCE_HOME" CASE_DIR="$case_dir" \
      python3 - "$case_dir/fixture.sh" "$bash_bin" <<'PY'
import os
import pty
import select
import signal
import sys
import time

fixture = sys.argv[1]
bash_bin = sys.argv[2]
pid, fd = pty.fork()
if pid == 0:
    os.execv(bash_bin, [bash_bin, fixture])

output = bytearray()
sent_input = False
status = None
deadline = time.monotonic() + 10
while time.monotonic() < deadline:
    readable, _, _ = select.select([fd], [], [], 0.1)
    if readable:
        try:
            chunk = os.read(fd, 4096)
        except OSError:
            chunk = b""
        output.extend(chunk)
        if not sent_input and b"DOT_PTY_READY" in output:
            os.write(fd, b"accepted\n")
            sent_input = True
    done, candidate = os.waitpid(pid, os.WNOHANG)
    if done:
        status = candidate
        break

if status is None:
    os.kill(pid, signal.SIGTERM)
    term_deadline = time.monotonic() + 1
    while time.monotonic() < term_deadline:
        done, candidate = os.waitpid(pid, os.WNOHANG)
        if done:
            status = candidate
            break
        time.sleep(0.05)
if status is None:
    os.kill(pid, signal.SIGKILL)
    _, status = os.waitpid(pid, 0)

text = output.decode("utf-8", errors="replace")
sys.stdout.write(text)
exit_code = os.waitstatus_to_exitcode(status)
if not sent_input or "DOT_PTY_OK" not in text:
    sys.exit(1)
sys.exit(exit_code)
PY
  ) || pty_rc=$?

  _assert_exit "interactive command: pseudo-terminal read completes" 0 "$pty_rc"
  _assert_contains "interactive command: worker retains terminal access" \
    "DOT_PTY_OK" "$pty_out"
}

