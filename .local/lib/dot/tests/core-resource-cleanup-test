_run_cleanup_signal_shield_case() {
  local case_dir fixture_pid fixture_rc=0 had_monitor=0
  case_dir=$(_tmpdir)
  mkdir -p "$case_dir/bin" "$case_dir/home" "$case_dir/owned" "$case_dir/state"

  cat >"$case_dir/bin/rm" <<'RM'
#!/usr/bin/env bash
set -eu

count=0
[[ ! -f "$CASE_DIR/rm-count" ]] || count=$(<"$CASE_DIR/rm-count")
count=$((count + 1))
printf '%s\n' "$count" >"$CASE_DIR/rm-count"
: >"$CASE_DIR/rm-ready-$count"
while [[ ! -e "$CASE_DIR/rm-continue-$count" ]]; do sleep 0.01; done
exec "$REAL_RM" "$@"
RM
  chmod +x "$case_dir/bin/rm"

  cat >"$case_dir/fixture.sh" <<'FIXTURE'
