    _pass "signal shield: later group signal cannot interrupt lock removal"
  else
    _fail "signal shield: later group signal cannot interrupt lock removal"
  fi
  [[ "$had_monitor" == 1 ]] && set -m
}

_run_first_signal_latch_case() {
  local case_dir fixture_rc=0
  case_dir=$(_tmpdir)
  mkdir -p "$case_dir/owned"

  cat >"$case_dir/fixture.sh" <<'FIXTURE'
