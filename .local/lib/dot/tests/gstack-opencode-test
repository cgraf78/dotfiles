#!/usr/bin/env bash
# gstack-opencode-test - dependency-free OpenCode registration and cleanup.

# shellcheck disable=SC1090,SC1091

set -o pipefail
export NO_COLOR=1

# shellcheck source=helpers.sh
. "$HOME/.local/lib/dot/tests/helpers.sh"

source_home=${DOT_TEST_SOURCE_HOME:-$HOME}
work=$(_tmpdir)
fixture_home="$work/home"
gstack_dir="$fixture_home/.local/share/garrytan/gstack"
mock_bin="$work/bin"
bun_log="$work/bun.log"
setup_log="$work/setup.log"

mkdir -p \
  "$gstack_dir/qa" \
  "$gstack_dir/browse" \
  "$gstack_dir/codex" \
  "$gstack_dir/bin" \
  "$gstack_dir/browse/dist" \
  "$gstack_dir/browse/bin" \
  "$gstack_dir/design" \
  "$gstack_dir/review/specialists" \
  "$gstack_dir/qa/templates" \
  "$gstack_dir/qa/references" \
  "$gstack_dir/plan-devex-review" \
  "$fixture_home/.config/dot" \
  "$mock_bin"

: >"$bun_log"
: >"$setup_log"

cat >"$gstack_dir/SKILL.md" <<'MD'
---
name: gstack
---
MD
cat >"$gstack_dir/qa/SKILL.md" <<'MD'
---
name: qa
description: QA fixture: checks OpenCode transforms
allowed-tools:
  - Bash
triggers:
  - check qa
---

## When to invoke this skill

Runs fixture QA checks when asked to validate the current behavior.

## Workflow

Read `.claude/skills/review/TODOS-format.md`.
Read `~/.claude/skills/review/checklist.md`.
Run `~/.claude/skills/gstack/bin/gstack-config`.
MD
cat >"$gstack_dir/browse/SKILL.md" <<'MD'
---
name: browse
---
MD
cat >"$gstack_dir/codex/SKILL.md" <<'MD'
---
name: gstack-codex
description: must not make OpenCode invoke Codex recursively
---
MD
printf 'runtime\n' >"$gstack_dir/bin/gstack-config"
printf 'browser\n' >"$gstack_dir/browse/dist/browse"
printf 'browser helper\n' >"$gstack_dir/browse/bin/helper"
for file in checklist.md design-checklist.md greptile-triage.md TODOS-format.md; do
  printf '%s\n' "$file" >"$gstack_dir/review/$file"
done
printf 'specialist\n' >"$gstack_dir/review/specialists/testing.md"
printf 'template\n' >"$gstack_dir/qa/templates/default.md"
printf 'reference\n' >"$gstack_dir/qa/references/default.md"
printf 'hall of fame\n' >"$gstack_dir/plan-devex-review/dx-hall-of-fame.md"
printf 'ethos\n' >"$gstack_dir/ETHOS.md"
printf 'browse\n' >"$fixture_home/.config/dot/gstack-skills-exclude"

cat >"$gstack_dir/setup" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$GSTACK_OPENCODE_SETUP_LOG"
SH
chmod +x "$gstack_dir/setup"

cat >"$mock_bin/opencode" <<'SH'
#!/usr/bin/env bash
exit 0
SH
chmod +x "$mock_bin/opencode"

cat >"$mock_bin/bun" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$GSTACK_OPENCODE_BUN_LOG"
exit 99
SH
chmod +x "$mock_bin/bun"

mkdir -p "$fixture_home/.config/opencode/skills/gstack-review"
printf 'unmanaged\n' >"$fixture_home/.config/opencode/skills/gstack-review/SKILL.md"
ln -s \
  "$fixture_home/.gstack/dotfiles-skills/gstack-old" \
  "$fixture_home/.config/opencode/skills/gstack-old"

saved_home=$HOME
saved_path=$PATH
real_ln=$(command -v ln)
real_rm=$(command -v rm)
HOME=$fixture_home
PATH="$mock_bin:/usr/bin:/bin"
export HOME PATH
export GSTACK_OPENCODE_BUN_LOG=$bun_log
export GSTACK_OPENCODE_SETUP_LOG=$setup_log
export GSTACK_OPENCODE_REAL_LN=$real_ln
export GSTACK_OPENCODE_REAL_RM=$real_rm
export DOT_GSTACK_REGISTER_LIB="$source_home/.local/lib/dot/gstack-register/api.sh"

# shellcheck source=../gstack-register/api.sh
. "$DOT_GSTACK_REGISTER_LIB"

eval "$(declare -f _dot_gstack_has_agent | sed \
  '1s/_dot_gstack_has_agent/_original_dot_gstack_has_agent/')"

cat >"$mock_bin/compatible-opencode" <<'SH'
#!/usr/bin/env bash
exit 0
SH
chmod +x "$mock_bin/compatible-opencode"
DOT_OPENCODE_COMMAND=compatible-opencode
export DOT_OPENCODE_COMMAND
if _original_dot_gstack_has_agent opencode; then
  _pass "OpenCode: compatible command override enables registration"
else
  _fail "OpenCode: compatible command override enables registration"
fi
rm -f "$mock_bin/compatible-opencode"
hash -r
if _original_dot_gstack_has_agent opencode; then
  _fail "OpenCode: command override does not fall back to a different executable"
else
  _pass "OpenCode: command override does not fall back to a different executable"
fi
unset DOT_OPENCODE_COMMAND

_dot_gstack_has_agent() {
  if [ "$1" = "opencode" ]; then
    [ -x "$mock_bin/opencode" ]
    return
  fi
  _original_dot_gstack_has_agent "$@"
}

eval "$(declare -f _dot_gstack_register_opencode | sed \
  '1s/_dot_gstack_register_opencode/_original_dot_gstack_register_opencode/')"
opencode_register_count=0
_dot_gstack_register_opencode() {
  opencode_register_count=$((opencode_register_count + 1))
  _original_dot_gstack_register_opencode "$@"
}

if dot_gstack_register_all; then
  _pass "OpenCode: registration succeeds without Bun"
else
  _fail "OpenCode: registration succeeds without Bun"
fi

opencode_root="$fixture_home/.config/opencode/skills/gstack"
_assert_eq "OpenCode: does not invoke Bun" "" "$(cat "$bun_log" 2>/dev/null)"
_assert_eq "OpenCode: lightweight registration does not run upstream setup" \
  "" "$(cat "$setup_log" 2>/dev/null)"
_assert_file_exists "OpenCode: installs the root router" "$opencode_root/SKILL.md"
_assert_contains "OpenCode: keeps upstream's source skill name" \
  "name: qa" "$(cat "$fixture_home/.config/opencode/skills/gstack-qa/SKILL.md" 2>/dev/null)"
opencode_qa=$(cat "$fixture_home/.config/opencode/skills/gstack-qa/SKILL.md" 2>/dev/null)
opencode_qa_frontmatter=$(awk 'NR == 1 { next } /^---$/ { exit } { print }' \
  "$fixture_home/.config/opencode/skills/gstack-qa/SKILL.md")
_assert_contains "OpenCode: restores trigger-rich discovery description" \
  "Runs fixture QA checks when asked to validate the current behavior." \
  "$opencode_qa_frontmatter"
_assert_not_contains "OpenCode: strips Claude-only allowed-tools frontmatter" \
  "allowed-tools:" "$opencode_qa"
_assert_not_contains "OpenCode: strips Claude-only trigger frontmatter" \
  "triggers:" "$opencode_qa"
_assert_contains "OpenCode: preserves project-relative skill paths" \
  '.claude/skills/review/TODOS-format.md' "$opencode_qa"
_assert_contains "OpenCode: rewrites global review paths to its runtime root" \
  "$opencode_root/review/checklist.md" "$opencode_qa"
_assert_contains "OpenCode: rewrites gstack runtime paths to its runtime root" \
  "$opencode_root/bin/gstack-config" "$opencode_qa"
_assert_file_exists "OpenCode: links a retained generated skill" \
  "$fixture_home/.config/opencode/skills/gstack-qa/SKILL.md"
_assert_file_missing "OpenCode: honors the shared skill exclusion list" \
  "$fixture_home/.config/opencode/skills/gstack-browse/SKILL.md"
_assert_file_missing "OpenCode: omits the Codex self-wrapper" \
  "$fixture_home/.config/opencode/skills/gstack-codex/SKILL.md"
_assert_file_content "OpenCode: preserves an unmanaged skill collision" \
  "unmanaged" "$fixture_home/.config/opencode/skills/gstack-review/SKILL.md"
if [ ! -e "$fixture_home/.config/opencode/skills/gstack-old" ] &&
  [ ! -L "$fixture_home/.config/opencode/skills/gstack-old" ]; then
  _pass "OpenCode: prunes stale managed skill links"
else
  _fail "OpenCode: prunes stale managed skill links"
fi

_assert_file_exists "OpenCode: links the runtime bin directory" \
  "$opencode_root/bin/gstack-config"
_assert_file_missing "OpenCode: tolerates an initially absent design runtime" \
  "$opencode_root/design/dist/design"
_assert_file_exists "OpenCode: installs the complete review runtime manifest" \
  "$opencode_root/review/design-checklist.md"
_assert_file_exists "OpenCode: installs the Greptile review runtime asset" \
  "$opencode_root/review/greptile-triage.md"
_assert_file_exists "OpenCode: links review specialists" \
  "$opencode_root/review/specialists/testing.md"
_assert_file_exists "OpenCode: links QA templates" \
  "$opencode_root/qa/templates/default.md"
_assert_file_exists "OpenCode: links QA references" \
  "$opencode_root/qa/references/default.md"
_assert_file_exists "OpenCode: links the DX reference" \
  "$opencode_root/plan-devex-review/dx-hall-of-fame.md"

touch "$work/cache-probe"
dot_gstack_register_all
_assert_eq "OpenCode cache: skips the registration pass when inputs are unchanged" \
  "1" "$opencode_register_count"

mkdir -p "$gstack_dir/design/dist"
printf 'design\n' >"$gstack_dir/design/dist/design"
dot_gstack_register_all
_assert_file_exists "OpenCode cache: links a design runtime created after warmup" \
  "$opencode_root/design/dist/design"

rm -r "$gstack_dir/design/dist"
dot_gstack_register_all
if [ ! -e "$opencode_root/design" ] && [ ! -L "$opencode_root/design" ]; then
  _pass "OpenCode cache: removes a design runtime removed after warmup"
else
  _fail "OpenCode cache: removes a design runtime removed after warmup"
fi

sleep 1
cat >"$gstack_dir/qa/SKILL.md" <<'MD'
---
name: qa
description: refreshed OpenCode fixture
---
MD
dot_gstack_register_all
_assert_contains "OpenCode cache: a source skill update refreshes OpenCode" \
  "refreshed OpenCode fixture" \
  "$(cat "$fixture_home/.config/opencode/skills/gstack-qa/SKILL.md" 2>/dev/null)"
_assert_eq "OpenCode cache: source refresh still does not invoke Bun" \
  "" "$(cat "$bun_log" 2>/dev/null)"

rm -f "$gstack_dir/review/greptile-triage.md"
dot_gstack_register_all
if [ ! -e "$opencode_root/review/greptile-triage.md" ] &&
  [ ! -L "$opencode_root/review/greptile-triage.md" ]; then
  _pass "OpenCode: removes runtime assets dropped by upstream"
else
  _fail "OpenCode: removes runtime assets dropped by upstream"
fi

cache_file="$fixture_home/.gstack/.dotfiles-registration-cache-v1"
cache_before=$(cksum <"$cache_file")
cat >"$mock_bin/ln" <<'SH'
#!/usr/bin/env bash
for arg in "$@"; do
  case "$arg" in
    */.config/opencode/skills/gstack-qa) exit 1 ;;
  esac
done
exec "$GSTACK_OPENCODE_REAL_LN" "$@"
SH
chmod +x "$mock_bin/ln"
hash -r
sleep 1
printf '\nforced refresh\n' >>"$gstack_dir/qa/SKILL.md"
if dot_gstack_register_all; then
  _fail "OpenCode: a partial skill-link failure fails registration"
else
  _pass "OpenCode: a partial skill-link failure fails registration"
fi
_assert_eq "OpenCode: a partial install does not replace the current cache" \
  "$cache_before" "$(cksum <"$cache_file")"
rm -f "$mock_bin/ln"
hash -r
dot_gstack_register_all
_assert_file_exists "OpenCode: a later pass repairs a partial link failure" \
  "$fixture_home/.config/opencode/skills/gstack-qa/SKILL.md"

agent_removal_cache_before=$(cksum <"$cache_file")
cat >"$mock_bin/rm" <<'SH'
#!/usr/bin/env bash
for arg in "$@"; do
  case "$arg" in
    */.config/opencode/skills/gstack-qa) exit 1 ;;
  esac
done
exec "$GSTACK_OPENCODE_REAL_RM" "$@"
SH
chmod +x "$mock_bin/rm"
"$GSTACK_OPENCODE_REAL_RM" -f "$mock_bin/opencode"
hash -r
if _dot_gstack_has_agent opencode; then
  _fail "OpenCode: fixture models agent removal independently of the host"
else
  _pass "OpenCode: fixture models agent removal independently of the host"
fi
if dot_gstack_register_all; then
  _fail "OpenCode: an agent-removal failure fails registration"
else
  _pass "OpenCode: an agent-removal failure fails registration"
fi
_assert_eq "OpenCode: failed agent removal does not replace the current cache" \
  "$agent_removal_cache_before" "$(cksum <"$cache_file")"
"$GSTACK_OPENCODE_REAL_RM" -f "$mock_bin/rm"
hash -r
dot_gstack_register_all
_assert_file_missing "OpenCode: removes the managed root when the agent disappears" \
  "$opencode_root/SKILL.md"
_assert_file_missing "OpenCode: removes managed skills when the agent disappears" \
  "$fixture_home/.config/opencode/skills/gstack-qa/SKILL.md"
_assert_file_content "OpenCode: agent removal preserves unmanaged collisions" \
  "unmanaged" "$fixture_home/.config/opencode/skills/gstack-review/SKILL.md"

mkdir -p "$opencode_root"
printf 'private root\n' >"$opencode_root/SKILL.md"
ln -s "$gstack_dir/qa" "$fixture_home/.config/opencode/skills/gstack-upstream-owned"
cat >"$mock_bin/opencode" <<'SH'
#!/usr/bin/env bash
exit 0
SH
chmod +x "$mock_bin/opencode"
hash -r
dot_gstack_register_all
_assert_file_content "OpenCode: preserves an unmanaged runtime root" \
  "private root" "$opencode_root/SKILL.md"
_assert_file_exists "OpenCode: an unmanaged root keeps upstream-owned sibling skills" \
  "$fixture_home/.config/opencode/skills/gstack-upstream-owned/SKILL.md"

HOME=$saved_home
PATH=$saved_path
export HOME PATH
unset GSTACK_OPENCODE_BUN_LOG GSTACK_OPENCODE_SETUP_LOG
unset GSTACK_OPENCODE_REAL_LN GSTACK_OPENCODE_REAL_RM DOT_GSTACK_REGISTER_LIB
unset DOT_OPENCODE_COMMAND

_test_summary
