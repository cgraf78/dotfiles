#!/usr/bin/env bash
# zsh-completion-test — zsh completion startup behavior.

# shellcheck disable=SC1091 # dotfiles test helper lives under HOME.
. "$HOME/.local/lib/dot/tests/helpers.sh"

echo ""
echo "=== zsh completion init ==="

if ! command -v zsh >/dev/null 2>&1; then
  echo "  SKIP: zsh not installed"
  _test_summary
fi

TEST_TMPDIR=$(_tmpdir)
mkdir -p \
  "$TEST_TMPDIR/fpath" \
  "$TEST_TMPDIR/home/.local/share/zsh-users/zsh-autosuggestions"

echo "=== zsh compiled Git completion cache ==="

git_completion_source="$TEST_TMPDIR/git-source"
git_completion_cache="$TEST_TMPDIR/cache"
mkdir -p "$git_completion_source"
for old_version in 1 2 3; do
  old_dir="$git_completion_cache/shell/zsh-completions/old-version-$old_version/stale"
  mkdir -p "$old_dir"
  : >"$old_dir/_git.zwc"
  touch -t "20240101000${old_version}.00" "${old_dir%/stale}"
done
cat >"$git_completion_source/_git" <<'EOF'
#compdef git
print -r -- version-one
EOF

# shellcheck disable=SC2016 # inner zsh intentionally expands test variables.
cold_result=$(
  zsh -fc '
    HOME="$1/home"
    XDG_CACHE_HOME="$1/cache"
    fpath=("$1/git-source" $fpath)
    typeset TEST_ROOT="$1"
    zcompile() {
      print -r -- compile >>"$TEST_ROOT/compile-count"
      builtin zcompile "$@"
    }

    source "$2/.config/shell/interactive.d/54-tool-init.sh"
    source "$2/.config/shell/interactive.d/71-zsh-completion-cache.zsh"
    cache_dir="${fpath[1]}"
    printf "cold-cache=%s\n" "${fpath[1]}"
    autoload -Uz _git
    _git
    mode=$(zstat +mode "$cache_dir/_git.zwc")
    (( (mode & 077) == 0 )) && print cache-private=yes
  ' _ "$TEST_TMPDIR" "$HOME"
)
cold_compile_count=$(wc -l <"$TEST_TMPDIR/compile-count" | tr -d ' ')

# shellcheck disable=SC2016 # inner zsh intentionally expands test variables.
warm_result=$(
  zsh -fc '
    HOME="$1/home"
    XDG_CACHE_HOME="$1/cache"
    fpath=("$1/git-source" $fpath)
    typeset TEST_ROOT="$1"
    zcompile() {
      print -r -- compile >>"$TEST_ROOT/compile-count"
      builtin zcompile "$@"
    }

    source "$2/.config/shell/interactive.d/54-tool-init.sh"
    source "$2/.config/shell/interactive.d/71-zsh-completion-cache.zsh"
    autoload -Uz _git
    _git
  ' _ "$TEST_TMPDIR" "$HOME"
)
warm_compile_count=$(wc -l <"$TEST_TMPDIR/compile-count" | tr -d ' ')

zsh_version=$(zsh -fc 'print -r -- "$ZSH_VERSION"')
cache_base="$git_completion_cache/shell/zsh-completions/$zsh_version"
mkdir "$cache_base/.git-completion.stale"
: >"$cache_base/.git-completion.stale/partial"

cat >"$git_completion_source/_git.new" <<'EOF'
#compdef git
print -r -- version-two
EOF
touch -r "$git_completion_source/_git" "$git_completion_source/_git.new"
mv "$git_completion_source/_git.new" "$git_completion_source/_git"

# shellcheck disable=SC2016 # inner zsh intentionally expands test variables.
changed_result=$(
  zsh -fc '
    HOME="$1/home"
    XDG_CACHE_HOME="$1/cache"
    fpath=("$1/git-source" $fpath)
    typeset TEST_ROOT="$1"
    zcompile() {
      print -r -- compile >>"$TEST_ROOT/compile-count"
      builtin zcompile "$@"
    }

    source "$2/.config/shell/interactive.d/54-tool-init.sh"
    source "$2/.config/shell/interactive.d/71-zsh-completion-cache.zsh"
    autoload -Uz _git
    _git
  ' _ "$TEST_TMPDIR" "$HOME"
)
changed_compile_count=$(wc -l <"$TEST_TMPDIR/compile-count" | tr -d ' ')

cat >"$git_completion_source/_git.new" <<'EOF'
#compdef git
print -r -- version-tri
EOF
touch -r "$git_completion_source/_git" "$git_completion_source/_git.new"
mv "$git_completion_source/_git.new" "$git_completion_source/_git"

# shellcheck disable=SC2016 # inner zsh intentionally expands test variables.
failed_result=$(
  zsh -fc '
    HOME="$1/home"
    XDG_CACHE_HOME="$1/cache"
    fpath=("$1/git-source" $fpath)
    typeset TEST_ROOT="$1"
    zcompile() {
      print -r -- compile >>"$TEST_ROOT/compile-count"
      print -r -- partial >"$2"
      return 1
    }

    source "$2/.config/shell/interactive.d/54-tool-init.sh"
    source "$2/.config/shell/interactive.d/71-zsh-completion-cache.zsh"
    autoload -Uz _git
    _git
    printf "failed-cache-first=%s\n" "${fpath[1]}"
    cache_base="$XDG_CACHE_HOME/shell/zsh-completions/$ZSH_VERSION"
    print -r -- "$cache_base"/.git-completion.*(N)
    generations=("$cache_base"/*(N/))
    printf "generation-count=%s\n" "${#generations}"
  ' _ "$TEST_TMPDIR" "$HOME"
)
failed_compile_count=$(wc -l <"$TEST_TMPDIR/compile-count" | tr -d ' ')

_assert_contains "zsh completion cache: cold build takes fpath precedence" \
  "cold-cache=$git_completion_cache/shell/zsh-completions/" "$cold_result"
_assert_contains "zsh completion cache: cold build loads compiled function" \
  "version-one" "$cold_result"
_assert_eq "zsh completion cache: cold build compiles once" \
  "1" "$cold_compile_count"
_assert_contains "zsh completion cache: bytecode is owner-only" \
  "cache-private=yes" "$cold_result"
_assert_file_missing "zsh completion cache: oldest Zsh version is pruned" \
  "$git_completion_cache/shell/zsh-completions/old-version-1/stale/_git.zwc"
_assert_file_exists "zsh completion cache: recent alternate Zsh version is retained" \
  "$git_completion_cache/shell/zsh-completions/old-version-3/stale/_git.zwc"
_assert_contains "zsh completion cache: warm build loads compiled function" \
  "version-one" "$warm_result"
_assert_eq "zsh completion cache: warm build does not recompile" \
  "1" "$warm_compile_count"
_assert_contains "zsh completion cache: source replacement refreshes bytecode" \
  "version-two" "$changed_result"
_assert_eq "zsh completion cache: source identity change recompiles" \
  "2" "$changed_compile_count"
_assert_contains "zsh completion cache: compile failure falls back to source" \
  "version-tri" "$failed_result"
_assert_contains "zsh completion cache: failed refresh does not take precedence" \
  "failed-cache-first=$git_completion_source" "$failed_result"
_assert_eq "zsh completion cache: failed refresh attempts one compile" \
  "3" "$failed_compile_count"
_assert_not_contains "zsh completion cache: failed refresh leaves no temporary bytecode" \
  ".git-completion." "$failed_result"
_assert_contains "zsh completion cache: obsolete generations are removed" \
  "generation-count=1" "$failed_result"

cached_generation=$(printf '%s\n' "$cache_base"/*/)
# shellcheck disable=SC2016 # inner zsh intentionally expands test variables.
cached_result=$(
  zsh -fc '
    fpath=("$1" "$2")
    print -r -- "#compdef git" "print -r -- source-only" >"$2/_git"
    autoload -Uz _git
    _git
  ' _ "$cached_generation" "$git_completion_source"
)
_assert_contains "zsh completion cache: compiled artifact is actually loaded" \
  "version-two" "$cached_result"
_assert_not_contains "zsh completion cache: source fallback was not used" \
  "source-only" "$cached_result"

quiet_cache_root="$TEST_TMPDIR/not-a-directory"
: >"$quiet_cache_root"
quiet_result=$(
  XDG_CACHE_HOME="$quiet_cache_root" zsh -fc '
    fpath=("$1" $fpath)
    source "$2/.config/shell/interactive.d/54-tool-init.sh"
    source "$2/.config/shell/interactive.d/71-zsh-completion-cache.zsh"
    print -r -- "first=${fpath[1]}"
  ' _ "$git_completion_source" "$HOME" 2>&1
)
_assert_eq "zsh completion cache: unwritable cache fails open without noise" \
  "first=$git_completion_source" "$quiet_result"

cat >"$TEST_TMPDIR/fpath/compinit" <<'EOF'
(( COMPINIT_COUNT++ ))
typeset -gA _comps
EOF

cat >"$TEST_TMPDIR/home/.local/share/zsh-users/zsh-autosuggestions/zsh-autosuggestions.zsh" <<'EOF'
(( AUTOSUGGEST_MANUAL_AT_SOURCE = ${+ZSH_AUTOSUGGEST_MANUAL_REBIND} ))
_zsh_autosuggest_start() {
  (( AUTOSUGGEST_BIND_COUNT++ ))
  if (( ${+ZSH_AUTOSUGGEST_MANUAL_REBIND} )); then
    precmd_functions=("${(@)precmd_functions:#_zsh_autosuggest_start}")
  fi
}
(( precmd_functions[(I)_zsh_autosuggest_start] )) ||
  precmd_functions+=(_zsh_autosuggest_start)
EOF

# shellcheck disable=SC2016 # inner zsh intentionally expands test variables.
result=$(
  zsh -fc '
    fpath=("$1/fpath" $fpath)
    HOME="$1/home"
    _UNAME=Linux
    _tool_init() { :; }
    source "$2/.config/shell/interactive.d/70-integrations.zsh"
    source "$2/.config/shell/interactive.d/70-integrations.zsh"
    printf "compinit=%s\n" "${COMPINIT_COUNT:-0}"
  ' _ "$TEST_TMPDIR" "$HOME"
)

_assert_contains "zsh completion: re-source keeps compinit single-run" \
  "compinit=1" "$result"

# shellcheck disable=SC2016 # inner zsh intentionally expands test variables.
result=$(
  zsh -fc '
    HOME="$1/home"
    _UNAME=Linux
    _tool_init() { :; }
    typeset -ga precmd_functions=()
    source "$2/.config/shell/interactive.d/70-integrations.zsh"
    source "$2/.config/shell/interactive.d/70-integrations.zsh"
    printf "armed-hooks=%s\n" "${precmd_functions[(I)_zsh_autosuggest_start]}"
    _zsh_autosuggest_start
    printf "manual-at-source=%s\n" "${AUTOSUGGEST_MANUAL_AT_SOURCE:-0}"
    printf "bind-count=%s\n" "${AUTOSUGGEST_BIND_COUNT:-0}"
    printf "remaining-hooks=%s\n" "${precmd_functions[(I)_zsh_autosuggest_start]}"
  ' _ "$TEST_TMPDIR" "$HOME"
)

_assert_contains "zsh autosuggestions: manual rebind is enabled before plugin load" \
  "manual-at-source=1" "$result"
_assert_contains "zsh autosuggestions: re-source arms one bind hook" \
  "armed-hooks=1" "$result"
_assert_contains "zsh autosuggestions: first prompt still binds widgets" \
  "bind-count=1" "$result"
_assert_contains "zsh autosuggestions: first bind removes recurring prompt hook" \
  "remaining-hooks=0" "$result"

result=$(
  zsh -fc '
    emulate -L zsh
    __git_prompt_fd=""
    zle() { return 0; }
    __git_prompt() { :; }
    source "$1/.config/shell/interactive.d/60-prompt.zsh"
    exec {__git_prompt_fd}< <(:)
    __git_prompt_async_cancel
    printf "stderr-visible\n" >&2
  ' _ "$HOME" 2>&1
)

_assert_contains "zsh prompt: async cancel keeps stderr visible" \
  "stderr-visible" "$result"

_test_summary
