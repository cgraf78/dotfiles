#!/usr/bin/env bash
# Verify dotfiles' consumer boundary for git-tools.
#
# git-tools owns Git selection, stash, and worktree mechanics and exercises
# those workflows in its own test suite. Dotfiles owns only dependency
# activation, local fzf/editor policy, and the established short command names.
# Keeping this suite at that boundary prevents the provider implementation from
# being tested twice while still catching every integration drift that could
# break an interactive shell after `dot update`.

set -o pipefail
export NO_COLOR=1

SOURCE_HOME="${DOT_TEST_SOURCE_HOME:-$HOME}"

# shellcheck source=helpers.sh
. "$SOURCE_HOME/.local/lib/dot/tests/helpers.sh"

_test_use_host_shdeps
SHDEPS_CONF_DIR="$SOURCE_HOME/.config/shdeps"
export SHDEPS_CONF_DIR

# Resolve the installed provider through the same public Shdeps contract used
# at runtime. The override exists only for cross-repository development.
git_tools_shell="${DOT_TEST_GIT_TOOLS_SHELL:-}"
if [[ -z "$git_tools_shell" ]]; then
  git_tools_shell=$(
    shdeps dep-file cgraf78/git-tools share/git-tools/shell.sh 2>/dev/null
  ) || git_tools_shell=""
fi
if [[ ! -r "$git_tools_shell" ]]; then
  _fail "git-tools shell provider is available (file not found: $git_tools_shell)"
  _test_summary
fi

# Source the production order: consumer hooks and aliases are defined before
# the provider, allowing git-tools to preserve the supplied presentation hooks.
# shellcheck disable=SC1090
. "$SOURCE_HOME/.config/shell/interactive.d/56-dot.sh"
# shellcheck disable=SC1090
. "$SOURCE_HOME/.config/shell/interactive.d/57-git-tools.sh"
# shellcheck disable=SC1090
. "$git_tools_shell"

echo "=== git-tools activation ownership ==="

_assert_eq "resolved git-tools provider publishes its loaded marker" \
  "1" "${GIT_TOOLS_SHELL_LOADED:-}"
_assert_file_missing "retired fzf Git implementation stays removed" \
  "$SOURCE_HOME/.config/shell/interactive.d/57-fzf-git.sh"
_assert_file_missing "retired worktree implementation stays removed" \
  "$SOURCE_HOME/.config/shell/interactive.d/57-git-worktree.sh"

for loader in 70-integrations.bash 70-integrations.zsh; do
  loader_content=$(cat "$SOURCE_HOME/.config/shell/interactive.d/$loader")
  _assert_contains "$loader declares the cached git-tools integration" \
    "_tool_init git-tools _tool_shdeps_source_emit" "$loader_content"
  _assert_contains "$loader resolves the provider through shdeps" \
    "cgraf78/git-tools share/git-tools/shell.sh" "$loader_content"
done

for function_name in \
  git_tools_fzf_preview git_tools_fzf_pick git_tools_edit_file \
  gbr glo gst gstash _worktree_root gw gwl gwd gwp; do
  if declare -F "$function_name" >/dev/null; then
    _pass "dotfiles adapter function exists: $function_name"
  else
    _fail "dotfiles adapter function exists: $function_name"
  fi
done

_assert_eq "dotfiles keeps its established worktree parent policy" \
  "$HOME/worktrees" "$GIT_TOOLS_WORKTREE_PARENT"

echo
echo "=== git-tools presentation hooks ==="

adapter_log=$(_tmpdir)/adapter.log
fzf() {
  printf 'fzf' >"$adapter_log"
  printf ' <%s>' "$@" >>"$adapter_log"
  printf '\n' >>"$adapter_log"
}
_edit_file() {
  printf 'edit' >"$adapter_log"
  printf ' <%s>' "$@" >>"$adapter_log"
  printf '\n' >>"$adapter_log"
}

git_tools_fzf_preview --prompt="branch> "
_assert_file_content "preview hook adds dotfiles' large fzf layout" \
  "fzf <--height> <70%> <--reverse> <--preview-window=bottom,60%,border-top> <--prompt=branch> >" \
  "$adapter_log"

git_tools_fzf_pick --prompt="worktree> "
_assert_file_content "picker hook adds dotfiles' compact fzf layout" \
  "fzf <--height> <40%> <--reverse> <--prompt=worktree> >" \
  "$adapter_log"

git_tools_edit_file "path with spaces" 42
_assert_file_content "editor hook preserves every provider argument" \
  "edit <path with spaces> <42>" "$adapter_log"

echo
echo "=== git-tools short command forwarding ==="

# Redefine only the provider entry points. The public aliases must remain thin
# pass-throughs so Git behavior continues to have exactly one implementation.
_provider_call() {
  local name="$1"
  shift
  printf '%s' "$name" >"$adapter_log"
  printf ' <%s>' "$@" >>"$adapter_log"
  printf '\n' >>"$adapter_log"
}
git_tools_fzf_branch() { _provider_call branch "$@"; }
git_tools_fzf_log() { _provider_call log "$@"; }
git_tools_fzf_status() { _provider_call status "$@"; }
git_tools_fzf_stash() { _provider_call stash "$@"; }
git_tools_worktree_root() { _provider_call root "$@"; }
git_tools_worktree() { _provider_call worktree "$@"; }
git_tools_worktree_list() { _provider_call list "$@"; }
git_tools_worktree_remove() { _provider_call remove "$@"; }
git_tools_worktree_prune() { _provider_call prune "$@"; }

_assert_forwarding() {
  local description="$1" expected="$2" command_name="$3"
  shift 3
  "$command_name" "$@"
  _assert_file_content "$description" "$expected" "$adapter_log"
}

_assert_forwarding "gbr forwards arguments unchanged" \
  "branch <feature branch> <--remote>" gbr "feature branch" --remote
_assert_forwarding "glo forwards arguments unchanged" \
  "log <--all> <two words>" glo --all "two words"
_assert_forwarding "gst forwards arguments unchanged" \
  "status <path with spaces>" gst "path with spaces"
_assert_forwarding "gstash forwards arguments unchanged" \
  "stash <stash@{2}>" gstash 'stash@{2}'
_assert_forwarding "_worktree_root forwards arguments unchanged" \
  "root <custom root>" _worktree_root "custom root"
_assert_forwarding "gw forwards arguments unchanged" \
  "worktree <topic/name> <main>" gw topic/name main
_assert_forwarding "gwl forwards arguments unchanged" \
  "list <--query> <topic branch>" gwl --query "topic branch"
_assert_forwarding "gwd forwards arguments unchanged" \
  "remove <topic/name>" gwd topic/name
_assert_forwarding "gwp forwards arguments unchanged" \
  "prune <--dry-run>" gwp --dry-run

if command -v zsh >/dev/null 2>&1; then
  zsh_result=$(
    SOURCE_HOME="$SOURCE_HOME" \
      GIT_TOOLS_TEST_PROVIDER="$git_tools_shell" \
      zsh -dfc '
        set -e
        source "$SOURCE_HOME/.config/shell/interactive.d/56-dot.sh"
        source "$SOURCE_HOME/.config/shell/interactive.d/57-git-tools.sh"
        source "$GIT_TOOLS_TEST_PROVIDER"
        for name in git_tools_fzf_preview git_tools_fzf_pick \
          git_tools_edit_file gbr glo gst gstash _worktree_root gw gwl gwd gwp; do
          typeset -f "$name" >/dev/null
        done
        [[ "$GIT_TOOLS_WORKTREE_PARENT" == "$HOME/worktrees" ]]
        print -r -- ok
      '
  )
  _assert_eq "zsh loads the same adapter and provider surface" ok "$zsh_result"
else
  echo "  SKIP: zsh not installed"
fi

_test_summary
