_assert_exit "literal -m double-quoted: extracts" 0 $?
_assert_contains "literal -m double-quoted: content" "Fix the thing" "$__EXT_OUT"

__EXT_OUT=$(_hook_extract_literal_m "sl commit -m 'Fix the thing'")
_assert_exit "literal -m single-quoted: extracts" 0 $?
_assert_contains "literal -m single-quoted: content" "Fix the thing" "$__EXT_OUT"

_hook_extract_literal_m 'sl amend' >/dev/null 2>&1
_assert_exit "no -m flag: returns 1" 1 $?

# End-to-end: literal -m with bad message through validator
