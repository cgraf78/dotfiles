echo "=== Agent hook: guard condition ==="

# Replicate the agent hook's guard check (head -1 restricts to command line)
_hook_should_validate() {
  local first_line
  first_line=$(printf '%s' "$1" | head -1)
  printf '%s' "$first_line" | grep -qE '\bsl (commit|amend|metaedit)\b' &&
    printf '%s' "$first_line" | grep -qE ' -[ml] | -[ml]$|<<'
}

_hook_should_validate 'sl commit -m "message"'
_assert_exit "guard: sl commit -m triggers" 0 $?

_hook_should_validate 'sl amend -m "message"'
_assert_exit "guard: sl amend -m triggers" 0 $?

_hook_should_validate 'sl metaedit -m "message"'
_assert_exit "guard: sl metaedit -m triggers" 0 $?

_hook_should_validate "sl commit -m \"\$(cat <<'EOF'
message
EOF
)\""
_assert_exit "guard: sl commit with heredoc triggers" 0 $?

_hook_should_validate 'sl amend'
_assert_exit "guard: sl amend without -m skips" 1 $?

_hook_should_validate 'sl commit'
_assert_exit "guard: sl commit without -m skips" 1 $?

# Heredoc content mentioning sl commit should NOT trigger (head -1 fix)
_hook_should_validate "git -C /tmp/repo commit -F /dev/stdin <<'EOF'
sl commit -m something
EOF"
_assert_exit "guard: git commit with sl in heredoc body skips" 1 $?

# "sl commit" in -m message text matches the guard, but this is harmless:
# heredoc/file extraction yields nothing, so validation is skipped entirely.
_hook_should_validate 'git commit -m "update sl commit hook"'
_assert_exit "guard: git commit mentioning sl in msg matches (harmless)" 0 $?

