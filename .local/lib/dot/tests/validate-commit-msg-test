echo "=== Agent hook: literal -m extraction ==="

# Replicate the agent hook's literal -m fallback extraction
_hook_extract_literal_m() {
  local cmd="$1"
  if printf '%s' "$cmd" | head -1 | grep -qE ' -m '; then
    printf '%s\n' "$cmd" | sed -n '1s/.*-m[[:space:]]*"\(.*\)"/\1/p; 1s/.*-m[[:space:]]*'"'"'\(.*\)'"'"'/\1/p'
    return 0
  fi
  return 1
}

