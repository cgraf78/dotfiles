echo "=== Agent hook: heredoc extraction ==="

# Replicate the agent hook's heredoc extraction logic
_hook_extract_heredoc() {
  local cmd="$1"
  local delim
  delim=$(printf '%s\n' "$cmd" | sed -nE "s/.*<<-?'?([A-Za-z_][A-Za-z0-9_]*)'?.*/\1/p" | head -1)
  if [ -n "$delim" ]; then
    printf '%s\n' "$cmd" | awk -v delim="$delim" '
      index($0, "<<") && $0 ~ delim { in_doc = 1; next }
      in_doc && $0 ~ "^[[:space:]]*" delim "[[:space:]]*$" { exit }
      in_doc { print }
    '
    return 0
  fi
  return 1
}

