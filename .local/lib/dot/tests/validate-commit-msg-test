# ===========================================================================
# Agent hook: -l FILE extraction
# ===========================================================================

echo "=== Agent hook: -l FILE extraction ==="

# Replicate the agent hook's -l file extraction logic
_hook_extract_file() {
  local cmd="$1"
  if printf '%s' "$cmd" | grep -qE ' -l '; then
    local mfile
    mfile=$(printf '%s' "$cmd" | sed -n 's/.*-l[[:space:]]\{1,\}\([^[:space:]]\{1,\}\).*/\1/p' | head -1)
    if [ -n "$mfile" ] && [ -f "$mfile" ]; then
      cat "$mfile"
      return 0
    fi
  fi
  return 1
}

