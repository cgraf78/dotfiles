#!/usr/bin/env bash
# core-test — unit tests for the dot dotfiles manager.
#
# Creates temp directories with mock git repos to test command routing,
# overlay handling, normalize/filtered logic, and merge scripts.
#
# Usage:
#   dot-test core              run all core shards
#   DOT_CORE_SHARD=all ./core-test
#   DOT_CORE_SHARD=main ./core-test
#   DOT_CORE_SHARD=overlays ./core-test
#   DOT_CORE_SHARD=merges ./core-test
#   DOT_CORE_SHARD=launchers ./core-test
#   DOT_CORE_SHARD=cron-config ./core-test
#   DOT_CORE_SHARD=doctor ./core-test
#   DOT_CORE_SHARD=pull ./core-test
#   DOT_CORE_SHARD=reexec ./core-test
#   DOT_CORE_SHARD=static ./core-test
#   DOT_CORE_SHARD=update ./core-test

set -o pipefail
export NO_COLOR=1

# Formatter/linter dev tooling is expected to come from the global
# mise toolset, so seed the shim dir explicitly for direct test runs.
[ -d "$HOME/.local/share/mise/shims" ] &&
  PATH="$HOME/.local/share/mise/shims:$PATH"
export MISE_GLOBAL_CONFIG_FILE="$HOME/.config/mise/config.toml"

# shellcheck disable=SC2034
# Sourced core modules use BIN_DIR to exercise the PATH-visible launchers.
BIN_DIR="${HOME}/.local/bin"
REAL_HOME="$HOME"
DEPENDENCY_HOME="${DOT_TEST_HOST_HOME:-$REAL_HOME}"

# shellcheck source=helpers.sh
. "$HOME/.local/lib/dot/tests/helpers.sh"
_test_prefer_system_git || exit 1
# shellcheck source=fixtures.sh
. "$HOME/.local/lib/dot/tests/fixtures.sh"

_test_prepare_shdeps_snapshot "$REAL_HOME" "$DEPENDENCY_HOME" || exit 1

_core_shard="${DOT_CORE_SHARD:-main}"
_core_run_main=false
_core_run_ui=false
_core_run_overlays=false
_core_run_merges=false
_core_run_launchers=false
_core_run_cron_config=false
_core_run_doctor=false
_core_run_commands=false
_core_run_pull=false
_core_run_reexec=false
_core_run_update=false
case "$_core_shard" in
  all)
    _core_run_main=true
    _core_run_ui=true
    _core_run_overlays=true
    _core_run_merges=true
    _core_run_launchers=true
    _core_run_cron_config=true
    _core_run_doctor=true
    _core_run_commands=true
    _core_run_pull=true
    _core_run_reexec=true
    _core_run_update=true
    ;;
  main)
    _core_run_main=true
    _core_run_ui=true
    ;;
  overlays)
    _core_run_overlays=true
    ;;
  merges)
    _core_run_merges=true
    ;;
  launchers)
    _core_run_launchers=true
    ;;
  cron-config)
    _core_run_cron_config=true
    ;;
  doctor)
    _core_run_doctor=true
    ;;
  commands)
    _core_run_commands=true
    _core_run_pull=true
    _core_run_reexec=true
    _core_run_update=true
    ;;
  pull)
    _core_run_commands=true
    _core_run_pull=true
    ;;
  reexec)
    _core_run_commands=true
    _core_run_reexec=true
    ;;
  static)
    # runner.sh executes before static.sh, whose DOT_CORE_STATIC_ONLY path exits
    # before fixture setup. Keeping this as a real empty shard therefore
    # suppresses duplicate runner coverage after the static checks finish; the
    # ordinary core-test suite remains the single owner in full dot-test runs.
    ;;
  update)
    _core_run_commands=true
    _core_run_update=true
    ;;
  *)
    echo "unknown DOT_CORE_SHARD: $_core_shard" >&2
    exit 2
    ;;
esac

CORE_TEST_MODULE_DIR="$HOME/.local/lib/dot/tests/core"
# shellcheck source=core/runner.sh
. "$CORE_TEST_MODULE_DIR/runner.sh"
# shellcheck source=core/static.sh
. "$CORE_TEST_MODULE_DIR/static.sh"
# shellcheck source=core/main.sh
. "$CORE_TEST_MODULE_DIR/main.sh"
# shellcheck source=core/overlays.sh
. "$CORE_TEST_MODULE_DIR/overlays.sh"
# shellcheck source=core/merges.sh
. "$CORE_TEST_MODULE_DIR/merges.sh"
# shellcheck source=core/launchers.sh
. "$CORE_TEST_MODULE_DIR/launchers.sh"
# shellcheck source=core/doctor.sh
. "$CORE_TEST_MODULE_DIR/doctor.sh"
# shellcheck source=core/commands.sh
. "$CORE_TEST_MODULE_DIR/commands.sh"
# shellcheck source=core/cron.sh
. "$CORE_TEST_MODULE_DIR/cron.sh"

dot_core_setup() {
  dot_fixture_home
  dot_fixture_base_repo
  dot_fixture_copy_core
  dot_fixture_shdeps_config
  dot_fixture_seed_base_file

  # ---------------------------------------------------------------------------
  # Tests: init.sh setup
  # ---------------------------------------------------------------------------

  echo "=== init.sh setup ==="

  # Bootstrap shdeps for in-process tests that need platform/host filtering
  # (overlay discovery, cron filter directives).
  dot_fixture_source_core_init

  _assert_eq "DOTFILES points to bare repo" "$TEST_HOME/.dotfiles" "$DOTFILES"
  _assert_contains "GIT uses bare repo" "--git-dir=$DOTFILES" "$GIT"
  _assert_contains "GIT uses HOME as worktree" "--work-tree=$TEST_HOME" "$GIT"

  # Several shards need branch metadata even when the launcher tests are skipped.
  # shellcheck disable=SC2034
  DEFAULT_BRANCH=$($GIT branch --show-current 2>/dev/null || echo "master")

  if ! $_core_run_overlays &&
    { $_core_run_doctor || $_core_run_commands || $_core_run_launchers; } &&
    [[ ! -f "$TEST_HOME/.config/dot/overlays.d/10-work.conf" ]]; then
    mkdir -p "$TEST_HOME/.config/dot/overlays.d"
    cat >"$TEST_HOME/.config/dot/overlays.d/10-work.conf" <<'CONF'
url=git@example.com:work.git
CONF
  fi

  if $_core_run_doctor; then
    mkdir -p "$TEST_HOME/.config/dot/merge-hooks.d" "$TEST_HOME/.config/dot/overlays.d"
  fi

  if $_core_run_cron_config; then
    mkdir -p "$TEST_HOME/.config/dot/merge-hooks.d"
  fi
}

if $_core_run_main; then
  dot_core_test_runner
fi

if [[ "${DOT_CORE_SKIP_STATIC:-0}" != "1" ]]; then
  dot_core_test_static
fi

dot_core_setup

if $_core_run_ui; then
  dot_core_test_main
fi

if $_core_run_overlays; then
  dot_core_test_overlays
fi

if $_core_run_merges; then
  dot_core_test_merges
fi

if $_core_run_launchers; then
  dot_core_test_launchers
fi

if $_core_run_doctor; then
  dot_core_test_doctor
fi

if $_core_run_commands; then
  dot_core_test_commands
fi

if $_core_run_cron_config; then
  dot_core_test_cron
fi

_test_summary
