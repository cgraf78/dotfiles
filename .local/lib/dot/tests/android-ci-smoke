#!/usr/bin/env bash
# android-ci-smoke — validate Android-specific dotfiles policy in real Termux.

set -o pipefail

fail() {
  printf 'FAIL: %s\n' "$1" >&2
  exit 1
}

[[ "${PREFIX:-}" == *com.termux*/usr ]] || fail "PREFIX is not a Termux prefix"
[[ "$(uname -o)" == "Android" ]] || fail "uname does not report Android"
command -v pkg >/dev/null || fail "Termux pkg command is unavailable"

root=${DOTFILES_ROOT:-$PWD}
toolchains="$root/.config/shdeps/00-toolchains.conf"
deps="$root/.config/shdeps/10-deps.conf"

[[ -r "$toolchains" && -r "$deps" ]] || fail "shdeps configuration is unavailable"

awk '$1 == "cargo" && $2 == "pkg" && $0 ~ /android:rust/ { found = 1 }
     END { exit !found }' "$toolchains" ||
  fail "Rust toolchain lacks its Android package mapping"
awk '$1 == "uv" && $2 == "pkg" && $0 ~ /os:macos,os:android/ { found = 1 }
     END { exit !found }' "$toolchains" ||
  fail "uv lacks its Android package policy"
awk '$1 == "fd" && $2 == "pkg" && $0 ~ /android:fd/ { found = 1 }
     END { exit !found }' "$deps" ||
  fail "fd lacks its Android package mapping"
awk '$1 == "ast-grep/ast-grep" && $2 == "github:release" && $0 ~ /os:!android/ { found = 1 }
     END { exit !found }' "$deps" ||
  fail "ast-grep release fallback is not excluded on unsupported Android"
awk '$1 == "neovim/neovim" && $2 == "custom" && $0 !~ /os:!android/ { found = 1 }
     END { exit !found }' "$deps" ||
  fail "Neovim custom installer is not enabled on Android"
awk '$1 == "watchexec" && $2 == "pkg" &&
       $0 ~ /os:macos,os:android/ { found = 1 }
     END { exit !found }' "$deps" ||
  fail "Watchexec lacks its Android package policy"
awk '$1 == "watchexec\/watchexec" && $2 == "github" &&
       $0 ~ /os:!macos,os:!android/ { found = 1 }
     END { exit !found }' "$deps" ||
  fail "Watchexec GitHub install is not excluded on Android"
awk '$1 == "fujiapple852\/trippy" && $2 == "github" &&
       $0 ~ /os:!macos,os:!android/ { found = 1 }
     END { exit !found }' "$deps" ||
  fail "Trippy GitHub install is not excluded on Android"
awk '$1 == "ClementTsang\/bottom" && $2 == "github" &&
       $0 ~ /os:!macos,os:!android/ { found = 1 }
     END { exit !found }' "$deps" ||
  fail "Bottom GitHub install is not excluded on Android"
awk '$1 == "cgraf78\/hive-memory" && $2 == "github" &&
       $0 ~ /os:!android/ { found = 1 }
     END { exit !found }' "$deps" ||
  fail "Hive Memory GitHub install is not excluded on Android"

command -v nvim >/dev/null || fail "Termux Neovim package did not provide nvim"
nvim --version 2>&1 | awk 'NR == 1 && $1 == "NVIM" { found = 1 }
                           END { exit !found }' ||
  fail "Termux Neovim binary does not run"
PATH="$root/.local/bin:$PATH" NVIM_LAUNCHER_FORCE_NEW=1 nvim --version 2>&1 |
  awk 'NR == 1 && $1 == "NVIM" { found = 1 }
       END { exit !found }' ||
  fail "dotfiles nvim launcher does not delegate on Android"

command -v watchexec >/dev/null || fail "dot update did not install Watchexec"
watchexec --version >/dev/null 2>&1 ||
  fail "Termux Watchexec binary does not run"

printf 'Android Termux developer tool policy smoke passed\n'
