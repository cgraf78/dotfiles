#!/usr/bin/env bash
# gstack-register-test - dotfiles policy and provider activation boundary.

set -o pipefail
export NO_COLOR=1

# shellcheck source=helpers.sh
. "$HOME/.local/lib/dot/tests/helpers.sh"

source_home=$HOME
deps="$source_home/.config/shdeps/10-deps.conf"
shdeps_hook="$source_home/.config/shdeps/hooks.d/garrytan/gstack.sh"
merge_hook="$source_home/.local/lib/dot/core/merge-hooks/gstack.sh"

dependency_order=$(
  awk '$1 == "cgraf78/gstack-register" || $1 == "garrytan/gstack" {
    print $1 " " $2
  }' "$deps"
)
_assert_eq "gstack ownership: provider installs before upstream checkout" \
  $'cgraf78/gstack-register github\ngarrytan/gstack github' \
  "$dependency_order"

_assert_file_exists "gstack policy: XDG exclusion file is tracked" \
  "$source_home/.config/gstack-register/skills-exclude"
_assert_file_missing "gstack policy: dot-private exclusion path is retired" \
  "$source_home/.config/dot/gstack-skills-exclude"

consumer_implementation=$(
  git -C "$source_home" ls-files -- .local/lib/dot/gstack-register 2>/dev/null || true
)
_assert_eq "gstack ownership: reusable implementation is absent from dotfiles" \
  "" "$consumer_implementation"

work=$(_tmpdir)
fixture_home="$work/home"
mock_bin="$work/bin"
call_log="$work/gstack-register.log"
mkdir -p "$fixture_home/.local/share/garrytan/gstack" "$mock_bin"

cat >"$mock_bin/gstack-register" <<'SH'
#!/usr/bin/env bash
: "${DOT_TEST_GSTACK_REGISTER_LOG:?}"
printf '%s\n' "$*" >>"$DOT_TEST_GSTACK_REGISTER_LOG"
exit "${DOT_TEST_GSTACK_REGISTER_STATUS:-0}"
SH
chmod +x "$mock_bin/gstack-register"

saved_home=$HOME
saved_path=$PATH
HOME=$fixture_home
PATH="$mock_bin:/usr/bin:/bin"
export HOME PATH
export DOT_TEST_GSTACK_REGISTER_LOG=$call_log

# shellcheck source=/dev/null
. "$shdeps_hook"
: >"$call_log"
post "garrytan/gstack"
uninstall "garrytan/gstack"
_assert_file_content "gstack shdeps adapter: dispatches sync and uninstall" \
  $'sync\nuninstall' "$call_log"

DOT_TEST_GSTACK_REGISTER_STATUS=17
export DOT_TEST_GSTACK_REGISTER_STATUS
set +e
post "garrytan/gstack"
post_status=$?
set -e
_assert_exit "gstack shdeps adapter: preserves provider failure" 17 "$post_status"
unset DOT_TEST_GSTACK_REGISTER_STATUS

# shellcheck source=/dev/null
. "$merge_hook"
: >"$call_log"
merge
merge
_assert_file_content "gstack merge adapter: reconciles on every dot update" \
  $'sync\nsync' "$call_log"

DOT_TEST_GSTACK_REGISTER_STATUS=19
export DOT_TEST_GSTACK_REGISTER_STATUS
set +e
merge
merge_status=$?
set -e
_assert_exit "gstack merge adapter: preserves provider failure" 19 "$merge_status"
unset DOT_TEST_GSTACK_REGISTER_STATUS

# Partial installs and isolated merge-hook runs may not have exposed the
# provider command. The upstream post hook remains the authoritative first
# registration pass once shdeps installs both dependencies.
: >"$call_log"
PATH=/usr/bin:/bin
hash -r
if merge; then
  _pass "gstack merge adapter: missing provider is a safe no-op"
else
  _fail "gstack merge adapter: missing provider is a safe no-op"
fi
_assert_file_content "gstack merge adapter: missing provider launches nothing" \
  "" "$call_log"

HOME=$saved_home
PATH=$saved_path
export HOME PATH
unset DOT_TEST_GSTACK_REGISTER_LOG
unset -f post uninstall merge

_test_summary
