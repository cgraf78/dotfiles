# ---------------------------------------------------------------------------
# Tests: bare dotfiles repo performance guard
# ---------------------------------------------------------------------------

echo "=== Bare dotfiles repo: untracked HOME walk skipped ==="

repo=$(_tmpdir)
bare="$repo/.dotfiles"
mock_bin=$(_mock_bin)
record="$repo/sley-env"
mkdir -p "$repo/.config/lazygit"
git init -q --bare "$bare"
cat >"$mock_bin/sley" <<EOF
#!/usr/bin/env bash
# Record only the readiness invocation. SLEY_SKIP_UNTRACKED tunes the untracked
# file walk, which is exclusive to the readiness/file-scan path. The commit-msg
# hook makes a separate secrets-message-file call that scans message text only
# (no untracked walk), so it neither sets nor needs the var.
[ "\$1" = ready ] && printf '%s\n' "\${SLEY_SKIP_UNTRACKED:-unset}" >"$record"
exit 0
EOF
chmod +x "$mock_bin/sley"
cat >"$repo/.config/lazygit/config.yml" <<'EOF'
git:
  pagers: []
EOF
_git_set_test_identity \
  env GIT_DIR="$bare" GIT_WORK_TREE="$repo" GIT_CONFIG_GLOBAL="$repo/.gitconfig-test" git
env GIT_DIR="$bare" GIT_WORK_TREE="$repo" GIT_CONFIG_GLOBAL="$repo/.gitconfig-test" \
  git config core.hooksPath "$HOOK_DIR"
env GIT_DIR="$bare" GIT_WORK_TREE="$repo" GIT_CONFIG_GLOBAL="$repo/.gitconfig-test" \
  git config commit.gpgsign false
env GIT_DIR="$bare" GIT_WORK_TREE="$repo" GIT_CONFIG_GLOBAL="$repo/.gitconfig-test" \
  git add .config/lazygit/config.yml
__COMMIT_OUT=$(
  cd "$repo" &&
    env "${_NO_AGENT_ENV[@]}" \
      GIT_DIR="$bare" \
      GIT_WORK_TREE="$repo" \
      GIT_CONFIG_GLOBAL="$repo/.gitconfig-test" \
      PATH="$mock_bin:$PATH" \
      git commit -m "bare-home" 2>&1
)
__COMMIT_RC=$?
_assert_exit "bare dotfiles repo: commit succeeds" 0 "$__COMMIT_RC"
_assert_file_content "bare dotfiles repo: SLEY_SKIP_UNTRACKED=1" "1" "$record"

