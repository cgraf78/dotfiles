# A clean message commits, and the scan still ran.
repo=$(_new_repo)
printf 'code\n' >"$repo/f.txt"
(cd "$repo" && git add f.txt)
_commit "$repo" "add a feature" PATH="$mock_ss:$PATH" MOCK_SECRETS_RC=0
_assert_exit "commit-msg: clean message commits" 0 "$__COMMIT_RC"
_assert_contains "commit-msg: clean commit still ran the scan" \
  "mock-secrets-args=secrets --message-file" "$__COMMIT_OUT"

# The secrets scan must not swallow validate-commit-msg's blocking exit: a
# title >100 chars is a validate hard error, and a clean secrets scan (rc 0)
# must still let that failure block the commit.
repo=$(_new_repo)
printf 'code\n' >"$repo/f.txt"
(cd "$repo" && git add f.txt)
_long_title="this commit title is deliberately far too long to be acceptable and comfortably exceeds the one hundred character hard limit"
_commit "$repo" "$_long_title" PATH="$mock_ss:$PATH" MOCK_SECRETS_RC=0
_assert_exit "commit-msg: clean scan still lets a validate hard error block" 1 "$__COMMIT_RC"

# GITHOOK_COMMITMSG_SKIP bypasses the whole hook, including the scan.
repo=$(_new_repo)
printf 'code\n' >"$repo/f.txt"
(cd "$repo" && git add f.txt)
_commit "$repo" "add a feature" PATH="$mock_ss:$PATH" MOCK_SECRETS_RC=1 GITHOOK_COMMITMSG_SKIP=1
_assert_exit "commit-msg: GITHOOK_COMMITMSG_SKIP bypasses the scan" 0 "$__COMMIT_RC"

