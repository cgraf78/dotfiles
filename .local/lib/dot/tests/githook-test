#!/usr/bin/env bash
# githook-test — unit tests for the shared git hooks.
#
# shellcheck disable=SC2030,SC2031 # git config env is intentionally scoped to fixture subshells.
#
# Covers the shared Git hook directory. Each test spins up an isolated temp git
# repo with `core.hooksPath` aimed at the hook under test, so the suite is safe
# to run anywhere without touching the user's real repos.
#
# Usage: githook-test

set -o pipefail
export NO_COLOR=1
SOURCE_HOME="$HOME"

# Formatter/linter dev tooling is expected to come from the global
# mise toolset, so seed the shim dir explicitly for direct test runs
# (matches the pattern used by autoformat-test / autolint-test).
# On macOS, brew binaries are signed and must take priority over
# unsigned mise downloads that macOS Gatekeeper kills.
[ -d "$SOURCE_HOME/.local/share/mise/shims" ] &&
  PATH="$SOURCE_HOME/.local/share/mise/shims:$PATH"
[ -d "/opt/homebrew/bin" ] &&
  PATH="/opt/homebrew/bin:$PATH"
export MISE_GLOBAL_CONFIG_FILE="$SOURCE_HOME/.config/mise/config.toml"

# shellcheck source=helpers.sh
. "$SOURCE_HOME/.local/lib/dot/tests/helpers.sh"

_require_compatible_libc "githook-test"

HOOK_DIR="$SOURCE_HOME/.local/share/git-hooks"
DEPENDENCY_HOME="${DOT_TEST_HOST_HOME:-$SOURCE_HOME}"
# This suite tests the hooks, not the dotfiles-aware Git launcher. Keep Git's
# login-shell and SCM telemetry state inside a fixture HOME, while reading the
# real dotfiles tool policy and installed Mise toolchain.
_mock_home
XDG_CONFIG_HOME="$SOURCE_HOME/.config"
XDG_CACHE_HOME="$HOME/.cache"
XDG_STATE_HOME="$HOME/.local/state"
XDG_DATA_HOME="$HOME/.local/share"
MISE_DATA_DIR="$DEPENDENCY_HOME/.local/share/mise"
MISE_STATE_DIR="$DEPENDENCY_HOME/.local/state/mise"
MISE_CACHE_DIR="$DEPENDENCY_HOME/.cache/mise"
CHECKRUN_CONFIG_DIR="$SOURCE_HOME/.config/checkrun"
DOT_GIT_REAL=1
export XDG_CONFIG_HOME XDG_CACHE_HOME XDG_STATE_HOME XDG_DATA_HOME
export MISE_DATA_DIR MISE_STATE_DIR MISE_CACHE_DIR CHECKRUN_CONFIG_DIR
export DOT_GIT_REAL

# Tests that deliberately copy the tracked Git launcher to an isolated PATH
# still need its fallback library after HOME moves away from the source tree.
mkdir -p "$HOME/.local/lib/dot/core"
ln -s "$SOURCE_HOME/.local/lib/dot/launcher-real.sh" \
  "$HOME/.local/lib/dot/launcher-real.sh"
ln -s "$SOURCE_HOME/.local/lib/dot/core/xdg.sh" \
  "$HOME/.local/lib/dot/core/xdg.sh"

echo "=== hook test runtime isolation ==="
case "$HOME/" in
  "$_DOT_TEST_TMP_ROOT/"*) _pass "hook runtime: HOME is suite-local" ;;
  *) _fail "hook runtime: HOME is suite-local" ;;
esac
_assert_eq "hook runtime: cache is fixture-local" \
  "$HOME/.cache" "$XDG_CACHE_HOME"
_assert_eq "hook runtime: state is fixture-local" \
  "$HOME/.local/state" "$XDG_STATE_HOME"

# Most tests unset agent-session env vars so assertions do not depend on the
# invoking agent runtime. The hook itself must not bypass readiness for agents.
_NO_AGENT_ENV=(
  -u AGENTGUARD_NAME
  -u AGENTGUARD_SESSION_ID
  -u CODEX_THREAD_ID
  -u CODEX_INTERNAL_ORIGINATOR_OVERRIDE
  -u CLAUDE_CODE_CURRENT_SESSION_ID
  -u CLAUDE_CODE_SESSION_ID
  -u GEMINI_PROJECT_DIR
  AGENTGUARD_PROCESS_DETECT=0
)

for hook in pre-commit pre-merge-commit pre-applypatch prepare-commit-msg \
  sley-commit-gate; do
  if [ ! -x "$HOOK_DIR/$hook" ]; then
    echo "githook-test: hook not found or not executable at $HOOK_DIR/$hook" >&2
    exit 1
  fi
done

echo "=== Prepare-commit-msg ordinary commit fast path ==="

prepare_probe_bin=$(_mock_bin)
prepare_probe_log=$(_tmpdir)/git.log
prepare_sed_log=$(_tmpdir)/sed.log
prepare_message=$(_tmpdir)/message
prepare_git_dir=$(_tmpdir)
prepare_output=$(_tmpdir)/output
: >"$prepare_probe_log"
: >"$prepare_sed_log"
printf 'ordinary commit\n' >"$prepare_message"
ln -s "$(command -v bash)" "$prepare_probe_bin/bash"
cat >"$prepare_probe_bin/git" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$PREPARE_PROBE_LOG"
[[ "$*" == "rev-parse --absolute-git-dir" ]] || exit 2
printf '%s\n' "$PREPARE_GIT_DIR"
EOF
cat >"$prepare_probe_bin/sed" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$PREPARE_SED_LOG"
exit 0
EOF
chmod +x "$prepare_probe_bin/git" "$prepare_probe_bin/sed"

PREPARE_PROBE_LOG="$prepare_probe_log" \
  PREPARE_GIT_DIR="$prepare_git_dir" \
  PREPARE_SED_LOG="$prepare_sed_log" \
  PATH="$prepare_probe_bin:$PATH" \
  "$HOOK_DIR/prepare-commit-msg" "$prepare_message" >"$prepare_output" 2>&1
prepare_rc=$?

_assert_eq "prepare-commit-msg fast path: exits successfully" "0" "$prepare_rc"
_assert_file_content "prepare-commit-msg fast path: emits no diagnostics" \
  "" "$prepare_output"
_assert_eq "prepare-commit-msg fast path: resolves all sequencer paths in one Git call" \
  "1" "$(wc -l <"$prepare_probe_log" | tr -d ' ')"
_assert_file_content "prepare-commit-msg fast path: queries the absolute Git directory" \
  "rev-parse --absolute-git-dir" "$prepare_probe_log"
_assert_eq "prepare-commit-msg fast path: reads the message without sed processes" \
  "0" "$(wc -l <"$prepare_sed_log" | tr -d ' ')"

# Each test runs inside its own repo. Keep the helper tiny — the
# isolation knobs (GIT_CONFIG_GLOBAL) matter more than any fancy
# fixture abstraction.
_new_repo() {
  local repo
  repo=$(_tmpdir)
  (
    cd "$repo" || exit 1
    # Point git at an empty per-repo global so real user config (e.g.
    # a system-wide fsmonitor or a differently-set hooksPath) can't
    # leak in and skew behavior.
    export GIT_CONFIG_GLOBAL="$repo/.gitconfig-test"
    : >"$GIT_CONFIG_GLOBAL"
    git init -q
    _git_set_test_identity git
    git config core.hooksPath "$HOOK_DIR"
    git config commit.gpgsign false
  )
  echo "$repo"
}

# Run `git commit` inside $1 with the given env prefix and message.
# Captures stdout+stderr into $__COMMIT_OUT and the exit code into
# $__COMMIT_RC. Keeps the full command line explicit at call sites
# rather than building one-size-fits-all plumbing.
_commit() {
  local repo="$1" msg="$2"
  shift 2
  # Unset agent-session env vars so the pre-commit hook runs its full
  # format/lint/validate pipeline (not the agent-session short-circuit).
  # Tests that need the agent bypass must set the vars explicitly.
  __COMMIT_OUT=$(
    cd "$repo" &&
      env "${_NO_AGENT_ENV[@]}" \
        GIT_CONFIG_GLOBAL="$repo/.gitconfig-test" "$@" \
        git commit -m "$msg" 2>&1
  )
  __COMMIT_RC=$?
}

_mock_sley_ready_bin() {
  local mock_bin
  mock_bin=$(_mock_bin)
  cat >"$mock_bin/sley" <<'EOF'
#!/usr/bin/env bash
[ "$1" = "ready" ] || exit 0
shift
printf 'mock-sley=1\n'
printf 'mock-args=%s\n' "$*"
printf 'mock-pwd=%s\n' "$PWD"
[ -n "${MOCK_SLEY_OUT:-}" ] && printf '%s\n' "$MOCK_SLEY_OUT"
exit "${MOCK_SLEY_RC:-0}"
EOF
  chmod +x "$mock_bin/sley"
  printf '%s\n' "$mock_bin"
}

# Mock sley that passes the `ready` gate (so pre-commit does not block) but
# returns MOCK_SECRETS_RC for `secrets --message-file`, so the commit-msg
# message scan can be exercised in isolation. Records the secrets invocation.
_mock_sley_secrets_bin() {
  local mock_bin
  mock_bin=$(_mock_bin)
  cat >"$mock_bin/sley" <<'EOF'
#!/usr/bin/env bash
case "$1" in
  ready) exit 0 ;;
  secrets)
    printf 'mock-secrets-args=%s\n' "$*"
    exit "${MOCK_SECRETS_RC:-0}"
    ;;
  *) exit 0 ;;
esac
EOF
  chmod +x "$mock_bin/sley"
  printf '%s\n' "$mock_bin"
}

