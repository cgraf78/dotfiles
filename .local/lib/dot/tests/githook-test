# ---------------------------------------------------------------------------

echo "=== Default: clean file, clean lint ==="

repo=$(_new_repo)
cat >"$repo/ok.py" <<'EOF'
x = 1
EOF
(cd "$repo" && git add ok.py)
_commit "$repo" "clean"
_assert_exit "clean file + clean lint: commit succeeds" 0 "$__COMMIT_RC"

echo "=== Default: formatter mutates → commit rejected ==="

# ruff --fix removes unused imports; `import os` is dropped by the
# format pass, so the file on disk diverges from the staged version
# and the hook should reject with a clear message.
repo=$(_new_repo)
cat >"$repo/fixable.py" <<'EOF'
import os
x = 1
EOF
(cd "$repo" && git add fixable.py)
_commit "$repo" "fmt-reject"
_assert_exit "formatter mutated file: commit rejected" 1 "$__COMMIT_RC"
_assert_contains "formatter reject: mentions staging" \
  "stage the formatting changes" "$__COMMIT_OUT"
_assert_contains "formatter reject: from sley fix" \
  "sley fix:" "$__COMMIT_OUT"

echo "=== Default: lint failure blocks via sley ready ==="

# A file that's formatter-clean but trips the linter. sley ready's check
# phase runs lint and blocks the commit on failure (rc=1).
if command -v rumdl &>/dev/null; then
  repo=$(_new_repo)
  cat >"$repo/dup.md" <<'EOF'
# Title

## Dup

## Dup
EOF
  (cd "$repo" && git add dup.md)
  _commit "$repo" "lint-block"
  _assert_exit "lint failure: commit blocked" 1 "$__COMMIT_RC"
fi

