#!/usr/bin/env bash
# wezterm-test - dotfiles WezTerm config and termnav wrapper integration.

set -o pipefail
export NO_COLOR=1

# shellcheck source=helpers.sh
. "$HOME/.local/lib/dot/tests/helpers.sh"

real_home="$HOME"
config="$HOME/.config/wezterm/wezterm.lua"
link_routes="$HOME/.config/wezterm/link-routes.lua"
public_link_rules="$HOME/.config/wezterm/public-link-rules.lua"
termnav_module="$HOME/.config/wezterm/termnav-module.lua"
content=$(cat "$config")
route_wrapper=$(cat "$link_routes")
public_rule_wrapper=$(cat "$public_link_rules")
termnav_wrapper=$(cat "$termnav_module")
alias_content=$(cat "$HOME/.config/shell/interactive.d/50-aliases.sh")
ripgrep_content=$(cat "$HOME/.config/ripgrep/config")

_wezterm_lua() {
  local code="$1" nvim_bin script

  if command -v lua >/dev/null 2>&1; then
    lua -e "$code"
    return
  fi

  nvim_bin=$(_wezterm_working_nvim || true)
  if [[ -n "$nvim_bin" && -x "$nvim_bin" ]]; then
    script=$(_tmpdir)/wezterm-lua.lua
    printf '%s\n' "$code" >"$script"
    _with_timeout 10s "$nvim_bin" --headless --noplugin -u NONE -i NONE -l "$script" 2>&1
    return
  fi

  printf '%s\n' "wezterm-test: no Lua runner found" >&2
  return 127
}

_wezterm_working_nvim() {
  local candidate

  for candidate in \
    "$real_home/.local/share/neovim/neovim/bin/nvim" \
    "$(command -v nvim 2>/dev/null || true)"; do
    [[ -n "$candidate" && -x "$candidate" ]] || continue

    # Alpine can see the bootstrapped glibc-linked nvim binary as executable
    # even though musl cannot run it. Probe the binary before using it as the
    # Lua host so the suite falls back cleanly instead of reporting a timeout
    # from the dynamic loader.
    if _with_timeout 10s "$candidate" --version >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

_wezterm_has_lua_runner() {
  command -v lua >/dev/null 2>&1 && return 0
  _wezterm_working_nvim >/dev/null
}

