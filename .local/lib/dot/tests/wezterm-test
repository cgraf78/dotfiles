_probe_command() {
  local command_name="$1"
  shift
  # shellcheck disable=SC2016 # The inner shell expands its own positional args.
  env -i "$@" HOME="$HOME" PATH="$alias_probe_bin:/usr/bin:/bin" bash -c \
    'source "$1"; shift; "$@"' _ \
    "$HOME/.config/shell/interactive.d/50-aliases.sh" "$command_name" fixture
}

_probe_prealiased_command() {
  local command_name="$1"
  shift
  # shellcheck disable=SC2016 # The inner shell expands its own positional args.
  env -i "$@" HOME="$HOME" PATH="$alias_probe_bin:/usr/bin:/bin" zsh -f -c \
    'alias ls="ls -G"; alias rg="rg --hidden"; source "$1"; shift; "$@"' _ \
    "$HOME/.config/shell/interactive.d/50-aliases.sh" "$command_name" fixture
}

_probe_prealiased_source() {
  # shellcheck disable=SC2016 # The inner shell expands its own positional args.
  env -i HOME="$HOME" PATH="$alias_probe_bin:/usr/bin:/bin" zsh -f -c \
    'alias ls="ls -G"; alias rg="rg --hidden"; source "$1"' _ \
    "$HOME/.config/shell/interactive.d/50-aliases.sh" 2>&1
}

