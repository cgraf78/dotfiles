cat >"$regex_test" <<'PY'
import re
import sys

config_path = sys.argv[1]
content = open(config_path, encoding="utf-8").read()
patterns = re.findall(r"regex = \[\[(.*?)\]\]", content)
if len(patterns) != 5:
    raise SystemExit(f"expected 5 file hyperlink regexes, found {len(patterns)}")

compiled = [re.compile(pattern) for pattern in patterns]


def custom_matches(text):
    spans = []
    matches = []
    for pattern in compiled:
        for match in pattern.finditer(text):
            start, end = match.span()
            if any(start < span_end and end > span_start for span_start, span_end in spans):
                continue
            spans.append((start, end))
            matches.append(match.group(0))
    return matches


positives = {
    "src/foo.cpp:42": ["src/foo.cpp:42"],
    "'./project dir/src/file with spaces.cpp:12'": ["'./project dir/src/file with spaces.cpp:12'"],
}
negatives = [
    "'v1.2.3'",
    '"https://example.com/path"',
]

for text, expected in positives.items():
    actual = custom_matches(text)
    if actual != expected:
        raise SystemExit(f"{text!r}: expected {expected!r}, got {actual!r}")

for text in negatives:
    actual = custom_matches(text)
    if actual:
        raise SystemExit(f"{text!r}: expected no custom match, got {actual!r}")

print("ok")
PY
