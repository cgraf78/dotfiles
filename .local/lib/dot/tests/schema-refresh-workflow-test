#!/usr/bin/env bash
# schema-refresh-workflow-test - scheduled Checkrun schema refresh policy.
# shellcheck disable=SC2016 # Assertions intentionally match literal workflow expressions.

set -euo pipefail
export NO_COLOR=1

# shellcheck source=helpers.sh
. "$HOME/.local/lib/dot/tests/helpers.sh"

workflow="$HOME/.github/workflows/refresh-checkrun-schemas.yml"
if [[ ! -f "$workflow" ]]; then
  _fail "schema refresh: workflow exists"
  _test_summary
fi

content=$(<"$workflow")
refresh_job=$(awk '
  /^  refresh:$/ { in_job = 1 }
  /^  publish:$/ { exit }
  in_job { print }
' "$workflow")
publish_job=$(awk '
  /^  publish:$/ { in_job = 1 }
  in_job { print }
' "$workflow")

_assert_contains "schema refresh: runs daily" 'cron: "17 4 * * *"' "$content"
_assert_contains "schema refresh: manual runs remain available" 'workflow_dispatch:' "$content"
_assert_contains "schema refresh: concurrent publishers serialize" 'group: refresh-checkrun-schemas' "$content"
_assert_contains "schema refresh: an active publisher is not cancelled" 'cancel-in-progress: false' "$content"
_assert_contains "schema refresh: workflow permissions default to none" 'permissions: {}' "$content"
_assert_contains "schema refresh: runtime is bounded" 'timeout-minutes: 20' "$content"
_assert_contains "schema refresh: updater is read-only" 'contents: read' "$content"
_assert_contains "schema refresh: publisher can update contents" 'contents: write' "$content"
_assert_contains "schema refresh: publisher can manage its PR" 'pull-requests: write' "$content"
_assert_not_contains "schema refresh: updater cannot access the deploy key" \
  'DOTFILES_SCHEMA_REFRESH_DEPLOY_KEY' "$refresh_job"
_assert_not_contains "schema refresh: updater cannot access a write API token" \
  'GH_TOKEN:' "$refresh_job"
_assert_not_contains "schema refresh: updater cannot write repository contents" \
  'contents: write' "$refresh_job"
_assert_contains "schema refresh: only publisher gets repository write permission" \
  'contents: write' "$publish_job"
_assert_contains "schema refresh: only publisher gets pull-request write permission" \
  'pull-requests: write' "$publish_job"

_assert_contains "schema refresh: read-only job publishes a patch artifact" \
  'uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02' "$content"
_assert_contains "schema refresh: privileged job consumes the patch artifact" \
  'uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093' "$content"
_assert_contains "schema refresh: publisher waits for read-only refresh" 'needs: refresh' "$content"
_assert_contains "schema refresh: checkout uses the dedicated deploy key" \
  'ssh-key: ${{ secrets.DOTFILES_SCHEMA_REFRESH_DEPLOY_KEY }}' "$content"
_assert_contains "schema refresh: deploy-key persistence is explicit" \
  'persist-credentials: true # zizmor: ignore[artipacked]' "$content"
_assert_contains "schema refresh: missing deploy key fails loudly" \
  'DOTFILES_SCHEMA_REFRESH_DEPLOY_KEY is not configured' "$content"
_assert_contains "schema refresh: JSON Schema validation is mandatory" \
  "python3 -c 'import jsonschema'" "$content"
_assert_contains "schema refresh: JSON Schema validator is pinned" \
  "'jsonschema==4.25.1'" "$content"
_assert_contains "schema refresh: payloads receive meta-schema validation" \
  'validator_for(schema).check_schema(schema)' "$content"
_assert_contains "schema refresh: updater comes from Checkrun" 'repository: cgraf78/checkrun' "$content"
_assert_contains "schema refresh: command uses the public Checkrun API" \
  'checkrun" schema refresh' "$content"
_assert_contains "schema refresh: fetch phase has one bounded retry" \
  'retrying the read-only fetch phase once' "$content"
_assert_contains "schema refresh: only pinned payloads are staged" \
  'git add -- "${changed_paths[@]}"' "$content"
_assert_contains "schema refresh: new untracked payloads are detected" \
  'git_paths("ls-files", "--others", "--exclude-standard", "-z")' "$content"
_assert_contains "schema refresh: unexpected tracked changes are rejected" \
  'unexpected tracked changes from schema refresh' "$content"
_assert_contains "schema refresh: publisher revalidates staged paths" \
  'git diff --cached --name-only -z' "$content"
_assert_contains "schema refresh: generated patch is whitespace-clean" \
  'git diff --cached --check' "$content"

_assert_contains "schema refresh: default-branch races are rejected" \
  'default branch changed during schema refresh; rerun the workflow' "$content"
_assert_contains "schema refresh: updates use a dedicated branch" \
  'UPDATE_BRANCH: automation/checkrun-schema-refresh' "$content"
_assert_contains "schema refresh: workflow creates a pull request" 'gh pr create' "$content"
_assert_contains "schema refresh: PR lookup is scoped to the repository owner" \
  'head="$owner:$UPDATE_BRANCH"' "$content"
_assert_contains "schema refresh: reused PR base is verified" \
  'unexpected base on schema refresh PR' "$content"
_assert_contains "schema refresh: reused PR head repository is verified" \
  'unexpected head repository on schema refresh PR' "$content"
_assert_contains "schema refresh: pull request is synchronized after creation" \
  'git commit --amend' "$content"
_assert_contains "schema refresh: synchronization push is lease protected" \
  '--force-with-lease=$remote_ref:$published_sha' "$content"
_assert_contains "schema refresh: GitHub auto-merge is requested" \
  'gh pr merge "$number" --auto --squash' "$content"

create_line=$(awk '/gh pr create/ { print NR; exit }' "$workflow")
amend_line=$(awk '/git commit --amend/ { print NR; exit }' "$workflow")
auto_merge_line=$(awk '/gh pr merge .*--auto/ { print NR; exit }' "$workflow")
if [[ -n "$create_line" && -n "$amend_line" && -n "$auto_merge_line" &&
  "$create_line" -lt "$amend_line" && "$amend_line" -lt "$auto_merge_line" ]]; then
  _pass "schema refresh: PR precedes protected-check synchronization and auto-merge"
else
  _fail "schema refresh: PR must precede synchronization and auto-merge"
fi

key_check_line=$(awk '/name: Require the repository-scoped deploy key/ { print NR; exit }' "$workflow")
publish_checkout_line=$(awk '/name: Checkout exact refresh base/ { print NR; exit }' "$workflow")
if [[ -n "$key_check_line" && -n "$publish_checkout_line" &&
  "$key_check_line" -lt "$publish_checkout_line" ]]; then
  _pass "schema refresh: deploy key is required before credentialed checkout"
else
  _fail "schema refresh: deploy key preflight must precede credentialed checkout"
fi

_assert_not_contains "schema refresh: workflow never pushes to main" \
  'git push origin HEAD:main' "$content"
_assert_not_contains "schema refresh: updater never recursively stages the schema directory" \
  'git add .local/share/checkrun/schemas' "$content"
_assert_not_contains "schema refresh: workflow never bypasses protection" \
  'gh pr merge "$number" --admin' "$content"
_assert_contains "schema refresh: SSH checkout uses an inert required token" \
  'token: unused-by-ssh-checkout' "$content"

schema_python=
for candidate in python3 /usr/bin/python3; do
  if command -v "$candidate" >/dev/null 2>&1 &&
    "$candidate" -c 'from jsonschema.validators import validator_for' 2>/dev/null; then
    schema_python=$candidate
    break
  fi
done

if [[ -z "$schema_python" ]]; then
  schema_python=$(command -v python3)
  schema_stub=$(_tmpdir)
  mkdir -p "$schema_stub/jsonschema"
  printf '%s\n' 'class SchemaError(Exception):' '    pass' \
    >"$schema_stub/jsonschema/exceptions.py"
  cat >"$schema_stub/jsonschema/validators.py" <<'PY'
from .exceptions import SchemaError


class _Validator:
    @staticmethod
    def check_schema(schema):
        if schema.get("type") == "not-a-real-json-schema-type":
            raise SchemaError("invalid type")


def validator_for(_schema):
    return _Validator()
PY
  : >"$schema_stub/jsonschema/__init__.py"
  export PYTHONPATH="$schema_stub${PYTHONPATH:+:$PYTHONPATH}"
fi

validator=$(_tmpdir)/validate-refresh.py
awk '
  /python3 - "\$base_sha" "\$paths_file" <<.PY./ { in_validator = 1; next }
  in_validator && /^          PY$/ { exit }
  in_validator { sub(/^          /, ""); print }
' "$workflow" >"$validator"

fixture=$(_tmpdir)
mkdir -p "$fixture/.local/share/checkrun/schemas"
git -C "$fixture" init -q
git -C "$fixture" config user.name test
git -C "$fixture" config user.email test@example.invalid
git -C "$fixture" config core.hooksPath /dev/null
printf '%s\n' '{"title":"old"}' \
  >"$fixture/.local/share/checkrun/schemas/existing.schema.json"
git -C "$fixture" add .local/share/checkrun/schemas/existing.schema.json
git -C "$fixture" commit -qm base
base=$(git -C "$fixture" rev-parse HEAD)

printf '%s\n' '{"title":"updated"}' \
  >"$fixture/.local/share/checkrun/schemas/existing.schema.json"
printf '%s\n' '{"title":"new"}' \
  >"$fixture/.local/share/checkrun/schemas/new.schema.json"
paths=$(_tmpdir)/paths
set +e
(cd "$fixture" && "$schema_python" "$validator" "$base" "$paths")
rc=$?
set -e
_assert_exit "schema refresh validator: accepts updated and new payloads" 0 "$rc"
_assert_file_content "schema refresh validator: inventories tracked and untracked payloads" \
  $'.local/share/checkrun/schemas/existing.schema.json\n.local/share/checkrun/schemas/new.schema.json' \
  "$paths"

printf '%s\n' '{"type":"not-a-real-json-schema-type"}' \
  >"$fixture/.local/share/checkrun/schemas/new.schema.json"
set +e
invalid_output=$(cd "$fixture" && "$schema_python" "$validator" "$base" "$paths" 2>&1)
rc=$?
set -e
_assert_exit "schema refresh validator: rejects invalid JSON Schemas" 1 "$rc"
_assert_contains "schema refresh validator: reports meta-schema failure" \
  'invalid schema refresh output' "$invalid_output"
printf '%s\n' '{"title":"new"}' \
  >"$fixture/.local/share/checkrun/schemas/new.schema.json"

printf '%s\n' unexpected >"$fixture/unexpected.txt"
set +e
unexpected_output=$(cd "$fixture" && "$schema_python" "$validator" "$base" "$paths" 2>&1)
rc=$?
set -e
_assert_exit "schema refresh validator: rejects unexpected files" 1 "$rc"
_assert_contains "schema refresh validator: reports rejected path" \
  'unexpected.txt' "$unexpected_output"

_test_summary
