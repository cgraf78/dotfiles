#!/usr/bin/env bash
# OpenCode AgentGuard adapter integration tests.

set -u

if ! command -v node >/dev/null 2>&1; then
  echo "SKIP: opencode-agentguard-test (node unavailable)"
  exit 0
fi

test_root=$(mktemp -d 2>/dev/null || mktemp -d -t opencode-agentguard-test) || exit 1
trap 'rm -rf "$test_root"' EXIT

fixture_home="$test_root/home"
fixture_bin="$fixture_home/.local/bin"
behavior_dir="$test_root/behaviors"
hook_log="$test_root/hooks.jsonl"
mkdir -p "$fixture_bin" "$behavior_dir"

cp "$HOME/.config/dot/merge-hooks.d/opencode/agentguard.js" "$test_root/agentguard.mjs"

cat >"$test_root/hook-fixture.mjs" <<'HOOK_FIXTURE'
#!/usr/bin/env node

import fs from "node:fs";
import path from "node:path";
import { spawn } from "node:child_process";

const hook = path.basename(process.argv[1]);
const input = await new Promise((resolve) => {
  let data = "";
  process.stdin.setEncoding("utf8");
  process.stdin.on("data", (chunk) => {
    data += chunk;
  });
  process.stdin.on("end", () => resolve(data));
});
const payload = input.trim() ? JSON.parse(input) : {};
const behaviorPath = path.join(process.env.DOT_TEST_HOOK_BEHAVIOR_DIR, `${hook}.json`);
const behavior = fs.existsSync(behaviorPath)
  ? JSON.parse(fs.readFileSync(behaviorPath, "utf8"))
  : {};

fs.appendFileSync(
  process.env.DOT_TEST_HOOK_LOG,
  `${JSON.stringify({
    hook,
    payload,
    cwd: process.cwd(),
    name: process.env.AGENTGUARD_NAME,
    session: process.env.AGENTGUARD_SESSION_ID,
    bashEnv: process.env.BASH_ENV,
  })}\n`,
);

if (behavior.descendantMarker) {
  spawn(
    process.execPath,
    [
      "-e",
      'const fs = require("node:fs"); setTimeout(() => fs.writeFileSync(process.argv[1], "alive"), 200);',
      behavior.descendantMarker,
    ],
    { stdio: "ignore" },
  );
}

if (behavior.delayMs) {
  await new Promise((resolve) => setTimeout(resolve, behavior.delayMs));
}

let stdout = behavior.stdout ?? "{}";
if (behavior.echoCommand) {
  stdout = JSON.stringify({ context: payload.tool_input?.command ?? "" });
}
if (behavior.stderr) process.stderr.write(behavior.stderr);
if (stdout) process.stdout.write(stdout);
process.exit(behavior.exit ?? 0);
HOOK_FIXTURE
chmod +x "$test_root/hook-fixture.mjs"

for hook in \
  agent-hook-session-start \
  agent-hook-prompt-submit \
  agent-hook-pre-bash \
  agent-hook-post-bash \
  agent-hook-pre-edit \
  agent-hook-post-edit \
  agent-hook-pre-mcp \
  agent-hook-post-mcp \
  agent-hook-notification \
  agent-hook-stop \
  agent-hook-session-end; do
  ln -s "$test_root/hook-fixture.mjs" "$fixture_bin/$hook"
done

cat >"$test_root/test.mjs" <<'TEST_SCRIPT'
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import fs from "node:fs";
import path from "node:path";
import { pathToFileURL } from "node:url";

const root = process.env.DOT_TEST_ROOT;
const home = process.env.DOT_TEST_HOME;
const logPath = process.env.DOT_TEST_HOOK_LOG;
const behaviorDir = process.env.DOT_TEST_HOOK_BEHAVIOR_DIR;
const pluginPath = process.env.DOT_TEST_PLUGIN;
const hmLauncher = process.env.DOT_TEST_HM_LAUNCHER;
const sourceDirectory = path.join(root, "workspace");
fs.mkdirSync(sourceDirectory, { recursive: true });
process.env.HOME = home;
// Keep normal fixture hooks comfortably above process-startup jitter. The full
// dotfiles runner executes suites in parallel, so a blanket 100 ms budget turns
// ordinary Node startup into a load-sensitive failure instead of testing the
// adapter contract. The one timeout test below narrows this scale temporarily.
process.env.DOT_OPENCODE_AGENTGUARD_TIMEOUT_SCALE = "0.1";

const { AgentGuardPlugin } = await import(`${pathToFileURL(pluginPath).href}?test=${Date.now()}`);

let passed = 0;
let failed = 0;

function behavior(hook, value) {
  fs.writeFileSync(path.join(behaviorDir, `${hook}.json`), JSON.stringify(value));
}

function clearBehavior(hook) {
  fs.rmSync(path.join(behaviorDir, `${hook}.json`), { force: true });
}

function clearLog() {
  fs.writeFileSync(logPath, "");
}

function logs() {
  const raw = fs.readFileSync(logPath, "utf8").trim();
  return raw ? raw.split("\n").map((line) => JSON.parse(line)) : [];
}

async function plugin(config = {}, client) {
  const hooks = await AgentGuardPlugin({ directory: sourceDirectory, client });
  await hooks.config?.(config);
  return hooks;
}

async function check(name, fn) {
  try {
    await fn();
    passed += 1;
    console.log(`PASS: ${name}`);
  } catch (error) {
    failed += 1;
    console.error(`FAIL: ${name}`);
    console.error(error?.stack ?? String(error));
  }
}

await check("exports the complete OpenCode hook surface", async () => {
  const hooks = await plugin();
  for (const name of [
    "config",
    "chat.message",
    "permission.ask",
    "shell.env",
    "tool.execute.before",
    "tool.execute.after",
    "event",
    "dispose",
  ]) {
    assert.equal(typeof hooks[name], "function", name);
  }
});

await check("injects OpenCode identity into shell commands for Hive Memory", async () => {
  const hooks = await plugin();
  const output = {
    env: {
      PATH: "/fixture/bin",
      CUSTOM_ENV: "preserved",
      AGENTGUARD_NAME: "stale-agent",
      AGENTGUARD_SESSION_ID: "stale-session",
    },
  };
  await hooks["shell.env"](
    { cwd: sourceDirectory, sessionID: "shell-session", callID: "shell-call" },
    output,
  );
  assert.deepEqual(output.env, {
    PATH: "/fixture/bin",
    CUSTOM_ENV: "preserved",
    AGENTGUARD_NAME: "opencode",
    AGENTGUARD_SESSION_ID: "shell-session",
  });

  const hmCore = path.join(root, "hm-core");
  fs.writeFileSync(
    hmCore,
    `#!/bin/sh
printf 'agent=%s\\n' "\${HIVE_MEMORY_AGENT_ID:-}"
printf 'session=%s\\n' "\${HIVE_MEMORY_SESSION_ID:-}"
`,
  );
  fs.chmodSync(hmCore, 0o755);
  const launched = spawnSync(hmLauncher, ["env-probe"], {
    encoding: "utf8",
    env: {
      ...process.env,
      ...output.env,
      HOME: home,
      HIVE_MEMORY_CORE: hmCore,
      PATH: process.env.PATH,
    },
  });
  assert.equal(launched.status, 0, launched.stderr);
  assert.equal(launched.stdout, "agent=opencode\nsession=shell-session\n");

  const ambientSession = process.env.AGENTGUARD_SESSION_ID;
  process.env.AGENTGUARD_SESSION_ID = "outer-agent-session";
  const sessionless = {
    env: {
      CUSTOM_ENV: "preserved",
    },
  };
  try {
    await hooks["shell.env"]({ cwd: sourceDirectory }, sessionless);
    assert.deepEqual(sessionless.env, {
      CUSTOM_ENV: "preserved",
      AGENTGUARD_NAME: "opencode",
      AGENTGUARD_SESSION_ID: "",
    });

    // OpenCode applies the hook's output as an overlay on process.env. Exercise
    // that exact composition so a deletion-only implementation cannot hide the
    // inherited outer-agent session in this regression test.
    const sessionlessLaunch = spawnSync(hmLauncher, ["env-probe"], {
      encoding: "utf8",
      env: {
        ...process.env,
        ...sessionless.env,
        HOME: home,
        HIVE_MEMORY_AGENT_ID: "",
        HIVE_MEMORY_SESSION_ID: "",
        HIVE_MEMORY_CORE: hmCore,
        PATH: process.env.PATH,
      },
    });
    assert.equal(sessionlessLaunch.status, 0, sessionlessLaunch.stderr);
    assert.match(sessionlessLaunch.stdout, /^agent=opencode\nsession=opencode-\d+\n$/);
    assert.doesNotMatch(sessionlessLaunch.stdout, /outer-agent-session/);
  } finally {
    if (ambientSession === undefined) {
      delete process.env.AGENTGUARD_SESSION_ID;
    } else {
      process.env.AGENTGUARD_SESSION_ID = ambientSession;
    }
  }
  await hooks.dispose();
});

