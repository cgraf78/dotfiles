await check("translates Bash, edit, multiedit, write, patch, and MCP payloads", async () => {
  clearLog();
  fs.mkdirSync(path.join(sourceDirectory, "relative-dir"), { recursive: true });
  const hooks = await plugin({ mcp: { "server-name": { type: "local" } } });
  const cases = [
    [
      "bash",
      "b1",
      { command: "pwd", timeout: 50, workdir: "/tmp" },
      "Bash",
      "agent-hook-pre-bash",
      "/tmp",
      7,
    ],
    [
      "bash",
      "b2",
      { command: "pwd", workdir: "relative-dir" },
      "Bash",
      "agent-hook-pre-bash",
      path.join(sourceDirectory, "relative-dir"),
      null,
    ],
    [
      "edit",
      "e1",
      { filePath: "a.txt", oldString: "old", newString: "new", replaceAll: true },
      "Edit",
      "agent-hook-pre-edit",
      sourceDirectory,
    ],
    [
      "write",
      "w1",
      { filePath: "b.txt", content: "body" },
      "Write",
      "agent-hook-pre-edit",
      sourceDirectory,
    ],
    [
      "multiedit",
      "me1",
      {
        filePath: "multi.txt",
        edits: [{ oldString: "before", newString: "after", replaceAll: false }],
      },
      "MultiEdit",
      "agent-hook-pre-edit",
      sourceDirectory,
    ],
    [
      "apply_patch",
      "p1",
      { patchText: "*** Begin Patch" },
      "Edit",
      "agent-hook-pre-edit",
      sourceDirectory,
    ],
    [
      "server-name_lookup",
      "m1",
      { query: "value" },
      "mcp__server-name__lookup",
      "agent-hook-pre-mcp",
      sourceDirectory,
    ],
  ];

  for (const [tool, callID, args, , , , exit] of cases) {
    await hooks["tool.execute.before"]({ tool, sessionID: "payload-session", callID }, { args });
    await hooks["tool.execute.after"](
      { tool, sessionID: "payload-session", callID, args },
      {
        title: tool,
        output: `${tool} output`,
        metadata: tool === "bash" ? { exit } : {},
      },
    );
  }

  const records = logs();
  for (let index = 0; index < cases.length; index += 1) {
    const [tool, , args, toolName, preHook, expectedCwd, exit] = cases[index];
    const pre = records[index * 2];
    const post = records[index * 2 + 1];
    assert.equal(pre.hook, preHook, tool);
    assert.equal(pre.payload.hook_event_name, "PreToolUse");
    assert.equal(pre.payload.tool_name, toolName);
    assert.equal(pre.payload.session_id, "payload-session");
    assert.equal(pre.payload.cwd, expectedCwd);
    // macOS exposes /tmp and /var as symlinks into /private. Keep asserting
    // the lexical directory in AgentGuard's payload, because that is the path
    // OpenCode requested, while comparing the hook process's cwd with the
    // filesystem-canonical directory the kernel reports after chdir(2).
    const expectedProcessCwd = fs.realpathSync(expectedCwd);
    assert.equal(pre.cwd, expectedProcessCwd);
    assert.equal(post.payload.cwd, expectedCwd);
    assert.equal(post.cwd, expectedProcessCwd);
    assert.equal(pre.name, "opencode");
    assert.equal(pre.session, "payload-session");
    assert.equal(pre.bashEnv, path.join(home, ".config/shell/env-noninteractive.sh"));
    assert.equal(post.payload.hook_event_name, "PostToolUse");
    if (tool === "bash") {
      assert.equal(pre.payload.tool_input.command, args.command);
      assert.equal(post.payload.tool_response.stdout, "bash output");
      assert.equal(post.payload.tool_response.exit_code, exit === null ? 1 : exit);
    }
    if (tool === "edit") {
      assert.equal(pre.payload.tool_input.file_path, "a.txt");
      assert.equal(pre.payload.tool_input.old_string, "old");
      assert.equal(pre.payload.tool_input.new_string, "new");
      assert.equal(pre.payload.tool_input.replace_all, true);
    }
    if (tool === "write") {
      assert.equal(pre.payload.tool_input.file_path, "b.txt");
      assert.equal(pre.payload.tool_input.content, "body");
    }
    if (tool === "multiedit") {
      assert.equal(pre.payload.tool_input.file_path, "multi.txt");
      assert.deepEqual(pre.payload.tool_input.edits, [
        { old_string: "before", new_string: "after", replace_all: false },
      ]);
    }
    if (tool === "apply_patch") {
      assert.equal(pre.payload.tool_input.patch, "*** Begin Patch");
    }
  }
});

await check("preserves typed MCP content and appends hook context", async () => {
  clearLog();
  let hooks;
  behavior("agent-hook-pre-mcp", { stdout: JSON.stringify({ context: "pre MCP context" }) });
  behavior("agent-hook-post-mcp", { stdout: JSON.stringify({ context: "post MCP context" }) });
  try {
    hooks = await plugin({ mcp: { docs: { type: "local" } } });
    const args = { query: "value" };
    await hooks["tool.execute.before"](
      { tool: "docs_lookup", sessionID: "typed-mcp", callID: "typed-mcp-call" },
      { args },
    );
    const content = [{ type: "text", text: "typed MCP result" }];
    const output = {
      title: "lookup",
      output: "legacy display result",
      content: content.map((part) => ({ ...part })),
      metadata: { source: "mcp" },
    };
    await hooks["tool.execute.after"](
      { tool: "docs_lookup", sessionID: "typed-mcp", callID: "typed-mcp-call", args },
      output,
    );

    const post = logs().find((record) => record.hook === "agent-hook-post-mcp");
    assert.deepEqual(post.payload.tool_response.content, content);
    assert.equal(post.payload.tool_response.metadata.source, "mcp");
    assert.equal(output.output, "legacy display result");
    assert.deepEqual(output.content[0], content[0]);
    assert.equal(output.content.at(-1).type, "text");
    assert.match(output.content.at(-1).text, /pre MCP context/);
    assert.match(output.content.at(-1).text, /post MCP context/);
  } finally {
    await hooks?.dispose();
    clearBehavior("agent-hook-pre-mcp");
    clearBehavior("agent-hook-post-mcp");
  }
});

await check("serializes lazy session start before the first prompt", async () => {
  clearLog();
  behavior("agent-hook-session-start", {
    delayMs: 40,
    stdout: JSON.stringify({ context: "start context" }),
  });
  behavior("agent-hook-prompt-submit", {
    stdout: JSON.stringify({ hookSpecificOutput: { additionalContext: "prompt context" } }),
  });
  const hooks = await plugin();
  void hooks.event({
    event: {
      type: "session.created",
      properties: { info: { id: "race-session" } },
    },
  });
  const output = {
    message: { system: "existing" },
    parts: [{ type: "text", text: "hello" }],
  };
  await hooks["chat.message"]({ sessionID: "race-session", agent: "build" }, output);
  assert.match(output.message.system, /start context/);
  assert.match(output.message.system, /prompt context/);
  const records = logs();
  assert.equal(records.filter((item) => item.hook === "agent-hook-session-start").length, 1);
  assert.equal(
    records.find((item) => item.hook === "agent-hook-session-start").payload.hook_event_name,
    "SessionStart",
  );
  assert.equal(
    records.find((item) => item.hook === "agent-hook-prompt-submit").payload.hook_event_name,
    "UserPromptSubmit",
  );
  await hooks.dispose();
  clearBehavior("agent-hook-session-start");
  clearBehavior("agent-hook-prompt-submit");
});

await check("deduplicates Stop and finalizes each session at most once", async () => {
  clearLog();
  const hooks = await plugin();
  const first = { message: {}, parts: [{ type: "text", text: "one" }] };
  await hooks["chat.message"]({ sessionID: "life-session", agent: "build" }, first);
  void hooks.event({ event: { type: "session.idle", properties: { sessionID: "life-session" } } });
  void hooks.event({ event: { type: "session.idle", properties: { sessionID: "life-session" } } });
  await hooks["chat.message"](
    { sessionID: "life-session", agent: "build" },
    { message: {}, parts: [{ type: "text", text: "two" }] },
  );
  void hooks.event({ event: { type: "session.idle", properties: { sessionID: "life-session" } } });
  void hooks.event({
    event: { type: "session.deleted", properties: { info: { id: "life-session" } } },
  });
  await hooks.dispose();
  const records = logs();
  assert.equal(records.filter((item) => item.hook === "agent-hook-stop").length, 2);
  assert.equal(records.filter((item) => item.hook === "agent-hook-session-end").length, 1);
  assert.ok(
    records
      .filter((item) => item.hook === "agent-hook-stop")
      .every((item) => item.payload.hook_event_name === "Stop"),
  );
  assert.equal(
    records.find((item) => item.hook === "agent-hook-session-end").payload.hook_event_name,
    "SessionEnd",
  );
});

await check("queues an idle event behind an in-flight message callback", async () => {
  clearLog();
  behavior("agent-hook-prompt-submit", { delayMs: 50 });
  const hooks = await plugin();
  const message = hooks["chat.message"](
    { sessionID: "message-race", agent: "build" },
    { message: {}, parts: [{ type: "text", text: "race" }] },
  );
  void hooks.event({
    event: { type: "session.idle", properties: { sessionID: "message-race" } },
  });
  await message;
  await hooks.dispose();
  const records = logs();
  const promptIndex = records.findIndex((item) => item.hook === "agent-hook-prompt-submit");
  const stopIndex = records.findIndex((item) => item.hook === "agent-hook-stop");
  assert.ok(promptIndex >= 0);
  assert.ok(stopIndex > promptIndex);
  clearBehavior("agent-hook-prompt-submit");
});

await check("does not finalize an active session because the clock advanced", async () => {
  clearLog();
  const hooks = await plugin();
  await hooks["chat.message"](
    { sessionID: "old-active", agent: "build" },
    { message: {}, parts: [{ type: "text", text: "first" }] },
  );
  clearLog();
  const originalNow = Date.now;
  const later = originalNow() + 7 * 60 * 60 * 1_000;
  Date.now = () => later;
  try {
    await hooks["chat.message"](
      { sessionID: "old-active", agent: "build" },
      { message: {}, parts: [{ type: "text", text: "second" }] },
    );
  } finally {
    Date.now = originalNow;
  }
  const records = logs();
  assert.equal(records.filter((item) => item.hook === "agent-hook-session-start").length, 0);
  assert.equal(records.filter((item) => item.hook === "agent-hook-session-end").length, 0);
  await hooks.dispose();
});

await check("does not finalize an active session because the session map is full", async () => {
  clearLog();
  const hooks = await plugin();
  await hooks["chat.message"](
    { sessionID: "cap-active", agent: "build" },
    { message: {}, parts: [{ type: "text", text: "first" }] },
  );
  for (let index = 0; index < 260; index += 1) {
    void hooks.event({
      event: { type: "session.created", properties: { info: { id: `cap-${index}` } } },
    });
  }
  clearLog();
  await hooks["chat.message"](
    { sessionID: "cap-active", agent: "build" },
    { message: {}, parts: [{ type: "text", text: "second" }] },
  );
  const records = logs();
  assert.equal(records.filter((item) => item.hook === "agent-hook-session-start").length, 0);
  assert.equal(records.filter((item) => item.hook === "agent-hook-session-end").length, 0);
  await hooks.dispose();
});

await check("isolates concurrent pre-tool context by callID", async () => {
  clearLog();
  behavior("agent-hook-pre-bash", { echoCommand: true });
  const hooks = await plugin();
  await Promise.all([
    hooks["tool.execute.before"](
      { tool: "bash", sessionID: "calls", callID: "call-one" },
      { args: { command: "context one" } },
    ),
    hooks["tool.execute.before"](
      { tool: "bash", sessionID: "calls", callID: "call-two" },
      { args: { command: "context two" } },
    ),
  ]);
  const two = { title: "two", output: "result two", metadata: {} };
  const one = { title: "one", output: "result one", metadata: {} };
  await hooks["tool.execute.after"](
    { tool: "bash", sessionID: "calls", callID: "call-two", args: { command: "context two" } },
    two,
  );
  await hooks["tool.execute.after"](
    { tool: "bash", sessionID: "calls", callID: "call-one", args: { command: "context one" } },
    one,
  );
  assert.match(two.output, /context two/);
  assert.doesNotMatch(two.output, /context one/);
  assert.match(one.output, /context one/);
  assert.doesNotMatch(one.output, /context two/);
  await hooks.dispose();
  clearBehavior("agent-hook-pre-bash");
});

await check("fails closed with stderr for protected pre-hook denials", async () => {
  clearLog();
  behavior("agent-hook-pre-bash", { exit: 2, stderr: "denied by fixture" });
  const hooks = await plugin();
  const output = { args: { command: "danger" } };
  try {
    await assert.rejects(
      hooks["tool.execute.before"](
        { tool: "bash", sessionID: "denied", callID: "denied-call" },
        output,
      ),
