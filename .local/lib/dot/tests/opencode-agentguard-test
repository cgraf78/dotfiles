await check("fails closed when a protected hook closes stdin early", async () => {
  clearLog();
  const hookPath = path.join(home, ".local/bin/agent-hook-pre-edit");
  const hookScript = path.join(root, "close-input-hook.sh");
  const descendantReady = path.join(root, "closed-input-descendant-ready");
  const descendantMarker = path.join(root, "closed-input-descendant-survived");
  const darwinBin = path.join(root, "darwin-bin");
  const savedPath = process.env.PATH;
  const descendantDelayMs = 1_000;
  fs.mkdirSync(darwinBin);
  fs.writeFileSync(path.join(darwinBin, "pkill"), "#!/bin/sh\nexit 2\n", {
    mode: 0o755,
  });
  fs.writeFileSync(
    hookScript,
    `#!/bin/sh
python3 - "${descendantReady}" "${descendantMarker}" "${descendantDelayMs / 1_000}" <<'PY' &
import os
import pathlib
import sys
import time

# A hook helper is allowed to create its own process group. macOS does this for
# some background jobs, so killing only the hook leader's group is not enough;
# every process in the isolated hook session must be stopped on protocol error.
os.setpgrp()
pathlib.Path(sys.argv[1]).write_text("ready", encoding="utf-8")
time.sleep(float(sys.argv[3]))
pathlib.Path(sys.argv[2]).write_text("alive", encoding="utf-8")
PY
while [ ! -s "${descendantReady}" ]; do
  sleep 0.01
done
exec 0<&-
sleep 5
`,
  );
  fs.chmodSync(hookScript, 0o755);
  fs.rmSync(hookPath);
  fs.symlinkSync(hookScript, hookPath);
  // Apple's pkill omits the session selector supported by procps-ng. Put an
  // equivalent invalid-usage result first on PATH so Linux catches any cleanup
  // implementation that silently relies on the non-portable `pkill -s`.
  process.env.PATH = `${darwinBin}${path.delimiter}${savedPath}`;
  try {
    const hooks = await plugin();
    await assert.rejects(
      hooks["tool.execute.before"](
        { tool: "edit", sessionID: "closed-input", callID: "closed-input-call" },
        {
          args: {
            filePath: "large",
            oldString: "",
            newString: "x".repeat(2 * 1024 * 1024),
          },
        },
      ),
      /input failed/i,
    );
    // The ready handshake makes the separate process group deterministic before
    // stdin closes. Waiting past its write deadline then tests cleanup itself,
    // without depending on when macOS schedules the EPIPE notification.
    await new Promise((resolve) => setTimeout(resolve, descendantDelayMs + 250));
    assert.equal(fs.existsSync(descendantMarker), false);
    await hooks.dispose();
  } finally {
    process.env.PATH = savedPath;
    fs.rmSync(hookPath);
    fs.symlinkSync(path.join(root, "hook-fixture.mjs"), hookPath);
  }
});

