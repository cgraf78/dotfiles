#!/usr/bin/env bash
# shdeps-hooks-test — unit tests for dotfiles-specific shdeps custom hooks.
#
# shdeps itself owns the generic dependency installer tests. This file covers
# subtle behavior in hook glue where dotfiles choose fallback tools and wrap
# externally managed executables.

set -o pipefail
export NO_COLOR=1

# shellcheck source=helpers.sh disable=SC1091
. "$HOME/.local/lib/dot/tests/helpers.sh"

REAL_HOME="$HOME"

echo "=== shdeps hook policy ==="

_release_helpers=$(
  rg -l 'shdeps_github_release_install' "$REAL_HOME/.config/shdeps/hooks.d" |
    sed "\|^$REAL_HOME/.config/shdeps/hooks.d/neovim/neovim.sh$|d" || true
)
_assert_eq "custom hooks do not hide native github:release update policy" \
  "" "$_release_helpers"
_assert_not_contains "tree-sitter: no upstream release binary on Linux" \
  "tree-sitter/tree-sitter                   github:release" \
  "$(cat "$REAL_HOME/.config/shdeps/10-deps.conf")"

_gitleaks_dep=$(
  awk '$1 == "gitleaks/gitleaks" { print; exit }' \
    "$REAL_HOME/.config/shdeps/10-deps.conf"
)
_assert_eq "gitleaks: Linux requires a release binary" \
  "github:release" "$(awk '{ print $2 }' <<<"$_gitleaks_dep")"
_assert_eq "gitleaks: release matching uses the executable name" \
  "gitleaks" "$(awk '{ print $3 }' <<<"$_gitleaks_dep")"
_assert_contains "gitleaks: upstream release excludes Android" \
  "os:!macos,os:!android" "$_gitleaks_dep"

_tree_sitter_dep=$(
  awk '$1 == "tree-sitter-cli" && $2 == "pkg" { print; exit }' \
    "$REAL_HOME/.config/shdeps/10-deps.conf"
)
_assert_eq "tree-sitter: uses package manager instead of release binary" \
  "pkg" "$(awk '{ print $2 }' <<<"$_tree_sitter_dep")"
_assert_eq "tree-sitter: command maps to tree-sitter" \
  "tree-sitter" "$(awk '{ print $3 }' <<<"$_tree_sitter_dep")"
_assert_contains "tree-sitter: package aliases cover apt" \
  "apt:tree-sitter-cli" "$_tree_sitter_dep"
_assert_contains "tree-sitter: package aliases cover dnf" \
  "dnf:tree-sitter-cli" "$_tree_sitter_dep"
_assert_contains "tree-sitter: package aliases cover pacman" \
  "pacman:tree-sitter-cli" "$_tree_sitter_dep"
_assert_contains "tree-sitter: package aliases cover zypper" \
  "zypper:tree-sitter-cli" "$_tree_sitter_dep"
_assert_contains "tree-sitter: package aliases cover apk" \
  "apk:tree-sitter-cli" "$_tree_sitter_dep"
_assert_contains "tree-sitter: Homebrew uses formula name" \
  "brew:tree-sitter" "$_tree_sitter_dep"
_assert_contains "tree-sitter: Termux uses native package name" \
  "android:tree-sitter" "$_tree_sitter_dep"

_clippy_dep=$(
  awk '$1 == "clippy" && $2 == "pkg" { print; exit }' \
    "$REAL_HOME/.config/shdeps/00-toolchains.conf"
)
_assert_eq "clippy: uses package manager instead of cargo install" \
  "pkg" "$(awk '{ print $2 }' <<<"$_clippy_dep")"
_assert_eq "clippy: command check uses cargo subcommand binary" \
  "cargo-clippy" "$(awk '{ print $3 }' <<<"$_clippy_dep")"
_assert_contains "clippy: Debian package name is rust-clippy" \
  "apt:rust-clippy" "$_clippy_dep"
_assert_not_contains "clippy: Debian package name is not the command name" \
  "apt:cargo-clippy" "$_clippy_dep"
_assert_contains "clippy: Alpine package name is rust-clippy" \
  "apk:rust-clippy" "$_clippy_dep"
_assert_contains "clippy: Arch package bundles clippy with rust" \
  "pacman:rust" "$_clippy_dep"
_assert_contains "clippy: Homebrew formula bundles clippy with rust" \
  "brew:rust" "$_clippy_dep"
_assert_contains "clippy: Termux rust package bundles clippy" \
  "android:rust" "$_clippy_dep"
_assert_contains "rust-src: Termux rust package bundles sources" \
  "android:rust" \
  "$(awk '$1 == "rust-src" && $2 == "pkg" { print; exit }' "$REAL_HOME/.config/shdeps/00-toolchains.conf")"

echo "=== cmake-language-server hook ==="

_cmake_language_server_hook="$REAL_HOME/.config/shdeps/hooks.d/cmake-language-server.sh"
# shellcheck source=/dev/null
. "$_cmake_language_server_hook"

_cmake_language_server_bin=$(_mock_bin)
_cmake_language_server_calls=$(_tmpdir)/calls.log
cat >"$_cmake_language_server_bin/uv" <<'EOF'
#!/usr/bin/env bash
printf 'uv:%s\n' "$*" >>"$CMAKE_LANGUAGE_SERVER_TEST_CALLS"
case "${CMAKE_LANGUAGE_SERVER_TEST_INVENTORY:-valid}" in
  valid)
    printf 'other-tool v9.8.7 (/tools/other-tool)\n'
    printf '%s\n' '- other-tool (/bin/other-tool)'
    printf 'cmake-language-server v0.1.11 (/tools/cmake-language-server)\n'
    printf -- '- cmake-language-server (%s)\n' "$CMAKE_LANGUAGE_SERVER_TEST_ACTIVE"
    ;;
  empty) ;;
  malformed)
    printf 'cmake-language-server not-a-version (/tools/cmake-language-server)\n'
    printf -- '- cmake-language-server (%s)\n' "$CMAKE_LANGUAGE_SERVER_TEST_ACTIVE"
    ;;
  shadowed)
    printf 'cmake-language-server v9.8.7 (/tools/cmake-language-server)\n'
    printf '%s\n' '- cmake-language-server (/different/bin/cmake-language-server)'
    ;;
esac
EOF
chmod +x "$_cmake_language_server_bin/uv"
cat >"$_cmake_language_server_bin/cmake-language-server" <<'EOF'
#!/usr/bin/env bash
printf 'cmake-language-server:%s\n' "$*" >>"$CMAKE_LANGUAGE_SERVER_TEST_CALLS"
exit 99
EOF
chmod +x "$_cmake_language_server_bin/cmake-language-server"

_cmake_language_server_saved_path=$PATH
PATH="$_cmake_language_server_bin:/usr/bin:/bin"
export CMAKE_LANGUAGE_SERVER_TEST_CALLS="$_cmake_language_server_calls"
export CMAKE_LANGUAGE_SERVER_TEST_ACTIVE="$_cmake_language_server_bin/cmake-language-server"

CMAKE_LANGUAGE_SERVER_TEST_INVENTORY=valid
export CMAKE_LANGUAGE_SERVER_TEST_INVENTORY
_assert_eq "cmake-language-server: version comes from uv inventory" \
  "cmake-language-server 0.1.11" "$(version)"

CMAKE_LANGUAGE_SERVER_TEST_INVENTORY=empty
export CMAKE_LANGUAGE_SERVER_TEST_INVENTORY
_assert_eq "cmake-language-server: empty uv inventory omits version detail" \
  "" "$(version)"

CMAKE_LANGUAGE_SERVER_TEST_INVENTORY=malformed
export CMAKE_LANGUAGE_SERVER_TEST_INVENTORY
_assert_eq "cmake-language-server: malformed uv version is not reported" \
  "" "$(version)"

CMAKE_LANGUAGE_SERVER_TEST_INVENTORY=shadowed
export CMAKE_LANGUAGE_SERVER_TEST_INVENTORY
_assert_eq "cmake-language-server: shadowed uv install is not reported" \
  "" "$(version)"

_assert_eq "cmake-language-server: status queries the uv inventory" \
  $'uv:tool list --show-paths\nuv:tool list --show-paths\nuv:tool list --show-paths\nuv:tool list --show-paths' \
  "$(cat "$_cmake_language_server_calls")"
_assert_not_contains "cmake-language-server: status never launches the Python CLI" \
  "cmake-language-server:" "$(cat "$_cmake_language_server_calls")"
PATH=$_cmake_language_server_saved_path
unset CMAKE_LANGUAGE_SERVER_TEST_ACTIVE CMAKE_LANGUAGE_SERVER_TEST_CALLS
unset CMAKE_LANGUAGE_SERVER_TEST_INVENTORY
unset -f exists version install uninstall

_assert_contains "uv: Termux uses the native package" \
  "os:macos,os:android" \
  "$(awk '$1 == "uv" && $2 == "pkg" { print; exit }' "$REAL_HOME/.config/shdeps/00-toolchains.conf")"
_assert_contains "uv: upstream release checkout excludes Android" \
  "os:!macos,os:!android" \
  "$(awk '$1 == "astral-sh/uv" { print; exit }' "$REAL_HOME/.config/shdeps/00-toolchains.conf")"

_assert_contains "bat: Termux command keeps the native binary name" \
  "android:bat,apt:batcat" \
  "$(awk '$1 == "bat" && $2 == "pkg" { print; exit }' "$REAL_HOME/.config/shdeps/10-deps.conf")"

for _termux_native in difftastic direnv dust gum lazygit mise; do
  _assert_contains "$_termux_native: Termux uses the native package" \
    "os:macos,os:android" \
    "$(awk -v name="$_termux_native" '$1 == name && $2 == "pkg" { print; exit }' "$REAL_HOME/.config/shdeps/10-deps.conf")"
done

for _termux_upstream in \
  Wilfred/difftastic direnv/direnv bootandy/dust charmbracelet/gum \
  Decodetalkers/neocmakelsp editorconfig-checker/editorconfig-checker \
  jesseduffield/lazygit jdx/mise; do
  _assert_contains "$_termux_upstream: upstream install excludes Android" \
    "os:!macos,os:!android" \
    "$(awk -v name="$_termux_upstream" '$1 == name { print; exit }' "$REAL_HOME/.config/shdeps/10-deps.conf")"
done

echo "=== neovim hook ==="

_neovim_dep=$(
  awk '$1 == "neovim/neovim" { print; exit }' \
    "$REAL_HOME/.config/shdeps/10-deps.conf"
)
_assert_contains "neovim: launcher-owned binary is custom managed" \
  "custom" "$_neovim_dep"
_assert_not_contains "neovim: shdeps install supports Android" \
  "os:!android" "$_neovim_dep"
_assert_not_contains "neovim: macOS pkg entry does not trust launcher" \
  "neovim                                    pkg              nvim" \
  "$(cat "$REAL_HOME/.config/shdeps/10-deps.conf")"

_neovim_hook="$REAL_HOME/.config/shdeps/hooks.d/neovim/neovim.sh"
# shellcheck source=/dev/null
