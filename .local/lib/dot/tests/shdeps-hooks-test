# The CI bootstrap runs `dot update` before this suite.  Verify the installed
# release artifact itself rather than merely trusting a declaration's command
# field; an upstream rename can leave a valid-looking but unusable launcher.
_assert_shdeps_tool_runs() {
  local tool="$1" package="$2" path version_output

  if [[ "$(uname -s)" == "Darwin" ]]; then
    if ! brew list --versions "$package" >/dev/null 2>&1; then
      _fail "developer tool: $tool is installed by Homebrew"
      return
    fi
    path="$(brew --prefix "$package")/bin/$tool"
  else
    path="$REAL_HOME/.local/bin/$tool"
  fi

  if [[ ! -x "$path" ]]; then
    _fail "developer tool: $tool is installed by shdeps"
  elif version_output=$("$path" --version 2>&1); then
    _pass "developer tool: $tool runs after shdeps install"
  else
    # Keep the CI failure actionable without dumping arbitrary tool output.
    version_output="${version_output%%$'\n'*}"
    _fail "developer tool: $tool runs after shdeps install ($version_output)"
  fi
}

# Worktree tests intentionally keep source config separate from installed host
