cat >"$_gstack_merge_repo/SKILL.md" <<'MD'
---
name: gstack
---
MD
mkdir -p "$_gstack_merge_repo/projects" "$_gstack_merge_repo/sessions"
cat >"$_gstack_merge_repo/config.yaml" <<'YAML'
proactive: true
YAML
touch "$_gstack_merge_repo/.codex-desc-healed"
cat >"$_gstack_merge_repo/qa/SKILL.md" <<'MD'
---
name: qa
---
MD
cat >"$_gstack_merge_repo/setup" <<'SH'
#!/usr/bin/env bash
printf 'setup %s\n' "$*" >>"$GSTACK_MERGE_LOG"
SH
