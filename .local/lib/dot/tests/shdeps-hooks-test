for _dependency in ast-grep/ast-grep watchexec/watchexec fujiapple852/trippy; do
  _dependency_dep=$(awk -v name="$_dependency" '$1 == name { print; exit }' \
    "$REAL_HOME/.config/shdeps/10-deps.conf")
  _assert_eq "developer tool: $_dependency uses the native github updater" \
    "github" "$(awk '{ print $2 }' <<<"$_dependency_dep")"
  _assert_contains "developer tool: $_dependency excludes macOS github installs" \
    "os:!macos" "$_dependency_dep"
done

for _developer_tool in ast-grep watchexec trippy; do
  _developer_tool_dep=$(awk -v name="$_developer_tool" '$1 == name && $2 == "pkg" { print; exit }' \
    "$REAL_HOME/.config/shdeps/10-deps.conf")
  _assert_eq "developer tool: $_developer_tool uses Homebrew on macOS" \
    "pkg" "$(awk '{ print $2 }' <<<"$_developer_tool_dep")"
  _assert_contains "developer tool: $_developer_tool package route is macOS-only" \
