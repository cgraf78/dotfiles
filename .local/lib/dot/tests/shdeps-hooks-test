# The hooks now record skips through shdeps' binary-backed helpers, which shdeps
# provides at runtime. Mock them onto the test's install dir so coverage stays
# hermetic (shdeps itself is tested in its own repo). They resolve the install
# dir at call time, so each block's shdeps_install_dir mock drives them.
# shellcheck disable=SC2329  # invoked indirectly by the sourced hook.
shdeps_skip() {
  local marker
  marker="$(shdeps_install_dir)/$1/.skipped"
  mkdir -p "$(dirname "$marker")"
  printf '%s\n' "${2:-skipped}" >"$marker"
