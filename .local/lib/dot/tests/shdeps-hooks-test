  _pass "neovim: brew install exposes real binary behind launcher"
else
  _fail "neovim: brew install exposes real binary behind launcher"
fi
_assert_eq "neovim: brew real binary points at Homebrew nvim" \
  "$_nvim_brew_prefix/bin/nvim" "$(readlink "$_nvim_home/neovim/neovim/bin/nvim")"
_assert_file_missing "neovim: brew install leaves public launcher path alone" \
  "$_nvim_bin/nvim"
if exists "neovim/neovim"; then
  _pass "neovim: real binary satisfies exists check"
else
  _fail "neovim: real binary satisfies exists check"
fi
_assert_eq "neovim: version comes from real binary" "v0.12.0" "$(version "neovim/neovim")"

_nvim_termux_prefix=$(_tmpdir)
mkdir -p "$_nvim_termux_prefix/bin"
cat >"$_nvim_termux_prefix/bin/nvim" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' 'NVIM v0.12.3'
EOF
chmod +x "$_nvim_termux_prefix/bin/nvim"

# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_platform_match() { [[ "${1:-}" == android ]]; }
# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_pkg_mgr() { echo apt; }
# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_pkg_install_for_mgr() {
  printf 'pkg:%s\n' "$*" >>"$_nvim_calls"
  return 0
}
export PREFIX="$_nvim_termux_prefix"
install "neovim/neovim"
_assert_contains "neovim: Termux installs the native package" \
  "pkg:apt:neovim" "$(cat "$_nvim_calls")"
_assert_eq "neovim: Termux real binary points at native nvim" \
  "$_nvim_termux_prefix/bin/nvim" \
  "$(readlink "$_nvim_home/neovim/neovim/bin/nvim")"

# Keep the release-asset test on its non-Android path.
# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_platform_match() { return 1; }

# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_pkg_mgr() { echo apt; }
# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_github_release_install() {
  printf 'release:%s|%s|%s|%s\n' "$1" "$2" "$3" "$4" >>"$_nvim_calls"
}
install "neovim/neovim"
_assert_contains "neovim: github release avoids legacy self-link target" \
  "release:neovim/neovim|nvim|neovim/neovim|$_nvim_home/neovim/neovim/bin/nvim.shdeps-link" \
  "$(cat "$_nvim_calls")"
_assert_file_missing "neovim: github release removes disposable side link" \
  "$_nvim_home/neovim/neovim/bin/nvim.shdeps-link"

unset -f exists version install uninstall shdeps_install_dir shdeps_bin_dir \
  shdeps_pkg_mgr shdeps_reinstall shdeps_pkg_install_for_mgr \
  shdeps_github_release_install shdeps_platform_match

echo "=== wezterm hook ==="

_wezterm_hook="$REAL_HOME/.config/shdeps/hooks.d/wezterm.sh"
# shellcheck source=/dev/null
. "$_wezterm_hook"

# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_platform() { echo darwin; }
# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_pkg_mgr() { echo brew; }
_wezterm_brew=$(_mock_bin)
cat >"$_wezterm_brew/brew" <<'EOF'
#!/usr/bin/env bash
printf 'brew should not run in CI\n' >&2
exit 1
EOF
chmod +x "$_wezterm_brew/brew"
if CI=1 PATH="$_wezterm_brew:/usr/bin:/bin" exists "wez/wezterm"; then
  _pass "wezterm: CI satisfies GUI terminal dependency"
else
  _fail "wezterm: CI satisfies GUI terminal dependency"
fi
if CI=1 PATH="$_wezterm_brew:/usr/bin:/bin" install "wez/wezterm"; then
