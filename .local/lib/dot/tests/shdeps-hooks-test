_gstack_merge_log=$(_tmpdir)/gstack-merge.log
_gstack_merge_agent_bin=$(_mock_bin)
cat >"$_gstack_merge_agent_bin/codex" <<'SH'
#!/usr/bin/env bash
exit 0
SH
chmod +x "$_gstack_merge_agent_bin/codex"
_saved_home=$HOME
_saved_path=$PATH
HOME=$_gstack_merge_home
# Keep this migration fixture independent of host-installed agents: it models a
# Codex-only machine, so a real /usr/local/bin/gemini must not affect results.
PATH="$_gstack_merge_agent_bin:/usr/bin:/bin"
export GSTACK_MERGE_LOG=$_gstack_merge_log
export DOT_GSTACK_REGISTER_LIB="$REAL_HOME/.local/lib/dot/gstack-register/api.sh"
# shellcheck disable=SC2329  # sourced merge helper calls this by name.
_warn() { printf '%s\n' "$*" >&2; }
# shellcheck disable=SC2329  # sourced merge helper calls this by name.
_log() { printf '%s\n' "$*" >/dev/null; }

