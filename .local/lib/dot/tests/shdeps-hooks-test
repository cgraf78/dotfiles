  "os:!alpine" "$_ast_grep_github_dep"
_ast_grep_alpine_dep=$(awk '$1 == "ast-grep" && $2 == "pkg" && /os:alpine/ { print; exit }' \
  "$REAL_HOME/.config/shdeps/10-deps.conf")
