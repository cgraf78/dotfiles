else
  _fail "wezterm: CI install path is a no-op"
fi

unset -f exists version install shdeps_platform shdeps_pkg_mgr

echo "=== gstack hook ==="

_assert_not_contains "gstack: dotfiles do not install Bun for skill registration" \
  "bun                                       custom" \
  "$(cat "$REAL_HOME/.config/shdeps/00-toolchains.conf")"
_gstack_dep=$(
  awk '$1 == "garrytan/gstack" { print; exit }' \
    "$REAL_HOME/.config/shdeps/10-deps.conf"
)
_assert_eq "gstack: repository dependency is managed by shdeps" \
  "github" "$(awk '{ print $2 }' <<<"$_gstack_dep")"

echo "=== shdeps dependency repos ==="

for _dependency in agentguard checkrun cmdblocks sley termnav; do
  _dependency_dep=$(
    awk -v name="cgraf78/$_dependency" '$1 == name { print; exit }' \
