  "$_gstack_merge_repo/config.yaml"
# Blast-radius invariant: migration moves ONLY whitelisted runtime entries. The
# upstream checkout holds source content (skills, a setup script) with no
# whitelist entry; those must stay in the checkout and must NOT be drained into
# durable ~/.gstack state.
_assert_file_exists "gstack: migration leaves unknown checkout skill in place" \
  "$_gstack_merge_repo/qa/SKILL.md"
_assert_file_exists "gstack: migration leaves the upstream setup script in place" \
  "$_gstack_merge_repo/setup"
_assert_file_exists "gstack: migration leaves the top-level source SKILL.md in place" \
  "$_gstack_merge_repo/SKILL.md"
_assert_file_missing "gstack: migration does not drain unknown skill into state" \
  "$_gstack_merge_home/.gstack/qa/SKILL.md"
_assert_file_missing "gstack: migration does not drain the setup script into state" \
  "$_gstack_merge_home/.gstack/setup"
_assert_file_missing "gstack: dot update skips Gemini when Gemini CLI is missing" \
  "$_gstack_merge_home/.gemini/extensions/gstack/gemini-extension.json"

: >"$_gstack_merge_log"
