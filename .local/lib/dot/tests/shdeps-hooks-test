case "${CMAKE_LANGUAGE_SERVER_TEST_INVENTORY:-valid}" in
  valid)
    printf 'other-tool v9.8.7 (/tools/other-tool)\n'
    printf '%s\n' '- other-tool (/bin/other-tool)'
    printf 'cmake-language-server v0.1.11 (/tools/cmake-language-server)\n'
    printf -- '- cmake-language-server (%s)\n' "$CMAKE_LANGUAGE_SERVER_TEST_ACTIVE"
