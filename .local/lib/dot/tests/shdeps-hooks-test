EOF
chmod +x "$_cmake_language_server_bin/uv"
cat >"$_cmake_language_server_bin/cmake-language-server" <<'EOF'
#!/usr/bin/env bash
printf 'cmake-language-server:%s\n' "$*" >>"$CMAKE_LANGUAGE_SERVER_TEST_CALLS"
exit 99
EOF
chmod +x "$_cmake_language_server_bin/cmake-language-server"

_cmake_language_server_saved_path=$PATH
PATH="$_cmake_language_server_bin:/usr/bin:/bin"
export CMAKE_LANGUAGE_SERVER_TEST_CALLS="$_cmake_language_server_calls"
export CMAKE_LANGUAGE_SERVER_TEST_ACTIVE="$_cmake_language_server_bin/cmake-language-server"

CMAKE_LANGUAGE_SERVER_TEST_INVENTORY=valid
export CMAKE_LANGUAGE_SERVER_TEST_INVENTORY
_assert_eq "cmake-language-server: version comes from uv inventory" \
  "cmake-language-server 0.1.11" "$(version)"

CMAKE_LANGUAGE_SERVER_TEST_INVENTORY=empty
export CMAKE_LANGUAGE_SERVER_TEST_INVENTORY
_assert_eq "cmake-language-server: empty uv inventory omits version detail" \
  "" "$(version)"

CMAKE_LANGUAGE_SERVER_TEST_INVENTORY=malformed
export CMAKE_LANGUAGE_SERVER_TEST_INVENTORY
_assert_eq "cmake-language-server: malformed uv version is not reported" \
