  "$_gstack_home/.gstack/dotfiles-skills/gstack-qa/SKILL.md"
_assert_file_exists "gstack: post hook creates shared Gemini context" \
  "$_gstack_home/.gstack/dotfiles-skills/GEMINI.md"
_assert_file_exists "gstack: post hook marks shared generated skill as managed" \
  "$_gstack_home/.gstack/dotfiles-skills/gstack-qa/.dotfiles-managed-gstack"
_assert_file_exists "gstack: post hook links prefixed Claude skill" \
  "$_gstack_home/.claude/skills/gstack-qa/SKILL.md"
_assert_eq "gstack: post hook points Claude skill at shared generated skill" \
  "$_gstack_home/.gstack/dotfiles-skills/gstack-qa" \
  "$(readlink "$_gstack_home/.claude/skills/gstack-qa")"
_assert_file_missing "gstack: post hook removes legacy unprefixed Claude skill" \
  "$_gstack_home/.claude/skills/qa/SKILL.md"
_assert_contains "gstack: post hook preserves unmanaged Claude skill collision" \
  "name: manual-owned" "$(cat "$_gstack_home/.claude/skills/manual/SKILL.md")"
_assert_file_missing "gstack: post hook prunes stale Claude gstack link" \
  "$_gstack_home/.claude/skills/checkpoint"
_assert_file_missing "gstack: post hook prunes legacy unprefixed Codex copy" \
  "$_gstack_home/.codex/skills/qa/SKILL.md"
_assert_file_exists "gstack: post hook preserves unmanaged Codex skill with prose marker" \
  "$_gstack_home/.codex/skills/review/SKILL.md"
_assert_file_missing "gstack: post hook prunes removed-source legacy Codex copy" \
  "$_gstack_home/.codex/skills/removed/SKILL.md"
_assert_file_missing "gstack: post hook prunes stale managed Codex skill" \
  "$_gstack_home/.codex/skills/gstack-old/SKILL.md"
_assert_file_exists "gstack: post hook links Codex source skill" \
  "$_gstack_home/.codex/skills/gstack-qa/SKILL.md"
_assert_eq "gstack: post hook points Codex skill at shared generated skill" \
  "$_gstack_home/.gstack/dotfiles-skills/gstack-qa" \
  "$(readlink "$_gstack_home/.codex/skills/gstack-qa")"
_assert_file_exists "gstack: post hook marks Codex source skill as managed" \
  "$_gstack_home/.codex/skills/gstack-qa/.dotfiles-managed-gstack"
_assert_file_missing "gstack: post hook removes legacy Codex runtime root" \
  "$_gstack_home/.codex/skills/gstack/SKILL.md"
_assert_contains "gstack: post hook rewrites Codex skill name" \
  "name: gstack-qa" "$(cat "$_gstack_home/.codex/skills/gstack-qa/SKILL.md")"
_assert_contains "gstack: post hook quotes invalid Codex YAML descriptions" \
  'description: "QA workflow: catches visual regressions. (gstack)"' \
  "$(cat "$_gstack_home/.codex/skills/gstack-qa/SKILL.md")"
_assert_contains "gstack: post hook rewrites absolute Claude runtime paths" \
  "Run $_gstack_repo/bin/gstack-config" \
  "$(cat "$_gstack_home/.gstack/dotfiles-skills/gstack-qa/SKILL.md")"
