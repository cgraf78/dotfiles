cat >"$_nvim_brew/brew" <<'EOF'
#!/usr/bin/env bash
case "$*" in
  "list neovim") exit 0 ;;
  "--prefix neovim") printf '%s\n' "$NVIM_TEST_BREW_PREFIX" ;;
  *) exit 1 ;;
esac
EOF
chmod +x "$_nvim_brew/brew"

# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
