_assert_file_exists "gstack: post hook marks Gemini extension as managed" \
  "$_gstack_home/.gemini/extensions/gstack/.dotfiles-managed-gstack"
_assert_eq "gstack: post hook points Gemini context at shared generated context" \
  "$_gstack_home/.gstack/dotfiles-skills/GEMINI.md" \
  "$(readlink "$_gstack_home/.gemini/extensions/gstack/GEMINI.md")"
