  "os:alpine" "$_ast_grep_alpine_dep"
_assert_eq "ast-grep: command is ast-grep" "ast-grep" \
  "$(awk '$1 == "ast-grep/ast-grep" { print $3; exit }' "$REAL_HOME/.config/shdeps/10-deps.conf")"
