# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_bin_dir() { echo "$_nvim_bin"; }
# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_pkg_mgr() { echo brew; }
# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_reinstall() { return 1; }
# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_pkg_install_for_mgr() {
  printf 'pkg:%s\n' "$*" >>"$_nvim_calls"
  return 0
}
PATH="$_nvim_brew:/usr/bin:/bin" \
  NVIM_TEST_BREW_PREFIX="$_nvim_brew_prefix" \
  install "neovim/neovim"
