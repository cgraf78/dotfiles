JSON
ln -sfn "$_gstack_merge_repo/SKILL.md" "$_gstack_merge_home/.gemini/extensions/gstack/GEMINI.md"
if merge; then
  _pass "gstack: stamped migration refreshes lightweight registrations"
else
  _fail "gstack: stamped migration refreshes lightweight registrations"
fi
_assert_eq "gstack: stamped migration still skips upstream setup" "" "$(cat "$_gstack_merge_log")"
_assert_file_exists "gstack: stamped migration restores missing Codex skill" \
  "$_gstack_merge_home/.codex/skills/gstack-qa/SKILL.md"
_assert_file_missing "gstack: stamped migration removes stale Gemini extension when CLI is missing" \
  "$_gstack_merge_home/.gemini/extensions/gstack/gemini-extension.json"

