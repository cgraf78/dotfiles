export GSTACK_HOOK_LOG=$_gstack_log
export DOT_GSTACK_REGISTER_LIB="$REAL_HOME/.local/lib/dot/gstack-register/api.sh"
# shellcheck disable=SC2329  # sourced hook helper calls this by name.
shdeps_warn() { printf '%s\n' "$*" >&2; }

# shellcheck source=/dev/null
. "$_gstack_hook"

if post "garrytan/gstack"; then
  _pass "gstack: post hook registers skills"
else
  _fail "gstack: post hook registers skills"
fi
_assert_eq "gstack: post hook does not run upstream setup" "" "$(cat "$_gstack_log" 2>/dev/null)"
_assert_file_missing "gstack: post hook removes Claude compatibility root" \
  "$_gstack_home/.claude/skills/gstack/SKILL.md"
_assert_file_missing "gstack: post hook removes legacy Claude connect-chrome alias" \
  "$_gstack_home/.claude/skills/connect-chrome"
