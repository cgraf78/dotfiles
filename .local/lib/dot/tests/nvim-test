_assert_eq "startup timeout: forced kill tolerates macOS permission race" "0" "$rc"

timeout_cancel_descendant_pid="$timeout_fixture_dir/cancel-descendant.pid"
timeout_wrapper_pid_file="$timeout_fixture_dir/wrapper.pid"
DOT_TEST_TIMEOUT_WRAPPER_PID_FILE="$timeout_wrapper_pid_file" \
  DOT_TEST_TIMEOUT_CHILD="$timeout_fixture_dir/child.py" \
  DOT_TEST_TIMEOUT_DESCENDANT_PID="$timeout_cancel_descendant_pid" \
  _with_timeout 30 "$timeout_fixture_dir/parent.sh" &
timeout_call_pid=$!
timeout_wait_started=$SECONDS
while [[ ! -s "$timeout_wrapper_pid_file" || ! -s "$timeout_cancel_descendant_pid" ]]; do
  if ((SECONDS - timeout_wait_started >= 5)); then
    break
  fi
  sleep 0.05
done
if [[ -s "$timeout_wrapper_pid_file" && -s "$timeout_cancel_descendant_pid" ]]; then
  timeout_wrapper_pid=$(cat "$timeout_wrapper_pid_file")
  kill -TERM "$timeout_wrapper_pid"
  rc=0
  wait "$timeout_call_pid" || rc=$?
  _assert_eq "startup timeout: cancellation preserves signal status" "143" "$rc"
  cancel_descendant_pid=$(cat "$timeout_cancel_descendant_pid")
  _assert_process_stopped "startup timeout: cancellation kills descendant process group" \
    "$cancel_descendant_pid"
else
  _fail "startup timeout: cancellation fixture becomes ready"
  kill -TERM "$timeout_call_pid" 2>/dev/null || true
  wait "$timeout_call_pid" 2>/dev/null || true
fi

