rc=0
python3 - "$_DOT_TEST_TIMEOUT_PY" <<'PY' || rc=$?
import importlib.util
import signal
import sys

spec = importlib.util.spec_from_file_location("dot_timeout", sys.argv[1])
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)


class Process:
    pid = 123
    waited = False

    def wait(self):
        self.waited = True


process = Process()
module.process = process
module.time.sleep = lambda _: None


def killpg(_pid, signum):
    if signum == signal.SIGKILL:
        raise PermissionError


module.os.killpg = killpg
module.stop_process_group(signal.SIGTERM)
assert process.waited
