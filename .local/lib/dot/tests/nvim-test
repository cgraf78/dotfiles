#!/usr/bin/env bash
# nvim-test — unit tests for custom nvim config modules.
#
# Runs lua tests headlessly via `nvim --headless` to exercise dotfiles-owned
# Neovim config modules and integration wiring for extracted plugins.
#
# Usage: nvim-test

set -o pipefail
export NO_COLOR=1

# shellcheck source=helpers.sh
. "$HOME/.local/lib/dot/tests/helpers.sh"

_require_compatible_libc "nvim-test"
_test_use_host_runtime_dirs
_test_use_host_shdeps

# Run a lua snippet headlessly in nvim. Prepends the nvim config lua dir
# to package.path so dofile'd modules can resolve their require() calls.
_nvim_lua() {
  local _lua_dir="$HOME/.config/nvim/lua"
  # Keep headless tests off the user's ShaDa file. `dot-test` runs suites in
  # parallel, and concurrent nvim processes can otherwise fight over
  # ~/.local/state/nvim/shada/main.shada.
  nvim --headless --noplugin -u NONE -i NONE \
    -c "lua package.path='$_lua_dir/?.lua;' .. package.path; $1" \
    -c 'qa!' 2>&1
}

# Run a Lua snippet after loading the VSCode-style keymaps. These tests use
# Select mode directly because that is what lets printable keys replace
# selected text; command-style mappings need to avoid inserting their rhs.
_nvim_vscode_keys() {
  _nvim_lua "
    vim.o.selection = 'exclusive'
    vim.o.clipboard = ''
    dofile(vim.fn.expand('~/.config/nvim/lua/config/keymaps/vscode.lua'))
    $1
  "
}

# Keep one full-config smoke test in this suite. Most tests use `--noplugin`
# unit snippets for determinism, but startup/shutdown regressions usually hide
# in integration paths such as filetype, LSP, lint, and workspace root probes.
_nvim_startup_budget() {
  if [[ -n "${NVIM_STARTUP_BUDGET_SECONDS:-}" ]]; then
    printf '%s\n' "$NVIM_STARTUP_BUDGET_SECONDS"
  elif [[ "${DOT_TEST_PARALLEL:-0}" = 1 && "${DOT_TEST_JOBS:-1}" =~ ^[0-9]+$ && "${DOT_TEST_JOBS:-1}" -gt 1 ]]; then
    # The full config smoke test runs real startup/shutdown while dot-test may
    # also be driving shell, Git, bootstrap, and editor suites. Keep direct
    # single-suite runs strict, but scale the parallel-run budget with load.
    printf '%s\n' "$((6 + DOT_TEST_JOBS * 2))"
  elif [[ -n "${WSL_DISTRO_NAME:-}" || -n "${WSL_INTEROP:-}" ]]; then
    # WSL terminal sessions can be CPU- and IO-constrained under the full
    # parallel dot-test load. Keep the smoke test meaningful without making it
    # fail only because the host is busy.
    printf '15\n'
  else
    printf '6\n'
  fi
}

_run_nvim_startup() {
  local timeout_seconds="$1" file="$2"

  _with_timeout "$timeout_seconds" nvim -i NONE --headless \
    --cmd 'lua vim.g.mason_disabled = true' \
    "$file" '+qa!'
}

_prepare_nvim_startup() {
  local file="$1" budget="$2" remaining output rc elapsed
  local total_elapsed=0

  while :; do
    remaining=$((120 - total_elapsed))
    if [[ "$remaining" -le 0 ]]; then
      echo "startup preparation did not converge within 120 seconds"
      return 124
    fi

    SECONDS=0
    output=$(_run_nvim_startup "$remaining" "$file" 2>&1)
    rc=$?
    elapsed=$SECONDS
    total_elapsed=$((total_elapsed + elapsed))
    if [[ "$rc" -ne 0 ]]; then
      printf '%s\n' "$output"
      return "$rc"
    fi

    [[ "$elapsed" -le "$budget" ]] && return 0
  done
}

_assert_nvim_startup_budget() {
  local desc="$1" file="$2" budget
  local output rc elapsed
  budget=$(_nvim_startup_budget)

  # LazyVim may populate plugins on first launch; measure only after that
  # readiness process has completed successfully.
  output=$(_prepare_nvim_startup "$file" "$budget" 2>&1)
  rc=$?
  if [[ "$rc" -ne 0 ]]; then
    _fail "$desc preparation failed (exit $rc; output: $output)"
    return
  fi

  SECONDS=0
  output=$(_run_nvim_startup 20 "$file" 2>&1)
  rc=$?
  elapsed=$SECONDS

  if [[ "$rc" -eq 0 && "$elapsed" -le "$budget" ]]; then
    _pass "$desc"
  else
    _fail "$desc (exit $rc after ${elapsed}s, budget ${budget}s; output: $output)"
  fi
}

