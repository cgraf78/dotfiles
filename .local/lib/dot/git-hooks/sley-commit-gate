#!/usr/bin/env bash
# sley-commit-gate — add dotfiles policy before Sley's generic gate.

set -u

# The Git launcher runs `$HOME` commits against the base bare dotfiles repo
# (`~/.dotfiles`) with `$HOME` as the work tree. In that shape, Sley's
# untracked-file status walk would traverse all of `$HOME`; commit scope only
# needs staged files, so use the launcher's untracked-walk escape hatch.
if [ "${SLEY_SKIP_UNTRACKED:-0}" != "1" ] &&
  [ -n "${GIT_DIR:-}" ] &&
  [ -n "${GIT_WORK_TREE:-}" ]; then
  git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null || true)
  if [ "$(basename "$git_dir")" = ".dotfiles" ]; then
    export SLEY_SKIP_UNTRACKED=1
  fi
fi

# Everything after the bare-repository policy belongs to Sley. Keeping this
# final dispatch separate makes the ownership boundary visible and prevents a
# future Sley fix from being reimplemented in dotfiles.
hook_dir=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd) || exit 1
exec "$hook_dir/sley-provider-hook" sley-commit-gate "$@"
