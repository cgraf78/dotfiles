#!/usr/bin/env bash
# vscode-sley-test — verify dotfiles' thin Sley extension consumer contract.

set -euo pipefail

# shellcheck source=helpers.sh
. "$HOME/.local/lib/dotfiles/legacy-dot/tests/helpers.sh"

echo "=== VS Code Sley integration ==="

asset_rel=share/sley/vscode/sley-tools-0.0.1
expected_source="\$HOME/.local/share/cgraf78/sley/$asset_rel"
declared_id=$(
  awk -F '\t' '$1 == "cgraf.sley-tools" { print $1; exit }' \
    "$HOME/.config/dot/merge-hooks.d/vscode/local-extensions.d/10-extensions.tsv"
)
declared_source=$(
  awk -F '\t' '$1 == "cgraf.sley-tools" { print $2; exit }' \
    "$HOME/.config/dot/merge-hooks.d/vscode/local-extensions.d/10-extensions.tsv"
)

# The literal stable-link path is intentional. `dot update` refreshes shdeps
# before merge hooks run, so activation follows the currently installed Sley
# checkout without copying provider bytes back into this repository.
_assert_eq "vscode sley: declaration uses Sley dependency asset" \
  "$expected_source" "$declared_source"
_assert_file_missing "vscode sley: dotfiles carries no extension manifest" \
  "$HOME/.local/share/dot-vscode-extensions/sley-tools-0.0.1/package.json"
_assert_file_missing "vscode sley: dotfiles carries no extension entry point" \
  "$HOME/.local/share/dot-vscode-extensions/sley-tools-0.0.1/extension.js"

# Cross-repository PRs set DOT_TEST_SLEY_ROOT to the exact provider commit.
# Normal fleet and post-merge test runs resolve the same contract through the
# host's stable shdeps link. Failing when neither has the published asset keeps
# an incomplete provider/consumer update visible instead of silently reducing
# this smoke test to a static TSV assertion.
provider_root="${DOT_TEST_SLEY_ROOT:-${DOT_TEST_HOST_HOME:-$HOME}/.local/share/cgraf78/sley}"
extension_dir="$provider_root/$asset_rel"
manifest="$extension_dir/package.json"

_assert_file_exists "vscode sley: provider publishes manifest" "$manifest"

# Sley owns its versioned directory and entry-point packaging invariants. The
# useful consumer contract is narrower: the extension ID that dotfiles
# activates must match the package published at the configured dependency path.
if [[ -r "$manifest" ]]; then
  package_name=$(jq -r '.name // ""' "$manifest")
  package_publisher=$(jq -r '.publisher // ""' "$manifest")

  _assert_eq "vscode sley: declared ID matches provider package" \
    "$declared_id" "$package_publisher.$package_name"
fi

_test_summary
