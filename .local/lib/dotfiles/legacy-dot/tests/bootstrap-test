# ---- Fresh install (with overlay) ----

if $_bootstrap_run_overlay; then
  echo ""
  echo "=== Fresh install (with overlay) ==="

  FRESH_WORK=$(_tmpdir)
  result=$(_run_bootstrap "$FRESH_WORK")

  # Base dotfiles set up
  _assert_file_exists "overlay: .bashrc checked out" "$FRESH_WORK/.bashrc"

  # Overlay repo cloned
  if [[ -d "$FRESH_WORK/.dotfiles-work" ]]; then
    _pass "overlay: work repo cloned"
  else
    _fail "overlay: work repo cloned"
  fi
  _assert_file_exists "overlay: work config present" "$FRESH_WORK/.dotfiles-work/work-config"
  _assert_contains "overlay: work files linked" "Overlays" "$result"
  if [[ -L "$FRESH_WORK/.testrc_work" ]]; then
    _pass "overlay: symlink created"
  else
    _fail "overlay: symlink created"
  fi

  # Done message
  _assert_contains "overlay: done message" "Done" "$result"

  # ---- Re-run on existing machine ----

  echo ""
  echo "=== Re-run (existing setup) ==="

  # Run again on the same home — should succeed without re-cloning
  result=$(_run_bootstrap "$FRESH_WORK")

  # Should NOT try to clone (repo already exists)
  _assert_not_contains "re-run: skips clone" "Cloning dotfiles" "$result"

  # Overlay repo exists → pulls instead of cloning
  _assert_contains "re-run: pulls overlay repo" "Pulling work" "$result"
  _assert_not_contains "re-run: no overlay clone" "Cloning work" "$result"

  # Still succeeds
  _assert_contains "re-run: done message" "Done" "$result"

  # ---- Auto-detect: overlays present → processes them ----

  echo ""
  echo "=== Auto-detect overlays ==="

  # No args + overlay conf present → clones/pulls overlay
  result=$(_run_bootstrap "$FRESH_WORK")
  _assert_contains "auto-detect: overlay processed" "Pulling work" "$result"
  _assert_contains "auto-detect: done" "Done" "$result"

  # No args + no overlay conf → base only
  AUTO_BASE_ONLY=$(_tmpdir)
  result=$(_run_bootstrap_base "$AUTO_BASE_ONLY")
  _assert_not_contains "auto-detect: no overlay" "Pulling work" "$result"
  _assert_not_contains "auto-detect: no clone" "Cloning work" "$result"
  _assert_contains "auto-detect: base done" "Done" "$result"

  # Required overlay failures must fail bootstrap rather than writing the
  # success marker. Optional overlays are how a conf says "skip if unavailable".
  FRESH_REQUIRED_FAIL=$(_tmpdir)
  git clone --bare "$BASE_ORIGIN" "$FRESH_REQUIRED_FAIL/.dotfiles" >/dev/null 2>&1
  mkdir -p "$FRESH_REQUIRED_FAIL/.config/dot/overlays.d"
  cat >"$FRESH_REQUIRED_FAIL/.config/dot/overlays.d/10-work.conf" <<CONF
url=$WORK_ORIGIN
CONF
  cat >"$FRESH_REQUIRED_FAIL/.config/dot/overlays.d/10-work.ssh" <<'SSH'
Host github-dotfiles-work
  HostName github.com
  User git
  IdentityFile ~/.ssh/dotfiles-work-bootstrap-test-nonexistent
SSH
  required_rc=0
  required_result=$(
    DOTBOOTSTRAP_SOURCED="" \
      HOME="$FRESH_REQUIRED_FAIL" \
      SHDEPS_TEST_TOOL_REPO="$TEST_TOOL_ORIGIN" \
      SHDEPS_HOOK_PACK_REPO="$HOOK_PACK_ORIGIN" \
      "$BIN_DIR/dotbootstrap" 2>&1
  ) || required_rc=$?
  _assert_exit "overlay: required missing key fails bootstrap" 1 "$required_rc"
  _assert_contains "overlay: required missing key explains incomplete bootstrap" \
    "required overlay sync failed" "$required_result"
  if [[ ! -e "$FRESH_REQUIRED_FAIL/.dotbootstrap-done" ]]; then
    _pass "overlay: required failure does not write done marker"
  else
    _fail "overlay: required failure does not write done marker"
  fi

  # Exercise the actual top-level signal traps, not only the resource helper
  # in isolation. A blocking Git wrapper keeps a real overlay worker alive
  # until dotbootstrap is terminated; the bounded waits keep a regression from
  # hanging the test suite that is meant to detect it.
  FRESH_CANCEL=$(_tmpdir)
  git clone --bare "$BASE_ORIGIN" "$FRESH_CANCEL/.dotfiles" >/dev/null 2>&1
  mkdir -p "$FRESH_CANCEL/.config/dot/overlays.d"
  cat >"$FRESH_CANCEL/.config/dot/overlays.d/10-work.conf" <<CONF
url=$WORK_ORIGIN
CONF
  CANCEL_BIN=$(_tmpdir)
  CANCEL_TMP=$(_tmpdir)
  CANCEL_READY="$CANCEL_TMP/clone-ready"
  CANCEL_CHILD_PID="$CANCEL_TMP/clone.pid"
  CANCEL_OUT="$CANCEL_TMP/bootstrap.out"
  # Delegate through the tracked launcher in explicit-real mode. Its normal
  # PATH-aware resolution works on nonstandard layouts without rediscovering
  # this blocking wrapper or hardcoding platform install prefixes.
  REAL_GIT="$BIN_DIR/git"
  REAL_PYTHON=$(command -v python3)
  cat >"$CANCEL_BIN/git" <<'SH'
#!/usr/bin/env bash
if [[ "${1:-}" == clone && "${2:-}" == "$DOT_TEST_BLOCK_CLONE_URL" ]]; then
  exec "$DOT_TEST_REAL_PYTHON" - "$DOT_TEST_BLOCK_READY" "$DOT_TEST_BLOCK_PID" <<'PY'
import os
import pathlib
import signal
import sys
import time

for sig in (signal.SIGHUP, signal.SIGINT, signal.SIGQUIT, signal.SIGTERM):
    signal.signal(sig, signal.SIG_IGN)
pathlib.Path(sys.argv[2]).write_text(f"{os.getpid()}\n", encoding="ascii")
pathlib.Path(sys.argv[1]).touch()
while True:
    time.sleep(60)
PY
fi
DOT_GIT_REAL=1 PATH="$DOT_TEST_REAL_GIT_PATH" \
  exec "$DOT_TEST_REAL_GIT" "$@"
SH
  chmod +x "$CANCEL_BIN/git"

  DOTBOOTSTRAP_SOURCED="" \
    HOME="$FRESH_CANCEL" \
    TMPDIR="$CANCEL_TMP" \
    PATH="$CANCEL_BIN:$BOOTSTRAP_TEST_PATH" \
    DOT_TEST_REAL_GIT="$REAL_GIT" \
    DOT_TEST_REAL_GIT_PATH="$BOOTSTRAP_TEST_PATH" \
    DOT_TEST_REAL_PYTHON="$REAL_PYTHON" \
    DOT_TEST_BLOCK_CLONE_URL="$WORK_ORIGIN" \
    DOT_TEST_BLOCK_READY="$CANCEL_READY" \
    DOT_TEST_BLOCK_PID="$CANCEL_CHILD_PID" \
    SHDEPS_TEST_TOOL_REPO="$TEST_TOOL_ORIGIN" \
    SHDEPS_HOOK_PACK_REPO="$HOOK_PACK_ORIGIN" \
    "$BIN_DIR/dotbootstrap" >"$CANCEL_OUT" 2>&1 &
  cancel_bootstrap_pid=$!

  cancel_ready=0
  for _ in {1..200}; do
    if [[ -f "$CANCEL_READY" ]]; then
      cancel_ready=1
      break
    fi
    jobs -pr | grep -qx "$cancel_bootstrap_pid" || break
    sleep 0.05
  done
  if [[ "$cancel_ready" -eq 1 ]]; then
    _pass "cancellation: real bootstrap reaches an owned overlay worker"
  else
    _fail "cancellation: real bootstrap reaches an owned overlay worker"
  fi

  # The result directory is registered before the clone starts. Preserve the
  # harness-owned control files while checking that private worker scratch is
  # present and subsequently removed.
  cancel_scratch_before=$(find "$CANCEL_TMP" -mindepth 1 -maxdepth 1 \
    ! -name clone-ready ! -name clone.pid ! -name bootstrap.out -print -quit)
  if [[ -n "$cancel_scratch_before" ]]; then
    _pass "cancellation: real bootstrap registers private worker scratch"
  else
    _fail "cancellation: real bootstrap registers private worker scratch"
  fi

  kill -TERM "$cancel_bootstrap_pid" 2>/dev/null || true
  cancel_timed_out=1
  # Poll the actual job state; the 30-second cap is only a deadlock watchdog.
  # Loaded CI runners can spend more than ten seconds scheduling nested cleanup
  # even though each owner is making progress, so the old cap was a flaky test
  # deadline rather than a product invariant.
  for _ in {1..600}; do
    if ! jobs -pr | grep -qx "$cancel_bootstrap_pid"; then
      cancel_timed_out=0
      break
    fi
    sleep 0.05
  done
  if [[ "$cancel_timed_out" -eq 1 ]]; then
    kill -KILL "$cancel_bootstrap_pid" 2>/dev/null || true
  fi
  cancel_rc=0
  wait "$cancel_bootstrap_pid" 2>/dev/null || cancel_rc=$?

  _assert_eq "cancellation: real bootstrap cleanup stays within its deadline" \
    "0" "$cancel_timed_out"
  _assert_exit "cancellation: real bootstrap preserves TERM status" 143 "$cancel_rc"

  cancel_external_pid=$(cat "$CANCEL_CHILD_PID" 2>/dev/null || true)
  cancel_external_live=1
  for _ in {1..40}; do
    cancel_external_state=$(ps -o stat= -p "$cancel_external_pid" 2>/dev/null || true)
    if [[ -z "$cancel_external_pid" ]] ||
      ! kill -0 "$cancel_external_pid" 2>/dev/null ||
      [[ "$cancel_external_state" =~ ^[[:space:]]*Z ]]; then
      cancel_external_live=0
      break
    fi
    sleep 0.05
  done
  if [[ -r "/proc/$$/stat" && -n "$cancel_external_pid" &&
    "$cancel_external_live" -eq 0 ]]; then
    _pass "cancellation: strong identity removes external clone process"
  elif [[ -r "/proc/$$/stat" ]]; then
    _fail "cancellation: strong identity removes external clone process"
    kill -KILL "$cancel_external_pid" 2>/dev/null || true
  elif [[ -n "$cancel_external_pid" && "$cancel_external_live" -eq 0 ]]; then
    # Bootstrap tests are noninteractive. On a weak-identity host the owned
    # worker group must therefore contain the clone and finish cleanup before
    # the outer bootstrap releases its state.
    _pass "cancellation: weak noninteractive group removes external clone process"
  elif [[ -n "$cancel_external_pid" ]]; then
    _fail "cancellation: weak noninteractive group removes external clone process"
    kill -KILL "$cancel_external_pid" 2>/dev/null || true
  else
    _fail "cancellation: weak identity records external clone process"
  fi

  cancel_scratch_after=$(find "$CANCEL_TMP" -mindepth 1 -maxdepth 1 \
    ! -name clone-ready ! -name clone.pid ! -name bootstrap.out -print -quit)
  if [[ -z "$cancel_scratch_after" ]]; then
    _pass "cancellation: real bootstrap removes private worker scratch"
  else
    _fail "cancellation: real bootstrap removes private worker scratch"
  fi
  if [[ ! -e "$FRESH_CANCEL/.dotbootstrap-done" ]]; then
    _pass "cancellation: real bootstrap does not write done marker"
  else
    _fail "cancellation: real bootstrap does not write done marker"
  fi
  # A machine-local descriptor can point at an already-present source tree;
  # bootstrap links it without cloning or otherwise managing that tree.
  FRESH_LOCAL=$(_tmpdir)
  LOCAL_BOOTSTRAP_SOURCE="$FRESH_LOCAL/local source"
  git clone --bare "$BASE_ORIGIN" "$FRESH_LOCAL/.dotfiles" >/dev/null 2>&1
  mkdir -p \
    "$FRESH_LOCAL/.config/dot/overlays.d" \
    "$LOCAL_BOOTSTRAP_SOURCE/home"
  printf '%s\n' "local bootstrap value" \
    >"$LOCAL_BOOTSTRAP_SOURCE/home/.local-bootstrap-fixture"
  cat >"$FRESH_LOCAL/.config/dot/overlays.d/15-filesystem.local.conf" <<CONF
sync=none
path=$LOCAL_BOOTSTRAP_SOURCE
CONF
  local_result=$(
    DOTBOOTSTRAP_SOURCED="" \
      HOME="$FRESH_LOCAL" \
      SHDEPS_TEST_TOOL_REPO="$TEST_TOOL_ORIGIN" \
      SHDEPS_HOOK_PACK_REPO="$HOOK_PACK_ORIGIN" \
      "$BIN_DIR/dotbootstrap" 2>&1
  )
  _assert_contains "local overlay: bootstrap applies overlays" \
    "Overlays" "$local_result"
  _assert_eq "local overlay: bootstrap preserves exact link target" \
    "$LOCAL_BOOTSTRAP_SOURCE/home/.local-bootstrap-fixture" \
    "$(readlink "$FRESH_LOCAL/.local-bootstrap-fixture" 2>/dev/null || true)"
  _assert_file_exists "local overlay: bootstrap writes done marker" \
    "$FRESH_LOCAL/.dotbootstrap-done"
  if [[ ! -e "$FRESH_LOCAL/.dotfiles-filesystem" ]]; then
    _pass "local overlay: bootstrap creates no overlay checkout"
  else
    _fail "local overlay: bootstrap creates no overlay checkout"
  fi

  # A missing active source fails before overlay links, dependency updates, or
  # merge hooks can make a half-configured install look successful.
  FRESH_LOCAL_MISSING=$(_tmpdir)
  git clone --bare "$BASE_ORIGIN" "$FRESH_LOCAL_MISSING/.dotfiles" >/dev/null 2>&1
  mkdir -p "$FRESH_LOCAL_MISSING/.config/dot/overlays.d"
  cat >"$FRESH_LOCAL_MISSING/.config/dot/overlays.d/15-filesystem.local.conf" <<CONF
sync=none
path=$FRESH_LOCAL_MISSING/missing source
CONF
  local_missing_rc=0
  local_missing_result=$(
    DOTBOOTSTRAP_SOURCED="" \
      HOME="$FRESH_LOCAL_MISSING" \
      SHDEPS_TEST_TOOL_REPO="$TEST_TOOL_ORIGIN" \
      SHDEPS_HOOK_PACK_REPO="$HOOK_PACK_ORIGIN" \
      "$BIN_DIR/dotbootstrap" 2>&1
  ) || local_missing_rc=$?
  _assert_exit "local overlay: missing source fails bootstrap" 1 "$local_missing_rc"
  _assert_contains "local overlay: missing source is diagnosed" \
    "overlay source is unavailable" "$local_missing_result"
  _assert_file_missing "local overlay: missing source writes no done marker" \
    "$FRESH_LOCAL_MISSING/.dotbootstrap-done"
  _assert_file_missing "local overlay: missing source runs no merge hooks" \
    "$FRESH_LOCAL_MISSING/.test-hooks/hook-pack"
fi

# ---- Filter skipping ----

if $_bootstrap_run_edge; then
  echo ""
  echo "=== Filter skipping ==="

  FRESH_FILTER=$(_tmpdir)
  if [[ ! -d "$FRESH_FILTER/.dotfiles" ]]; then
    git clone --bare "$BASE_ORIGIN" "$FRESH_FILTER/.dotfiles" >/dev/null 2>&1
  fi
  # Create overlay conf with wrong platform filter
  mkdir -p "$FRESH_FILTER/.config/dot/overlays.d"
  cat >"$FRESH_FILTER/.config/dot/overlays.d/10-work.conf" <<CONF
url=$WORK_ORIGIN
platforms=nonexistent-platform
CONF
  result=$(
    DOTBOOTSTRAP_SOURCED="" \
      HOME="$FRESH_FILTER" \
      SHDEPS_TEST_TOOL_REPO="$TEST_TOOL_ORIGIN" \
      SHDEPS_HOOK_PACK_REPO="$HOOK_PACK_ORIGIN" \
      "$BIN_DIR/dotbootstrap" 2>&1
  )
  if [[ ! -d "$FRESH_FILTER/.dotfiles-work" ]]; then
    _pass "filter: overlay not cloned (wrong platform)"
  else
    _fail "filter: overlay not cloned (wrong platform)"
  fi
  _assert_contains "filter: still completes" "Done" "$result"

  # ---- Existing non-worktree overlay protection ----

  echo ""
  echo "=== Existing non-worktree overlay ==="

  FRESH_BROKEN=$(_tmpdir)
  git clone --bare "$BASE_ORIGIN" "$FRESH_BROKEN/.dotfiles" >/dev/null 2>&1
  mkdir -p "$FRESH_BROKEN/.config/dot/overlays.d"
  cat >"$FRESH_BROKEN/.config/dot/overlays.d/10-work.conf" <<CONF
url=$WORK_ORIGIN
CONF
  # An existing path may contain user-owned files, so bootstrap must not
  # replace it just because it is not an overlay checkout.
  mkdir -p "$FRESH_BROKEN/.dotfiles-work"
  echo "stale" >"$FRESH_BROKEN/.dotfiles-work/junk"
  _bootstrap_status=0
  result=$(
    DOTBOOTSTRAP_SOURCED="" \
      HOME="$FRESH_BROKEN" \
      SHDEPS_TEST_TOOL_REPO="$TEST_TOOL_ORIGIN" \
      SHDEPS_HOOK_PACK_REPO="$HOOK_PACK_ORIGIN" \
      "$BIN_DIR/dotbootstrap" 2>&1
  ) || _bootstrap_status=$?
  _assert_eq "non-worktree overlay: bootstrap fails" "1" "$_bootstrap_status"
  _assert_contains "non-worktree overlay: warns" "leaving it untouched" "$result"
  if [[ -f "$FRESH_BROKEN/.dotfiles-work/junk" && ! -e "$FRESH_BROKEN/.dotfiles-work/.git" ]]; then
    _pass "non-worktree overlay: user content remains untouched"
  else
    _fail "non-worktree overlay: user content remains untouched"
  fi

  # ---- Argument handling (help + unknown args) ----

  echo ""
  echo "=== Argument handling ==="

  # --help must print usage, exit 0, and cause NO side effects (no done marker,
  # no backup dir, no "Setting up machine") — a help probe must never
  # reconfigure the machine.
  ARG_HOME=$(_tmpdir)
  help_rc=0
  help_out=$(
    DOTBOOTSTRAP_SOURCED="" HOME="$ARG_HOME" "$BIN_DIR/dotbootstrap" --help 2>&1
  ) || help_rc=$?
  _assert_exit "args: --help exits 0" 0 "$help_rc"
  _assert_contains "args: --help prints usage" "Usage:" "$help_out"
  _assert_not_contains "args: --help does not set up" "Setting up machine" "$help_out"
  if [[ ! -e "$ARG_HOME/.dotbootstrap-done" && ! -d "$ARG_HOME/.dotfiles-backup" ]]; then
    _pass "args: --help has no side effects"
  else
    _fail "args: --help has no side effects"
  fi

  # -h is an accepted alias for --help.
  hshort_rc=0
  hshort_out=$(
    DOTBOOTSTRAP_SOURCED="" HOME="$(_tmpdir)" "$BIN_DIR/dotbootstrap" -h 2>&1
  ) || hshort_rc=$?
  _assert_exit "args: -h exits 0" 0 "$hshort_rc"
  _assert_contains "args: -h prints usage" "Usage:" "$hshort_out"

  # An unknown argument must be rejected (exit 2) and must NOT reach setup.
  UNK_HOME=$(_tmpdir)
  unk_rc=0
  unk_out=$(
    DOTBOOTSTRAP_SOURCED="" HOME="$UNK_HOME" "$BIN_DIR/dotbootstrap" bogus-arg 2>&1
  ) || unk_rc=$?
  _assert_exit "args: unknown arg exits 2" 2 "$unk_rc"
  _assert_contains "args: unknown arg named" "unknown argument: bogus-arg" "$unk_out"
  _assert_not_contains "args: unknown arg does not set up" "Setting up machine" "$unk_out"
  if [[ ! -e "$UNK_HOME/.dotbootstrap-done" ]]; then
    _pass "args: unknown arg writes no done marker"
  else
    _fail "args: unknown arg writes no done marker"
  fi

  # ---- Incomplete checkout (missing core/init.sh) ----

  echo ""
  echo "=== Incomplete checkout ==="

  # Reconfigure with no bare repo -> core/init.sh is absent -> bootstrap must
  # FAIL (exit 1) and must NOT write the success marker, so a half-installed
  # machine is never mistaken for a completed one.
  INCOMPLETE_HOME=$(_tmpdir)
  incomplete_rc=0
  incomplete_out=$(
    DOTBOOTSTRAP_SOURCED="" HOME="$INCOMPLETE_HOME" "$BIN_DIR/dotbootstrap" 2>&1
  ) || incomplete_rc=$?
  _assert_exit "incomplete: missing core/init.sh exits 1" 1 "$incomplete_rc"
  _assert_contains "incomplete: reports missing core lib" "core/init.sh not found" "$incomplete_out"
  if [[ ! -e "$INCOMPLETE_HOME/.dotbootstrap-done" ]]; then
    _pass "incomplete: no done marker written"
  else
    _fail "incomplete: no done marker written"
  fi
fi

# ---- README shortcut bootstrap ----

if $_bootstrap_run_shortcut; then
  echo ""
  echo "=== README shortcut bootstrap ==="

  shortcut_url="cgraf78.github.io/d"
  shortcut_probe_err=$(_tmpfile)
  shortcut_probe_rc=0
  curl -fsSL --connect-timeout 10 --max-time 30 "$shortcut_url" -o /dev/null 2>"$shortcut_probe_err" ||
    shortcut_probe_rc=$?
  case "$shortcut_probe_rc" in
    0)
      ;;
    5 | 6 | 7 | 28 | 35 | 56)
      shortcut_probe_msg=$(tr '\n' ' ' <"$shortcut_probe_err")
      echo "SKIP: README shortcut URL unreachable from current network (curl exit $shortcut_probe_rc: $shortcut_probe_msg)"
      _test_summary
      ;;
  esac

  SHORTCUT_HOME=$(_tmpdir)
  shortcut_rc=0
  shortcut_result=$(
    HOME="$SHORTCUT_HOME" \
      DOTBOOTSTRAP_SOURCED="" \
      DOTBOOTSTRAP_DOTFILES_REPO="$BASE_ORIGIN" \
      SHDEPS_TEST_TOOL_REPO="$TEST_TOOL_ORIGIN" \
      SHDEPS_HOOK_PACK_REPO="$HOOK_PACK_ORIGIN" \
      bash -c 'curl -sL "$1" | bash' _ "$shortcut_url" 2>&1
  ) || shortcut_rc=$?

  _assert_exit "shortcut: README curl-pipe exits successfully" 0 "$shortcut_rc"
  _assert_contains "shortcut: public script clones the configured repo" \
    "==> Cloning bare repo" "$shortcut_result"
  _assert_contains "shortcut: dotbootstrap init hands off to checked-out script" \
    "==> Running dotbootstrap" "$shortcut_result"
  _assert_contains "shortcut: full bootstrap completes" "Done" "$shortcut_result"

  _assert_file_exists "shortcut: bare repo cloned" "$SHORTCUT_HOME/.dotfiles/HEAD"
  _assert_file_exists "shortcut: dotbootstrap checked out" "$SHORTCUT_HOME/.local/bin/dotbootstrap"
  _assert_file_exists "shortcut: base shell file checked out" "$SHORTCUT_HOME/.bashrc"
  _assert_file_exists "shortcut: generic tool installed" \
    "$SHORTCUT_HOME/.local/share/fixture/test-tool/bin/test-tool"
  _assert_file_exists "shortcut: generic tool linked" "$SHORTCUT_HOME/.local/bin/test-tool"
  _assert_file_content "shortcut: generic hook ran" \
    "$SHORTCUT_HOME/.local/share/fixture/hook-pack" \
    "$SHORTCUT_HOME/.test-hooks/hook-pack"
fi

_test_summary
