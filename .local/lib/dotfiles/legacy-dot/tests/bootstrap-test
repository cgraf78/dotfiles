#!/usr/bin/env bash
# bootstrap-test — unit tests for the dotbootstrap machine bootstrapper.
#
# Tests functions in isolation by sourcing with DOTBOOTSTRAP_SOURCED=1,
# and tests full bootstrap flow via subprocess with local repos.
#
# Usage:
#   dot-test bootstrap                 run all bootstrap shards
#   DOT_BOOTSTRAP_SHARD=all ./bootstrap-test
#   DOT_BOOTSTRAP_SHARD=unit ./bootstrap-test
#   DOT_BOOTSTRAP_SHARD=fresh ./bootstrap-test
#   DOT_BOOTSTRAP_SHARD=overlay ./bootstrap-test
#   DOT_BOOTSTRAP_SHARD=edge ./bootstrap-test
#   DOT_BOOTSTRAP_SHARD=shortcut ./bootstrap-test

set -o pipefail
export NO_COLOR=1

BIN_DIR="${HOME}/.local/bin"
BOOTSTRAP_TEST_PATH="$PATH"

# shellcheck source=helpers.sh
. "$HOME/.local/lib/dotfiles/legacy-dot/tests/helpers.sh"
# shellcheck source=fixtures.sh
. "$HOME/.local/lib/dotfiles/legacy-dot/tests/fixtures.sh"

_bootstrap_shard="${DOT_BOOTSTRAP_SHARD:-unit}"
_bootstrap_run_unit=false
_bootstrap_run_full=false
_bootstrap_run_fresh=false
_bootstrap_run_overlay=false
_bootstrap_run_edge=false
_bootstrap_run_shortcut=false
case "$_bootstrap_shard" in
  all)
    _bootstrap_run_unit=true
    _bootstrap_run_full=true
    _bootstrap_run_fresh=true
    _bootstrap_run_overlay=true
    _bootstrap_run_edge=true
    _bootstrap_run_shortcut=true
    ;;
  unit)
    _bootstrap_run_unit=true
    ;;
  fresh)
    _bootstrap_run_full=true
    _bootstrap_run_fresh=true
    ;;
  overlay)
    _bootstrap_run_full=true
    _bootstrap_run_overlay=true
    ;;
  edge)
    _bootstrap_run_full=true
    _bootstrap_run_edge=true
    ;;
  shortcut)
    _bootstrap_run_full=true
    _bootstrap_run_shortcut=true
    ;;
  *)
    echo "unknown DOT_BOOTSTRAP_SHARD: $_bootstrap_shard" >&2
    exit 2
    ;;
esac

# ---------------------------------------------------------------------------
# Setup: mock HOME with bare repo structure
# ---------------------------------------------------------------------------

dot_fixture_home
DEPENDENCY_HOME="${DOT_TEST_HOST_HOME:-$REAL_HOME}"

_test_prepare_shdeps_snapshot "$REAL_HOME" "$DEPENDENCY_HOME" || exit 1

dot_fixture_base_repo
dot_fixture_seed_bootstrap_files

# Source shared helpers and dotbootstrap functions (without running main logic)
# shellcheck source=../core/init.sh
. "$REAL_HOME/.local/lib/dotfiles/legacy-dot/core/init.sh"
_ensure_shdeps
BACKUP="$TEST_HOME/.dotfiles-backup/test"
BRANCH=""
export DOTBOOTSTRAP_SOURCED=1
# shellcheck source=../../../bin/dotbootstrap
. "$BIN_DIR/dotbootstrap"

# ---------------------------------------------------------------------------
# Tests: _detect_branch
# ---------------------------------------------------------------------------

if $_bootstrap_run_unit; then
  echo "=== Branch detection ==="

  # Priority 1: DOTFILES_BRANCH env var — export so shellcheck sees
  # it as an external-consumer var rather than flagging SC2034.
  BRANCH=""
  export DOTFILES_BRANCH="custom-branch"
  _detect_branch
  _assert_eq "env var override" "custom-branch" "$BRANCH"
  unset DOTFILES_BRANCH

  # Priority 2: current local branch in bare repo
  BRANCH=""
  _detect_branch
  DEFAULT_BRANCH=$($GIT branch --show-current 2>/dev/null || echo "master")
  _assert_eq "current local branch" "$DEFAULT_BRANCH" "$BRANCH"

  # Priority 3: origin/HEAD fallback
  ORIGIN_BARE=$(_tmpdir)
  git clone --bare "$DOTFILES" "$ORIGIN_BARE" >/dev/null 2>&1
  $GIT remote add origin "$ORIGIN_BARE" 2>/dev/null || $GIT remote set-url origin "$ORIGIN_BARE"
  $GIT fetch origin >/dev/null 2>&1
  $GIT remote set-head origin "$DEFAULT_BRANCH" 2>/dev/null || true

  # Detach HEAD so current branch is empty, forcing origin/HEAD fallback
  $GIT checkout --detach HEAD 2>/dev/null || true
  BRANCH=""
  _detect_branch
  _assert_eq "origin/HEAD fallback" "$DEFAULT_BRANCH" "$BRANCH"

  # Priority 4: fallback to "main" when nothing else works
  $GIT remote remove origin 2>/dev/null || true
  BRANCH=""
  _detect_branch
  _assert_eq "fallback to main" "main" "$BRANCH"

  # Re-attach to branch for remaining tests
  $GIT checkout "$DEFAULT_BRANCH" 2>/dev/null || $GIT checkout -b main 2>/dev/null

  # ---------------------------------------------------------------------------
  # Tests: _require_bootstrap_tools — prerequisite preflight
  # ---------------------------------------------------------------------------

  echo ""
  echo "=== Prerequisite preflight ==="

  # An empty PATH makes `command -v git/curl` fail (the builtins still run), so
  # the preflight should report both as missing and exit non-zero. Capture the
  # rc via `|| rc=$?` so the intentional failure doesn't trip the suite's set -e.
  _preflight_rc=0
  _preflight_out=$(PATH=/var/empty _require_bootstrap_tools 2>&1) || _preflight_rc=$?
  _assert_exit "preflight: missing tools exit non-zero" 1 "$_preflight_rc"
  _assert_contains "preflight: reports missing git" "- git" "$_preflight_out"
  _assert_contains "preflight: reports missing curl" "- curl" "$_preflight_out"
  _assert_contains "preflight: gives an actionable install hint" "apt-get install" "$_preflight_out"

  # With git and curl on PATH (the test runner has both) and Bash 4+, it passes
  # silently and returns 0.
  _preflight_pass_rc=0
  _preflight_pass_out=$(_require_bootstrap_tools 2>&1) || _preflight_pass_rc=$?
  _assert_exit "preflight: tools present returns 0" 0 "$_preflight_pass_rc"
  _assert_eq "preflight: tools present is silent" "" "$_preflight_pass_out"

  # Only one tool missing → only that tool is reported.
  _curl_only_dir=$(_tmpdir)
  ln -s "$(command -v curl)" "$_curl_only_dir/curl"
  _preflight_git_out=$(PATH="$_curl_only_dir" _require_bootstrap_tools 2>&1) || true
  _assert_contains "preflight: reports the missing git" "- git" "$_preflight_git_out"
  _assert_not_contains "preflight: does not flag present curl" "- curl" "$_preflight_git_out"

  # A worker-level overlay failure must take the same explicit incomplete path
  # as a required overlay failure. In particular, `set -e` must not bypass the
  # diagnostic or let bootstrap continue into finalization.
  _overlay_sync_rc=0
  _overlay_sync_out=$(
    # shellcheck disable=SC2329  # Invoked indirectly by the helper under test.
    _ensure_shdeps() { :; }
    # shellcheck disable=SC2329  # Invoked indirectly by the helper under test.
    _merge_overlay_ssh_configs() { :; }
    # shellcheck disable=SC2329  # Invoked indirectly by the helper under test.
    _discover_overlays() { :; }
    # shellcheck disable=SC2329  # Invoked indirectly by the helper under test.
    _preflight_local_overlays() { :; }
    # shellcheck disable=SC2329  # Invoked indirectly by the helper under test.
    _pull_overlays() { return 17; }
    _bootstrap_sync_overlays 2>&1
  ) || _overlay_sync_rc=$?
  _assert_exit "overlay sync: worker failure returns non-zero" 1 "$_overlay_sync_rc"
  _assert_contains "overlay sync: worker failure explains incomplete bootstrap" \
    "required overlay sync failed" "$_overlay_sync_out"

  # The real bootstrap calls this as a bare command under errexit so failures
  # inside the coordinator stay fatal. In that production context Bash exits
  # with the original worker status rather than the normalized conditional-call
  # status asserted above.
  _overlay_production_output=$(_tmpdir)/overlay-production.output
  _overlay_production_rc=0
  _overlay_production_had_errexit=0
  [[ "$-" == *e* ]] && _overlay_production_had_errexit=1
  set +e
  (
    set -e
    # shellcheck disable=SC2329  # Invoked indirectly by the helper under test.
    _ensure_shdeps() { :; }
    # shellcheck disable=SC2329  # Invoked indirectly by the helper under test.
    _merge_overlay_ssh_configs() { :; }
    # shellcheck disable=SC2329  # Invoked indirectly by the helper under test.
    _discover_overlays() { :; }
    # shellcheck disable=SC2329  # Invoked indirectly by the helper under test.
    _preflight_local_overlays() { :; }
    # shellcheck disable=SC2329  # Invoked indirectly by the helper under test.
    _pull_overlays() { return 17; }
    _bootstrap_sync_overlays
  ) >"$_overlay_production_output" 2>&1
  _overlay_production_rc=$?
  [[ "$_overlay_production_had_errexit" -eq 0 ]] || set -e
  _assert_exit "overlay sync: production errexit preserves worker status" \
    17 "$_overlay_production_rc"
  _assert_contains "overlay sync: production failure explains incomplete bootstrap" \
    "required overlay sync failed" "$(cat "$_overlay_production_output")"

  # Do not place the coordinator on the left side of `||`: Bash disables
  # errexit throughout a function invoked from that context, which can turn an
  # unexpected worker-internal failure into a false success.
  _overlay_internal_marker=$(_tmpdir)/continued
  _overlay_internal_output=$(_tmpdir)/output
  _overlay_internal_rc=0
  _overlay_internal_had_errexit=0
  [[ "$-" == *e* ]] && _overlay_internal_had_errexit=1
  set +e
  (
    set -e
    # shellcheck disable=SC2329  # Invoked indirectly by the helper under test.
    _ensure_shdeps() { :; }
    # shellcheck disable=SC2329  # Invoked indirectly by the helper under test.
    _merge_overlay_ssh_configs() { :; }
    # shellcheck disable=SC2329  # Invoked indirectly by the helper under test.
    _discover_overlays() { :; }
    # shellcheck disable=SC2329  # Invoked indirectly by the helper under test.
    _preflight_local_overlays() { :; }
    # shellcheck disable=SC2329  # Invoked indirectly by the helper under test.
    _pull_overlays() {
      false
      : >"$_overlay_internal_marker"
    }
    _bootstrap_sync_overlays 2>&1
  ) >"$_overlay_internal_output" 2>&1
  _overlay_internal_rc=$?
  [[ "$_overlay_internal_had_errexit" -eq 0 ]] || set -e
  _overlay_internal_out=$(cat "$_overlay_internal_output")
  if [[ "$_overlay_internal_rc" -ne 0 ]]; then
    _pass "overlay sync: unexpected internal failure retains errexit"
  else
    _fail "overlay sync: unexpected internal failure retains errexit"
  fi
  if [[ ! -e "$_overlay_internal_marker" ]]; then
    _pass "overlay sync: unexpected internal failure stops coordinator work"
  else
    _fail "overlay sync: unexpected internal failure stops coordinator work"
  fi
  _assert_contains "overlay sync: unexpected failure explains incomplete bootstrap" \
    "required overlay sync failed" "$_overlay_internal_out"

  # ---------------------------------------------------------------------------
  # Tests: merge-wezterm
  # ---------------------------------------------------------------------------

  echo ""
  echo "=== WezTerm merge ==="

  # Source the real merge-wezterm script from the repo under test.
  # shellcheck disable=SC1091  # sourced via repo-relative test path
  . "$REAL_HOME/.local/lib/dotfiles/legacy-dot/core/merge-hooks/wezterm.sh"

  WEZ_HOME=$(_tmpdir)
  WEZ_WIN_HOME=$(_tmpdir)
  if [[ "$(uname -s)" == "Linux" ]]; then
    mkdir -p "$WEZ_HOME/.config/wezterm"
    echo "return { test = true }" >"$WEZ_HOME/.config/wezterm/wezterm.lua"
    echo "return { module = true }" >"$WEZ_HOME/.config/wezterm/link-routes.lua"
    echo "return { resolver = true }" >"$WEZ_HOME/.config/wezterm/termnav-module.lua"
    echo "return { public = true }" >"$WEZ_HOME/.config/wezterm/public-link-rules.lua"
    mkdir -p "$WEZ_HOME/.config/wezterm/hyperlink-rules.d"
    echo "return { work_links = true }" >"$WEZ_HOME/.config/wezterm/hyperlink-rules.d/80-work.lua"
    mkdir -p "$WEZ_HOME/bin" "$WEZ_HOME/termnav-src"
    : >"$WEZ_HOME/bin/wezterm.exe"
    chmod +x "$WEZ_HOME/bin/wezterm.exe"
    echo "return { termnav = true }" >"$WEZ_HOME/termnav-src/link-routes.lua"
    echo "return { termnav_public = true }" >"$WEZ_HOME/termnav-src/public-link-rules.lua"
    cat >"$WEZ_HOME/bin/shdeps" <<EOF
#!/usr/bin/env bash
if [[ "\$*" == "dep-file cgraf78/termnav lib/termnav/wezterm/link-routes.lua" ]]; then
  printf '%s\n' "$WEZ_HOME/termnav-src/link-routes.lua"
  exit 0
fi
if [[ "\$*" == "dep-file cgraf78/termnav lib/termnav/wezterm/public-link-rules.lua" ]]; then
  printf '%s\n' "$WEZ_HOME/termnav-src/public-link-rules.lua"
  exit 0
fi
exit 1
EOF
    chmod +x "$WEZ_HOME/bin/shdeps"
    HOME="$WEZ_HOME" WSL_DISTRO_NAME="archlinux" USER="chris" \
      DOT_TEST_WINDOWS_HOME="$WEZ_WIN_HOME" DOT_TEST_WSL_PAIRED_ACCOUNT=1 \
      PATH="$WEZ_HOME/bin:$PATH" merge

    _assert_file_exists "merge wezterm: created Windows-home file under WSL" "$WEZ_WIN_HOME/.wezterm.lua"
    _assert_file_content "merge wezterm: copied file content" "return { test = true }" "$WEZ_WIN_HOME/.wezterm.lua"
    _assert_file_exists "merge wezterm: copied companion lua module under WSL" "$WEZ_WIN_HOME/link-routes.lua"
    _assert_file_content "merge wezterm: copied companion module content" \
      "return { module = true }" "$WEZ_WIN_HOME/link-routes.lua"
    _assert_file_exists "merge wezterm: copied termnav resolver under WSL" \
      "$WEZ_WIN_HOME/termnav-module.lua"
    _assert_file_content "merge wezterm: copied termnav resolver content" \
      "return { resolver = true }" "$WEZ_WIN_HOME/termnav-module.lua"
    _assert_file_exists "merge wezterm: copied public link wrapper under WSL" \
      "$WEZ_WIN_HOME/public-link-rules.lua"
    _assert_file_content "merge wezterm: copied public link wrapper content" \
      "return { public = true }" "$WEZ_WIN_HOME/public-link-rules.lua"
    _assert_file_exists "merge wezterm: copied hyperlink rule extension under WSL" \
      "$WEZ_WIN_HOME/hyperlink-rules.d/80-work.lua"
    _assert_file_content "merge wezterm: copied hyperlink rule extension content" \
      "return { work_links = true }" "$WEZ_WIN_HOME/hyperlink-rules.d/80-work.lua"
    _assert_file_exists "merge wezterm: copied shdeps-resolved termnav module under WSL" \
      "$WEZ_WIN_HOME/termnav-link-routes.lua"
    _assert_file_content "merge wezterm: copied termnav route module content" \
      "return { termnav = true }" "$WEZ_WIN_HOME/termnav-link-routes.lua"
    _assert_file_exists "merge wezterm: copied shdeps-resolved public link module under WSL" \
      "$WEZ_WIN_HOME/termnav-public-link-rules.lua"
    _assert_file_content "merge wezterm: copied termnav public link module content" \
      "return { termnav_public = true }" "$WEZ_WIN_HOME/termnav-public-link-rules.lua"
    rm -f "$WEZ_HOME/.config/wezterm/hyperlink-rules.d/80-work.lua"
    HOME="$WEZ_HOME" WSL_DISTRO_NAME="archlinux" USER="chris" \
      DOT_TEST_WINDOWS_HOME="$WEZ_WIN_HOME" DOT_TEST_WSL_PAIRED_ACCOUNT=1 \
      PATH="$WEZ_HOME/bin:$PATH" merge
    _assert_file_missing "merge wezterm: removes stale managed hyperlink rule extension" \
      "$WEZ_WIN_HOME/hyperlink-rules.d/80-work.lua"

    # Regression: a second Linux account on the same WSL distro (e.g. root)
    # resolves the identical native Windows home. An unpaired account must
    # not touch it at all, or two accounts' `dot update` cron jobs race on
    # the same native .wezterm.lua with no locking between them. Pre-seed
    # the file (rather than deleting it) so this also catches a regression
    # that modifies it in place instead of only ones that recreate it.
    printf 'return { pre_existing = true }' >"$WEZ_WIN_HOME/.wezterm.lua"
    echo "return { work_links = true }" >"$WEZ_HOME/.config/wezterm/hyperlink-rules.d/80-work.lua"
    HOME="$WEZ_HOME" WSL_DISTRO_NAME="archlinux" USER="chris" \
      DOT_TEST_WINDOWS_HOME="$WEZ_WIN_HOME" DOT_TEST_WSL_PAIRED_ACCOUNT=0 \
      PATH="$WEZ_HOME/bin:$PATH" merge
    _assert_file_content "merge wezterm: unpaired account leaves native Windows home untouched" \
      "return { pre_existing = true }" "$WEZ_WIN_HOME/.wezterm.lua"

    # Test mode must not fall through to the real Windows home. On WSL, /mnt/c
    # remains live even while HOME points at a temp tree.
    rm -f \
      "$WEZ_WIN_HOME/.wezterm.lua" \
      "$WEZ_WIN_HOME/link-routes.lua" \
      "$WEZ_WIN_HOME/public-link-rules.lua" \
      "$WEZ_WIN_HOME/termnav-link-routes.lua" \
      "$WEZ_WIN_HOME/termnav-public-link-rules.lua" \
      "$WEZ_WIN_HOME/termnav-module.lua" \
      "$WEZ_WIN_HOME/hyperlink-rules.d/80-work.lua"
    echo "return { work_links = true }" >"$WEZ_HOME/.config/wezterm/hyperlink-rules.d/80-work.lua"
    HOME="$WEZ_HOME" WSL_DISTRO_NAME="archlinux" USER="chris" DOT_TEST=1 PATH="$WEZ_HOME/bin:$PATH" \
      DOT_TEST_WINDOWS_HOME='' merge
    _assert_file_missing "merge wezterm: test mode requires fake Windows home" "$WEZ_WIN_HOME/.wezterm.lua"
    _assert_file_missing "merge wezterm: test mode skips companion modules without fake Windows home" \
      "$WEZ_WIN_HOME/link-routes.lua"
    _assert_file_missing "merge wezterm: test mode skips termnav module without fake Windows home" \
      "$WEZ_WIN_HOME/termnav-link-routes.lua"
    _assert_file_missing "merge wezterm: test mode skips public link module without fake Windows home" \
      "$WEZ_WIN_HOME/termnav-public-link-rules.lua"
    _assert_file_missing "merge wezterm: test mode skips hyperlink rule extensions without fake Windows home" \
      "$WEZ_WIN_HOME/hyperlink-rules.d/80-work.lua"

    # WSL and Windows usernames can differ. Match the VS Code resolver policy by
    # trusting Windows USERPROFILE and never guessing /mnt/c/Users/$USER.
    WEZ_PROFILE_HOME="$WEZ_HOME/windows/Users/Actual Profile"
    WEZ_PROFILE_WIN='C:\Users\Actual Profile'
    WEZ_PROFILE_BIN=$(_tmpdir)
    mkdir -p "$WEZ_PROFILE_HOME" "$WEZ_PROFILE_BIN"
    cat >"$WEZ_PROFILE_BIN/cmd.exe" <<EOF
#!/usr/bin/env bash
if [[ "\$*" == "/D /C set USERPROFILE" ]]; then
  printf '%s\r\n' 'UNC paths are not supported. Defaulting to Windows directory.'
  printf '%s\r\n' 'USERPROFILE=$WEZ_PROFILE_WIN'
  exit 0
fi
exit 1
EOF
    cat >"$WEZ_PROFILE_BIN/wslpath" <<EOF
#!/usr/bin/env bash
case "\$*" in
  "$WEZ_PROFILE_WIN") printf '%s\n' "$WEZ_PROFILE_HOME" ;;
  *) exit 1 ;;
esac
EOF
    chmod +x "$WEZ_PROFILE_BIN/cmd.exe" "$WEZ_PROFILE_BIN/wslpath"
    rm -f "$WEZ_PROFILE_HOME/.wezterm.lua"
    HOME="$WEZ_HOME" WSL_DISTRO_NAME="archlinux" USER="wronglinux" DOT_TEST=0 \
      DOT_TEST_WINDOWS_HOME='' DOT_WINDOWS_HOME='' DOT_TEST_WINDOWS_CMD_EXE="$WEZ_PROFILE_BIN/cmd.exe" \
      DOT_TEST_WSL_PAIRED_ACCOUNT=1 PATH="$WEZ_PROFILE_BIN:$WEZ_HOME/bin:$PATH" merge
    _assert_file_exists "merge wezterm: WSL uses Windows USERPROFILE over Linux USER" \
      "$WEZ_PROFILE_HOME/.wezterm.lua"
    _assert_file_content "merge wezterm: Windows-profile copy content is preserved" \
      "return { test = true }" "$WEZ_PROFILE_HOME/.wezterm.lua"

    # Non-WSL Linux should be a no-op.
    HOME="$WEZ_HOME" WSL_DISTRO_NAME='' WSL_INTEROP='' USER="chris" merge
    _assert_file_missing "merge wezterm: no-op on non-WSL Linux" "$WEZ_WIN_HOME/.wezterm.lua"
    _assert_file_missing "merge wezterm: no companion module copy on non-WSL Linux" "$WEZ_WIN_HOME/link-routes.lua"
    _assert_file_missing "merge wezterm: no public link module copy on non-WSL Linux" \
      "$WEZ_WIN_HOME/termnav-public-link-rules.lua"
    _assert_file_missing "merge wezterm: no hyperlink rule extension copy on non-WSL Linux" \
      "$WEZ_WIN_HOME/hyperlink-rules.d/80-work.lua"
  else
    echo "  SKIP: merge wezterm WSL-specific assertions (non-Linux runner)"
  fi

  echo ""
  echo "=== Windows host guards ==="

  # Source the real VS Code merge script after the WezTerm tests. It defines its
  # own merge() function, but these assertions only need the variant resolver.
  # shellcheck disable=SC1091  # sourced via repo-relative test path
  . "$REAL_HOME/.local/lib/dotfiles/legacy-dot/core/merge-hooks/vscode.sh"

  _prepare_vscode_merge_config() {
    local home="$1"
    mkdir -p "$home/.config/dot/merge-hooks.d"
    cp -R "$REAL_HOME/.config/dot/merge-hooks.d/vscode" \
      "$home/.config/dot/merge-hooks.d/vscode"
  }

  if [[ "$(uname -s)" == "Linux" ]]; then
    VSCODE_HOME=$(_tmpdir)
    VSCODE_PROFILE=$(_tmpdir)/Users/Chris
    VSCODE_APPDATA="$VSCODE_PROFILE/AppData/Roaming"
    mkdir -p "$VSCODE_APPDATA/Code/User"
    _prepare_vscode_merge_config "$VSCODE_HOME"

    result=$(HOME="$VSCODE_HOME" WSL_DISTRO_NAME="archlinux" DOT_TEST=1 \
      DOT_TEST_WINDOWS_APPDATA="$VSCODE_APPDATA" DOT_TEST_WSL_PAIRED_ACCOUNT=1 _vscode_variants)
    _assert_contains "merge vscode: test mode can use fake Windows APPDATA" \
      "$VSCODE_APPDATA/Code/User" "$result"
    _assert_contains "merge vscode: WSL fake APPDATA uses server extension dir" \
      "$VSCODE_HOME/.vscode-server/extensions" "$result"
    _assert_not_contains "merge vscode: WSL fake APPDATA does not target Windows extensions dir" \
      "$VSCODE_PROFILE/.vscode/extensions" "$result"

    # Regression: a second Linux account on the same WSL distro (e.g. root)
    # resolves the identical native Windows APPDATA path. Without this guard
    # both accounts' `dot update` cron jobs would merge into the same native
    # settings.json/keybindings.json with no locking between them.
    result_unpaired=$(HOME="$VSCODE_HOME" WSL_DISTRO_NAME="archlinux" DOT_TEST=1 \
      DOT_TEST_WINDOWS_APPDATA="$VSCODE_APPDATA" DOT_TEST_WSL_PAIRED_ACCOUNT=0 _vscode_variants)
    _assert_not_contains "merge vscode: unpaired account skips Windows APPDATA variant" \
      "$VSCODE_APPDATA/Code/User" "$result_unpaired"

    VSCODE_BIN=$(_tmpdir)
    VSCODE_PROBE_OUT=$(_tmpdir)/appdata.out
    mkdir -p "$VSCODE_BIN"
    cat >"$VSCODE_BIN/cmd.exe" <<'EOF'
#!/usr/bin/env bash
IFS= read -r _maybe_stdin || true
printf '%s\r\n' 'C:\Users\Chris\AppData\Roaming'
EOF
    cat >"$VSCODE_BIN/wslpath" <<EOF
#!/usr/bin/env bash
printf '%s\n' "$VSCODE_APPDATA"
EOF
    chmod +x "$VSCODE_BIN/cmd.exe" "$VSCODE_BIN/wslpath"
    stdin_after=$(REAL_HOME="$REAL_HOME" DOT_TEST=0 DOT_TEST_WSL_PAIRED_ACCOUNT=1 \
      PATH="$VSCODE_BIN:$PATH" \
      VSCODE_PROBE_OUT="$VSCODE_PROBE_OUT" bash -c '
        set -euo pipefail
        # shellcheck source=/dev/null
        . "$REAL_HOME/.local/lib/dotfiles/legacy-dot/core/merge-hooks/vscode.sh"
        _vscode_wsl_appdata_dirs >"$VSCODE_PROBE_OUT"
        IFS= read -r line || line=""
        printf "%s" "$line"
      ' <<<"after-probe")
    _assert_eq "merge vscode: Windows APPDATA probe preserves stdin" \
      "after-probe" "$stdin_after"
    _assert_file_content "merge vscode: Windows APPDATA probe still resolves profile" \
      "$VSCODE_APPDATA" "$VSCODE_PROBE_OUT"

    result=$(HOME="$VSCODE_HOME" WSL_DISTRO_NAME="archlinux" DOT_TEST=1 \
      DOT_TEST_WINDOWS_APPDATA='' _vscode_variants)
    _assert_eq "merge vscode: test mode does not resolve real Windows APPDATA" "" "$result"

    VSCODE_LINUX_HOME=$(_tmpdir)
    mkdir -p "$VSCODE_LINUX_HOME/.config/Code/User"
    _prepare_vscode_merge_config "$VSCODE_LINUX_HOME"
    linux_result=$(HOME="$VSCODE_LINUX_HOME" REAL_HOME="$REAL_HOME" bash -c '
      set -euo pipefail
      _is_wsl() { return 1; }
      uname() { printf "Linux\n"; }
      # shellcheck source=/dev/null
      . "$REAL_HOME/.local/lib/dotfiles/legacy-dot/core/merge-hooks/vscode.sh"
      _vscode_variants
    ')
    _assert_contains "merge vscode: non-WSL Linux uses local extension dir" \
      "$VSCODE_LINUX_HOME/.vscode/extensions" "$linux_result"
    _assert_contains "merge vscode: non-WSL Linux uses local settings dir" \
      "$VSCODE_LINUX_HOME/.config/Code/User" "$linux_result"
    _assert_not_contains "merge vscode: non-WSL Linux does not use WSL server dir" \
      "$VSCODE_LINUX_HOME/.vscode-server/extensions" "$linux_result"
  else
    echo "  SKIP: Windows host guards (non-Linux runner)"
  fi

  VSCODE_MAC_HOME=$(_tmpdir)
  VSCODE_APPS=$(_tmpdir)/Applications
  mkdir -p \
    "$VSCODE_APPS/Visual Studio Code.app" \
    "$VSCODE_MAC_HOME/Library/Application Support/Code/User"
  _prepare_vscode_merge_config "$VSCODE_MAC_HOME"
  mac_result=$(HOME="$VSCODE_MAC_HOME" REAL_HOME="$REAL_HOME" \
    DOT_TEST_VSCODE_APPLICATIONS_DIR="$VSCODE_APPS" bash -c '
      set -euo pipefail
      _is_wsl() { return 1; }
      uname() { printf "Darwin\n"; }
      # shellcheck source=/dev/null
      . "$REAL_HOME/.local/lib/dotfiles/legacy-dot/core/merge-hooks/vscode.sh"
      _vscode_variants
    ')
  _assert_contains "merge vscode: macOS uses local extension dir" \
    "$VSCODE_MAC_HOME/.vscode/extensions" "$mac_result"
  _assert_contains "merge vscode: macOS uses Code settings dir" \
    "$VSCODE_MAC_HOME/Library/Application Support/Code/User" "$mac_result"
  _assert_not_contains "merge vscode: macOS does not include missing Insiders app" \
    "$VSCODE_MAC_HOME/.vscode-insiders/extensions" "$mac_result"

  # ---------------------------------------------------------------------------
  # Tests: hook file syntax (dotfiles-specific — shdeps tests cover hook logic)
  # ---------------------------------------------------------------------------

  echo ""
  echo "=== Hook syntax (bash -n) ==="
  # Verify all real dotfiles hook files pass syntax check.
  syntax_ok=1
  while IFS= read -r -d '' f; do
    if ! bash -n "$f" 2>/dev/null; then
      _fail "syntax: $(basename "$f")"
      syntax_ok=0
    fi
  done < <(
    find \
      "$REAL_HOME/.config/dot/merge-hooks.d" \
      "$REAL_HOME/.config/shdeps/hooks.d" \
      -type f -name '*.sh' -print0 2>/dev/null |
      LC_ALL=C sort -z
  )
  if [[ "$syntax_ok" -eq 1 ]]; then
    _pass "syntax: all hook files pass bash -n"
  fi
  # ---------------------------------------------------------------------------
  # Tests: _backup_and_checkout
  # ---------------------------------------------------------------------------

  echo ""
  echo "=== Backup and checkout ==="

  # Re-add origin so checkout can work
  ORIGIN_BARE2=$(_tmpdir)
  git clone --bare "$DOTFILES" "$ORIGIN_BARE2" >/dev/null 2>&1
  $GIT remote add origin "$ORIGIN_BARE2" 2>/dev/null || $GIT remote set-url origin "$ORIGIN_BARE2"
  $GIT fetch origin >/dev/null 2>&1
  BRANCH=$($GIT branch --show-current 2>/dev/null || echo "main")

  # Create a conflicting file (same path as a repo-tracked file)
  echo "local content" >"$TEST_HOME/.testrc"

  BACKUP="$TEST_HOME/.dotfiles-backup/test1"
  result=$(_backup_and_checkout 2>&1)

  _assert_contains "shows backup message" "backed up" "$result"
  _assert_contains "shows checkout message" "checking out" "$result"

  # Conflicting file was backed up
  if [[ -f "$BACKUP/.testrc" ]]; then
    _pass "conflicting file backed up"
    _assert_file_content "backup has original content" "local content" "$BACKUP/.testrc"
  else
    _fail "conflicting file backed up"
  fi

  # Checked-out file restored from repo
  _assert_file_exists "repo file restored" "$TEST_HOME/.testrc"
  _assert_file_content "restored file has repo content" "initial" "$TEST_HOME/.testrc"

  # Untracked file is NOT backed up or removed
  echo "untracked" >"$TEST_HOME/untracked_file"
  BACKUP="$TEST_HOME/.dotfiles-backup/test2"
  _backup_and_checkout >/dev/null 2>&1
  _assert_file_missing "untracked file not backed up" "$BACKUP/untracked_file"
  _assert_file_content "untracked file untouched" "untracked" "$TEST_HOME/untracked_file"
  rm -f "$TEST_HOME/untracked_file"

  # Empty backup dir is removed (no conflicts)
  rm -f "$TEST_HOME/.testrc" "$TEST_HOME/.config/dot/placeholder"
  BACKUP="$TEST_HOME/.dotfiles-backup/test3"
  _backup_and_checkout >/dev/null 2>&1
  if [[ ! -d "$BACKUP" ]]; then
    _pass "empty backup dir removed"
  else
    _fail "empty backup dir removed"
  fi

  # A rebootstrap can begin with the tracked dotfiles git launcher first on
  # PATH. Bash caches that path during the pre-checkout commands, but the
  # backup loop then moves the launcher away. Checkout must fall through to
  # the system git rather than reusing the vanished cached path.
  _hashed_home=$(_tmpdir)
  _hashed_staging=$(_tmpdir)
  _hashed_origin=$(_tmpdir)
  _hashed_real_git=$(PATH=/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin command -v git)
  mkdir -p "$_hashed_staging/.local/bin"
  cat >"$_hashed_staging/.local/bin/git" <<EOF
#!/usr/bin/env bash
exec "$_hashed_real_git" "\$@"
EOF
  chmod +x "$_hashed_staging/.local/bin/git"
  printf '%s\n' 'repo content' >"$_hashed_staging/.testrc"
  dot_fixture_seed_repo "$_hashed_origin" "$_hashed_staging"
  mkdir -p "$_hashed_home/.local/bin"
  git clone --bare "$_hashed_origin" "$_hashed_home/.dotfiles" >/dev/null 2>&1
  cp "$_hashed_staging/.local/bin/git" "$_hashed_home/.local/bin/git"
  printf '%s\n' 'local content' >"$_hashed_home/.testrc"
  _hashed_branch=$(git -C "$_hashed_staging" branch --show-current)
  _hashed_result=$(
    HOME="$_hashed_home"
    DOTFILES="$_hashed_home/.dotfiles"
    BACKUP="$_hashed_home/.dotfiles-backup/hashed-git"
    BRANCH="$_hashed_branch"
    GIT="git --git-dir=$DOTFILES --work-tree=$HOME"
    PATH="$_hashed_home/.local/bin:$BOOTSTRAP_TEST_PATH"
    hash -r
    git --version >/dev/null
    rc=0
    _backup_and_checkout 2>&1 || rc=$?
    printf 'rc=%s\n' "$rc"
    printf 'content=%s\n' "$(cat "$_hashed_home/.testrc" 2>/dev/null || true)"
    if [[ -x "$_hashed_home/.local/bin/git" ]]; then
      printf '%s\n' 'launcher=restored'
    fi
    true
  )
  _assert_contains "checkout: moved hashed git launcher still succeeds" \
    "rc=0" "$_hashed_result"
  _assert_contains "checkout: tracked content is restored after moving hashed git" \
    "content=repo content" "$_hashed_result"
  _assert_contains "checkout: tracked git launcher is restored" \
    "launcher=restored" "$_hashed_result"
  _assert_not_contains "checkout: does not execute the vanished cached launcher" \
    "No such file or directory" "$_hashed_result"

  # Filtering routine checkout chatter must not replace git's status. A real
  # checkout failure has to stop bootstrap with its original exit code.
  _checkout_fail_home=$(_tmpdir)
  _checkout_fail_bin=$(_tmpdir)
  mkdir -p "$_checkout_fail_bin"
  printf '%s\n' 'local content' >"$_checkout_fail_home/.testrc"
  cat >"$_checkout_fail_bin/git" <<'SH'
#!/usr/bin/env bash
case " $* " in
  *" ls-tree "*) printf '%s\n' '.testrc' ;;
  *" checkout "*)
    printf '%s\n' 'Already on main'
    printf '%s\n' 'forced checkout failure' >&2
    exit 23
    ;;
esac
SH
  chmod +x "$_checkout_fail_bin/git"
  _checkout_fail_result=$(
    HOME="$_checkout_fail_home"
    DOTFILES="$_checkout_fail_home/.dotfiles"
    BACKUP="$_checkout_fail_home/.dotfiles-backup/checkout-failure"
    BRANCH="main"
    GIT="$_checkout_fail_bin/git --git-dir=$DOTFILES --work-tree=$HOME"
    rc=0
    _backup_and_checkout 2>&1 || rc=$?
    printf 'rc=%s\n' "$rc"
    printf 'backup=%s\n' "$(cat "$BACKUP/.testrc" 2>/dev/null || true)"
  )
  _assert_contains "checkout: propagates git's failure status" \
    "rc=23" "$_checkout_fail_result"
  _assert_contains "checkout: reports an actionable checkout failure" \
    "error: git checkout of main failed (exit 23)" "$_checkout_fail_result"
  _assert_contains "checkout: preserves substantive git failure output" \
    "forced checkout failure" "$_checkout_fail_result"
  _assert_not_contains "checkout: filters routine git chatter" \
    "Already on main" "$_checkout_fail_result"
  _assert_contains "checkout: failed checkout keeps original backup" \
    "backup=local content" "$_checkout_fail_result"
fi

# ---------------------------------------------------------------------------
# Tests: Full bootstrap flow (subprocess with local repos)
# ---------------------------------------------------------------------------

if $_bootstrap_run_full; then
  # Build local repos that stand in for remote origins.

  # --- Base dotfiles origin ---
  BASE_STAGING=$(_tmpdir)
  mkdir -p "$BASE_STAGING/.local/bin" "$BASE_STAGING/.local/lib/dotfiles/legacy-dot/core"
  echo "bashrc content" >"$BASE_STAGING/.bashrc"

  cp "$REAL_HOME/.local/bin/dotbootstrap" "$BASE_STAGING/.local/bin/dotbootstrap"
  cp "$REAL_HOME/.local/lib/dotfiles/legacy-dot/core/"*.sh "$BASE_STAGING/.local/lib/dotfiles/legacy-dot/core/"
  cp -R "$REAL_HOME/.local/lib/dotfiles/legacy-dot/core/doctor" "$BASE_STAGING/.local/lib/dotfiles/legacy-dot/core/"
  cp -R "$REAL_HOME/.local/lib/dotfiles/legacy-dot/core/repos" "$BASE_STAGING/.local/lib/dotfiles/legacy-dot/core/"
  dot_fixture_write_shdeps_config "$BASE_STAGING"

  mkdir -p "$BASE_STAGING/.config/dot/merge-hooks.d/testapp" \
    "$BASE_STAGING/.local/lib/dotfiles/legacy-dot/core/merge-hooks"
  printf '%s\n' "# Test app merge inputs" \
    >"$BASE_STAGING/.config/dot/merge-hooks.d/testapp/README.md"
  cat >"$BASE_STAGING/.local/lib/dotfiles/legacy-dot/core/merge-hooks/testapp.sh" <<'MERGE'
merge() { echo "MERGE_TESTAPP_RAN"; }
MERGE

  BASE_ORIGIN=$(_tmpdir)
  dot_fixture_seed_repo "$BASE_ORIGIN" "$BASE_STAGING"
  # The README shortcut defaults to branch `main`. Keep this fixture compatible
  # even when the local Git default branch is still `master`, without changing
  # the separate branch-detection unit coverage above.
  BASE_DEFAULT_BRANCH=$(git --git-dir="$BASE_ORIGIN" symbolic-ref --short HEAD)
  if [[ "$BASE_DEFAULT_BRANCH" != "main" ]]; then
    git --git-dir="$BASE_ORIGIN" branch main "$BASE_DEFAULT_BRANCH"
    git --git-dir="$BASE_ORIGIN" symbolic-ref HEAD refs/heads/main
  fi

  # --- Overlay (work) dotfiles origin ---
  WORK_STAGING=$(_tmpdir)
  echo "work config" >"$WORK_STAGING/work-config"
  mkdir -p "$WORK_STAGING/home"
  echo "work shell" >"$WORK_STAGING/home/.testrc_work"

  WORK_ORIGIN=$(_tmpdir)
  dot_fixture_seed_repo "$WORK_ORIGIN" "$WORK_STAGING"

  # --- test tool origin (stub with bin/test-tool) ---
  dot_fixture_shdeps_tool_origin TEST_TOOL_ORIGIN

  # --- hook pack origin (stub content for a generic post-install hook) ---
  dot_fixture_shdeps_hook_pack_origin HOOK_PACK_ORIGIN

  # Helper to run dotbootstrap in a fresh HOME with local repos.
  # Pre-clones the base bare repo (dotbootstrap no longer auto-clones).
  # Creates overlay conf pointing at the test work repo origin.
  # Usage: _run_bootstrap <home> [extra-args...]
  _run_bootstrap() {
    local home="$1"
    shift
    if [[ ! -d "$home/.dotfiles" ]]; then
      git clone --bare "$BASE_ORIGIN" "$home/.dotfiles" >/dev/null 2>&1
    fi
    # Create overlay conf pointing at test work origin.
    # Intentionally overwrites any conf from base checkout.
    mkdir -p "$home/.config/dot/overlays.d"
    cat >"$home/.config/dot/overlays.d/10-work.conf" <<CONF
url=$WORK_ORIGIN
CONF
    DOTBOOTSTRAP_SOURCED="" \
      HOME="$home" \
      SHDEPS_TEST_TOOL_REPO="$TEST_TOOL_ORIGIN" \
      SHDEPS_HOOK_PACK_REPO="$HOOK_PACK_ORIGIN" \
      "$BIN_DIR/dotbootstrap" "$@" 2>&1
  }

  # Helper for base-only bootstrap (no overlay conf)
  _run_bootstrap_base() {
    local home="$1"
    shift
    if [[ ! -d "$home/.dotfiles" ]]; then
      git clone --bare "$BASE_ORIGIN" "$home/.dotfiles" >/dev/null 2>&1
    fi
    # No overlay conf
    DOTBOOTSTRAP_SOURCED="" \
      HOME="$home" \
      SHDEPS_TEST_TOOL_REPO="$TEST_TOOL_ORIGIN" \
      SHDEPS_HOOK_PACK_REPO="$HOOK_PACK_ORIGIN" \
      "$BIN_DIR/dotbootstrap" "$@" 2>&1
  }
fi

# ---- Fresh install (no overlays) ----

if $_bootstrap_run_fresh; then
