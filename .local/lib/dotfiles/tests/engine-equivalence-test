#!/usr/bin/env bash
# Retained dual-run gate for the embedded-to-standalone engine extraction.

set -u

source_home=${DOT_TEST_SOURCE_HOME:-$HOME}
# shellcheck source=helpers.sh
. "$source_home/.local/lib/dotfiles/tests/helpers.sh"

fixture_file=$source_home/.local/lib/dotfiles/tests/fixtures/engine-equivalence-v1.tsv
old_revision=
candidate_revision=
old_archive_digest=
allowed_old=()
allowed_candidate=()

while IFS=$'\t' read -r kind name value extra; do
  case $kind in
    '' | \#*) continue ;;
  esac
  if [[ -z $name || -z $value || -n ${extra:-} ]]; then
    echo "invalid engine-equivalence fixture row: $kind" >&2
    exit 1
  fi
  case $kind:$name in
    revision:old-dotfiles) old_revision=$value ;;
    revision:candidate-dot) candidate_revision=$value ;;
    archive:old-dotfiles-core-sha256) old_archive_digest=$value ;;
    allowed:old-only) allowed_old+=("$value") ;;
    allowed:candidate-only) allowed_candidate+=("$value") ;;
    *)
      echo "unknown engine-equivalence fixture row: $kind:$name" >&2
      exit 1
      ;;
  esac
done <"$fixture_file"

case $old_revision:$candidate_revision in
  *[!0-9a-f:]* | *:*:)
    echo 'invalid pinned engine revision' >&2
    exit 1
    ;;
esac
[[ ${#old_revision} -eq 40 && ${#candidate_revision} -eq 40 ]] || {
  echo 'engine revisions must be full 40-character object IDs' >&2
  exit 1
}
case $old_archive_digest in
  *[!0-9a-f]* | '')
    echo 'invalid old-engine archive digest' >&2
    exit 1
    ;;
esac
[[ ${#old_archive_digest} -eq 64 ]] || {
  echo 'old-engine archive digest must be a full SHA-256 value' >&2
  exit 1
}
[[ ${#allowed_old[@]} -eq 1 && ${allowed_old[0]} == .local/lib/dot ]] || {
  echo 'old-engine allowed-delta ledger drifted' >&2
  exit 1
}
[[ ${#allowed_candidate[@]} -eq 1 &&
  ${allowed_candidate[0]} == .local/lib/dotfiles ]] || {
  echo 'candidate-engine allowed-delta ledger drifted' >&2
  exit 1
}
cutover_revision=$(sed -n 's/^minimum_revision=//p' \
  "$source_home/.local/lib/dotfiles/dot-cutover.lock")
[[ $candidate_revision == "$cutover_revision" ]] || {
  echo 'equivalence candidate does not match the fleet cutover revision' >&2
  exit 1
}

dot_root=$(_test_dot_root) || {
  echo 'standalone dot checkout is unavailable' >&2
  exit 1
}
git -C "$dot_root" cat-file -e "$candidate_revision^{commit}" 2>/dev/null || {
  echo "candidate standalone revision is unavailable: $candidate_revision" >&2
  exit 1
}

fixture=$(_tmpdir)
fixture=$(cd "$fixture" && pwd -P)
old_home=$fixture/old-home
candidate_home=$fixture/candidate-home
candidate_engine=$fixture/candidate-engine
old_tmp=$fixture/old-tmp
candidate_tmp=$fixture/candidate-tmp
mkdir -p "$old_home" "$candidate_home" "$candidate_engine" \
  "$old_tmp" "$candidate_tmp"
chmod 0700 "$old_home" "$candidate_home" "$candidate_engine" \
  "$old_tmp" "$candidate_tmp"

old_archive=$source_home/.local/lib/dotfiles/tests/fixtures/engine-equivalence-old-core.tar.gz
if ! python3 - "$old_archive" "$old_home" "$old_archive_digest" \
  "$old_revision" <<'PY'; then
import hashlib
import io
import inspect
import os
from pathlib import PurePosixPath
import sys
import tarfile

archive_path, destination, expected_digest, expected_revision = sys.argv[1:]
with open(archive_path, "rb") as stream:
    payload = stream.read()
if hashlib.sha256(payload).hexdigest() != expected_digest:
    raise SystemExit("old-engine archive digest mismatch")

with tarfile.open(fileobj=io.BytesIO(payload), mode="r:gz") as archive:
    if archive.pax_headers.get("comment") != expected_revision:
        raise SystemExit("old-engine archive revision mismatch")
    members = archive.getmembers()
    allowed_directories = {
        ".local",
        ".local/lib",
        ".local/lib/dot",
        ".local/lib/dot/core",
    }
    for member in members:
        path = PurePosixPath(member.name)
        if (
            path.is_absolute()
            or ".." in path.parts
            or not (
                (member.isdir() and member.name in allowed_directories)
                or member.name.startswith(".local/lib/dot/core/")
            )
            or not (member.isdir() or member.isfile())
        ):
            raise SystemExit(f"unsafe old-engine archive member: {member.name!r}")
    extraction_options = {}
    if "filter" in inspect.signature(archive.extractall).parameters:
        extraction_options["filter"] = "fully_trusted"
    archive.extractall(destination, members=members, **extraction_options)

# Match command-line tar's normal umask treatment for the parent directories
# that are visible in the equivalence inventory. The archived engine subtree
# itself remains byte- and mode-exact beneath the explicit old-only ledger.
current_umask = os.umask(0)
os.umask(current_umask)
for relative in (".local", ".local/lib"):
    os.chmod(os.path.join(destination, relative), 0o777 & ~current_umask)
PY
  echo 'could not extract the old embedded engine' >&2
  exit 1
fi
git -C "$dot_root" archive "$candidate_revision" |
  tar -x -C "$candidate_engine" || {
  echo 'could not extract the candidate standalone engine' >&2
  exit 1
}

for hook in "$old_home"/.local/lib/dot/core/merge-hooks/*.sh; do
  case ${hook##*/} in
    cron.sh | ignore.sh) ;;
    *) rm -f -- "$hook" ;;
  esac
done

candidate_extensions=$candidate_home/.local/lib/dotfiles
mkdir -p "$candidate_extensions/merge-hooks.d/lib"
for hook in ignore.sh cron.serial.sh; do
  cp "$source_home/.local/lib/dotfiles/merge-hooks.d/$hook" \
    "$candidate_extensions/merge-hooks.d/$hook"
done
for support in compat.sh windows.sh agent-playbooks.sh shdeps-assets.sh; do
  cp "$source_home/.local/lib/dotfiles/merge-hooks.d/lib/$support" \
    "$candidate_extensions/merge-hooks.d/lib/$support"
done

prepare_home() {
  local home=$1 fake_bin=$2 state=$3

  mkdir -p \
    "$home/.config/dot/merge-hooks.d/ignore/ignore.d" \
    "$home/.config/dot/merge-hooks.d/cron/cron.d" \
    "$home/.config/dot/merge-hooks.d/cron/path.d" \
    "$home/.local/bin" "$home/.local/share" "$home/.local/state" \
    "$home/.cache" "$fake_bin" "$state"
  printf '%s\n' '.cache/' 'build/' \
    >"$home/.config/dot/merge-hooks.d/ignore/ignore.d/10-base.gitignore"
  # shellcheck disable=SC2016 # The fixture exercises documented literal HOME expansion.
  printf '%s\n' '*/5 * * * * $HOME/.local/bin/fixture-job' \
    >"$home/.config/dot/merge-hooks.d/cron/cron.d/10-base.cron"
  # shellcheck disable=SC2016 # The fixture exercises documented literal HOME expansion.
  printf '%s\n' '$HOME/.local/bin' '/usr/bin' \
    >"$home/.config/dot/merge-hooks.d/cron/path.d/10-base.pathlist"
  printf '%s\n' 'MAILTO=fixture@example.invalid' >"$state/crontab"
  : >"$state/effects.log"
  chmod 0600 "$state/effects.log"

  cat >"$fake_bin/rg" <<'SCRIPT'
#!/usr/bin/env bash
exit 0
SCRIPT
  cat >"$fake_bin/crontab" <<'SCRIPT'
#!/usr/bin/env bash
set -u
case ${1:-} in
  -l)
    printf '%s\n' 'crontab -l' >>"$DOT_EQ_EFFECT_LOG"
    [[ -f $DOT_EQ_CRONTAB_STATE ]] || exit 1
    cat "$DOT_EQ_CRONTAB_STATE"
    ;;
  -)
    temporary=$DOT_EQ_CRONTAB_STATE.tmp.$$
    cat >"$temporary" || exit 1
    chmod 0644 "$temporary" || exit 1
    mv "$temporary" "$DOT_EQ_CRONTAB_STATE" || exit 1
    printf '%s\n' 'crontab -' >>"$DOT_EQ_EFFECT_LOG"
    ;;
  -r)
    rm -f -- "$DOT_EQ_CRONTAB_STATE"
    printf '%s\n' 'crontab -r' >>"$DOT_EQ_EFFECT_LOG"
    ;;
  *) exit 2 ;;
esac
SCRIPT
  chmod 0755 "$fake_bin/rg" "$fake_bin/crontab"
}

old_fake=$fixture/old-bin
candidate_fake=$fixture/candidate-bin
old_state=$old_home/.local/state/equivalence
candidate_state=$candidate_home/.local/state/equivalence
prepare_home "$old_home" "$old_fake" "$old_state"
prepare_home "$candidate_home" "$candidate_fake" "$candidate_state"

old_runner=$fixture/run-old
candidate_runner=$fixture/run-candidate
cat >"$old_runner" <<'SCRIPT'
#!/usr/bin/env bash
set -uo pipefail
# shellcheck source=/dev/null
. "$HOME/.local/lib/dot/core/init.sh"
_dot_cleanup_install_owner_traps
first=0
second=0
_run_merges || first=$?
_run_merges || second=$?
printf 'first=%s\nsecond=%s\n' "$first" "$second"
[[ $first -eq 0 && $second -eq 0 ]]
SCRIPT
cat >"$candidate_runner" <<'SCRIPT'
#!/usr/bin/env bash
set -uo pipefail
DOT_SOURCE_ROOT=$1
DOT_CONFIG_VERSION=1
DOT_EXTENSION_API=1
DOT_EXTENSIONS_DIR=$HOME/.local/lib/dotfiles
DOT_DEPENDENCY_PROVIDER=none
export DOT_SOURCE_ROOT DOT_CONFIG_VERSION DOT_EXTENSION_API
export DOT_EXTENSIONS_DIR DOT_DEPENDENCY_PROVIDER
# shellcheck source=/dev/null
. "$DOT_SOURCE_ROOT/lib/dot/public/api-version.sh"
# shellcheck source=/dev/null
. "$DOT_SOURCE_ROOT/lib/dot/public/xdg.sh"
# shellcheck source=/dev/null
. "$DOT_SOURCE_ROOT/lib/dot/public/ui.sh"
# shellcheck source=/dev/null
. "$DOT_SOURCE_ROOT/lib/dot/runtime.sh"
_dot_cleanup_install_owner_traps
first=0
second=0
_run_merges || first=$?
_run_merges || second=$?
printf 'first=%s\nsecond=%s\n' "$first" "$second"
[[ $first -eq 0 && $second -eq 0 ]]
SCRIPT
chmod 0755 "$old_runner" "$candidate_runner"

inventory_owned_tree() {
  local root=$1 output=$2
  python3 - "$root" >"$output" <<'PY'
import hashlib
import os
import stat
import sys

root = os.path.realpath(sys.argv[1])


def describe(path, relative):
    metadata = os.lstat(path)
    mode = format(stat.S_IMODE(metadata.st_mode), "04o")
    kind = "other"
    target = "-"
    digest = "-"
    if stat.S_ISDIR(metadata.st_mode):
        kind = "directory"
    elif stat.S_ISREG(metadata.st_mode):
        kind = "file"
        with open(path, "rb") as stream:
            digest = hashlib.sha256(stream.read()).hexdigest()
    elif stat.S_ISLNK(metadata.st_mode):
        kind = "symlink"
        target = os.readlink(path)
    print("\t".join((relative, kind, mode, target, digest)))
    if kind != "directory":
        return
    with os.scandir(path) as entries:
        ordered = sorted(entries, key=lambda entry: os.fsencode(entry.name))
    for entry in ordered:
        child = entry.name if relative == "." else relative + "/" + entry.name
        describe(entry.path, child)


describe(root, ".")
PY
}

run_engine() {
  local role=$1 home=$2 fake_bin=$3 state=$4 temporary=$5 runner=$6
  local engine=${7:-} status=0

  HOME=$home \
    XDG_CONFIG_HOME=$home/.config \
    XDG_DATA_HOME=$home/.local/share \
    XDG_STATE_HOME=$home/.local/state \
    XDG_CACHE_HOME=$home/.cache \
    TMPDIR=$temporary \
    PATH=$fake_bin:/usr/bin:/bin \
    DOT_EQ_CRONTAB_STATE=$state/crontab \
    DOT_EQ_EFFECT_LOG=$state/effects.log \
    DOT_QUIET=1 DOT_VERBOSE=0 DOT_MERGE_JOBS=1 \
    "$BASH" "$runner" ${engine:+"$engine"} \
    >"$fixture/$role.stdout" 2>"$fixture/$role.stderr" || status=$?
  printf '%s\n' "$status" >"$fixture/$role.status"
}

inventory_owned_tree "$old_home/.local/lib/dot" \
  "$fixture/old.owned.before"
inventory_owned_tree "$candidate_home/.local/lib/dotfiles" \
  "$fixture/candidate.owned.before"
run_engine old "$old_home" "$old_fake" "$old_state" "$old_tmp" "$old_runner"
run_engine candidate "$candidate_home" "$candidate_fake" "$candidate_state" \
  "$candidate_tmp" "$candidate_runner" "$candidate_engine"
inventory_owned_tree "$old_home/.local/lib/dot" \
  "$fixture/old.owned.after"
inventory_owned_tree "$candidate_home/.local/lib/dotfiles" \
  "$fixture/candidate.owned.after"

normalize_text() {
  local source=$1 home=$2 destination=$3
  sed "s|$home|\$HOME|g" "$source" >"$destination"
}

normalize_text "$fixture/old.stdout" "$old_home" "$fixture/old.stdout.normalized"
normalize_text "$fixture/candidate.stdout" "$candidate_home" \
  "$fixture/candidate.stdout.normalized"
normalize_text "$fixture/old.stderr" "$old_home" "$fixture/old.stderr.normalized"
normalize_text "$fixture/candidate.stderr" "$candidate_home" \
  "$fixture/candidate.stderr.normalized"
normalize_text "$old_state/effects.log" "$old_home" "$fixture/old.effects.normalized"
normalize_text "$candidate_state/effects.log" "$candidate_home" \
  "$fixture/candidate.effects.normalized"
normalize_text "$old_home/.ignore" "$old_home" "$fixture/old.ignore.normalized"
normalize_text "$candidate_home/.ignore" "$candidate_home" \
  "$fixture/candidate.ignore.normalized"
normalize_text "$old_state/crontab" "$old_home" "$fixture/old.crontab.normalized"
normalize_text "$candidate_state/crontab" "$candidate_home" \
  "$fixture/candidate.crontab.normalized"

inventory_home() {
  local home=$1 output=$2
  python3 - "$home" >"$output" <<'PY'
import hashlib
import os
import stat
import sys

root = os.path.realpath(sys.argv[1])
root_bytes = os.fsencode(root)


def normalized(value):
    return value.replace(root_bytes, b"$HOME")


def visit(directory, relative=""):
    with os.scandir(directory) as entries:
        ordered = sorted(entries, key=lambda entry: os.fsencode(entry.name))
    for entry in ordered:
        rel = entry.name if not relative else relative + "/" + entry.name
        metadata = entry.stat(follow_symlinks=False)
        mode = format(stat.S_IMODE(metadata.st_mode), "04o")
        kind = "other"
        target = "-"
        digest = "-"
        if stat.S_ISDIR(metadata.st_mode):
            kind = "directory"
        elif stat.S_ISREG(metadata.st_mode):
            kind = "file"
            with open(entry.path, "rb") as stream:
                digest = hashlib.sha256(normalized(stream.read())).hexdigest()
        elif stat.S_ISLNK(metadata.st_mode):
            kind = "symlink"
            target = os.fsdecode(normalized(os.fsencode(os.readlink(entry.path))))
        print("\t".join((rel, kind, mode, target, digest)))
        if kind == "directory":
            visit(entry.path, rel)


visit(root)
PY
}

filter_inventory() {
  local side=$1 input=$2 output=$3 line path prefix skip
  local -a allowed=()

  case $side in
    old) allowed=("${allowed_old[@]}") ;;
    candidate) allowed=("${allowed_candidate[@]}") ;;
    *) return 2 ;;
  esac
  : >"$output"
  while IFS= read -r line || [[ -n $line ]]; do
    path=${line%%$'\t'*}
    skip=false
    for prefix in "${allowed[@]}"; do
      case $path in
        "$prefix" | "$prefix"/*)
          skip=true
          break
          ;;
      esac
    done
    [[ $skip == true ]] || printf '%s\n' "$line" >>"$output"
  done <"$input"
}

inventory_home "$old_home" "$fixture/old.inventory"
inventory_home "$candidate_home" "$fixture/candidate.inventory"
filter_inventory old "$fixture/old.inventory" "$fixture/old.comparable"
filter_inventory candidate "$fixture/candidate.inventory" \
  "$fixture/candidate.comparable"

_assert_eq 'old embedded engine succeeds twice' 0 "$(<"$fixture/old.status")"
_assert_eq 'candidate standalone engine succeeds twice' 0 \
  "$(<"$fixture/candidate.status")"
_assert_file_content 'old embedded engine reports two successful passes' \
  $'first=0\nsecond=0' "$fixture/old.stdout.normalized"
_assert_file_content 'candidate engine reports two successful passes' \
  $'first=0\nsecond=0' "$fixture/candidate.stdout.normalized"
_assert_file_content 'old embedded engine emits no diagnostics' '' \
  "$fixture/old.stderr.normalized"
_assert_file_content 'candidate engine emits no diagnostics' '' \
  "$fixture/candidate.stderr.normalized"

if cmp -s "$fixture/old.effects.normalized" \
  "$fixture/candidate.effects.normalized"; then
  _pass 'ordered external-effect transcripts are equivalent'
else
  diff -u "$fixture/old.effects.normalized" \
    "$fixture/candidate.effects.normalized" >&2 || true
  _fail 'ordered external-effect transcripts are equivalent'
fi

if cmp -s "$fixture/old.comparable" "$fixture/candidate.comparable"; then
  _pass 'complete normalized HOME inventories are equivalent'
else
  diff -u "$fixture/old.comparable" "$fixture/candidate.comparable" >&2 || true
  _fail 'complete normalized HOME inventories are equivalent'
fi

if cmp -s "$fixture/old.owned.before" "$fixture/old.owned.after"; then
  _pass 'old-only ownership tree remains unchanged during execution'
else
  diff -u "$fixture/old.owned.before" "$fixture/old.owned.after" >&2 || true
  _fail 'old-only ownership tree remains unchanged during execution'
fi
if cmp -s "$fixture/candidate.owned.before" \
  "$fixture/candidate.owned.after"; then
  _pass 'candidate-only ownership tree remains unchanged during execution'
else
  diff -u "$fixture/candidate.owned.before" \
    "$fixture/candidate.owned.after" >&2 || true
  _fail 'candidate-only ownership tree remains unchanged during execution'
fi

if grep -Fq $'.local/lib/dot\tdirectory\t' "$fixture/old.inventory"; then
  _pass 'old-only ownership delta is present and explicit'
else
  _fail 'old-only ownership delta is present and explicit'
fi
if grep -Fq $'.local/lib/dotfiles\tdirectory\t' \
  "$fixture/candidate.inventory"; then
  _pass 'candidate-only ownership delta is present and explicit'
else
  _fail 'candidate-only ownership delta is present and explicit'
fi

_assert_file_content 'generated ignore policy is equivalent' \
  "$(<"$fixture/old.ignore.normalized")" \
  "$fixture/candidate.ignore.normalized"
_assert_file_content 'installed crontab is equivalent' \
  "$(<"$fixture/old.crontab.normalized")" \
  "$fixture/candidate.crontab.normalized"

_test_summary
