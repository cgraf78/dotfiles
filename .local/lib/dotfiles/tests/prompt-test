    zmodload zsh/datetime 2>/dev/null
    PROBE=$1; ASYNC60=$2
    zle() { return 0; }
    __git_prompt() { print $sysparams[pid] >$PROBE; sleep 10; print " (x)"; }
    . "$ASYNC60" >/dev/null 2>&1
    __git_prompt_async_start
    integer n=0
    while [[ ! -s $PROBE && n -lt 250 ]]; do sleep 0.02; ((n++)); done
    [[ -s $PROBE ]] || { print "WORKER=missing"; exit 0; }
    _old=$(<$PROBE)
    : >$PROBE
    _t0=$EPOCHREALTIME
    __git_prompt_async_start
    n=0
    while kill -0 $_old 2>/dev/null && ((n < 300)); do sleep 0.02; ((n++)); done
    _t1=$EPOCHREALTIME
    kill -0 $_old 2>/dev/null && print "OLD=alive" || print "OLD=dead"
    if [[ -n $_t0 && -n $_t1 ]] && (( (_t1 - _t0) * 1000 < 8000 )); then
      print "PROMPT-KILL=yes"
    else
      print "PROMPT-KILL=no"
    fi
    _new=$(<$PROBE)
    __git_prompt_async_cancel
    [[ -n ${_new:-} ]] && kill -9 $_new 2>/dev/null
    kill -9 $_old 2>/dev/null
  ' _ "$ASYNC_PROBE" "$ASYNC60" 2>/dev/null)
  _assert_contains "async: previous worker is dead after redraw" \
    "OLD=dead" "$async_kill_out"
  _assert_contains "async: worker felled promptly, not after its full sleep" \
    "PROMPT-KILL=yes" "$async_kill_out"

