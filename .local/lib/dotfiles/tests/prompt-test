_assert_eq "system nonrepo prompt: fails fast on the system binary" \
  "1" "$(grep -c '^system:' "$SYS_SYS_LOG" | tr -d ' ')"
_assert_file_content "system nonrepo prompt: never retries outside repos" \
  "" "$SYS_REAL_LOG"

SYS_BREW="$TEST_TMPDIR/sysbrew"
