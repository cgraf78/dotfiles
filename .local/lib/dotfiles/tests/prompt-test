    "DEFS-OK" "$async_defs"

  # Rapid redraws must kill the previous worker instead of orphaning it: the
  # stub sleeps 10s, the cancel must fell it long before (6s deadline).
  ASYNC_PROBE="$TEST_TMPDIR/async-probe.pid"
  rm -f "$ASYNC_PROBE"
