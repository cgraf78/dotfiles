#!/usr/bin/env bash
# prompt-test — shell prompt helpers.

# shellcheck disable=SC1091 # dotfiles test helper lives under HOME.
. "${BASH_SOURCE[0]%/*}/helpers.sh"

REAL_HOME="${DOT_TEST_SOURCE_HOME:-$HOME}"
REAL_GIT=$(PATH=/usr/bin:/bin command -v git)
TEST_TMPDIR=$(_tmpdir)

echo ""
echo "=== prompt: home dotfiles git path ==="

MOCK_HOME="$TEST_TMPDIR/home"
MOCK_BIN="$TEST_TMPDIR/bin"
GIT_LOG="$TEST_TMPDIR/git.log"
mkdir -p "$MOCK_HOME/.dotfiles" "$MOCK_BIN"
: >"$GIT_LOG"

cat >"$MOCK_BIN/git" <<'EOF'
#!/usr/bin/env bash
if [[ "${PROMPT_USE_REAL_GIT:-0}" == 1 ]]; then
  exec "$REAL_GIT" "$@"
fi
printf '%s\n' "$*" >>"$GIT_LOG"
case " $* " in
  *" rev-parse --git-dir "*)
    printf '%s\n' "${MOCK_GITDIR:-.dotfiles}"
    ;;
  *" --no-optional-locks status --porcelain=v2 --branch "*)
    [[ "${MOCK_STATUS_FAIL:-0}" != 1 ]] || exit 1
    [[ "${MOCK_EMPTY_STATUS:-0}" != 1 ]] || exit 0
    printf '%s\n' \
      "# branch.head ${MOCK_BRANCH:-main}" \
      '# branch.ab +1 -2' \
      '1 .M N... 100644 100644 100644 aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa file.txt'
    ;;
  *" rev-parse --short HEAD "*)
    printf 'abc123\n'
    ;;
  *)
    exit 1
    ;;
esac
EOF
chmod +x "$MOCK_BIN/git"

export HOME="$MOCK_HOME"
export GIT_LOG REAL_GIT
PATH="$MOCK_BIN:$PATH"
# Isolate launcher-bypass assertions from the host's system git. Sections
# covering the system fast path override this with fixture candidates.
DOT_GIT_PROMPT_SYSTEM_GITS=""
export DOT_GIT_PROMPT_SYSTEM_GITS

(
  cd "$HOME" || exit 1
  # shellcheck disable=SC1091 # source the installed prompt helper from real HOME.
  . "$REAL_HOME/.config/shell/interactive.d/59-prompt.sh"
  __git_prompt
) >"$TEST_TMPDIR/prompt.out"

prompt_out=$(cat "$TEST_TMPDIR/prompt.out")
git_log=$(cat "$GIT_LOG")

_assert_contains "home dotfiles prompt: renders branch" "main" "$prompt_out"
_assert_not_contains \
  "home dotfiles prompt: skips launcher rev-parse" \
  "rev-parse --git-dir" \
  "$git_log"
_assert_contains \
  "home dotfiles prompt: uses explicit bare repo args" \
  "--git-dir=$HOME/.dotfiles --work-tree=$HOME --no-optional-locks status --porcelain=v2 --branch" \
  "$git_log"

echo ""
echo "=== prompt: dotfiles descendant git path ==="

: >"$GIT_LOG"
mkdir -p "$HOME/.config/prompt-test"
ln -s .dotfiles "$HOME/.dotfiles-alias"
export MOCK_GITDIR="$HOME/.dotfiles-alias"
(
  cd "$HOME/.config/prompt-test" || exit 1
  # shellcheck disable=SC1091 # source the installed prompt helper from real HOME.
  . "$REAL_HOME/.config/shell/interactive.d/59-prompt.sh"
  __git_prompt
) >"$TEST_TMPDIR/prompt-descendant.out"
unset MOCK_GITDIR

prompt_descendant_out=$(cat "$TEST_TMPDIR/prompt-descendant.out")
git_descendant_log=$(cat "$GIT_LOG")

_assert_contains "dotfiles descendant prompt: renders branch" \
  "main" "$prompt_descendant_out"
_assert_contains "dotfiles descendant prompt: keeps authoritative discovery" \
  "rev-parse --git-dir" "$git_descendant_log"
_assert_contains "dotfiles descendant prompt: status uses explicit base repo" \
  "--git-dir=$HOME/.dotfiles --work-tree=$HOME --no-optional-locks status --porcelain=v2 --branch" \
  "$git_descendant_log"

echo ""
echo "=== prompt: nested repository path ==="

: >"$GIT_LOG"
mkdir -p "$HOME/project/src" "$HOME/project/src/.git"
export MOCK_GITDIR=.git
(
  cd "$HOME/project/src" || exit 1
  # shellcheck disable=SC1091 # source the installed prompt helper from real HOME.
  . "$REAL_HOME/.config/shell/interactive.d/59-prompt.sh"
  __git_prompt
) >"$TEST_TMPDIR/prompt-nested.out"
unset MOCK_GITDIR

git_nested_log=$(cat "$GIT_LOG")
_assert_contains "nested repository prompt: keeps normal status routing" \
  "--no-optional-locks status --porcelain=v2 --branch" "$git_nested_log"
_assert_not_contains "nested repository prompt: does not select base dotfiles" \
  "--git-dir=$HOME/.dotfiles" "$git_nested_log"
_assert_not_contains "nested repository prompt: skips separate discovery" \
  "rev-parse --git-dir" "$git_nested_log"
_assert_eq "nested repository prompt: invokes git once" \
  "1" "$(wc -l <"$GIT_LOG" | tr -d ' ')"

echo ""
echo "=== prompt: Bash resolves the real Git command once ==="

RESOLVED_HOME="$TEST_TMPDIR/resolved-home"
RESOLVED_REAL_BIN="$TEST_TMPDIR/resolved-real-bin"
RESOLVED_WRAPPER_LOG="$TEST_TMPDIR/resolved-wrapper.log"
RESOLVED_REAL_LOG="$TEST_TMPDIR/resolved-real.log"
RESOLVED_COMMAND_LOG="$TEST_TMPDIR/resolved-command.log"
RESOLVED_CACHE="$RESOLVED_HOME/.cache/dot/git-real"
mkdir -p "$RESOLVED_HOME/.dotfiles" \
  "$RESOLVED_HOME/.local/bin" \
  "${RESOLVED_CACHE%/*}" \
  "$RESOLVED_REAL_BIN"
: >"$RESOLVED_WRAPPER_LOG"
: >"$RESOLVED_REAL_LOG"
cat >"$RESOLVED_HOME/.local/bin/git" <<'EOF'
#!/usr/bin/env bash
# Dotfiles-aware launcher for Git.
printf 'wrapper:%s\n' "$*" >>"$RESOLVED_WRAPPER_LOG"
exec "$RESOLVED_REAL_BIN/git" "$@"
EOF
cat >"$RESOLVED_REAL_BIN/git" <<'EOF'
#!/usr/bin/env bash
printf 'real:%s\n' "$*" >>"$RESOLVED_REAL_LOG"
case " $* " in
  *" --no-optional-locks status --porcelain=v2 --branch "*)
    printf '%s\n' '# branch.head main' '# branch.ab +0 -0'
    ;;
  *) exit 1 ;;
esac
EOF
chmod +x "$RESOLVED_HOME/.local/bin/git" "$RESOLVED_REAL_BIN/git"
RESOLVED_PATH="$RESOLVED_HOME/.local/bin:$RESOLVED_REAL_BIN:/usr/bin:/bin"
printf '%s\n%s\n' "$RESOLVED_REAL_BIN/git" "$RESOLVED_PATH" >"$RESOLVED_CACHE"

resolved_prompt=$(
  HOME="$RESOLVED_HOME" \
    BASH_ENV='' \
    REAL_HOME="$REAL_HOME" \
    RESOLVED_REAL_BIN="$RESOLVED_REAL_BIN" \
    RESOLVED_WRAPPER_LOG="$RESOLVED_WRAPPER_LOG" \
    RESOLVED_REAL_LOG="$RESOLVED_REAL_LOG" \
    RESOLVED_COMMAND_LOG="$RESOLVED_COMMAND_LOG" \
    XDG_CACHE_HOME="$RESOLVED_HOME/.cache" \
    PATH="$RESOLVED_PATH" \
    bash --noprofile --norc -c '
      cd "$HOME" || exit 1
      # shellcheck disable=SC1091
      . "$REAL_HOME/.config/shell/interactive.d/59-prompt.sh"
      printf "%s\n%s\n" "${_DOT_GIT_PROMPT_BIN:-unset}" \
        "${_DOT_GIT_PROMPT_PATH_SNAPSHOT:-unset}" >"$RESOLVED_COMMAND_LOG"
      __git_prompt
    '
)
_assert_contains "Bash prompt real Git: renders repository state" \
  "main" "$resolved_prompt"
_assert_file_content "Bash prompt real Git: accepts the launcher cache" \
  "$(printf '%s\n%s' "$RESOLVED_REAL_BIN/git" "$RESOLVED_PATH")" \
  "$RESOLVED_COMMAND_LOG"
_assert_file_content "Bash prompt real Git: bypasses the PATH launcher after resolution" \
  "" "$RESOLVED_WRAPPER_LOG"
_assert_contains "Bash prompt real Git: invokes the resolved command" \
  "real:--git-dir=$RESOLVED_HOME/.dotfiles --work-tree=$RESOLVED_HOME --no-optional-locks status --porcelain=v2 --branch" \
  "$(cat "$RESOLVED_REAL_LOG")"

: >"$RESOLVED_WRAPPER_LOG"
: >"$RESOLVED_REAL_LOG"
resolved_zsh_prompt=$(
  HOME="$RESOLVED_HOME" \
    REAL_HOME="$REAL_HOME" \
    RESOLVED_REAL_BIN="$RESOLVED_REAL_BIN" \
    RESOLVED_WRAPPER_LOG="$RESOLVED_WRAPPER_LOG" \
    RESOLVED_REAL_LOG="$RESOLVED_REAL_LOG" \
    XDG_CACHE_HOME="$RESOLVED_HOME/.cache" \
    PATH="$RESOLVED_PATH" \
    zsh -f -c '
      cd "$HOME" || exit 1
      . "$REAL_HOME/.config/shell/interactive.d/59-prompt.sh"
      __git_prompt
    '
)
_assert_contains "Zsh prompt real Git: renders repository state" \
  "main" "$resolved_zsh_prompt"
_assert_file_content "Zsh prompt real Git: bypasses the PATH launcher" \
  "" "$RESOLVED_WRAPPER_LOG"
_assert_contains "Zsh prompt real Git: invokes the resolved command" \
  "real:--git-dir=$RESOLVED_HOME/.dotfiles --work-tree=$RESOLVED_HOME --no-optional-locks status --porcelain=v2 --branch" \
  "$(cat "$RESOLVED_REAL_LOG")"

echo ""
echo "=== prompt: explicit Git context ==="

: >"$GIT_LOG"
mkdir -p "$HOME/alternate-worktree"
export GIT_DIR="$HOME/.dotfiles"
export GIT_WORK_TREE="$HOME/alternate-worktree"
export MOCK_GITDIR="$HOME/.dotfiles"
(
  cd "$HOME/.config/prompt-test" || exit 1
  # shellcheck disable=SC1091 # source the installed prompt helper from real HOME.
  . "$REAL_HOME/.config/shell/interactive.d/59-prompt.sh"
  __git_prompt
) >"$TEST_TMPDIR/prompt-explicit.out"
unset GIT_DIR GIT_WORK_TREE MOCK_GITDIR

git_explicit_log=$(cat "$GIT_LOG")
_assert_contains "explicit Git prompt: keeps normal status routing" \
  "--no-optional-locks status --porcelain=v2 --branch" "$git_explicit_log"
_assert_not_contains "explicit Git prompt: does not override caller worktree" \
  "--work-tree=$HOME" "$git_explicit_log"
_assert_not_contains "explicit Git prompt: uses provided git dir without discovery" \
  "rev-parse --git-dir" "$git_explicit_log"

echo ""
echo "=== prompt: linked worktree operation state ==="

: >"$GIT_LOG"
WORKTREE_ROOT="$HOME/linked-worktree"
WORKTREE_GITDIR="$HOME/common/worktrees/linked-worktree"
mkdir -p "$WORKTREE_ROOT/src" "$WORKTREE_GITDIR"
printf 'gitdir: ../common/worktrees/linked-worktree' >"$WORKTREE_ROOT/.git"
: >"$WORKTREE_GITDIR/MERGE_HEAD"
export MOCK_GITDIR="$WORKTREE_GITDIR"
(
  cd "$WORKTREE_ROOT/src" || exit 1
  # shellcheck disable=SC1091 # source the installed prompt helper from real HOME.
  . "$REAL_HOME/.config/shell/interactive.d/59-prompt.sh"
  __git_prompt
) >"$TEST_TMPDIR/prompt-worktree.out"
unset MOCK_GITDIR

prompt_worktree_out=$(cat "$TEST_TMPDIR/prompt-worktree.out")
git_worktree_log=$(cat "$GIT_LOG")
_assert_contains "linked worktree prompt: preserves merge state" \
  "|MERGE" "$prompt_worktree_out"
_assert_contains "linked worktree prompt: validates gitfile operation state" \
  "rev-parse --git-dir" "$git_worktree_log"
_assert_eq "linked worktree prompt: validates operation state" \
  "2" "$(wc -l <"$GIT_LOG" | tr -d ' ')"

echo ""
echo "=== prompt: symlinked repository path ==="

SYMLINK_PARENT="$HOME/symlink-parent"
SYMLINK_TARGET="$HOME/symlink-target"
mkdir -p "$SYMLINK_PARENT" "$SYMLINK_TARGET/src"
"$REAL_GIT" -C "$SYMLINK_PARENT" init -q
"$REAL_GIT" -C "$SYMLINK_PARENT" symbolic-ref HEAD refs/heads/alpha
: >"$SYMLINK_PARENT/.git/MERGE_HEAD"
"$REAL_GIT" -C "$SYMLINK_TARGET" init -q
"$REAL_GIT" -C "$SYMLINK_TARGET" symbolic-ref HEAD refs/heads/beta
ln -s "$SYMLINK_TARGET" "$SYMLINK_PARENT/link"
(
  export PROMPT_USE_REAL_GIT=1
  cd "$SYMLINK_PARENT/link/src" || exit 1
  # shellcheck disable=SC1091 # source the installed prompt helper from real HOME.
  . "$REAL_HOME/.config/shell/interactive.d/59-prompt.sh"
  __git_prompt
) >"$TEST_TMPDIR/prompt-symlink.out"

prompt_symlink_out=$(cat "$TEST_TMPDIR/prompt-symlink.out")
_assert_contains "symlinked repository prompt: uses physical repository" \
  "beta" "$prompt_symlink_out"
_assert_not_contains "symlinked repository prompt: ignores lexical operation state" \
  "|MERGE" "$prompt_symlink_out"

echo ""
echo "=== prompt: discovery disagreement ==="

: >"$GIT_LOG"
DISAGREE_ROOT="$HOME/disagreement"
AUTHORITATIVE_GITDIR="$HOME/authoritative-gitdir"
mkdir -p "$DISAGREE_ROOT/.git" "$AUTHORITATIVE_GITDIR"
: >"$DISAGREE_ROOT/.git/MERGE_HEAD"
export MOCK_GITDIR="$AUTHORITATIVE_GITDIR"
(
  cd "$DISAGREE_ROOT" || exit 1
  # shellcheck disable=SC1091 # source the installed prompt helper from real HOME.
  . "$REAL_HOME/.config/shell/interactive.d/59-prompt.sh"
  __git_prompt
) >"$TEST_TMPDIR/prompt-disagreement.out"
unset MOCK_GITDIR

prompt_disagreement_out=$(cat "$TEST_TMPDIR/prompt-disagreement.out")
_assert_not_contains "discovery disagreement: rejects inferred operation state" \
  "|MERGE" "$prompt_disagreement_out"
_assert_contains "discovery disagreement: validates with Git" \
  "rev-parse --git-dir" "$(cat "$GIT_LOG")"

echo ""
echo "=== prompt: Git ceiling fallback ==="

CEILING_ROOT="$HOME/ceiling-repo"
mkdir -p "$CEILING_ROOT/sub"
"$REAL_GIT" -C "$CEILING_ROOT" init -q
if (
  # shellcheck disable=SC2030,SC2034 # read by the sourced prompt helper.
  GIT_CEILING_DIRECTORIES="$CEILING_ROOT/"
  cd "$CEILING_ROOT/sub" || exit 1
  # shellcheck disable=SC1091 # source the installed prompt helper from real HOME.
  . "$REAL_HOME/.config/shell/interactive.d/59-prompt.sh"
  _dot_git_prompt_gitdir
) >"$TEST_TMPDIR/prompt-ceiling.out" 2>/dev/null; then
  _fail "Git ceiling prompt: defers discovery to Git"
else
  _pass "Git ceiling prompt: defers discovery to Git"
fi

echo ""
echo "=== prompt: repository operation states ==="

for operation in merge rebase pick revert; do
  rm -f "$HOME/project/src/.git/MERGE_HEAD" \
    "$HOME/project/src/.git/CHERRY_PICK_HEAD" \
    "$HOME/project/src/.git/REVERT_HEAD"
  rm -rf "$HOME/project/src/.git/rebase-merge"
  case "$operation" in
    merge)
      : >"$HOME/project/src/.git/MERGE_HEAD"
      expected_operation='|MERGE'
      ;;
    rebase)
      mkdir "$HOME/project/src/.git/rebase-merge"
      expected_operation='|REBASE'
      ;;
    pick)
      : >"$HOME/project/src/.git/CHERRY_PICK_HEAD"
      expected_operation='|PICK'
      ;;
    revert)
      : >"$HOME/project/src/.git/REVERT_HEAD"
      expected_operation='|REVERT'
      ;;
  esac
  : >"$GIT_LOG"
  export MOCK_GITDIR=.git
  (
    cd "$HOME/project/src" || exit 1
    # shellcheck disable=SC1091 # source the installed prompt helper from real HOME.
    . "$REAL_HOME/.config/shell/interactive.d/59-prompt.sh"
    __git_prompt
  ) >"$TEST_TMPDIR/prompt-operation.out"
  unset MOCK_GITDIR
  _assert_contains "operation prompt: preserves $operation state" \
    "$expected_operation" "$(cat "$TEST_TMPDIR/prompt-operation.out")"
  _assert_eq "operation prompt: $operation validates operation state" \
    "2" "$(wc -l <"$GIT_LOG" | tr -d ' ')"
done
rm -f "$HOME/project/src/.git/MERGE_HEAD" \
  "$HOME/project/src/.git/CHERRY_PICK_HEAD" \
  "$HOME/project/src/.git/REVERT_HEAD"
rm -rf "$HOME/project/src/.git/rebase-merge"

echo ""
echo "=== prompt: detached head ==="

: >"$GIT_LOG"
export MOCK_BRANCH='(detached)' MOCK_GITDIR=.git
(
  cd "$HOME/project/src" || exit 1
  # shellcheck disable=SC1091 # source the installed prompt helper from real HOME.
  . "$REAL_HOME/.config/shell/interactive.d/59-prompt.sh"
  __git_prompt
) >"$TEST_TMPDIR/prompt-detached.out"
unset MOCK_BRANCH MOCK_GITDIR

prompt_detached_out=$(cat "$TEST_TMPDIR/prompt-detached.out")
git_detached_log=$(cat "$GIT_LOG")
_assert_contains "detached prompt: renders short revision" \
  "abc123" "$prompt_detached_out"
_assert_not_contains "detached prompt: skips separate git-dir discovery" \
  "rev-parse --git-dir" "$git_detached_log"
_assert_eq "detached prompt: adds only the revision lookup" \
  "2" "$(wc -l <"$GIT_LOG" | tr -d ' ')"

echo ""
echo "=== prompt: non-repository ==="

: >"$GIT_LOG"
NONREPO_ROOT="$TEST_TMPDIR/outside-home"
mkdir -p "$NONREPO_ROOT"
export MOCK_STATUS_FAIL=1
(
  cd "$NONREPO_ROOT" || exit 1
  # shellcheck disable=SC1091 # source the installed prompt helper from real HOME.
  . "$REAL_HOME/.config/shell/interactive.d/59-prompt.sh"
  __git_prompt
) >"$TEST_TMPDIR/prompt-nonrepo.out"
unset MOCK_STATUS_FAIL

_assert_file_content "non-repository prompt: renders nothing" \
  "" "$TEST_TMPDIR/prompt-nonrepo.out"
_assert_eq "non-repository prompt: stops after failed status" \
  "1" "$(wc -l <"$GIT_LOG" | tr -d ' ')"

echo ""
echo "=== prompt: stale resolver cache refresh ==="

# A cache whose PATH snapshot no longer matches is discarded, but instead of
# routing every prompt through the PATH launcher until something republishes,
# the resolver re-resolves past the launcher in-process and refreshes the
# cache for fresh shells.
STALE_CACHE="$RESOLVED_HOME/.cache/dot/git-real"
STALE_COMMAND_LOG="$TEST_TMPDIR/stale-command.log"
printf '%s\n%s\n' "$RESOLVED_REAL_BIN/git" "STALE-PATH-NO-LONGER-CURRENT" >"$STALE_CACHE"
: >"$RESOLVED_WRAPPER_LOG"
: >"$RESOLVED_REAL_LOG"
stale_prompt=$(
  HOME="$RESOLVED_HOME" \
    BASH_ENV='' \
    REAL_HOME="$REAL_HOME" \
    RESOLVED_REAL_BIN="$RESOLVED_REAL_BIN" \
    RESOLVED_WRAPPER_LOG="$RESOLVED_WRAPPER_LOG" \
    RESOLVED_REAL_LOG="$RESOLVED_REAL_LOG" \
    STALE_COMMAND_LOG="$STALE_COMMAND_LOG" \
    XDG_CACHE_HOME="$RESOLVED_HOME/.cache" \
    PATH="$RESOLVED_PATH" \
    bash --noprofile --norc -c '
      cd "$HOME" || exit 1
      # shellcheck disable=SC1091
      . "$REAL_HOME/.config/shell/interactive.d/59-prompt.sh"
      printf "%s\n" "${_DOT_GIT_PROMPT_BIN:-unset}" >"$STALE_COMMAND_LOG"
      __git_prompt
    '
)
_assert_contains "stale cache prompt: still renders repository state" \
  "main" "$stale_prompt"
_assert_file_content "stale cache prompt: re-resolves past the launcher" \
  "$RESOLVED_REAL_BIN/git" "$STALE_COMMAND_LOG"
_assert_file_content "stale cache prompt: bypasses the PATH launcher" \
  "" "$RESOLVED_WRAPPER_LOG"
_assert_file_content "stale cache prompt: refreshes the cache for fresh shells" \
  "$(printf '%s\n%s' "$RESOLVED_REAL_BIN/git" "$RESOLVED_PATH")" "$STALE_CACHE"

echo ""
echo "=== prompt: launcher-published cache ==="

# The launcher publishes its own validated cache beside the legacy prompt
# path. The resolver consults it when the legacy entry is missing or stale.
LAUNCHER_CACHE="$RESOLVED_HOME/.cache/dotfiles/git-real"
mkdir -p "${LAUNCHER_CACHE%/*}"
printf '%s\n%s\n' "$RESOLVED_REAL_BIN/git" "STALE-PATH-NO-LONGER-CURRENT" >"$STALE_CACHE"
printf '%s\n%s\n' "$RESOLVED_REAL_BIN/git" "$RESOLVED_PATH" >"$LAUNCHER_CACHE"
: >"$RESOLVED_WRAPPER_LOG"
: >"$RESOLVED_REAL_LOG"
launcher_cache_prompt=$(
  HOME="$RESOLVED_HOME" \
    BASH_ENV='' \
    REAL_HOME="$REAL_HOME" \
    RESOLVED_REAL_BIN="$RESOLVED_REAL_BIN" \
    RESOLVED_WRAPPER_LOG="$RESOLVED_WRAPPER_LOG" \
    RESOLVED_REAL_LOG="$RESOLVED_REAL_LOG" \
    STALE_COMMAND_LOG="$STALE_COMMAND_LOG" \
    XDG_CACHE_HOME="$RESOLVED_HOME/.cache" \
    PATH="$RESOLVED_PATH" \
    bash --noprofile --norc -c '
      cd "$HOME" || exit 1
      # shellcheck disable=SC1091
      . "$REAL_HOME/.config/shell/interactive.d/59-prompt.sh"
      printf "%s\n" "${_DOT_GIT_PROMPT_BIN:-unset}" >"$STALE_COMMAND_LOG"
      __git_prompt
    '
)
_assert_contains "launcher cache prompt: still renders repository state" \
  "main" "$launcher_cache_prompt"
_assert_file_content "launcher cache prompt: accepts the launcher cache path" \
  "$RESOLVED_REAL_BIN/git" "$STALE_COMMAND_LOG"
_assert_file_content "launcher cache prompt: bypasses the PATH launcher" \
  "" "$RESOLVED_WRAPPER_LOG"
rm -f "$LAUNCHER_CACHE"

echo ""
echo "=== prompt: resolver skips launcher copies ==="

# A second launcher copy elsewhere on PATH (shared-HOME root/sudo shells)
# must not satisfy the past-launcher scan: it carries the launcher marker.
COPY_HOME="$TEST_TMPDIR/copy-home"
COPY_REAL_BIN="$TEST_TMPDIR/copy-real-bin"
COPY_OTHER_BIN="$TEST_TMPDIR/copy-other-bin"
COPY_WRAPPER_LOG="$TEST_TMPDIR/copy-wrapper.log"
COPY_OTHER_LOG="$TEST_TMPDIR/copy-other.log"
COPY_REAL_LOG="$TEST_TMPDIR/copy-real.log"
COPY_COMMAND_LOG="$TEST_TMPDIR/copy-command.log"
mkdir -p "$COPY_HOME/.dotfiles" "$COPY_HOME/.local/bin" \
  "$COPY_HOME/.cache" "$COPY_REAL_BIN" "$COPY_OTHER_BIN"
: >"$COPY_WRAPPER_LOG"
: >"$COPY_OTHER_LOG"
: >"$COPY_REAL_LOG"
cat >"$COPY_HOME/.local/bin/git" <<'EOF'
#!/usr/bin/env bash
# Dotfiles-aware launcher for Git.
printf 'wrapper:%s\n' "$*" >>"$COPY_WRAPPER_LOG"
exec "$COPY_REAL_BIN/git" "$@"
EOF
cat >"$COPY_OTHER_BIN/git" <<'EOF'
#!/usr/bin/env bash
# Dotfiles-aware launcher for Git.
printf 'other:%s\n' "$*" >>"$COPY_OTHER_LOG"
exec "$COPY_REAL_BIN/git" "$@"
EOF
cat >"$COPY_REAL_BIN/git" <<'EOF'
#!/usr/bin/env bash
printf 'real:%s\n' "$*" >>"$COPY_REAL_LOG"
case " $* " in
  *" --no-optional-locks status --porcelain=v2 --branch "*)
    printf '%s\n' '# branch.head main' '# branch.ab +0 -0'
    ;;
  *) exit 1 ;;
esac
EOF
chmod +x "$COPY_HOME/.local/bin/git" "$COPY_OTHER_BIN/git" "$COPY_REAL_BIN/git"
COPY_PATH="$COPY_HOME/.local/bin:$COPY_OTHER_BIN:$COPY_REAL_BIN:/usr/bin:/bin"
copy_prompt=$(
  HOME="$COPY_HOME" \
    BASH_ENV='' \
    REAL_HOME="$REAL_HOME" \
    COPY_WRAPPER_LOG="$COPY_WRAPPER_LOG" \
    COPY_OTHER_LOG="$COPY_OTHER_LOG" \
    COPY_REAL_BIN="$COPY_REAL_BIN" \
    COPY_REAL_LOG="$COPY_REAL_LOG" \
    COPY_COMMAND_LOG="$COPY_COMMAND_LOG" \
    XDG_CACHE_HOME="$COPY_HOME/.cache" \
    PATH="$COPY_PATH" \
    bash --noprofile --norc -c '
      cd "$HOME" || exit 1
      # shellcheck disable=SC1091
      . "$REAL_HOME/.config/shell/interactive.d/59-prompt.sh"
      printf "%s\n" "${_DOT_GIT_PROMPT_BIN:-unset}" >"$COPY_COMMAND_LOG"
