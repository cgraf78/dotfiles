# Mirror shdeps_write_wrapper (used by the php/java hooks) onto the mocked bin
# dir: parse "[--env V]... <name> <interp> [args...] -- <payload>" and emit the
# same `exec <interp> <args...> <payload> "$@"` launcher the real helper writes.
# shellcheck disable=SC2329  # invoked indirectly by the sourced hook.
shdeps_write_wrapper() {
  local env_lines=() head=() payload="" saw_sep=0
  while [[ $# -gt 0 ]]; do
    if [[ "$saw_sep" -eq 1 ]]; then
      payload="$1"
      shift
      continue
    fi
    case "$1" in
      --env)
        env_lines+=("$2")
        shift 2
        ;;
      --)
        saw_sep=1
        shift
        ;;
      *)
        head+=("$1")
        shift
        ;;
    esac
  done
  local wrapper
  wrapper="$(shdeps_bin_dir)/${head[0]}"
  mkdir -p "$(dirname "$wrapper")"
  {
    printf '#!/usr/bin/env bash\n'
    local line
    for line in ${env_lines[@]+"${env_lines[@]}"}; do
      printf 'export %s\n' "$line"
    done
    printf 'exec'
    local token
    for token in "${head[@]:1}"; do
      printf ' %q' "$token"
    done
    printf ' %q "$@"\n' "$payload"
  } >"$wrapper"
  chmod u+x "$wrapper"
  printf '%s\n' "$wrapper"
}

