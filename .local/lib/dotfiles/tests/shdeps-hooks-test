#!/usr/bin/env bash
# shdeps-hooks-test — base-owned Shdeps declarations and custom hooks.

set -o pipefail
export NO_COLOR=1

# shellcheck source=helpers.sh disable=SC1091
. "${BASH_SOURCE[0]%/*}/helpers.sh"

REAL_HOME=$HOME
_test_prefer_system_git || exit 1

echo "=== base Shdeps ownership ==="

_base_hook_names=$(git -C "$REAL_HOME" ls-files '.config/shdeps/hooks.d/*.sh' \
  '.config/shdeps/hooks.d/**/*.sh' |
  sed -e 's#^\.config/shdeps/hooks.d/##' -e 's#\.sh$##' |
  LC_ALL=C sort)
for _base_hook in cgraf78/dot eza nerd-fonts rcaloras/bash-preexec \
  tmux tmux-plugins/tmux-resurrect wezterm xclip; do
  if grep -Fxq "$_base_hook" <<<"$_base_hook_names"; then
    _pass "Shdeps: base custom hook is retained: $_base_hook"
  else
    _fail "Shdeps: base custom hook is retained: $_base_hook"
  fi
done

# D4 intentionally retains the old capability installers until D5 removes the
# monolith. Every non-base hook must therefore be an explicitly inventoried
# temporary path, never an accidental new top-level owner.
while IFS= read -r _hook_path; do
  _base_hook=${_hook_path#.config/shdeps/hooks.d/}
  _base_hook=${_base_hook%.sh}
  grep -Fxq "$_base_hook" <<<"$(printf '%s\n' cgraf78/dot eza nerd-fonts \
    rcaloras/bash-preexec tmux tmux-plugins/tmux-resurrect wezterm xclip)" && continue
  if awk -F '\t' -v path="$_hook_path" \
    'NR > 1 && $1 == path && $5 == "keep" && $6 == "remove" { found=1 }
     END { exit found ? 0 : 1 }' \
    "$REAL_HOME/.local/share/doc/dotfiles/overlay-profile-baseline-disposition.tsv"; then
    _pass "Shdeps staging: temporary capability hook is inventoried: $_base_hook"
  else
    _fail "Shdeps staging: temporary capability hook is inventoried: $_base_hook"
  fi
done < <(git -C "$REAL_HOME" ls-files '.config/shdeps/hooks.d/*.sh' \
  '.config/shdeps/hooks.d/**/*.sh')

for _base_dependency in cgraf78/agent-rules-sync cgraf78/dot cgraf78/ds \
  cgraf78/ettun cgraf78/fwdports cgraf78/sysup cgraf78/termnav \
  cgraf78/tmux-tools tmux; do
  if awk -v dependency="$_base_dependency" '$1 == dependency { found=1 }
    END { exit found ? 0 : 1 }' "$REAL_HOME/.config/shdeps/10-deps.conf"; then
    _pass "Shdeps: base declares $_base_dependency"
  else
    _fail "Shdeps: base declares $_base_dependency"
  fi
done

for _capability_dependency in neovim/neovim cgraf78/agentguard \
  cgraf78/checkrun cgraf78/git-tools cgraf78/hive-memory cgraf78/sley \
  cgraf78/vscode-exts; do
  if awk -v dependency="$_capability_dependency" '$1 == dependency { found=1 }
    END { exit found ? 0 : 1 }' "$REAL_HOME/.config/shdeps/10-deps.conf"; then
    _pass "Shdeps staging: retained capability declaration $_capability_dependency"
  else
    _fail "Shdeps staging: retained capability declaration $_capability_dependency"
  fi
done

_eza_pkg=$(
  awk '$1 == "eza" && $2 == "pkg" { print; exit }' \
    "$REAL_HOME/.config/shdeps/10-deps.conf"
)
_assert_eq "eza: keeps native package management where available" \
  "pkg" "$(awk '{ print $2 }' <<<"$_eza_pkg")"
_assert_contains "eza: native package declaration excludes DNF" \
  "mgr:!dnf" "$_eza_pkg"
_assert_not_contains "eza: native package declaration does not rename the dependency" \
  "eza-community/eza" "$_eza_pkg"
_eza_custom=$(
  awk '$1 == "eza" && $2 == "custom" { print; exit }' \
    "$REAL_HOME/.config/shdeps/10-deps.conf"
)
_assert_eq "eza: DNF fallback preserves the manifest identity" \
  "custom" "$(awk '{ print $2 }' <<<"$_eza_custom")"
_assert_eq "eza: DNF fallback checks the eza command" \
  "eza" "$(awk '{ print $3 }' <<<"$_eza_custom")"
_assert_contains "eza: custom release fallback is limited to DNF systems" \
  "mgr:dnf" "$_eza_custom"
_assert_eq "eza: no renamed dependency competes for the command" \
  "" "$(awk '$1 == "eza-community/eza" { print }' "$REAL_HOME/.config/shdeps/10-deps.conf")"

_eza_hook="$REAL_HOME/.config/shdeps/hooks.d/eza.sh"
_assert_file_exists "eza: DNF release hook is tracked" "$_eza_hook"
if [[ -f $_eza_hook ]]; then
  _eza_install_root=$(_tmpdir)
  _eza_public_bin=$(_tmpdir)
  _eza_cargo_bin=$(_mock_bin)
  _eza_state=$(_tmpdir)
  _eza_calls=$(_tmpdir)/release-calls.log
  _eza_saved_state_dir_set=${SHDEPS_STATE_DIR+x}
  _eza_saved_state_dir=${SHDEPS_STATE_DIR:-}
  SHDEPS_STATE_DIR=$_eza_state
  export SHDEPS_STATE_DIR
  cat >"$_eza_cargo_bin/eza" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' 'v0.14.2 cargo'
EOF
  chmod +x "$_eza_cargo_bin/eza"

  # shellcheck source=/dev/null
  . "$_eza_hook"
  # shellcheck disable=SC2329  # the sourced hook invokes this public API.
  shdeps_install_dir() { printf '%s\n' "$_eza_install_root"; }
  # shellcheck disable=SC2329  # the sourced hook invokes this public API.
  shdeps_bin_dir() { printf '%s\n' "$_eza_public_bin"; }
  # shellcheck disable=SC2329  # test double for the release installer boundary.
  shdeps_github_release_install() {
    printf '%s\n' "$*" >>"$_eza_calls"
    mkdir -p "$_eza_install_root/eza/bin"
    printf '%s\n' 'v1 archive' >"$_eza_install_root/eza/.shdeps-release-layout"
    cat >"$_eza_install_root/eza/bin/eza" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' 'eza - A modern, maintained replacement for ls'
printf '%s\n' 'v0.20.24 [+git]'
EOF
    chmod +x "$_eza_install_root/eza/bin/eza"
    ln -s "$_eza_install_root/eza/bin/eza" "$_eza_public_bin/eza"
  }
  # shellcheck disable=SC2329  # test double for custom cleanup.
  shdeps_unlink_extras() { return 0; }

  _eza_saved_path=$PATH
  PATH="$_eza_cargo_bin:/usr/bin:/bin"
  if exists eza; then
    _fail "eza: an unrelated Cargo binary does not satisfy the managed release"
  else
    _pass "eza: an unrelated Cargo binary does not satisfy the managed release"
  fi
  if install eza; then
    _pass "eza: DNF hook installs the managed upstream release"
  else
    _fail "eza: DNF hook installs the managed upstream release"
  fi
  _assert_file_content "eza: release helper keeps the stable dependency identity" \
    "eza eza eza-community/eza" "$_eza_calls"
  if exists eza; then
    _pass "eza: managed release satisfies the hook"
  else
    _fail "eza: managed release satisfies the hook"
  fi
  _assert_eq "eza: version comes from the managed release" \
    "v0.20.24 [+git]" "$(version eza)"

  printf '%s\n' "$_eza_public_bin/eza" >"$_eza_state/eza.binlinks"
  uninstall eza
  _assert_file_missing "eza: uninstall removes its managed public command" \
    "$_eza_public_bin/eza"
  _assert_file_missing "eza: uninstall removes its managed release root" \
    "$_eza_install_root/eza"
  _assert_file_missing "eza: uninstall removes stale release link state" \
    "$_eza_state/eza.binlinks"

  install eza

  _eza_foreign=$(_tmpdir)/foreign-eza
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' >"$_eza_foreign"
  chmod +x "$_eza_foreign"
  rm -f "$_eza_public_bin/eza"
  ln -s "$_eza_foreign" "$_eza_public_bin/eza"
  uninstall eza
  _assert_file_exists "eza: uninstall preserves a foreign public command" \
    "$_eza_public_bin/eza"
  _assert_file_missing "eza: uninstall removes its marked release root" \
    "$_eza_install_root/eza"

  rm -f "$_eza_public_bin/eza"
  mkdir -p "$_eza_install_root/eza/bin"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' \
    >"$_eza_install_root/eza/bin/eza"
  chmod +x "$_eza_install_root/eza/bin/eza"
  ln -s "$_eza_install_root/eza/bin/eza" "$_eza_public_bin/eza"
  uninstall eza
  _assert_file_exists "eza: uninstall preserves an unmarked install root" \
    "$_eza_install_root/eza/bin/eza"
  _assert_file_exists "eza: uninstall preserves a link into an unmarked root" \
    "$_eza_public_bin/eza"

  PATH=$_eza_saved_path
  if [[ -n $_eza_saved_state_dir_set ]]; then
    SHDEPS_STATE_DIR=$_eza_saved_state_dir
    export SHDEPS_STATE_DIR
  else
    unset SHDEPS_STATE_DIR
  fi
  unset -f exists install uninstall version shdeps_bin_dir \
    shdeps_github_release_install shdeps_install_dir shdeps_unlink_extras \
    _eza_managed _eza_public_bin _eza_public_link_owned \
    _eza_release_root _eza_release_root_owned
fi

echo "=== wezterm hook ==="

_wezterm_hook="$REAL_HOME/.config/shdeps/hooks.d/wezterm.sh"
# shellcheck source=/dev/null
. "$_wezterm_hook"

# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_platform() { echo darwin; }
# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_pkg_mgr() { echo brew; }
_wezterm_brew=$(_mock_bin)
cat >"$_wezterm_brew/brew" <<'EOF'
#!/usr/bin/env bash
printf 'brew should not run in CI\n' >&2
exit 1
EOF
chmod +x "$_wezterm_brew/brew"
if CI=1 PATH="$_wezterm_brew:/usr/bin:/bin" exists "wez/wezterm"; then
  _pass "wezterm: CI satisfies GUI terminal dependency"
else
  _fail "wezterm: CI satisfies GUI terminal dependency"
fi
if CI=1 PATH="$_wezterm_brew:/usr/bin:/bin" install "wez/wezterm"; then
  _pass "wezterm: CI install path is a no-op"
else
  _fail "wezterm: CI install path is a no-op"
fi

_wezterm_calls=$(_tmpdir)/calls.log
_wezterm_mgr=dnf
_wezterm_release='centos|9'
_wezterm_machine=x86_64
_wezterm_tmp_parent=$(_tmpdir)
_wezterm_release_json='{"tag_name":"20240203-110809-5046fc22","assets":[{"browser_download_url":"https://github.com/wez/wezterm/releases/download/20240203-110809-5046fc22/wezterm-20240203_110809_5046fc22-1.centos9.x86_64.rpm"}]}'
# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_platform() { echo linux; }
# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_pkg_mgr() { echo "$_wezterm_mgr"; }
# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_require_sudo() { return 0; }
# shellcheck disable=SC2329  # hook calls this private helper by name.
_wezterm_os_release() { echo "$_wezterm_release"; }
# shellcheck disable=SC2329  # hook calls this platform command by name.
uname() { echo "$_wezterm_machine"; }
# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_warn() { printf 'warn:%s\n' "$*" >>"$_wezterm_calls"; }
# shellcheck disable=SC2329  # hook invokes the platform temporary-file helper.
mktemp() {
  printf 'mktemp:%s\n' "$*" >>"$_wezterm_calls"
  if [[ ${1:-} == -d ]]; then
    rm -rf "$_wezterm_tmp_parent/stage"
    mkdir -p "$_wezterm_tmp_parent/stage"
    printf '%s\n' "$_wezterm_tmp_parent/stage"
  else
    : >"$_wezterm_tmp_parent/extensionless"
    printf '%s\n' "$_wezterm_tmp_parent/extensionless"
  fi
}
# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_curl() {
  local arg output=""
  for arg in "$@"; do
    if [[ "$arg" == https://api.github.com/* ]]; then
      printf '%s\n' "$_wezterm_release_json"
      return 0
    fi
  done
  while (($#)); do
    if [[ "$1" == -o ]]; then
      output="$2"
      shift 2
    else
      printf 'curl:%s\n' "$1" >>"$_wezterm_calls"
      shift
    fi
  done
  if [[ -n ${_wezterm_download_fail:-} ]]; then
    return 1
  fi
  [[ -z "$output" ]] || : >"$output"
}
# shellcheck disable=SC2329  # hook invokes sudo by name.
sudo() {
  printf 'sudo:%s\n' "$*" >>"$_wezterm_calls"
  [[ -z ${_wezterm_sudo_fail:-} ]]
}
_assert_eq "wezterm: Ubuntu keeps its native release asset" \
  "Ubuntu24.04" "$(_wezterm_asset_pattern ubuntu 24.04)"
_assert_eq "wezterm: Debian keeps its native release asset" \
  "Debian12" "$(_wezterm_asset_pattern debian 12)"
_assert_eq "wezterm: Fedora keeps its native release asset" \
  "Fedora42" "$(_wezterm_asset_pattern fedora 42)"
for _wezterm_rhel_id in centos rhel rocky almalinux; do
  _assert_eq "wezterm: $_wezterm_rhel_id uses the CentOS-compatible RPM" \
    "centos9" "$(_wezterm_asset_pattern "$_wezterm_rhel_id" 9.6 2>/dev/null)"
done
if CI='' DISPLAY=:99 install "wezterm"; then
  _pass "wezterm: CentOS desktop installs the official CentOS major-version RPM"
else
  _fail "wezterm: CentOS desktop installs the official CentOS major-version RPM"
fi
_assert_contains "wezterm: CentOS desktop selects the CentOS 9 release asset" \
  "wezterm-20240203_110809_5046fc22-1.centos9.x86_64.rpm" \
  "$(cat "$_wezterm_calls" 2>/dev/null)"
_assert_contains "wezterm: CentOS stages an RPM filename for DNF" \
  "sudo:dnf install -y $_wezterm_tmp_parent/stage/wezterm.rpm" \
  "$(cat "$_wezterm_calls")"
_assert_file_missing "wezterm: CentOS removes its package staging directory" \
  "$_wezterm_tmp_parent/stage"

_wezterm_sudo_fail=1
: >"$_wezterm_calls"
if CI='' DISPLAY=:99 install "wezterm"; then
  _fail "wezterm: failed DNF install remains visible"
else
  _pass "wezterm: failed DNF install remains visible"
fi
unset _wezterm_sudo_fail
_assert_file_missing "wezterm: failed DNF install removes its staging directory" \
  "$_wezterm_tmp_parent/stage"

_wezterm_download_fail=1
: >"$_wezterm_calls"
if CI='' DISPLAY=:99 install "wezterm"; then
  _fail "wezterm: failed RPM download remains visible"
else
  _pass "wezterm: failed RPM download remains visible"
fi
unset _wezterm_download_fail
_assert_file_missing "wezterm: failed RPM download removes its staging directory" \
  "$_wezterm_tmp_parent/stage"
_assert_not_contains "wezterm: failed RPM download does not invoke DNF" \
  "sudo:" "$(cat "$_wezterm_calls")"

# shellcheck disable=SC2329  # hook invokes the platform cleanup command.
rm() {
  local arg last=""
  for arg in "$@"; do
    last=$arg
  done
  if [[ -n ${_wezterm_cleanup_fail:-} && $last == "$_wezterm_tmp_parent/stage" ]]; then
    return 1
  fi
  command rm "$@"
}
_wezterm_download_fail=1
_wezterm_cleanup_fail=1
: >"$_wezterm_calls"
if CI='' DISPLAY=:99 install "wezterm"; then
  _fail "wezterm: failed download and cleanup remains visible"
else
  _pass "wezterm: failed download and cleanup remains visible"
fi
unset _wezterm_download_fail _wezterm_cleanup_fail
_assert_contains "wezterm: failed download reports staging cleanup failure" \
  "failed to clean up wezterm package staging directory" \
  "$(cat "$_wezterm_calls")"
unset -f rm
command rm -rf "$_wezterm_tmp_parent/stage"

_wezterm_mgr=apt
_wezterm_release='ubuntu|22.04'
_wezterm_release_json='{"tag_name":"20240203-110809-5046fc22","assets":[{"browser_download_url":"https://github.com/wez/wezterm/releases/download/20240203-110809-5046fc22/wezterm-20240203_110809_5046fc22-1.Ubuntu22.04.arm64.deb"},{"browser_download_url":"https://github.com/wez/wezterm/releases/download/20240203-110809-5046fc22/wezterm-20240203_110809_5046fc22-1.Ubuntu22.04.deb"}]}'
_wezterm_machine=x86_64
: >"$_wezterm_calls"
if CI='' DISPLAY=:99 install "wezterm"; then
  _pass "wezterm: x86_64 Debian-family desktop installs a native asset"
else
  _fail "wezterm: x86_64 Debian-family desktop installs a native asset"
fi
_assert_contains "wezterm: x86_64 Debian-family desktop selects the generic amd64 package" \
  "wezterm-20240203_110809_5046fc22-1.Ubuntu22.04.deb" \
  "$(cat "$_wezterm_calls")"
_assert_not_contains "wezterm: x86_64 Debian-family desktop rejects the ARM package" \
  ".Ubuntu22.04.arm64.deb" "$(cat "$_wezterm_calls")"
_assert_contains "wezterm: Debian stages a DEB filename for dpkg" \
  "sudo:dpkg -i $_wezterm_tmp_parent/stage/wezterm.deb" \
  "$(cat "$_wezterm_calls")"
_assert_file_missing "wezterm: Debian removes its package staging directory" \
  "$_wezterm_tmp_parent/stage"

_wezterm_machine=aarch64
: >"$_wezterm_calls"
if CI='' DISPLAY=:99 install "wezterm"; then
  _pass "wezterm: ARM Debian-family desktop installs a native asset"
else
  _fail "wezterm: ARM Debian-family desktop installs a native asset"
fi
_assert_contains "wezterm: ARM Debian-family desktop selects the arm64 package" \
  ".Ubuntu22.04.arm64.deb" "$(cat "$_wezterm_calls")"

_wezterm_mgr=dnf
_wezterm_release='centos|9'
_wezterm_release_json='{"tag_name":"20240203-110809-5046fc22","assets":[{"browser_download_url":"https://github.com/wez/wezterm/releases/download/20240203-110809-5046fc22/wezterm-20240203_110809_5046fc22-1.centos9.x86_64.rpm"}]}'
: >"$_wezterm_calls"
if CI='' DISPLAY=:99 install "wezterm"; then
  _fail "wezterm: ARM RHEL-family desktop rejects x86_64-only releases"
else
  _pass "wezterm: ARM RHEL-family desktop rejects x86_64-only releases"
fi
_assert_not_contains "wezterm: ARM RHEL-family desktop does not download the x86_64 RPM" \
  "curl:https://github.com/wez/wezterm/releases/download/20240203-110809-5046fc22/wezterm-20240203_110809_5046fc22-1.centos9.x86_64.rpm" \
  "$(cat "$_wezterm_calls")"

unset -f exists version install mktemp shdeps_platform shdeps_pkg_mgr \
  shdeps_require_sudo shdeps_curl shdeps_warn sudo uname \
  _wezterm_arch _wezterm_asset_pattern _wezterm_os_release \
  _wezterm_select_asset

echo "=== xclip hook ==="

_xclip_hook="$REAL_HOME/.config/shdeps/hooks.d/xclip.sh"
# shellcheck source=/dev/null
. "$_xclip_hook"
_xclip_calls=$(_tmpdir)/calls.log
# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_pkg_mgr() { echo dnf; }
# shellcheck disable=SC2329  # hook calls this public shdeps API by name.
shdeps_require_sudo() { return 0; }
# shellcheck disable=SC2329  # hook calls this platform command by name.
uname() { echo Linux; }
# shellcheck disable=SC2329  # hook invokes sudo by name.
sudo() { printf 'sudo:%s\n' "$*" >>"$_xclip_calls"; }
if DISPLAY=:99 install "xclip"; then
  _pass "xclip: graphical DNF session installs the package"
else
  _fail "xclip: graphical DNF session installs the package"
fi
_assert_file_content "xclip: graphical DNF session uses dnf" \
  "sudo:dnf install -y xclip" "$_xclip_calls"
if DISPLAY='' install "xclip"; then
  _pass "xclip: headless Linux session remains skipped"
else
  _fail "xclip: headless Linux session remains skipped"
fi
_assert_file_content "xclip: headless Linux does not invoke dnf" \
  "sudo:dnf install -y xclip" "$_xclip_calls"
# shellcheck disable=SC2329  # hook calls this platform command by name.
uname() { echo Darwin; }
if DISPLAY=:99 install "xclip"; then
  _pass "xclip: macOS remains outside the Linux-only hook"
else
  _fail "xclip: macOS remains outside the Linux-only hook"
fi
_assert_file_content "xclip: macOS does not invoke dnf" \
  "sudo:dnf install -y xclip" "$_xclip_calls"

unset -f exists version install shdeps_pkg_mgr shdeps_require_sudo sudo uname \
  _xclip_applicable

echo "=== eza stable-identity transition ==="

if [[ -f $_eza_hook ]] &&
  _test_prepare_shdeps_snapshot "$REAL_HOME" "${DOT_TEST_HOST_HOME:-}"; then
  _eza_transition_home=$(_tmpdir)
  _eza_transition_conf=$_eza_transition_home/conf
  _eza_transition_hooks=$_eza_transition_conf/hooks.d
  _eza_transition_state=$_eza_transition_home/state
  _eza_transition_install=$_eza_transition_home/share
  _eza_transition_bin=$_eza_transition_home/bin
  _eza_transition_tools=$(_mock_bin)
  _eza_transition_apt_tools=$(_mock_bin)
  mkdir -p \
    "$_eza_transition_hooks" \
    "$_eza_transition_state" \
    "$_eza_transition_install/eza/bin" \
    "$_eza_transition_bin"

  printf '%s\n' \
    'eza pkg eza - mgr:!dnf' \
    'eza custom eza - mgr:dnf' \
    >"$_eza_transition_conf/deps.conf"
  ln -s "$_eza_hook" "$_eza_transition_hooks/eza.sh"
  printf '%s\n' 'eza|pkg|eza|' >"$_eza_transition_state/manifest"
  printf '%s\n' 'v1 archive' \
    >"$_eza_transition_install/eza/.shdeps-release-layout"
  cat >"$_eza_transition_install/eza/bin/eza" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' 'eza - A modern, maintained replacement for ls'
printf '%s\n' 'v0.20.24 [+git]'
EOF
  chmod +x "$_eza_transition_install/eza/bin/eza"
  ln -s "$_eza_transition_install/eza/bin/eza" \
    "$_eza_transition_bin/eza"
  for _eza_transition_tool in awk bash hostname readlink uname; do
    ln -s "$(command -v "$_eza_transition_tool")" \
      "$_eza_transition_tools/$_eza_transition_tool"
    ln -s "$(command -v "$_eza_transition_tool")" \
      "$_eza_transition_apt_tools/$_eza_transition_tool"
  done
  ln -s "$SHDEPS_RUST_CLI" "$_eza_transition_tools/shdeps"
  ln -s "$SHDEPS_RUST_CLI" "$_eza_transition_apt_tools/shdeps"
  ln -s "$_eza_transition_install/eza/bin/eza" \
    "$_eza_transition_apt_tools/eza"
  cat >"$_eza_transition_tools/dnf" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
  chmod +x "$_eza_transition_tools/dnf"
  cat >"$_eza_transition_apt_tools/apt-get" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
  cat >"$_eza_transition_apt_tools/dpkg-query" <<'EOF'
#!/usr/bin/env bash
printf 'install ok installed\teza\t0.20.24\n'
