  fi
  _assert_file_content "tmux: failed install preserves prior payload" \
    "previous managed payload" "$_tmux_install/tmux/tmux-builds/sentinel"
  _assert_eq "tmux: failed install leaves no staging directories" \
    "" "$(printf '%s\n' "$_tmux_install/tmux"/.tmux-stage.* | sed "/[*]/d")"

  uninstall tmux
  if [[ ! -e $_tmux_install/tmux/tmux-builds &&
    ! -L $_tmux_install/tmux/tmux-builds ]]; then
    _pass "tmux: uninstall removes only the managed payload"
