#!/usr/bin/env bash
# shdeps-hooks-test — unit tests for dotfiles-specific shdeps custom hooks.
#
# shdeps itself owns the generic dependency installer tests. This file covers
# subtle behavior in hook glue where dotfiles choose fallback tools and wrap
# externally managed executables.

set -o pipefail
export NO_COLOR=1

# shellcheck source=helpers.sh disable=SC1091
. "${BASH_SOURCE[0]%/*}/helpers.sh"

REAL_HOME="$HOME"
_test_prefer_system_git || exit 1

echo "=== shdeps hook policy ==="

_release_helpers=$(
  rg -l 'shdeps_github_release_install' "$REAL_HOME/.config/shdeps/hooks.d" |
    sed "\|^$REAL_HOME/.config/shdeps/hooks.d/neovim/neovim.sh$|d" || true
)
_assert_eq "custom hooks do not hide native github:release update policy" \
  "" "$_release_helpers"
_assert_not_contains "tree-sitter: no upstream release binary on Linux" \
  "tree-sitter/tree-sitter                   github:release" \
  "$(cat "$REAL_HOME/.config/shdeps/10-deps.conf")"

_gitleaks_dep=$(
  awk '$1 == "gitleaks/gitleaks" { print; exit }' \
    "$REAL_HOME/.config/shdeps/10-deps.conf"
)
_assert_eq "gitleaks: Linux requires a release binary" \
  "github:release" "$(awk '{ print $2 }' <<<"$_gitleaks_dep")"
_assert_eq "gitleaks: release matching uses the executable name" \
  "gitleaks" "$(awk '{ print $3 }' <<<"$_gitleaks_dep")"
_assert_contains "gitleaks: upstream release excludes Android" \
  "os:!macos,os:!android" "$_gitleaks_dep"

_tree_sitter_dep=$(
  awk '$1 == "tree-sitter-cli" && $2 == "pkg" { print; exit }' \
    "$REAL_HOME/.config/shdeps/10-deps.conf"
)
_assert_eq "tree-sitter: uses package manager instead of release binary" \
  "pkg" "$(awk '{ print $2 }' <<<"$_tree_sitter_dep")"
_assert_eq "tree-sitter: command maps to tree-sitter" \
  "tree-sitter" "$(awk '{ print $3 }' <<<"$_tree_sitter_dep")"
_assert_contains "tree-sitter: package aliases cover apt" \
  "apt:tree-sitter-cli" "$_tree_sitter_dep"
_assert_contains "tree-sitter: package aliases cover dnf" \
  "dnf:tree-sitter-cli" "$_tree_sitter_dep"
_assert_contains "tree-sitter: package aliases cover pacman" \
  "pacman:tree-sitter-cli" "$_tree_sitter_dep"
_assert_contains "tree-sitter: package aliases cover zypper" \
  "zypper:tree-sitter-cli" "$_tree_sitter_dep"
_assert_contains "tree-sitter: package aliases cover apk" \
  "apk:tree-sitter-cli" "$_tree_sitter_dep"
_assert_contains "tree-sitter: Homebrew uses formula name" \
  "brew:tree-sitter" "$_tree_sitter_dep"
_assert_contains "tree-sitter: Termux uses native package name" \
  "android:tree-sitter" "$_tree_sitter_dep"

_clippy_dep=$(
  awk '$1 == "clippy" && $2 == "pkg" { print; exit }' \
    "$REAL_HOME/.config/shdeps/00-toolchains.conf"
)
_assert_eq "clippy: uses package manager instead of cargo install" \
  "pkg" "$(awk '{ print $2 }' <<<"$_clippy_dep")"
_assert_eq "clippy: command check uses cargo subcommand binary" \
  "cargo-clippy" "$(awk '{ print $3 }' <<<"$_clippy_dep")"
_assert_contains "clippy: Debian package name is rust-clippy" \
  "apt:rust-clippy" "$_clippy_dep"
_assert_not_contains "clippy: Debian package name is not the command name" \
  "apt:cargo-clippy" "$_clippy_dep"
_assert_contains "clippy: Alpine package name is rust-clippy" \
  "apk:rust-clippy" "$_clippy_dep"
_assert_contains "clippy: Arch package bundles clippy with rust" \
  "pacman:rust" "$_clippy_dep"
_assert_contains "clippy: Homebrew formula bundles clippy with rust" \
  "brew:rust" "$_clippy_dep"
_assert_contains "clippy: Termux rust package bundles clippy" \
  "android:rust" "$_clippy_dep"
_assert_contains "rust-src: Termux rust package bundles sources" \
  "android:rust" \
  "$(awk '$1 == "rust-src" && $2 == "pkg" { print; exit }' "$REAL_HOME/.config/shdeps/00-toolchains.conf")"

echo "=== Python toolchain hook ==="

_python_dep=$(
  awk '$1 == "python" { print; exit }' \
    "$REAL_HOME/.config/shdeps/00-toolchains.conf"
)
_assert_eq "python: shared interpreter uses the system package manager" \
  "pkg" "$(awk '{ print $2 }' <<<"$_python_dep")"
_assert_eq "python: package preparation leaves command ownership to policy" \
  "-" "$(awk '{ print $3 }' <<<"$_python_dep")"
_assert_contains "python: Debian installs the shared python3 package" \
  "apt:python3" "$_python_dep"

_python_minimum_dep=$(
  awk '$1 == "python-minimum" { print; exit }' \
    "$REAL_HOME/.config/shdeps/00-toolchains.conf"
)
_assert_eq "python: minimum-version policy runs after package installation" \
  "custom" "$(awk '{ print $2 }' <<<"$_python_minimum_dep")"
_assert_eq "python: minimum-version policy checks the selected python3" \
  "python3" "$(awk '{ print $3 }' <<<"$_python_minimum_dep")"
_assert_eq "python: exactly one dependency owns the public python3 command" \
  "1" \
  "$(awk '$3 == "python3" { count++ } END { print count + 0 }' \
    "$REAL_HOME/.config/shdeps/00-toolchains.conf")"

_python_hook="$REAL_HOME/.config/shdeps/hooks.d/python-minimum.sh"
_assert_file_exists "python: custom hook is tracked" "$_python_hook"
if [[ -f $_python_hook ]]; then
  _python_saved_shdeps_bin_dir=$(declare -f shdeps_bin_dir 2>/dev/null || true)
  _python_saved_shdeps_install_dir=$(declare -f shdeps_install_dir 2>/dev/null || true)
  _python_saved_shdeps_pkg_install_for_mgr=$(
    declare -f shdeps_pkg_install_for_mgr 2>/dev/null || true
  )
  _python_saved_shdeps_platform_match=$(
    declare -f shdeps_platform_match 2>/dev/null || true
  )
  _python_saved_shdeps_warn=$(declare -f shdeps_warn 2>/dev/null || true)
  # shellcheck source=/dev/null
  . "$_python_hook"

  _python_bin=$(_mock_bin)
  _python_calls=$(_tmpdir)/calls.log
  cat >"$_python_bin/python3" <<'EOF'
#!/bin/bash
printf 'python3:%s\n' "$*" >>"$PYTHON_TEST_CALLS"
case "${1:-}" in
  --version)
    printf 'Python %s\n' "$PYTHON_TEST_VERSION"
    ;;
  -I)
    [[ ${2:-} == -S && ${3:-} == -c ]] || exit 2
    major=${PYTHON_TEST_VERSION%%.*}
    rest=${PYTHON_TEST_VERSION#*.}
    minor=${rest%%.*}
    if [[ $major -gt 3 || $major -eq 3 && $minor -ge 11 ]]; then
      exit 0
    fi
    exit 1
    ;;
  *) exit 2 ;;
esac
EOF
  chmod +x "$_python_bin/python3"

  _python_saved_path=$PATH
  export PYTHON_TEST_CALLS=$_python_calls
  export PYTHON_TEST_VERSION=3.10.14
  PATH="$_python_bin:$_python_saved_path"
  if exists python; then
    _fail "python: 3.10 does not satisfy the toolchain floor"
  else
    _pass "python: 3.10 does not satisfy the toolchain floor"
  fi
  export PYTHON_TEST_VERSION=3.11.0
  if exists python; then
    _pass "python: 3.11 satisfies the toolchain floor"
  else
    _fail "python: 3.11 satisfies the toolchain floor"
  fi
  export PYTHON_TEST_VERSION=3.14.2
  if exists python; then
    _pass "python: newer versions remain accepted"
  else
    _fail "python: newer versions remain accepted"
  fi
  _assert_contains "python: version probe encodes the 3.11 floor" \
    "sys.version_info >= (3, 11)" "$(cat "$_python_calls")"
  _assert_eq "python: status reports the selected interpreter version" \
    "Python 3.14.2" "$(version python)"

  PATH=$_python_saved_path
  _python_system_bin=$(_mock_bin)
  _python_public_bin=$(_tmpdir)
  _python_install_root=$(_tmpdir)
  _python_brew_prefix=$(_tmpdir)
  mkdir -p "$_python_brew_prefix/bin"
  _python_tools=$(_mock_bin)
  for _python_tool in bash cat chmod env ln mkdir mv readlink rm rmdir; do
    ln -s "$(command -v "$_python_tool")" "$_python_tools/$_python_tool"
  done
  _python_package_calls=$(_tmpdir)/package-calls.log
  _python_warnings=$(_tmpdir)/warnings.log
  cat >"$_python_system_bin/python3" <<'EOF'
#!/bin/bash
case "${1:-}" in
  --version) printf 'Python 3.10.14\n' ;;
  -I) exit 1 ;;
  *) exit 2 ;;
esac
EOF
  chmod +x "$_python_system_bin/python3"
  cat >"$_python_system_bin/brew" <<'EOF'
#!/bin/bash
[[ $* == "--prefix python@3.12" ]] || exit 2
printf '%s\n' "$PYTHON_TEST_BREW_PREFIX"
EOF
  chmod +x "$_python_system_bin/brew"
  export PYTHON_TEST_BREW_PREFIX=$_python_brew_prefix
  # shellcheck disable=SC2329  # the sourced hook invokes this public API.
  shdeps_platform_match() { return 1; }
  # shellcheck disable=SC2329  # the sourced hook invokes this public API.
  shdeps_pkg_install_for_mgr() {
    printf '%s\n' "$*" >>"$_python_package_calls"
    cat >"$PYTHON_TEST_BREW_PREFIX/bin/python3.12" <<'PYTHON'
#!/bin/bash
case "${1:-}" in
  --version) printf 'Python 3.12.99\n' ;;
  -I) [[ ${2:-} == -S && ${3:-} == -c ]] ;;
  *) exit 2 ;;
esac
PYTHON
    chmod +x "$PYTHON_TEST_BREW_PREFIX/bin/python3.12"
  }
  # shellcheck disable=SC2329  # the sourced hook invokes this public API.
  shdeps_bin_dir() { printf '%s\n' "$_python_public_bin"; }
  # shellcheck disable=SC2329  # the sourced hook invokes this public API.
  shdeps_install_dir() { printf '%s\n' "$_python_install_root"; }
  # shellcheck disable=SC2329  # the sourced hook invokes this public API.
  shdeps_warn() { printf '%s\n' "$*" >>"$_python_warnings"; }

  PATH="$_python_public_bin:$_python_system_bin:$_python_tools"
  if install python-minimum; then
    _pass "python: native versioned package satisfies the minimum"
  else
    _fail "python: native versioned package satisfies the minimum"
  fi
  _assert_contains "python: native fallback covers Debian and Ubuntu" \
    "apt:python3.11-venv" "$(cat "$_python_package_calls")"
  _assert_contains "python: native fallback covers Red Hat-family systems" \
    "dnf:python3.11" "$(cat "$_python_package_calls")"
  _assert_contains "python: native fallback covers Homebrew" \
    "brew:python@3.12" "$(cat "$_python_package_calls")"
  _assert_file_exists "python: native fallback creates a tiny managed wrapper" \
    "$_python_install_root/python-minimum/python3"
  _assert_eq "python: public python3 selects the managed wrapper" \
    "$_python_install_root/python-minimum/python3" \
    "$(readlink "$_python_public_bin/python3")"
  _assert_eq "python: native fallback reports the shared interpreter" \
    "Python 3.12.99" "$(version python-minimum)"

  uninstall python-minimum
  _assert_file_missing "python: uninstall removes only the managed public wrapper" \
    "$_python_public_bin/python3"
  _assert_file_exists "python: uninstall leaves the shared system interpreter" \
    "$_python_brew_prefix/bin/python3.12"

  PATH=$_python_saved_path
  _python_uv_bin=$(_mock_bin)
  _python_uv_public_bin=$(_tmpdir)
  _python_uv_install_root=$(_tmpdir)
  cat >"$_python_uv_bin/python3" <<'EOF'
#!/bin/bash
case "${1:-}" in
  --version) printf 'Python 3.10.14\n' ;;
  -I) exit 1 ;;
  *) exit 2 ;;
esac
EOF
  chmod +x "$_python_uv_bin/python3"
  cat >"$_python_uv_bin/uv" <<'EOF'
#!/bin/bash
printf 'uv:%s\n' "$*" >>"$PYTHON_TEST_CALLS"
[[ $* == "python install --default --upgrade 3.12" ]] || exit 2
cat >"$PYTHON_TEST_PUBLIC_BIN/python3" <<'PYTHON'
#!/bin/bash
case "${1:-}" in
  --version) printf 'Python 3.12.99\n' ;;
  -I) [[ ${2:-} == -S && ${3:-} == -c ]] ;;
  *) exit 2 ;;
esac
PYTHON
chmod +x "$PYTHON_TEST_PUBLIC_BIN/python3"
EOF
  chmod +x "$_python_uv_bin/uv"
  export PYTHON_TEST_PUBLIC_BIN=$_python_uv_public_bin
  # shellcheck disable=SC2329  # the sourced hook invokes this public API.
  shdeps_pkg_install_for_mgr() {
    printf '%s\n' "$*" >>"$_python_package_calls"
    return 1
  }
  # shellcheck disable=SC2329  # the sourced hook invokes this public API.
  shdeps_bin_dir() { printf '%s\n' "$_python_uv_public_bin"; }
  # shellcheck disable=SC2329  # the sourced hook invokes this public API.
  shdeps_install_dir() { printf '%s\n' "$_python_uv_install_root"; }
  PATH="$_python_uv_public_bin:$_python_uv_bin:$_python_tools"
  if install python-minimum; then
    _pass "python: uv fallback installs a supported interpreter"
  else
    _fail "python: uv fallback installs a supported interpreter"
  fi
  PATH=$_python_saved_path
  _assert_contains "python: uv fallback selects the maintained 3.12 line" \
    "uv:python install --default --upgrade 3.12" "$(cat "$_python_calls")"

  _python_empty_bin=$(_mock_bin)
  # shellcheck disable=SC2329  # the sourced hook invokes this public API.
  shdeps_bin_dir() { printf '%s\n' "$_python_public_bin"; }
  # shellcheck disable=SC2329  # the sourced hook invokes this public API.
  shdeps_install_dir() { printf '%s\n' "$_python_install_root"; }
  PATH=$_python_empty_bin
  if install python-minimum; then
    _fail "python: missing uv fails visibly"
  else
    _pass "python: missing uv fails visibly"
  fi
  PATH=$_python_saved_path
  _assert_contains "python: missing uv diagnostic is actionable" \
    "uv is unavailable" "$(cat "$_python_warnings")"

  unset PYTHON_TEST_BREW_PREFIX PYTHON_TEST_CALLS PYTHON_TEST_PUBLIC_BIN \
    PYTHON_TEST_VERSION
  unset -f exists install uninstall version shdeps_warn shdeps_bin_dir \
    shdeps_install_dir shdeps_pkg_install_for_mgr shdeps_platform_match \
    _python_expose _python_install_system _python_supported \
    _python_supported_alternate _python_supported_path
  [[ -z $_python_saved_shdeps_bin_dir ]] ||
    eval "$_python_saved_shdeps_bin_dir"
  [[ -z $_python_saved_shdeps_install_dir ]] ||
    eval "$_python_saved_shdeps_install_dir"
  [[ -z $_python_saved_shdeps_pkg_install_for_mgr ]] ||
    eval "$_python_saved_shdeps_pkg_install_for_mgr"
  [[ -z $_python_saved_shdeps_platform_match ]] ||
    eval "$_python_saved_shdeps_platform_match"
  [[ -z $_python_saved_shdeps_warn ]] || eval "$_python_saved_shdeps_warn"
  _assert_eq "python: restores the shared platform helper" \
    "$_python_saved_shdeps_platform_match" \
    "$(declare -f shdeps_platform_match 2>/dev/null || true)"
  if declare -f _python_supported_path &>/dev/null; then
    _fail "python: test cleanup removes every private hook helper"
  else
    _pass "python: test cleanup removes every private hook helper"
  fi
  unset _python_saved_shdeps_bin_dir _python_saved_shdeps_install_dir \
    _python_saved_shdeps_pkg_install_for_mgr \
    _python_saved_shdeps_platform_match _python_saved_shdeps_warn
fi

echo "=== cmake-language-server retirement hook ==="

_cmake_language_server_hook="$REAL_HOME/.config/shdeps/hooks.d/cmake-language-server.sh"
# shellcheck source=/dev/null
. "$_cmake_language_server_hook"

_cmake_language_server_bin=$(_mock_bin)
_cmake_language_server_calls=$(_tmpdir)/calls.log
cat >"$_cmake_language_server_bin/uv" <<'EOF'
#!/usr/bin/env bash
printf 'uv:%s\n' "$*" >>"$CMAKE_LANGUAGE_SERVER_TEST_CALLS"
EOF
chmod +x "$_cmake_language_server_bin/uv"

_cmake_language_server_saved_path=$PATH
PATH="$_cmake_language_server_bin:/usr/bin:/bin"
export CMAKE_LANGUAGE_SERVER_TEST_CALLS="$_cmake_language_server_calls"

_cmake_language_server_active_lifecycle=
for _cmake_language_server_function in exists version install post; do
  if declare -F "$_cmake_language_server_function" >/dev/null; then
    _cmake_language_server_active_lifecycle=$_cmake_language_server_function
    break
  fi
done
if [[ -z $_cmake_language_server_active_lifecycle ]]; then
  _pass "cmake-language-server: retirement hook exposes no active lifecycle"
else
  _fail "cmake-language-server: retirement hook exposes no active lifecycle"
fi
_assert_exit "cmake-language-server: retirement hook rejects another dependency" \
  1 "$(
    uninstall another-tool >/dev/null 2>&1
    printf '%s' "$?"
  )"
_assert_exit "cmake-language-server: retirement hook removes the legacy uv tool" \
  0 "$(
    uninstall cmake-language-server >/dev/null 2>&1
    printf '%s' "$?"
  )"
_assert_file_content "cmake-language-server: retirement uses the uv inventory owner" \
  "uv:tool uninstall cmake-language-server" "$_cmake_language_server_calls"
PATH=$_cmake_language_server_saved_path
unset CMAKE_LANGUAGE_SERVER_TEST_CALLS
unset -f exists version install uninstall
unset _cmake_language_server_active_lifecycle _cmake_language_server_function

_assert_contains "uv: Termux uses the native package" \
  "os:macos,os:android" \
  "$(awk '$1 == "uv" && $2 == "pkg" { print; exit }' "$REAL_HOME/.config/shdeps/00-toolchains.conf")"
_assert_contains "uv: upstream release checkout excludes Android" \
  "os:!macos,os:!android" \
  "$(awk '$1 == "astral-sh/uv" { print; exit }' "$REAL_HOME/.config/shdeps/00-toolchains.conf")"

_assert_contains "bat: Termux command keeps the native binary name" \
  "android:bat,apt:batcat" \
  "$(awk '$1 == "bat" && $2 == "pkg" { print; exit }' "$REAL_HOME/.config/shdeps/10-deps.conf")"

_ast_grep_pkg=$(
  awk '$1 == "ast-grep" && $2 == "pkg" { print; exit }' \
    "$REAL_HOME/.config/shdeps/10-deps.conf"
)
_assert_eq "ast-grep: prefers native package managers" \
  "pkg" "$(awk '{ print $2 }' <<<"$_ast_grep_pkg")"
_assert_eq "ast-grep: package check uses the upstream command" \
  "ast-grep" "$(awk '{ print $3 }' <<<"$_ast_grep_pkg")"
for _ast_grep_native_pkg in brew pacman; do
  _assert_contains "ast-grep: $_ast_grep_native_pkg uses the native package" \
    "$_ast_grep_native_pkg:ast-grep" "$_ast_grep_pkg"
done
_assert_contains "ast-grep: native route is limited to package catalogs that carry it" \
  "mgr:brew,mgr:pacman" "$_ast_grep_pkg"

_ast_grep_release=$(
  awk '$1 == "ast-grep/ast-grep" && $2 == "github:release" { print; exit }' \
    "$REAL_HOME/.config/shdeps/10-deps.conf"
)
_assert_eq "ast-grep: fallback uses the official release archive" \
  "github:release" "$(awk '{ print $2 }' <<<"$_ast_grep_release")"
_assert_contains "ast-grep: release fallback excludes unsupported and native-package targets" \
  "mgr:!brew,mgr:!pacman,mgr:!apk,os:!android" "$_ast_grep_release"

_duckdb_pkg=$(
  awk '$1 == "duckdb" && $2 == "pkg" { print; exit }' \
    "$REAL_HOME/.config/shdeps/10-deps.conf"
)
_assert_eq "duckdb: prefers native package managers" \
  "pkg" "$(awk '{ print $2 }' <<<"$_duckdb_pkg")"
_assert_eq "duckdb: package check uses the upstream command" \
  "duckdb" "$(awk '{ print $3 }' <<<"$_duckdb_pkg")"
for _duckdb_native_pkg in brew pacman; do
  _assert_contains "duckdb: $_duckdb_native_pkg uses the native package" \
    "$_duckdb_native_pkg:duckdb" "$_duckdb_pkg"
done
_assert_contains "duckdb: native route is limited to package catalogs that carry it" \
  "mgr:brew,mgr:pacman" "$_duckdb_pkg"

_duckdb_release=$(
  awk '$1 == "duckdb/duckdb" && $2 == "github:release" { print; exit }' \
    "$REAL_HOME/.config/shdeps/10-deps.conf"
)
_assert_eq "duckdb: fallback uses the official release archive" \
  "github:release" "$(awk '{ print $2 }' <<<"$_duckdb_release")"
_assert_contains "duckdb: release fallback excludes Android and native-package targets" \
  "mgr:!brew,mgr:!pacman,os:!android" "$_duckdb_release"

_bpftrace_deps=$(
  awk '$1 ~ /(^|\/)bpftrace$/ || \
    $3 ~ /(^|,)([^,:]+:)?bpftrace(,|$)/ { print }' \
    "$REAL_HOME/.config/shdeps/"*.conf
)
_assert_eq "bpftrace: dependency stays disabled" "" "$_bpftrace_deps"

_neocmakelsp_deps=$(
  awk '$1 == "Decodetalkers/neocmakelsp" || \
    $1 == "neocmakelsp/neocmakelsp" || \
    ($1 == "neocmakelsp" && $2 != "pkg") { print }' \
    "$REAL_HOME/.config/shdeps/10-deps.conf"
)
_assert_eq "neocmakelsp: shdeps has no competing release provider" "" "$_neocmakelsp_deps"

_mise_config=$(cat "$REAL_HOME/.config/mise/config.toml")
_assert_contains "neocmakelsp: mise uses the current upstream release provider" \
  '"github:neocmakelsp/neocmakelsp" = { version = "latest", os = ["linux"] }' \
  "$_mise_config"
_assert_contains "neocmakelsp: macOS keeps the native package provider" \
  "os:macos" \
  "$(awk '$1 == "neocmakelsp" && $2 == "pkg" { print }' "$REAL_HOME/.config/shdeps/10-deps.conf")"
_mise_lock=$(cat "$REAL_HOME/.config/mise/mise.lock")
_assert_contains "neocmakelsp: tracked lock records the release provider" \
  '[[tools."github:neocmakelsp/neocmakelsp"]]' "$_mise_lock"
_assert_contains "neocmakelsp: tracked lock pins the release backend" \
  'backend = "github:neocmakelsp/neocmakelsp"' "$_mise_lock"

_superhtml_deps=$(awk '$1 == "superhtml" { print }' "$REAL_HOME/.config/shdeps/10-deps.conf")
_assert_contains "superhtml: macOS keeps the native package provider" \
  "os:macos" "$_superhtml_deps"
_assert_contains "superhtml: mise uses the release provider on Linux" \
  '"github:kristoff-it/superhtml" = { version = "latest", os = ["linux"] }' \
  "$_mise_config"
_assert_not_contains "superhtml: deprecated ubi provider is retired" \
  '"ubi:kristoff-it/superhtml"' "$_mise_config"
_assert_contains "superhtml: tracked lock records the release provider" \
  '[[tools."github:kristoff-it/superhtml"]]' "$_mise_lock"
_assert_not_contains "superhtml: tracked lock retires the UBI provider" \
  '[[tools."ubi:kristoff-it/superhtml"]]' "$_mise_lock"

_cmake_language_server_dep=$(
  awk '$1 == "cmake-language-server" { print }' \
    "$REAL_HOME/.config/shdeps/10-deps.conf"
)
_assert_eq "cmake-language-server: stale shdeps provider is retired" \
  "" "$_cmake_language_server_dep"
_assert_file_exists "cmake-language-server: prune keeps a retirement hook" \
  "$REAL_HOME/.config/shdeps/hooks.d/cmake-language-server.sh"

for _termux_native in difftastic direnv dust gum lazygit mise yq; do
