#!/usr/bin/env bash
# Detach a disposable CI checkout to the exact event-selected candidate commit.

set -euo pipefail

root=$(cd -P -- "${BASH_SOURCE[0]%/*}/../../../.." && pwd -P)
candidate_sha=${DOTFILES_CANDIDATE_SHA:-}
lock=$root/.github/overlay-profile-stack.lock

stack_value() {
  local key=$1
  awk -F= -v key="$key" '$1 == key { count++; value=$2 } END {
    if (count == 1) print value; else exit 1
  }' "$lock"
}

verify_d5_pull_request_base() {
  local base_ref base_sha event_ref event_sha commit merge_base

  base_ref=$(stack_value dotfiles_d4_base_ref 2>/dev/null || true)
  base_sha=$(stack_value dotfiles_d4_base 2>/dev/null || true)
  if [[ -z $base_ref && -z $base_sha ]]; then
    return 0
  fi
  [[ -n $base_ref && -n $base_sha && $base_sha =~ ^[0-9a-f]{40}$ ]] || {
    printf 'checkout-ci-candidate: invalid D5 base lock\n' >&2
    return 1
  }
  git check-ref-format --branch "$base_ref" >/dev/null 2>&1 || {
    printf 'checkout-ci-candidate: invalid D5 base ref: %s\n' "$base_ref" >&2
    return 1
  }
  [[ ${GITHUB_EVENT_NAME:-} == pull_request &&
    -f ${GITHUB_EVENT_PATH:-} && ! -L ${GITHUB_EVENT_PATH:-} ]] || {
    printf 'checkout-ci-candidate: D5 CI requires a pull-request event\n' >&2
    return 1
  }
  IFS=$'\t' read -r event_ref event_sha < <(
    python3 - "$GITHUB_EVENT_PATH" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    event = json.load(stream)
base = event.get("pull_request", {}).get("base", {})
print(f"{base.get('ref', '')}\t{base.get('sha', '')}")
PY
  )
  [[ $event_ref == "$base_ref" ]] || {
    printf 'checkout-ci-candidate: pull-request base ref does not match lock\n' >&2
    return 1
  }
  [[ $event_sha =~ ^[0-9a-f]{40}$ ]] || {
    printf 'checkout-ci-candidate: invalid pull-request base SHA\n' >&2
    return 1
  }

  if [[ $(root_git rev-parse --is-shallow-repository) == true ]]; then
    root_git fetch --quiet --no-tags --unshallow origin \
      "$candidate_sha" "$event_sha" "$base_sha" || return 1
  else
    root_git fetch --quiet --no-tags origin "$event_sha" "$base_sha" || return 1
  fi
  for commit in "$event_sha" "$base_sha"; do
    [[ $(root_git cat-file -t "$commit" 2>/dev/null) == commit ]] || {
      printf 'checkout-ci-candidate: required base SHA is not a fetched commit\n' >&2
      return 1
    }
  done
  # The D5 lock records the migration floor, not the forever-current main
  # commit. Later pull requests may target descendants after D5 is merged.
  merge_base=$(root_git merge-base "$event_sha" "$base_sha" 2>/dev/null) ||
    merge_base=
  [[ $merge_base == "$base_sha" ]] || {
    printf 'checkout-ci-candidate: pull-request base is outside the locked D4 history\n' >&2
    return 1
  }
  merge_base=$(root_git merge-base "$candidate_sha" "$base_sha" 2>/dev/null) ||
    merge_base=
  [[ $merge_base == "$base_sha" ]] || {
    printf 'checkout-ci-candidate: D5 head is not based on the locked D4 commit\n' >&2
    return 1
  }
}

[[ $candidate_sha =~ ^[0-9a-f]{40}$ ]] || {
  printf 'checkout-ci-candidate: invalid immutable candidate revision: %s\n' \
    "${candidate_sha:-<empty>}" >&2
  exit 1
}

[[ -d $root/.git && ! -L $root/.git ]] || {
  printf 'checkout-ci-candidate: a disposable standalone checkout is required: %s\n' \
    "$root" >&2
  exit 1
}

root_git() {
  # Container jobs can present the checked-out files under a different uid
  # from the shell that runs the test command. Trust only this script-derived
  # candidate path instead of depending on mutable runner-global Git config.
  # Clear every repository-selection and write-redirection variable so a
  # caller cannot redirect fetch or checkout into shared repository metadata.
  env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR \
    -u GIT_IMPLICIT_WORK_TREE -u GIT_PREFIX \
    -u GIT_INDEX_FILE -u GIT_OBJECT_DIRECTORY \
    -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_SHALLOW_FILE \
    -u GIT_CONFIG -u GIT_CONFIG_GLOBAL -u GIT_CONFIG_SYSTEM \
    -u GIT_CONFIG_COUNT -u GIT_CONFIG_PARAMETERS -u GIT_NAMESPACE \
    -u GIT_GRAFT_FILE -u GIT_REPLACE_REF_BASE \
    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
    GIT_NO_REPLACE_OBJECTS=1 \
    git --no-replace-objects -c "safe.directory=$root" -C "$root" "$@"
}

git_top=$(root_git rev-parse --show-toplevel 2>/dev/null) || exit 1
git_dir=$(root_git rev-parse --absolute-git-dir 2>/dev/null) || exit 1
git_common_dir=$(root_git rev-parse --git-common-dir 2>/dev/null) || exit 1
case $git_common_dir in
  /*) ;;
  *) git_common_dir=$root/$git_common_dir ;;
esac
git_common_dir=$(cd -P -- "$git_common_dir" && pwd -P) || exit 1
[[ $git_top == "$root" && $git_dir == "$root/.git" &&
  $git_common_dir == "$root/.git" ]] || {
  printf 'checkout-ci-candidate: repository metadata is not standalone: %s\n' \
    "$root" >&2
  exit 1
}

restore_ci_git_config() {
  local path=.config/git/config status expected actual

  status=$(root_git status --porcelain -- "$path")
  [[ -n $status ]] || return 0
  [[ $status == " M $path" ]] || return 1

  expected=$(root_git show "HEAD:$path") || return 1
  expected+=$'\n[safe]\n\tdirectory = '"$root"
  actual=$(<"$root/$path")
  [[ $actual == "$expected" ]] || return 1

  # The shared CI workflow writes this one global setting after redirecting
  # HOME into the checkout. Restore the reviewed candidate copy before moving
  # away from GitHub's synthesized merge ref.
  root_git checkout-index --force -- "$path"
}

restore_ci_git_config || true
dirty=$(root_git status --porcelain --untracked-files=all |
  sed '/^?? \.gitconfig$/d')
if [[ -n $dirty ]]; then
  printf 'checkout-ci-candidate: refusing to replace a dirty checkout\n' >&2
  printf '%s\n' "$dirty" >&2
  exit 1
fi

origin=$(root_git remote get-url origin 2>/dev/null) || {
  printf 'checkout-ci-candidate: origin remote is unavailable\n' >&2
  exit 1
}
[[ -n $origin ]] || exit 1

root_git fetch --quiet --no-tags --depth=1 origin "$candidate_sha"
root_git checkout --quiet --detach "$candidate_sha"

actual_sha=$(root_git rev-parse HEAD)
[[ $actual_sha == "$candidate_sha" ]] || {
  printf 'checkout-ci-candidate: expected %s, checked out %s\n' \
    "$candidate_sha" "$actual_sha" >&2
  exit 1
}
dirty=$(root_git status --porcelain --untracked-files=all |
  sed '/^?? \.gitconfig$/d')
[[ -z $dirty ]] || {
  printf 'checkout-ci-candidate: exact checkout is unexpectedly dirty\n' >&2
  printf '%s\n' "$dirty" >&2
  exit 1
}

if [[ ${GITHUB_ACTIONS:-false} == true &&
  ${GITHUB_EVENT_NAME:-} == pull_request ]]; then
  verify_d5_pull_request_base || exit 1
fi

printf 'candidate-checkout\torigin=%s\thead=%s\n' "$origin" "$actual_sha"
