#!/usr/bin/env bash
# shell-loader-test — `_shell_source_dir` loader behavior.

# shellcheck disable=SC1091 # dotfiles test helper lives under the source home.
. "${BASH_SOURCE[0]%/*}/helpers.sh"

REAL_HOME="${DOT_TEST_SOURCE_HOME:-$HOME}"
LOADER="$REAL_HOME/.local/lib/dotfiles/shell-loader.sh"
TEST_TMPDIR=$(_tmpdir)

make_fixture() {
  local dir=$1
  mkdir -p "$dir"
  cat >"$dir/05-first.sh" <<'EOF'
printf 'first\n' >>"$DOT_LOADER_TEST_LOG"
EOF
  # A top-level `for f` like master.zshrc's completion walk: without the
  # save/restore around each source this rebinds the loader's loop variable
  # through dynamic scoping.
  cat >"$dir/10-clobber.sh" <<'EOF'
for f in a smcc; do :; done
sorted=CLOBBERED
printf 'second\n' >>"$DOT_LOADER_TEST_LOG"
EOF
  cat >"$dir/15-third.sh" <<'EOF'
printf 'third\n' >>"$DOT_LOADER_TEST_LOG"
EOF
  cat >"$dir/20-only.zsh" <<'EOF'
printf 'zsh-only\n' >>"$DOT_LOADER_TEST_LOG"
EOF
  cat >"$dir/21-only.bash" <<'EOF'
printf 'bash-only\n' >>"$DOT_LOADER_TEST_LOG"
EOF
}

echo ""
echo "=== shell-loader: clobber-resistant timing labels (bash) ==="

FIX_BASH=$TEST_TMPDIR/fix-bash
make_fixture "$FIX_BASH"
LOG_BASH=$TEST_TMPDIR/order-bash.log
: >"$LOG_BASH"
timing_bash=$(
  DOT_LOADER_TEST_LOG="$LOG_BASH" SHELL_LOADER_TIMING=1 \
    bash -c ". '$LOADER'; _shell_source_dir '$FIX_BASH' bash" 2>&1
)
_assert_eq "loader timing: every selected file sourced in order" \
  $'first\nsecond\nthird\nbash-only' "$(cat "$LOG_BASH")"
labels_bash=$(printf '%s\n' "$timing_bash" | awk -F'\t' '$1=="SHELL_TIMING" {print $3}')
_assert_eq "loader timing: labels are the sourced paths" \
  "$FIX_BASH/05-first.sh
$FIX_BASH/10-clobber.sh
$FIX_BASH/15-third.sh
$FIX_BASH/21-only.bash" "$labels_bash"
_assert_not_contains "loader timing: clobbered loop var never leaks into labels" \
  "smcc" "$timing_bash"
_assert_not_contains "loader timing: clobbered sorted never leaks into labels" \
  "CLOBBERED" "$timing_bash"

echo ""
echo "=== shell-loader: plain path sources all in order (bash) ==="

LOG_PLAIN=$TEST_TMPDIR/order-plain.log
: >"$LOG_PLAIN"
plain_out=$(
  DOT_LOADER_TEST_LOG="$LOG_PLAIN" \
    bash -c ". '$LOADER'; _shell_source_dir '$FIX_BASH' bash" 2>&1
)
_assert_eq "loader plain: every selected file sourced in order" \
  $'first\nsecond\nthird\nbash-only' "$(cat "$LOG_PLAIN")"
_assert_not_contains "loader plain: no timing output without the flag" \
  "SHELL_TIMING" "$plain_out"

if command -v zsh >/dev/null 2>&1; then
  echo ""
  echo "=== shell-loader: clobber-resistant timing labels (zsh) ==="

  FIX_ZSH=$TEST_TMPDIR/fix-zsh
  make_fixture "$FIX_ZSH"
  LOG_ZSH=$TEST_TMPDIR/order-zsh.log
  : >"$LOG_ZSH"
  timing_zsh=$(
    DOT_LOADER_TEST_LOG="$LOG_ZSH" SHELL_LOADER_TIMING=1 \
      zsh -f -c ". '$LOADER'; _shell_source_dir '$FIX_ZSH' zsh" 2>&1
  )
  _assert_eq "loader timing (zsh): every selected file sourced in order" \
    $'first\nsecond\nthird\nzsh-only' "$(cat "$LOG_ZSH")"
  labels_zsh=$(printf '%s\n' "$timing_zsh" | awk -F'\t' '$1=="SHELL_TIMING" {print $3}')
  _assert_eq "loader timing (zsh): labels are the sourced paths" \
    "$FIX_ZSH/05-first.sh
$FIX_ZSH/10-clobber.sh
$FIX_ZSH/15-third.sh
$FIX_ZSH/20-only.zsh" "$labels_zsh"
  _assert_not_contains "loader timing (zsh): clobbered loop var never leaks" \
    "smcc" "$timing_zsh"

  echo ""
  echo "=== shell-loader: plain path sources all in order (zsh) ==="

  LOG_PLAIN_ZSH=$TEST_TMPDIR/order-plain-zsh.log
  : >"$LOG_PLAIN_ZSH"
  plain_zsh_out=$(
    DOT_LOADER_TEST_LOG="$LOG_PLAIN_ZSH" \
      zsh -f -c ". '$LOADER'; _shell_source_dir '$FIX_ZSH' zsh" 2>&1
  )
  _assert_eq "loader plain (zsh): every selected file sourced in order" \
    $'first\nsecond\nthird\nzsh-only' "$(cat "$LOG_PLAIN_ZSH")"
  _assert_not_contains "loader plain (zsh): no timing output without the flag" \
    "SHELL_TIMING" "$plain_zsh_out"
fi

# Non-interactive entry point (BASH_ENV / ~/.zshenv). Each new shell process
# must load env.d itself: shopt settings, functions, arrays, and shell-specific
# branches are not inherited through the environment. A load guard that
# leaks through the environment (for example via tmux's global environment)
# would silently skip env.d in every later `bash -c` / `zsh -c`.
ENV_HOME=$TEST_TMPDIR/env-home
mkdir -p "$ENV_HOME/.config/shell/env.d" "$ENV_HOME/.local/lib/dotfiles"
cp "$REAL_HOME/.config/shell/env-noninteractive.sh" "$ENV_HOME/.config/shell/"
cp "$LOADER" "$ENV_HOME/.local/lib/dotfiles/shell-loader.sh"
cp "$REAL_HOME/.zshenv" "$ENV_HOME/.zshenv"
cp "$REAL_HOME/.bashrc" "$ENV_HOME/.bashrc"
mkdir -p "$ENV_HOME/.config/shell/interactive.d"
cat >"$ENV_HOME/.config/shell/env.d/10-probe.sh" <<'EOF'
printf 'common %s\n' "$$" >>"$DOT_ENV_TEST_LOG"
EOF
cat >"$ENV_HOME/.config/shell/env.d/20-probe.bash" <<'EOF'
printf 'bash\n' >>"$DOT_ENV_TEST_LOG"
EOF
cat >"$ENV_HOME/.config/shell/env.d/20-probe.zsh" <<'EOF'
printf 'zsh\n' >>"$DOT_ENV_TEST_LOG"
EOF
ENV_BASH_ENV=$ENV_HOME/.config/shell/env-noninteractive.sh

# Run a command with a scrubbed environment rooted at the fixture home so the
# caller's live BASH_ENV, ZDOTDIR, and guards cannot leak in. Extra NAME=value
# pairs before the command simulate inherited environment state. stdin is
# /dev/null because bash treats a socket stdin with SHLVL<2 as an sshd launch
# and reads ~/.bashrc instead of BASH_ENV; agent and CI runners may hand the
# suite a socket.
env_run() {
  env -i HOME="$ENV_HOME" ZDOTDIR="$ENV_HOME" PATH="$PATH" \
    BASH_ENV="$ENV_BASH_ENV" DOT_ENV_TEST_LOG="$ENV_LOG" "$@" </dev/null
}

echo ""
echo "=== env-noninteractive: inherited guard does not skip env.d (bash) ==="

ENV_LOG=$TEST_TMPDIR/env-inherited-bash.log
: >"$ENV_LOG"
env_run _SHELL_ENV_NONINTERACTIVE_LOADED_SHELLS=bash,zsh bash -c ':'
_assert_eq "env-noninteractive (bash): inherited guard still loads env.d" \
  "common bash" "$(awk '{print $1}' "$ENV_LOG" | paste -sd' ' -)"

echo ""
echo "=== env-noninteractive: nested bash child loads env.d itself ==="

ENV_LOG=$TEST_TMPDIR/env-nested-bash.log
: >"$ENV_LOG"
env_run bash -c 'bash -c :'
_assert_eq "env-noninteractive (bash): parent and child each load env.d" \
  "2" "$(grep -c '^common ' "$ENV_LOG")"

echo ""
echo "=== env-noninteractive: same process loads env.d once (bash) ==="

ENV_LOG=$TEST_TMPDIR/env-resource-bash.log
: >"$ENV_LOG"
# shellcheck disable=SC2016 # the child shell expands its own BASH_ENV.
env_run bash -c '. "$BASH_ENV"; . "$BASH_ENV"'
_assert_eq "env-noninteractive (bash): re-sourcing in one process is a no-op" \
  "common bash" "$(awk '{print $1}' "$ENV_LOG" | paste -sd' ' -)"

ENV_LOG=$TEST_TMPDIR/env-bashrc-bash.log
: >"$ENV_LOG"
# shellcheck disable=SC2016 # the child shell expands its own HOME.
env_run bash -c '. "$HOME/.bashrc"'
_assert_eq "env-noninteractive (bash): BASH_ENV plus ~/.bashrc loads env.d once" \
  "common bash" "$(awk '{print $1}' "$ENV_LOG" | paste -sd' ' -)"

echo ""
echo "=== env-noninteractive: legacy guard is not re-exported ==="

ENV_LOG=$TEST_TMPDIR/env-export-bash.log
: >"$ENV_LOG"
exported=$(env_run _SHELL_ENV_NONINTERACTIVE_LOADED_SHELLS=bash bash -c \
  'env | grep "^_SHELL_ENV_NONINTERACTIVE" || printf "none\n"')
_assert_eq "env-noninteractive (bash): no load guard exported to children" \
  "none" "$exported"

if command -v zsh >/dev/null 2>&1; then
  echo ""
  echo "=== env-noninteractive: inherited guard does not skip env.d (zsh) ==="

  ENV_LOG=$TEST_TMPDIR/env-inherited-zsh.log
  : >"$ENV_LOG"
  env_run _SHELL_ENV_NONINTERACTIVE_LOADED_SHELLS=bash,zsh zsh -c ':'
  _assert_eq "env-noninteractive (zsh): inherited guard still loads env.d" \
    "common zsh" "$(awk '{print $1}' "$ENV_LOG" | paste -sd' ' -)"

  echo ""
  echo "=== env-noninteractive: nested zsh child loads env.d itself ==="

  ENV_LOG=$TEST_TMPDIR/env-nested-zsh.log
  : >"$ENV_LOG"
  env_run zsh -c 'zsh -c :'
  _assert_eq "env-noninteractive (zsh): parent and child each load env.d" \
    "2" "$(grep -c '^common ' "$ENV_LOG")"

  echo ""
  echo "=== env-noninteractive: same process loads env.d once (zsh) ==="

  ENV_LOG=$TEST_TMPDIR/env-resource-zsh.log
  : >"$ENV_LOG"
  # shellcheck disable=SC2016 # the child shell expands its own HOME.
  env_run zsh -c '. "$HOME/.config/shell/env-noninteractive.sh"'
  _assert_eq "env-noninteractive (zsh): re-sourcing in one process is a no-op" \
    "common zsh" "$(awk '{print $1}' "$ENV_LOG" | paste -sd' ' -)"

  exported=$(env_run _SHELL_ENV_NONINTERACTIVE_LOADED_SHELLS=zsh zsh -c \
    'env | grep "^_SHELL_ENV_NONINTERACTIVE" || printf "none\n"')
  _assert_eq "env-noninteractive (zsh): no load guard exported to children" \
    "none" "$exported"
fi

_test_summary
