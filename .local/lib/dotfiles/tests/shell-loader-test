#!/usr/bin/env bash
# shell-loader-test — `_shell_source_dir` loader behavior.

# shellcheck disable=SC1091 # dotfiles test helper lives under the source home.
. "${BASH_SOURCE[0]%/*}/helpers.sh"

REAL_HOME="${DOT_TEST_SOURCE_HOME:-$HOME}"
LOADER="$REAL_HOME/.local/lib/dotfiles/shell-loader.sh"
TEST_TMPDIR=$(_tmpdir)

make_fixture() {
  local dir=$1
  mkdir -p "$dir"
  cat >"$dir/05-first.sh" <<'EOF'
printf 'first\n' >>"$DOT_LOADER_TEST_LOG"
EOF
  # A top-level `for f` like master.zshrc's completion walk: without the
  # save/restore around each source this rebinds the loader's loop variable
  # through dynamic scoping.
  cat >"$dir/10-clobber.sh" <<'EOF'
for f in a smcc; do :; done
sorted=CLOBBERED
printf 'second\n' >>"$DOT_LOADER_TEST_LOG"
EOF
  cat >"$dir/15-third.sh" <<'EOF'
printf 'third\n' >>"$DOT_LOADER_TEST_LOG"
EOF
  cat >"$dir/20-only.zsh" <<'EOF'
printf 'zsh-only\n' >>"$DOT_LOADER_TEST_LOG"
EOF
  cat >"$dir/21-only.bash" <<'EOF'
printf 'bash-only\n' >>"$DOT_LOADER_TEST_LOG"
EOF
}

echo ""
echo "=== shell-loader: clobber-resistant timing labels (bash) ==="

FIX_BASH=$TEST_TMPDIR/fix-bash
make_fixture "$FIX_BASH"
LOG_BASH=$TEST_TMPDIR/order-bash.log
: >"$LOG_BASH"
timing_bash=$(
  DOT_LOADER_TEST_LOG="$LOG_BASH" SHELL_LOADER_TIMING=1 \
    bash -c ". '$LOADER'; _shell_source_dir '$FIX_BASH' bash" 2>&1
)
_assert_eq "loader timing: every selected file sourced in order" \
  $'first\nsecond\nthird\nbash-only' "$(cat "$LOG_BASH")"
labels_bash=$(printf '%s\n' "$timing_bash" | awk -F'\t' '$1=="SHELL_TIMING" {print $3}')
_assert_eq "loader timing: labels are the sourced paths" \
  "$FIX_BASH/05-first.sh
$FIX_BASH/10-clobber.sh
$FIX_BASH/15-third.sh
$FIX_BASH/21-only.bash" "$labels_bash"
_assert_not_contains "loader timing: clobbered loop var never leaks into labels" \
  "smcc" "$timing_bash"
_assert_not_contains "loader timing: clobbered sorted never leaks into labels" \
  "CLOBBERED" "$timing_bash"

echo ""
echo "=== shell-loader: plain path sources all in order (bash) ==="

LOG_PLAIN=$TEST_TMPDIR/order-plain.log
: >"$LOG_PLAIN"
plain_out=$(
  DOT_LOADER_TEST_LOG="$LOG_PLAIN" \
    bash -c ". '$LOADER'; _shell_source_dir '$FIX_BASH' bash" 2>&1
)
_assert_eq "loader plain: every selected file sourced in order" \
  $'first\nsecond\nthird\nbash-only' "$(cat "$LOG_PLAIN")"
_assert_not_contains "loader plain: no timing output without the flag" \
  "SHELL_TIMING" "$plain_out"

if command -v zsh >/dev/null 2>&1; then
  echo ""
  echo "=== shell-loader: clobber-resistant timing labels (zsh) ==="

  FIX_ZSH=$TEST_TMPDIR/fix-zsh
  make_fixture "$FIX_ZSH"
  LOG_ZSH=$TEST_TMPDIR/order-zsh.log
  : >"$LOG_ZSH"
  timing_zsh=$(
    DOT_LOADER_TEST_LOG="$LOG_ZSH" SHELL_LOADER_TIMING=1 \
      zsh -f -c ". '$LOADER'; _shell_source_dir '$FIX_ZSH' zsh" 2>&1
  )
  _assert_eq "loader timing (zsh): every selected file sourced in order" \
    $'first\nsecond\nthird\nzsh-only' "$(cat "$LOG_ZSH")"
  labels_zsh=$(printf '%s\n' "$timing_zsh" | awk -F'\t' '$1=="SHELL_TIMING" {print $3}')
  _assert_eq "loader timing (zsh): labels are the sourced paths" \
    "$FIX_ZSH/05-first.sh
$FIX_ZSH/10-clobber.sh
$FIX_ZSH/15-third.sh
$FIX_ZSH/20-only.zsh" "$labels_zsh"
  _assert_not_contains "loader timing (zsh): clobbered loop var never leaks" \
    "smcc" "$timing_zsh"

  echo ""
  echo "=== shell-loader: plain path sources all in order (zsh) ==="

  LOG_PLAIN_ZSH=$TEST_TMPDIR/order-plain-zsh.log
  : >"$LOG_PLAIN_ZSH"
  plain_zsh_out=$(
    DOT_LOADER_TEST_LOG="$LOG_PLAIN_ZSH" \
      zsh -f -c ". '$LOADER'; _shell_source_dir '$FIX_ZSH' zsh" 2>&1
  )
  _assert_eq "loader plain (zsh): every selected file sourced in order" \
    $'first\nsecond\nthird\nzsh-only' "$(cat "$LOG_PLAIN_ZSH")"
  _assert_not_contains "loader plain (zsh): no timing output without the flag" \
    "SHELL_TIMING" "$plain_zsh_out"
fi

# Non-interactive entry point (BASH_ENV / ~/.zshenv). Each new shell process
# must load env.d itself: shopt settings, functions, arrays, and shell-specific
# branches are not inherited through the environment. A load guard that
# leaks through the environment (for example via tmux's global environment)
# would silently skip env.d in every later `bash -c` / `zsh -c`.
ENV_HOME=$TEST_TMPDIR/env-home
mkdir -p "$ENV_HOME/.config/shell/env.d" "$ENV_HOME/.local/lib/dotfiles"
cp "$REAL_HOME/.config/shell/env-noninteractive.sh" "$ENV_HOME/.config/shell/"
cp "$LOADER" "$ENV_HOME/.local/lib/dotfiles/shell-loader.sh"
cp "$REAL_HOME/.zshenv" "$ENV_HOME/.zshenv"
cp "$REAL_HOME/.bashrc" "$ENV_HOME/.bashrc"
mkdir -p "$ENV_HOME/.config/shell/interactive.d"
cat >"$ENV_HOME/.config/shell/env.d/10-probe.sh" <<'EOF'
printf 'common %s\n' "$$" >>"$DOT_ENV_TEST_LOG"
EOF
cat >"$ENV_HOME/.config/shell/env.d/20-probe.bash" <<'EOF'
printf 'bash\n' >>"$DOT_ENV_TEST_LOG"
EOF
cat >"$ENV_HOME/.config/shell/env.d/20-probe.zsh" <<'EOF'
printf 'zsh\n' >>"$DOT_ENV_TEST_LOG"
EOF
ENV_BASH_ENV=$ENV_HOME/.config/shell/env-noninteractive.sh

# Run a command with a scrubbed environment rooted at the fixture home so the
# caller's live BASH_ENV, ZDOTDIR, and guards cannot leak in. Extra NAME=value
# pairs before the command simulate inherited environment state. stdin is
# /dev/null because bash treats a socket stdin with SHLVL<2 as an sshd launch
# and reads ~/.bashrc instead of BASH_ENV; agent and CI runners may hand the
# suite a socket.
env_run() {
  env -i HOME="$ENV_HOME" ZDOTDIR="$ENV_HOME" PATH="$PATH" \
    BASH_ENV="$ENV_BASH_ENV" DOT_ENV_TEST_LOG="$ENV_LOG" "$@" </dev/null
}

echo ""
echo "=== env-noninteractive: inherited guard does not skip env.d (bash) ==="

ENV_LOG=$TEST_TMPDIR/env-inherited-bash.log
: >"$ENV_LOG"
env_run _SHELL_ENV_NONINTERACTIVE_LOADED_SHELLS=bash,zsh bash -c ':'
_assert_eq "env-noninteractive (bash): inherited guard still loads env.d" \
  "common bash" "$(awk '{print $1}' "$ENV_LOG" | paste -sd' ' -)"

echo ""
echo "=== env-noninteractive: nested bash child loads env.d itself ==="

ENV_LOG=$TEST_TMPDIR/env-nested-bash.log
: >"$ENV_LOG"
env_run bash -c 'bash -c :'
_assert_eq "env-noninteractive (bash): parent and child each load env.d" \
  "2" "$(grep -c '^common ' "$ENV_LOG")"

echo ""
echo "=== env-noninteractive: same process loads env.d once (bash) ==="

ENV_LOG=$TEST_TMPDIR/env-resource-bash.log
: >"$ENV_LOG"
# shellcheck disable=SC2016 # the child shell expands its own BASH_ENV.
env_run bash -c '. "$BASH_ENV"; . "$BASH_ENV"'
_assert_eq "env-noninteractive (bash): re-sourcing in one process is a no-op" \
  "common bash" "$(awk '{print $1}' "$ENV_LOG" | paste -sd' ' -)"

ENV_LOG=$TEST_TMPDIR/env-bashrc-bash.log
: >"$ENV_LOG"
# shellcheck disable=SC2016 # the child shell expands its own HOME.
env_run bash -c '. "$HOME/.bashrc"'
_assert_eq "env-noninteractive (bash): BASH_ENV plus ~/.bashrc loads env.d once" \
  "common bash" "$(awk '{print $1}' "$ENV_LOG" | paste -sd' ' -)"

echo ""
echo "=== env-noninteractive: legacy guard is not re-exported ==="

ENV_LOG=$TEST_TMPDIR/env-export-bash.log
: >"$ENV_LOG"
exported=$(env_run _SHELL_ENV_NONINTERACTIVE_LOADED_SHELLS=bash bash -c \
  'env | grep "^_SHELL_ENV_NONINTERACTIVE" || printf "none\n"')
_assert_eq "env-noninteractive (bash): no load guard exported to children" \
  "none" "$exported"

if command -v zsh >/dev/null 2>&1; then
  echo ""
  echo "=== env-noninteractive: inherited guard does not skip env.d (zsh) ==="

  ENV_LOG=$TEST_TMPDIR/env-inherited-zsh.log
  : >"$ENV_LOG"
  env_run _SHELL_ENV_NONINTERACTIVE_LOADED_SHELLS=bash,zsh zsh -c ':'
  _assert_eq "env-noninteractive (zsh): inherited guard still loads env.d" \
    "common zsh" "$(awk '{print $1}' "$ENV_LOG" | paste -sd' ' -)"

  echo ""
  echo "=== env-noninteractive: nested zsh child loads env.d itself ==="

  ENV_LOG=$TEST_TMPDIR/env-nested-zsh.log
  : >"$ENV_LOG"
  env_run zsh -c 'zsh -c :'
  _assert_eq "env-noninteractive (zsh): parent and child each load env.d" \
    "2" "$(grep -c '^common ' "$ENV_LOG")"

  echo ""
  echo "=== env-noninteractive: same process loads env.d once (zsh) ==="

  ENV_LOG=$TEST_TMPDIR/env-resource-zsh.log
  : >"$ENV_LOG"
  # shellcheck disable=SC2016 # the child shell expands its own HOME.
  env_run zsh -c '. "$HOME/.config/shell/env-noninteractive.sh"'
  _assert_eq "env-noninteractive (zsh): re-sourcing in one process is a no-op" \
    "common zsh" "$(awk '{print $1}' "$ENV_LOG" | paste -sd' ' -)"

  exported=$(env_run _SHELL_ENV_NONINTERACTIVE_LOADED_SHELLS=zsh zsh -c \
    'env | grep "^_SHELL_ENV_NONINTERACTIVE" || printf "none\n"')
  _assert_eq "env-noninteractive (zsh): no load guard exported to children" \
    "none" "$exported"
fi

# Environment ownership. Interactive and login loads are authoritative (new
# tmux panes inherit tmux's stale global environment and must refresh it);
# non-interactive loads run in every nested `bash -c`, script, and hook and must
# keep values the caller passed down (`EDITOR=vim git commit`), filling only
# missing ones. Shell-local state still loads in every shell. The fixture uses
# the base fragments whose conversions these cases cover (50-core.sh for the
# exports, 90-path.sh for PATH) plus probes for the helper contract. It copies
# them by name instead of globbing the source env.d: an installed home also
# holds overlay fragments (the editor overlay's RIPGREP_CONFIG_PATH), which
# would make the results depend on which overlays and versions are installed.
OWN_HOME=$TEST_TMPDIR/own-home
OWN_ENV_D=$OWN_HOME/.config/shell/env.d
mkdir -p "$OWN_ENV_D" "$OWN_HOME/.config/shell/interactive.d" \
  "$OWN_HOME/.local/lib/dotfiles" "$OWN_HOME/.local/bin"
cp "$REAL_HOME/.config/shell/env-noninteractive.sh" "$OWN_HOME/.config/shell/"
cp "$LOADER" "$OWN_HOME/.local/lib/dotfiles/shell-loader.sh"
cp "$REAL_HOME/.zshenv" "$REAL_HOME/.zshrc" "$REAL_HOME/.zprofile" \
  "$REAL_HOME/.bashrc" "$REAL_HOME/.bash_profile" "$OWN_HOME/"
cp "$REAL_HOME/.config/shell/env.d/50-core.sh" \
  "$REAL_HOME/.config/shell/env.d/90-path.sh" "$OWN_ENV_D/"
cat >"$OWN_ENV_D/15-probe-local.sh" <<'EOF'
_dot_env_probe_fn() { :; }
EOF
cat >"$OWN_ENV_D/20-probe-local.bash" <<'EOF'
shopt -s extglob
DOT_ENV_PROBE_FLAVOR=bash
EOF
cat >"$OWN_ENV_D/20-probe-local.zsh" <<'EOF'
setopt extendedglob
DOT_ENV_PROBE_FLAVOR=zsh
EOF
# An earlier fragment's value must not look inherited to a later fragment
# that owns the same name (base's RIPGREP_CONFIG_PATH, then the editor
# overlay's).
cat >"$OWN_ENV_D/81-probe-default.sh" <<'EOF'
_shell_env_set DOT_ENV_PROBE_ORDER low
EOF
cat >"$OWN_ENV_D/82-probe-set.sh" <<'EOF'
_shell_env_set DOT_ENV_PROBE_ORDER high
EOF
# A fragment that unsets an inherited value (a dead SSH_AUTH_SOCK) makes it
# missing again, so the helper fills it.
cat >"$OWN_ENV_D/83-probe-repair.sh" <<'EOF'
[ "${DOT_ENV_PROBE_SOCK:-}" = dead ] && unset DOT_ENV_PROBE_SOCK
_shell_env_set DOT_ENV_PROBE_SOCK live
EOF
# PATH edits by earlier fragments (tool bootstraps prepend, system rc appends).
cat >"$OWN_ENV_D/85-probe-path.sh" <<'EOF'
[ -n "${DOT_ENV_PROBE_PREPEND:-}" ] && PATH="$DOT_ENV_PROBE_PREPEND:$PATH"
[ -n "${DOT_ENV_PROBE_APPEND:-}" ] && PATH="$PATH:$DOT_ENV_PROBE_APPEND"
true
EOF
# Fake executables: one in a dotfiles-managed PATH dir, one in a caller venv.
OWN_VENV=$TEST_TMPDIR/venv/bin
mkdir -p "$OWN_VENV"
printf '#!/bin/sh\n' >"$OWN_HOME/.local/bin/dot-env-probe-python"
printf '#!/bin/sh\n' >"$OWN_VENV/dot-env-probe-python"
chmod +x "$OWN_HOME/.local/bin/dot-env-probe-python" \
  "$OWN_VENV/dot-env-probe-python"
OWN_RG=$OWN_HOME/.config/ripgrep/config
OWN_HOST_BINS=/usr/local/bin:/opt/homebrew/bin:/opt/homebrew/sbin
OWN_BREW_BINS=/opt/homebrew/bin:/opt/homebrew/sbin

# Like env_run, rooted at the ownership fixture. Interactive shells get a
# /dev/null stdin as well, so job-control warnings go to stderr only.
own_run() {
  env -i HOME="$OWN_HOME" ZDOTDIR="$OWN_HOME" PATH="$PATH" \
    BASH_ENV="$OWN_HOME/.config/shell/env-noninteractive.sh" "$@" \
    </dev/null 2>/dev/null
}

# Print each PATH entry that appears more than once.
path_dupes() {
  printf '%s\n' "$1" | tr ':' '\n' | sort | uniq -d | paste -sd' ' -
}

# shellcheck disable=SC2016 # every probe below expands in the child shell.
PROBE_RG='printf "%s|%s" "$RIPGREP_CONFIG_PATH" "${FZF_DEFAULT_OPTS-unset}"'
# shellcheck disable=SC2016
PROBE_LOCAL='type _dot_env_probe_fn >/dev/null 2>&1 && printf "fn:%s" "$DOT_ENV_PROBE_FLAVOR"'
# shellcheck disable=SC2016
PROBE_PY='command -v dot-env-probe-python; printf "%s\n" "$PATH"'

# Probe command strings expand in the child shells, not here.
# shellcheck disable=SC2016
for own_sh in bash zsh; do
  command -v "$own_sh" >/dev/null 2>&1 || continue
  # Fixture PATHs may lack the shell's own dir (Alpine and macOS keep bash
  # and zsh in /bin), so the shell under test runs by absolute path.
  own_sh_bin=$(command -v "$own_sh")

  echo ""
  echo "=== env ownership: non-interactive keeps caller values ($own_sh) ==="

  _assert_eq "env ownership ($own_sh): missing values are filled" \
    "$OWN_RG|--bind=ctrl-n:down,ctrl-p:up,ctrl-d:half-page-down,ctrl-u:half-page-up,alt-j:down,alt-k:up" \
    "$(own_run "$own_sh_bin" -c "$PROBE_RG")"
  _assert_eq "env ownership ($own_sh): inherited values are kept" \
    "/caller/rg|--caller" \
    "$(own_run RIPGREP_CONFIG_PATH=/caller/rg FZF_DEFAULT_OPTS=--caller \
      "$own_sh_bin" -c "$PROBE_RG")"
  _assert_eq "env ownership ($own_sh): inherited empty value is kept" \
    "$OWN_RG|" \
    "$(own_run FZF_DEFAULT_OPTS= "$own_sh_bin" -c "$PROBE_RG")"
  _assert_eq "env ownership ($own_sh): nested child keeps a caller override" \
    "/caller/rg" \
    "$(own_run "$own_sh_bin" -c \
      'RIPGREP_CONFIG_PATH=/caller/rg bash -c "printf %s \"\$RIPGREP_CONFIG_PATH\""')"
  _assert_eq "env ownership ($own_sh): interactive parent, nested override kept" \
    "/caller/rg" \
    "$(own_run "$own_sh_bin" -i -c \
      'RIPGREP_CONFIG_PATH=/caller/rg bash -c "printf %s \"\$RIPGREP_CONFIG_PATH\""')"
  _assert_eq "env ownership ($own_sh): later fragment replaces an earlier one" \
    "high" "$(own_run "$own_sh_bin" -c 'printf %s "$DOT_ENV_PROBE_ORDER"')"
  _assert_eq "env ownership ($own_sh): inherited value beats every fragment" \
    "caller" \
    "$(own_run DOT_ENV_PROBE_ORDER=caller "$own_sh_bin" -c 'printf %s "$DOT_ENV_PROBE_ORDER"')"
  _assert_eq "env ownership ($own_sh): value unset by a fragment is refilled" \
    "live" "$(own_run DOT_ENV_PROBE_SOCK=dead "$own_sh_bin" -c 'printf %s "$DOT_ENV_PROBE_SOCK"')"
  _assert_eq "env ownership ($own_sh): live inherited value is kept" \
    "other" "$(own_run DOT_ENV_PROBE_SOCK=other "$own_sh_bin" -c 'printf %s "$DOT_ENV_PROBE_SOCK"')"
  _assert_eq "env ownership ($own_sh): no loader state leaks into the shell" \
    "unset|unset|unset|none" \
    "$(own_run "$own_sh_bin" -c 'printf "%s|%s|%s|" "${_SHELL_ENV_MODE-unset}" \
      "${_SHELL_ENV_OWNED-unset}" "${_SHELL_ENV_INHERITED_PATH-unset}"
      env | grep "^_SHELL_ENV" || printf none')"

  echo ""
  echo "=== env ownership: interactive and login loads refresh ($own_sh) ==="

  _assert_eq "env ownership ($own_sh): interactive shell refreshes a stale value" \
    "$OWN_RG" \
    "$(own_run RIPGREP_CONFIG_PATH=/stale "$own_sh_bin" -i -c 'printf %s "$RIPGREP_CONFIG_PATH"')"
  _assert_eq "env ownership ($own_sh): inherited mode variable cannot force fill" \
    "$OWN_RG" \
    "$(own_run _SHELL_ENV_MODE=fill "_SHELL_ENV_OWNED= " \
      RIPGREP_CONFIG_PATH=/stale "$own_sh_bin" -i -c 'printf %s "$RIPGREP_CONFIG_PATH"')"
  _assert_eq "env ownership ($own_sh): login shell refreshes a stale value" \
    "$OWN_RG" \
    "$(own_run RIPGREP_CONFIG_PATH=/stale "$own_sh_bin" -l -c 'printf %s "$RIPGREP_CONFIG_PATH"')"

  echo ""
  echo "=== env ownership: shell-local state in nested children ($own_sh) ==="

  _assert_eq "env ownership ($own_sh): nested bash child gets functions and bash branch" \
    "fn:bash" \
    "$(own_run "$own_sh_bin" -c "RIPGREP_CONFIG_PATH=/caller bash -c '$PROBE_LOCAL'")"
  _assert_eq "env ownership ($own_sh): nested zsh child gets functions and zsh branch" \
    "fn:zsh" \
    "$(own_run "$own_sh_bin" -c "RIPGREP_CONFIG_PATH=/caller zsh -c '$PROBE_LOCAL'")"
  _assert_eq "env ownership ($own_sh): leaked legacy guard is harmless" \
    "fn:$own_sh|/caller" \
    "$(own_run _SHELL_ENV_NONINTERACTIVE_LOADED_SHELLS=bash,zsh \
      RIPGREP_CONFIG_PATH=/caller "$own_sh_bin" -c \
      "$PROBE_LOCAL; printf '|%s' \"\$RIPGREP_CONFIG_PATH\"")"

  echo ""
  echo "=== env ownership: PATH order ($own_sh) ==="

  py_out=$(own_run "$own_sh_bin" -c \
    "PATH=\"$OWN_VENV:\$PATH\" bash -c '$PROBE_PY'")
  _assert_eq "env ownership ($own_sh): caller venv still resolves first" \
    "$OWN_VENV/dot-env-probe-python" "$(printf '%s\n' "$py_out" | sed -n 1p)"
  _assert_eq "env ownership ($own_sh): nested PATH has no duplicates" \
    "" "$(path_dupes "$(printf '%s\n' "$py_out" | sed -n 2p)")"
  py_out=$(own_run "$own_sh_bin" -c \
    "PATH=\"$OWN_VENV:\$PATH\" zsh -c '$PROBE_PY'")
  _assert_eq "env ownership ($own_sh): caller venv resolves first in zsh child" \
    "$OWN_VENV/dot-env-probe-python" "$(printf '%s\n' "$py_out" | sed -n 1p)"
  _assert_eq "env ownership ($own_sh): zsh child PATH has no duplicates" \
    "" "$(path_dupes "$(printf '%s\n' "$py_out" | sed -n 2p)")"
  # Host-managed dirs (/usr/local/bin everywhere, /opt/homebrew on macOS)
  # are listed explicitly so only the fixture's ~/.local/bin is missing.
  _assert_eq "env ownership ($own_sh): caller order kept, missing managed dir before system dirs" \
    "$OWN_HOME/.local/bin:/usr/bin:$OWN_HOST_BINS:/bin:$OWN_VENV" \
    "$(own_run PATH="/usr/bin:$OWN_HOST_BINS:/bin:$OWN_VENV:/usr/bin" \
      "$own_sh_bin" -c 'printf %s "$PATH"')"
  # A caller that replaces PATH (a Makefile `export PATH := ...`) rather than
  # extending it must still resolve its own entries first.
  py_out=$(own_run PATH="$OWN_VENV:/usr/bin:$OWN_HOST_BINS:/bin" "$own_sh_bin" -c "$PROBE_PY")
  _assert_eq "env ownership ($own_sh): replaced PATH keeps the caller venv first" \
    "$OWN_VENV/dot-env-probe-python" "$(printf '%s\n' "$py_out" | sed -n 1p)"
  _assert_eq "env ownership ($own_sh): missing managed dir lands before system dirs" \
    "$OWN_VENV:$OWN_HOME/.local/bin:/usr/bin:$OWN_HOST_BINS:/bin" \
    "$(printf '%s\n' "$py_out" | sed -n 2p)"
  _assert_eq "env ownership ($own_sh): caller-demoted managed dir stays put" \
    "$OWN_VENV:/usr/bin:$OWN_HOST_BINS:/bin:$OWN_HOME/.local/bin" \
    "$(own_run PATH="$OWN_VENV:/usr/bin:$OWN_HOST_BINS:/bin:$OWN_HOME/.local/bin" \
      "$own_sh_bin" -c 'printf %s "$PATH"')"
  _assert_eq "env ownership ($own_sh): fragment-appended entries follow, deduplicated" \
    "$OWN_VENV:/usr/bin:$OWN_HOST_BINS:/bin:$OWN_HOME/.local/bin:/probe/app" \
    "$(own_run PATH="$OWN_VENV:/usr/bin:$OWN_HOST_BINS:/bin:$OWN_HOME/.local/bin" \
      DOT_ENV_PROBE_APPEND=/usr/bin:/probe/app "$own_sh_bin" -c 'printf %s "$PATH"')"
  _assert_eq "env ownership ($own_sh): fragment-prepended entries cannot jump the caller" \
    "$OWN_VENV:/usr/bin:$OWN_HOST_BINS:/bin:$OWN_HOME/.local/bin:/probe/pre:/probe/app" \
    "$(own_run PATH="$OWN_VENV:/usr/bin:$OWN_HOST_BINS:/bin:$OWN_HOME/.local/bin" \
      DOT_ENV_PROBE_PREPEND=/probe/pre:/usr/bin DOT_ENV_PROBE_APPEND=/probe/app \
      "$own_sh_bin" -c 'printf %s "$PATH"')"
  own_path=$(own_run PATH="$OWN_VENV:/usr/bin:$OWN_HOST_BINS:/bin:$OWN_HOME/.local/bin" \
    "$own_sh_bin" -i -c 'printf %s "$PATH"')
  _assert_eq "env ownership ($own_sh): interactive shell restores managed priority" \
    "$OWN_HOME/.local/bin" "${own_path%%:*}"

  echo ""
  echo "=== env ownership: PATH anchors on host package dirs ($own_sh) ==="

  # Minimal PATHs that list /usr/local/bin (itself managed) ahead of the
  # system dirs: sudo's secure_path, systemd's user manager, sshd's default.
  # Missing managed dirs must land ahead of /usr/local/bin too, or a system
  # git there shadows the ~/.local/bin launcher. The Homebrew dirs trail each
  # input so a macOS host counts them as present, like the earlier cases.
  for own_min in \
    /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    /usr/local/bin:/usr/bin \
    /usr/local/bin:/usr/bin:/usr/local/sbin:/usr/sbin; do
    _assert_eq "env ownership ($own_sh): managed dir precedes host dirs in $own_min" \
      "$OWN_HOME/.local/bin:$own_min:$OWN_BREW_BINS" \
      "$(own_run PATH="$own_min:$OWN_BREW_BINS" "$own_sh_bin" -c 'printf %s "$PATH"')"
  done
  _assert_eq "env ownership ($own_sh): caller venv stays ahead of host-anchored managed dirs" \
    "$OWN_VENV:$OWN_HOME/.local/bin:/usr/local/bin:/usr/bin:$OWN_BREW_BINS" \
    "$(own_run PATH="$OWN_VENV:/usr/local/bin:/usr/bin:$OWN_BREW_BINS" \
      "$own_sh_bin" -c 'printf %s "$PATH"')"
  # shellcheck disable=SC2088 # a literal `~` entry, as a caller might pass.
  _assert_eq "env ownership ($own_sh): fill-only load drops . and empty entries only" \
    "$OWN_VENV:bin:~/tilde:$OWN_HOME/.local/bin:/usr/local/bin:/usr/bin:$OWN_BREW_BINS" \
    "$(own_run PATH=".:$OWN_VENV::bin:~/tilde:./:/usr/local/bin:/usr/bin:$OWN_BREW_BINS:" \
      "$own_sh_bin" -c 'printf %s "$PATH"')"
  own_path=$(own_run PATH="/usr/bin:." "$own_sh_bin" -i -c 'printf %s "$PATH"')
  _assert_contains "env ownership ($own_sh): interactive shell keeps its . entry" \
    ":/usr/bin:.:" ":$own_path:"
  # Homebrew hosts: a missing /usr/local/bin (managed after Homebrew) must
  # not jump an inherited /opt/homebrew/bin.
  if [ -d /opt/homebrew/bin ] && [ -d /opt/homebrew/sbin ] && [ -d /usr/local/bin ]; then
    _assert_eq "env ownership ($own_sh): missing managed dir keeps managed rank" \
      "$OWN_HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin" \
      "$(own_run PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin" \
        "$own_sh_bin" -c 'printf %s "$PATH"')"
  fi

  echo ""
  echo "=== env ownership: nested shells keep caller shdeps and BASH_ENV ($own_sh) ==="

  # A test that points shdeps at a fixture config must keep it in every
  # nested script instead of silently running the live hooks.
  _assert_eq "env ownership ($own_sh): caller SHDEPS_CONF_DIR survives nested bash" \
    "/caller/shdeps" \
    "$(own_run SHDEPS_CONF_DIR=/caller/shdeps "$own_sh_bin" -c \
      'bash -c "printf %s \"\$SHDEPS_CONF_DIR\""')"
  _assert_eq "env ownership ($own_sh): caller SHDEPS_CONF_DIR survives nested zsh" \
    "/caller/shdeps" \
    "$(own_run SHDEPS_CONF_DIR=/caller/shdeps "$own_sh_bin" -c \
      'zsh -c "printf %s \"\$SHDEPS_CONF_DIR\""')"
  _assert_eq "env ownership ($own_sh): missing SHDEPS_CONF_DIR is filled" \
    "$OWN_HOME/.config/shdeps" \
    "$(own_run "$own_sh_bin" -c 'printf %s "$SHDEPS_CONF_DIR"')"
done

# A caller's own BASH_ENV bootstrap (a tool's bash setup) reaches bash
# grandchildren of zsh; bash itself runs it instead of env.d.
OWN_CALLER_BASH_ENV=$TEST_TMPDIR/caller-bash-env.sh
printf '%s\n' 'DOT_ENV_PROBE_CALLER_BASH_ENV=ran' >"$OWN_CALLER_BASH_ENV"
if command -v zsh >/dev/null 2>&1; then
  # shellcheck disable=SC2016 # expands in the child shells.
  _assert_eq "env ownership (zsh): caller BASH_ENV survives to a bash grandchild" \
    "$OWN_CALLER_BASH_ENV|ran" \
    "$(own_run BASH_ENV="$OWN_CALLER_BASH_ENV" zsh -c \
      'bash -c "printf %s \"\$BASH_ENV|\$DOT_ENV_PROBE_CALLER_BASH_ENV\""')"
fi

# Bash's rshd heuristic: a `bash -c` whose stdin is a socket (agent tool
# shells, some job runners), or that sshd started with SSH_CLIENT set on
# SSH_SOURCE_BASHRC builds, reads ~/.bashrc instead of BASH_ENV when SHLVL
# is below 2. That load is non-interactive and non-login, so it must be
# fill-only like BASH_ENV; interactive and login shells stay authoritative.
# The env has no BASH_ENV, as under sshd, so env.d loads only via ~/.bashrc.
sshd_run() {
  env -i HOME="$OWN_HOME" ZDOTDIR="$OWN_HOME" "$@" 2>/dev/null
}
# Run a command with a connected Unix socket as stdin.
socket_stdin() {
  python3 -c 'import os, socket, sys
a, b = socket.socketpair()
os.dup2(a.fileno(), 0)
os.execvp(sys.argv[1], sys.argv[1:])' "$@"
}
# shellcheck disable=SC2016 # expands in the child shell.
PROBE_RSHD='printf "%s|%s" "$RIPGREP_CONFIG_PATH" "${SHDEPS_CONF_DIR-unset}"'

echo ""
echo "=== env ownership: bash reading ~/.bashrc for rshd/sshd commands ==="

# Bash on Linux (glibc and musl) applies the heuristic to a socket stdin;
# macOS builds may not, so there the non-login cases probe first and skip
# when nothing loads env.d. On Linux a probe miss is a failure, so a
# `.bashrc` that stops loading env.d for these shells cannot hide behind the
# skip. Login shells read ~/.bash_profile everywhere. Bash runs by absolute
# path because the fixture PATHs may lack its dir.
BASH_BIN=$(command -v bash)
# shellcheck disable=SC2016 # probes expand in the child shells.
if command -v python3 >/dev/null 2>&1; then
  socket_probe=$(socket_stdin env -i HOME="$OWN_HOME" PATH=/usr/bin:/bin \
    "$BASH_BIN" -c 'printf %s "${SHDEPS_CONF_DIR-unset}"' 2>/dev/null)
  if [ "$socket_probe" = unset ] && [ "$(uname -s)" != Linux ]; then
    echo "  SKIP: this bash does not read ~/.bashrc for socket-stdin commands"
  else
    _assert_eq "env ownership (bash): socket-stdin bash -c keeps caller values" \
      "/caller/rg|$OWN_HOME/.config/shdeps" \
      "$(socket_stdin env -i HOME="$OWN_HOME" PATH=/usr/bin:/bin \
        RIPGREP_CONFIG_PATH=/caller/rg "$BASH_BIN" -c "$PROBE_RSHD" 2>/dev/null)"
    _assert_eq "env ownership (bash): socket-stdin bash -c keeps a caller venv first" \
      "$OWN_VENV:$OWN_HOME/.local/bin:/usr/local/bin:/usr/bin:$OWN_BREW_BINS" \
      "$(socket_stdin env -i HOME="$OWN_HOME" \
        PATH="$OWN_VENV:/usr/local/bin:/usr/bin:$OWN_BREW_BINS" \
        "$BASH_BIN" -c 'printf %s "$PATH"' 2>/dev/null)"
  fi
  _assert_eq "env ownership (bash): socket-stdin login shell stays authoritative" \
    "$OWN_RG" \
    "$(socket_stdin env -i HOME="$OWN_HOME" PATH=/usr/bin:/bin \
      RIPGREP_CONFIG_PATH=/stale "$BASH_BIN" -l -c 'printf %s "$RIPGREP_CONFIG_PATH"' 2>/dev/null)"
else
  echo "  SKIP: socket-stdin cases need python3"
fi

# Only SSH_SOURCE_BASHRC builds (Fedora/RHEL, Debian) read ~/.bashrc for a
# bare SSH_CLIENT; elsewhere nothing loads and the filled value stays unset.
rshd_out=$(sshd_run PATH=/usr/bin:/bin SSH_CLIENT='192.0.2.1 22 22' \
  RIPGREP_CONFIG_PATH=/caller/rg "$BASH_BIN" -c "$PROBE_RSHD" </dev/null)
# shellcheck disable=SC2016 # probes expand in the child shells.
if [ "$rshd_out" = "/caller/rg|unset" ]; then
  echo "  SKIP: this bash does not read ~/.bashrc for SSH_CLIENT commands"
else
  _assert_eq "env ownership (bash): sshd bash -c keeps caller values" \
    "/caller/rg|$OWN_HOME/.config/shdeps" "$rshd_out"
  _assert_eq "env ownership (bash): sshd login shell stays authoritative" \
    "$OWN_RG" \
    "$(sshd_run PATH=/usr/bin:/bin SSH_CLIENT='192.0.2.1 22 22' \
      RIPGREP_CONFIG_PATH=/stale "$BASH_BIN" -l -c 'printf %s "$RIPGREP_CONFIG_PATH"' </dev/null)"
fi

echo ""
echo "=== env ownership: env.d writers use _shell_env_set ==="

# Ownership tracking needs every env.d writer of a managed name to use
# _shell_env_set: a plain export from an earlier fragment looks inherited to
# later ones, and a plain export always overwrites a caller's value. The
# checker allows the `${NAME:-default}` form (yields in every mode) and names
# whose merge logic lives in the fragment itself (PATH, MANPATH). Overlay
# fragments are symlinks in an installed home and are checked by their own
# suites with the same checker.
ENV_D_CHECK="${BASH_SOURCE[0]%/*}/support/env-d-plain-exports.awk"
env_d_plain_exports() {
  awk -v allow="PATH MANPATH" -f "$ENV_D_CHECK" "$@"
}
env_d_base_files=()
for env_d_f in "$REAL_HOME"/.config/shell/env.d/*.sh \
  "$REAL_HOME"/.config/shell/env.d/*.bash "$REAL_HOME"/.config/shell/env.d/*.zsh; do
  [ -f "$env_d_f" ] && [ ! -L "$env_d_f" ] && env_d_base_files+=("$env_d_f")
done
_assert_eq "env.d: base fragments export managed names only via _shell_env_set" \
  "" "$(env_d_plain_exports "${env_d_base_files[@]}")"
env_d_bad=$TEST_TMPDIR/env-d-bad.sh
# One case per line; the expected list below names the lines to flag.
cat >"$env_d_bad" <<'EOF'
export LANG="${LANG:-C}"
export FOO="${FOO:-x}" BAR=1
export SHDEPS_CONF_DIR="$HOME/.config/shdeps"
: && export BASH_ENV=x
export OTHER="${FOO:-x}"
# export COMMENTED=1
export PATH
X=1; export X
typeset -gx E=1
declare -x P=1
export "V=1"
export PAGER_OK="${PAGER_OK:-sh -c 'col -bx | bat'}" MANPATH="$HOME/man"
export -n GONE
_shell_env_set RG x # export in comment
if true; then export IN_IF=1; fi
EOF
_assert_eq "env.d: plain-export check flags every direct export" \
  "2 3 4 5 8 9 10 11 15" \
  "$(env_d_plain_exports "$env_d_bad" | cut -d: -f2 | paste -sd' ' -)"

_test_summary
