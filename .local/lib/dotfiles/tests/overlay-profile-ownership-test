class Invalid(Exception):
    """An ownership inventory invariant was violated."""


def git(*args: str, cwd: Path = ROOT) -> str:
    result = subprocess.run(
        ["git", "-C", str(cwd), *args],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode:
        raise Invalid(result.stderr.strip() or f"git {' '.join(args)} failed")
    return result.stdout


def load_tsv(path: Path, header: tuple[str, ...]) -> list[dict[str, str]]:
    if not path.is_file():
        raise Invalid(f"missing inventory: {path.relative_to(ROOT)}")
    lines = path.read_text(encoding="utf-8").splitlines()
    if not lines:
        raise Invalid(f"empty inventory: {path.relative_to(ROOT)}")
    actual_header = tuple(lines[0].split("\t"))
    if actual_header != header:
        raise Invalid(f"malformed header in {path.relative_to(ROOT)}")

    rows: list[dict[str, str]] = []
    for number, line in enumerate(lines[1:], 2):
        fields = line.split("\t")
        if len(fields) != len(header) or any(not field for field in fields):
            raise Invalid(f"malformed row {path.relative_to(ROOT)}:{number}")
        rows.append(dict(zip(header, fields, strict=True)))
    return rows


def note_value(note: str, key: str) -> str | None:
    """Return one semicolon-delimited manifest annotation value."""

    values: dict[str, str] = {}
    for field in note.split(";"):
        field = field.strip()
        if "=" not in field:
            continue
        item_key, value = field.split("=", 1)
        if item_key in values:
            raise Invalid(f"duplicate ownership annotation: {item_key}")
        values[item_key] = value
    return values.get(key)


