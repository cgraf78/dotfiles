#!/usr/bin/env bash
# Run exactly the base/control-plane suites owned by this repository.

set -euo pipefail

root=$(cd -P -- "${BASH_SOURCE[0]%/*}/../../../.." && pwd -P)
inventory=$root/.github/dot-test-suites.txt
tests_rel=.local/lib/dotfiles/tests
# Suites that need this resolved CI runtime live one level down. Dot discovers
# only top-level `*-test` files, so ordinary `dot test` never lists them; this
# script selects them explicitly with a second, directory-scoped invocation.
ci_only_rel=$tests_rel/ci-only

# shellcheck source=dot-runtime-resolve.sh
. "$root/.local/lib/dotfiles/tests/dot-runtime-resolve.sh"

_require_runtime() {
  local expected resolved actual origin
  [[ ${DOT_STACK_RUNTIME:-0} == 1 ]] || {
    printf 'run-ci: must run through stack-dot-runtime\n' >&2
    return 1
  }
  expected=${DOT_STACK_DOT_SHA:-}
  [[ $expected =~ ^[0-9a-f]{40}$ && ${DOT_STACK_DOT_ROOT:-} == /* ]] ||
    return 1
  resolved=$(command -v dot 2>/dev/null) || return 1
  [[ $resolved == "${DOT_STACK_DOT_BIN:-}" &&
    -x $DOT_STACK_DOT_BIN && ! -L $DOT_STACK_DOT_BIN ]] || return 1
  if _dot_runtime_is_release_root "$DOT_STACK_DOT_ROOT"; then
    # Releases have no Git remote to compare; the binary's own version tag
    # binds it to the resolved tag and commit instead.
    [[ $DOT_STACK_DOT_BIN == "$DOT_STACK_DOT_ROOT/dot" ]] || return 1
    actual=$(_dot_release_version_tag "$DOT_STACK_DOT_BIN" 2>/dev/null) ||
      return 1
    [[ $expected == "${actual##*-}"* ]] || return 1
    [[ -z ${DOT_STACK_DOT_RELEASE_TAG:-} ||
      $actual == "$DOT_STACK_DOT_RELEASE_TAG" ]]
  else
    [[ $DOT_STACK_DOT_BIN == "$DOT_STACK_DOT_ROOT/bin/dot" ]] || return 1
    actual=$(git -C "$DOT_STACK_DOT_ROOT" rev-parse HEAD 2>/dev/null) ||
      return 1
    origin=$(git -C "$DOT_STACK_DOT_ROOT" remote get-url origin 2>/dev/null) ||
      return 1
    [[ $actual == "$expected" && $origin == "${DOT_STACK_DOT_ORIGIN:-}" ]]
  fi
}

_require_candidate() {
  local actual
  [[ ${GITHUB_ACTIONS:-false} == true ]] || return 0
  [[ ${DOTFILES_CANDIDATE_SHA:-} =~ ^[0-9a-f]{40}$ ]] || return 1
  actual=$(git -C "$root" rev-parse HEAD 2>/dev/null) || return 1
  [[ $actual == "$DOTFILES_CANDIDATE_SHA" ]]
}

_require_candidate || {
  printf 'run-ci: checkout does not match the event candidate head\n' >&2
  exit 1
}

_require_runtime || {
  printf 'run-ci: resolved Dot runtime assertion failed\n' >&2
  exit 1
}

[[ -f $inventory && ! -L $inventory ]] || {
  printf 'run-ci: missing suite inventory: %s\n' "$inventory" >&2
  exit 1
}

declare -A seen=()
declare -a paths=() suites=() ci_only_suites=()
while IFS= read -r path || [[ -n $path ]]; do
  # A row names either a top-level suite or a CI-only suite; anything deeper
  # would be neither discovered locally nor selected here.
  suite=${path##*/}
  [[ ($path == "$tests_rel/$suite" || $path == "$ci_only_rel/$suite") &&
    $suite == ?*-test && $path != *'..'* && $path != *' '* ]] || {
    printf 'run-ci: invalid suite inventory row: %s\n' "$path" >&2
    exit 1
  }
  [[ -z ${seen[$path]+x} ]] || {
    printf 'run-ci: duplicate suite inventory row: %s\n' "$path" >&2
    exit 1
  }
  seen["$path"]=1
  [[ -f $root/$path && -x $root/$path && ! -L $root/$path ]] || {
    printf 'run-ci: missing executable suite: %s\n' "$path" >&2
    exit 1
  }
  paths+=("$path")
  if [[ $path == "$ci_only_rel/"* ]]; then
    ci_only_suites+=("${suite%-test}")
  else
    suites+=("${suite%-test}")
  fi
done <"$inventory"
((${#paths[@]} > 0)) || {
  printf 'run-ci: suite inventory is empty\n' >&2
  exit 1
}

declare -a discovered=()
shopt -s nullglob
for suite_path in "$root/$tests_rel"/*-test "$root/$ci_only_rel"/*-test; do
  [[ -f $suite_path && -x $suite_path && ! -L $suite_path ]] || continue
  discovered+=("${suite_path#"$root"/}")
done
shopt -u nullglob

expected=$(printf '%s\n' "${paths[@]}" | sort)
actual=$(printf '%s\n' "${discovered[@]+"${discovered[@]}"}" | sort)
[[ $actual == "$expected" ]] || {
  printf 'run-ci: executable suite inventory differs\n' >&2
  diff -u <(printf '%s\n' "$expected") <(printf '%s\n' "$actual") >&2 || true
  exit 1
}

if [[ ${1:-} == --validate-only ]]; then
  [[ $# -eq 1 ]] || exit 2
  printf 'run-ci: inventory valid (%s suites, %s CI-only)\n' \
    "${#paths[@]}" "${#ci_only_suites[@]}"
  exit 0
fi
[[ $# -eq 0 ]] || exit 2

export DOT_TEST_DOT_ROOT=$DOT_STACK_DOT_ROOT
export DOT_TEST_SOURCE_HOME=$root
cd "$root"

# Run one suite set from one discovery directory.
_run_set() {
  local directory=$1
  shift
  # Reassert immediately before executing each selected suite set. The direct
  # path and PATH resolution must still identify the same immutable Dot
  # checkout.
  _require_candidate || {
    printf 'run-ci: candidate checkout changed before test execution\n' >&2
    exit 1
  }
  _require_runtime || {
    printf 'run-ci: resolved Dot runtime changed before test execution\n' >&2
    exit 1
  }
  (
    # The control-plane tag selected this runtime; suites resolve their own
    # (offline probes pin fixture revisions, the live suite floats its fleet
    # tag). Do not leak the ambient tag into stubbed-origin probes. Scope the
    # unset to the child so the next reassertion still checks the tag.
    unset DOT_STACK_DOT_RELEASE_TAG DOT_STACK_DOT_RELEASE_REPO
    export DOT_TEST_TESTS_DIR=$root/$directory
    exec "$DOT_STACK_DOT_BIN" test "$@"
  )
}

# Run both sets even when the first fails so one CI log reports every failing
# suite, then exit with the first failing status.
status=0
if ((${#suites[@]} > 0)); then
  _run_set "$tests_rel" "${suites[@]}" || status=$?
fi
if ((${#ci_only_suites[@]} > 0)); then
  rc=0
  _run_set "$ci_only_rel" "${ci_only_suites[@]}" || rc=$?
  ((status != 0)) || status=$rc
fi
exit "$status"
