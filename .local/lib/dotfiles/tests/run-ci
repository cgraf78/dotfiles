#!/usr/bin/env bash
# Run exactly the base/control-plane suites owned by this repository.

set -euo pipefail

root=$(cd -P -- "${BASH_SOURCE[0]%/*}/../../../.." && pwd -P)
inventory=$root/.github/dot-test-suites.txt
lock=$root/.github/overlay-profile-stack.lock
if [[ -n ${DOT_STACK_LOCK_PATH:-} ]]; then
  if [[ ${DOT_TEST:-0} != 1 && $DOT_STACK_LOCK_PATH != "$lock" ]]; then
    printf 'run-ci: production lock path cannot be overridden\n' >&2
    exit 1
  fi
  lock=$DOT_STACK_LOCK_PATH
fi

_stack_value() {
  local key=$1
  awk -F= -v key="$key" '$1 == key { count++; value=$2 } END {
    if (count == 1) print value; else exit 1
  }' "$lock"
}

_require_runtime() {
  local expected resolved actual origin
  [[ ${DOT_STACK_RUNTIME:-0} == 1 ]] || {
    printf 'run-ci: must run through stack-dot-runtime\n' >&2
    return 1
  }
  expected=$(_stack_value dot) || return 1
  [[ $expected =~ ^[0-9a-f]{40}$ &&
    ${DOT_STACK_DOT_SHA:-} == "$expected" &&
    ${DOT_STACK_DOT_ROOT:-} == /* &&
    ${DOT_STACK_DOT_BIN:-} == "$DOT_STACK_DOT_ROOT/bin/dot" ]] || return 1
  actual=$(git -C "$DOT_STACK_DOT_ROOT" rev-parse HEAD 2>/dev/null) || return 1
  origin=$(git -C "$DOT_STACK_DOT_ROOT" remote get-url origin 2>/dev/null) || return 1
  resolved=$(command -v dot 2>/dev/null) || return 1
  [[ $actual == "$expected" && $resolved == "$DOT_STACK_DOT_BIN" &&
    $origin == "${DOT_STACK_DOT_ORIGIN:-}" &&
    -x $DOT_STACK_DOT_BIN && ! -L $DOT_STACK_DOT_BIN ]]
}

_require_candidate() {
  local actual
  [[ ${GITHUB_ACTIONS:-false} == true ]] || return 0
  [[ ${DOTFILES_CANDIDATE_SHA:-} =~ ^[0-9a-f]{40}$ ]] || return 1
  actual=$(git -C "$root" rev-parse HEAD 2>/dev/null) || return 1
  [[ $actual == "$DOTFILES_CANDIDATE_SHA" ]]
}

_require_candidate || {
  printf 'run-ci: checkout does not match the event candidate head\n' >&2
  exit 1
}

_require_runtime || {
  printf 'run-ci: locked D1 runtime assertion failed\n' >&2
  exit 1
}

[[ -f $inventory && ! -L $inventory ]] || {
  printf 'run-ci: missing suite inventory: %s\n' "$inventory" >&2
  exit 1
}

declare -A seen=()
declare -a paths=() suites=()
while IFS= read -r path || [[ -n $path ]]; do
  [[ $path == .local/lib/dotfiles/tests/*-test &&
    $path != *'..'* && $path != *' '* ]] || {
    printf 'run-ci: invalid suite inventory row: %s\n' "$path" >&2
    exit 1
  }
  [[ -z ${seen[$path]+x} ]] || {
    printf 'run-ci: duplicate suite inventory row: %s\n' "$path" >&2
    exit 1
  }
  seen["$path"]=1
  [[ -f $root/$path && -x $root/$path && ! -L $root/$path ]] || {
    printf 'run-ci: missing executable suite: %s\n' "$path" >&2
    exit 1
  }
  paths+=("$path")
  suite=${path##*/}
  suites+=("${suite%-test}")
done <"$inventory"
((${#paths[@]} > 0)) || {
  printf 'run-ci: suite inventory is empty\n' >&2
  exit 1
}

declare -a discovered=()
shopt -s nullglob
for suite_path in "$root"/.local/lib/dotfiles/tests/*-test; do
  [[ -f $suite_path && -x $suite_path && ! -L $suite_path ]] || continue
  discovered+=("${suite_path#"$root"/}")
done
shopt -u nullglob

expected=$(printf '%s\n' "${paths[@]}" | sort)
actual=$(printf '%s\n' "${discovered[@]+"${discovered[@]}"}" | sort)
[[ $actual == "$expected" ]] || {
  printf 'run-ci: executable suite inventory differs\n' >&2
  diff -u <(printf '%s\n' "$expected") <(printf '%s\n' "$actual") >&2 || true
  exit 1
}

if [[ ${1:-} == --validate-only ]]; then
  [[ $# -eq 1 ]] || exit 2
  printf 'run-ci: inventory valid (%s suites)\n' "${#suites[@]}"
  exit 0
fi
[[ $# -eq 0 ]] || exit 2

# Reassert immediately before executing the selected suite set. The direct
# path and PATH resolution must still identify the same immutable D1 checkout.
_require_candidate || {
  printf 'run-ci: candidate checkout changed before test execution\n' >&2
  exit 1
}
_require_runtime || {
  printf 'run-ci: locked D1 runtime changed before test execution\n' >&2
  exit 1
}
export DOT_TEST_DOT_ROOT=$DOT_STACK_DOT_ROOT
export DOT_TEST_SOURCE_HOME=$root
export DOT_TEST_TESTS_DIR=$root/.local/lib/dotfiles/tests
cd "$root"
exec "$DOT_STACK_DOT_BIN" test "${suites[@]}"
