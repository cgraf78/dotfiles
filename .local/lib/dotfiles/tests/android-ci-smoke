#!/usr/bin/env bash
# android-ci-smoke — validate always-active Android policy in real Termux.

set -euo pipefail

fail() {
  printf 'android-ci-smoke: FAIL: %s\n' "$1" >&2
  exit 1
}

[[ ${PREFIX:-} == *com.termux*/usr ]] || fail 'PREFIX is not a Termux prefix'
[[ $(uname -o) == Android ]] || fail 'uname does not report Android'
command -v pkg >/dev/null || fail 'Termux pkg command is unavailable'

root=${DOTFILES_ROOT:-$PWD}
deps=$root/.config/shdeps/10-deps.conf
tmux_hook=$root/.config/shdeps/hooks.d/tmux.sh
[[ -r $deps && -r $tmux_hook ]] || fail 'base Shdeps policy is unavailable'

awk '$1 == "fd" && $2 == "pkg" && $0 ~ /android:fd/ { found = 1 }
     END { exit !found }' "$deps" || fail 'fd lacks its Android package mapping'
awk '$1 == "tmux" && $2 == "custom" { found = 1 }
     END { exit !found }' "$deps" || fail 'tmux lacks its base custom declaration'
grep -Fq 'shdeps_pkg_install_for_mgr android:tmux' "$tmux_hook" ||
  fail 'tmux hook does not retain native Android package ownership'

for command_name in git tmux rg; do
  command -v "$command_name" >/dev/null ||
    fail "base command is unavailable: $command_name"
done
tmux -V >/dev/null 2>&1 || fail 'Termux tmux binary does not run'
rg --version >/dev/null 2>&1 || fail 'Termux ripgrep binary does not run'

printf 'Android Termux base policy smoke passed\n'
