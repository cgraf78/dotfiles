#!/usr/bin/env bash
# mise-refresh-workflow-test - scheduled Mise lock refresh policy.
# shellcheck disable=SC2016 # Assertions intentionally match literal workflow expressions.

set -euo pipefail
export NO_COLOR=1

# shellcheck source=.local/lib/dotfiles/tests/helpers.sh
. "${BASH_SOURCE[0]%/*}/helpers.sh"

workflow="$HOME/.github/workflows/update-mise-lock.yml"
if [[ ! -f "$workflow" ]]; then
  _fail "Mise refresh: workflow exists"
  _test_summary
fi

actions_lock=$(tr -d '\n' <"$HOME/.github/cgraf78-actions.lock")
if [[ ! "$actions_lock" =~ ^[0-9a-f]{40}$ ]]; then
  _fail "Mise refresh: shared Actions lock is a full commit SHA"
  _test_summary
fi

content=$(<"$workflow")
_assert_contains "Mise refresh: runs weekly off the top of the hour" \
  'cron: "43 6 * * 1"' "$content"
_assert_contains "Mise refresh: manual runs remain available" \
  'workflow_dispatch:' "$content"
_assert_contains "Mise refresh: workflow permissions default to none" \
  'permissions: {}' "$content"
_assert_contains "Mise refresh: caller uses the synchronized shared workflow" \
  "uses: cgraf78/actions/.github/workflows/mise-lock-refresh.yml@$actions_lock" \
  "$content"
_assert_contains "Mise refresh: caller can publish the update branch" \
  'contents: write' "$content"
_assert_contains "Mise refresh: caller can manage the update PR" \
  'pull-requests: write' "$content"
_assert_contains "Mise refresh: project name is explicit" \
  'project_name: Dotfiles' "$content"
_assert_contains "Mise refresh: config path is explicit" \
  'mise_config_file: .config/mise/config.toml' "$content"
_assert_contains "Mise refresh: lock path is explicit" \
  'mise_lock_file: .config/mise/mise.lock' "$content"
_assert_contains "Mise refresh: repository-only automation key is reused" \
  'deploy_key: ${{ secrets.DOTFILES_SCHEMA_REFRESH_DEPLOY_KEY }}' "$content"

for duplicated_implementation in \
  'runs-on:' \
  'steps:' \
  'jdx/mise-action@' \
  'gh pr create' \
  'gh pr merge' \
  'git push'; do
  _assert_not_contains \
    "Mise refresh: caller does not duplicate $duplicated_implementation" \
    "$duplicated_implementation" "$content"
done

_test_summary
