#!/usr/bin/env bash
# Verify the final top-level tree is a development-tool-free base profile.

set -u

source_home=${DOT_TEST_SOURCE_HOME:-$HOME}

# shellcheck source=helpers.sh
. "$source_home/.local/lib/dotfiles/tests/helpers.sh"
# shellcheck source=profile-ownership-policy.sh
. "$source_home/.local/lib/dotfiles/tests/profile-ownership-policy.sh"

ownership_policy=$source_home/.local/lib/dotfiles/tests/profile-ownership-policy.tsv

_assert_policy_invalid() {
  local description=$1 content=$2 fixture
  fixture=$(_tmpfile)
  printf '%s' "$content" >"$fixture"
  if dot_profile_ownership_policy_validate "$fixture" >/dev/null 2>&1; then
    _fail "$description"
  else
    _pass "$description"
  fi
}

_base_tracked_paths() {
  if [[ -e $source_home/.git || -L $source_home/.git ]]; then
    git -C "$source_home" ls-files -- "$@"
  else
    git --git-dir="$source_home/.dotfiles" --work-tree="$source_home" \
      ls-files -- "$@"
  fi
}

_assert_base_unowned() {
  local description=$1 path=$2 tracked
  tracked=$(_base_tracked_paths "$path")
  if [[ -z $tracked ]]; then
    _pass "$description"
  else
    _fail "$description (unexpected base-owned path: $tracked)"
  fi
}

_test_prefer_system_git || {
  _fail 'base boundary has an isolated system Git'
  _test_summary
}
system_git=$(type -P git)
controlled_bin=$(_tmpdir)
ln -s "$system_git" "$controlled_bin/git"
if PATH=$controlled_bin command -v git >/dev/null 2>&1; then
  _pass 'base retains raw Git for bootstrap and overlay transport'
else
  _fail 'base retains raw Git for bootstrap and overlay transport'
fi
if PATH=$controlled_bin command -v nvim >/dev/null 2>&1; then
  _fail 'base controlled PATH excludes Nvim'
else
  _pass 'base controlled PATH excludes Nvim'
fi

if dot_profile_ownership_policy_validate "$ownership_policy"; then
  _pass 'profile ownership policy is valid'
else
  _fail 'profile ownership policy is valid'
fi

_assert_policy_invalid 'ownership policy rejects a malformed header' \
  $'owner\tfamily\tpathspec\nbase\tprofile-control\t.config/dot/config\n'
_assert_policy_invalid 'ownership policy rejects an unknown owner' \
  $'owners\tfamily\tpathspec\nunknown\tprofile-control\t.config/dot/config\n'
_assert_policy_invalid 'ownership policy rejects an invalid family' \
  $'owners\tfamily\tpathspec\nbase\tProfile Control\t.config/dot/config\n'
_assert_policy_invalid 'ownership policy rejects an unsafe pathspec' \
  $'owners\tfamily\tpathspec\nbase\tprofile-control\t../config\n'
_assert_policy_invalid 'ownership policy rejects a duplicate pathspec' \
  $'owners\tfamily\tpathspec\nbase\tone\t.config/dot/config\nbase\tone\t.config/dot/config\n'
_assert_policy_invalid 'ownership policy keeps each family with one owner set' \
  $'owners\tfamily\tpathspec\neditor\tnvim\t.config/nvim/init.lua\ndev\tnvim\t.config/nvim/dev.lua\n'

forbidden_pathspecs=()
while IFS= read -r pathspec; do
  forbidden_pathspecs[${#forbidden_pathspecs[@]}]=$pathspec
done < <(dot_profile_ownership_forbidden "$ownership_policy" base)
base_ownership_violations=$(_base_tracked_paths "${forbidden_pathspecs[@]}")
_assert_eq 'base excludes editor-, dev-, and local-owned namespaces' \
  '' "$base_ownership_violations"

deps=$source_home/.config/shdeps/10-deps.conf
_assert_contains 'base dependencies retain agent-rules-sync' \
  'cgraf78/agent-rules-sync' "$(<"$deps")"
_assert_contains 'base dependencies retain tmux' \
  $'tmux\t' "$(tr -s '[:space:]' '\t' <"$deps")"
if grep -Eq '(^|/)(neovim|mise|git-tools|checkrun|agentguard)([[:space:]]|$)' \
  "$deps"; then
  _fail 'base dependencies exclude editor and development tooling'
else
  _pass 'base dependencies exclude editor and development tooling'
fi

for hook in \
  .config/shdeps/hooks.d/cargo.sh \
  .config/shdeps/hooks.d/neovim/neovim.sh \
  .local/lib/dotfiles/merge-hooks.d/mise.sh \
  .local/lib/dotfiles/merge-hooks.d/nvim.sh; do
  _assert_base_unowned 'base excludes a capability-owned hook' "$hook"
done

_test_summary
