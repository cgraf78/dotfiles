#!/usr/bin/env bash
# Client policy compatibility against the standalone dot extension contract.

set -u

source_home=${DOT_TEST_SOURCE_HOME:-$HOME}
host_home=${DOT_TEST_HOST_HOME:-$HOME}

# shellcheck source=helpers.sh
. "$source_home/.local/lib/dotfiles/tests/helpers.sh"
_test_prefer_system_git first || exit 1

_client_dot_root() {
  local candidate

  for candidate in \
    "${DOT_TEST_DOT_ROOT:-}" \
    "$host_home/git/dot" \
    "$host_home/.local/share/cgraf78/dot"; do
    [[ -n $candidate && -r $candidate/lib/dot/extension-worker.sh ]] || continue
    (cd -P -- "$candidate" && pwd -P)
    return
  done

  printf 'client extensions: standalone dot checkout not found\n' >&2
  return 1
}

dot_root=$(_client_dot_root) || {
  _fail 'client extensions: standalone dot checkout is available'
  _test_summary
}
fixture_home=$(_tmpdir)
mkdir -p "$fixture_home/.config/dot/overlays.d" "$fixture_home/.ssh"
chmod 0700 "$fixture_home" "$fixture_home/.ssh"
client_active_overlay_records=()

# Mirror only the executable client surface into the fixture HOME. A composed
# checkout can contain overlay-owned symlinks here; validating those links from
# a different HOME would correctly fail because the worker would see neither
# their overlay checkouts nor the private publication manifest. Recreate that
# authority with local, no-network clones so the test exercises the same
# symlink validation as production without executing hooks against live state.
_client_extension_fixture() {
  local source_client=$source_home/.local/lib/dotfiles
  local conf name url source_overlay fixture_overlay extension_dir
  local link source_link source_resolved fixture_resolved target rel authority
  local authority_name authority_source authority_fixture source_overlay_home
  local fixture_overlay_home owner manifest fixture_conf optional
  local -a authorities=()

  mkdir -p "$fixture_home/.local/lib/dotfiles" "$fixture_home/.config/git"
  for extension_dir in merge-hooks.d doctor.d pre-sync.d; do
    cp -R "$source_client/$extension_dir" \
      "$fixture_home/.local/lib/dotfiles/" || return 1
  done

  for conf in "$source_home"/.config/dot/overlays.d/*.conf; do
    [[ -f $conf ]] || continue
    cp "$conf" "$fixture_home/.config/dot/overlays.d/" || return 1
    name=${conf##*/}
    name=${name%.conf}
    if [[ $name =~ ^[0-9]+-(.+)$ ]]; then
      name=${BASH_REMATCH[1]}
    fi
    url=$(sed -n 's/^url=//p' "$conf")
    source_overlay=$source_home/.dotfiles-$name
    [[ -d $source_overlay ]] || source_overlay=$host_home/.dotfiles-$name
    fixture_overlay=$fixture_home/.dotfiles-$name
    [[ -n $url && -d $source_overlay ]] || continue
    git -C "$source_overlay" rev-parse --is-inside-work-tree \
      >/dev/null 2>&1 || continue
    git -c core.hooksPath=/dev/null clone --quiet --no-local \
      "$source_overlay" "$fixture_overlay" || return 1
    git -C "$fixture_overlay" remote set-url origin "$url" || return 1
    authorities+=("$name|$source_overlay|$fixture_overlay")
    fixture_conf=$fixture_home/.config/dot/overlays.d/${conf##*/}
    optional=$(sed -n 's/^optional=//p' "$fixture_conf")
    [[ -n $optional ]] || optional=false
    client_active_overlay_records+=(
      "$name|$fixture_overlay|$url|$fixture_conf|$optional|git"
    )
  done

  manifest=$fixture_home/.local/state/dot/overlay-links
  mkdir -p "${manifest%/*}" || return 1
  : >"$manifest" || return 1
  chmod 0600 "$manifest" || return 1

  while IFS= read -r -d '' link; do
    source_link=$source_home/${link#"$fixture_home"/}
    source_resolved=$(_test_realpath "$source_link") || return 1
    fixture_resolved=$(_test_realpath "$link") || return 1
    owner=
    for authority in "${authorities[@]+"${authorities[@]}"}"; do
      IFS='|' read -r authority_name authority_source authority_fixture \
        <<<"$authority"
      source_overlay_home=$(_test_realpath "$authority_source/home") || return 1
      fixture_overlay_home=$(_test_realpath "$authority_fixture/home") || return 1
      case $source_resolved in
        "$source_overlay_home"/*)
          case $fixture_resolved in
            "$fixture_overlay_home"/*) owner=$authority_name ;;
            *) return 1 ;;
          esac
          break
          ;;
      esac
    done
    [[ -n $owner ]] || return 1
    target=$(readlink "$link") || return 1
    rel=${link#"$fixture_home"/}
    printf '%s\t%s\t%s\n' "$rel" "$owner" "$target" >>"$manifest" || return 1
  done < <(find "$fixture_home/.local/lib/dotfiles" -type l -print0)

  # Always exercise an overlay-owned extension, including in public CI where
  # optional private overlays are intentionally unavailable. This prevents a
  # base-only checkout from hiding a missing active-overlay worker context.
  name=test-overlay
  url=https://example.invalid/cgraf78/dotfiles-test-overlay.git
  fixture_overlay=$fixture_home/.dotfiles-$name
  fixture_conf=$fixture_home/.config/dot/overlays.d/99-$name.conf
  extension_dir=$fixture_overlay/home/.local/lib/dotfiles/merge-hooks.d
  mkdir -p "$extension_dir" || return 1
  cat >"$extension_dir/test-overlay.sh" <<'HOOK'
merge() {
  :
}
HOOK
  git -c init.defaultBranch=main init --quiet "$fixture_overlay" || return 1
  git -C "$fixture_overlay" remote add origin "$url" || return 1
  printf 'url=%s\n' "$url" >"$fixture_conf" || return 1
  link=$fixture_home/.local/lib/dotfiles/merge-hooks.d/test-overlay.sh
  target=../../../../.dotfiles-$name/home/.local/lib/dotfiles/merge-hooks.d/test-overlay.sh
  ln -s "$target" "$link" || return 1
  rel=${link#"$fixture_home"/}
  printf '%s\t%s\t%s\n' "$rel" "$name" "$target" >>"$manifest" || return 1
  client_active_overlay_records+=(
    "$name|$fixture_overlay|$url|$fixture_conf|false|git"
  )
}

if ! _client_extension_fixture; then
  _fail 'client extensions: isolated composed authority is available'
  _test_summary
fi
client_root=$fixture_home/.local/lib/dotfiles

export DOT_SOURCE_ROOT=$dot_root
export DOT_EXTENSIONS_DIR=$client_root
export DOT_EXTENSION_API=1
export DOT_QUIET=1
export HOME=$fixture_home
# The fixture owns its HOME-derived client config. Hosted runners may export
# unrelated XDG roots; do not let those redirect the descriptor under test.
unset XDG_CONFIG_HOME XDG_STATE_HOME XDG_CACHE_HOME XDG_DATA_HOME XDG_RUNTIME_DIR

# shellcheck source=/dev/null
. "$dot_root/lib/dot/public/xdg.sh"
# The standalone worker gained a required one-use overlay context after this
# pre-profile client was published. Keep this compatibility test runnable with
# both sides of that independently deployable boundary.
client_worker_context=0
if [[ -r $dot_root/lib/dot/overlay-context.sh ]]; then
  # shellcheck source=/dev/null
  . "$dot_root/lib/dot/overlay-context.sh"
  client_worker_context=1
fi
# shellcheck source=/dev/null
. "$dot_root/lib/dot/extension-worker-launch.sh"

_client_worker_run() {
  local mode=$1 script=$2 stage=${3:-none}
  shift 3
  local temporary result output context token set_kind=active rc=0
  local -a records=("$@")

  temporary=$(_tmpdir)
  chmod 0700 "$temporary"
  result=$temporary/result
  : >"$result"
  chmod 0600 "$result"
  if [[ $client_worker_context -eq 1 ]]; then
    [[ $mode != pre-sync ]] || set_kind=eligible
    _dot_overlay_context_create "$temporary" "$mode" "$set_kind" "$stage" \
      "${records[@]+"${records[@]}"}" || return 1
    context=$REPLY_PATH
    token=$REPLY_TOKEN
    output=$(PATH=${CLIENT_WORKER_PATH:-/usr/bin:/bin} _dot_extension_worker_run \
      "$mode" "$script" "$temporary" "$result" "$context" "$token" \
      2>&1) || rc=$?
  else
    output=$(PATH=${CLIENT_WORKER_PATH:-/usr/bin:/bin} _dot_extension_worker_run \
      "$mode" "$script" "$temporary" "$result" 2>&1) || rc=$?
  fi
  if [[ -n $output ]]; then
    printf '%s\n' "$output" >&2
    return 1
  fi
  return "$rc"
}

client_crontab=$(_tmpdir)/crontab
cat >"$client_crontab" <<'CRONTAB'
#!/usr/bin/env bash
set -u

case ${1:-} in
  -l) exit 1 ;;
  -) cat >/dev/null ;;
  -r) : ;;
  *) exit 64 ;;
esac
CRONTAB
chmod +x "$client_crontab"
export DOT_TEST_CRONTAB=$client_crontab

for hook in "$client_root/merge-hooks.d"/*.sh; do
  if CLIENT_WORKER_PATH=/usr/bin:/bin _client_worker_run merge "$hook" none \
    "${client_active_overlay_records[@]+"${client_active_overlay_records[@]}"}"; then
    _pass "client merge hook loads through standalone worker: ${hook##*/}"
  else
    _fail "client merge hook loads through standalone worker: ${hook##*/}"
  fi
done

windows_home=$fixture_home/windows-home
wezterm_worker_bin=$(_tmpdir)
cat >"$wezterm_worker_bin/wezterm" <<'WEZTERM'
#!/usr/bin/env bash
exit 0
WEZTERM
chmod +x "$wezterm_worker_bin/wezterm"
mkdir -p "$fixture_home/.config/wezterm" "$windows_home"
printf 'return {}\n' >"$fixture_home/.config/wezterm/wezterm.lua"
if CLIENT_WORKER_PATH="$wezterm_worker_bin:/usr/bin:/bin" \
  WSL_DISTRO_NAME=Ubuntu DOT_TEST_WINDOWS_HOME=$windows_home \
  DOT_TEST_WSL_PAIRED_ACCOUNT=1 DOT_QUIET=1 \
  _client_worker_run merge "$client_root/merge-hooks.d/wezterm.sh" none \
  "${client_active_overlay_records[@]+"${client_active_overlay_records[@]}"}"; then
  _pass 'client WSL worker runs WezTerm hook through public platform API'
else
  _fail 'client WSL worker runs WezTerm hook through public platform API'
fi
_assert_file_content 'client WSL worker copies WezTerm config through public platform API' \
  'return {}' "$windows_home/.wezterm.lua"

for extension in "$client_root/doctor.d"/[0-9]*.sh; do
  if _client_worker_run doctor "$extension" none \
    "${client_active_overlay_records[@]+"${client_active_overlay_records[@]}"}"; then
    _pass "client doctor extension loads through standalone worker: ${extension##*/}"
  else
    _fail "client doctor extension loads through standalone worker: ${extension##*/}"
  fi
done

old_reference_output=$(
  grep -RInE \
    '\.local/lib/dot/(core|git-hooks|sley-hooks)|\.config/dot/merge-hooks\.d/codex/(api|refresh-trust|toml-render)' \
    "$client_root/merge-hooks.d" "$client_root/doctor.d" 2>/dev/null || true
)
_assert_eq 'dormant client extensions do not source embedded implementation paths' \
  '' "$old_reference_output"

cat >"$fixture_home/.config/dot/overlays.d/10-private.ssh" <<'SSH'
Host github-private
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_private
SSH
cat >"$fixture_home/.ssh/config" <<'SSH'
Host github.com
  HostName github.com
  ProxyCommand ssh proxy.example -W %h:%p

Host hand-managed
  HostName hand.example
SSH

pre_sync=$client_root/pre-sync.d/10-overlay-ssh.sh
private_record="private|$fixture_home/.dotfiles-private|https://example.invalid/private.git|$fixture_home/.config/dot/overlays.d/10-private.conf|true|git"
if _client_worker_run pre-sync "$pre_sync" prepare "$private_record"; then
  _pass 'client pre-sync SSH policy runs through standalone worker'
else
  _fail 'client pre-sync SSH policy runs through standalone worker'
fi
ssh_config=$(<"$fixture_home/.ssh/config")
_assert_contains 'client pre-sync SSH policy preserves hand-managed config' \
  'Host hand-managed' "$ssh_config"
_assert_contains 'client pre-sync SSH policy publishes managed alias' \
  '# dot-managed:overlay-ssh:private' "$ssh_config"
_assert_contains 'client pre-sync SSH policy preserves inherited proxy command' \
  'ProxyCommand ssh proxy.example -W %h:%p' "$ssh_config"

rm -f "$fixture_home/.config/dot/overlays.d/10-private.ssh"
if _client_worker_run pre-sync "$pre_sync" reconcile; then
  _pass 'client pre-sync SSH policy retires stale aliases'
else
  _fail 'client pre-sync SSH policy retires stale aliases'
fi
ssh_config=$(<"$fixture_home/.ssh/config")
_assert_contains 'client pre-sync SSH retirement preserves hand-managed config' \
  'Host hand-managed' "$ssh_config"
_assert_not_contains 'client pre-sync SSH retirement removes managed alias' \
  '# dot-managed:overlay-ssh:' "$ssh_config"

_test_summary
