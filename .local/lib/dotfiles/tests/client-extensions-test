#!/usr/bin/env bash
# Client policy compatibility against the standalone dot extension contract.

set -u

source_home=${DOT_TEST_SOURCE_HOME:-$HOME}
host_home=${DOT_TEST_HOST_HOME:-$HOME}

# shellcheck source=helpers.sh
. "$source_home/.local/lib/dotfiles/tests/helpers.sh"
_test_prefer_system_git first || exit 1

_client_dot_root() {
  local candidate

  for candidate in \
    "${DOT_TEST_DOT_ROOT:-}" \
    "$host_home/git/dot" \
    "$host_home/.local/share/cgraf78/dot"; do
    [[ -n $candidate ]] || continue
    if [[ -r $candidate/lib/dot/public/hook-runtime-v1/hook-api.sh ]]; then
      (cd -P -- "$candidate" && pwd -P)
      return
    fi
  done

  printf 'client extensions: standalone dot checkout not found\n' >&2
  return 1
}

dot_root=$(_client_dot_root) || {
  _fail 'client extensions: standalone dot checkout is available'
  _test_summary
}
fixture_home=$(_tmpdir)
mkdir -p "$fixture_home/.config/dot/overlays.d" "$fixture_home/.ssh"
chmod 0700 "$fixture_home" "$fixture_home/.ssh"
client_active_overlay_records=()

# Mirror only the executable client surface into the fixture HOME. A composed
# checkout can contain overlay-owned symlinks here; validating those links from
# a different HOME would correctly fail because the worker would see neither
# their overlay checkouts nor the private publication manifest. Recreate that
# authority with local, no-network clones so the test exercises the same
# symlink validation as production without executing hooks against live state.
_client_extension_fixture() {
  local source_home=$1 fixture_home=$2
  local source_client=$source_home/.local/lib/dotfiles
  local conf name url source_overlay fixture_overlay extension_dir
  local link source_link source_resolved fixture_resolved target rel authority
  local authority_name authority_source authority_fixture source_overlay_home
  local fixture_overlay_home owner manifest fixture_conf optional link_inventory
  local -a authorities=()

  mkdir -p "$fixture_home/.local/lib/dotfiles" "$fixture_home/.config/git"
  for extension_dir in merge-hooks.d doctor.d pre-sync.d; do
    cp -R "$source_client/$extension_dir" \
      "$fixture_home/.local/lib/dotfiles/" || return 1
  done
  # Shared base helpers that extensions load from the extension root.
  cp "$source_client/shell-grok-rc.sh" \
    "$fixture_home/.local/lib/dotfiles/" || return 1

  for conf in "$source_home"/.config/dot/overlays.d/*.conf; do
    [[ -f $conf ]] || continue
    cp "$conf" "$fixture_home/.config/dot/overlays.d/" || return 1
    name=${conf##*/}
    name=${name%.conf}
    if [[ $name =~ ^[0-9]+-(.+)$ ]]; then
      name=${BASH_REMATCH[1]}
    fi
    url=$(sed -n 's/^url=//p' "$conf")
    source_overlay=$source_home/.dotfiles-$name
    [[ -d $source_overlay ]] || source_overlay=$host_home/.dotfiles-$name
    fixture_overlay=$fixture_home/.dotfiles-$name
    [[ -n $url && -d $source_overlay ]] || continue
    git -C "$source_overlay" rev-parse --is-inside-work-tree \
      >/dev/null 2>&1 || continue
    git -c core.hooksPath=/dev/null clone --quiet --no-local \
      "$source_overlay" "$fixture_overlay" || return 1
    git -C "$fixture_overlay" remote set-url origin "$url" || return 1
    authorities+=("$name|$source_overlay|$fixture_overlay")
    fixture_conf=$fixture_home/.config/dot/overlays.d/${conf##*/}
    optional=$(sed -n 's/^optional=//p' "$fixture_conf")
    [[ -n $optional ]] || optional=false
    client_active_overlay_records+=(
      "$name|$fixture_overlay|$url|$fixture_conf|$optional|git"
    )
  done

  # Recreate authority only after a successful complete scan of the fixture.
  link_inventory=$(_tmpfile) || return 1
  find "$fixture_home/.local/lib/dotfiles" -type l -print0 >"$link_inventory" || return 1
  manifest=$fixture_home/.local/state/dot/overlay-links
  mkdir -p "${manifest%/*}" || return 1
  : >"$manifest" || return 1
  chmod 0600 "$manifest" || return 1

  while IFS= read -r -d '' link; do
    source_link=$source_home/${link#"$fixture_home"/}
    source_resolved=$(_test_realpath "$source_link") || return 1
    fixture_resolved=$(_test_realpath "$link") || return 1
    owner=
    for authority in "${authorities[@]+"${authorities[@]}"}"; do
      IFS='|' read -r authority_name authority_source authority_fixture \
        <<<"$authority"
      source_overlay_home=$(_test_realpath "$authority_source/home") || return 1
      fixture_overlay_home=$(_test_realpath "$authority_fixture/home") || return 1
      case $source_resolved in
        "$source_overlay_home"/*)
          case $fixture_resolved in
            "$fixture_overlay_home"/*) owner=$authority_name ;;
            *) return 1 ;;
          esac
          break
          ;;
      esac
    done
    [[ -n $owner ]] || return 1
    target=$(readlink "$link") || return 1
    rel=${link#"$fixture_home"/}
    printf '%s\t%s\t%s\n' "$rel" "$owner" "$target" >>"$manifest" || return 1
  done <"$link_inventory"

  # Always exercise an overlay-owned extension, including in public CI where
  # optional private overlays are intentionally unavailable. This prevents a
  # base-only checkout from hiding a missing active-overlay worker context.
  name=test-overlay
  url=https://example.invalid/cgraf78/dotfiles-test-overlay.git
  fixture_overlay=$fixture_home/.dotfiles-$name
  fixture_conf=$fixture_home/.config/dot/overlays.d/99-$name.conf
  extension_dir=$fixture_overlay/home/.local/lib/dotfiles/merge-hooks.d
  mkdir -p "$extension_dir" || return 1
  cat >"$extension_dir/test-overlay.sh" <<'HOOK'
merge() {
  :
}
HOOK
  git -c init.defaultBranch=main init --quiet "$fixture_overlay" || return 1
  git -C "$fixture_overlay" remote add origin "$url" || return 1
  printf 'url=%s\n' "$url" >"$fixture_conf" || return 1
  link=$fixture_home/.local/lib/dotfiles/merge-hooks.d/test-overlay.sh
  target=../../../../.dotfiles-$name/home/.local/lib/dotfiles/merge-hooks.d/test-overlay.sh
  ln -s "$target" "$link" || return 1
  rel=${link#"$fixture_home"/}
  printf '%s\t%s\t%s\n' "$rel" "$name" "$target" >>"$manifest" || return 1
  client_active_overlay_records+=(
    "$name|$fixture_overlay|$url|$fixture_conf|false|git"
  )
}

_client_extension_inventory_failure() (
  local inventory_source inventory_home
  inventory_source=$(_tmpdir) || exit 1
  inventory_home=$(_tmpdir) || exit 1
  mkdir -p "$inventory_source/.local/lib/dotfiles/"{merge-hooks.d,doctor.d,pre-sync.d} \
    "$inventory_home/.config/dot/overlays.d" || exit 1
  : >"$inventory_source/.local/lib/dotfiles/shell-grok-rc.sh" || exit 1
  find() {
    printf '%s\n' 'fixture symlink inventory failure' >&2
    return 17
  }
  _client_extension_fixture "$inventory_source" "$inventory_home"
)

inventory_rc=0
inventory_output=$(_client_extension_inventory_failure 2>&1) || inventory_rc=$?
_assert_exit 'client extensions: a failed symlink inventory rejects the fixture' 1 "$inventory_rc"
_assert_contains 'client extensions: reports the symlink inventory failure' \
  'fixture symlink inventory failure' "$inventory_output"

if ! _client_extension_fixture "$source_home" "$fixture_home"; then
  _fail 'client extensions: isolated composed authority is available'
  _test_summary
fi
client_root=$fixture_home/.local/lib/dotfiles

export DOT_SOURCE_ROOT=$dot_root
export DOT_EXTENSIONS_DIR=$client_root
export DOT_QUIET=1
export HOME=$fixture_home
# The fixture owns its HOME-derived client config. Hosted runners may export
# unrelated XDG roots; do not let those redirect the descriptor under test.
unset XDG_CONFIG_HOME XDG_STATE_HOME XDG_CACHE_HOME XDG_DATA_HOME XDG_RUNTIME_DIR

# shellcheck source=/dev/null
. "$dot_root/lib/dot/public/xdg.sh"
client_worker_v1=$dot_root/lib/dot/public/hook-runtime-v1/worker.sh
# Gate on readability and always invoke through the suite's own Bash: the
# worker needs no executable bit when driven directly, whatever the install
# umask did. Production spawns the worker with its resolved Bash 4+
# interpreter while hooks keep a versioned Bash 4+ API, so resolving the
# worker through the constrained child PATH would test a configuration the
# engine refuses (notably macOS /bin/bash 3.2). The PATH override below
# stays scoped to hook children.
if [[ ! -f $client_worker_v1 || ! -r $client_worker_v1 ]]; then
  _fail 'client extensions: standalone hook worker is readable'
  _test_summary
fi
if ((BASH_VERSINFO[0] < 4)); then
  _test_skip_suite "standalone worker hooks need Bash 4+ (suite runs under $BASH)"
fi

_client_worker_run() {
  local mode=$1 script=$2 stage=${3:-none}
  shift 3
  local temporary result set_kind=active
  local -a records=("$@")

  temporary=$(_tmpdir)
  chmod 0700 "$temporary"
  result=$temporary/result
  : >"$result"
  chmod 0600 "$result"
  [[ $mode != pre-sync ]] || set_kind=eligible
  _client_worker_run_v1 "$mode" "$script" "$stage" "$temporary" \
    "$result" "$set_kind" "${records[@]+"${records[@]}"}"
}

# Drive the versioned worker boundary directly. The worker's context file is
# plain NUL-separated fields (stage, set kind, retiring identity, record
# count, then the overlay records), so the test builds exactly what the
# native engine would hand over and asserts the same silent-success contract.
_client_worker_run_v1() {
  local mode=$1 script=$2 stage=$3 temporary=$4 result=$5 set_kind=$6
  shift 6
  local context=$temporary/context output rc=0
  local -a records=("$@")

  {
    printf '%s\0' "$stage" "$set_kind" "" ""
    printf '%s\0' "${#records[@]}"
    if ((${#records[@]} > 0)); then
      printf '%s\0' "${records[@]}"
    fi
  } >"$context" || return 1
  chmod 0600 "$context" || return 1
  output=$(PATH=${CLIENT_WORKER_PATH:-$DOT_TEST_SYSTEM_PATH} \
    "$BASH" "$client_worker_v1" "$mode" "$script" "$result" "$context" \
    2>&1) || rc=$?
  if [[ -n $output ]]; then
    printf '%s\n' "$output" >&2
    return 1
  fi
  return "$rc"
}

client_crontab=$(_tmpdir)/crontab
cat >"$client_crontab" <<'CRONTAB'
#!/usr/bin/env bash
set -u

case ${1:-} in
  -l) exit 1 ;;
  -) cat >/dev/null ;;
  -r) : ;;
  *) exit 64 ;;
esac
CRONTAB
chmod +x "$client_crontab"
export DOT_TEST_CRONTAB=$client_crontab

for hook in "$client_root/merge-hooks.d"/*.sh; do
  # Installed capability hooks run in their owning repository suites. Retain
  # the synthetic overlay hook so public base CI still exercises Dot's
  # overlay-owned worker authorization boundary.
  [[ ! -L $hook || ${hook##*/} == test-overlay.sh ]] || continue
  if CLIENT_WORKER_PATH=$DOT_TEST_SYSTEM_PATH _client_worker_run merge "$hook" none \
    "${client_active_overlay_records[@]+"${client_active_overlay_records[@]}"}"; then
    _pass "client merge hook loads through standalone worker: ${hook##*/}"
  else
    _fail "client merge hook loads through standalone worker: ${hook##*/}"
  fi
done

windows_home=$fixture_home/windows-home
wezterm_worker_bin=$(_tmpdir)
wezterm_config_dir=$fixture_home/.config/wezterm
wezterm_provider_dir=$fixture_home/termnav-fixture/lib/termnav/wezterm

_client_wezterm_merge() {
  CLIENT_WORKER_PATH="$wezterm_worker_bin:$DOT_TEST_SYSTEM_PATH" \
    WSL_DISTRO_NAME=Ubuntu DOT_TEST_WINDOWS_HOME=$windows_home \
    DOT_TEST_WSL_PAIRED_ACCOUNT=1 DOT_QUIET=1 \
    _client_worker_run merge "$client_root/merge-hooks.d/wezterm.sh" none \
    "${client_active_overlay_records[@]+"${client_active_overlay_records[@]}"}"
}

cat >"$wezterm_worker_bin/wezterm" <<'WEZTERM'
#!/usr/bin/env bash
exit 0
WEZTERM
cat >"$wezterm_worker_bin/shdeps" <<'SHDEPS'
#!/usr/bin/env bash
[[ $1 == dep-file && $2 == cgraf78/termnav && -f $HOME/termnav-fixture/$3 ]] || exit 1
printf '%s\n' "$HOME/termnav-fixture/$3"
SHDEPS
cat >"$wezterm_worker_bin/cp" <<'CP'
#!/usr/bin/env bash
[[ $1 != "${WEZTERM_TEST_FAIL_COPY:-}" ]] || exit 1
exec /bin/cp "$@"
CP
cat >"$wezterm_worker_bin/mv" <<'MV'
#!/usr/bin/env bash
if [[ ${3:-} == "$DOT_TEST_WINDOWS_HOME/.wezterm.lua" ]]; then
  printf '%s\n' 'published' >>"$DOT_TEST_WINDOWS_HOME/publications"
  for companion in attention.lua link-routes.lua public-link-rules.lua termnav-module.lua \
    termnav-link-routes.lua termnav-public-link-rules.lua hyperlink-rules.d/test.lua; do
    if [[ ! -f $DOT_TEST_WINDOWS_HOME/$companion ]]; then
      printf '%s\n' "$companion was missing at publication" >>"$DOT_TEST_WINDOWS_HOME/order"
    fi
  done
fi
exec /bin/mv "$@"
MV
chmod +x "$wezterm_worker_bin/"*
mkdir -p "$wezterm_config_dir/hyperlink-rules.d" "$fixture_home/.config/terminal" "$windows_home" "$wezterm_provider_dir"
for companion in attention.lua link-routes.lua public-link-rules.lua termnav-module.lua; do
  printf 'return {fixture=true}\n' >"$wezterm_config_dir/$companion"
done
printf 'return {routes=true}\n' >"$wezterm_provider_dir/link-routes.lua"
printf 'return {rules=true}\n' >"$wezterm_provider_dir/public-link-rules.lua"
printf 'return {extension=true}\n' >"$wezterm_config_dir/hyperlink-rules.d/test.lua"
printf 'return {}\n' >"$wezterm_config_dir/wezterm.lua"
cp "$source_home/.config/terminal/settings.json" "$fixture_home/.config/terminal/settings.json"
printf 'legacy companion\n' >"$windows_home/appearance.json"
mkdir -p "$windows_home/.config/terminal"
printf '\342\240\213\n\342\240\231\n' >"$windows_home/.config/terminal/working-spinner.frames"
if _client_wezterm_merge; then
  _pass 'client WSL worker runs WezTerm hook through public platform API'
else
  _fail 'client WSL worker runs WezTerm hook through public platform API'
fi
_assert_file_content 'client WSL worker copies WezTerm config through public platform API' \
  'return {}' "$windows_home/.wezterm.lua"
_assert_file_missing 'client WSL worker publishes all required Lua companions before the main config' \
  "$windows_home/order"
_assert_file_content 'client WSL worker copies the Termnav router' \
  'return {routes=true}' "$windows_home/termnav-link-routes.lua"
_assert_file_content 'client WSL worker copies the Termnav hyperlink rules' \
  'return {rules=true}' "$windows_home/termnav-public-link-rules.lua"

_assert_file_missing 'client WSL worker retires legacy appearance copy' \
  "$windows_home/appearance.json"
_assert_file_content 'client WSL worker copies shared appearance' \
  "$(cat "$fixture_home/.config/terminal/settings.json")" "$windows_home/.config/terminal/settings.json"
# Tabs no longer animate, so the hook retires the spinner frames it copied.
_assert_file_missing 'client WSL worker retires the working-spinner frames copy' \
  "$windows_home/.config/terminal/working-spinner.frames"

# A failed dependency copy must preserve both the old dependency and main config.
cp "$windows_home/.wezterm.lua" "$windows_home/main.before"
cp "$windows_home/.config/terminal/settings.json" "$windows_home/appearance.before"
mv "$fixture_home/.config/terminal/settings.json" "$fixture_home/appearance.parked"
printf 'return {new_config=true}\n' >"$wezterm_config_dir/wezterm.lua"
if _client_wezterm_merge 2>/dev/null; then
  _fail 'client WSL worker reports failed appearance copy'
else
  _pass 'client WSL worker reports failed appearance copy'
fi
_assert_file_content 'failed appearance copy preserves main config' \
  "$(cat "$windows_home/main.before")" "$windows_home/.wezterm.lua"
_assert_file_content 'failed appearance copy preserves published appearance' \
  "$(cat "$windows_home/appearance.before")" "$windows_home/.config/terminal/settings.json"
mv "$fixture_home/appearance.parked" "$fixture_home/.config/terminal/settings.json"

mv "$wezterm_provider_dir/public-link-rules.lua" "$fixture_home/rules.parked"
if _client_wezterm_merge 2>/dev/null; then
  _fail 'client WSL worker reports missing Termnav module'
else
  _pass 'client WSL worker reports missing Termnav module'
fi
_assert_file_content 'missing Termnav module preserves main config' \
  'return {}' "$windows_home/.wezterm.lua"
mv "$fixture_home/rules.parked" "$wezterm_provider_dir/public-link-rules.lua"

mv "$wezterm_config_dir/attention.lua" "$fixture_home/attention.parked"
if _client_wezterm_merge 2>/dev/null; then
  _fail 'client WSL worker reports missing local companion'
else
  _pass 'client WSL worker reports missing local companion'
fi
_assert_file_content 'missing local companion preserves main config' \
  'return {}' "$windows_home/.wezterm.lua"
mv "$fixture_home/attention.parked" "$wezterm_config_dir/attention.lua"

printf 'return {updated=true}\n' >"$wezterm_config_dir/attention.lua"
if WEZTERM_TEST_FAIL_COPY="$wezterm_config_dir/attention.lua" _client_wezterm_merge 2>/dev/null; then
  _fail 'client WSL worker reports a Lua companion copy failure'
else
  _pass 'client WSL worker reports a Lua companion copy failure'
fi
_assert_file_content 'failed Lua companion copy preserves main config' \
  'return {}' "$windows_home/.wezterm.lua"
_assert_file_content 'failed Lua companion copy preserves the published companion' \
  'return {fixture=true}' "$windows_home/attention.lua"

printf 'return {updated=true}\n' >"$wezterm_config_dir/hyperlink-rules.d/test.lua"
if WEZTERM_TEST_FAIL_COPY="$wezterm_config_dir/hyperlink-rules.d/test.lua" _client_wezterm_merge 2>/dev/null; then
  _fail 'client WSL worker reports a hyperlink extension copy failure'
else
  _pass 'client WSL worker reports a hyperlink extension copy failure'
fi
_assert_file_content 'failed extension copy preserves main config' \
  'return {}' "$windows_home/.wezterm.lua"
_assert_file_content 'failed extension copy preserves the published extension' \
  'return {extension=true}' "$windows_home/hyperlink-rules.d/test.lua"
if compgen -G "$windows_home/hyperlink-rules.d/.dotfiles-managed.tmp.*" >/dev/null; then
  _fail 'failed extension copy leaves no staged ownership manifest'
else
  _pass 'failed extension copy leaves no staged ownership manifest'
fi

wezterm_external_dir=$(_tmpdir)
for relative_name in attention.lua hyperlink-rules.d/.dotfiles-managed; do
  blocked_dest="$windows_home/$relative_name"
  mv "$blocked_dest" "$fixture_home/destination.parked"
  ln -s "$wezterm_external_dir" "$blocked_dest"
  if _client_wezterm_merge 2>/dev/null; then
    _fail "client WSL worker rejects directory destination $relative_name"
  else
    _pass "client WSL worker rejects directory destination $relative_name"
  fi
  _assert_file_content "directory destination $relative_name preserves main config" \
    'return {}' "$windows_home/.wezterm.lua"
  _assert_eq "directory destination $relative_name remains untouched" \
    "$wezterm_external_dir" "$(readlink "$blocked_dest")"
  _assert_eq "directory destination $relative_name receives no staged files" \
    '' "$(ls -A "$wezterm_external_dir")"
  rm -f "$blocked_dest"
  mv "$fixture_home/destination.parked" "$blocked_dest"
done

if _client_wezterm_merge && _client_wezterm_merge; then
  _pass 'client WSL worker retries and can rerun the completed update'
else
  _fail 'client WSL worker retries and can rerun the completed update'
fi
_assert_file_content 'successful retry publishes the new main config' \
  'return {new_config=true}' "$windows_home/.wezterm.lua"
_assert_file_content 'successful retry publishes the updated companion' \
  'return {updated=true}' "$windows_home/attention.lua"
_assert_file_content 'successful retry publishes the updated hyperlink extension' \
  'return {updated=true}' "$windows_home/hyperlink-rules.d/test.lua"
_assert_file_content 'completed WSL update does not republish an unchanged main config' \
  $'published\npublished' "$windows_home/publications"

for extension in "$client_root/doctor.d"/[0-9]*.sh; do
  [[ ! -L $extension ]] || continue
  if _client_worker_run doctor "$extension" none \
    "${client_active_overlay_records[@]+"${client_active_overlay_records[@]}"}"; then
    _pass "client doctor extension loads through standalone worker: ${extension##*/}"
  else
    _fail "client doctor extension loads through standalone worker: ${extension##*/}"
  fi
done

old_reference_output=$(
  grep -RInE \
    '\.local/lib/dot/(core|git-hooks|sley-hooks)|\.config/dot/merge-hooks\.d/codex/(api|refresh-trust|toml-render)' \
    "$client_root/merge-hooks.d" "$client_root/doctor.d" 2>/dev/null || true
)
_assert_eq 'dormant client extensions do not source embedded implementation paths' \
  '' "$old_reference_output"

cat >"$fixture_home/.config/dot/overlays.d/10-private.ssh" <<'SSH'
Host github-private
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_private
SSH
cat >"$fixture_home/.ssh/config" <<'SSH'
Host github.com
  HostName github.com
  ProxyCommand ssh proxy.example -W %h:%p

Host hand-managed
  HostName hand.example
SSH

pre_sync=$client_root/pre-sync.d/10-overlay-ssh.sh
private_record="private|$fixture_home/.dotfiles-private|https://example.invalid/private.git|$fixture_home/.config/dot/overlays.d/10-private.conf|true|git"
if _client_worker_run pre-sync "$pre_sync" prepare "$private_record"; then
  _pass 'client pre-sync SSH policy runs through standalone worker'
else
  _fail 'client pre-sync SSH policy runs through standalone worker'
fi
ssh_config=$(<"$fixture_home/.ssh/config")
_assert_contains 'client pre-sync SSH policy preserves hand-managed config' \
  'Host hand-managed' "$ssh_config"
_assert_contains 'client pre-sync SSH policy publishes managed alias' \
  '# dot-managed:overlay-ssh:private' "$ssh_config"
_assert_contains 'client pre-sync SSH policy preserves inherited proxy command' \
  'ProxyCommand ssh proxy.example -W %h:%p' "$ssh_config"

rm -f "$fixture_home/.config/dot/overlays.d/10-private.ssh"
if _client_worker_run pre-sync "$pre_sync" reconcile; then
  _pass 'client pre-sync SSH policy retires stale aliases'
else
  _fail 'client pre-sync SSH policy retires stale aliases'
fi
ssh_config=$(<"$fixture_home/.ssh/config")
_assert_contains 'client pre-sync SSH retirement preserves hand-managed config' \
  'Host hand-managed' "$ssh_config"
_assert_not_contains 'client pre-sync SSH retirement removes managed alias' \
  '# dot-managed:overlay-ssh:' "$ssh_config"

_test_summary
