#!/usr/bin/env bash
# The retained dotfiles bootstrap is a thin client binding over Dot's public
# installer and initialization command.

set -u

source_home=${DOT_TEST_SOURCE_HOME:-$HOME}
# shellcheck source=helpers.sh
. "$source_home/.local/lib/dotfiles/tests/helpers.sh"
_test_prefer_system_git first || exit 1

dot_root=$(_test_dot_root) || {
  echo 'standalone dot checkout is unavailable' >&2
  exit 1
}
fixture=$(_tmpdir)
fixture=$(cd "$fixture" && pwd -P)
home=$fixture/home
origin=$fixture/client.git
dot_origin=$fixture/dot.git
seed=$fixture/seed
fake_bin=$fixture/bin
mkdir -p "$home" "$seed" "$fixture/no-hooks" "$fake_bin"

# The generated installer deliberately follows the public main branch. Build a
# local main at the exact candidate revision so a worktree run tests the engine
# under review instead of whichever revision the shared repository currently
# names as main.
dot_revision=$(git -C "$dot_root" rev-parse HEAD) || exit 1
# GitHub checks out pull requests with depth one. Pushing that shallow boundary
# into a newly initialized receiver is intentionally rejected by Git, even
# though the candidate object itself is complete. A bare clone transfers the
# source's available object boundary without requiring older history or a
# network fetch; publish main only after confirming the clone still names the
# exact candidate under test.
git clone --quiet --bare --no-local --depth=1 "$dot_root" "$dot_origin"
[[ $(git --git-dir="$dot_origin" rev-parse HEAD) == "$dot_revision" ]] || exit 1
git --git-dir="$dot_origin" update-ref refs/heads/main "$dot_revision"
git --git-dir="$dot_origin" symbolic-ref HEAD refs/heads/main

git init --bare --initial-branch=main "$origin" >/dev/null
git -C "$seed" init --initial-branch=main >/dev/null
_git_set_test_identity git -C "$seed"
git -C "$seed" config core.hooksPath "$fixture/no-hooks"
mkdir -p "$seed/.config/dot"
cat >"$seed/.config/dot/config" <<'CONF'
version=1
extension_api=1
dependency_provider=none
CONF
printf '%s\n' '# fixture client' >"$seed/.bashrc"
mkdir -p "$seed/.local/bin"
cp "$source_home/.local/bin/dotbootstrap" "$seed/.local/bin/dotbootstrap"
cp "$source_home/.local/bin/dot" "$seed/.local/bin/dot"
git -C "$seed" add .
git -C "$seed" commit -m initial >/dev/null
git -C "$seed" remote add origin "$origin"
git -C "$seed" push -u origin main >/dev/null
git --git-dir="$origin" symbolic-ref HEAD refs/heads/main

cat >"$fake_bin/curl" <<'CURL'
#!/usr/bin/env bash
set -e
cat "$DOT_TEST_DOT_INSTALLER"
CURL
chmod 0755 "$fake_bin/curl"

bootstrap_status=0
HOME="$home" PATH="$fake_bin:$PATH" \
  DOT_TEST_DOT_INSTALLER="$dot_root/install.sh" \
  DOTBOOTSTRAP_DOTFILES_REPO="file://$origin" \
  DOTFILES_BRANCH=main \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$dot_origin" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$home/.local/share/cgraf78/dot" \
  SHDEPS_INSTALL_DIR="$home/.local/share" \
  bash "$source_home/.local/bin/dotbootstrap" init \
  >"$fixture/bootstrap.out" 2>"$fixture/bootstrap.err" || bootstrap_status=$?
if [[ $bootstrap_status -ne 0 ]]; then
  cat "$fixture/bootstrap.err" >&2
fi

_assert_eq 'dotfiles bootstrap installs and initializes through dot' 0 "$bootstrap_status"
_assert_eq 'dotfiles bootstrap installs the exact standalone revision' \
  "$dot_revision" \
  "$(git -C "$home/.local/share/cgraf78/dot" rev-parse HEAD 2>/dev/null || printf missing)"
_assert_file_content 'dotfiles bootstrap checks out the bound client repository' \
  '# fixture client' "$home/.bashrc"
if [[ -f $home/.local/bin/dot && ! -L $home/.local/bin/dot &&
  -x $home/.local/bin/dot && -L $home/.local/lib/dot ]]; then
  _pass 'dotfiles bootstrap keeps the client front door and public library link'
else
  _fail 'dotfiles bootstrap keeps the client front door and public library link'
fi
if git --no-pager diff --no-index --quiet --no-ext-diff --no-textconv -- \
  "$source_home/.local/bin/dot" "$home/.local/bin/dot"; then
  _pass 'dotfiles bootstrap publishes the reviewed client front door'
else
  _fail 'dotfiles bootstrap publishes the reviewed client front door'
fi
_assert_eq 'dotfiles bootstrap records the selected client revision' \
  "$(git -C "$seed" rev-parse HEAD)" \
  "$(git --git-dir="$home/.dotfiles" rev-parse HEAD 2>/dev/null || printf missing)"
_assert_file_exists 'dotfiles bootstrap records successful completion' \
  "$home/.dotbootstrap-done"

reconfigure_status=0
HOME="$home" PATH="$home/.local/bin:$PATH" \
  bash "$home/.local/bin/dotbootstrap" \
  >"$fixture/reconfigure.out" 2>"$fixture/reconfigure.err" || reconfigure_status=$?
_assert_eq 'dotfiles bootstrap reconfigures through standalone update' \
  0 "$reconfigure_status"

# The permanent client front door remains present when the Shdeps-owned
# checkout is lost. Reconfigure must recognize that the command cannot enter a
# runtime, reinstall Dot, and then continue through the same update path.
mv "$home/.local/share/cgraf78/dot" "$fixture/removed-dot"
repair_status=0
HOME="$home" PATH="$fake_bin:$home/.local/bin:$PATH" \
  DOT_TEST_DOT_INSTALLER="$dot_root/install.sh" \
  CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$dot_origin" \
  CGRAF78_CHECKOUT_INSTALL_DIR="$home/.local/share/cgraf78/dot" \
  SHDEPS_INSTALL_DIR="$home/.local/share" \
  bash "$home/.local/bin/dotbootstrap" \
  >"$fixture/repair.out" 2>"$fixture/repair.err" || repair_status=$?
_assert_eq 'dotfiles bootstrap repairs a missing standalone checkout' \
  0 "$repair_status"
_assert_eq 'dotfiles bootstrap repairs to the exact standalone revision' \
  "$dot_revision" \
  "$(git -C "$home/.local/share/cgraf78/dot" rev-parse HEAD 2>/dev/null || printf missing)"

_test_summary
