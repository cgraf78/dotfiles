#!/usr/bin/env bash
# Measure profile-related payload below an isolated fixture HOME.

set -euo pipefail

usage() {
  printf 'usage: %s --phase PHASE --profile PROFILE FIXTURE_HOME\n' \
    "${0##*/}" >&2
  exit 2
}

phase=
profile=
while (($# > 0)); do
  case $1 in
    --phase)
      (($# >= 2)) || usage
      phase=$2
      shift 2
      ;;
    --profile)
      (($# >= 2)) || usage
      profile=$2
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*) usage ;;
    *) break ;;
  esac
done
[[ $# -eq 1 && -n $phase && -n $profile ]] || usage
[[ $phase =~ ^[a-z][a-z0-9-]*$ ]] || usage
case $profile in base | editor | dev) ;; *) usage ;; esac

fixture_home=$1
[[ -d $fixture_home && ! -L $fixture_home ]] || {
  printf 'measure-profile-footprint: unsafe fixture home: %s\n' \
    "$fixture_home" >&2
  exit 1
}
fixture_home=$(CDPATH='' cd -P -- "$fixture_home" && pwd -P)
[[ $fixture_home != / ]] || {
  printf 'measure-profile-footprint: refusing filesystem root\n' >&2
  exit 1
}

_bytes_for() {
  local root=$1 relative parent path bytes=0 size count subtotal
  shift
  for relative in "$@"; do
    # Find already skips symlinks in a walked tree, but its starting path
    # would follow symlinks in any intermediate directory.
    parent=$relative
    while [[ $parent == */* ]]; do
      parent=${parent%/*}
      [[ ! -L $root/$parent ]] || continue 2
    done
    path=$root/$relative
    [[ -e $path || -L $path ]] || continue
    if [[ -f $path && ! -L $path ]]; then
      size=$(LC_ALL=C wc -c <"$path") || return 1
      size=${size//[[:blank:]]/}
    elif [[ -d $path && ! -L $path ]]; then
      # A failed traversal or byte count leaves a partial measurement.
      # Keep both sides of this pipeline checked before recording a subtotal.
      size=$(
        find "$path" -type f -exec sh -c \
          'for file do
            LC_ALL=C wc -c <"$file" || exit 1
          done' sh {} + |
          (
            subtotal=0
            while IFS=$' \t' read -r count; do
              [[ $count =~ ^[0-9]+$ ]] || exit 1
              subtotal=$((subtotal + 10#$count))
            done
            printf '%s\n' "$subtotal"
          )
      ) || return 1
    else
      continue
    fi
    [[ $size =~ ^[0-9]+$ ]] || return 1
    bytes=$((bytes + 10#$size))
  done
  printf '%s\n' "$bytes"
}

git_checkout_config=$(_bytes_for "$fixture_home" \
  .dotfiles .dotfiles-nvim .dotfiles-dev .config)
user_managed=$(_bytes_for "$fixture_home" \
  .local/bin .local/share/cgraf78 .local/share/shdeps)
nvim=$(_bytes_for "$fixture_home" \
  .local/share/neovim .local/share/nvim .local/state/nvim .cache/nvim)
mise=$(_bytes_for "$fixture_home" .local/share/mise)
language_caches=$(_bytes_for "$fixture_home" .cargo .rustup go/pkg .npm .cache/uv)
optional_private_overlays=$(_bytes_for "$fixture_home" .dotfiles-personal .dotfiles-work)

native_packages=0
native_status=unmeasured
if [[ -n ${DOT_FOOTPRINT_NATIVE_ROOT:-} ]]; then
  [[ -d $DOT_FOOTPRINT_NATIVE_ROOT && ! -L $DOT_FOOTPRINT_NATIVE_ROOT ]] || {
    printf 'measure-profile-footprint: unsafe native package root: %s\n' \
      "$DOT_FOOTPRINT_NATIVE_ROOT" >&2
    exit 1
  }
  native_root=$(CDPATH='' cd -P -- "$DOT_FOOTPRINT_NATIVE_ROOT" && pwd -P)
  native_packages=$(_bytes_for "$native_root" .)
  native_status=measured
fi

public_total=$((\
  git_checkout_config + user_managed + nvim + mise + \
  native_packages))

printf 'version=1\n'
printf 'phase=%s\n' "$phase"
printf 'profile=%s\n' "$profile"
printf 'category\tbytes\tstatus\n'
printf 'git_checkout_config\t%s\tmeasured\n' "$git_checkout_config"
printf 'language_caches\t%s\tseparate\n' "$language_caches"
printf 'mise\t%s\tmeasured\n' "$mise"
printf 'native_packages\t%s\t%s\n' "$native_packages" "$native_status"
printf 'nvim\t%s\tmeasured\n' "$nvim"
printf 'optional_private_overlays\t%s\tseparate\n' \
  "$optional_private_overlays"
printf 'user_managed\t%s\tmeasured\n' "$user_managed"
printf 'public_total\t%s\tderived\n' "$public_total"
