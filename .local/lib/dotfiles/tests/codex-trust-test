# Table-driven pins for the conservative header scan: provable headers
# fingerprint (rc 0), anything else fails closed into a prune (rc 1).
# Sourced in-process with stubbed hook APIs; the scan is pure.
dot_hook_source() { return 0; }
# shellcheck source=../merge-hooks.d/codex-trust.serial.sh
. "$hook"
_fingerprint_rc() {
  local content=$1 file rc
  file=$(mktemp)
  printf '%b' "$content" >"$file"
  _codex_trust_fingerprint "$file" >/dev/null 2>&1
  rc=$?
  rm -f "$file"
  printf '%s' "$rc"
}
_fingerprint_case() {
  local name=$1 content=$2 expect=$3 got
  got=$(_fingerprint_rc "$content")
  _assert_eq "scan: $name" "$expect" "$got"
}
_fingerprint_case 'quoted header fingerprints' \
  '[projects."/a"]\ntrust_level = "trusted"\n' 0
_fingerprint_case 'single-quoted path fingerprints' \
  "[projects.'/a']\ntrust_level = \"trusted\"\n" 0
_fingerprint_case 'trailing slash normalizes' \
  '[projects."/a/"]\ntrust_level = "trusted"\n' 0
_fingerprint_case 'bare table with blanks only fingerprints' \
  '[projects]\n\n[projects."/a"]\ntrust_level = "trusted"\n' 0
_fingerprint_case 'array table bails' \
  '[[projects."/a"]]\ntrust_level = "trusted"\n' 1
_fingerprint_case 'comment mentioning projects bails' \
  '[projects."/a"]\n# projects note\ntrust_level = "trusted"\n' 1
_fingerprint_case 'bare dotted entry bails' \
  '[projects]\n"/a".trust_level = "trusted"\n' 1
_fingerprint_case 'bare table with content bails' \
  '[projects]\nfoo = 1\n' 1
_fingerprint_case 'trailing comment on header bails' \
  '[projects."/a"] # comment\ntrust_level = "trusted"\n' 1
_fingerprint_case 'indented header bails' \
  '  [projects."/a"]\ntrust_level = "trusted"\n' 1
_fingerprint_case 'CRLF endings bail' \
  '[projects."/a"]\r\ntrust_level = "trusted"\r\n' 1
_fingerprint_case 'unquoted path bails' \
  '[projects./a]\ntrust_level = "trusted"\n' 1

