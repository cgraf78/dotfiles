#!/usr/bin/env bash
# Prove an existing pre-profile installation converges with one force update.

set -u

source_home=$(cd -P -- "${BASH_SOURCE[0]%/*}/../../../.." && pwd -P)

# shellcheck source=helpers.sh
. "$source_home/.local/lib/dotfiles/tests/helpers.sh"

lock=$source_home/.github/overlay-profile-stack.lock
lock_value() {
  local key=$1
  awk -F= -v key="$key" '$1 == key { count++; value=$2 } END {
    if (count == 1) print value; else exit 1
  }' "$lock"
}

source_sha=$(lock_value source_dotfiles 2>/dev/null || true)
dot_sha=$(lock_value dot 2>/dev/null || true)
legacy_dot_sha=$(lock_value pre_profile_dot 2>/dev/null || true)
nvim_sha=$(lock_value dotfiles_nvim 2>/dev/null || true)
dev_sha=$(lock_value dotfiles_dev 2>/dev/null || true)
d4_sha=$(lock_value dotfiles_d4_base 2>/dev/null || true)
final_sha=$(git -C "$source_home" rev-parse HEAD 2>/dev/null || true)

for pair in source:$source_sha dot:$dot_sha legacy-dot:$legacy_dot_sha \
  nvim:$nvim_sha dev:$dev_sha d4:$d4_sha final:$final_sha; do
  name=${pair%%:*}
  sha=${pair#*:}
  [[ $sha =~ ^[0-9a-f]{40}$ ]] || {
    _fail "legacy cutover has an immutable $name revision"
    _test_summary
  }
done
_pass 'legacy cutover has immutable source and destination revisions'

if [[ ${DOT_STACK_RUNTIME:-0} == 1 &&
  ${DOT_STACK_GROUP:-} == legacy-profile-cutover &&
  ${DOT_STACK_DOT_SHA:-} == "$dot_sha" ]]; then
  _pass 'legacy cutover harness is bound to the exact reviewed D1 runtime'
else
  _fail 'legacy cutover harness is bound to the exact reviewed D1 runtime'
  _test_summary
fi

_test_prefer_system_git || {
  _fail 'legacy cutover has an isolated system Git'
  _test_summary
}
git_bin=$(type -P git)
bash_bin=$(type -P bash)
host_home=${DOT_TEST_HOST_HOME:-$HOME}
shdeps_root=${DOT_STACK_SHDEPS_ROOT:-}
if [[ -z $shdeps_root ]]; then
  for candidate in "$host_home/.local/share/shdeps" "$host_home/git/shdeps"; do
    [[ -f $candidate/install.sh && -f $candidate/shdeps.sh &&
      -x $candidate/shdeps ]] || continue
    shdeps_root=$candidate
    break
  done
fi
if [[ -z $shdeps_root || ! -f $shdeps_root/install.sh ||
  ! -f $shdeps_root/shdeps.sh || ! -x $shdeps_root/shdeps ]]; then
  _fail 'legacy cutover has a complete Shdeps fixture runtime'
  _test_summary
fi
agent_rules_sync=$(type -P agent-rules-sync 2>/dev/null || true)
if [[ $agent_rules_sync != /* || ! -x $agent_rules_sync ]]; then
  _fail 'legacy cutover has the base-owned agent-rules-sync runtime'
  _test_summary
fi
_pass 'legacy cutover has isolated provider prerequisites'

fixture_root=$(_tmpdir)
root_origin=$fixture_root/dotfiles.git
dot_origin=$fixture_root/dot.git
nvim_origin=$fixture_root/dotfiles-nvim.git
dev_origin=$fixture_root/dotfiles-dev.git
provider_root=$fixture_root/shdeps-provider
git_config=$fixture_root/gitconfig
provider_log=$fixture_root/provider.log

make_origin() {
  local source=$1 destination=$2 name sha
  shift 2
  "$git_bin" init --quiet --bare "$destination" || return 1
  "$git_bin" --git-dir="$destination" config receive.shallowUpdate true
  while [[ $# -gt 0 ]]; do
    name=$1
    sha=$2
    shift 2
    "$git_bin" --git-dir="$destination" fetch --quiet --no-tags "$source" \
      "$sha:refs/heads/$name" || return 1
  done
}

make_origin "$source_home" "$root_origin" \
  pre-refactor "$source_sha" d4 "$d4_sha" final "$final_sha" || {
  _fail 'legacy cutover created the exact root origin'
  _test_summary
}

dot_source=${DOT_STACK_DOT_ORIGIN:-https://github.com/cgraf78/dot.git}
"$git_bin" init --quiet --bare "$dot_origin"
"$git_bin" --git-dir="$dot_origin" fetch --quiet --no-tags "$dot_source" \
  "$legacy_dot_sha:refs/heads/pre-profile" \
  "$dot_sha:refs/heads/main" || {
  _fail 'legacy cutover created the exact Dot origin'
  _test_summary
}
"$git_bin" --git-dir="$dot_origin" symbolic-ref HEAD refs/heads/main

make_origin \
  "${DOT_STACK_NVIM_REPOSITORY:-https://github.com/cgraf78/dotfiles-nvim.git}" \
  "$nvim_origin" main "$nvim_sha" || {
  _fail 'legacy cutover created the exact Nvim origin'
  _test_summary
}
"$git_bin" --git-dir="$nvim_origin" symbolic-ref HEAD refs/heads/main
make_origin \
  "${DOT_STACK_DEV_REPOSITORY:-https://github.com/cgraf78/dotfiles-dev.git}" \
  "$dev_origin" main "$dev_sha" || {
  _fail 'legacy cutover created the exact development origin'
  _test_summary
}
"$git_bin" --git-dir="$dev_origin" symbolic-ref HEAD refs/heads/main
_pass 'legacy cutover created exact local public origins'

mkdir -p "$provider_root"
cp -p "$shdeps_root/install.sh" "$shdeps_root/shdeps.sh" "$provider_root/"
cp -pL "$shdeps_root/shdeps" "$provider_root/shdeps.real"
for directory in completions lua man; do
  [[ -d $shdeps_root/$directory ]] || continue
  cp -R "$shdeps_root/$directory" "$provider_root/$directory"
done
cat >"$provider_root/shdeps" <<'SH'
#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} != update ]]; then
  exec "${BASH_SOURCE[0]%/*}/shdeps.real" "$@"
fi

install=${SHDEPS_INSTALL_DIR:?}/cgraf78/dot
before=$(git -C "$install" rev-parse HEAD)
git -C "$install" fetch --quiet --no-tags \
  "${DOT_CUTOVER_DOT_ORIGIN:?}" "${DOT_CUTOVER_DOT_SHA:?}"
git -C "$install" checkout --quiet --detach --force FETCH_HEAD
# Exercise the same repository-owned post-install contract as real Shdeps.
# shellcheck source=/dev/null
. "$HOME/.config/shdeps/hooks.d/cgraf78/dot.sh"
post cgraf78/dot
after=$(git -C "$install" rev-parse HEAD)
printf 'before=%s after=%s dot_force=%s shdeps_force=%s reexec_once=%s\n' \
  "$before" "$after" "${DOT_FORCE:-0}" "${SHDEPS_FORCE:-0}" \
  "${DOT_REEXEC_ONCE:-0}" >>"${DOT_CUTOVER_PROVIDER_LOG:?}"
SH
chmod 0755 "$provider_root/shdeps" "$provider_root/shdeps.real"
printf '{"method":"release"}\n' >"$provider_root/.shdeps-install.json"
: >"$provider_log"

"$git_bin" config --file "$git_config" \
  "url.file://$nvim_origin.insteadOf" \
  https://github.com/cgraf78/dotfiles-nvim.git
"$git_bin" config --file "$git_config" \
  "url.file://$dev_origin.insteadOf" \
  https://github.com/cgraf78/dotfiles-dev.git
"$git_bin" config --file "$git_config" \
  "url.file://$fixture_root/missing-personal.git.insteadOf" \
  git@github.com:cgraf78/dotfiles-personal.git
"$git_bin" config --file "$git_config" \
  "url.file://$fixture_root/missing-work.git.insteadOf" \
  github-dotfiles-work:cgraf78/dotfiles-work.git

set_root_target() {
  "$git_bin" --git-dir="$root_origin" update-ref refs/heads/main "$1" || return
  "$git_bin" --git-dir="$root_origin" symbolic-ref HEAD refs/heads/main
}

install_legacy_home() {
  local home=$1 initial_root=$2 install=$1/.local/share/cgraf78/dot
  set_root_target "$initial_root" || return 1
  "$git_bin" clone --quiet --separate-git-dir="$home/.dotfiles" \
    "file://$root_origin" "$home" || return 1
  "$git_bin" --git-dir="$home/.dotfiles" config core.bare false
  "$git_bin" --git-dir="$home/.dotfiles" config core.worktree "$home"

  mkdir -p "${install%/*}" "$home/.local/bin" "$home/.local/lib" "$home/.ssh"
  chmod 0700 "$home" "$home/.ssh"
  "$git_bin" clone --quiet --no-checkout "file://$dot_origin" "$install" || return 1
  "$git_bin" -C "$install" checkout --quiet --detach "$legacy_dot_sha" || return 1
  HOME="$home" PREFIX="$home/.local" BIN_DIR="$home/.local/bin" \
    DOT_PUBLIC_LIB="$home/.local/lib/dot" \
    SHDEPS_INSTALL_DIR="$home/.local/share" \
    "$bash_bin" "$install/support/install-checkout.sh" || return 1

  for command_name in tmux-continuum-default-server tmux-clip-paste; do
    printf '#!/bin/sh\nexit 0\n' >"$home/.local/bin/$command_name"
    chmod 0755 "$home/.local/bin/$command_name"
  done
  ln -s "$agent_rules_sync" "$home/.local/bin/agent-rules-sync"
  printf '%s\n' '.local/lib/dot' '.local/share/cgraf78/' \
    '.local/bin/agent-rules-sync' >>"$home/.dotfiles/info/exclude"
  printf 'preserve\n' >"$home/.config/unmanaged-cutover-sentinel"
}

advance_installed_root() {
  local home=$1 target=$2
  set_root_target "$target" || return 1
  "$git_bin" --git-dir="$home/.dotfiles" --work-tree="$home" \
    fetch --quiet --no-tags origin main || return 1
  "$git_bin" --git-dir="$home/.dotfiles" update-ref refs/heads/main FETCH_HEAD || return 1
  "$git_bin" --git-dir="$home/.dotfiles" --work-tree="$home" \
    read-tree --reset -u refs/heads/main
}

run_cutover_update() {
  local home=$1 log=$2 status=0
  env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR \
    -u SHDEPS_DIR -u SHDEPS_RUST_CLI -u SHDEPS_LUA_DIR \
    -u DOT_REEXEC_ONCE -u DOT_REEXEC_EXPECTED_REVISION \
    HOME="$home" \
    XDG_CONFIG_HOME="$home/.config" \
    XDG_DATA_HOME="$home/.local/share" \
    XDG_STATE_HOME="$home/.local/state" \
    XDG_CACHE_HOME="$home/.cache" \
    GIT_CONFIG_GLOBAL="$git_config" \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_TERMINAL_PROMPT=0 \
    GIT_SSH_COMMAND='ssh -o BatchMode=yes -o ConnectTimeout=1' \
    SHDEPS_LIB="$provider_root/shdeps.sh" \
    SHDEPS_INSTALL_DIR="$home/.local/share" \
    SHDEPS_BIN_DIR="$home/.local/bin" \
    SHDEPS_GIT_DEV_DIR="$home/git" \
    SHDEPS_STATE_DIR="$home/.local/state/shdeps" \
    DOT_CUTOVER_DOT_ORIGIN="file://$dot_origin" \
    DOT_CUTOVER_DOT_SHA="$dot_sha" \
    DOT_CUTOVER_PROVIDER_LOG="$provider_log" \
    BASH="$bash_bin" \
    PATH="$home/.local/bin:${git_bin%/*}:/usr/bin:/bin" \
    "$home/.local/bin/dot" update -f >"$log" 2>&1 || status=$?
  [[ $status -eq 0 ]] || sed -n '1,220p' "$log" >&2
  return "$status"
}

assert_cutover_final() {
  local label=$1 home=$2 log=$3 manifest
  manifest=$home/.local/state/dot/overlay-links
  _assert_eq "$label installs exact D1" "$dot_sha" \
    "$("$git_bin" -C "$home/.local/share/cgraf78/dot" rev-parse HEAD)"
  _assert_eq "$label installs exact final root" "$final_sha" \
    "$("$git_bin" --git-dir="$home/.dotfiles" rev-parse HEAD)"
  _assert_eq "$label installs exact Nvim overlay" "$nvim_sha" \
    "$("$git_bin" -C "$home/.dotfiles-nvim" rev-parse HEAD)"
  _assert_eq "$label installs exact development overlay" "$dev_sha" \
    "$("$git_bin" -C "$home/.dotfiles-dev" rev-parse HEAD)"
  _assert_file_content "$label preserves unmanaged content" preserve \
    "$home/.config/unmanaged-cutover-sentinel"
  _assert_file_missing "$label skips unavailable personal" "$home/.dotfiles-personal"
  _assert_file_missing "$label skips unavailable work" "$home/.dotfiles-work"
  if [[ -L $home/.config/nvim/init.lua &&
    $(_test_realpath "$home/.config/nvim/init.lua") == "$home/.dotfiles-nvim/home/.config/nvim/init.lua" ]]; then
    _pass "$label transfers Nvim ownership to its overlay"
  else
    _fail "$label transfers Nvim ownership to its overlay"
  fi
  if [[ -L $home/.config/git/config &&
    $(_test_realpath "$home/.config/git/config") == "$home/.dotfiles-dev/home/.config/git/config" ]]; then
    _pass "$label transfers Git configuration to the development overlay"
  else
    _fail "$label transfers Git configuration to the development overlay"
  fi
  if [[ -f $manifest ]] &&
    awk -F '\t' '$2 == "nvim" { nvim=1 } $2 == "dev" { dev=1 } END { exit !(nvim && dev) }' \
      "$manifest"; then
    _pass "$label publishes the active dev overlay manifest"
  else
    _fail "$label publishes the active dev overlay manifest"
  fi
  _assert_contains "$label reports completed convergence" 'Done in ' "$(<"$log")"
}

assert_provider_handoff() {
  local label=$1 start_line=$2 records
  records=$(tail -n +"$start_line" "$provider_log")
  _assert_contains "$label provider sees the legacy runtime" \
    "before=$legacy_dot_sha after=$dot_sha" "$records"
  _assert_contains "$label preserves force before re-exec" \
    'dot_force=1 shdeps_force=1 reexec_once=0' "$records"
  _assert_contains "$label preserves force after re-exec" \
    "before=$dot_sha after=$dot_sha dot_force=1 shdeps_force=1 reexec_once=1" \
    "$records"
}

set_root_target "$source_sha"

staged_home=$fixture_root/home-staged
install_legacy_home "$staged_home" "$source_sha" || {
  _fail 'staged legacy cutover home is prepared'
  _test_summary
}
start_line=$(($(wc -l <"$provider_log" 2>/dev/null || printf 0) + 1))
set_root_target "$d4_sha"
staged_log=$fixture_root/staged-d4.log
if run_cutover_update "$staged_home" "$staged_log"; then
  _pass 'legacy Dot reaches D4 through one force update'
else
  _fail 'legacy Dot reaches D4 through one force update'
fi
_assert_eq 'staged cutover installs exact D4 root' "$d4_sha" \
  "$("$git_bin" --git-dir="$staged_home/.dotfiles" rev-parse HEAD)"
_assert_eq 'staged cutover installs exact D1' "$dot_sha" \
  "$("$git_bin" -C "$staged_home/.local/share/cgraf78/dot" rev-parse HEAD)"
assert_provider_handoff 'staged cutover' "$start_line"
set_root_target "$final_sha"
staged_final_log=$fixture_root/staged-final.log
if run_cutover_update "$staged_home" "$staged_final_log"; then
  _pass 'D4 installation reaches final cutover through one force update'
else
  _fail 'D4 installation reaches final cutover through one force update'
fi
assert_cutover_final 'staged cutover' "$staged_home" "$staged_final_log"

direct_home=$fixture_root/home-direct
install_legacy_home "$direct_home" "$source_sha" || {
  _fail 'direct legacy cutover home is prepared'
  _test_summary
}
start_line=$(($(wc -l <"$provider_log" 2>/dev/null || printf 0) + 1))
set_root_target "$final_sha"
direct_log=$fixture_root/direct-final.log
if run_cutover_update "$direct_home" "$direct_log"; then
  _pass 'legacy Dot reaches final cutover through one force update'
else
  _fail 'legacy Dot reaches final cutover through one force update'
fi
assert_provider_handoff 'direct cutover' "$start_line"
assert_cutover_final 'direct cutover' "$direct_home" "$direct_log"

retry_home=$fixture_root/home-retry
install_legacy_home "$retry_home" "$source_sha" || {
  _fail 'interrupted legacy cutover home is prepared'
  _test_summary
}
advance_installed_root "$retry_home" "$final_sha" || {
  _fail 'interrupted legacy cutover advances only the root checkout'
  _test_summary
}
_assert_eq 'interrupted state retains the old Dot runtime' "$legacy_dot_sha" \
  "$("$git_bin" -C "$retry_home/.local/share/cgraf78/dot" rev-parse HEAD)"
start_line=$(($(wc -l <"$provider_log" 2>/dev/null || printf 0) + 1))
retry_log=$fixture_root/retry-final.log
if run_cutover_update "$retry_home" "$retry_log"; then
  _pass 'interrupted root-new runtime-old state retries without repair'
else
  _fail 'interrupted root-new runtime-old state retries without repair'
fi
assert_provider_handoff 'interrupted retry' "$start_line"
assert_cutover_final 'interrupted retry' "$retry_home" "$retry_log"

_test_summary
