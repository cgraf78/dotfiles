result=$(HOME="$reg_home" DOTFILES="$reg_home/.dotfiles" "$GC" 2>/dev/null)
apply_result=$(HOME="$reg_home" DOTFILES="$reg_home/.dotfiles" "$GC" --apply 2>/dev/null)
for ((reg_i = 0; reg_i < ${#reg_wts[@]}; reg_i++)); do
  wt=${reg_wts[$reg_i]}
  _assert_not_contains "roots: an unswept registered worktree is not a dry-run candidate (${wt##*/})" \
    "$wt" "$result"
  _assert_not_contains "roots: an unswept registered worktree is not an apply candidate (${wt##*/})" \
    "$wt" "$apply_result"
  _assert_file_exists "roots: an unswept registered worktree survives --apply (${wt##*/})" \
    "$wt/feat-reg-$((reg_i + 1)).txt"
done
result=$(HOME="$reg_home" DOTFILES="$reg_home/.dotfiles" "$GC" --root "$reg_outside" 2>/dev/null)
_assert_contains "roots: --root opts an outside worktree in" \
  "$(printf 'would-remove\t%s\tmerged into origin/main' "$reg_outside/scratch")" "$result"

# --root takes the root's children only; a checkout two levels down stays
# out of the sweep.
deep_root=$(_gc_tmpdir)
mkdir -p "$deep_root/group"
git -C "$main" worktree add "$deep_root/group/deep" -b feat-deep >/dev/null 2>&1
_git_set_test_identity git -C "$deep_root/group/deep"
_gc_commit_file "$deep_root/group/deep" feat-deep.txt
git -C "$deep_root/group/deep" push -u origin feat-deep >/dev/null 2>&1
_gc_merge_branch "$main" feat-deep
git -C "$deep_root/group/deep" fetch --prune origin >/dev/null 2>&1
_gc_make_old "$deep_root/group/deep"
result=$(HOME="$reg_home" DOTFILES="$reg_home/.dotfiles" "$GC" --root "$deep_root" 2>/dev/null)
_assert_not_contains "roots: --root leaves a checkout two levels deep alone" \
  "$deep_root/group/deep" "$result"

# A repository that hides untracked files from status (the base client sets
# status.showUntrackedFiles=no, and its worktrees inherit it): an old merged
# worktree whose only change is a new file is dirty, and --apply keeps it.
hide_home=$(_gc_tmpdir)
hide_origin_root=$(_tmpdir)
_gc_seed_origin "$hide_origin_root/origin.git"
_gc_clone_main "$hide_origin_root/origin.git" "$hide_home/git/alpha"
git -C "$hide_home/git/alpha" config status.showUntrackedFiles no
git -C "$hide_home/git/alpha" worktree add "$hide_home/.worktrees/old-untracked" \
  -b feat-hide >/dev/null 2>&1
wt=$hide_home/.worktrees/old-untracked
_git_set_test_identity git -C "$wt"
_gc_commit_file "$wt" feat-hide.txt
git -C "$wt" push -u origin feat-hide >/dev/null 2>&1
_gc_merge_branch "$hide_home/git/alpha" feat-hide
git -C "$wt" fetch --prune origin >/dev/null 2>&1
printf '%s\n' 'precious' >"$wt/new-notes.txt"
_gc_make_old "$wt"
result=$(HOME="$hide_home" DOTFILES="$hide_home/.dotfiles" "$GC" --apply 2>/dev/null)
_assert_contains "dirty: an untracked-only change is dirty despite showUntrackedFiles=no" \
  "$(printf 'skipped\t%s\tdirty' "$wt")" "$result"
_assert_file_exists "dirty: the untracked file survives --apply" "$wt/new-notes.txt"

# A file that appears after the dirty gate, just before the removal, must
# still stop it: Git's own clean check has to see untracked files too.
git -C "$hide_home/git/alpha" worktree add "$hide_home/.worktrees/old-late" \
  -b feat-late >/dev/null 2>&1
wt=$hide_home/.worktrees/old-late
_git_set_test_identity git -C "$wt"
_gc_commit_file "$wt" feat-late.txt
git -C "$wt" push -u origin feat-late >/dev/null 2>&1
_gc_merge_branch "$hide_home/git/alpha" feat-late
git -C "$wt" fetch --prune origin >/dev/null 2>&1
_gc_make_old "$wt"
late_bin=$(_tmpdir)
late_real_git=$(type -P git)
cat >"$late_bin/git" <<SH
#!/usr/bin/env bash
case " \$* " in
  *" worktree remove "*) printf '%s\n' late >"$wt/late-notes.txt" ;;
esac
exec "$late_real_git" "\$@"
SH
chmod +x "$late_bin/git"
result=$(HOME="$hide_home" DOTFILES="$hide_home/.dotfiles" PATH="$late_bin:$PATH" \
  "$GC" --apply 2>/dev/null)
_assert_not_contains "dirty: a file created after the gate stops the removal" \
  "$(printf 'removed\t%s' "$wt")" "$result"
_assert_file_exists "dirty: the late untracked file survives --apply" "$wt/late-notes.txt"

echo ""
echo "=== Recent Git activity keeps an old checkout ==="

# The sweep ages checkouts by the doctor's activity signals: an old top
# directory with a fresh HEAD (a recent checkout or commit) is young.
act_home=$(_gc_tmpdir)
act_origin_root=$(_tmpdir)
act_origin=$act_origin_root/origin.git
_gc_seed_origin "$act_origin"
_gc_clone_main "$act_origin" "$act_home/git/alpha"
main=$act_home/git/alpha
git -C "$main" worktree add "$act_home/.worktrees/old-active" -b feat-act >/dev/null 2>&1
wt=$act_home/.worktrees/old-active
_git_set_test_identity git -C "$wt"
_gc_commit_file "$wt" feat-act.txt
git -C "$wt" push -u origin feat-act >/dev/null 2>&1
_gc_merge_branch "$main" feat-act
git -C "$wt" fetch --prune origin >/dev/null 2>&1
_gc_make_old "$wt"
touch "$main/.git/worktrees/old-active/HEAD"
result=$(HOME="$act_home" DOTFILES="$act_home/.dotfiles" "$GC" 2>/dev/null)
_assert_contains "activity: a fresh HEAD keeps the checkout" \
  "$(printf 'kept\t%s\tyounger than 14 days' "$wt")" "$result"

echo ""
echo "=== Symlinked HOME ==="

# Through a symlinked HOME the sweep still excludes the live checkout,
# finds each registered checkout exactly once, and reports physical paths.
sym_parent=$(_gc_tmpdir)
mkdir -p "$sym_parent/real"
ln -s "$sym_parent/real" "$sym_parent/link"
sym_home=$sym_parent/link
sym_origin_root=$(_tmpdir)
_gc_seed_origin "$sym_origin_root/origin.git"
_gc_clone_main "$sym_origin_root/origin.git" "$sym_home/git/alpha"
git -C "$sym_home/git/alpha" worktree add "$sym_home/.worktrees/old-merged" -b feat-sym >/dev/null 2>&1
wt=$sym_home/.worktrees/old-merged
_git_set_test_identity git -C "$wt"
_gc_commit_file "$wt" feat-sym.txt
git -C "$wt" push -u origin feat-sym >/dev/null 2>&1
_gc_merge_branch "$sym_home/git/alpha" feat-sym
git -C "$wt" fetch --prune origin >/dev/null 2>&1
_gc_make_old "$wt"
result=$(HOME="$sym_home" DOTFILES="$sym_home/.dotfiles" "$GC" 2>/dev/null)
_assert_contains "symlinked home: the checkout is swept by its physical path" \
  "$(printf 'would-remove\t%s\tmerged into origin/main' "$sym_parent/real/.worktrees/old-merged")" \
  "$result"
_assert_eq "symlinked home: the checkout is listed once" "1" \
  "$(grep -c 'old-merged' <<<"$result")"

echo ""
echo "=== Linked checkout on the base branch keeps its branch ==="

bb_home=$(_gc_tmpdir)
bb_origin_root=$(_tmpdir)
bb_origin=$bb_origin_root/origin.git
_gc_seed_origin "$bb_origin"
_gc_clone_main "$bb_origin" "$bb_home/git/alpha"
main=$bb_home/git/alpha
git -C "$main" checkout --detach HEAD >/dev/null 2>&1
git -C "$main" worktree add "$bb_home/.worktrees/old-on-main" main >/dev/null 2>&1
wt=$bb_home/.worktrees/old-on-main
git -C "$wt" fetch --prune origin >/dev/null 2>&1
_gc_make_old "$wt"

result=$(HOME="$bb_home" DOTFILES="$bb_home/.dotfiles" "$GC" 2>/dev/null)
_assert_contains "base-branch: checkout would be removed" \
  "$(printf 'would-remove\t%s\tmerged into origin/main' "$wt")" "$result"
_assert_contains "base-branch: base branch would be kept" \
  $'would-skip-branch\tmain\tbase branch' "$result"
result=$(HOME="$bb_home" DOTFILES="$bb_home/.dotfiles" "$GC" --apply 2>/dev/null)
_assert_contains "base-branch: apply removes the checkout" \
  "$(printf 'removed\t%s\tmerged into origin/main' "$wt")" "$result"
_assert_contains "base-branch: apply keeps the base branch" \
  $'skipped-branch\tmain\tbase branch' "$result"
_assert_file_missing "base-branch: checkout is gone" "$wt/.git"
git -C "$main" rev-parse --verify -q refs/heads/main >/dev/null 2>&1
_assert_exit "base-branch: main survives" 0 "$?"

echo ""
echo "=== Non-origin remotes resolve a base without ambiguity ==="

ro_home=$(_gc_tmpdir)
ro_origin_root=$(_tmpdir)
ro_origin=$ro_origin_root/origin.git
_gc_seed_origin "$ro_origin"
git clone -o upstream "$ro_origin" "$ro_home/git/alpha" >/dev/null 2>&1
main=$ro_home/git/alpha
_git_set_test_identity git -C "$main"
git -C "$main" symbolic-ref refs/remotes/upstream/HEAD refs/remotes/upstream/main >/dev/null 2>&1
git -C "$main" worktree add "$ro_home/.worktrees/old-merged" -b feat-a >/dev/null 2>&1
wt=$ro_home/.worktrees/old-merged
_git_set_test_identity git -C "$wt"
_gc_commit_file "$wt" feat-a.txt
git -C "$wt" push -u upstream feat-a >/dev/null 2>&1
git -C "$main" fetch upstream >/dev/null 2>&1
git -C "$main" merge --no-ff upstream/feat-a -m merge >/dev/null 2>&1
git -C "$main" push upstream main >/dev/null 2>&1
git -C "$wt" fetch --prune upstream >/dev/null 2>&1
_gc_make_old "$wt"

result=$(HOME="$ro_home" DOTFILES="$ro_home/.dotfiles" "$GC" 2>/dev/null)
status=$?
_assert_exit "remotes: single non-origin remote exits 0" 0 "$status"
_assert_contains "remotes: lone remote HEAD proves the merge" \
  "$(printf 'would-remove\t%s\tmerged into upstream/main' "$wt")" "$result"

# A second remote must not hijack the base: origin wins by name even
# when its HEAD symref is missing.
git -C "$main" remote rename upstream origin >/dev/null 2>&1
fork_root=$(_tmpdir)
fork_origin=$fork_root/fork.git
_gc_seed_origin "$fork_origin"
git -C "$main" remote add fork "$fork_origin" >/dev/null 2>&1
git -C "$main" fetch fork >/dev/null 2>&1
git -C "$main" symbolic-ref refs/remotes/fork/HEAD refs/remotes/fork/main >/dev/null 2>&1
git -C "$main" symbolic-ref -d refs/remotes/origin/HEAD >/dev/null 2>&1

result=$(HOME="$ro_home" DOTFILES="$ro_home/.dotfiles" "$GC" 2>/dev/null)
_assert_contains "remotes: fork HEAD never becomes the base" \
  "$(printf 'would-remove\t%s\tmerged into origin/main' "$wt")" "$result"
_assert_not_contains "remotes: fork reason never prints" "fork/main" "$result"

echo ""
echo "=== Dirty submodule blocks removal ==="

sub_home=$(_gc_tmpdir)
sub_origin_root=$(_tmpdir)
sub_origin=$sub_origin_root/origin.git
_gc_seed_origin "$sub_origin"
_gc_clone_main "$sub_origin" "$sub_home/git/alpha"
main=$sub_home/git/alpha
git -C "$main" -c protocol.file.allow=always submodule add "$sub_origin" vendor >/dev/null 2>&1
git -C "$main" commit -m vendor >/dev/null 2>&1
git -C "$main" push origin main >/dev/null 2>&1
git -C "$main" worktree add "$sub_home/.worktrees/old-sub" -b feat-sub >/dev/null 2>&1
wt=$sub_home/.worktrees/old-sub
_git_set_test_identity git -C "$wt"
git -C "$wt" -c protocol.file.allow=always submodule update --init >/dev/null 2>&1
_gc_commit_file "$wt" feat-sub.txt
git -C "$wt" push -u origin feat-sub >/dev/null 2>&1
_gc_merge_branch "$main" feat-sub
git -C "$wt" fetch --prune origin >/dev/null 2>&1
printf '%s\n' 'submodule edit' >>"$wt/vendor/file.txt"
_gc_make_old "$wt"

result=$(HOME="$sub_home" DOTFILES="$sub_home/.dotfiles" "$GC" 2>/dev/null)
_assert_contains "submodule: dirty submodule is skipped" \
  "$(printf 'skipped\t%s\tdirty (uncommitted/untracked changes)' "$wt")" "$result"
_assert_file_exists "submodule: checkout survives" "$wt/file.txt"

echo ""
echo "=== Option surface ==="

opt_home=$(_gc_tmpdir)
result=$(HOME="$opt_home" DOTFILES="$opt_home/.dotfiles" "$GC" --help 2>&1)
_assert_exit "options: --help exits 0" 0 "$?"
_assert_contains "options: --help prints usage" "usage:" "$result"
result=$(HOME="$opt_home" DOTFILES="$opt_home/.dotfiles" "$GC" --older-than 2>&1)
_assert_exit "options: missing age value exits 1" 1 "$?"
result=$(HOME="$opt_home" DOTFILES="$opt_home/.dotfiles" "$GC" --root 2>&1)
_assert_exit "options: missing root value exits 1" 1 "$?"
result=$(HOME="$opt_home" DOTFILES="$opt_home/.dotfiles" "$GC" --older-than 0d 2>&1)
_assert_exit "options: zero age exits 1" 1 "$?"
result=$(HOME="$opt_home" DOTFILES="$opt_home/.dotfiles" "$GC" --older-than -3 2>&1)
_assert_exit "options: negative age exits 1" 1 "$?"
result=$(HOME=/nonexistent-gc-home DOTFILES="$opt_home/.dotfiles" "$GC" 2>&1)
_assert_exit "options: missing HOME directory exits 1" 1 "$?"
result=$(HOME="$opt_home" DOTFILES="$opt_home/.dotfiles" env -u BASH_ENV PATH=/nonexistent-gc-bin "$BASH" "$GC" 2>&1)
_assert_exit "options: missing git exits 1" 1 "$?"
result=$(HOME="$nf_home" DOTFILES="$nf_home/.dotfiles" "$GC" --dry-run --older-than=14d --no-fetch 2>/dev/null)
_assert_contains "options: equals form and explicit dry run work" \
  "$(printf 'would-remove\t%s\tmerged into origin/main' "$nf_home/.worktrees/old-merged")" "$result"
result=$(HOME="$rt_home" DOTFILES="$rt_home/.dotfiles" "$GC" --root="$rt_home/custom-wt" --root "$rt_home/custom-wt" 2>/dev/null)
dup_records=$(grep -c '^would-remove	' <<<"$result")
_assert_eq "options: repeated roots dedupe" 1 "$dup_records"

echo ""
echo "=== Shared roots and grouping folders ==="

# The doctor and the gc read one root list: ~/worktrees and ~/git/.worktrees
# join ~/.worktrees and ~/git/worktrees, and a folder there without a `.git`
# groups checkouts one level down. The owning clone sits outside every clone
# root, so only the roots can reach these checkouts. Widening the roots must
# not widen what is removed: a dirty, an unmerged, an orphaned, and a
# too-deep checkout all survive --apply.
grp_home=$(_gc_tmpdir)
grp_origin_root=$(_tmpdir)
grp_origin=$grp_origin_root/origin.git
_gc_seed_origin "$grp_origin"
_gc_clone_main "$grp_origin" "$grp_home/elsewhere/alpha"
main=$grp_home/elsewhere/alpha
mkdir -p "$grp_home/worktrees" "$grp_home/git/.worktrees" "$grp_home/git/worktrees/batch/deeper"
_grp_merged_worktree() {
  local wt=$1 branch=$2
  git -C "$main" worktree add "$wt" -b "$branch" >/dev/null 2>&1
  _git_set_test_identity git -C "$wt"
  _gc_commit_file "$wt" "$branch.txt"
  git -C "$wt" push -u origin "$branch" >/dev/null 2>&1
  _gc_merge_branch "$main" "$branch"
  git -C "$wt" fetch --prune origin >/dev/null 2>&1
}
_grp_merged_worktree "$grp_home/worktrees/g-top" feat-g-top
_grp_merged_worktree "$grp_home/git/.worktrees/g-hidden" feat-g-hidden
_grp_merged_worktree "$grp_home/git/worktrees/batch/g-nested" feat-g-nested
_grp_merged_worktree "$grp_home/git/worktrees/batch/g-dirty" feat-g-dirty
printf '%s\n' 'local edit' >>"$grp_home/git/worktrees/batch/g-dirty/feat-g-dirty.txt"
_grp_merged_worktree "$grp_home/git/worktrees/batch/deeper/g-deep" feat-g-deep
# Unmerged: a local commit never pushed.
git -C "$main" worktree add "$grp_home/git/worktrees/batch/g-unpushed" -b feat-g-unpushed >/dev/null 2>&1
_git_set_test_identity git -C "$grp_home/git/worktrees/batch/g-unpushed"
_gc_commit_file "$grp_home/git/worktrees/batch/g-unpushed" unpushed.txt
# Orphan: its repository is gone.
mkdir -p "$grp_home/git/worktrees/batch/g-orphan"
printf 'gitdir: %s\n' "$grp_home/git/gone-repo/.git/worktrees/g-orphan" \
  >"$grp_home/git/worktrees/batch/g-orphan/.git"
for wt in worktrees/g-top git/.worktrees/g-hidden git/worktrees/batch/g-nested \
  git/worktrees/batch/g-dirty git/worktrees/batch/deeper/g-deep \
  git/worktrees/batch/g-unpushed git/worktrees/batch/g-orphan; do
  _gc_make_old "$grp_home/$wt"
done

result=$(HOME="$grp_home" DOTFILES="$grp_home/.dotfiles" "$GC" 2>/dev/null)
_assert_exit "groups: dry run exits 0" 0 "$?"
for wt in worktrees/g-top git/.worktrees/g-hidden git/worktrees/batch/g-nested; do
  _assert_contains "groups: a merged checkout in a shared root is removable (${wt##*/})" \
    "$(printf 'would-remove\t%s\tmerged into origin/main' "$grp_home/$wt")" "$result"
done
_assert_contains "groups: a dirty grouped checkout is skipped" \
  "$(printf 'skipped\t%s\tdirty' "$grp_home/git/worktrees/batch/g-dirty")" "$result"
_assert_contains "groups: an unpushed grouped checkout is skipped" \
  "$(printf 'skipped\t%s\tmerge unproven for branch feat-g-unpushed' "$grp_home/git/worktrees/batch/g-unpushed")" "$result"
_assert_contains "groups: an orphaned grouped checkout is skipped" \
  "$(printf 'skipped\t%s\tbroken git pointer' "$grp_home/git/worktrees/batch/g-orphan")" "$result"
_assert_not_contains "groups: descent stops one level down" "g-deep" "$result"

result=$(HOME="$grp_home" DOTFILES="$grp_home/.dotfiles" "$GC" --apply 2>/dev/null)
_assert_exit "groups: apply exits 0" 0 "$?"
for wt in worktrees/g-top git/.worktrees/g-hidden git/worktrees/batch/g-nested; do
  _assert_file_missing "groups: apply removes the merged checkout (${wt##*/})" "$grp_home/$wt/.git"
done
_assert_file_exists "groups: the dirty checkout survives apply" \
  "$grp_home/git/worktrees/batch/g-dirty/feat-g-dirty.txt"
_assert_file_exists "groups: the unpushed checkout survives apply" \
  "$grp_home/git/worktrees/batch/g-unpushed/unpushed.txt"
_assert_file_exists "groups: the orphan survives apply" \
  "$grp_home/git/worktrees/batch/g-orphan/.git"
_assert_file_exists "groups: the too-deep checkout survives apply" \
  "$grp_home/git/worktrees/batch/deeper/g-deep/feat-g-deep.txt"
git -C "$main" rev-parse --verify -q refs/heads/feat-g-unpushed >/dev/null 2>&1
_assert_exit "groups: the unpushed branch survives apply" 0 "$?"

# A branch tracking another branch whose upstream is gone holds commits no
# remote ever saw: gone alone proves nothing there, so the gc keeps it.
git -C "$main" push origin main:base-slice >/dev/null 2>&1
git -C "$main" fetch origin >/dev/null 2>&1
git -C "$main" worktree add "$grp_home/git/worktrees/batch/g-foreign" -b feat-g-foreign \
  --track origin/base-slice >/dev/null 2>&1
_git_set_test_identity git -C "$grp_home/git/worktrees/batch/g-foreign"
_gc_commit_file "$grp_home/git/worktrees/batch/g-foreign" never-pushed.txt
git -C "$main" push origin --delete base-slice >/dev/null 2>&1
git -C "$main" fetch --prune origin >/dev/null 2>&1
_gc_make_old "$grp_home/git/worktrees/batch/g-foreign"
result=$(HOME="$grp_home" DOTFILES="$grp_home/.dotfiles" "$GC" --apply 2>/dev/null)
_assert_contains "groups: a gone foreign upstream is no proof" \
  "$(printf 'skipped\t%s\tmerge unproven for branch feat-g-foreign' "$grp_home/git/worktrees/batch/g-foreign")" "$result"
_assert_file_exists "groups: its never-pushed commit's checkout survives apply" \
  "$grp_home/git/worktrees/batch/g-foreign/never-pushed.txt"

# A gone local upstream is no proof either, however the names line up.
git -C "$main" worktree add "$grp_home/git/worktrees/batch/g-local" -b stack/g-local >/dev/null 2>&1
git -C "$grp_home/git/worktrees/batch/g-local" checkout -b g-local --track stack/g-local >/dev/null 2>&1
_git_set_test_identity git -C "$grp_home/git/worktrees/batch/g-local"
_gc_commit_file "$grp_home/git/worktrees/batch/g-local" local-only.txt
git -C "$main" branch -D stack/g-local >/dev/null 2>&1
_gc_make_old "$grp_home/git/worktrees/batch/g-local"
result=$(HOME="$grp_home" DOTFILES="$grp_home/.dotfiles" "$GC" --apply 2>/dev/null)
_assert_contains "groups: a gone local upstream is no proof" \
  "$(printf 'skipped\t%s\tmerge unproven for branch g-local' "$grp_home/git/worktrees/batch/g-local")" "$result"
_assert_file_exists "groups: the local-upstream checkout survives apply" \
  "$grp_home/git/worktrees/batch/g-local/local-only.txt"

# A nested checkout in a folder Git ignores (a global ignore of
# `.worktrees/`) is invisible to the dirty gate and to Git's own clean
# check: removing its old, clean, merged parent would delete it, uncommitted
# work and all. The parent is kept, whether the nested checkout is a
# registered worktree or an unregistered clone.
_grp_merged_worktree "$grp_home/worktrees/grp2/f" feat-g-parent
git -C "$main" worktree add "$grp_home/worktrees/grp2/f/.worktrees/inner" -b g-inner >/dev/null 2>&1
printf '%s\n' 'inner edit' >>"$grp_home/worktrees/grp2/f/.worktrees/inner/file.txt"
printf '%s\n' 'new' >"$grp_home/worktrees/grp2/f/.worktrees/inner/untracked.txt"
_grp_merged_worktree "$grp_home/worktrees/grp2/g" feat-g-parent2
git clone "$grp_origin" "$grp_home/worktrees/grp2/g/.worktrees/grp/clone" >/dev/null 2>&1
printf '%s\n' 'clone work' >"$grp_home/worktrees/grp2/g/.worktrees/grp/clone/work.txt"
printf '%s\n' '.worktrees/' >>"$main/.git/info/exclude"
_gc_make_old "$grp_home/worktrees/grp2/f"
_gc_make_old "$grp_home/worktrees/grp2/g"
result=$(HOME="$grp_home" DOTFILES="$grp_home/.dotfiles" "$GC" --apply 2>/dev/null)
_assert_contains "nested: a registered nested worktree keeps its parent" \
  "$(printf 'skipped\t%s\tcontains another checkout (.worktrees/inner)' "$grp_home/worktrees/grp2/f")" "$result"
_assert_contains "nested: an ignored nested clone keeps its parent" \
  "$(printf 'skipped\t%s\tcontains another checkout (.worktrees/grp/clone)' "$grp_home/worktrees/grp2/g")" "$result"
_assert_file_exists "nested: the nested worktree's untracked work survives" \
  "$grp_home/worktrees/grp2/f/.worktrees/inner/untracked.txt"
_assert_file_exists "nested: the nested clone's work survives" \
  "$grp_home/worktrees/grp2/g/.worktrees/grp/clone/work.txt"

# Deeper and odder shapes under an ignored folder: a clone three levels
# down, a bare repository (no `.git` inside it), and a clone in an ignored
# folder whose name line porcelain would quote (a space).
_grp_merged_worktree "$grp_home/worktrees/grp2/deep" feat-g-deepnest
git clone "$grp_origin" "$grp_home/worktrees/grp2/deep/.worktrees/a/b/clone" >/dev/null 2>&1
printf '%s\n' 'deep work' >"$grp_home/worktrees/grp2/deep/.worktrees/a/b/clone/work.txt"
_grp_merged_worktree "$grp_home/worktrees/grp2/bare" feat-g-bare
git clone --bare "$grp_origin" "$grp_home/worktrees/grp2/bare/.worktrees/store.git" >/dev/null 2>&1
_grp_merged_worktree "$grp_home/worktrees/grp2/spaced" feat-g-spaced
