# The immutable flag denies entry removal even to root, so this is the
# end-to-end failure path for privileged runners. The probe skips the
# section on filesystems without immutable support.
_immutable_usable() {
  local probe
  probe=$(_tmpdir)/probe || return 1
  mkdir -p "$probe/child" || return 1
  command -v chattr >/dev/null 2>&1 || return 1
  chattr +i "$probe/child" >/dev/null 2>&1 || return 1
  if touch "$probe/child/f" >/dev/null 2>&1; then
    chattr -i "$probe/child" >/dev/null 2>&1
    return 1
  fi
  chattr -i "$probe/child" >/dev/null 2>&1 || return 1
  return 0
}

