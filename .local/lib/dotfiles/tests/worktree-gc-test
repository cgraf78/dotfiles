_gc_merged_worktree "$mp_home/git/owner" "$mp_home/git/parked/.worktrees/old-parked" feat-mp
printf 'gitdir: %s\n' "$mp_home/git/gone/.git/worktrees/orph" >"$mp_home/git/parked/.worktrees/orph/.git"
_gc_make_old "$mp_home/git/parked/.worktrees/orph"
result=$(HOME="$mp_home" DOTFILES="$mp_home/.dotfiles" GIT_TOOLS_ROOT="$STUB_ROOT" "$GC" 2>/dev/null)
_assert_contains "gitfile: a managed owner's parked worktree lends its .worktrees" \
  "$(printf 'would-remove\t%s\tmerged' "$mp_home/git/parked/.worktrees/old-parked")" "$result"
_assert_contains "gitfile: an orphan in a managed parked worktree is reported" \
  "$(printf 'skipped\t%s\tbroken git pointer' "$mp_home/git/parked/.worktrees/orph")" "$result"
# Git spells the parked worktree's common directory physically; reached
# through a symlinked HOME, the owner still matches by identity.
ln -s "$mp_home" "$mp_home.link"
result=$(HOME="$mp_home.link" DOTFILES="$mp_home.link/.dotfiles" GIT_TOOLS_ROOT="$STUB_ROOT" \
  "$GC" 2>/dev/null)
_assert_contains "gitfile: a parked worktree's owner matches through a symlinked HOME" \
  "$(printf 'would-remove\t%s\tmerged' "$mp_home/git/parked/.worktrees/old-parked")" "$result"
# The base client counts as an owner too. An empty leftover in its parked
# worktree's .worktrees is reachable only through that worktree (the base
# client's own registrations are swept wherever they live anyway).
git init --quiet --bare "$mp_home/.dotfiles"
git --git-dir="$mp_home/.dotfiles" config core.bare false
git --git-dir="$mp_home/.dotfiles" config core.worktree "$mp_home"
mp_base_git=(git --git-dir="$mp_home/.dotfiles" --work-tree="$mp_home")
_git_set_test_identity "${mp_base_git[@]}"
"${mp_base_git[@]}" remote add origin "$mp_origin_root/origin.git"
"${mp_base_git[@]}" fetch --quiet origin
"${mp_base_git[@]}" checkout --quiet -b main origin/main
"${mp_base_git[@]}" worktree add --quiet "$mp_home/git/base-parked" -b base-parked 2>/dev/null
mkdir -p "$mp_home/git/base-parked/.worktrees/old-empty"
_gc_make_old "$mp_home/git/base-parked/.worktrees/old-empty"
result=$(HOME="$mp_home" DOTFILES="$mp_home/.dotfiles" GIT_TOOLS_ROOT="$STUB_ROOT" "$GC" 2>/dev/null)
_assert_contains "gitfile: the base client's parked worktree lends its .worktrees" \
  "$(printf 'would-remove\t%s\tempty directory, no known registration' "$mp_home/git/base-parked/.worktrees/old-empty")" "$result"
skip_commons=$(
  # shellcheck source=../worktree-gc.sh
  . "$ROOT/.local/lib/dotfiles/worktree-gc.sh" &&
    HOME="$skip_home" DOTFILES="$skip_home/.dotfiles" _dr_worktree_clone_commons
)
_assert_contains "gitfile: the doctor reads a --separate-git-dir clone's admin area" \
  "$skip_home/elsewhere/sep.git" "$skip_commons"
_assert_not_contains "gitfile: the doctor never reads a parked worktree's external owner" \
  "$skip_home/elsewhere/owner" "$skip_commons"

# A clone named like a shared worktree root is a repository, not a root: an
# empty directory inside it is that repository's, never a leftover.
_gc_clone_main "$skip_origin_root/origin.git" "$skip_home/git/worktrees"
mkdir -p "$skip_home/git/worktrees/empty-src"
_gc_make_old "$skip_home/git/worktrees/empty-src"
result=$(HOME="$skip_home" DOTFILES="$skip_home/.dotfiles" GIT_TOOLS_ROOT="$STUB_ROOT" \
  "$GC" 2>/dev/null)
_assert_not_contains "shared root: a clone named worktrees is not swept as a root" \
  "$skip_home/git/worktrees/empty-src" "$result"

# Outside ~/git a shared root is never a clone root: a stray .git (an old
