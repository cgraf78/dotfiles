git init --quiet "$skip_home/worktrees"
mkdir -p "$skip_home/worktrees/old-left"
_gc_make_old "$skip_home/worktrees/old-left"
result=$(HOME="$skip_home" DOTFILES="$skip_home/.dotfiles" GIT_TOOLS_ROOT="$STUB_ROOT" \
  "$GC" 2>/dev/null)
_assert_contains "shared root: ~/worktrees with a stray .git is still swept" \
  "$(printf 'would-remove\t%s\tempty directory, no known registration' "$skip_home/worktrees/old-left")" "$result"

echo ""
echo "=== End to end with git-tools ==="

if ! gc_real_root=$(_gc_real_git_tools); then
  echo '  - skipping end-to-end cases: no git-tools with porcelain cleanup (set DOT_TEST_GIT_TOOLS_ROOT)'
else
  e2e_home=$(_gc_tmpdir)
  e2e_origin_root=$(_tmpdir)
  _gc_seed_origin "$e2e_origin_root/origin.git"
  # Old checkouts have old branches: date every commit and reflog entry three
