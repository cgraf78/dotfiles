  _assert_exit "e2e: a legacy bare client sweep exits 0" 0 "$?"
  _assert_not_contains "e2e: a legacy bare client is not refused as bare" \
    "bare repositories are not supported" "$result$(cat "$lb_home/stderr.txt")"
  _assert_contains "e2e: a legacy bare client's merged checkout is removed" \
    "$(printf 'removed\t%s\t' "$lb_home/.worktrees/old-lb")" "$result"
  _assert_file_missing "e2e: the legacy bare client's checkout is gone" "$lb_home/.worktrees/old-lb/.git"
  git --git-dir="$lb_home/.dotfiles" rev-parse --verify -q refs/heads/lb-no-checkout >/dev/null 2>&1
  _assert_exit "e2e: a legacy bare client's merged branch is deleted" 1 "$?"
  _assert_file_exists "e2e: the legacy bare client's HOME files survive" "$lb_home/file.txt"
fi
echo ""
echo "=== Empty unregistered directories are eligible for rmdir only ==="

empty_home=$(_gc_tmpdir)
empty_origin=$(_tmpdir)/origin.git
_gc_seed_origin "$empty_origin"
_gc_clone_main "$empty_origin" "$empty_home/git/alpha"
empty_main=$empty_home/git/alpha
empty_extra=$empty_home/extra-root
mkdir -p "$empty_home/.worktrees/old-empty" "$empty_home/.worktrees/young-empty" \
  "$empty_home/.worktrees/hidden-file" "$empty_home/.worktrees/visible-file" \
  "$empty_home/git/alpha/.worktrees/old-ci" "$empty_extra/old-test" "$empty_home/outside"
printf '%s\n' 'keep hidden data' >"$empty_home/.worktrees/hidden-file/.data"
printf '%s\n' 'keep data' >"$empty_home/.worktrees/visible-file/data"
ln -s "$empty_home/outside" "$empty_home/.worktrees/alias"
for empty_dir in "$empty_home/.worktrees/old-empty" "$empty_home/.worktrees/hidden-file" \
  "$empty_home/.worktrees/visible-file" "$empty_home/git/alpha/.worktrees/old-ci" \
  "$empty_extra/old-test" "$empty_home/outside"; do
  _gc_make_old "$empty_dir"
done
# A registration can survive the checkout's .git file; do not turn that
# recoverable Git problem into an automatic directory deletion.
empty_registered=$empty_home/.worktrees/registered
git -C "$empty_main" worktree add "$empty_registered" -b registered >/dev/null 2>&1
rm "$empty_registered/.git" "$empty_registered/file.txt"
_gc_make_old "$empty_registered"
result=$(HOME="$empty_home" DOTFILES="$empty_home/.dotfiles" "$GC" --no-fetch --root "$empty_extra" 2>/dev/null)
_assert_contains "empty: old shared directory is eligible" \
  "$(printf 'would-remove\t%s\tempty directory, no known registration' "$empty_home/.worktrees/old-empty")" "$result"
_assert_contains "empty: repo-local directory is eligible" \
  "$(printf 'would-remove\t%s\tempty directory, no known registration' "$empty_home/git/alpha/.worktrees/old-ci")" "$result"
_assert_contains "empty: explicit-root directory is eligible" \
  "$(printf 'would-remove\t%s\tempty directory, no known registration' "$empty_extra/old-test")" "$result"
_assert_contains "empty: young directory is kept" \
  "$(printf 'kept\t%s\tyounger than' "$empty_home/.worktrees/young-empty")" "$result"
_assert_contains "empty: hidden data prevents eligibility" \
  "$(printf 'skipped\t%s\tno .git' "$empty_home/.worktrees/hidden-file")" "$result"
_assert_contains "empty: visible data prevents eligibility" \
  "$(printf 'skipped\t%s\tno .git' "$empty_home/.worktrees/visible-file")" "$result"
_assert_contains "empty: registered checkout is kept" \
  "$(printf 'skipped\t%s\tregistered worktree, missing .git' "$empty_registered")" "$result"
_assert_not_contains "empty: symlink target is never eligible" \
  "$(printf 'would-remove\t%s\t' "$empty_home/outside")" "$result"
if [[ -d "$empty_home/.worktrees/old-empty" ]]; then status=0; else status=1; fi
_assert_exit "empty: dry run preserves the directory" 0 "$status"
result=$(HOME="$empty_home" DOTFILES="$empty_home/.dotfiles" "$GC" --no-fetch --apply --root "$empty_extra" 2>/dev/null)
if [[ -e "$empty_home/.worktrees/old-empty" || -L "$empty_home/.worktrees/old-empty" ]]; then status=0; else status=1; fi
_assert_exit "empty: old shared directory removed" 1 "$status"
if [[ -e "$empty_home/git/alpha/.worktrees/old-ci" || -L "$empty_home/git/alpha/.worktrees/old-ci" ]]; then status=0; else status=1; fi
_assert_exit "empty: repo-local directory removed" 1 "$status"
if [[ -e "$empty_extra/old-test" || -L "$empty_extra/old-test" ]]; then status=0; else status=1; fi
_assert_exit "empty: explicit-root directory removed" 1 "$status"
_assert_file_exists "empty: hidden data preserved" "$empty_home/.worktrees/hidden-file/.data"
_assert_file_exists "empty: visible data preserved" "$empty_home/.worktrees/visible-file/data"
if [[ -d "$empty_home/.worktrees/young-empty" ]]; then status=0; else status=1; fi
_assert_exit "empty: young directory preserved" 0 "$status"
if [[ -d "$empty_registered" ]]; then status=0; else status=1; fi
_assert_exit "empty: registered directory preserved" 0 "$status"
if [[ -d "$empty_home/outside" ]]; then status=0; else status=1; fi
_assert_exit "empty: symlink target preserved" 0 "$status"

# A file arriving after the empty check must survive the atomic rmdir gate.
race_bin=$(_tmpdir)
race_dir=$empty_home/.worktrees/race
mkdir -p "$race_dir"
_gc_make_old "$race_dir"
cat >"$race_bin/rmdir" <<'STUB'
#!/usr/bin/env bash
dir=${@: -1}
printf '%s\n' 'new work' >"$dir/arrived.txt"
exec "$EMPTY_REAL_RMDIR" "$@"
STUB
chmod +x "$race_bin/rmdir"
export EMPTY_REAL_RMDIR
EMPTY_REAL_RMDIR=$(command -v rmdir)
result=$(HOME="$empty_home" DOTFILES="$empty_home/.dotfiles" PATH="$race_bin:$PATH" "$GC" --no-fetch --apply 2>/dev/null)
_assert_file_exists "empty: concurrent file survives attempted removal" "$race_dir/arrived.txt"

_assert_contains "empty: concurrent contents are reported as a skip" \
  "$(printf 'skipped\t%s\tdirectory changed during cleanup' "$race_dir")" "$result"

empty_busy=$empty_home/.worktrees/busy
mkdir -p "$empty_busy"
_gc_make_old "$empty_busy"
if [[ -d /proc ]]; then
  result=$(
    cd -- "$empty_busy" || exit 1
    if ! _gc_cwd_visible "$BASHPID" "$empty_busy"; then
      printf '%s\n' 'EMPTY_CWD_UNAVAILABLE'
      exit 0
    fi
    HOME="$empty_home" DOTFILES="$empty_home/.dotfiles" "$GC" --no-fetch --apply 2>/dev/null
  )
  if [[ $result == EMPTY_CWD_UNAVAILABLE ]]; then
    echo '  - skipping empty in-use case: /proc cwd unavailable'
  else
    _assert_contains "empty: current working directory blocks removal" \
      "$(printf 'skipped\t%s\tin use' "$empty_busy")" "$result"
    if [[ -d $empty_busy ]]; then status=0; else status=1; fi
    _assert_exit "empty: in-use directory remains" 0 "$status"
  fi
else
  echo '  - skipping empty in-use case: no /proc on this platform'
fi

# A plain rmdir failure must be visible in the sweep status, not a success.
empty_failure=$empty_home/.worktrees/failure
mkdir -p "$empty_failure"
_gc_make_old "$empty_failure"
printf '#!/usr/bin/env bash\nexit 1\n' >"$race_bin/rmdir"
result=$(HOME="$empty_home" DOTFILES="$empty_home/.dotfiles" PATH="$race_bin:$PATH" "$GC" --no-fetch --apply 2>/dev/null)
status=$?
_assert_exit "empty: removal failure exits 2" 2 "$status"
if [[ -d $empty_failure ]]; then status=0; else status=1; fi
_assert_exit "empty: failed removal preserves directory" 0 "$status"
unset EMPTY_REAL_RMDIR

# Lost administrative metadata is eligible only for a full merged snapshot.
# This stronger fallback requires readable Linux process information.
if [[ -d /proc/self/cwd ]] && command -v python3 >/dev/null 2>&1; then
  orphan_home=$(_gc_tmpdir)
  mkdir -p "$orphan_home/git" "$orphan_home/.worktrees"
  _gc_seed_origin "$orphan_home/origin.git"
  git clone "$orphan_home/origin.git" "$orphan_home/git/owner" >/dev/null 2>&1
  orphan=$orphan_home/.worktrees/landed-orphan
  git -C "$orphan_home/git/owner" worktree add -b landed-orphan "$orphan" main >/dev/null 2>&1
  orphan_admin=$(git -C "$orphan" rev-parse --git-dir)
  rm -r -- "$orphan_admin"
  _gc_make_old "$orphan"
  result=$(HOME="$orphan_home" DOTFILES="$orphan_home/.dotfiles" "$GC" --no-fetch 2>/dev/null)
  _assert_contains "orphan: exact merged snapshot previewed" \
    "$(printf 'would-remove\t%s\torphaned checkout matches merged commit' "$orphan")" "$result"
  _assert_file_exists "orphan: preview preserves checkout" "$orphan/file.txt"
  printf 'private data\n' >"$orphan/.private"
  _gc_make_old "$orphan"
  result=$(HOME="$orphan_home" DOTFILES="$orphan_home/.dotfiles" "$GC" --no-fetch --apply 2>/dev/null)
  _assert_contains "orphan: hidden extra file blocks cleanup" \
    "$(printf 'skipped\t%s\torphaned checkout differs from merged history' "$orphan")" "$result"
  _assert_file_exists "orphan: hidden data survives" "$orphan/.private"
  rm -- "$orphan/.private"
  _gc_make_old "$orphan"
  result=$(HOME="$orphan_home" DOTFILES="$orphan_home/.dotfiles" "$GC" --no-fetch --apply 2>/dev/null)
  _assert_contains "orphan: exact merged snapshot removed" \
    "$(printf 'removed\t%s\torphaned checkout matches merged commit' "$orphan")" "$result"
  if [[ -e $orphan ]]; then orphan_status=1; else orphan_status=0; fi
  _assert_exit "orphan: checkout removed" 0 "$orphan_status"
  git -C "$orphan_home/git/owner" show-ref --verify --quiet refs/heads/landed-orphan
  orphan_status=$?
  _assert_exit "orphan: original branch retained" 0 "$orphan_status"
else
  echo '  - skipping orphan retirement case: python3 or readable /proc unavailable'
fi

_test_summary
