  export GIT_COMMITTER_DATE="@$(($(date +%s) - 3 * 86400)) +0000"
  _gc_build_matrix "$e2e_home" "$e2e_origin_root/origin.git"
  # A merged branch with no checkout at all: most leftovers look like this.
  e2e_main=$e2e_home/git/alpha
  git -C "$e2e_main" pull --quiet --ff-only origin main
  git -C "$e2e_main" switch --quiet -c no-checkout
  _gc_commit_file "$e2e_main" no-checkout.txt
  git -C "$e2e_main" switch --quiet main
  git -C "$e2e_main" merge --quiet --no-ff no-checkout -m "merge no-checkout"
  git -C "$e2e_main" push --quiet origin main
  unset GIT_COMMITTER_DATE
  # Its age reads the main repository this setup just touched.
  _gc_make_old "$e2e_home/.worktrees/fake-orphan"

  result=$(HOME="$e2e_home" DOTFILES="$e2e_home/.dotfiles" GIT_TOOLS_ROOT="$gc_real_root" \
    "$GC" 2>"$e2e_home/stderr.txt")
  _assert_exit "e2e: dry run exits 0" 0 "$?"
  _assert_contains "e2e: an old merged checkout would go" \
    "$(printf 'would-remove\t%s\t' "$e2e_home/.worktrees/old-merged")" "$result"
  _assert_contains "e2e: its merged branch would go" \
    "$(printf 'would-remove-branch\tfeat-a\t%s' "$e2e_main/.git")" "$result"
  _assert_contains "e2e: a merged branch without a checkout would go" \
    "$(printf 'would-remove-branch\tno-checkout\t%s' "$e2e_main/.git")" "$result"
  _assert_contains "e2e: a second repository is swept" \
    "$(printf 'would-remove\t%s\t' "$e2e_home/git/beta/.worktrees/old-merged-beta")" "$result"
  _assert_contains "e2e: a detached merged checkout would go" \
    "$(printf 'would-remove\t%s\tmerged' "$e2e_home/.worktrees/old-detached-merged")" "$result"
  _assert_contains "e2e: an unmerged checkout stays" \
    "$(printf 'skipped\t%s\tmerge unproven' "$e2e_home/.worktrees/old-unmerged")" "$result"
  _assert_contains "e2e: a dirty checkout stays" \
    "$(printf 'skipped\t%s\tdirty' "$e2e_home/.worktrees/old-dirty")" "$result"
  _assert_contains "e2e: a locked checkout stays" \
    "$(printf 'skipped\t%s\tlocked' "$e2e_home/git/worktrees/old-locked")" "$result"
  _assert_contains "e2e: a young checkout stays" \
    "$(printf 'kept\t%s\tyounger than 14 days' "$e2e_home/.worktrees/young-merged")" "$result"
  _assert_contains "e2e: a main checkout stays" \
    "$(printf 'skipped\t%s\tmain checkout' "$e2e_home/.worktrees/plain-clone")" "$result"
  _assert_contains "e2e: a remote-less repository's checkout stays" \
    "$(printf 'skipped\t%s\tno remote base branch' "$e2e_home/.worktrees/local-wt")" "$result"
  _assert_file_exists "e2e: the dry run removes nothing" "$e2e_home/.worktrees/old-merged/feat-a.txt"

  result=$(HOME="$e2e_home" DOTFILES="$e2e_home/.dotfiles" GIT_TOOLS_ROOT="$gc_real_root" \
    "$GC" --apply 2>/dev/null)
  _assert_exit "e2e: apply exits 0" 0 "$?"
  _assert_file_missing "e2e: the merged checkout is gone" "$e2e_home/.worktrees/old-merged/.git"
  git -C "$e2e_main" rev-parse --verify -q refs/heads/no-checkout >/dev/null 2>&1
  _assert_exit "e2e: the merged branch without a checkout is gone" 1 "$?"
  git -C "$e2e_main" rev-parse --verify -q refs/heads/wip-a >/dev/null 2>&1
  _assert_exit "e2e: the unmerged branch survives" 0 "$?"
  _assert_file_exists "e2e: the dirty checkout survives" "$e2e_home/.worktrees/old-dirty/feat-c.txt"
  _assert_file_exists "e2e: the locked checkout survives" "$e2e_home/git/worktrees/old-locked/feat-d.txt"

  # A legacy bare base client (core.bare=true, HOME as its work tree only
  # through the environment) is swept like a fresh one, not refused as bare.
  lb_home=$(_gc_tmpdir)
  lb_origin=$(_tmpdir)/origin.git
  _gc_seed_origin "$lb_origin"
  git clone --quiet --bare "$lb_origin" "$lb_home/.dotfiles" >/dev/null 2>&1
  lb_git=(git --git-dir="$lb_home/.dotfiles" --work-tree="$lb_home")
  _git_set_test_identity "${lb_git[@]}"
  "${lb_git[@]}" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
  "${lb_git[@]}" fetch --quiet origin
  "${lb_git[@]}" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main
  "${lb_git[@]}" reset --quiet --hard main
  export GIT_COMMITTER_DATE="@$(($(date +%s) - 3 * 86400)) +0000"
  "${lb_git[@]}" worktree add --quiet "$lb_home/.worktrees/old-lb" -b lb-merged >/dev/null 2>&1
  "${lb_git[@]}" branch lb-no-checkout main
  unset GIT_COMMITTER_DATE
  _gc_make_old "$lb_home/.worktrees/old-lb"
  _assert_eq "e2e: the legacy fixture is bare" "true" \
    "$(git --git-dir="$lb_home/.dotfiles" config --get core.bare)"

  result=$(HOME="$lb_home" DOTFILES="$lb_home/.dotfiles" GIT_TOOLS_ROOT="$gc_real_root" \
    "$GC" --apply 2>"$lb_home/stderr.txt")
  _assert_exit "e2e: a legacy bare client sweep exits 0" 0 "$?"
  _assert_not_contains "e2e: a legacy bare client is not refused as bare" \
    "bare repositories are not supported" "$result$(cat "$lb_home/stderr.txt")"
  _assert_contains "e2e: a legacy bare client's merged checkout is removed" \
    "$(printf 'removed\t%s\t' "$lb_home/.worktrees/old-lb")" "$result"
  _assert_file_missing "e2e: the legacy bare client's checkout is gone" "$lb_home/.worktrees/old-lb/.git"
  git --git-dir="$lb_home/.dotfiles" rev-parse --verify -q refs/heads/lb-no-checkout >/dev/null 2>&1
  _assert_exit "e2e: a legacy bare client's merged branch is deleted" 1 "$?"
  _assert_file_exists "e2e: the legacy bare client's HOME files survive" "$lb_home/file.txt"

  # A --separate-git-dir clone is cleaned from its clone root, which Git
  # itself cannot name as its main checkout.
  sep_home=$(_gc_tmpdir)
  sep_origin=$(_tmpdir)/origin.git
  _gc_seed_origin "$sep_origin"
  mkdir -p "$sep_home/git" "$sep_home/elsewhere"
  git clone --quiet --separate-git-dir="$sep_home/elsewhere/sep.git" "$sep_origin" \
    "$sep_home/git/sep" 2>/dev/null
  git -C "$sep_home/git/sep" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main
  _git_set_test_identity git -C "$sep_home/git/sep"
  export GIT_COMMITTER_DATE="@$(($(date +%s) - 3 * 86400)) +0000"
  git -C "$sep_home/git/sep" switch --quiet -c sep-merged
  _gc_commit_file "$sep_home/git/sep" sep-merged.txt
  git -C "$sep_home/git/sep" switch --quiet main
  git -C "$sep_home/git/sep" merge --quiet --no-ff sep-merged -m "merge sep-merged"
  git -C "$sep_home/git/sep" push --quiet origin main
  unset GIT_COMMITTER_DATE
  result=$(HOME="$sep_home" DOTFILES="$sep_home/.dotfiles" GIT_TOOLS_ROOT="$gc_real_root" \
    "$GC" 2>/dev/null)
  _assert_contains "e2e: a --separate-git-dir clone's merged branch would go" \
    "$(printf 'would-remove-branch\tsep-merged\t%s' "$sep_home/elsewhere/sep.git")" "$result"

  # Configuration the host injects through the environment (here a
  # url.<base>.insteadOf rewrite, as a devserver does for GitHub) is what
  # lets git-tools reach the remote; dropping it would leave every sweep
  # offline.
  cfg_home=$(_gc_tmpdir)
  cfg_origin_root=$(_tmpdir)
  _gc_seed_origin "$cfg_origin_root/origin.git"
  _gc_clone_main "$cfg_origin_root/origin.git" "$cfg_home/git/alpha"
  export GIT_COMMITTER_DATE="@$(($(date +%s) - 3 * 86400)) +0000"
  git -C "$cfg_home/git/alpha" switch --quiet -c cfg-merged
  _gc_commit_file "$cfg_home/git/alpha" cfg-merged.txt
  git -C "$cfg_home/git/alpha" switch --quiet main
  git -C "$cfg_home/git/alpha" merge --quiet --no-ff cfg-merged -m "merge cfg-merged"
  git -C "$cfg_home/git/alpha" push --quiet origin main
  unset GIT_COMMITTER_DATE
  git -C "$cfg_home/git/alpha" remote set-url origin gh:origin.git
  result=$(HOME="$cfg_home" DOTFILES="$cfg_home/.dotfiles" GIT_TOOLS_ROOT="$gc_real_root" \
    GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0="url.$cfg_origin_root/.insteadOf" GIT_CONFIG_VALUE_0=gh: \
    "$GC" 2>"$cfg_home/stderr.txt")
  _assert_not_contains "e2e: an env-injected insteadOf rewrite still reaches the remote" \
    "remote base unreachable" "$(cat "$cfg_home/stderr.txt")"
  _assert_contains "e2e: the remote-proven branch would go" \
    "$(printf 'would-remove-branch\tcfg-merged\t')" "$result"

  # A linked worktree parked under ~/git whose repository lives elsewhere
  # brings that repository into nothing: its merged branch stays.
  ext_home=$(_gc_tmpdir)
  ext_root=$(_gc_tmpdir)
  _gc_seed_origin "$ext_root/origin.git"
  _gc_clone_main "$ext_root/origin.git" "$ext_root/ext/repo"
  export GIT_COMMITTER_DATE="@$(($(date +%s) - 3 * 86400)) +0000"
  git -C "$ext_root/ext/repo" switch --quiet -c ext-merged
  _gc_commit_file "$ext_root/ext/repo" ext-merged.txt
  git -C "$ext_root/ext/repo" switch --quiet main
  git -C "$ext_root/ext/repo" merge --quiet --no-ff ext-merged -m "merge ext-merged"
  git -C "$ext_root/ext/repo" push --quiet origin main
  unset GIT_COMMITTER_DATE
  mkdir -p "$ext_home/git"
  git -C "$ext_root/ext/repo" worktree add --quiet "$ext_home/git/ext-wt" -b ext-wt 2>/dev/null
  # Nor does an old merged checkout of it nested in the parked worktree's
  # own .worktrees, which no clone root holds.
  mkdir -p "$ext_home/git/ext-wt/.worktrees"
  export GIT_COMMITTER_DATE="@$(($(date +%s) - 3 * 86400)) +0000"
  _gc_merged_worktree "$ext_root/ext/repo" "$ext_home/git/ext-wt/.worktrees/old" ext-old
  unset GIT_COMMITTER_DATE
  result=$(HOME="$ext_home" DOTFILES="$ext_home/.dotfiles" GIT_TOOLS_ROOT="$gc_real_root" \
    "$GC" --apply 2>/dev/null)
  _assert_file_exists "e2e: a checkout in a parked worktree's .worktrees survives --apply" \
    "$ext_home/git/ext-wt/.worktrees/old/ext-old.txt"
  _assert_not_contains "e2e: a parked worktree's external owner is not swept" "ext-merged" "$result"
  git -C "$ext_root/ext/repo" rev-parse --verify -q refs/heads/ext-merged >/dev/null 2>&1
  _assert_exit "e2e: the external owner's merged branch survives --apply" 0 "$?"
fi
echo ""
echo "=== Empty unregistered directories are eligible for rmdir only ==="

empty_home=$(_gc_tmpdir)
empty_origin=$(_tmpdir)/origin.git
_gc_seed_origin "$empty_origin"
_gc_clone_main "$empty_origin" "$empty_home/git/alpha"
empty_main=$empty_home/git/alpha
empty_extra=$empty_home/extra-root
mkdir -p "$empty_home/.worktrees/old-empty" "$empty_home/.worktrees/young-empty" \
  "$empty_home/.worktrees/hidden-file" "$empty_home/.worktrees/visible-file" \
  "$empty_home/git/alpha/.worktrees/old-ci" "$empty_extra/old-test" "$empty_home/outside"
printf '%s\n' 'keep hidden data' >"$empty_home/.worktrees/hidden-file/.data"
printf '%s\n' 'keep data' >"$empty_home/.worktrees/visible-file/data"
ln -s "$empty_home/outside" "$empty_home/.worktrees/alias"
for empty_dir in "$empty_home/.worktrees/old-empty" "$empty_home/.worktrees/hidden-file" \
  "$empty_home/.worktrees/visible-file" "$empty_home/git/alpha/.worktrees/old-ci" \
  "$empty_extra/old-test" "$empty_home/outside"; do
  _gc_make_old "$empty_dir"
done
