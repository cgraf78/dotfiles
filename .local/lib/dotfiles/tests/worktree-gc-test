#!/usr/bin/env bash
# worktree-gc-test — dot-worktree-gc multi-repo cleanup coverage.
#
# dot-worktree-gc owns discovery, the age policy, and directories no
# repository can speak for; every per-repository decision comes from
# `git cleanup-repo` in git-tools. Most cases run against a stub provider
# that logs its arguments and answers with porcelain records, so discovery,
# repository coverage, argument plumbing, and record mapping are covered
# without git-tools installed. The end-to-end cases run against a real
# git-tools with porcelain cleanup (DOT_TEST_GIT_TOOLS_ROOT, or the host's
# checkout or Shdeps install) and skip when none is available.

set -o pipefail
export NO_COLOR=1

# shellcheck source=helpers.sh
. "${BASH_SOURCE[0]%/*}/helpers.sh"
_test_prefer_system_git || exit 1

ROOT=$(cd -P -- "${BASH_SOURCE[0]%/*}/../../../.." && pwd -P)
GC=$ROOT/.local/bin/dot-worktree-gc

# Fixture git operations must never execute ambient developer hooks:
# installed profiles point core.hooksPath at sley, whose gate fails
# fixture commits in sandboxes. An empty hooks dir disables hooks for
# every git call below, fixtures and tool alike; the tool performs no
# hook-triggering operations so its behavior is unchanged.
_GC_EMPTY_HOOKS_DIR=$(_tmpdir)/empty-hooks
mkdir -p "$_GC_EMPTY_HOOKS_DIR"
_test_hermetic_git core.hooksPath "$_GC_EMPTY_HOOKS_DIR"

# Seed a bare origin with a main branch carrying one commit.
_gc_seed_origin() {
  local origin=$1 seed
  seed=$(_tmpdir)
  git init --bare "$origin" >/dev/null 2>&1
  git --git-dir="$origin" symbolic-ref HEAD refs/heads/main >/dev/null 2>&1
  git init "$seed" >/dev/null 2>&1
  _git_set_test_identity git -C "$seed"
  printf '%s\n' 'seed' >"$seed/file.txt"
  git -C "$seed" add file.txt >/dev/null 2>&1
  git -C "$seed" commit -m seed >/dev/null 2>&1
  git -C "$seed" branch -M main >/dev/null 2>&1
  git -C "$seed" push "$origin" main:main >/dev/null 2>&1
}

_gc_commit_file() {
  local dir=$1 name=$2
  printf '%s\n' "$name" >"$dir/$name"
  git -C "$dir" add "$name" >/dev/null 2>&1
  git -C "$dir" commit -m "$name" >/dev/null 2>&1
}

# Print the checkout plus the Git activity files the sweep ages it by
# (its Git directory's HEAD and index).
_gc_age_paths() {
  local dir=$1 gitdir='' first signal
  printf '%s\n' "$dir"
  if [[ -d $dir/.git ]]; then
    gitdir=$dir/.git
  elif [[ -f $dir/.git ]] && IFS= read -r first <"$dir/.git"; then
    gitdir=${first#gitdir: }
    [[ $gitdir == /* ]] || gitdir=$dir/$gitdir
  fi
  [[ -n $gitdir ]] || return 0
  for signal in "$gitdir/HEAD" "$gitdir/index"; do
    [[ -e $signal ]] && printf '%s\n' "$signal"
  done
  return 0
}
_gc_make_old() {
  local path
  while IFS= read -r path; do
    touch -t 202001010000 "$path"
  done < <(_gc_age_paths "$1")
}
_gc_make_age_days() {
  local path
  while IFS= read -r path; do
    python3 -c 'import os,sys,time; t=int(time.time())-int(sys.argv[2])*86400; os.utime(sys.argv[1],(t,t))' "$path" "$2"
  done < <(_gc_age_paths "$1")
}

# Fixture HOME with physical (symlink-resolved) spelling: the tool
# reports physical paths, and TMPDIR is a symlink on some platforms
# (macOS /var -> /private/var), so expected paths must resolve too.
_gc_tmpdir() {
  local dir
  dir=$(_tmpdir) || return 1
  (cd -- "$dir" && pwd -P)
}
_gc_make_fresh() { touch "$1"; }

# Succeed when this platform resolves PID's /proc working directory to DIR
# the way the gc does (`cd -P` plus `pwd -P`). Polls up to 10s for the
# process to get there. In-use cases skip with a reason when it never does.
_gc_cwd_visible() {
  local pid=$1 dir=$2 deadline=$((SECONDS + 10)) want got
  want=$(cd -P -- "$dir" && pwd -P) || return 1
  while ((SECONDS <= deadline)); do
    got=$(cd -P -- "/proc/$pid/cwd" 2>/dev/null && pwd -P 2>/dev/null) || got=
    [[ $got == "$want" ]] && return 0
    sleep 0.1
  done
  return 1
}

# Clone an origin as a repo main checkout and pin its remote HEAD so
# default-branch detection never depends on clone transport behavior.
_gc_clone_main() {
  local origin=$1 dest=$2
  git clone "$origin" "$dest" >/dev/null 2>&1
  _git_set_test_identity git -C "$dest"
  git -C "$dest" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main >/dev/null 2>&1
}

# Merge a worktree branch into the main checkout's default and publish it.
_gc_merge_branch() {
  local main=$1 branch=$2
  git -C "$main" fetch origin >/dev/null 2>&1
  git -C "$main" merge --no-ff "origin/$branch" -m "merge $branch" >/dev/null 2>&1
  git -C "$main" push origin main >/dev/null 2>&1
}

# Build the standard matrix: two repos (alpha, beta) under $home/git with
# linked worktrees covering every gc verdict. Prints nothing; callers know
# the layout.
_gc_build_matrix() {
  local home=$1 origin=$2
  local main wt

  _gc_clone_main "$origin" "$home/git/alpha"
  main=$home/git/alpha

  # Old, merged into the upstream default: removed.
  git -C "$main" worktree add "$home/.worktrees/old-merged" -b feat-a >/dev/null 2>&1
  wt=$home/.worktrees/old-merged
  _git_set_test_identity git -C "$wt"
  _gc_commit_file "$wt" feat-a.txt
  git -C "$wt" push -u origin feat-a >/dev/null 2>&1
  _gc_merge_branch "$main" feat-a
  git -C "$wt" fetch --prune origin >/dev/null 2>&1
  _gc_make_old "$wt"

  # Old, unmerged, upstream alive: skipped.
  git -C "$main" worktree add "$home/.worktrees/old-unmerged" -b wip-a >/dev/null 2>&1
  wt=$home/.worktrees/old-unmerged
  _git_set_test_identity git -C "$wt"
  _gc_commit_file "$wt" wip-a.txt
  git -C "$wt" push -u origin wip-a >/dev/null 2>&1
  _gc_make_old "$wt"

  # Young, merged: kept.
  git -C "$main" worktree add "$home/.worktrees/young-merged" -b feat-b >/dev/null 2>&1
  wt=$home/.worktrees/young-merged
  _git_set_test_identity git -C "$wt"
  _gc_commit_file "$wt" feat-b.txt
  git -C "$wt" push -u origin feat-b >/dev/null 2>&1
  _gc_merge_branch "$main" feat-b
  git -C "$wt" fetch --prune origin >/dev/null 2>&1
  _gc_make_fresh "$wt"

  # Old, merged, but dirty: skipped.
  git -C "$main" worktree add "$home/.worktrees/old-dirty" -b feat-c >/dev/null 2>&1
  wt=$home/.worktrees/old-dirty
  _git_set_test_identity git -C "$wt"
  _gc_commit_file "$wt" feat-c.txt
  git -C "$wt" push -u origin feat-c >/dev/null 2>&1
  _gc_merge_branch "$main" feat-c
  git -C "$wt" fetch --prune origin >/dev/null 2>&1
  printf '%s\n' 'local edit' >>"$wt/feat-c.txt"
  _gc_make_old "$wt"

  # Old, detached at a merged commit: removed.
  git -C "$main" worktree add --detach "$home/.worktrees/old-detached-merged" main >/dev/null 2>&1
  _gc_make_old "$home/.worktrees/old-detached-merged"

  # Old, detached at an unmerged commit: skipped.
  git -C "$main" worktree add --detach "$home/.worktrees/old-detached-unmerged" wip-a >/dev/null 2>&1
  _gc_make_old "$home/.worktrees/old-detached-unmerged"

  # Old, merged, but locked: skipped.
  git -C "$main" worktree add "$home/git/worktrees/old-locked" -b feat-d >/dev/null 2>&1
  wt=$home/git/worktrees/old-locked
  _git_set_test_identity git -C "$wt"
  _gc_commit_file "$wt" feat-d.txt
  git -C "$wt" push -u origin feat-d >/dev/null 2>&1
  _gc_merge_branch "$main" feat-d
  git -C "$wt" fetch --prune origin >/dev/null 2>&1
  git -C "$main" worktree lock "$wt" >/dev/null 2>&1
  _gc_make_old "$wt"

  # Old plain clone: its own main checkout, never removable: skipped.
  _gc_clone_main "$origin" "$home/.worktrees/plain-clone"
  _gc_make_old "$home/.worktrees/plain-clone"

  # Nonempty old directory without Git metadata: preserve its unknown files.
  mkdir -p "$home/.worktrees/no-git"
  printf '%s\n' 'unknown work' >"$home/.worktrees/no-git/.note"
  _gc_make_old "$home/.worktrees/no-git"

  # Old, .git pointer whose repo was deleted: skipped.
  mkdir -p "$home/.worktrees/broken-pointer"
  printf 'gitdir: %s\n' "$home/git/deleted-repo/.git" >"$home/.worktrees/broken-pointer/.git"
  _gc_make_old "$home/.worktrees/broken-pointer"

  # Old, git metadata usable but checkout unregistered: skipped.
  mkdir -p "$home/.worktrees/fake-orphan"
  printf 'gitdir: %s\n' "$main/.git" >"$home/.worktrees/fake-orphan/.git"
  _gc_make_old "$home/.worktrees/fake-orphan"

  # Old linked worktree in a repo without remotes: nothing to prove: skipped.
  git init "$home/git/local-only" >/dev/null 2>&1
  _git_set_test_identity git -C "$home/git/local-only"
  _gc_commit_file "$home/git/local-only" local.txt
  git -C "$home/git/local-only" branch -M main >/dev/null 2>&1
  git -C "$home/git/local-only" worktree add "$home/.worktrees/local-wt" -b feat-local >/dev/null 2>&1
  _git_set_test_identity git -C "$home/.worktrees/local-wt"
  _gc_commit_file "$home/.worktrees/local-wt" feat-local.txt
  _gc_make_old "$home/.worktrees/local-wt"

  # Second repo proving the multi-repo sweep.
  _gc_clone_main "$origin" "$home/git/beta"
  git -C "$home/git/beta" worktree add "$home/git/beta/.worktrees/old-merged-beta" -b feat-beta >/dev/null 2>&1
  wt=$home/git/beta/.worktrees/old-merged-beta
  _git_set_test_identity git -C "$wt"
  _gc_commit_file "$wt" feat-beta.txt
  git -C "$wt" push -u origin feat-beta >/dev/null 2>&1
  _gc_merge_branch "$home/git/beta" feat-beta
  git -C "$wt" fetch --prune origin >/dev/null 2>&1
  _gc_make_old "$wt"
}

# A git-tools root whose git-cleanup-repo is a stub. It logs every call and
# answers --help probes (failing them under STUB_OLD, as a release without
# porcelain cleanup would). With STUB_RECORDS it prints that file; otherwise
# it decides every selected worktree: kept as merge-unproven when its path
# contains STUB_KEEP, removed otherwise. STUB_FAIL_FETCH fails runs that would
# fetch with the unreachable-remote status 3, and STUB_FAIL fails every run
# with status 2.
_gc_stub_root() {
  local root
  root=$(_tmpdir)/git-tools
  mkdir -p "$root/bin"
  cat >"$root/bin/git-cleanup-repo" <<'STUB'
#!/usr/bin/env bash
if [[ " $* " == *" --help "* ]]; then
  [[ -n ${STUB_OLD:-} ]] && exit 2
  exit 0
fi
{
  stdin=tty
  [[ -t 0 ]] || stdin=none
  printf 'call\tcwd=%s\tgit_dir=%s\twork_tree=%s\tprompt=%s\tgcm=%s\taskpass=%s\tstdin=%s\n' \
    "$PWD" "${GIT_DIR:-}" "${GIT_WORK_TREE:-}" "${GIT_TERMINAL_PROMPT:-}" \
    "${GCM_INTERACTIVE:-}" "${GIT_ASKPASS-unset}" "$stdin"
  printf 'arg\t%s\n' "$@"
} >>"${STUB_LOG:-/dev/null}"
if [[ -n ${STUB_FAIL_FETCH:-} && " $* " != *" --no-fetch "* ]]; then
  echo "git cleanup-repo: could not inspect remote base branch: origin/main" >&2
  exit 3
fi
if [[ -n ${STUB_FAIL:-} ]]; then
  echo "git cleanup-repo: a note before the failure" >&2
  echo "git cleanup-repo: boom" >&2
  exit 2
fi
if [[ -n ${STUB_RECORDS:-} ]]; then
  cat "$STUB_RECORDS"
  exit 0
fi
dry=0
[[ " $* " == *" --dry-run "* ]] && dry=1
while (($# > 0)); do
  case $1 in
    --worktree | --retire-worktree)
      code=merged
      [[ $1 == --retire-worktree ]] && code=requested
      branch=$(git -C "$2" symbolic-ref -q --short HEAD 2>/dev/null)
      if [[ -n ${STUB_KEEP:-} && $2 == *"$STUB_KEEP"* ]]; then
        printf 'keep-worktree\t%s\tmerge-unproven\t%s\n' "$2" "$branch"
      elif ((dry)); then
        printf 'would-remove-worktree\t%s\t%s\t%s\n' "$2" "$code" "$branch"
      else
        printf 'remove-worktree\t%s\t%s\t%s\n' "$2" "$code" "$branch"
      fi
      shift 2
      continue
      ;;
  esac
  shift
done
exit 0
STUB
  chmod +x "$root/bin/git-cleanup-repo"
  printf '%s\n' "$root"
}

# Print a real git-tools root that supports porcelain cleanup, or fail.
_gc_real_git_tools() {
  local host_home=${DOT_TEST_HOST_HOME:-$HOME} candidate
  # The installed release, not a development checkout on whatever branch it
  # happens to have, unless DOT_TEST_GIT_TOOLS_ROOT names one deliberately.
  for candidate in "${DOT_TEST_GIT_TOOLS_ROOT:-}" \
    "$host_home/.local/share/cgraf78/git-tools"; do
    [[ -n $candidate && -x $candidate/bin/git-cleanup-repo ]] || continue
    "$candidate/bin/git-cleanup-repo" --porcelain --no-update-base \
      --worktree . --retire-worktree . --include-closed --min-age 1 \
      --help >/dev/null 2>&1 || continue
    (cd -P -- "$candidate" && pwd -P)
    return 0
  done
  return 1
}

# A merged linked worktree of MAIN on BRANCH at WT, made old.
_gc_merged_worktree() {
  local main=$1 wt=$2 branch=$3
  git -C "$main" worktree add "$wt" -b "$branch" >/dev/null 2>&1
  _git_set_test_identity git -C "$wt"
  _gc_commit_file "$wt" "$branch.txt"
  git -C "$wt" push -u origin "$branch" >/dev/null 2>&1
  _gc_merge_branch "$main" "$branch"
  git -C "$wt" fetch --prune origin >/dev/null 2>&1
  _gc_make_old "$wt"
}

STUB_ROOT=$(_gc_stub_root)

echo "=== Usage errors ==="

usage_home=$(_gc_tmpdir)
result=$(HOME="$usage_home" DOTFILES="$usage_home/.dotfiles" "$GC" --older-than bogus 2>&1)
status=$?
_assert_exit "usage: invalid age exits 1" 1 "$status"
_assert_contains "usage: invalid age prints usage" "usage:" "$result"

result=$(HOME="$usage_home" DOTFILES="$usage_home/.dotfiles" "$GC" --bogus-flag 2>&1)
status=$?
_assert_exit "usage: unknown flag exits 1" 1 "$status"

result=$(HOME="$usage_home" DOTFILES="$usage_home/.dotfiles" "$GC" --dry-run --apply 2>&1)
status=$?
_assert_exit "usage: both modes exits 1" 1 "$status"

result=$(HOME="$usage_home" DOTFILES="$usage_home/.dotfiles" "$GC" extra-positional 2>&1)
status=$?
_assert_exit "usage: positional argument exits 1" 1 "$status"

result=$(env -u HOME DOTFILES="$usage_home/.dotfiles" "$GC" 2>&1)
status=$?
_assert_exit "usage: unset HOME exits 1" 1 "$status"

echo ""
echo "=== A missing or older git-tools skips repository cleanup ==="

prov_home=$(_gc_tmpdir)
prov_origin_root=$(_tmpdir)
_gc_seed_origin "$prov_origin_root/origin.git"
_gc_clone_main "$prov_origin_root/origin.git" "$prov_home/git/alpha"
_gc_merged_worktree "$prov_home/git/alpha" "$prov_home/.worktrees/old-merged" feat-p
mkdir -p "$prov_home/.worktrees/old-empty"
_gc_make_old "$prov_home/.worktrees/old-empty"

result=$(HOME="$prov_home" DOTFILES="$prov_home/.dotfiles" \
  GIT_TOOLS_ROOT="$prov_home/no-git-tools" "$GC" --apply 2>"$prov_home/stderr.txt")
_assert_exit "provider: missing git-tools still exits 0" 0 "$?"
_assert_contains "provider: missing git-tools is announced" \
  "git-tools not found" "$(cat "$prov_home/stderr.txt")"
_assert_contains "provider: an old checkout waits for git-tools" \
  "$(printf 'skipped\t%s\tgit-tools cleanup unavailable' "$prov_home/.worktrees/old-merged")" "$result"
_assert_contains "provider: empty directories are still retired" \
  "$(printf 'removed\t%s\tempty directory, no known registration' "$prov_home/.worktrees/old-empty")" "$result"
_assert_file_exists "provider: the old checkout survives" "$prov_home/.worktrees/old-merged/feat-p.txt"

result=$(HOME="$prov_home" DOTFILES="$prov_home/.dotfiles" GIT_TOOLS_ROOT="$STUB_ROOT" \
  STUB_OLD=1 "$GC" 2>"$prov_home/stderr.txt")
_assert_contains "provider: a git-tools without porcelain cleanup is announced" \
  "predates porcelain cleanup" "$(cat "$prov_home/stderr.txt")"
_assert_contains "provider: an older git-tools is never driven" \
  "$(printf 'skipped\t%s\tgit-tools cleanup unavailable' "$prov_home/.worktrees/old-merged")" "$result"

echo ""
echo "=== Every managed clone is swept with the right arguments ==="

arg_home=$(_gc_tmpdir)
arg_origin_root=$(_tmpdir)
_gc_seed_origin "$arg_origin_root/origin.git"
_gc_clone_main "$arg_origin_root/origin.git" "$arg_home/git/alpha"
_gc_clone_main "$arg_origin_root/origin.git" "$arg_home/git/quiet"
_gc_clone_main "$arg_origin_root/origin.git" "$arg_home/.dotfiles-dev"
_gc_merged_worktree "$arg_home/git/alpha" "$arg_home/.worktrees/old-a" feat-old-a
git -C "$arg_home/git/alpha" worktree add "$arg_home/.worktrees/young-a" -b feat-young-a >/dev/null 2>&1
_gc_make_fresh "$arg_home/.worktrees/young-a"
arg_log=$(_tmpdir)/stub.log

# An editor terminal's askpass helper (VS Code sets GIT_ASKPASS) would raise
# a credential dialog even with terminal prompts off.
HOME="$arg_home" DOTFILES="$arg_home/.dotfiles" GIT_TOOLS_ROOT="$STUB_ROOT" \
  GIT_ASKPASS=/bin/false STUB_LOG="$arg_log" "$GC" >/dev/null 2>&1
_assert_exit "args: dry run exits 0" 0 "$?"
arg_calls=$(cat "$arg_log")
for arg_repo in git/alpha git/quiet .dotfiles-dev; do
  _assert_contains "args: a clone without old checkouts is swept too (${arg_repo})" \
    "$(printf 'call\tcwd=%s\t' "$arg_home/$arg_repo")" "$arg_calls"
done
for arg_flag in --no-update-base --porcelain --dry-run; do
  _assert_contains "args: the sweep passes $arg_flag" "$(printf 'arg\t%s' "$arg_flag")" "$arg_calls"
done
_assert_contains "args: branches proven only by ancestry wait a day" \
  "$(printf 'arg\t--min-age\narg\t1')" "$arg_calls"
_assert_contains "args: the resolved remote is passed explicitly" \
  "$(printf 'arg\t--remote\narg\torigin')" "$arg_calls"
# git-tools resolves the base branch: only it can follow a remote whose
# default branch moved after the local <remote>/HEAD was recorded.
_assert_not_contains "args: the base branch is left to git-tools" \
  "$(printf 'arg\t--base')" "$arg_calls"
_assert_contains "args: credential prompts are disabled" \
  "$(printf '\tprompt=0\tgcm=never\taskpass=\t')" "$arg_calls"
_assert_not_contains "args: an inherited askpass helper is cleared" \
  "askpass=/bin/false" "$arg_calls"
_assert_not_contains "args: credential prompts are disabled for every repository" \
  "$(printf '\tprompt=\t')" "$arg_calls"
_assert_not_contains "args: the provider never reads the terminal" \
  "$(printf '\tstdin=tty')" "$arg_calls"
_assert_contains "args: an old checkout is selected" \
  "$(printf 'arg\t--worktree\narg\t%s' "$arg_home/.worktrees/old-a")" "$arg_calls"
_assert_not_contains "args: a young checkout is never selected" "young-a" "$arg_calls"
_assert_not_contains "args: the dry run does not fetch-disable by default" \
  "$(printf 'arg\t--no-fetch')" "$arg_calls"
_assert_eq "args: each repository is cleaned in exactly one call" \
  "$(grep -c $'^call\t' <<<"$arg_calls")" "$(grep $'^call\t' <<<"$arg_calls" | sort -u | wc -l | tr -d ' ')"

# Only a base read from <remote>/HEAD is left to git-tools. Without that
# symref, or when it names a pruned branch, gc's own base is passed so both
# tools prove against the same branch, offline too.
git -C "$arg_home/git/quiet" symbolic-ref --delete refs/remotes/origin/HEAD
git -C "$arg_home/.dotfiles-dev" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/pruned
: >"$arg_log"
HOME="$arg_home" DOTFILES="$arg_home/.dotfiles" GIT_TOOLS_ROOT="$STUB_ROOT" \
  STUB_LOG="$arg_log" "$GC" --no-fetch >/dev/null 2>&1
arg_calls=$(cat "$arg_log")
# The arguments of the call made from one repository's directory.
_gc_call_args() {
  awk -v want="cwd=$1" -F '\t' \
    '$1 == "call" { on = ($2 == want); next } on' <<<"$2"
}
for arg_repo in git/quiet .dotfiles-dev; do
  _assert_contains "args: a base not read from origin/HEAD is passed explicitly (${arg_repo})" \
    "$(printf 'arg\t--base\narg\tmain')" "$(_gc_call_args "$arg_home/$arg_repo" "$arg_calls")"
done
_assert_not_contains "args: a base read from origin/HEAD is still left to git-tools" \
  "$(printf 'arg\t--base')" "$(_gc_call_args "$arg_home/git/alpha" "$arg_calls")"
git -C "$arg_home/git/quiet" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main
git -C "$arg_home/.dotfiles-dev" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main

: >"$arg_log"
HOME="$arg_home" DOTFILES="$arg_home/.dotfiles" GIT_TOOLS_ROOT="$STUB_ROOT" \
  STUB_LOG="$arg_log" "$GC" --apply --no-fetch --include-closed >/dev/null 2>&1
arg_calls=$(cat "$arg_log")
_assert_not_contains "args: --apply runs for real" "$(printf 'arg\t--dry-run')" "$arg_calls"
_assert_contains "args: --no-fetch is passed through" "$(printf 'arg\t--no-fetch')" "$arg_calls"
_assert_contains "args: --include-closed is passed through" \
  "$(printf 'arg\t--include-closed')" "$arg_calls"

# The base client's work tree is HOME through core.worktree: it is cleaned
# from HOME with GIT_DIR naming its Git directory.
git init --bare "$arg_home/.dotfiles" >/dev/null 2>&1
git --git-dir="$arg_home/.dotfiles" config core.bare false
git --git-dir="$arg_home/.dotfiles" config core.worktree "$arg_home"
arg_base_git=(git --git-dir="$arg_home/.dotfiles" --work-tree="$arg_home")
_git_set_test_identity "${arg_base_git[@]}"
"${arg_base_git[@]}" remote add origin "$arg_origin_root/origin.git" >/dev/null 2>&1
"${arg_base_git[@]}" fetch origin >/dev/null 2>&1
"${arg_base_git[@]}" checkout -b main origin/main >/dev/null 2>&1
"${arg_base_git[@]}" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main >/dev/null 2>&1
: >"$arg_log"
HOME="$arg_home" DOTFILES="$arg_home/.dotfiles" GIT_TOOLS_ROOT="$STUB_ROOT" \
  STUB_LOG="$arg_log" "$GC" >/dev/null 2>&1
_assert_contains "args: the base client is cleaned from HOME with GIT_DIR and GIT_WORK_TREE" \
  "$(printf 'call\tcwd=%s\tgit_dir=%s\twork_tree=%s\t' "$arg_home" "$arg_home/.dotfiles" "$arg_home")" \
  "$(cat "$arg_log")"

# A legacy bare client (core.bare=true, no core.worktree) has a work tree
# only through the environment, so it gets the same GIT_WORK_TREE.
git --git-dir="$arg_home/.dotfiles" config --unset core.worktree
git --git-dir="$arg_home/.dotfiles" config core.bare true
: >"$arg_log"
HOME="$arg_home" DOTFILES="$arg_home/.dotfiles" GIT_TOOLS_ROOT="$STUB_ROOT" \
  STUB_LOG="$arg_log" "$GC" >/dev/null 2>&1
