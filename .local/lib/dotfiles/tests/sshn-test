#!/usr/bin/env bash

set -euo pipefail

SOURCE_HOME=${DOT_TEST_SOURCE_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)}
SSHN_SOURCE=$SOURCE_HOME/.config/shell/interactive.d/55-ssh.sh
TEST_TMPDIR=$(mktemp -d)
trap 'rm -rf "$TEST_TMPDIR"' EXIT

mkdir -p "$TEST_TMPDIR/bin"
cat >"$TEST_TMPDIR/bin/ssh" <<'EOF'
#!/bin/sh
printf '%s\n' "$@" >"$SSHN_CAPTURE"
EOF
chmod +x "$TEST_TMPDIR/bin/ssh"

pass=0

check_login() {
  local shell_name=$1 label=$2 line i=0
  local -a expected
  shift 2

  # shellcheck disable=SC2016 # The child shell expands the forwarded args.
  PATH="$TEST_TMPDIR/bin:$PATH" SSHN_SOURCE="$SSHN_SOURCE" \
    SSHN_CAPTURE="$TEST_TMPDIR/actual" \
    "$shell_name" -c '. "$SSHN_SOURCE"; sshn "$@"' "$shell_name" "$@"

  expected=(-t "$@")
  while IFS= read -r line; do
    if ((i < ${#expected[@]})); then
      if [[ $line != "${expected[$i]}" ]]; then
        printf '%s: SSH argument %s changed\n' "$label" "$i" >&2
        exit 1
      fi
    elif ((i == ${#expected[@]})); then
      case $line in
        "NO_TMUX=1 DS_SSHN_SHELL=$shell_name /bin/sh -lc "*) ;;
        *)
          printf '%s: no-tmux login command missing\n' "$label" >&2
          exit 1
          ;;
      esac
    else
      printf '%s: unexpected extra SSH argument\n' "$label" >&2
      exit 1
    fi
    i=$((i + 1))
  done <"$TEST_TMPDIR/actual"
  if ((i != ${#expected[@]} + 1)); then
    printf '%s: missing SSH argument\n' "$label" >&2
    exit 1
  fi

  printf '%s: ok\n' "$label"
  pass=$((pass + 1))
}

for shell_name in bash zsh; do
  command -v "$shell_name" >/dev/null 2>&1 || continue
  check_login "$shell_name" "$shell_name host" host.example
  check_login "$shell_name" "$shell_name X11 forwarding" -Y host.example
  check_login "$shell_name" "$shell_name no tty" -T host.example
  check_login "$shell_name" "$shell_name mixed SSH options" \
    -J jump.example -p 2222 -o 'ProxyCommand=proxy helper' user@host.example
  check_login "$shell_name" "$shell_name quoted option value" \
    -i '/tmp/key with spaces' host.example

  rm -f "$TEST_TMPDIR/actual"
  # shellcheck disable=SC2016 # The child shell sources the tested function.
  if PATH="$TEST_TMPDIR/bin:$PATH" SSHN_SOURCE="$SSHN_SOURCE" \
    SSHN_CAPTURE="$TEST_TMPDIR/actual" \
    "$shell_name" -c '. "$SSHN_SOURCE"; sshn' "$shell_name" \
    2>"$TEST_TMPDIR/usage"; then
    printf '%s: missing host was accepted\n' "$shell_name" >&2
    exit 1
  fi
  if [[ -e $TEST_TMPDIR/actual || ! -s $TEST_TMPDIR/usage ]]; then
    printf '%s: missing host reached SSH or omitted usage\n' "$shell_name" >&2
    exit 1
  fi
  printf '%s missing host: ok\n' "$shell_name"
  pass=$((pass + 1))
done

printf '\nResults: %s passed, 0 failed\n' "$pass"
[[ -z ${DOT_TEST_REPORTER:-} ]] || "$DOT_TEST_REPORTER" complete "$pass" 0
