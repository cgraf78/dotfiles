#!/usr/bin/env bash
# Static ownership checks for dotfiles consumers after the standalone split.

set -u

source_home=${DOT_TEST_SOURCE_HOME:-$HOME}
# shellcheck source=helpers.sh
. "$source_home/.local/lib/dotfiles/tests/helpers.sh"

_client_path_contains() {
  local label=$1 path=$2 expected=$3
  _assert_contains "$label" "$expected" "$(<"$source_home/$path")"
}

_client_path_contains 'bash loads the dotfiles-owned shell loader' \
  .bashrc '.local/lib/dotfiles/shell-loader.sh'
_client_path_contains 'zsh loads the dotfiles-owned shell loader' \
  .zshrc '.local/lib/dotfiles/shell-loader.sh'
_client_path_contains 'zprofile loads the dotfiles-owned shell loader' \
  .zprofile '.local/lib/dotfiles/shell-loader.sh'
_client_path_contains 'noninteractive shell loads the dotfiles-owned shell loader' \
  .config/shell/env-noninteractive.sh '.local/lib/dotfiles/shell-loader.sh'
_client_path_contains 'WSL aliases load the dotfiles-owned Windows helper' \
  .config/shell/interactive.d/51-aliases-wsl.sh '.local/lib/dotfiles/windows.sh'
_client_path_contains 'Termnav shell policy loads the dotfiles-owned Shdeps helper' \
  .config/shell/interactive.d/53-termnav.sh '.local/lib/dotfiles/shdeps-assets.sh'
_client_path_contains 'marks consume the public standalone XDG library' \
  .config/shell/interactive.d/57-marks.sh '.local/lib/dot/xdg.sh'
_client_path_contains 'clipboard consumes the public standalone XDG library' \
  .local/bin/clip '.local/lib/dot/xdg.sh'
_client_path_contains 'Git launcher loads the dotfiles-owned launcher helper' \
  .local/bin/git '../lib/dotfiles/launcher-real.sh'

# The base no longer owns the dot entry point: the provider-published
# command (release install) is the only `dot`. Keeping this path untracked
# is load-bearing — a repo-owned door must byte-match the running dot's
# canonical launcher or every base pull fails closed, which no single
# content can satisfy across the cutover. Assert absence so the file can
# never be reintroduced silently.
if [[ -e $source_home/.local/bin/dot || -L $source_home/.local/bin/dot ]]; then
  _fail 'dotfiles base owns no .local/bin/dot entry point'
else
  _pass 'dotfiles base owns no .local/bin/dot entry point'
fi

selected_paths=(
  .bashrc
  .zshrc
  .zprofile
  .config/shell/env-noninteractive.sh
  .config/shell/interactive.d/51-aliases-wsl.sh
  .config/shell/interactive.d/53-termnav.sh
  .config/shell/interactive.d/54-tool-init.sh
  .config/shell/interactive.d/57-marks.sh
  .local/bin/clip
  .local/bin/git
)
old_references=$(
  grep -nE '\.local/lib/dot/core/(shell-loader|windows|shdeps-assets|launcher-real)\.sh|\.local/lib/dot/(git-hooks|sley-hooks)' \
    "${selected_paths[@]/#/$source_home/}" 2>/dev/null || true
)
_assert_eq 'standalone consumers contain no retired client-helper paths' '' "$old_references"

_test_summary
