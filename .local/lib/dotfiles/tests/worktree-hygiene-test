#!/usr/bin/env bash
# worktree-hygiene-test — doctor worktree disk/staleness coverage.

set -o pipefail
export NO_COLOR=1

# shellcheck source=helpers.sh
. "${BASH_SOURCE[0]%/*}/helpers.sh"
# shellcheck source=fixtures.sh
. "${BASH_SOURCE[0]%/*}/fixtures.sh"
_test_prefer_system_git || exit 1

# Resolve the standalone engine before the fixture HOME replaces the lookup.
# (dot_fixture_copy_core reads DOT_TEST_SOURCE_HOME itself.)
DOT_TEST_DOT_ROOT=$(_test_dot_root) || {
  echo 'worktree hygiene tests require the standalone Dot checkout' >&2
  exit 1
}
export DOT_TEST_DOT_ROOT

dot_fixture_home
dot_fixture_copy_core
_test_load_dot_doctor_api "$TEST_HOME" || {
  echo 'worktree hygiene tests require the doctor extension API' >&2
  exit 1
}
dot_doctor_source doctor.d/lib/worktrees.sh || {
  echo 'worktree hygiene tests require doctor.d/lib/worktrees.sh' >&2
  exit 1
}

_doctor_records() {
  local status=0
  : >"$DOT_DOCTOR_RESULT_FILE"
  "$@" || status=$?
  cat "$DOT_DOCTOR_RESULT_FILE"
  return "$status"
}

# Seed a bare origin with a main branch carrying one commit.
_seed_origin() {
  local origin=$1 seed
  seed=$(_tmpdir)
  git init --bare "$origin" >/dev/null 2>&1
  git --git-dir="$origin" symbolic-ref HEAD refs/heads/main >/dev/null 2>&1
  git init "$seed" >/dev/null 2>&1
  _git_set_test_identity git -C "$seed"
  printf '%s\n' 'seed' >"$seed/file.txt"
  git -C "$seed" add file.txt >/dev/null 2>&1
  git -C "$seed" commit -m seed >/dev/null 2>&1
  git -C "$seed" branch -M main >/dev/null 2>&1
  git -C "$seed" push "$origin" main:main >/dev/null 2>&1
}

# Clone an origin into a worktree slot and pin its remote HEAD explicitly so
# default-branch detection never depends on clone transport behavior.
_clone_worktree() {
  local origin=$1 dest=$2
  git clone "$origin" "$dest" >/dev/null 2>&1
  _git_set_test_identity git -C "$dest"
  git -C "$dest" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main >/dev/null 2>&1
}

_commit_file() {
  local dir=$1 name=$2
  printf '%s\n' "$name" >"$dir/$name"
  git -C "$dir" add "$name" >/dev/null 2>&1
  git -C "$dir" commit -m "$name" >/dev/null 2>&1
}

# Age a checkout: its root plus every Git activity signal the doctor reads
# (HEAD and index in the checkout's Git directory).
_make_old() {
  local dir=$1 gitdir='' first signal
  touch -t 202001010000 "$dir"
  if [[ -d $dir/.git ]]; then
    gitdir=$dir/.git
  elif [[ -f $dir/.git ]] && IFS= read -r first <"$dir/.git"; then
    gitdir=${first#gitdir: }
    [[ $gitdir == /* ]] || gitdir=$dir/$gitdir
  fi
  [[ -n $gitdir ]] || return 0
  for signal in "$gitdir/HEAD" "$gitdir/index"; do
    [[ -e $signal ]] && touch -t 202001010000 "$signal"
  done
  return 0
}
_make_fresh() { touch "$1"; }

echo "=== Worktree disk threshold ==="

disk_home=$(_tmpdir)
mkdir -p "$disk_home/.worktrees/big" "$disk_home/git/worktrees/small"
head -c 102400 /dev/zero >"$disk_home/.worktrees/big/blob.bin"
head -c 1024 /dev/zero >"$disk_home/git/worktrees/small/blob.bin"
# Old and non-git: counted for disk, silent for staleness.
_make_old "$disk_home/git/worktrees/small"

result=$(HOME="$disk_home" DOTFILES="$disk_home/.dotfiles" \
  DOT_WORKTREE_WARN_BYTES=2048 \
  _doctor_records _dr_check_worktrees)
status=$?
_assert_exit "disk: over-threshold check exits 0 (warn-only)" 0 "$status"
_assert_contains "disk: section renders" $'section\tWorktrees' "$result"
_assert_contains "disk: over-threshold warns" $'warn\tworktree disk' "$result"
_assert_contains "disk: over-threshold counts both shared roots" \
  "across 2 worktrees" "$result"
_assert_contains "disk: over-threshold names the knob" \
  "DOT_WORKTREE_WARN_BYTES" "$result"

result=$(HOME="$disk_home" DOTFILES="$disk_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_contains "disk: under-threshold is ok" $'ok\tworktree disk' "$result"
_assert_contains "disk: non-git dirs are safe for staleness" \
  $'ok\tno stale worktrees' "$result"

result=$(HOME="$disk_home" DOTFILES="$disk_home/.dotfiles" \
  DOT_WORKTREE_WARN_BYTES=bogus \
  _doctor_records _dr_check_worktrees)
_assert_contains "disk: invalid override falls back to the default" \
  $'ok\tworktree disk' "$result"

echo ""
echo "=== Missing worktree roots ==="

empty_home=$(_tmpdir)
result=$(HOME="$empty_home" DOTFILES="$empty_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
status=$?
_assert_exit "missing: absent roots exit 0" 0 "$status"
_assert_contains "missing: absent roots report ok" \
  $'ok\tno worktrees found' "$result"

echo ""
echo "=== Stale worktree detection ==="

stale_home=$(_tmpdir)
origin_root=$(_tmpdir)
stale_origin=$origin_root/origin.git
_seed_origin "$stale_origin"

# Old, merged into the upstream default: warns.
_clone_worktree "$stale_origin" "$stale_home/.worktrees/old-merged"
wt=$stale_home/.worktrees/old-merged
git -C "$wt" checkout -b feature >/dev/null 2>&1
_commit_file "$wt" feature.txt
git -C "$wt" push -u origin feature >/dev/null 2>&1
git -C "$wt" checkout main >/dev/null 2>&1
git -C "$wt" merge --no-ff feature -m merge >/dev/null 2>&1
git -C "$wt" push origin main >/dev/null 2>&1
git -C "$wt" checkout feature >/dev/null 2>&1
git -C "$wt" fetch --prune origin >/dev/null 2>&1
_make_old "$wt"

# Old, unmerged, upstream alive: silent.
_clone_worktree "$stale_origin" "$stale_home/.worktrees/old-unmerged"
wt=$stale_home/.worktrees/old-unmerged
git -C "$wt" checkout -b wip >/dev/null 2>&1
_commit_file "$wt" wip.txt
git -C "$wt" push -u origin wip >/dev/null 2>&1
_make_old "$wt"

# Young, merged into the upstream default: silent.
_clone_worktree "$stale_origin" "$stale_home/.worktrees/young-merged"
wt=$stale_home/.worktrees/young-merged
git -C "$wt" checkout -b feature-young >/dev/null 2>&1
_commit_file "$wt" feature-young.txt
git -C "$wt" push -u origin feature-young >/dev/null 2>&1
git -C "$wt" checkout main >/dev/null 2>&1
git -C "$wt" merge --no-ff feature-young -m merge >/dev/null 2>&1
git -C "$wt" push origin main >/dev/null 2>&1
git -C "$wt" checkout feature-young >/dev/null 2>&1
git -C "$wt" fetch --prune origin >/dev/null 2>&1
_make_fresh "$wt"

# Old, upstream branch deleted and pruned: warns.
_clone_worktree "$stale_origin" "$stale_home/.worktrees/old-gone"
wt=$stale_home/.worktrees/old-gone
git -C "$wt" checkout -b temp >/dev/null 2>&1
_commit_file "$wt" temp.txt
git -C "$wt" push -u origin temp >/dev/null 2>&1
git -C "$wt" checkout main >/dev/null 2>&1
git -C "$wt" push origin --delete temp >/dev/null 2>&1
git -C "$wt" fetch --prune origin >/dev/null 2>&1
git -C "$wt" checkout temp >/dev/null 2>&1
_make_old "$wt"

# Old, detached HEAD: safe and silent.
_clone_worktree "$stale_origin" "$stale_home/.worktrees/old-detached"
wt=$stale_home/.worktrees/old-detached
git -C "$wt" checkout "$(git -C "$wt" rev-parse HEAD)" >/dev/null 2>&1
_make_old "$wt"

# Old, no remotes at all: safe and silent.
mkdir -p "$stale_home/git/worktrees/old-no-remote"
wt=$stale_home/git/worktrees/old-no-remote
git init "$wt" >/dev/null 2>&1
_git_set_test_identity git -C "$wt"
_commit_file "$wt" local.txt
git -C "$wt" branch -M main >/dev/null 2>&1
_make_old "$wt"

# Old checkout sitting on the synced default branch in a repo-local root:
# fully merged, so warns.
mkdir -p "$stale_home/git/old-main-repo/.worktrees"
_clone_worktree "$stale_origin" "$stale_home/git/old-main-repo/.worktrees/old-main"
_make_old "$stale_home/git/old-main-repo/.worktrees/old-main"

result=$(HOME="$stale_home" DOTFILES="$stale_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
status=$?
_assert_exit "stale: detection exits 0 (warn-only)" 0 "$status"
_assert_contains "stale: enumeration covers every root" \
  "across 7 worktrees" "$result"
_assert_contains "stale: old merged and gone worktrees warn" \
  $'warn\t3 stale worktrees' "$result"
_assert_contains "stale: merged reason names the default" \
  "merged into origin/main" "$result"
_assert_contains "stale: merged worktree is listed" "old-merged" "$result"
_assert_contains "stale: gone worktree is listed" "old-gone" "$result"
_assert_contains "stale: gone reason names the upstream" \
  "upstream origin/temp is gone" "$result"
_assert_contains "stale: synced default checkout warns" "old-main" "$result"
_assert_not_contains "stale: old unmerged worktree stays silent" \
  "old-unmerged" "$result"
_assert_not_contains "stale: young merged worktree stays silent" \
  "young-merged" "$result"
_assert_not_contains "stale: detached HEAD stays silent" \
  "old-detached" "$result"
_assert_not_contains "stale: repo without remotes stays silent" \
  "old-no-remote" "$result"

echo ""
echo "=== Multi-remote default branch ==="

multi_home=$(_tmpdir)
multi_origin_root=$(_tmpdir)
multi_origin=$multi_origin_root/origin.git
_seed_origin "$multi_origin"

# A second remote whose HEAD sorts before origin's must never win: the
# checkout is merged into origin/main and must say so.
_clone_worktree "$multi_origin" "$multi_home/.worktrees/old-multiremote"
wt=$multi_home/.worktrees/old-multiremote
git -C "$wt" checkout -b feature-mr >/dev/null 2>&1
_commit_file "$wt" feature-mr.txt
git -C "$wt" push -u origin feature-mr >/dev/null 2>&1
git -C "$wt" checkout main >/dev/null 2>&1
git -C "$wt" merge --no-ff feature-mr -m merge >/dev/null 2>&1
git -C "$wt" push origin main >/dev/null 2>&1
git -C "$wt" checkout feature-mr >/dev/null 2>&1
git -C "$wt" remote add fork "$multi_origin" >/dev/null 2>&1
git -C "$wt" fetch fork >/dev/null 2>&1
git -C "$wt" symbolic-ref refs/remotes/fork/HEAD refs/remotes/fork/main >/dev/null 2>&1
_make_old "$wt"

# A lone non-origin remote still resolves through its HEAD.
git clone -o upstream "$multi_origin" "$multi_home/.worktrees/old-upstream-only" >/dev/null 2>&1
wt=$multi_home/.worktrees/old-upstream-only
_git_set_test_identity git -C "$wt"
git -C "$wt" symbolic-ref refs/remotes/upstream/HEAD refs/remotes/upstream/main >/dev/null 2>&1
git -C "$wt" checkout -b feature-up >/dev/null 2>&1
_commit_file "$wt" feature-up.txt
git -C "$wt" push -u upstream feature-up >/dev/null 2>&1
git -C "$wt" checkout main >/dev/null 2>&1
git -C "$wt" merge --no-ff feature-up -m merge >/dev/null 2>&1
git -C "$wt" push upstream main >/dev/null 2>&1
git -C "$wt" checkout feature-up >/dev/null 2>&1
git -C "$wt" fetch --prune upstream >/dev/null 2>&1
_make_old "$wt"

# With origin's HEAD symref missing, conventional origin names win over
# any fork HEAD.
_clone_worktree "$multi_origin" "$multi_home/.worktrees/old-no-head-symref"
wt=$multi_home/.worktrees/old-no-head-symref
git -C "$wt" checkout -b feature-nh >/dev/null 2>&1
_commit_file "$wt" feature-nh.txt
git -C "$wt" push -u origin feature-nh >/dev/null 2>&1
git -C "$wt" checkout main >/dev/null 2>&1
git -C "$wt" merge --no-ff feature-nh -m merge >/dev/null 2>&1
git -C "$wt" push origin main >/dev/null 2>&1
git -C "$wt" checkout feature-nh >/dev/null 2>&1
git -C "$wt" remote add fork "$multi_origin" >/dev/null 2>&1
git -C "$wt" fetch fork >/dev/null 2>&1
git -C "$wt" symbolic-ref refs/remotes/fork/HEAD refs/remotes/fork/main >/dev/null 2>&1
git -C "$wt" symbolic-ref -d refs/remotes/origin/HEAD >/dev/null 2>&1
_make_old "$wt"

# Fixture-validity lock: fork/HEAD must sort before origin/HEAD, or the
# fork assertions below would pass on unfixed code (false negative).
first_head=$(git -C "$multi_home/.worktrees/old-multiremote" for-each-ref --format='%(refname)' 'refs/remotes/*/HEAD' | head -1)
_assert_eq "multiremote: fixture fork HEAD sorts first" "refs/remotes/fork/HEAD" "$first_head"

result=$(HOME="$multi_home" DOTFILES="$multi_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
status=$?
_assert_exit "multiremote: detection exits 0 (warn-only)" 0 "$status"
_assert_contains "multiremote: all three checkouts warn" \
  $'warn\t3 stale worktrees' "$result"
_assert_contains "multiremote: fork HEAD never becomes the base" \
  "merged into origin/main" "$result"
_assert_not_contains "multiremote: fork reason never prints" "fork/" "$result"
_assert_contains "multiremote: lone non-origin remote resolves" \
  "merged into upstream/main" "$result"
_assert_contains "multiremote: multiremote checkout is listed" \
  "old-multiremote" "$result"
_assert_contains "multiremote: upstream-only checkout is listed" \
  "old-upstream-only" "$result"
_assert_contains "multiremote: missing origin HEAD falls back to origin" \
  "old-no-head-symref" "$result"

echo ""
echo "=== Vanished checkout keeps partial age results ==="

dvanish_home=$(_tmpdir)
dvanish_origin_root=$(_tmpdir)
dvanish_origin=$dvanish_origin_root/origin.git
_seed_origin "$dvanish_origin"

# Old, merged into the upstream default: warns.
_clone_worktree "$dvanish_origin" "$dvanish_home/.worktrees/old-merged"
wt=$dvanish_home/.worktrees/old-merged
git -C "$wt" checkout -b feature-dv >/dev/null 2>&1
_commit_file "$wt" feature-dv.txt
git -C "$wt" push -u origin feature-dv >/dev/null 2>&1
git -C "$wt" checkout main >/dev/null 2>&1
git -C "$wt" merge --no-ff feature-dv -m merge >/dev/null 2>&1
git -C "$wt" push origin main >/dev/null 2>&1
git -C "$wt" checkout feature-dv >/dev/null 2>&1
git -C "$wt" fetch --prune origin >/dev/null 2>&1
_make_old "$wt"

# Old, merged, deleted mid-sweep by the find wrapper below.
_clone_worktree "$dvanish_origin" "$dvanish_home/.worktrees/old-victim"
victim=$dvanish_home/.worktrees/old-victim
git -C "$victim" checkout -b feature-dvv >/dev/null 2>&1
_commit_file "$victim" feature-dvv.txt
git -C "$victim" push -u origin feature-dvv >/dev/null 2>&1
git -C "$victim" checkout main >/dev/null 2>&1
git -C "$victim" merge --no-ff feature-dvv -m merge >/dev/null 2>&1
git -C "$victim" push origin main >/dev/null 2>&1
git -C "$victim" checkout feature-dvv >/dev/null 2>&1
git -C "$victim" fetch --prune origin >/dev/null 2>&1
_make_old "$victim"
# A find wrapper that deletes one candidate mid-sweep, deterministically
# reproducing the enumeration-to-find race; the surviving matches must
# still warn instead of collapsing to no-stale-warnings.
dvanish_bin=$(_tmpdir)/dvanish-bin
mkdir -p "$dvanish_bin"
real_find=$(command -v find)
cat >"$dvanish_bin/find" <<STUB
#!/usr/bin/env bash
rm -rf "\$GC_FIND_VICTIM"
exec "$real_find" "\$@"
STUB
chmod +x "$dvanish_bin/find"

result=$(GC_FIND_VICTIM="$victim" PATH="$dvanish_bin:$PATH" \
  HOME="$dvanish_home" DOTFILES="$dvanish_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
status=$?
_assert_exit "dvanish: detection exits 0 (warn-only)" 0 "$status"
_assert_contains "dvanish: surviving checkout still warns" \
  $'warn\t1 stale worktree' "$result"
_assert_contains "dvanish: surviving checkout is listed" "old-merged" "$result"
_assert_not_contains "dvanish: vanished checkout stays silent" \
  "old-victim" "$result"

echo ""
echo "=== Base repository worktrees ==="

base_home=$(_tmpdir)
git init --bare "$base_home/.dotfiles" >/dev/null 2>&1
git --git-dir="$base_home/.dotfiles" config core.bare false
git --git-dir="$base_home/.dotfiles" config core.worktree "$base_home"
base_git=(git --git-dir="$base_home/.dotfiles" --work-tree="$base_home")
_git_set_test_identity "${base_git[@]}"
printf '%s\n' 'base' >"$base_home/.seed"
"${base_git[@]}" add .seed >/dev/null 2>&1
"${base_git[@]}" commit -m seed >/dev/null 2>&1
"${base_git[@]}" branch -M main >/dev/null 2>&1
# One linked worktree inside the shared root (exercises dedupe) and one
# outside every scanned root (exercises base worktree discovery).
"${base_git[@]}" worktree add "$base_home/.worktrees/base-wt" -b base-wt >/dev/null 2>&1
"${base_git[@]}" worktree add "$base_home/elsewhere/base-wt2" -b base-wt2 >/dev/null 2>&1

result=$(HOME="$base_home" DOTFILES="$base_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
status=$?
_assert_exit "base: linked worktrees exit 0" 0 "$status"
_assert_contains "base: shared-root worktree counts once (dedupe)" \
  "across 2 worktrees" "$result"
_assert_contains "base: fresh linked worktrees are not stale" \
  $'ok\tno stale worktrees' "$result"

echo ""
echo "=== Overlay clone worktrees ==="

overlay_home=$(_tmpdir)
mkdir -p "$overlay_home/.dotfiles-dev/.worktrees/wt1"
# Old and non-git: counted for disk, silent for staleness.
_make_old "$overlay_home/.dotfiles-dev/.worktrees/wt1"

result=$(HOME="$overlay_home" DOTFILES="$overlay_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
status=$?
_assert_exit "overlay: enumeration exits 0" 0 "$status"
_assert_contains "overlay: repo-local worktree counts" \
  "across 1 worktrees" "$result"
_assert_contains "overlay: non-git checkout stays silent" \
  $'ok\tno stale worktrees' "$result"

echo ""
echo "=== Disk total cache ==="

# The du total recomputes only when a checkout root changes: a second
# run over an untouched tree must skip du entirely and report
# byte-identical records, while a root mtime change recomputes. The du
# shim delegates to the real du while counting invocations.
cache_home=$(_tmpdir)
mkdir -p "$cache_home/.worktrees/cached-big"
head -c 102400 /dev/zero >"$cache_home/.worktrees/cached-big/blob.bin"
_make_old "$cache_home/.worktrees/cached-big"
cache_real_du=$(command -v du)
cache_du_log=$(_tmpfile)
cache_shim_bin=$(_tmpdir)
cat >"$cache_shim_bin/du" <<SH
#!/usr/bin/env bash
printf 'du-called\n' >>"$cache_du_log"
exec "$cache_real_du" "\$@"
SH
chmod +x "$cache_shim_bin/du"
cache_saved_home=$HOME
cache_saved_path=$PATH
if [[ -z ${DOTFILES+x} ]]; then
  cache_dotfiles_unset=1
else
  cache_dotfiles_unset=0
  cache_saved_dotfiles=$DOTFILES
fi
if [[ -z ${XDG_CACHE_HOME+x} ]]; then
  cache_xdg_unset=1
else
  cache_xdg_unset=0
  cache_saved_xdg=$XDG_CACHE_HOME
fi
_run_cached_check() {
  HOME=$cache_home
  DOTFILES=$cache_home/.dotfiles
  XDG_CACHE_HOME=$cache_home/cache
  PATH=$cache_shim_bin:$PATH
  export HOME DOTFILES XDG_CACHE_HOME PATH
  _doctor_records _dr_check_worktrees >"$1" 2>/dev/null
}
_run_cached_check "$cache_home/run1.txt"
cache_status=$?
_run_cached_check "$cache_home/run2.txt"
touch "$cache_home/.worktrees/cached-big"
_run_cached_check "$cache_home/run3.txt"
printf 'garbage-not-a-total\n' >"$cache_home/cache/dot/doctor-worktrees-du.tsv"
_run_cached_check "$cache_home/run4.txt"
HOME=$cache_saved_home
PATH=$cache_saved_path
if ((cache_dotfiles_unset == 1)); then
  unset DOTFILES
else
  DOTFILES=$cache_saved_dotfiles
fi
if ((cache_xdg_unset == 1)); then
  unset XDG_CACHE_HOME
else
  XDG_CACHE_HOME=$cache_saved_xdg
fi
export HOME DOTFILES PATH XDG_CACHE_HOME
cache_run1=$(cat "$cache_home/run1.txt")
cache_run2=$(cat "$cache_home/run2.txt")
cache_run3=$(cat "$cache_home/run3.txt")
cache_run4=$(cat "$cache_home/run4.txt")
_assert_exit "cache: first run exits 0" 0 "$cache_status"
_assert_eq "cache: warm run reports identical records" "$cache_run1" "$cache_run2"
_assert_eq "cache: root touch recomputes the same total" "$cache_run1" "$cache_run3"
_assert_eq "cache: corrupt cache recomputes the same total" "$cache_run1" "$cache_run4"
cache_du_calls=$(grep -c . "$cache_du_log")
_assert_eq "cache: du runs on miss, touch, and corruption only" 3 "$cache_du_calls"

# The six-hour max age bounds root-set staleness: an ancient stamp
# recomputes even when the key matches. And a failing stat degrades to
# the keyed lookup instead of failing the check.
cache_du_before_age=$(grep -c . "$cache_du_log")
HOME=$cache_home
DOTFILES=$cache_home/.dotfiles
XDG_CACHE_HOME=$cache_home/cache
PATH=$cache_shim_bin:$cache_saved_path
export HOME DOTFILES XDG_CACHE_HOME PATH
cache_file=$cache_home/cache/dot/doctor-worktrees-du.tsv
{
  printf 'v2 1577836800\n'
  tail -n +2 "$cache_file"
} >"$cache_file.new" && mv "$cache_file.new" "$cache_file"
_run_cached_check "$cache_home/run5.txt"
cache_du_after_age=$(grep -c . "$cache_du_log")
cache_statfail_bin=$(_tmpdir)
cache_real_stat=$(command -v stat)
cat >"$cache_statfail_bin/stat" <<SH
#!/usr/bin/env bash
# Fail only the cache-file mtime lookup; key-line stats still succeed so
# this isolates the max-age fallback (unknown age serves the keyed total).
case "\$*" in
  *doctor-worktrees-du.tsv*) exit 1 ;;
esac
exec "$cache_real_stat" "\$@"
SH
chmod +x "$cache_statfail_bin/stat"
PATH=$cache_statfail_bin:$cache_shim_bin:$cache_saved_path
export PATH
_run_cached_check "$cache_home/run6.txt"
cache_du_after_statfail=$(grep -c . "$cache_du_log")
HOME=$cache_saved_home
PATH=$cache_saved_path
if ((cache_dotfiles_unset == 1)); then
  unset DOTFILES
else
  DOTFILES=$cache_saved_dotfiles
fi
if ((cache_xdg_unset == 1)); then
  unset XDG_CACHE_HOME
else
  XDG_CACHE_HOME=$cache_saved_xdg
fi
export HOME DOTFILES PATH XDG_CACHE_HOME
_assert_eq "cache: ancient stamp recomputes the same total" "$cache_run1" \
  "$(cat "$cache_home/run5.txt")"
_assert_eq "cache: ancient stamp costs one du pass" \
  $((cache_du_before_age + 1)) "$cache_du_after_age"
_assert_eq "cache: failing stat serves the same total" "$cache_run1" \
  "$(cat "$cache_home/run6.txt")"
_assert_eq "cache: failing stat costs no du pass" \
  "$cache_du_after_age" "$cache_du_after_statfail"

# Only roots whose mtime moved are measured again; the rest reuse their
# cached size, and the total still matches a cold pass.
part_home=$(_tmpdir)
mkdir -p "$part_home/.worktrees/part-a" "$part_home/.worktrees/part-b"
head -c 102400 /dev/zero >"$part_home/.worktrees/part-a/blob.bin"
head -c 51200 /dev/zero >"$part_home/.worktrees/part-b/blob.bin"
_make_old "$part_home/.worktrees/part-a"
_make_old "$part_home/.worktrees/part-b"
part_log=$(_tmpfile)
part_bin=$(_tmpdir)
cat >"$part_bin/du" <<SH
#!/usr/bin/env bash
printf '%s\n' "\$*" >>"$part_log"
exec "$cache_real_du" "\$@"
SH
chmod +x "$part_bin/du"
part_run() {
  HOME="$part_home" DOTFILES="$part_home/.dotfiles" \
    XDG_CACHE_HOME="$part_home/cache" PATH="$part_bin:$PATH" \
    _doctor_records _dr_check_worktrees
}
part_cold=$(part_run)
touch "$part_home/.worktrees/part-b"
: >"$part_log"
part_warm=$(part_run)
_assert_eq "cache: a partial refresh reports the cold total" "$part_cold" "$part_warm"
_assert_contains "cache: the touched root is measured again" "part-b" "$(cat "$part_log")"
_assert_not_contains "cache: an untouched root reuses its size" "part-a" "$(cat "$part_log")"

echo ""
echo "=== Stale base-ref sharing ==="

# Four old same-repo checkouts on merged branches: the base ref must
# resolve once for the whole repo. Counts are structural: an unshared
# check issues four origin-HEAD probes.
share_home=$(_tmpdir)
share_origin_root=$(_tmpdir)
share_origin=$share_origin_root/origin.git
_seed_origin "$share_origin"
git clone "$share_origin" "$share_home/git/alpha" >/dev/null 2>&1
share_main=$share_home/git/alpha
_git_set_test_identity git -C "$share_main"
git -C "$share_main" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main >/dev/null 2>&1
for share_i in 1 2 3 4; do
  git -C "$share_main" worktree add "$share_home/.worktrees/share-old-$share_i" -b "share-feat-$share_i" >/dev/null 2>&1
  share_wt=$share_home/.worktrees/share-old-$share_i
  _git_set_test_identity git -C "$share_wt"
  _commit_file "$share_wt" "share-feat-$share_i.txt"
  git -C "$share_wt" push -u origin "share-feat-$share_i" >/dev/null 2>&1
  git -C "$share_main" fetch origin >/dev/null 2>&1
  git -C "$share_main" merge --no-ff "origin/share-feat-$share_i" -m merge >/dev/null 2>&1
  git -C "$share_main" push origin main >/dev/null 2>&1
  git -C "$share_wt" fetch --prune origin >/dev/null 2>&1
  _make_old "$share_wt"
done
share_real_git=$(command -v git)
share_git_log=$(_tmpfile)
share_shim_bin=$(_tmpdir)
cat >"$share_shim_bin/git" <<SH
#!/usr/bin/env bash
printf '%s\n' "\$*" >>"$share_git_log"
exec "$share_real_git" "\$@"
SH
chmod +x "$share_shim_bin/git"
share_saved_home=$HOME
share_saved_path=$PATH
if [[ -z ${DOTFILES+x} ]]; then
  share_dotfiles_unset=1
else
  share_dotfiles_unset=0
  share_saved_dotfiles=$DOTFILES
fi
HOME=$share_home
DOTFILES=$share_home/.dotfiles
PATH=$share_shim_bin:$PATH
export HOME DOTFILES PATH
_doctor_records _dr_check_worktrees >"$share_home/run.txt" 2>/dev/null
share_status=$?
HOME=$share_saved_home
PATH=$share_saved_path
if ((share_dotfiles_unset == 1)); then
  unset DOTFILES
else
  DOTFILES=$share_saved_dotfiles
fi
export HOME DOTFILES PATH
share_result=$(cat "$share_home/run.txt")
_assert_exit "sharing: detection exits 0" 0 "$share_status"
_assert_contains "sharing: all four same-repo checkouts warn" \
  $'warn\t4 stale worktrees' "$share_result"
share_symrefs=$(grep -c 'symbolic-ref' "$share_git_log")
if ((share_symrefs <= 2)); then
  _pass "sharing: one base resolution serves the repo ($share_symrefs)"
else
  _fail "sharing: one base resolution serves the repo (got $share_symrefs)"
fi

echo ""
echo "=== Stale facts batched per repo ==="

# Several old checkouts of one repo: the stale facts must come from one
# worktree listing for the whole repo instead of per-checkout branch probes,
# with reasons identical to the per-checkout probe for every shape (main
# checkout, merged, gone, gone-and-merged, unmerged, detached, prefix-named
# branches, a checkout moved without repair, and an orphaned admin dir).
batch_home=$(_tmpdir)
batch_origin_root=$(_tmpdir)
batch_origin=$batch_origin_root/origin.git
_seed_origin "$batch_origin"
mkdir -p "$batch_home/.worktrees"
git clone "$batch_origin" "$batch_home/.worktrees/mb-main" >/dev/null 2>&1
batch_main=$batch_home/.worktrees/mb-main
_git_set_test_identity git -C "$batch_main"
git -C "$batch_main" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main >/dev/null 2>&1
_batch_worktree() {
  git -C "$batch_main" worktree add "$batch_home/.worktrees/$1" -b "$1" >/dev/null 2>&1
  _git_set_test_identity git -C "$batch_home/.worktrees/$1"
  _commit_file "$batch_home/.worktrees/$1" "$1.txt"
  git -C "$batch_home/.worktrees/$1" push -u origin "$1" >/dev/null 2>&1
}
_batch_merge() {
  git -C "$batch_main" fetch origin >/dev/null 2>&1
  git -C "$batch_main" merge --no-ff "origin/$1" -m "merge $1" >/dev/null 2>&1
  git -C "$batch_main" push origin main >/dev/null 2>&1
}
_batch_worktree mb-merged
_batch_merge mb-merged
_batch_worktree mb-gone
git -C "$batch_main" push origin --delete mb-gone >/dev/null 2>&1
_batch_worktree mb-gone-merged
_batch_merge mb-gone-merged
git -C "$batch_main" push origin --delete mb-gone-merged >/dev/null 2>&1
_batch_worktree mb-x
_batch_merge mb-x
_batch_worktree mb-x-y
_batch_worktree mb-unmerged
_batch_worktree mb-detached
git -C "$batch_home/.worktrees/mb-detached" checkout --detach >/dev/null 2>&1
_batch_worktree mb-moved
_batch_merge mb-moved
_batch_worktree mb-orphan
git -C "$batch_main" fetch --prune origin >/dev/null 2>&1
# Moved without `git worktree repair`: the checkout still works but the
# listing names its old path, so it must fall back to the per-checkout probe.
mv "$batch_home/.worktrees/mb-moved" "$batch_home/.worktrees/mb-moved-away"
rm -rf "$batch_main/.git/worktrees/mb-orphan"
batch_names="mb-main mb-merged mb-gone mb-gone-merged mb-x mb-x-y mb-unmerged mb-detached mb-moved-away mb-orphan"
for batch_name in $batch_names; do
  _make_old "$batch_home/.worktrees/$batch_name"
done
batch_real_git=$(command -v git)
batch_git_log=$(_tmpfile)
batch_shim_bin=$(_tmpdir)
cat >"$batch_shim_bin/git" <<SH
#!/usr/bin/env bash
printf '%s\n' "\$*" >>"$batch_git_log"
exec "$batch_real_git" "\$@"
SH
chmod +x "$batch_shim_bin/git"
batch_saved_home=$HOME
batch_saved_path=$PATH
if [[ -z ${DOTFILES+x} ]]; then
  batch_dotfiles_unset=1
else
  batch_dotfiles_unset=0
  batch_saved_dotfiles=$DOTFILES
fi
HOME=$batch_home
DOTFILES=$batch_home/.dotfiles
PATH=$batch_shim_bin:$PATH
export HOME DOTFILES PATH
# List every stale sample so each shape's reason is visible in the report.
batch_saved_limit=$_DR_WORKTREE_STALE_LIST_LIMIT
_DR_WORKTREE_STALE_LIST_LIMIT=20
_doctor_records _dr_check_worktrees >"$batch_home/run.txt" 2>/dev/null
batch_status=$?
_DR_WORKTREE_STALE_LIST_LIMIT=$batch_saved_limit
batch_listings=$(grep -c 'worktree list' "$batch_git_log")
batch_branch_probes=$(grep -c 'branch --show-current' "$batch_git_log")
# Cross-check every shape against the per-checkout probe it replaces.
batch_mismatch=
_DR_WORKTREE_BASE_KEYS=()
_DR_WORKTREE_BASE_REFS=()
_DR_WORKTREE_FACT_KEYS=()
_DR_WORKTREE_FACT_ROWS=()
for batch_name in $batch_names; do
  batch_dir=$(cd "$batch_home/.worktrees/$batch_name" && pwd -P)
  _dr_worktree_stale_reason "$batch_dir"
  batch_expected=$REPLY
  _dr_worktree_stale_reason_batched "$batch_dir"
  [[ $REPLY == "$batch_expected" ]] ||
    batch_mismatch+="$batch_name: '$REPLY' != '$batch_expected'; "
done
HOME=$batch_saved_home
PATH=$batch_saved_path
if ((batch_dotfiles_unset == 1)); then
  unset DOTFILES
else
  DOTFILES=$batch_saved_dotfiles
fi
export HOME DOTFILES PATH
batch_result=$(cat "$batch_home/run.txt")
_assert_exit "batched: detection exits 0" 0 "$batch_status"
_assert_contains "batched: merged, gone, and synced checkouts warn" \
  $'warn\t6 stale worktrees' "$batch_result"
_assert_contains "batched: merged reason names the default" \
  "mb-merged (merged into origin/main)" "$batch_result"
_assert_contains "batched: gone reason names the upstream" \
  "mb-gone (upstream origin/mb-gone is gone)" "$batch_result"
_assert_contains "batched: a gone upstream wins over merged" \
  "mb-gone-merged (upstream origin/mb-gone-merged is gone)" "$batch_result"
_assert_contains "batched: the main checkout reads its own row" \
  "mb-main (merged into origin/main" "$batch_result"
_assert_contains "batched: a prefix-named merged branch warns" \
  "mb-x (merged into origin/main)" "$batch_result"
_assert_not_contains "batched: its unmerged longer sibling stays silent" \
  "mb-x-y" "$batch_result"
_assert_contains "batched: an unlisted moved checkout falls back" \
  "mb-moved-away (merged into origin/main)" "$batch_result"
_assert_not_contains "batched: unmerged checkout stays silent" \
  "mb-unmerged" "$batch_result"
_assert_not_contains "batched: detached checkout stays silent" \
  "mb-detached" "$batch_result"
_assert_not_contains "batched: orphaned checkout stays silent" \
  "mb-orphan" "$batch_result"
_assert_eq "batched: admin files replace the worktree listing" "0" "$batch_listings"
# Only the orphan (no repo key) and the moved checkout (no listed row) fall
# back to a per-checkout branch probe.
_assert_eq "batched: listed checkouts need no branch probe" "2" \
  "$batch_branch_probes"
_assert_eq "batched: reasons match the per-checkout probe" "" "$batch_mismatch"

# A failing `--merged` query must fall back to the per-checkout probe rather
# than read as "not merged".
batch_fail_bin=$(_tmpdir)
cat >"$batch_fail_bin/git" <<SH
#!/usr/bin/env bash
case " \$* " in *" --merged="*) exit 1 ;; esac
exec "$batch_real_git" "\$@"
SH
chmod +x "$batch_fail_bin/git"
HOME=$batch_home
DOTFILES=$batch_home/.dotfiles
PATH=$batch_fail_bin:$batch_saved_path
export HOME DOTFILES PATH
_DR_WORKTREE_STALE_LIST_LIMIT=20
_doctor_records _dr_check_worktrees >"$batch_home/run-fail.txt" 2>/dev/null
_DR_WORKTREE_STALE_LIST_LIMIT=$batch_saved_limit
HOME=$batch_saved_home
PATH=$batch_saved_path
if ((batch_dotfiles_unset == 1)); then
  unset DOTFILES
else
  DOTFILES=$batch_saved_dotfiles
fi
export HOME DOTFILES PATH
_assert_contains "batched: a failed merged query falls back" \
  "mb-merged (merged into origin/main)" "$(cat "$batch_home/run-fail.txt")"

echo ""
echo "=== Stale probe scope ==="

# Queries cover only the old checkouts being probed: a never-pulled main clone
# and young worktrees add no history walks, and with only detached and gone
# old checkouts no base ref is resolved at all.
scope_home=$(_tmpdir)
scope_origin_root=$(_tmpdir)
scope_origin=$scope_origin_root/origin.git
_seed_origin "$scope_origin"
git clone "$scope_origin" "$scope_home/git/scope" >/dev/null 2>&1
scope_main=$scope_home/git/scope
_git_set_test_identity git -C "$scope_main"
git -C "$scope_main" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main >/dev/null 2>&1
for scope_name in sc-gone sc-detached sc-young; do
  git -C "$scope_main" worktree add "$scope_home/.worktrees/$scope_name" -b "$scope_name" >/dev/null 2>&1
  _git_set_test_identity git -C "$scope_home/.worktrees/$scope_name"
  _commit_file "$scope_home/.worktrees/$scope_name" "$scope_name.txt"
  git -C "$scope_home/.worktrees/$scope_name" push -u origin "$scope_name" >/dev/null 2>&1
done
git -C "$scope_main" push origin --delete sc-gone >/dev/null 2>&1
git -C "$scope_main" fetch --prune origin >/dev/null 2>&1
git -C "$scope_home/.worktrees/sc-detached" checkout --detach >/dev/null 2>&1
_make_old "$scope_home/.worktrees/sc-gone"
_make_old "$scope_home/.worktrees/sc-detached"
_make_fresh "$scope_home/.worktrees/sc-young"
scope_git_log=$(_tmpfile)
scope_shim_bin=$(_tmpdir)
cat >"$scope_shim_bin/git" <<SH
#!/usr/bin/env bash
printf '%s\n' "\$*" >>"$scope_git_log"
exec "$batch_real_git" "\$@"
SH
chmod +x "$scope_shim_bin/git"
HOME=$scope_home
DOTFILES=$scope_home/.dotfiles
PATH=$scope_shim_bin:$batch_saved_path
export HOME DOTFILES PATH
_doctor_records _dr_check_worktrees >"$scope_home/run.txt" 2>/dev/null
HOME=$batch_saved_home
PATH=$batch_saved_path
if ((batch_dotfiles_unset == 1)); then
  unset DOTFILES
else
  DOTFILES=$batch_saved_dotfiles
fi
export HOME DOTFILES PATH
scope_tracking=$(grep 'upstream:track' "$scope_git_log")
_assert_contains "scope: the gone checkout warns" \
  "sc-gone (upstream origin/sc-gone is gone)" "$(cat "$scope_home/run.txt")"
_assert_contains "scope: tracking covers the old branch" \
  "refs/heads/sc-gone" "$scope_tracking"
_assert_not_contains "scope: tracking skips the main clone's branch" \
  "refs/heads/main" "$scope_tracking"
_assert_not_contains "scope: tracking skips young checkouts" \
  "refs/heads/sc-young" "$scope_tracking"
_assert_eq "scope: no base ref resolves without a mergeable branch" "0" \
  "$(grep -c 'symbolic-ref' "$scope_git_log")"

echo ""
echo "=== Activity signals, not folder mtime ==="

# A merged checkout whose root is old but whose Git activity is recent is
# in use: commit, checkout, and reset move HEAD or the index. Folder mtime
# alone called both stale. A clone's gc, which rewrites every worktree's
# reflog, is not activity.
act_home=$(_tmpdir)
act_origin_root=$(_tmpdir)
act_origin=$act_origin_root/origin.git
_seed_origin "$act_origin"
for act_name in act-head act-index act-idle; do
  _clone_worktree "$act_origin" "$act_home/.worktrees/$act_name"
  _make_old "$act_home/.worktrees/$act_name"
done
touch "$act_home/.worktrees/act-head/.git/HEAD"
touch "$act_home/.worktrees/act-index/.git/index"
git clone "$act_origin" "$act_home/git/act-main" >/dev/null 2>&1
git -C "$act_home/git/act-main" symbolic-ref refs/remotes/origin/HEAD \
  refs/remotes/origin/main >/dev/null 2>&1
git -C "$act_home/git/act-main" worktree add --detach \
  "$act_home/.worktrees/act-linked" origin/main >/dev/null 2>&1
git -C "$act_home/.worktrees/act-linked" checkout -b act-linked >/dev/null 2>&1
git -C "$act_home/.worktrees/act-linked" branch --set-upstream-to=origin/main >/dev/null 2>&1
_make_old "$act_home/.worktrees/act-linked"
git -C "$act_home/git/act-main" reflog expire --all --expire=now >/dev/null 2>&1
result=$(HOME="$act_home" DOTFILES="$act_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_contains "activity: the idle clone and the gc'd worktree are stale" \
  $'warn\t2 stale worktrees' "$result"
_assert_contains "activity: idle checkout is listed" "act-idle" "$result"
_assert_contains "activity: a clone gc does not refresh its worktrees" \
  "act-linked (merged into origin/main)" "$result"
_assert_not_contains "activity: a fresh HEAD keeps a checkout active" \
  "act-head" "$result"
_assert_not_contains "activity: a fresh index keeps a checkout active" \
  "act-index" "$result"
_assert_contains "activity: a standalone clone is labelled" \
  "act-idle (merged into origin/main, standalone clone)" "$result"
_assert_contains "activity: mixed rows send worktrees to the gc and clones by hand" \
  "review linked worktrees with 'dot-worktree-gc' (dry run by default); delete standalone clones by hand" \
  "$result"

echo ""
echo "=== Dirty inactive worktrees ==="

dirty_home=$(_tmpdir)
dirty_origin_root=$(_tmpdir)
dirty_origin=$dirty_origin_root/origin.git
_seed_origin "$dirty_origin"
_clone_worktree "$dirty_origin" "$dirty_home/.worktrees/dirty-modified"
printf '%s\n' 'local edit' >>"$dirty_home/.worktrees/dirty-modified/file.txt"
_clone_worktree "$dirty_origin" "$dirty_home/.worktrees/dirty-untracked"
printf '%s\n' 'scratch' >"$dirty_home/.worktrees/dirty-untracked/notes.txt"
_clone_worktree "$dirty_origin" "$dirty_home/.worktrees/clean-merged"
for dirty_name in dirty-modified dirty-untracked clean-merged; do
  _make_old "$dirty_home/.worktrees/$dirty_name"
done
dirty_index=$dirty_home/.worktrees/dirty-modified/.git/index
result=$(HOME="$dirty_home" DOTFILES="$dirty_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_contains "dirty: only the clean checkout is stale" \
  $'warn\t1 stale worktree' "$result"
_assert_contains "dirty: dirty checkouts get their own row" \
  $'warn\t2 inactive worktrees have uncommitted changes' "$result"
_assert_contains "dirty: modified files are counted" \
  "dirty-modified (1 uncommitted; merged into origin/main)" "$result"
_assert_contains "dirty: untracked files are counted" \
  "dirty-untracked (1 uncommitted; merged into origin/main)" "$result"
_assert_not_contains "dirty: a dirty checkout is never called stale" \
  "dirty-modified (merged" "$result"
_assert_contains "dirty: the row says the gc skips it" \
  "dot-worktree-gc skips dirty checkouts" "$result"
_assert_contains "dirty: clone-only stale rows say clones go by hand" \
  "dot-worktree-gc never removes standalone clones" "$result"
# _make_old dated the index 2020; a refreshing status would have moved it.
_assert_eq "dirty: the probe leaves the index untouched" \
  "$dirty_index" "$(find "$dirty_index" -mtime +1000 2>/dev/null)"

echo ""
echo "=== Registered worktrees anywhere ==="

# Checkouts a clone registered outside every scanned folder are found from
# the clone's admin area; prunable and locked admin entries are reported.
reg_home=$(_tmpdir)
reg_origin_root=$(_tmpdir)
reg_origin=$reg_origin_root/origin.git
_seed_origin "$reg_origin"
git clone "$reg_origin" "$reg_home/git/alpha" >/dev/null 2>&1
reg_main=$reg_home/git/alpha
git -C "$reg_main" worktree add "$reg_home/shared/live" -b live >/dev/null 2>&1
git -C "$reg_main" worktree add "$reg_home/shared/gone" -b gone >/dev/null 2>&1
git -C "$reg_main" worktree add "$reg_home/shared/locked-live" -b locked-live >/dev/null 2>&1
git -C "$reg_main" worktree add "$reg_home/shared/locked-gone" -b locked-gone >/dev/null 2>&1
git -C "$reg_main" worktree lock "$reg_home/shared/locked-live" >/dev/null 2>&1
git -C "$reg_main" worktree lock "$reg_home/shared/locked-gone" >/dev/null 2>&1
rm -rf "$reg_home/shared/gone" "$reg_home/shared/locked-gone"
# An admin entry without a gitdir pointer is prunable too.
mkdir -p "$reg_main/.git/worktrees/no-pointer"
reg_git_log=$(_tmpfile)
reg_shim_bin=$(_tmpdir)
cat >"$reg_shim_bin/git" <<SH
#!/usr/bin/env bash
printf '%s\n' "\$*" >>"$reg_git_log"
exec "$batch_real_git" "\$@"
SH
chmod +x "$reg_shim_bin/git"
result=$(HOME="$reg_home" DOTFILES="$reg_home/.dotfiles" \
  PATH="$reg_shim_bin:$PATH" _doctor_records _dr_check_worktrees)
status=$?
_assert_exit "registered: check exits 0 (warn-only)" 0 "$status"
_assert_contains "registered: live checkouts outside scanned roots count" \
  "across 2 worktrees" "$result"
_assert_contains "registered: prunable entries warn" \
  $'warn\t2 prunable worktree entries' "$result"
# shellcheck disable=SC2088 # Rows carry tilde display paths.
_assert_contains "registered: a missing checkout is prunable" \
  "~/git/alpha: gone" "$result"
# shellcheck disable=SC2088 # Rows carry tilde display paths.
_assert_contains "registered: a pointerless entry is prunable" \
  "~/git/alpha: no-pointer" "$result"
_assert_contains "registered: the prune command is named" \
  "worktree prune" "$result"
_assert_contains "registered: locked entries are reported" \
  "2 locked worktrees" "$result"
# shellcheck disable=SC2088 # Rows carry tilde display paths.
_assert_contains "registered: a locked live checkout is listed" \
  "~/shared/locked-live" "$result"
# shellcheck disable=SC2088 # Rows carry tilde display paths.
_assert_contains "registered: a locked entry is never prunable" \
  "~/git/alpha: locked-gone (checkout missing)" "$result"
_assert_not_contains "registered: the admin scan spawns no worktree listing" \
  "worktree list" "$(cat "$reg_git_log")"
# Out-of-band output is a doctor protocol error: unreadable admin files
# (the pointerless entry) must stay silent.
_assert_eq "registered: odd admin entries print nothing to stderr" "" \
  "$(HOME="$reg_home" DOTFILES="$reg_home/.dotfiles" \
    _doctor_records _dr_check_worktrees 2>&1 >/dev/null)"

# Locked checkouts are reported once, in the locked row, even when stale;
# a stale linked worktree alone points at the gc.
reg_merged_wt=$reg_home/shared/locked-live
_make_old "$reg_merged_wt"
_make_old "$reg_home/shared/live"
result=$(HOME="$reg_home" DOTFILES="$reg_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_contains "registered: the unlocked linked worktree is stale" \
  $'warn\t1 stale worktree' "$result"
_assert_not_contains "registered: a locked checkout is never listed as stale" \
  "locked-live (merged" "$result"
_assert_contains "registered: linked-only stale rows point at the gc" \
  "review with 'dot-worktree-gc' (dry run by default)" "$result"

# A locked checkout whose repository lives outside every clone root is
# still recognised as locked through its own pointer.
lockout_home=$(_tmpdir)
lockout_origin_root=$(_tmpdir)
_seed_origin "$lockout_origin_root/origin.git"
git clone "$lockout_origin_root/origin.git" "$lockout_home/elsewhere/repo" >/dev/null 2>&1
git -C "$lockout_home/elsewhere/repo" symbolic-ref refs/remotes/origin/HEAD \
  refs/remotes/origin/main >/dev/null 2>&1
git -C "$lockout_home/elsewhere/repo" worktree add --detach \
  "$lockout_home/.worktrees/locked-far" origin/main >/dev/null 2>&1
git -C "$lockout_home/.worktrees/locked-far" checkout -b locked-far >/dev/null 2>&1
git -C "$lockout_home/.worktrees/locked-far" branch --set-upstream-to=origin/main >/dev/null 2>&1
_make_old "$lockout_home/.worktrees/locked-far"
result=$(HOME="$lockout_home" DOTFILES="$lockout_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_contains "registered: fixture far checkout is stale while unlocked" \
  "locked-far (merged into origin/main)" "$result"
git -C "$lockout_home/elsewhere/repo" worktree lock "$lockout_home/.worktrees/locked-far" \
  >/dev/null 2>&1
result=$(HOME="$lockout_home" DOTFILES="$lockout_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_contains "registered: a far repository's locked checkout is not stale" \
  $'ok\tno stale worktrees' "$result"

# A reftable repository keeps HEAD as a placeholder; its table directory is
# the activity signal.
reft_home=$(_tmpdir)
git clone -q "$lockout_origin_root/origin.git" "$reft_home/.worktrees/reft" >/dev/null 2>&1
if git -C "$reft_home/.worktrees/reft" refs migrate --ref-format=reftable >/dev/null 2>&1 &&
  [[ -d $reft_home/.worktrees/reft/.git/reftable ]]; then
  git -C "$reft_home/.worktrees/reft" symbolic-ref refs/remotes/origin/HEAD \
    refs/remotes/origin/main >/dev/null 2>&1
  _make_old "$reft_home/.worktrees/reft"
  touch -t 202001010000 "$reft_home/.worktrees/reft/.git/reftable"
  result=$(HOME="$reft_home" DOTFILES="$reft_home/.dotfiles" \
    _doctor_records _dr_check_worktrees)
  _assert_contains "reftable: an idle reftable clone is stale" "reft (merged" "$result"
  touch "$reft_home/.worktrees/reft/.git/reftable"
  result=$(HOME="$reft_home" DOTFILES="$reft_home/.dotfiles" \
    _doctor_records _dr_check_worktrees)
  _assert_contains "reftable: fresh ref activity keeps it active" \
    $'ok\tno stale worktrees' "$result"
else
  echo "  - skipping reftable case (git cannot migrate to reftable)"
fi

# A folder that only groups checkouts is not itself a worktree, and a
# checkout nested in it is measured once, through the folder.
nest_home=$(_tmpdir)
mkdir -p "$nest_home/git/worktrees/group"
nest_origin_root=$(_tmpdir)
_seed_origin "$nest_origin_root/origin.git"
git clone "$nest_origin_root/origin.git" "$nest_home/git/nest" >/dev/null 2>&1
git -C "$nest_home/git/nest" worktree add "$nest_home/git/worktrees/group/three" \
  -b three >/dev/null 2>&1
head -c 102400 /dev/zero >"$nest_home/git/worktrees/group/three/blob.bin"
result=$(HOME="$nest_home" DOTFILES="$nest_home/.dotfiles" \
  DOT_WORKTREE_WARN_BYTES=150000 _doctor_records _dr_check_worktrees)
_assert_contains "nested: a grouping folder is not counted as a worktree" \
  "across 1 worktrees" "$result"
_assert_contains "nested: nested bytes are measured once" \
  $'ok\tworktree disk' "$result"

# Relative admin pointers (worktree.useRelativePaths) resolve like Git.
if git -C "$reg_main" worktree add --relative-paths "$reg_home/shared/relative" \
  -b relative >/dev/null 2>&1; then
  result=$(HOME="$reg_home" DOTFILES="$reg_home/.dotfiles" \
    _doctor_records _dr_check_worktrees)
  _assert_contains "registered: a relative pointer counts as live" \
    "across 3 worktrees" "$result"
  _assert_not_contains "registered: a relative pointer is not prunable" \
    ": relative" "$result"
else
  echo "  - skipping relative pointer case (git lacks --relative-paths)"
fi

echo ""
echo "=== Real Git behind the PATH launcher ==="

# A dotfiles launcher copy first on PATH is skipped by its marker line: the
# check reaches the next git and still reports, and never pays the launcher.
launch_bin=$(_tmpdir)
launch_log=$(_tmpfile)
cat >"$launch_bin/git" <<SH
#!/usr/bin/env bash
# Dotfiles-aware launcher for Git.
printf '%s\n' "\$*" >>"$launch_log"
exit 99
SH
chmod +x "$launch_bin/git"
result=$(HOME="$act_home" DOTFILES="$act_home/.dotfiles" \
  PATH="$launch_bin:$PATH" _doctor_records _dr_check_worktrees)
_assert_contains "launcher: the check still finds the stale checkout" \
  "act-idle (merged into origin/main" "$result"
_assert_eq "launcher: the launcher is never invoked" "" "$(cat "$launch_log")"

echo ""
echo "=== Parallel probes match serial probes ==="

par_saved_limit=$_DR_WORKTREE_STALE_LIST_LIMIT
_DR_WORKTREE_STALE_LIST_LIMIT=20
par_default=$(HOME="$batch_home" DOTFILES="$batch_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
par_serial=$(HOME="$batch_home" DOTFILES="$batch_home/.dotfiles" \
  DOT_DOCTOR_JOBS=1 _doctor_records _dr_check_worktrees)
par_dirty_serial=$(HOME="$dirty_home" DOTFILES="$dirty_home/.dotfiles" \
  DOT_DOCTOR_JOBS=1 _doctor_records _dr_check_worktrees)
par_dirty_default=$(HOME="$dirty_home" DOTFILES="$dirty_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_DR_WORKTREE_STALE_LIST_LIMIT=$par_saved_limit
_assert_eq "parallel: stale records match a serial run" "$par_serial" "$par_default"
_assert_eq "parallel: dirty records match a serial run" \
  "$par_dirty_serial" "$par_dirty_default"
_assert_contains "parallel: the serial run still finds the batch shapes" \
  "mb-gone (upstream origin/mb-gone is gone)" "$par_serial"

echo ""
echo "=== Repo identity keys ==="

key_home=$(_tmpdir)
key_origin_root=$(_tmpdir)
key_origin=$key_origin_root/origin.git
_seed_origin "$key_origin"
git clone "$key_origin" "$key_home/main" >/dev/null 2>&1
git -C "$key_home/main" worktree add "$key_home/linked-a" -b linked-a >/dev/null 2>&1
git -C "$key_home/main" worktree add "$key_home/linked-b" -b linked-b >/dev/null 2>&1
git clone "$key_origin" "$key_home/other" >/dev/null 2>&1
mkdir -p "$key_home/plain"
printf 'not-a-gitdir-pointer\n' >"$key_home/plain/.git"
key_main=$(_dr_worktree_repo_key "$key_home/main")
key_a=$(_dr_worktree_repo_key "$key_home/linked-a")
key_b=$(_dr_worktree_repo_key "$key_home/linked-b")
key_other=$(_dr_worktree_repo_key "$key_home/other")
_assert_eq "repo key: main and linked checkouts share one key" "$key_main" "$key_a"
_assert_eq "repo key: linked siblings share one key" "$key_a" "$key_b"
if [[ -n $key_main && -n $key_other ]]; then
  _pass "repo key: keys resolve to real paths"
else
  _fail "repo key: keys resolve to real paths"
fi
if [[ $key_other != "$key_main" ]]; then
  _pass "repo key: separate clones get distinct keys"
else
  _fail "repo key: separate clones get distinct keys"
fi
key_plain_status=0
_dr_worktree_repo_key "$key_home/plain" >/dev/null 2>&1 || key_plain_status=$?
_assert_exit "repo key: garbage gitfile fails closed" 1 "$key_plain_status"
key_missing_status=0
_dr_worktree_repo_key "$key_home/no-such-dir" >/dev/null 2>&1 || key_missing_status=$?
_assert_exit "repo key: missing dir fails closed" 1 "$key_missing_status"

_test_summary
