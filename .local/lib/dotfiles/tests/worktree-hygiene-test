  "run 'git -C <path> status' to see why" "$result"

echo ""
echo "=== DOT_DOCTOR_GIT ==="

# A host can name the Git binary for every probe: a wrapper first on PATH
# then never runs. An unusable value (missing, a directory, the dotfiles
# launcher) falls back to the PATH search, and the check still reports.
dg_real_git=$(command -v git)
dg_bin=$(_tmpdir)
dg_log=$(_tmpfile)
cat >"$dg_bin/git-plain" <<SH
#!/usr/bin/env bash
printf '%s\n' "\$*" >>"$dg_log"
exec "$dg_real_git" "\$@"
SH
chmod +x "$dg_bin/git-plain"
dg_wrap_bin=$(_tmpdir)
dg_wrap_log=$(_tmpfile)
cat >"$dg_wrap_bin/git" <<SH
#!/usr/bin/env bash
printf '%s\n' "\$*" >>"$dg_wrap_log"
exec "$dg_real_git" "\$@"
SH
chmod +x "$dg_wrap_bin/git"
result=$(HOME="$act_home" DOTFILES="$act_home/.dotfiles" PATH="$dg_wrap_bin:$PATH" \
  DOT_DOCTOR_GIT="$dg_bin/git-plain" _doctor_records _dr_check_worktrees)
_assert_contains "doctor git: an absolute path still finds the stale checkout" \
  "act-idle (merged into origin/main" "$result"
_assert_contains "doctor git: the named binary runs the probes" "for-each-ref" "$(cat "$dg_log")"
_assert_eq "doctor git: the PATH wrapper never runs" "" "$(cat "$dg_wrap_log")"
: >"$dg_log"
result=$(HOME="$act_home" DOTFILES="$act_home/.dotfiles" PATH="$dg_wrap_bin:$dg_bin:$PATH" \
  DOT_DOCTOR_GIT=git-plain _doctor_records _dr_check_worktrees)
_assert_contains "doctor git: a command name resolves through PATH" "for-each-ref" "$(cat "$dg_log")"
_assert_eq "doctor git: a command name skips the wrapper too" "" "$(cat "$dg_wrap_log")"
for dg_value in "$dg_bin/no-such-git" "$dg_bin" "$launch_bin/git" no-such-git-command; do
  : >"$dg_wrap_log"
  result=$(HOME="$act_home" DOTFILES="$act_home/.dotfiles" PATH="$dg_wrap_bin:$PATH" \
    DOT_DOCTOR_GIT="$dg_value" _doctor_records _dr_check_worktrees)
  _assert_contains "doctor git: an unusable value falls back (${dg_value##*/})" \
    "act-idle (merged into origin/main" "$result"
  _assert_contains "doctor git: the fallback is the PATH Git (${dg_value##*/})" \
    "for-each-ref" "$(cat "$dg_wrap_log")"
done
_assert_eq "doctor git: the launcher is never run" "" "$(cat "$launch_log")"

echo ""
echo "=== Base ref without origin/HEAD ==="

# A clone without the origin/HEAD symref resolves its base from the tracking
# query's conventional origin branch: no extra base-ref chain spawns.
nohead_home=$(_tmpdir)
nohead_origin_root=$(_tmpdir)
_seed_origin "$nohead_origin_root/origin.git"
mkdir -p "$nohead_home/.worktrees"
git clone "$nohead_origin_root/origin.git" "$nohead_home/.worktrees/nohead" >/dev/null 2>&1
git -C "$nohead_home/.worktrees/nohead" remote set-head origin --delete >/dev/null 2>&1
_make_old "$nohead_home/.worktrees/nohead"
nohead_log=$(_tmpfile)
nohead_bin=$(_tmpdir)
cat >"$nohead_bin/git" <<SH
#!/usr/bin/env bash
printf '%s\n' "\$*" >>"$nohead_log"
exec "$dg_real_git" "\$@"
SH
chmod +x "$nohead_bin/git"
result=$(HOME="$nohead_home" DOTFILES="$nohead_home/.dotfiles" PATH="$nohead_bin:$PATH" \
  _doctor_records _dr_check_worktrees)
_assert_contains "nohead: the synced clone is merged into origin/main" \
  "nohead (merged into origin/main, standalone clone)" "$result"
_assert_not_contains "nohead: no base-ref chain runs" "symbolic-ref" "$(cat "$nohead_log")"
_assert_not_contains "nohead: no remote listing runs" " remote" "$(cat "$nohead_log")"

echo ""
echo "=== Review edge cases ==="

# A gone upstream counts only when it is the branch's own name: a branch
# tracking another branch (the base it was cut from) may hold commits no
# remote ever saw, so it is never called stale on that alone.
foreign_home=$(_tmpdir)
foreign_origin_root=$(_tmpdir)
_seed_origin "$foreign_origin_root/origin.git"
mkdir -p "$foreign_home/.worktrees"
_clone_worktree "$foreign_origin_root/origin.git" "$foreign_home/.worktrees/foreign"
wt=$foreign_home/.worktrees/foreign
git -C "$wt" push origin main:base-slice >/dev/null 2>&1
git -C "$wt" fetch origin >/dev/null 2>&1
git -C "$wt" checkout -b local-work --track origin/base-slice >/dev/null 2>&1
_commit_file "$wt" never-pushed.txt
git -C "$wt" push origin --delete base-slice >/dev/null 2>&1
git -C "$wt" fetch --prune origin >/dev/null 2>&1
_make_old "$wt"
result=$(HOME="$foreign_home" DOTFILES="$foreign_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_contains "edge: a gone foreign upstream is not stale" $'ok\tno stale worktrees' "$result"
_DR_WORKTREE_BASE_KEYS=()
_DR_WORKTREE_BASE_REFS=()
_dr_worktree_stale_reason "$(cd "$wt" && pwd -P)"
_assert_eq "edge: the per-checkout probe agrees" "" "$REPLY"

# The same gone foreign upstream on a branch that did land still reads as
# merged: the batched probe must resolve a base for it.
_clone_worktree "$foreign_origin_root/origin.git" "$foreign_home/.worktrees/foreign-landed"
wt=$foreign_home/.worktrees/foreign-landed
git -C "$wt" push origin main:base-slice-2 >/dev/null 2>&1
git -C "$wt" fetch origin >/dev/null 2>&1
git -C "$wt" checkout -b landed --track origin/base-slice-2 >/dev/null 2>&1
_commit_file "$wt" landed.txt
git -C "$wt" push origin landed:main >/dev/null 2>&1
git -C "$wt" push origin --delete base-slice-2 >/dev/null 2>&1
git -C "$wt" fetch --prune origin >/dev/null 2>&1
_make_old "$wt"

# Neither a local upstream nor a remote whose name holds a slash is the
# branch's own name, however the short names line up.
_clone_worktree "$foreign_origin_root/origin.git" "$foreign_home/.worktrees/local-up"
wt=$foreign_home/.worktrees/local-up
git -C "$wt" checkout -b stack/feat >/dev/null 2>&1
git -C "$wt" checkout -b feat --track stack/feat >/dev/null 2>&1
_commit_file "$wt" local-only.txt
git -C "$wt" branch -D stack/feat >/dev/null 2>&1
_make_old "$wt"
_clone_worktree "$foreign_origin_root/origin.git" "$foreign_home/.worktrees/slash-remote"
wt=$foreign_home/.worktrees/slash-remote
git -C "$wt" remote add fork/a "$foreign_origin_root/origin.git" >/dev/null 2>&1
git -C "$wt" push fork/a main:x >/dev/null 2>&1
git -C "$wt" fetch fork/a >/dev/null 2>&1
git -C "$wt" checkout -b a/x --track fork/a/x >/dev/null 2>&1
_commit_file "$wt" fork-only.txt
git -C "$wt" push fork/a --delete x >/dev/null 2>&1
git -C "$wt" fetch --prune fork/a >/dev/null 2>&1
_make_old "$wt"
result=$(HOME="$foreign_home" DOTFILES="$foreign_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_contains "edge: a landed branch with a gone foreign upstream is merged" \
  "foreign-landed (merged into origin/main, standalone clone)" "$result"
_assert_contains "edge: only the landed branch is stale" $'warn\t1 stale worktree' "$result"
_assert_not_contains "edge: a gone local upstream is not stale" "local-up (" "$result"
_assert_not_contains "edge: a slash-named remote is not the branch's own" \
  "slash-remote (" "$result"
for wt in local-up slash-remote; do
  _DR_WORKTREE_BASE_KEYS=()
  _DR_WORKTREE_BASE_REFS=()
  _dr_worktree_stale_reason "$(cd "$foreign_home/.worktrees/$wt" && pwd -P)"
  _assert_eq "edge: the per-checkout probe agrees ($wt)" "" "$REPLY"
done

# Leading zeros in the disk knob are decimal, never octal: 02048 is 2K, not
# octal 1064, and 09000 is 9K, not an arithmetic error.
result=$(HOME="$disk_home" DOTFILES="$disk_home/.dotfiles" \
  DOT_WORKTREE_WARN_BYTES=02048 _doctor_records _dr_check_worktrees 2>&1)
_assert_contains "edge: a 0-led knob displays as decimal" \
  "the 2K DOT_WORKTREE_WARN_BYTES limit" "$result"
result=$(HOME="$disk_home" DOTFILES="$disk_home/.dotfiles" \
  DOT_WORKTREE_WARN_BYTES=09000 _doctor_records _dr_check_worktrees 2>&1)
_assert_not_contains "edge: a 0-led knob raises no arithmetic error" "value too great" "$result"
_assert_contains "edge: a 0-led non-octal knob still applies" \
  "the 9K DOT_WORKTREE_WARN_BYTES limit" "$result"
_assert_eq "edge: a 0-led knob reads as decimal" "900000000" \
  "$(DOT_WORKTREE_WARN_BYTES=0900000000 _dr_worktree_warn_bytes)"

# A CRLF pointer to a live Git directory is no orphan (Git strips the CR),
# and a deleted separate Git directory names its repository, not an admin
# entry of whatever folder holds it.
crlf_home=$(_tmpdir)
crlf_origin_root=$(_tmpdir)
_seed_origin "$crlf_origin_root/origin.git"
mkdir -p "$crlf_home/.worktrees/crlf" "$crlf_home/.worktrees/sep"
git clone --bare "$crlf_origin_root/origin.git" "$crlf_home/store.git" >/dev/null 2>&1
printf 'gitdir: %s\r\n' "$crlf_home/store.git" >"$crlf_home/.worktrees/crlf/.git"
printf 'gitdir: %s\n' "$crlf_home/worktrees/old/.git" >"$crlf_home/.worktrees/sep/.git"
result=$(HOME="$crlf_home" DOTFILES="$crlf_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_contains "edge: only the deleted pointer target is an orphan" \
  $'warn\t1 orphaned worktree' "$result"
# shellcheck disable=SC2088 # Rows carry tilde display paths.
_assert_contains "edge: a separate Git directory names its repository" \
  "~/.worktrees/sep (~/worktrees/old is gone)" "$result"

# An annotated tag at a conventional origin branch peels to a commit, as the
# chain's `^{commit}` does, so the batched probe takes the same base.
tag_home=$(_tmpdir)
tag_origin_root=$(_tmpdir)
_seed_origin "$tag_origin_root/origin.git"
mkdir -p "$tag_home/.worktrees"
git clone "$tag_origin_root/origin.git" "$tag_home/.worktrees/tagged" >/dev/null 2>&1
wt=$tag_home/.worktrees/tagged
_git_set_test_identity git -C "$wt"
git -C "$wt" remote set-head origin --delete >/dev/null 2>&1
git -C "$wt" tag -a -m peel peel-me origin/main >/dev/null 2>&1
git -C "$wt" update-ref refs/remotes/origin/main "$(git -C "$wt" rev-parse peel-me)" >/dev/null 2>&1
_make_old "$wt"
result=$(HOME="$tag_home" DOTFILES="$tag_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_contains "edge: a tag at origin/main still bases on origin/main" \
  "tagged (merged into origin/main, standalone clone)" "$result"

echo ""
echo "=== Nested and moved checkouts ==="

# A stale checkout holding another checkout (here in a folder Git ignores)
# is not the gc's to remove: removing it would delete the nested one.
nest_home2=$(_tmpdir)
nest_origin2=$(_tmpdir)
_seed_origin "$nest_origin2/origin.git"
_clone_worktree "$nest_origin2/origin.git" "$nest_home2/git/alpha"
mkdir -p "$nest_home2/worktrees/grp2"
git -C "$nest_home2/git/alpha" worktree add "$nest_home2/worktrees/grp2/f" --detach main >/dev/null 2>&1
git -C "$nest_home2/git/alpha" worktree add "$nest_home2/worktrees/grp2/f/.worktrees/inner" -b inner >/dev/null 2>&1
printf '%s\n' '.worktrees/' >>"$nest_home2/git/alpha/.git/info/exclude"
git -C "$nest_home2/worktrees/grp2/f" checkout -q -b f-merged >/dev/null 2>&1
_make_old "$nest_home2/worktrees/grp2/f"
result=$(HOME="$nest_home2" DOTFILES="$nest_home2/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_contains "nested: a checkout holding another is kept" \
  $'stale-entry\t~/worktrees/grp2/f (merged into origin/main, contains another checkout)' "$result"
_assert_not_contains "nested: the row does not send it to the gc" "'dot-worktree-gc --apply'" "$result"

# A prunable-looking entry whose checkout was only moved is a repair, not a
# prune: pruning would orphan the moved checkout.
mv_home=$(_tmpdir)
mv_origin=$(_tmpdir)
_seed_origin "$mv_origin/origin.git"
git clone "$mv_origin/origin.git" "$mv_home/git/alpha" >/dev/null 2>&1
mkdir -p "$mv_home/.worktrees"
git -C "$mv_home/git/alpha" worktree add "$mv_home/.worktrees/before" -b mv1 >/dev/null 2>&1
git -C "$mv_home/git/alpha" worktree add "$mv_home/.worktrees/deleted" -b mv2 >/dev/null 2>&1
mv "$mv_home/.worktrees/before" "$mv_home/.worktrees/after"
rm -rf "$mv_home/.worktrees/deleted"
result=$(HOME="$mv_home" DOTFILES="$mv_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_contains "moved: a deleted checkout's entry is still prunable" \
  $'warn\t1 prunable worktree entry\t~/git/alpha: deleted;' "$result"
_assert_contains "moved: a moved checkout gets the repair row" \
  $'warn\t1 moved worktree is not repaired\t~/.worktrees/after (entry before of ~/git/alpha);' "$result"
_assert_contains "moved: the repair row names the command for its checkout" \
  "run 'git -C ~/.worktrees/after worktree repair' (pruning would orphan it)" "$result"
# A prune in that repository would also drop the moved checkout's entry and
# orphan it, so the repair comes first and no bare prune is offered.
_assert_contains "moved: the prune hint repairs the moved checkout first" \
  "their checkouts are gone, but pruning now would orphan the moved worktree below: first run 'git -C ~/.worktrees/after worktree repair', then 'git -C ~/git/alpha worktree prune'" \
  "$result"
_assert_not_contains "moved: no bare prune is offered" \
  "their checkouts are gone: run 'git -C ~/git/alpha worktree prune'" "$result"
# Following the hint in order keeps the moved checkout.
git -C "$mv_home/.worktrees/after" worktree repair >/dev/null 2>&1
git -C "$mv_home/git/alpha" worktree prune >/dev/null 2>&1
result=$(HOME="$mv_home" DOTFILES="$mv_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_not_contains "moved: repair then prune leaves no orphan" "orphaned" "$result"
_assert_not_contains "moved: repair then prune leaves nothing to prune" "prunable" "$result"
# Two moved checkouts in the repository to prune: one repair command names
# both, and following the hint in order orphans neither.
mv3_home=$(_tmpdir)
git clone "$mv_origin/origin.git" "$mv3_home/git/gamma" >/dev/null 2>&1
mkdir -p "$mv3_home/.worktrees"
for mv3_name in a b gone; do
  git -C "$mv3_home/git/gamma" worktree add "$mv3_home/.worktrees/$mv3_name" -b "mv3-$mv3_name" >/dev/null 2>&1
done
mv "$mv3_home/.worktrees/a" "$mv3_home/.worktrees/a-moved"
mv "$mv3_home/.worktrees/b" "$mv3_home/.worktrees/b-moved"
rm -rf "$mv3_home/.worktrees/gone"
result=$(HOME="$mv3_home" DOTFILES="$mv3_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_contains "moved: two moved checkouts are repaired together before the prune" \
  "pruning now would orphan the moved worktrees below: first run 'git -C ~/git/gamma worktree repair ~/.worktrees/a-moved ~/.worktrees/b-moved', then 'git -C ~/git/gamma worktree prune'" \
  "$result"
git -C "$mv3_home/git/gamma" worktree repair "$mv3_home/.worktrees/a-moved" "$mv3_home/.worktrees/b-moved" >/dev/null 2>&1
git -C "$mv3_home/git/gamma" worktree prune >/dev/null 2>&1
result=$(HOME="$mv3_home" DOTFILES="$mv3_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_not_contains "moved: following the hint for two moved checkouts orphans neither" \
  "orphaned" "$result"
_assert_not_contains "moved: following the hint for two moved checkouts leaves nothing to prune" \
  "prunable" "$result"

# With only deleted checkouts, the prune command names the repository.
mv2_home=$(_tmpdir)
git clone "$mv_origin/origin.git" "$mv2_home/git/beta" >/dev/null 2>&1
mkdir -p "$mv2_home/.worktrees"
git -C "$mv2_home/git/beta" worktree add "$mv2_home/.worktrees/gone" -b mv3 >/dev/null 2>&1
rm -rf "$mv2_home/.worktrees/gone"
result=$(HOME="$mv2_home" DOTFILES="$mv2_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_contains "moved: the prune hint names the one repository" \
  "their checkouts are gone: run 'git -C ~/git/beta worktree prune'" "$result"

echo ""
echo "=== Symlinked HOME ==="

# HOME reached through a symlink (macOS keeps HOME and TMPDIR under
# /var -> /private/var): Git records physical paths in its gitdir files,
# and every row must still shorten them to ~ and count each checkout once.
sym_real=$(_tmpdir)
sym_home=$(_tmpdir)/home-link
ln -s "$sym_real" "$sym_home"
sym_real=$(cd "$sym_real" && pwd -P)
sym_origin_root=$(_tmpdir)
_seed_origin "$sym_origin_root/origin.git"
git clone "$sym_origin_root/origin.git" "$sym_home/git/alpha" >/dev/null 2>&1
sym_main=$sym_home/git/alpha
git -C "$sym_main" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main >/dev/null 2>&1
git -C "$sym_main" worktree add "$sym_home/shared/locked-live" -b sym-locked >/dev/null 2>&1
git -C "$sym_main" worktree lock "$sym_home/shared/locked-live" >/dev/null 2>&1
git -C "$sym_main" worktree add --detach "$sym_home/.worktrees/sym-stale" origin/main >/dev/null 2>&1
git -C "$sym_home/.worktrees/sym-stale" checkout -b sym-stale >/dev/null 2>&1
git -C "$sym_home/.worktrees/sym-stale" branch --set-upstream-to=origin/main >/dev/null 2>&1
_make_old "$sym_home/.worktrees/sym-stale"
git -C "$sym_main" worktree add "$sym_home/shared/gone" -b sym-gone >/dev/null 2>&1
rm -rf "$sym_home/shared/gone"
result=$(HOME="$sym_home" DOTFILES="$sym_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_contains "symlinked home: each checkout counts once" \
  "across 2 worktrees" "$result"
# shellcheck disable=SC2088 # Rows carry tilde display paths.
_assert_contains "symlinked home: a locked checkout displays under ~" \
  "~/shared/locked-live" "$result"
# shellcheck disable=SC2088 # Rows carry tilde display paths.
_assert_contains "symlinked home: a stale checkout displays under ~" \
  "~/.worktrees/sym-stale (merged into origin/main)" "$result"
# shellcheck disable=SC2088 # Rows carry tilde display paths.
_assert_contains "symlinked home: a prunable entry displays under ~" \
  "~/git/alpha: gone" "$result"
_assert_not_contains "symlinked home: no physical home path leaks into a row" \
  "$sym_real" "$result"

echo ""
echo "=== Repo identity keys ==="

key_home=$(_tmpdir)
key_origin_root=$(_tmpdir)
key_origin=$key_origin_root/origin.git
_seed_origin "$key_origin"
git clone "$key_origin" "$key_home/main" >/dev/null 2>&1
git -C "$key_home/main" worktree add "$key_home/linked-a" -b linked-a >/dev/null 2>&1
git -C "$key_home/main" worktree add "$key_home/linked-b" -b linked-b >/dev/null 2>&1
git clone "$key_origin" "$key_home/other" >/dev/null 2>&1
mkdir -p "$key_home/plain"
printf 'not-a-gitdir-pointer\n' >"$key_home/plain/.git"
key_main=$(_dr_worktree_repo_key "$key_home/main")
key_a=$(_dr_worktree_repo_key "$key_home/linked-a")
key_b=$(_dr_worktree_repo_key "$key_home/linked-b")
key_other=$(_dr_worktree_repo_key "$key_home/other")
_assert_eq "repo key: main and linked checkouts share one key" "$key_main" "$key_a"
_assert_eq "repo key: linked siblings share one key" "$key_a" "$key_b"
if [[ -n $key_main && -n $key_other ]]; then
  _pass "repo key: keys resolve to real paths"
else
  _fail "repo key: keys resolve to real paths"
fi
if [[ $key_other != "$key_main" ]]; then
  _pass "repo key: separate clones get distinct keys"
else
  _fail "repo key: separate clones get distinct keys"
fi
key_plain_status=0
_dr_worktree_repo_key "$key_home/plain" >/dev/null 2>&1 || key_plain_status=$?
_assert_exit "repo key: garbage gitfile fails closed" 1 "$key_plain_status"
key_missing_status=0
_dr_worktree_repo_key "$key_home/no-such-dir" >/dev/null 2>&1 || key_missing_status=$?
_assert_exit "repo key: missing dir fails closed" 1 "$key_missing_status"

