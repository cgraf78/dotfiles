_assert_contains "groups: the new roots and the group are stale" \
  $'warn\t3 stale worktrees' "$result"
_assert_contains "groups: ~/worktrees is a shared root" \
  $'stale-entry\t~/worktrees/g-top (merged into origin/main)' "$result"
_assert_contains "groups: ~/git/.worktrees is a shared root" \
  $'stale-entry\t~/git/.worktrees/g-hidden (merged into origin/main)' "$result"
_assert_contains "groups: a grouped checkout is swept" \
  $'stale-entry\t~/git/worktrees/batch/g-nested (merged into origin/main)' "$result"
_assert_not_contains "groups: descent stops one level down" "g-deep" "$result"
_assert_not_contains "groups: nothing is outside the swept roots" \
  "outside the swept roots" "$result"
grp_row=$(grep $'^warn\t3 stale worktrees' <<<"$result")
_assert_contains "groups: the stale row counts by reason" \
  $'warn\t3 stale worktrees (older than 14 days): 3 merged\t' "$grp_row"
_assert_contains "groups: the stale row ends with the gc commands" \
  "; run 'dot-worktree-gc' (dry run; also lists merged branches across clones), then 'dot-worktree-gc --apply' (deletes those branches too; untracked or ignored content other than tagged caches and cleanupRepo.worktreePrunePath entries keeps a checkout)" \
  "$grp_row"
# Every stale checkout is an item; a Dot with list items folds the tail
# itself, and the hint is a separate next-step line.
result=$(HOME="$grp_home" DOTFILES="$grp_home/.dotfiles" \
  _with_list_api _doctor_records _dr_check_worktrees)
_assert_contains "groups: list items name every stale checkout" \
  "$(printf '%s\n' $'warn\t3 stale worktrees (older than 14 days): 3 merged\t' \
    $'item\t~/git/.worktrees/g-hidden (merged into origin/main)\t' \
    $'item\t~/git/worktrees/batch/g-nested (merged into origin/main)\t' \
    $'item\t~/worktrees/g-top (merged into origin/main)\t' \
    $'hint\trun \'dot-worktree-gc\' (dry run; also lists merged branches across clones), then \'dot-worktree-gc --apply\' (deletes those branches too; untracked or ignored content other than tagged caches and cleanupRepo.worktreePrunePath entries keeps a checkout)\t')" \
  "$result"

# A grouping folder whose every checkout is stale counts whole toward the
# disk row's stale share, loose bytes included.
_disk_blob 409600 "$grp_home/git/worktrees/batch/notes/big.bin"
result=$(HOME="$grp_home" DOTFILES="$grp_home/.dotfiles" DOT_WORKTREE_WARN_BYTES=2048 \
  _with_list_api _doctor_records _dr_check_worktrees)
_assert_contains "groups: a stale grouping folder makes the disk row warn" \
