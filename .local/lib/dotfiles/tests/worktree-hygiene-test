  "$(awk -F '\t' '$1 == "warn" { inrow = ($2 ~ /^worktree disk /); next }
    inrow && $1 == "item" { sub(/ [^ ]*$/, "", $2); print $2; exit }' <<<"$result")"

echo ""
echo "=== Disk row names the largest roots ==="

top_home=$(_tmpdir)
mkdir -p "$top_home/.worktrees"
for top_name in big-c big-a big-d big-b; do
  mkdir -p "$top_home/.worktrees/$top_name"
