  "orph-top (" "$result"

echo ""
echo "=== Shared roots and grouping folders ==="

# ~/worktrees and ~/git/.worktrees are shared roots like ~/.worktrees and
# ~/git/worktrees, and a folder there without a `.git` groups checkouts one
# level down. The owning clone lives outside every clone root, so only the
# roots reach these checkouts; they are the gc's to sweep, so the stale row
# counts them by reason and points at the gc.
grp_home=$(_tmpdir)
grp_origin_root=$(_tmpdir)
_seed_origin "$grp_origin_root/origin.git"
grp_main=$(_tmpdir)/alpha
_clone_worktree "$grp_origin_root/origin.git" "$grp_main"
mkdir -p "$grp_home/worktrees" "$grp_home/git/.worktrees" \
  "$grp_home/git/worktrees/batch/notes" "$grp_home/git/worktrees/batch/deeper"
_grp_worktree() {
  git -C "$grp_main" worktree add "$grp_home/$1" -b "$2" >/dev/null 2>&1
  _git_set_test_identity git -C "$grp_home/$1"
  _commit_file "$grp_home/$1" "$2.txt"
  git -C "$grp_home/$1" push -u origin "$2" >/dev/null 2>&1
  git -C "$grp_main" fetch origin >/dev/null 2>&1
  git -C "$grp_main" merge --no-ff "origin/$2" -m "merge $2" >/dev/null 2>&1
  git -C "$grp_main" push origin main >/dev/null 2>&1
  _make_old "$grp_home/$1"
}
_grp_worktree worktrees/g-top g-top
_grp_worktree git/.worktrees/g-hidden g-hidden
_grp_worktree git/worktrees/batch/g-nested g-nested
_grp_worktree git/worktrees/batch/deeper/g-deep g-deep
result=$(HOME="$grp_home" DOTFILES="$grp_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_contains "groups: grouped checkouts count, the group and loose folders do not" \
