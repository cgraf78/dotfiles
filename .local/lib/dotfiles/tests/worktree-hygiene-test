#!/usr/bin/env bash
# worktree-hygiene-test — doctor worktree disk/staleness coverage.

set -o pipefail
export NO_COLOR=1
# A host may name the probe Git (an overlay sets DOT_DOCTOR_GIT); the suite
# must exercise the PATH resolution and its shims unless a case sets it.
unset DOT_DOCTOR_GIT

# shellcheck source=helpers.sh
. "${BASH_SOURCE[0]%/*}/helpers.sh"
# shellcheck source=fixtures.sh
. "${BASH_SOURCE[0]%/*}/fixtures.sh"
_test_prefer_system_git || exit 1

# Resolve the standalone engine before the fixture HOME replaces the lookup.
# (dot_fixture_copy_core reads DOT_TEST_SOURCE_HOME itself.)
DOT_TEST_DOT_ROOT=$(_test_dot_root) || {
  echo 'worktree hygiene tests require the standalone Dot checkout' >&2
  exit 1
}
export DOT_TEST_DOT_ROOT

dot_fixture_home
dot_fixture_copy_core
_test_load_dot_doctor_api "$TEST_HOME" || {
  echo 'worktree hygiene tests require the doctor extension API' >&2
  exit 1
}
dot_doctor_source doctor.d/lib/worktrees.sh || {
  echo 'worktree hygiene tests require doctor.d/lib/worktrees.sh' >&2
  exit 1
}
# The list helpers are newer than some Dot releases this suite runs
# against: default to the older API, where each row's items and next step
# join its detail, and opt in per case with stubs (_with_list_api).
unset -f dot_doctor_item dot_doctor_hint

# Run a command with the list helpers stubbed in, as a Dot that has them
# records items and hints.
_with_list_api() {
  (
    # shellcheck disable=SC2329 # Probed by the checks under test.
    dot_doctor_item() { _dot_doctor_record item "$1"; }
    # shellcheck disable=SC2329
    dot_doctor_hint() { _dot_doctor_record hint "$1"; }
    "$@"
  )
}

# The disk row reads free space with df; the host's own disk must not
# decide a case. This df reports every argument on one filesystem of
# HYGIENE_DF_SIZE KiB with HYGIENE_DF_AVAIL KiB free (default: plenty), or
# prints HYGIENE_DF_RAW verbatim (a captured df output, header included).
_hygiene_df_bin=$(_tmpdir)/df-bin
mkdir -p "$_hygiene_df_bin"
cat >"$_hygiene_df_bin/df" <<'SH'
#!/usr/bin/env bash
if [[ -n ${HYGIENE_DF_RAW:-} ]]; then
  printf '%s\n' "$HYGIENE_DF_RAW"
  exit 0
fi
size=${HYGIENE_DF_SIZE:-1073741824}
avail=${HYGIENE_DF_AVAIL:-1000000000}
printf 'Filesystem 1024-blocks Used Available Capacity Mounted on\n'
for arg; do
  case $arg in -*) continue ;; esac
  printf '/dev/test %s %s %s 50%% /test mount\n' "$size" $((size - avail)) "$avail"
done
SH
chmod +x "$_hygiene_df_bin/df"
PATH=$_hygiene_df_bin:$PATH
export PATH

# Fixture repositories must not depend on the developer's Git config (commit
# signing, hooks) or on inherited GIT_CONFIG_COUNT entries.
_hygiene_hooks_dir=$(_tmpdir)/empty-hooks
mkdir -p "$_hygiene_hooks_dir"
_test_hermetic_git core.hooksPath "$_hygiene_hooks_dir"

# Print the records a check filed, then one "stale-entry" line per clean
# stale checkout: the stale row shows counts only, so per-path reasons are
# asserted through the check's full list.
_doctor_records() {
  local status=0 entry
  : >"$DOT_DOCTOR_RESULT_FILE"
  _DR_WORKTREE_STALE_ENTRIES=()
  "$@" || status=$?
  cat "$DOT_DOCTOR_RESULT_FILE"
  for entry in ${_DR_WORKTREE_STALE_ENTRIES[@]+"${_DR_WORKTREE_STALE_ENTRIES[@]}"}; do
    _dr_worktree_label "${entry%%$'\t'*}"
    printf 'stale-entry\t%s (%s)\n' "$REPLY" "${entry#*$'\t'}"
  done
  return "$status"
}

# Seed a bare origin with a main branch carrying one commit.
_seed_origin() {
  local origin=$1 seed
  seed=$(_tmpdir)
  git init --bare "$origin" >/dev/null 2>&1
  git --git-dir="$origin" symbolic-ref HEAD refs/heads/main >/dev/null 2>&1
  git init "$seed" >/dev/null 2>&1
  _git_set_test_identity git -C "$seed"
  printf '%s\n' 'seed' >"$seed/file.txt"
  git -C "$seed" add file.txt >/dev/null 2>&1
  git -C "$seed" commit -m seed >/dev/null 2>&1
  git -C "$seed" branch -M main >/dev/null 2>&1
  git -C "$seed" push "$origin" main:main >/dev/null 2>&1
}

# Clone an origin into a worktree slot and pin its remote HEAD explicitly so
# default-branch detection never depends on clone transport behavior.
_clone_worktree() {
  local origin=$1 dest=$2
  git clone "$origin" "$dest" >/dev/null 2>&1
  _git_set_test_identity git -C "$dest"
  git -C "$dest" symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main >/dev/null 2>&1
}

_commit_file() {
  local dir=$1 name=$2
  printf '%s\n' "$name" >"$dir/$name"
  git -C "$dir" add "$name" >/dev/null 2>&1
  git -C "$dir" commit -m "$name" >/dev/null 2>&1
}

# Age a checkout: its root plus every Git activity signal the doctor reads
# (HEAD and index in the checkout's Git directory).
_make_old() {
  local dir=$1 gitdir='' first signal
  touch -t 202001010000 "$dir"
  if [[ -d $dir/.git ]]; then
    gitdir=$dir/.git
  elif [[ -f $dir/.git ]] && IFS= read -r first <"$dir/.git"; then
    gitdir=${first#gitdir: }
    [[ $gitdir == /* ]] || gitdir=$dir/$gitdir
  fi
  [[ -n $gitdir ]] || return 0
  for signal in "$gitdir/HEAD" "$gitdir/index"; do
    [[ -e $signal ]] && touch -t 202001010000 "$signal"
  done
  return 0
}
_make_fresh() { touch "$1"; }

# Write BYTES of incompressible data to FILE. Cases that compare sizes
# must not use zeros: a compressing or deduplicating filesystem (as on
# some CI hosts) stores them in a block or two, so du reports neither the
# written size nor a stable order between files.
_disk_blob() {
  head -c "$1" /dev/urandom >"$2"
}

echo "=== Worktree disk threshold ==="

disk_home=$(_tmpdir)
mkdir -p "$disk_home/.worktrees/big" "$disk_home/git/worktrees/small"
head -c 102400 /dev/zero >"$disk_home/.worktrees/big/blob.bin"
head -c 1024 /dev/zero >"$disk_home/git/worktrees/small/blob.bin"
# Old and non-git: counted for disk, silent for staleness.
_make_old "$disk_home/git/worktrees/small"

result=$(HOME="$disk_home" DOTFILES="$disk_home/.dotfiles" \
  DOT_WORKTREE_WARN_BYTES=2048 \
  _doctor_records _dr_check_worktrees)
status=$?
_assert_exit "disk: over-threshold check exits 0 (warn-only)" 0 "$status"
_assert_contains "disk: section renders" $'section\tWorktrees' "$result"
# Above the limit, active trees and room to spare are information only.
_assert_contains "disk: over-threshold active trees are info" $'info\tworktree disk' "$result"
_assert_not_contains "disk: over-threshold active trees do not warn" \
  $'warn\tworktree disk' "$result"
_assert_contains "disk: over-threshold counts both shared roots" \
  "across 2 worktrees" "$result"
_assert_contains "disk: over-threshold names the knob" \
  "DOT_WORKTREE_WARN_BYTES" "$result"
_assert_contains "disk: the info row says why it is not a warning" \
  "but stale and orphaned trees hold under half of it and 953.7G is free on /test mount" "$result"
_assert_contains "disk: the info row gives its reason before its largest trees" \
  $' across 2 worktrees\tabove the 2K DOT_WORKTREE_WARN_BYTES limit, but ' "$result"
_assert_contains "disk: the info row labels its largest trees" \
  $' is free on /test mount; largest: ~/.worktrees/big ' "$result"
# On a Dot with list items, the largest trees are items and the reason is
# the row's detail: nothing needs doing, so it is no next-step line.
result=$(HOME="$disk_home" DOTFILES="$disk_home/.dotfiles" DOT_WORKTREE_WARN_BYTES=2048 \
  _with_list_api _doctor_records _dr_check_worktrees)
_assert_contains "disk: the info row lists its largest trees as items" \
  $'\nitem\tlargest: ~/.worktrees/big ' "$result"
_assert_contains "disk: the info row gives its reason as its detail" \
  $' across 2 worktrees\tabove the 2K DOT_WORKTREE_WARN_BYTES limit, but stale and orphaned trees hold under half of it and 953.7G is free on /test mount\n' \
  "$result"
_assert_not_contains "disk: the info row files no next step" $'\nhint\t' "$result"

# Low space: under 5% of used plus available and under 20 GiB free.
result=$(HOME="$disk_home" DOTFILES="$disk_home/.dotfiles" \
  DOT_WORKTREE_WARN_BYTES=2048 HYGIENE_DF_SIZE=1073741824 HYGIENE_DF_AVAIL=10485760 \
  _doctor_records _dr_check_worktrees)
_assert_contains "disk: low space warns" \
  $' across 2 worktrees; only 10.0G free on /test mount\t' "$result"
# Raising the limit would silence a real low-space warning, so it is not
# offered then.
_assert_contains "disk: low space says to free space" \
  "free space on /test mount: remove finished worktrees ('dot-worktree-gc' lists stale ones) or other large files there" \
  "$result"
_assert_not_contains "disk: low space does not offer raising the limit" \
  "raise the" "$result"
result=$(HOME="$disk_home" DOTFILES="$disk_home/.dotfiles" \
  DOT_WORKTREE_WARN_BYTES=2048 HYGIENE_DF_SIZE=1073741824 HYGIENE_DF_AVAIL=52428800 \
  _doctor_records _dr_check_worktrees)
_assert_contains "disk: tens of GiB free is not low, whatever the percentage" \
  $'info\tworktree disk' "$result"
result=$(HOME="$disk_home" DOTFILES="$disk_home/.dotfiles" \
  DOT_WORKTREE_WARN_BYTES=2048 HYGIENE_DF_SIZE=20971520 HYGIENE_DF_AVAIL=4194304 \
  _doctor_records _dr_check_worktrees)
_assert_contains "disk: a small disk with a fifth free is not low" \
  $'info\tworktree disk' "$result"
# A real `df -Pk` shape from a large ext4 disk at 96% use: f_blocks counts
# the root-reserved blocks, so available is 4.5% of the size but 4.8% of
# used plus available, and 52 GiB is not low either way.
result=$(HOME="$disk_home" DOTFILES="$disk_home/.dotfiles" DOT_WORKTREE_WARN_BYTES=2048 \
  HYGIENE_DF_RAW=$'Filesystem     1024-blocks       Used Available Capacity Mounted on\n/dev/vda4       1203111804 1088593744  54518060      96% /' \
  _doctor_records _dr_check_worktrees)
_assert_contains "disk: a real df line parses, and 52 GiB free is not low" \
  "52.0G is free on /" "$result"
result=$(HOME="$disk_home" DOTFILES="$disk_home/.dotfiles" DOT_WORKTREE_WARN_BYTES=2048 \
  HYGIENE_DF_RAW=$'Filesystem     1024-blocks       Used Available Capacity Mounted on\n/dev/vda4       1203111804 1136000000  10000000      100% /' \
  _doctor_records _dr_check_worktrees)
_assert_contains "disk: a real df line under both thresholds is low" \
  "; only 9.5G free on /"$'\t' "$result"
# The host's own df (no shim) parses on every CI platform: GNU, BusyBox,
# BSD/macOS, and Termux all print the POSIX `-Pk` shape. Only the shape is
# asserted; the host's free space decides nothing here.
hygiene_real_path=${PATH//"$_hygiene_df_bin:"/}
if PATH=$hygiene_real_path _dr_worktree_free_space "$disk_home"; then
  if [[ ${_DR_WORKTREE_FS[0]} =~ ^[0-9]+$'\t'[0-9]+$'\t'/ ]]; then
    _pass "disk: the host df parses into available, used, and a mount"
  else
    _fail "disk: the host df parses into available, used, and a mount (got '${_DR_WORKTREE_FS[0]}')"
  fi
else
  _fail "disk: the host df parses into available, used, and a mount (df gave nothing usable)"
fi
# Every filesystem holding a root is judged, not only the emptiest one: a
# small volume with room to spare must not hide a large one that is full.
result=$(HOME="$disk_home" DOTFILES="$disk_home/.dotfiles" DOT_WORKTREE_WARN_BYTES=2048 \
  HYGIENE_DF_RAW=$'Filesystem 1024-blocks Used Available Capacity Mounted on\n/dev/small 20971520 10485760 8388608 56% /small\n/dev/big 1203111804 1180000000 12000000 99% /big\n/dev/big 1203111804 1180000000 12000000 99% /big' \
  _doctor_records _dr_check_worktrees)
_assert_contains "disk: a full filesystem warns even when another has less free" \
  "; only 11.4G free on /big"$'\t' "$result"
# df that cannot answer leaves free space unknown: info, without a free part.
disk_nodf=$(_tmpdir)
printf '#!/bin/sh\nexit 1\n' >"$disk_nodf/df"
chmod +x "$disk_nodf/df"
result=$(HOME="$disk_home" DOTFILES="$disk_home/.dotfiles" \
  DOT_WORKTREE_WARN_BYTES=2048 PATH="$disk_nodf:$PATH" \
  _doctor_records _dr_check_worktrees)
_assert_contains "disk: unknown free space is info" $'info\tworktree disk' "$result"
_assert_not_contains "disk: unknown free space names no mount" " free on " "$result"
# A stale root holding an active checkout is not reclaimable as a whole:
# removing it would delete the active one too.
nest_disk_saved=("${_DR_WORKTREE_DU_SIZES[@]}")
: >"$DOT_DOCTOR_RESULT_FILE"
_DR_WORKTREE_DU_SIZES=($'900\t/r/stale' $'100\t/r/solo')
_DR_WORKTREE_DISK_ROOTS=(/r/stale /r/solo)
_DR_WORKTREE_DISK_CHECKOUTS=(/r/stale /r/stale/.worktrees/active /r/solo)
_DR_WORKTREE_DISK_CULPRITS=(/r/stale)
HOME=/nonexistent DOT_WORKTREE_WARN_BYTES=2048 _dr_worktree_report_disk 3 1000
_assert_contains "disk: a stale root holding an active checkout is no culprit" \
  $'info\tworktree disk 1000K across 3 worktrees' "$(cat "$DOT_DOCTOR_RESULT_FILE")"
: >"$DOT_DOCTOR_RESULT_FILE"
_DR_WORKTREE_DISK_CHECKOUTS=(/r/stale /r/solo)
HOME=/nonexistent DOT_WORKTREE_WARN_BYTES=2048 _dr_worktree_report_disk 2 1000
_assert_contains "disk: a stale root with nothing active inside is a culprit" \
  $'warn\tworktree disk 1000K across 2 worktrees, 900K of it stale or orphaned' \
  "$(cat "$DOT_DOCTOR_RESULT_FILE")"
_DR_WORKTREE_DU_SIZES=(${nest_disk_saved[@]+"${nest_disk_saved[@]}"})

# A full disk whose reserved blocks are in use reports a negative Available.
result=$(HOME="$disk_home" DOTFILES="$disk_home/.dotfiles" \
  DOT_WORKTREE_WARN_BYTES=2048 HYGIENE_DF_AVAIL=-100 \
  _doctor_records _dr_check_worktrees)
_assert_contains "disk: a negative Available is a full disk" \
  "; only 0B free on /test mount"$'\t' "$result"
# A filesystem reporting no size at all says nothing about space.
result=$(HOME="$disk_home" DOTFILES="$disk_home/.dotfiles" \
  DOT_WORKTREE_WARN_BYTES=2048 HYGIENE_DF_SIZE=0 HYGIENE_DF_AVAIL=0 \
  _doctor_records _dr_check_worktrees)
_assert_contains "disk: a zero-size filesystem is not low on space" \
  $'info\tworktree disk' "$result"

result=$(HOME="$disk_home" DOTFILES="$disk_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
_assert_contains "disk: under-threshold is ok" $'ok\tworktree disk' "$result"
_assert_contains "disk: non-git dirs are safe for staleness" \
  $'ok\tno stale worktrees' "$result"

result=$(HOME="$disk_home" DOTFILES="$disk_home/.dotfiles" \
  DOT_WORKTREE_WARN_BYTES=bogus \
  _doctor_records _dr_check_worktrees)
_assert_contains "disk: invalid override falls back to the default" \
  $'ok\tworktree disk' "$result"

echo ""
echo "=== Missing worktree roots ==="

empty_home=$(_tmpdir)
result=$(HOME="$empty_home" DOTFILES="$empty_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
status=$?
_assert_exit "missing: absent roots exit 0" 0 "$status"
_assert_contains "missing: absent roots report ok" \
  $'ok\tno worktrees found' "$result"

echo ""
echo "=== Stale worktree detection ==="

stale_home=$(_tmpdir)
origin_root=$(_tmpdir)
stale_origin=$origin_root/origin.git
_seed_origin "$stale_origin"

# Old, merged into the upstream default: warns.
_clone_worktree "$stale_origin" "$stale_home/.worktrees/old-merged"
wt=$stale_home/.worktrees/old-merged
git -C "$wt" checkout -b feature >/dev/null 2>&1
_commit_file "$wt" feature.txt
git -C "$wt" push -u origin feature >/dev/null 2>&1
git -C "$wt" checkout main >/dev/null 2>&1
git -C "$wt" merge --no-ff feature -m merge >/dev/null 2>&1
git -C "$wt" push origin main >/dev/null 2>&1
git -C "$wt" checkout feature >/dev/null 2>&1
git -C "$wt" fetch --prune origin >/dev/null 2>&1
_make_old "$wt"

# Old, unmerged, upstream alive: silent.
_clone_worktree "$stale_origin" "$stale_home/.worktrees/old-unmerged"
wt=$stale_home/.worktrees/old-unmerged
git -C "$wt" checkout -b wip >/dev/null 2>&1
_commit_file "$wt" wip.txt
git -C "$wt" push -u origin wip >/dev/null 2>&1
_make_old "$wt"

# Young, merged into the upstream default: silent.
_clone_worktree "$stale_origin" "$stale_home/.worktrees/young-merged"
wt=$stale_home/.worktrees/young-merged
git -C "$wt" checkout -b feature-young >/dev/null 2>&1
_commit_file "$wt" feature-young.txt
git -C "$wt" push -u origin feature-young >/dev/null 2>&1
git -C "$wt" checkout main >/dev/null 2>&1
git -C "$wt" merge --no-ff feature-young -m merge >/dev/null 2>&1
git -C "$wt" push origin main >/dev/null 2>&1
git -C "$wt" checkout feature-young >/dev/null 2>&1
git -C "$wt" fetch --prune origin >/dev/null 2>&1
_make_fresh "$wt"

# Old, upstream branch deleted and pruned: warns.
_clone_worktree "$stale_origin" "$stale_home/.worktrees/old-gone"
wt=$stale_home/.worktrees/old-gone
git -C "$wt" checkout -b temp >/dev/null 2>&1
_commit_file "$wt" temp.txt
git -C "$wt" push -u origin temp >/dev/null 2>&1
git -C "$wt" checkout main >/dev/null 2>&1
git -C "$wt" push origin --delete temp >/dev/null 2>&1
git -C "$wt" fetch --prune origin >/dev/null 2>&1
git -C "$wt" checkout temp >/dev/null 2>&1
_make_old "$wt"

# Old, detached HEAD: safe and silent.
_clone_worktree "$stale_origin" "$stale_home/.worktrees/old-detached"
wt=$stale_home/.worktrees/old-detached
git -C "$wt" checkout "$(git -C "$wt" rev-parse HEAD)" >/dev/null 2>&1
_make_old "$wt"

# Old, no remotes at all: safe and silent.
mkdir -p "$stale_home/git/worktrees/old-no-remote"
wt=$stale_home/git/worktrees/old-no-remote
git init "$wt" >/dev/null 2>&1
_git_set_test_identity git -C "$wt"
_commit_file "$wt" local.txt
git -C "$wt" branch -M main >/dev/null 2>&1
_make_old "$wt"

# Old checkout sitting on the synced default branch in a repo-local root:
# fully merged, so warns.
mkdir -p "$stale_home/git/old-main-repo/.worktrees"
# Only a clone root's .worktrees is enumerated, so the parent is a repo.
git init --quiet "$stale_home/git/old-main-repo"
_clone_worktree "$stale_origin" "$stale_home/git/old-main-repo/.worktrees/old-main"
_make_old "$stale_home/git/old-main-repo/.worktrees/old-main"

result=$(HOME="$stale_home" DOTFILES="$stale_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
status=$?
_assert_exit "stale: detection exits 0 (warn-only)" 0 "$status"
_assert_contains "stale: enumeration covers every root" \
  "across 7 worktrees" "$result"
_assert_contains "stale: old merged and gone worktrees warn" \
  $'warn\t3 stale worktrees' "$result"
_assert_contains "stale: merged reason names the default" \
  "merged into origin/main" "$result"
_assert_contains "stale: merged worktree is listed" "old-merged" "$result"
_assert_contains "stale: gone worktree is listed" "old-gone" "$result"
_assert_contains "stale: gone reason names the upstream" \
  "upstream origin/temp is gone" "$result"
_assert_contains "stale: synced default checkout warns" "old-main" "$result"
_assert_not_contains "stale: old unmerged worktree stays silent" \
  "old-unmerged" "$result"
_assert_not_contains "stale: young merged worktree stays silent" \
  "young-merged" "$result"
_assert_not_contains "stale: detached HEAD stays silent" \
  "old-detached" "$result"
_assert_not_contains "stale: repo without remotes stays silent" \
  "old-no-remote" "$result"

echo ""
echo "=== Multi-remote default branch ==="

multi_home=$(_tmpdir)
multi_origin_root=$(_tmpdir)
multi_origin=$multi_origin_root/origin.git
_seed_origin "$multi_origin"

# A second remote whose HEAD sorts before origin's must never win: the
# checkout is merged into origin/main and must say so.
_clone_worktree "$multi_origin" "$multi_home/.worktrees/old-multiremote"
wt=$multi_home/.worktrees/old-multiremote
git -C "$wt" checkout -b feature-mr >/dev/null 2>&1
_commit_file "$wt" feature-mr.txt
git -C "$wt" push -u origin feature-mr >/dev/null 2>&1
git -C "$wt" checkout main >/dev/null 2>&1
git -C "$wt" merge --no-ff feature-mr -m merge >/dev/null 2>&1
git -C "$wt" push origin main >/dev/null 2>&1
git -C "$wt" checkout feature-mr >/dev/null 2>&1
git -C "$wt" remote add fork "$multi_origin" >/dev/null 2>&1
git -C "$wt" fetch fork >/dev/null 2>&1
git -C "$wt" symbolic-ref refs/remotes/fork/HEAD refs/remotes/fork/main >/dev/null 2>&1
_make_old "$wt"

# A lone non-origin remote still resolves through its HEAD.
git clone -o upstream "$multi_origin" "$multi_home/.worktrees/old-upstream-only" >/dev/null 2>&1
wt=$multi_home/.worktrees/old-upstream-only
_git_set_test_identity git -C "$wt"
git -C "$wt" symbolic-ref refs/remotes/upstream/HEAD refs/remotes/upstream/main >/dev/null 2>&1
git -C "$wt" checkout -b feature-up >/dev/null 2>&1
_commit_file "$wt" feature-up.txt
git -C "$wt" push -u upstream feature-up >/dev/null 2>&1
git -C "$wt" checkout main >/dev/null 2>&1
git -C "$wt" merge --no-ff feature-up -m merge >/dev/null 2>&1
git -C "$wt" push upstream main >/dev/null 2>&1
git -C "$wt" checkout feature-up >/dev/null 2>&1
git -C "$wt" fetch --prune upstream >/dev/null 2>&1
_make_old "$wt"

# With origin's HEAD symref missing, conventional origin names win over
# any fork HEAD.
_clone_worktree "$multi_origin" "$multi_home/.worktrees/old-no-head-symref"
wt=$multi_home/.worktrees/old-no-head-symref
git -C "$wt" checkout -b feature-nh >/dev/null 2>&1
_commit_file "$wt" feature-nh.txt
git -C "$wt" push -u origin feature-nh >/dev/null 2>&1
git -C "$wt" checkout main >/dev/null 2>&1
git -C "$wt" merge --no-ff feature-nh -m merge >/dev/null 2>&1
git -C "$wt" push origin main >/dev/null 2>&1
git -C "$wt" checkout feature-nh >/dev/null 2>&1
git -C "$wt" remote add fork "$multi_origin" >/dev/null 2>&1
git -C "$wt" fetch fork >/dev/null 2>&1
git -C "$wt" symbolic-ref refs/remotes/fork/HEAD refs/remotes/fork/main >/dev/null 2>&1
git -C "$wt" symbolic-ref -d refs/remotes/origin/HEAD >/dev/null 2>&1
_make_old "$wt"

# Fixture-validity lock: fork/HEAD must sort before origin/HEAD, or the
# fork assertions below would pass on unfixed code (false negative).
first_head=$(git -C "$multi_home/.worktrees/old-multiremote" for-each-ref --format='%(refname)' 'refs/remotes/*/HEAD' | head -1)
_assert_eq "multiremote: fixture fork HEAD sorts first" "refs/remotes/fork/HEAD" "$first_head"

result=$(HOME="$multi_home" DOTFILES="$multi_home/.dotfiles" \
  _doctor_records _dr_check_worktrees)
status=$?
_assert_exit "multiremote: detection exits 0 (warn-only)" 0 "$status"
_assert_contains "multiremote: all three checkouts warn" \
  $'warn\t3 stale worktrees' "$result"
_assert_contains "multiremote: fork HEAD never becomes the base" \
  "merged into origin/main" "$result"
_assert_not_contains "multiremote: fork reason never prints" "fork/" "$result"
_assert_contains "multiremote: lone non-origin remote resolves" \
