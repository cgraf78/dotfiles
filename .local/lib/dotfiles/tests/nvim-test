    return
  end
  if calls["cgraf78/present"] ~= 1 then
    print("duplicate-present-root:" .. tostring(calls["cgraf78/present"]))
    return
  end

  if runtime.dep_file("cgraf78/missing", "assets/readable file.lua") ~= nil then
    print("initially-missing-root-resolved")
    return
  end
  if runtime.dep_file("cgraf78/missing", "assets/readable file.lua") ~= nil
    or calls["cgraf78/missing"] ~= 1
  then
    print("missing-root-not-batched")
    return
  end
  local recovered = nil
  local recovered_in_time = vim.wait(1000, function()
    recovered = runtime.dep_file("cgraf78/missing", "assets/readable file.lua")
    return recovered ~= nil
  end, 1)
  if not recovered_in_time or not recovered
    or not runtime.dep_file("cgraf78/missing", "assets/readable file.lua") then
    print("installed-root-did-not-recover")
    return
  end
  if calls["cgraf78/missing"] ~= 2 then
    print("missing-root-recovery-count:" .. tostring(calls["cgraf78/missing"]))
    return
  end

  local invalid = {
    "", "/absolute", "C:\\\\absolute", "\\\\\\\\server\\\\share",
    "../escape", "nested/../escape", "nested\\\\..\\\\escape", "nul\0byte",
  }
  local before = calls["cgraf78/present"]
  for _, relpath in ipairs(invalid) do
    if runtime.dep_file("cgraf78/present", relpath) ~= nil then
      print("invalid-path-resolved:" .. relpath)
      return
    end
  end
