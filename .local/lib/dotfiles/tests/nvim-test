        if dep == "cgraf78/present" or (dep == "cgraf78/missing" and calls[dep] > 1) then
          return vim.env.DOT_TEST_DEP_FILE_ROOT
        end
        return nil
      end,
    }
  end

  local readable = runtime.dep_file("cgraf78/present", "assets/readable file.lua")
  local symlink = runtime.dep_file("cgraf78/present", "assets/symlink.lua")
  if not readable or not symlink then
