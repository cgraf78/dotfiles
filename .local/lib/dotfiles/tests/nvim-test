_assert_eq "startup timeout: descendant watchdog returns timeout status" "124" "$rc"
descendant_pid=$(cat "$timeout_descendant_pid")
_assert_process_stopped "startup timeout: descendant that ignores TERM is killed" \
  "$descendant_pid"

rc=0
