    return
  end
  if runtime.dep_file("cgraf78/present", "assets/missing.lua") ~= nil
    or runtime.dep_file("cgraf78/present", "assets/dir") ~= nil
    or runtime.dep_file("cgraf78/present", "assets/fifo") ~= nil
    or runtime.dep_file("cgraf78/present", "assets/fifo-symlink") ~= nil
  then
