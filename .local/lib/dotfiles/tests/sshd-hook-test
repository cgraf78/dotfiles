#!/usr/bin/env bash

set -euo pipefail

REAL_HOME=${DOT_TEST_SOURCE_HOME:-$HOME}
# shellcheck source=helpers.sh
. "$REAL_HOME/.local/lib/dotfiles/tests/helpers.sh"

TEST_HOME=$(_tmpdir)
export HOME=$TEST_HOME
export DOT_TEST_SOURCE_HOME=$REAL_HOME
_test_load_dot_merge_api || {
  _fail 'sshd hook: standalone merge API is unavailable'
  _test_summary
}

HOOK=$REAL_HOME/.local/lib/dotfiles/merge-hooks.d/sshd.serial.sh
[[ -f $HOOK ]] || {
  _fail 'sshd hook: standalone client hook is installed'
  _test_summary
  exit 1
}
SOURCE_DIR=$TEST_HOME/.config/dot/merge-hooks.d/sshd/sshd_config.d
SOURCE=$SOURCE_DIR/60-termnav-relay.conf
SSHD_ROOT=$TEST_HOME/sshd-root
DESTINATION=$SSHD_ROOT/sshd_config.d/60-termnav-relay.conf
LOG=$TEST_HOME/sshd-merge.log

mkdir -p "$SOURCE_DIR"
printf 'AcceptEnv TERMNAV_PARENT_RELAY\n' >"$SOURCE"
: >"$LOG"

run_sshd_merge() {
  unset -f merge _sshd_effective_uid _sshd_config_root _sshd_ready \
    _sshd_set_owner 2>/dev/null || true
  # shellcheck source=/dev/null
  . "$HOOK"
  # shellcheck disable=SC2329 # Invoked indirectly by merge.
  _sshd_effective_uid() { printf '%s\n' "${SSHD_EFFECTIVE_UID:-0}"; }
  # shellcheck disable=SC2329 # Invoked indirectly by merge.
  _sshd_config_root() { printf '%s\n' "$SSHD_ROOT"; }
  # shellcheck disable=SC2329 # Invoked indirectly by merge.
  _sshd_ready() { return "${SSHD_READY_STATUS:-0}"; }
  # shellcheck disable=SC2329 # Invoked indirectly by merge.
  _sshd_set_owner() { printf 'owner:%s\n' "$1" >>"$LOG"; }
  merge
}

SSHD_EFFECTIVE_UID=1000
run_sshd_merge >/dev/null 2>&1
_assert_file_missing 'sshd hook: non-root run is a no-op' "$DESTINATION"

SSHD_EFFECTIVE_UID=0
# shellcheck disable=SC2329 # Public tool probe used by merge.
dot_tool_present() { return 1; }
run_sshd_merge >/dev/null 2>&1
_assert_file_missing 'sshd hook: absent sshd is a no-op' "$DESTINATION"

# shellcheck disable=SC2329 # Public tool probe used by merge.
dot_tool_present() { return 0; }
mkdir -p "$SSHD_ROOT"
printf 'Port 22\n' >"$SSHD_ROOT/sshd_config"
run_sshd_merge >/dev/null 2>&1
_assert_file_missing 'sshd hook: missing include directory is unsupported' "$DESTINATION"

mkdir -p "$SSHD_ROOT/sshd_config.d"
SSHD_READY_STATUS=1
run_sshd_merge >/dev/null 2>&1
_assert_file_missing 'sshd hook: unready server is unsupported' "$DESTINATION"
SSHD_READY_STATUS=0

# shellcheck disable=SC2329 # Invoked by the hook under test.
sshd() {
  printf 'validate:%s\n' "$*" >>"$LOG"
  [[ $1 == -T ]] &&
    printf '%s TERMNAV_PARENT_RELAY\n' "${SSHD_EFFECTIVE_KEY:-acceptenv}"
  return "${SSHD_VALIDATE_STATUS:-0}"
}
# shellcheck disable=SC2329 # Invoked by the hook under test.
systemctl() {
  printf 'systemctl:%s\n' "$*" >>"$LOG"
  case $1:${3:-${2:-}} in
    is-active:sshd.service) return "${SSHD_SERVICE_STATUS:-0}" ;;
    is-active:ssh.service) return "${SSH_SERVICE_STATUS:-1}" ;;
    reload:*) return "${SSHD_RELOAD_STATUS:-0}" ;;
  esac
  return 1
}
# shellcheck disable=SC2329 # Invoked by the hook under test.
service() {
  printf 'service:%s\n' "$*" >>"$LOG"
  case $1:$2 in
    sshd:status) return "${SSHD_SYSV_STATUS:-1}" ;;
    ssh:status) return "${SSH_SYSV_STATUS:-1}" ;;
    *:reload) return "${SSHD_RELOAD_STATUS:-0}" ;;
  esac
  return 1
}
# shellcheck disable=SC2329 # Invoked by the hook under test.
launchctl() {
  printf 'launchctl:%s\n' "$*" >>"$LOG"
  case $1:${2:-} in
    print:system/com.openssh.sshd) return "${SSHD_LAUNCHD_STATUS:-1}" ;;
    kickstart:-k) return "${SSHD_RELOAD_STATUS:-0}" ;;
  esac
  return 1
}
export -f sshd systemctl service launchctl
export SSHD_VALIDATE_STATUS=0 SSHD_SERVICE_STATUS=0 SSH_SERVICE_STATUS=1
export SSHD_SYSV_STATUS=1 SSH_SYSV_STATUS=1 SSHD_LAUNCHD_STATUS=1
export SSHD_RELOAD_STATUS=0 LOG

SSHD_EFFECTIVE_KEY=AcceptEnv
: >"$LOG"
run_sshd_merge >/dev/null 2>&1
_assert_file_exists 'sshd hook: installs a validated relay policy' "$DESTINATION"
_assert_eq 'sshd hook: installs exact declarative content' \
  "$(cat "$SOURCE")" "$(cat "$DESTINATION")"
mode=$(stat -c '%a' "$DESTINATION" 2>/dev/null || stat -f '%Lp' "$DESTINATION")
_assert_eq 'sshd hook: installs system config mode' 644 "$mode"
log=$(cat "$LOG")
_assert_contains 'sshd hook: validates the full server config' \
  "validate:-t -f $SSHD_ROOT/sshd_config" "$log"
_assert_contains 'sshd hook: checks effective AcceptEnv policy' \
  "validate:-T -f $SSHD_ROOT/sshd_config" "$log"
_assert_contains 'sshd hook: reloads the active sshd service' \
  'systemctl:reload sshd.service' "$log"

: >"$LOG"
run_sshd_merge >/dev/null 2>&1
_assert_eq 'sshd hook: unchanged policy performs no validation or reload' \
  '' "$(cat "$LOG")"

printf 'known-good\n' >"$DESTINATION"
printf 'invalid replacement\n' >"$SOURCE"
SSHD_VALIDATE_STATUS=1
: >"$LOG"
status=0
run_sshd_merge >/dev/null 2>&1 || status=$?
_assert_exit 'sshd hook: validation failure propagates' 1 "$status"
_assert_eq 'sshd hook: validation failure restores prior policy' \
  known-good "$(cat "$DESTINATION")"
_assert_not_contains 'sshd hook: validation failure does not reload' \
  'systemctl:reload' "$(cat "$LOG")"

printf 'AcceptEnv TERMNAV_PARENT_RELAY\n' >"$SOURCE"
SSHD_VALIDATE_STATUS=0
SSHD_RELOAD_STATUS=1
: >"$LOG"
status=0
run_sshd_merge >/dev/null 2>&1 || status=$?
_assert_exit 'sshd hook: reload failure propagates' 1 "$status"
_assert_file_exists 'sshd hook: validated policy remains after reload failure' \
  "$DESTINATION"
_assert_file_exists 'sshd hook: reload failure records pending activation' \
  "$DESTINATION.reload-pending"

SSHD_RELOAD_STATUS=0
: >"$LOG"
run_sshd_merge >/dev/null 2>&1
_assert_contains 'sshd hook: unchanged pending policy retries reload' \
  'systemctl:reload sshd.service' "$(cat "$LOG")"
_assert_file_missing 'sshd hook: successful retry clears pending activation' \
  "$DESTINATION.reload-pending"

rm -f "$DESTINATION"
ln -s "$TEST_HOME/sshd-symlink-target" "$DESTINATION"
status=0
run_sshd_merge >/dev/null 2>&1 || status=$?
_assert_exit 'sshd hook: symlink destination is rejected' 1 "$status"
_assert_file_missing 'sshd hook: symlink target is never created' \
  "$TEST_HOME/sshd-symlink-target"

_test_summary
