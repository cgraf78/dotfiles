#!/usr/bin/env bash
# tmux-test - always-active tmux configuration coverage.

set -o pipefail
export NO_COLOR=1

# shellcheck source=helpers.sh
. "${BASH_SOURCE[0]%/*}/helpers.sh"

source_home=${DOT_TEST_SOURCE_HOME:-$HOME}
tmux_config=$source_home/.config/tmux/tmux.conf
tmux_base=$source_home/.config/tmux/conf.d/10-base.conf
tmux_content=$(<"$tmux_base")
shdeps_content=$(<"$source_home/.config/shdeps/10-deps.conf")
# shellcheck disable=SC2088 # Match the literal path stored in tmux config.
termnav_hot_path='~/.local/bin/termnav navigate'
move_tab_left=$(printf '%s\n' "$tmux_content" | awk "/^bind-key -n 'M-\\{' / { print }")
move_tab_right=$(printf '%s\n' "$tmux_content" | awk "/^bind-key -n 'M-\\}' / { print }")

echo "=== base tmux policy ==="

# shellcheck disable=SC2016 # Match the literal command substitution in tmux.conf.
_assert_contains "tmux: new panes prefer zsh when available" \
  'shell=$(command -v zsh' "$tmux_content"
_assert_contains "tmux: terminal supports true color" \
  'terminal-overrides' "$tmux_content"
# shellcheck disable=SC2016 # Match the literal HOME reference in the loader.
_assert_contains "tmux: loader reads ordered capability fragments" \
  'source-file -q "$HOME/.config/tmux/conf.d/*.conf"' \
  "$(<"$tmux_config")"
_assert_not_contains "tmux: base fragment excludes editor mouse policy" \
  'set -g mouse on' "$tmux_content"
_assert_not_contains "tmux: base fragment excludes Nvim commands" \
  'nvim' "$tmux_content"
_assert_contains "tmux: escape delay stays bounded" \
  'set -s escape-time 10' "$tmux_content"
_assert_contains "tmux: history is retained generously" \
  'set -g history-limit 100000' "$tmux_content"
_assert_contains "tmux: clipboard popup uses the provider command" \
  'tmux-clip-paste' "$tmux_content"
_assert_contains "tmux: continuum coordination uses the provider command" \
  'tmux-continuum-default-server' "$tmux_content"
_assert_contains "tmux: last-output copy uses the provider command" \
  'tmux-copy-last-output' "$tmux_content"
_assert_contains "tmux: terminal boundary routing uses Termnav" \
  'termnav navigate' "$tmux_content"
_assert_not_contains "tmux: retired relay command stays absent" \
  'termnav-relay' "$tmux_content"
_assert_not_contains "tmux: retired navigation wrapper stays absent" \
  'termnav-navigate' "$tmux_content"

# Every provider command the base fragment binds must come from a base
# dependency: editor and dev hosts layer more deps on top, but a base-only host
# has nothing else to satisfy these keys.
for dependency in tmux cgraf78/cmdblocks cgraf78/tmux-tools cgraf78/termnav \
  laktak/extrakto tmux-plugins/tmux-continuum tmux-plugins/tmux-resurrect \
  tmux-plugins/tpm; do
  if awk -v dependency="$dependency" '$1 == dependency { found=1 }
    END { exit found ? 0 : 1 }' <<<"$shdeps_content"; then
    _pass "tmux: base declares $dependency"
  else
    _fail "tmux: base declares $dependency"
  fi
done
_assert_eq 'tmux: Termnav is a GitHub-owned dependency' github \
  "$(awk '$1 == "cgraf78/termnav" { print $2 }' <<<"$shdeps_content")"
if [[ -n ${DOT_TEST_TERMNAV_ROOT:-} ]]; then
  if [[ -x ${DOT_TEST_TERMNAV_ROOT}/target/release/termnav ]]; then
    _pass 'tmux: candidate termnav is executable'
  else
    _fail 'tmux: candidate termnav is executable'
  fi
fi

_assert_contains 'tmux: focused pane labels use the shared leaf predicate' \
  '@termnav_pane_is_focused_leaf' "$tmux_content"
for hook in client-attached client-focus-in client-focus-out client-detached; do
  _assert_contains "tmux: declares the $hook focus hook" \
    "set-hook -g ${hook}[110]" "$tmux_content"
done
_assert_contains 'tmux: attached clients publish terminal context' \
  'termnav tmux context --tty #{q:client_tty}' "$tmux_content"
_assert_contains 'tmux: control clients are excluded from context publication' \
  '#{==:#{client_control_mode},0}' "$tmux_content"
_assert_not_contains 'tmux: context publication remains ordered' \
  "client-attached[100] 'run-shell -b" "$tmux_content"
_assert_contains 'tmux: focus-in starts the focus watcher' \
  'termnav tmux focus watch' "$tmux_content"
_assert_contains 'tmux: focus-out stops the focus watcher' \
  'termnav tmux focus stop' "$tmux_content"
_assert_contains 'tmux: selection changes repair stale focus state' \
  'termnav tmux focus sync' "$tmux_content"
_assert_contains 'tmux: inactive panes keep the Night Owl background' \
  "set -g @termnav_inactive_style 'bg=#010d17'" "$tmux_content"
_assert_contains 'tmux: active panes keep the Night Owl background' \
  "set -g window-active-style 'bg=#011627'" "$tmux_content"
_assert_not_contains 'tmux: focus rendering does not spawn commands' \
  '#(' "$(printf '%s\n' "$tmux_content" | awk '/termnav_pane_is_focused_leaf|window-active-style|pane-active-border-style|pane-border-format/')"

for binding in \
  'bind -T copy-mode-vi C-c send-keys -X copy-pipe-and-cancel' \
  'bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "clip capture"' \
  "bind -T copy-mode-vi S-Left if -F '#{selection_active}'" \
  "bind -T copy-mode-vi S-Right if -F '#{selection_active}'" \
  "bind -T copy-mode-vi S-Up if -F '#{selection_active}'" \
  "bind -T copy-mode-vi S-Down if -F '#{selection_active}'" \
  "bind -T copy-mode-vi C-S-Left if -F '#{selection_active}'" \
  "bind -T copy-mode-vi C-S-Right if -F '#{selection_active}'"; do
  _assert_contains "tmux: preserves copy-mode binding $binding" \
    "$binding" "$tmux_content"
done
_assert_contains 'tmux: modified copy selections establish an anchor' \
  'send-keys -X begin-selection' "$tmux_content"
_assert_contains 'tmux: publishes copy-mode selections through OSC 52' \
  'set -g set-clipboard on' "$tmux_content"
_assert_contains 'tmux: default copy command records clipboard history' \
  "set -g copy-command 'clip capture'" "$tmux_content"
# shellcheck disable=SC2016 # Match the literal command substitution in config.
_assert_contains 'tmux: clipboard picker uses the isolated handoff path' \
  'clip pick > "$(tmux-clip-paste --path)"' "$tmux_content"
_assert_contains 'tmux: clipboard picker pastes after the popup exits' \
  'run-shell tmux-clip-paste' "$tmux_content"
_assert_not_contains 'tmux: retired manual session exporter stays absent' \
  'tmux-save-session' "$tmux_content"
_assert_not_contains 'tmux: retired manual session restorer stays absent' \
  'tmux-restore-session' "$tmux_content"
_assert_contains 'tmux: reload removes the retired save key' 'unbind S' "$tmux_content"
# shellcheck disable=SC2016 # Match the literal HOME reference in the binding.
_assert_contains 'tmux: prefix R reloads the loader' \
  'bind R source-file "$HOME/.config/tmux/tmux.conf"' "$tmux_content"
_assert_contains 'tmux: extrakto loads only when installed' \
  'test ! -x ~/.local/share/laktak/extrakto/extrakto.tmux ||' "$tmux_content"
_assert_contains 'tmux: extrakto copies record clipboard history' \
  "set -g @extrakto_clip_tool 'clip capture &&" "$tmux_content"

plugins=$(awk '/^[[:space:]]*set -g @plugin / { gsub(/'\''/, "", $4); print $4 }' \
  "$tmux_base")
_assert_eq 'tmux: persistence plugins retain dependency order' \
  $'tmux-plugins/tpm\ntmux-plugins/tmux-resurrect\ntmux-plugins/tmux-continuum' \
  "$plugins"
native_restore_line=$(awk "/set -g @continuum-restore 'off'/ { print NR }" "$tmux_base")
native_interval_line=$(awk "/set -g @continuum-save-interval '0'/ { print NR }" "$tmux_base")
tpm_load_line=$(awk '/exec ~\/\.local\/share\/tmux-plugins\/tpm\/tpm/ { print NR }' "$tmux_base")
default_owner_line=$(awk '/tmux-continuum-default-server/ { print NR }' "$tmux_base" | tail -n 1)
if [[ $native_restore_line -lt $tpm_load_line &&
  $native_interval_line -lt $tpm_load_line &&
  $tpm_load_line -lt $default_owner_line ]]; then
  _pass 'tmux: native persistence ownership is disabled before provider activation'
else
  _fail 'tmux: native persistence ownership is disabled before provider activation'
fi
for policy in \
  "set -g @continuum-restore 'off'" \
  "set -g @continuum-save-interval '0'" \
  "set -g @tmux-tools-continuum-save-interval '5'" \
  "set -g @tmux-tools-resurrect-auto-restore 'off'" \
  "set -g @resurrect-dir '~/.local/share/tmux/resurrect/\$HOSTNAME'" \
  "set -g @resurrect-hook-post-save-layout 'ds resurrect save'" \
  "set -g @resurrect-hook-pre-restore-all 'ds resurrect begin'" \
  "set -g @resurrect-hook-post-restore-all 'ds resurrect restore'"; do
  _assert_contains "tmux: preserves persistence policy $policy" \
    "$policy" "$tmux_content"
done
_assert_not_contains 'tmux: does not restart every foreground process' \
  "set -g @resurrect-processes ':all:'" "$tmux_content"
_assert_not_contains 'tmux: does not persist terminal scrollback by default' \
  "set -g @resurrect-capture-pane-contents 'on'" "$tmux_content"
resurrect_home=$(_tmpdir)
HOME=$resurrect_home bash -c 'umask 000; . "$1"; post' _ \
  "$source_home/.config/shdeps/hooks.d/tmux-plugins/tmux-resurrect.sh"
for directory in \
  "$resurrect_home/.local/share/tmux/resurrect" \
  "$resurrect_home/.local/share/tmux/resurrect/$(hostname)"; do
  mode=$(stat -c '%a' "$directory" 2>/dev/null || stat -f '%Lp' "$directory")
  _assert_eq "tmux: protects resurrect directory $directory" 700 "$mode"
done

_assert_contains 'tmux: defines exact router origin metadata' \
  'navigate_origin_args="--client-pid #{client_pid} --client-tty #{q:client_tty} --client-created #{client_created} --client-termtype #{q:client_termtype} --source-socket #{q:socket_path} --source-pane #{pane_id} --source-session #{q:session_id}"' \
  "$tmux_content"
_assert_eq 'tmux: defines router origin metadata once' 1 \
  "$(awk '/^navigate_origin_args=/ { count++ } END { print count + 0 }' <<<"$tmux_content")"
for direction in left right; do
  _assert_contains "tmux: routes $direction tab movement through Termnav" \
    "$termnav_hot_path tab-move $direction --parent \$navigate_origin_args" \
    "$tmux_content"
done
_assert_not_contains 'tmux: boundary routes stay foreground-ordered' \
  "run-shell -b '$termnav_hot_path" "$tmux_content"
_assert_contains 'tmux: local left tab movement stays native' \
  'swap-window -d -t :-' "$move_tab_left"
_assert_contains 'tmux: local right tab movement stays native' \
  'swap-window -d -t :+' "$move_tab_right"
for retired in termnav-switch-tab wezterm-switch-tab wezterm-move-tab \
  wezterm-select-pane DOT_PARENT_SWITCH_TAB DOT_PARENT_MOVE_TAB \
  DOT_PARENT_SELECT_PANE; do
  _assert_not_contains "tmux: retired route stays absent: $retired" \
    "$retired" "$tmux_content"
done
relay_values=(
  $'\033[777009u'
  $'\033[?2004;0$y'
  $'\033[?2004;1$y'
  $'\033[?2004;2$y'
  $'\033[?2004;3$y'
  $'\033[?2004;4$y'
)
# shellcheck disable=SC2016 # Preserve tmux's literal config escapes.
relay_config_values=(
  '\033[777009u'
  '\033[?2004;0\$y'
  '\033[?2004;1\$y'
  '\033[?2004;2\$y'
  '\033[?2004;3\$y'
  '\033[?2004;4\$y'
)
# shellcheck disable=SC2016 # Preserve tmux's partially escaped display form.
relay_escaped_esc_values=(
  '\033[777009u'
  '\033[?2004;0$y'
  '\033[?2004;1$y'
  '\033[?2004;2$y'
  '\033[?2004;3$y'
  '\033[?2004;4$y'
)
# shellcheck disable=SC2016 # Preserve the legacy literal display values.
relay_legacy_values=(
  '_[777009u'
  '_[?2004;0$y'
  '_[?2004;1$y'
  '_[?2004;2$y'
  '_[?2004;3$y'
  '_[?2004;4$y'
)
for index in "${!relay_values[@]}"; do
  key=$((index + 8))
  expected="set -s user-keys[$key] \"${relay_config_values[index]}\""
  actual=$(awk -v prefix="set -s user-keys[$key] " \
    'index($0, prefix) == 1 { print }' "$tmux_base")
  _assert_eq "tmux: relay user key $key has one exact source definition" \
    "$expected" "$actual"
done
_assert_not_contains 'tmux: retired parent-loopback user keys stay absent' \
  'user-keys[0]' "$tmux_content"

terminal_filter=$(
  cat <<'AWK'
$1 !~ /^[TXZ]/ && $(NF-1) == $NF && ($2 ~ /^(ssh|mosh|mosh-client|mosh-server|et)$/ || (mouse == 1 && $2 ~ /^(tmux|screen):?$/)) { found = 1 }
END { exit !found }
AWK
)
_assert_contains 'tmux: transport fallback retains terminal-process matching' \
  'END { exit !found }' "$terminal_filter"
printf 'S+ bash 39056 39056\nS+ tmux: client 39056 39056\n' |
  awk -v mouse=1 "$terminal_filter"
_assert_exit 'tmux: mouse-aware nested client is routed outward' 0 "$?"
printf 'S+ bash 39056 39056\nS+ tmux: client 39056 39056\n' |
  awk -v mouse=0 "$terminal_filter"
_assert_exit 'tmux: non-mouse nested client stays local' 1 "$?"
printf 'S+ bash 39056 39056\nS ssh 39100 39056\n' |
  awk -v mouse=1 "$terminal_filter"
_assert_exit 'tmux: background transport stays local' 1 "$?"

if command -v tmux >/dev/null 2>&1; then
  socket=$(_tmux_socket) || exit 1
  CLEANUP_DIRS+=("${socket%/*}")
  _tmux_fixture_env "$source_home" || exit 1
  tmux_cmd() {
    "${TMUX_FIXTURE_ENV[@]}" tmux -S "$socket" "$@"
  }
  if tmux_cmd -f /dev/null \
    new-session -d -s dot-tmux-syntax \
    'sleep 60' >/dev/null 2>&1; then
    active_pane=$(tmux_cmd display-message -p '#{pane_id}')
    inactive_pane=$(tmux_cmd split-window -d -P -F '#{pane_id}' 'sleep 60')
    tmux_cmd select-pane -t "$active_pane"
    output=$(tmux_cmd source-file -n \
      "$tmux_config" 2>&1)
    status=$?
    _assert_exit "tmux: base fragment loader parses" 0 "$status"
    _assert_eq "tmux: syntax validation is quiet" '' "$output"
    tmux_cmd bind-key -T prefix S run-shell tmux-save-session
    tmux_cmd bind-key -T prefix R run-shell tmux-restore-session
    tmux_cmd source-file "$tmux_config" >/dev/null 2>&1 || true
    mode_keys=$(tmux_cmd show-window-options -gv mode-keys)
    control_output=$(printf 'detach-client\n' |
      tmux_cmd -C attach-session -t dot-tmux-syntax 2>&1)
    control_status=$?
    control_messages=$(tmux_cmd show-messages)
    root_keys=$(tmux_cmd list-keys -T root)
    prefix_keys=$(tmux_cmd list-keys -T prefix)
    copy_keys=$(tmux_cmd list-keys -T copy-mode-vi)
    client_hook=$(tmux_cmd show-hooks -g client-attached)
    pane_border_format=$(tmux_cmd show-options -gv pane-border-format)
    pane_border_style=$(tmux_cmd show-window-options -gv pane-border-style)
    pane_active_border_style=$(tmux_cmd show-window-options -gv pane-active-border-style)
    active_pane_border=$(tmux_cmd display-message -p -t "$active_pane" "$pane_border_format")
    inactive_pane_border=$(tmux_cmd display-message -p -t "$inactive_pane" "$pane_border_format")
    _assert_eq 'tmux: runtime mode keys remain vi' vi "$mode_keys"
    _assert_contains 'tmux: runtime installs the client context hook' \
      'client-attached[100]' "$client_hook"
    _assert_contains 'tmux: runtime excludes control clients from context publication' \
      '#{==:#{client_control_mode},0}' "$client_hook"
    _assert_exit 'tmux: control client attaches and detaches cleanly' 0 "$control_status"
    _assert_contains 'tmux: control client receives a clean protocol exit' \
      '%exit' "$control_output"
    _assert_not_contains 'tmux: control client does not publish terminal context' \
      'command: run-shell "\~/.local/bin/termnav tmux context' "$control_messages"
    _assert_eq 'tmux: runtime retains conditional pane labels' \
      '#{?#{E:@termnav_pane_is_focused_leaf},,#[fg=#898989]} #{E:@pane_label} ' \
      "$pane_border_format"
    # ds strips host literals from pane-border-format to avoid repeating its
    # session host label, so host comparisons must stay in user options.
    for host_literal in '#{host' '#H'; do
      _assert_not_contains "tmux: pane-border-format avoids ds-rewritten $host_literal" \
        "$host_literal" "$pane_border_format"
    done
    _assert_eq 'tmux: runtime retains dim inactive borders' 'fg=#333333' \
      "$pane_border_style"
    _assert_contains 'tmux: runtime active border remains cyan' \
      'fg=cyan' "$pane_active_border_style"
    _assert_contains 'tmux: runtime active border remains bold' \
      'bold' "$pane_active_border_style"
    _assert_contains 'tmux: runtime unfocused labels remain dim' \
      '#[fg=#898989]' "$active_pane_border"
    _assert_contains 'tmux: runtime inactive labels remain dim' \
      '#[fg=#898989]' "$inactive_pane_border"
    _assert_contains 'tmux: runtime copy mode retains Ctrl-c' \
      'copy-pipe-and-cancel' "$copy_keys"
    copy_command=$(tmux_cmd show-options -gv copy-command)
    _assert_eq 'tmux: runtime default copy command is clip capture' \
      'clip capture' "$copy_command"
    _assert_not_contains 'tmux: runtime removes the stale manual save key' \
      'bind-key -T prefix S ' "$prefix_keys"
    _assert_not_contains 'tmux: runtime replaces the stale manual restore key' \
      'tmux-restore-session' "$prefix_keys"
    _assert_contains 'tmux: runtime prefix R reloads the config' \
      'source-file' "$(printf '%s\n' "$prefix_keys" | awk '$4 == "R"')"
    for key in '"' % c; do
      _assert_contains "tmux: runtime prefix $key keeps the pane directory" \
        '-c "#{pane_current_path}"' \
        "$(printf '%s\n' "$prefix_keys" | awk -v key="$key" '$4 == key || $4 == "\\" key')"
    done
    _assert_contains 'tmux: runtime copy mode v begins a selection' \
      'begin-selection' "$(printf '%s\n' "$copy_keys" | awk '$4 == "v"')"
    _assert_contains 'tmux: runtime copy mode y copies through clip' \
      'copy-pipe-and-cancel "clip capture"' \
      "$(printf '%s\n' "$copy_keys" | awk '$4 == "y"')"
    _assert_contains 'tmux: runtime copy mode C-v keeps rectangle selection' \
      'rectangle-toggle' "$(printf '%s\n' "$copy_keys" | awk '$4 == "C-v"')"
    _assert_contains 'tmux: runtime clipboard picker uses the handoff path' \
      'tmux-clip-paste --path' "$prefix_keys"
    for key in User8 User9 User10 User11 User12 User13; do
      line=$(printf '%s\n' "$root_keys" |
        awk -v key="$key" \
          '$1 == "bind-key" && $2 == "-T" && $3 == "root" && $4 == key')
      _assert_contains "tmux: runtime $key invokes Termnav relay" \
        'termnav relay commit' "$line"
      _assert_contains "tmux: runtime $key quotes the source socket" \
        '--tmux-socket #{q:socket_path}' "$line"
    done
    for index in "${!relay_values[@]}"; do
      key=$((index + 8))
      value=$(tmux_cmd show-options -sv "user-keys[$key]")
      # tmux releases render server strings as raw bytes, config-escaped text,
      # or a legacy underscore for ESC. Accept only the complete known form
      # for this exact key; the source assertion above prevents an ambiguous
      # legacy display from hiding a literal underscore in configuration.
      case $value in
        "${relay_values[index]}" | "${relay_config_values[index]}" | \
          "${relay_escaped_esc_values[index]}" | \
          "${relay_legacy_values[index]}") value=${relay_values[index]} ;;
      esac
      _assert_eq "tmux: runtime user key $key keeps its exact sequence" \
        "${relay_values[index]}" "$value"
    done
    for direction in left right; do
      line=$(printf '%s\n' "$root_keys" |
        awk -v key="M-${direction/left/\{}" 'BEGIN { if (key == "M-right") key="M-}" } index($0, "\"" key "\"") { print }')
      _assert_contains "tmux: runtime $direction tab move uses Termnav at the edge" \
        "termnav navigate tab-move $direction --parent" "$line"
      _assert_contains "tmux: runtime $direction tab move preserves client identity" \
        '--client-pid #{client_pid}' "$line"
      for metadata in \
        '--client-tty #{q:client_tty}' \
        '--client-created #{client_created}' \
        '--source-socket #{q:socket_path}' \
        '--source-pane #{pane_id}' \
        '--source-session #{q:session_id}'; do
        _assert_contains "tmux: runtime $direction tab move keeps ${metadata%% *}" \
          "$metadata" "$line"
      done
    done
    for retired_key in User0 User1 User2 User3 User4 User5 User6 User7; do
      _assert_not_contains "tmux: runtime removes retired key $retired_key" \
        "bind-key -T root $retired_key " "$root_keys"
    done

    # Window names and pane labels derive from what each pane runs. Fake apps
    # are symlinks to bash, so pane_current_command reports the link name.
    # bash ignores its invocation name, unlike multi-call sleep binaries
    # (busybox, coreutils) whose process reports the wrong name, and the
    # trailing no-op keeps it from exec-ing sleep in its place;
    # the launcher enables mouse reporting (the interactive-app signal) and
    # optionally sets an app-chosen title before exec.
    labels_dir=$(_tmpdir)
    mkdir -p "$labels_dir/bin" "$labels_dir/proj-a" "$labels_dir/proj-d" \
      "$labels_dir/proj-z" "$labels_dir/h/sub" "$labels_dir/hx"
    for app_name in agentx ssh zsh; do
      ln -s "$(command -v bash)" "$labels_dir/bin/$app_name"
    done
    cat >"$labels_dir/app" <<'SH'
#!/bin/sh
printf '\033[?1000h'
[ -n "${2-}" ] && printf '\033]2;%s\033\\' "$2"
exec "${0%/*}/bin/$1" -c 'sleep 60; :'
SH
    # A plain shell pane: the same fake command without mouse reporting.
    cat >"$labels_dir/shell" <<'SH'
#!/bin/sh
exec "${0%/*}/bin/zsh" -c 'sleep 60; :'
SH
    chmod +x "$labels_dir/app" "$labels_dir/shell"
    app="$labels_dir/app"
    shell="$labels_dir/shell"
    fixture_home=$(tmux_cmd show-environment -g HOME)
    fixture_home=${fixture_home#HOME=}
    host_short=$(tmux_cmd display-message -p '#{host_short}')
    long_title=a-very-long-remote-host-name

    # wait_command PANE COMMAND [MOUSE] polls until the pane's foreground
    # command (and optionally its mouse flag) settles, so assertions never
    # race the launcher's exec.
    wait_command() {
      local pane=$1 expected=$2 mouse=${3:-} state=''
      for _ in $(seq 1 50); do
        state=$(tmux_cmd display-message -p -t "$pane" \
          '#{pane_current_command} #{mouse_any_flag}' 2>/dev/null)
        if [[ ${state% *} == "$expected" && (-z $mouse || ${state##* } == "$mouse") ]]; then
          return 0
        fi
        sleep 0.1
      done
      _fail "tmux: pane $pane reached '$expected' (last state: '$state')"
      return 1
    }
    # Labels use UTF-8 separators and ellipses. -u renders them even where the
    # test runs without a UTF-8 locale, as some CI images do.
    window_name() {
      tmux_cmd -u display-message -p -t "$1" '#{E:automatic-rename-format}'
    }
    pane_label() {
      tmux_cmd -u display-message -p -t "$1" '#{E:@pane_label}'
    }

    # Shells and short-lived commands never name a window: it falls back to
    # the active pane's directory.
    plain_window=$(tmux_cmd new-window -d -P -F '#{window_id}' \
      -c "$labels_dir/proj-a" "$shell")
    wait_command "$plain_window" zsh 0
    _assert_eq 'tmux: shell-only window is named after its directory' \
      proj-a "$(window_name "$plain_window")"

    # An interactive app names the window even while a shell pane has focus.
    agent_window=$(tmux_cmd new-window -d -P -F '#{window_id}' \
      -c "$fixture_home" "$app agentx 'fix the bug'")
    agent_pane=$(tmux_cmd display-message -p -t "$agent_window" '#{pane_id}')
    shell_pane=$(tmux_cmd split-window -d -P -F '#{pane_id}' -t "$agent_pane" \
      -c "$fixture_home" "$shell")
    tmux_cmd select-pane -t "$shell_pane"
    wait_command "$agent_pane" agentx 1
    wait_command "$shell_pane" zsh 0
    _assert_eq 'tmux: interactive app names its window regardless of focus' \
      agentx "$(window_name "$agent_window")"
    _assert_eq 'tmux: interactive pane label shows the app title' \
      'agentx · fix the bug' "$(pane_label "$agent_pane")"
    _assert_eq 'tmux: shell pane label shows a home-relative directory' \
      'zsh · ~' "$(pane_label "$shell_pane")"

    # Wrapper processes use the app's own title, unless that title is just
    # tmux's hostname default. Several apps are listed in pane order.
    wrapped_window=$(tmux_cmd new-window -d -P -F '#{window_id}' \
      "$app ssh remote:ds")
    wrapped_pane=$(tmux_cmd display-message -p -t "$wrapped_window" '#{pane_id}')
    default_pane=$(tmux_cmd split-window -d -P -F '#{pane_id}' -t "$wrapped_pane" \
      "$app ssh '$host_short'")
    wait_command "$wrapped_pane" ssh 1
    wait_command "$default_pane" ssh 1
    _assert_eq 'tmux: wrapped apps are named by title, else by command' \
      'remote:ds ssh' "$(window_name "$wrapped_window")"
    _assert_eq 'tmux: wrapped pane label is the app title alone' \
      remote:ds "$(pane_label "$wrapped_pane")"
    _assert_eq 'tmux: wrapped pane with a default title shows its command' \
      ssh "$(pane_label "$default_pane")"

    # Long names are capped so one window cannot crowd the tab bar, and a
    # title that only echoes the pane directory is not repeated.
    long_window=$(tmux_cmd new-window -d -P -F '#{window_id}' \
      "$app ssh $long_title")
    echo_pane=$(tmux_cmd split-window -d -P -F '#{pane_id}' -t "$long_window" \
      -c "$labels_dir/proj-d" "$app agentx proj-d")
    wait_command "$long_window" ssh 1
    wait_command "$echo_pane" agentx 1
    _assert_eq 'tmux: long window names are truncated with an ellipsis' \
      'a-very-long-remote-h…' "$(window_name "$long_window")"
    _assert_eq 'tmux: a title echoing the directory is not repeated' \
      agentx "$(pane_label "$echo_pane")"

    # A title is untrusted text: style directives must render literally rather
    # than restyle the tab bar or border.
    hostile_window=$(tmux_cmd new-window -d -P -F '#{window_id}' \
      "$app ssh '#[fg=red]evil'")
    wait_command "$hostile_window" ssh 1
    _assert_eq 'tmux: window names escape title style directives' \
      '##[fg=red]evil' "$(window_name "$hostile_window")"
    _assert_eq 'tmux: pane labels escape title style directives' \
      '##[fg=red]evil' "$(pane_label "$hostile_window")"

    # Shell widgets such as fzf history search enable mouse reporting while the
    # shell stays in the foreground; that must not rename the tab.
    widget_window=$(tmux_cmd new-window -d -P -F '#{window_id}' \
      -c "$labels_dir/proj-z" "$app zsh")
    wait_command "$widget_window" zsh 1
    _assert_eq 'tmux: a mouse-reporting shell does not name its window' \
      proj-z "$(window_name "$widget_window")"
    _assert_eq 'tmux: a mouse-reporting shell keeps a directory label' \
      "zsh · $labels_dir/proj-z" "$(pane_label "$widget_window")"

    # Home abbreviation compares whole path components, and falls back to the
    # plain path when the server has no HOME.
    tmux_cmd set-environment -g HOME "$labels_dir/h"
    for case in "h:~" "h/sub:~/sub" "hx:$labels_dir/hx"; do
      home_pane=$(tmux_cmd new-window -d -P -F '#{pane_id}' \
        -c "$labels_dir/${case%%:*}" "$shell")
      wait_command "$home_pane" zsh 0
      _assert_eq "tmux: home abbreviation for ${case%%:*}" \
        "${case#*:}" "$(tmux_cmd -u display-message -p -t "$home_pane" '#{E:@pane_dir}')"
    done
    tmux_cmd set-environment -gu HOME
    _assert_eq 'tmux: no HOME leaves directories unabbreviated' \
      "$labels_dir/hx" \
      "$(tmux_cmd -u display-message -p -t "$home_pane" '#{E:@pane_dir}')"
    tmux_cmd set-environment -g HOME "$fixture_home"

    # Tab badges reflect zoom and copy mode for the window's active pane.
    current_format=$(tmux_cmd show-window-options -gv window-status-current-format)
    tmux_cmd resize-pane -Z -t "$shell_pane"
    tmux_cmd copy-mode -t "$shell_pane"
    _assert_contains 'tmux: current tab shows zoom' '[Z]' \
      "$(tmux_cmd -u display-message -p -t "$shell_pane" "$current_format")"
    _assert_contains 'tmux: current tab shows copy mode' '[COPY]' \
      "$(tmux_cmd -u display-message -p -t "$shell_pane" "$current_format")"
    tmux_cmd send-keys -t "$shell_pane" -X cancel
    tmux_cmd clock-mode -t "$shell_pane"
    _assert_not_contains 'tmux: other pane modes are not labelled as copy mode' \
      '[COPY]' "$(tmux_cmd -u display-message -p -t "$shell_pane" "$current_format")"
    tmux_cmd send-keys -t "$shell_pane" q
    tmux_cmd resize-pane -Z -t "$shell_pane"
    _assert_not_contains 'tmux: tab badges clear with their modes' '[' \
      "$(tmux_cmd -u display-message -p -t "$shell_pane" "$current_format")"
    _assert_eq 'tmux: windows rename automatically' on \
      "$(tmux_cmd show-window-options -gv automatic-rename)"
    _assert_eq 'tmux: nested tmux titles its parent pane with host:session' \
      '#{?@hostname_alias,#{@hostname_alias},#{host_short}}:#S' \
      "$(tmux_cmd show-options -gv set-titles-string)"

    # Attach a second configured server's client from inside a pane of the
    # first, the way `ssh host` from a tmux pane nests tmux. The nested client
    # must still negotiate extended keys, or the outer tmux collapses Ctrl-Shift
    # chords to their plain Ctrl form before the nested pane sees them.
    nested_socket=$(_tmux_socket) || exit 1
    CLEANUP_DIRS+=("${nested_socket%/*}")
    nested_cmd() {
      "${TMUX_FIXTURE_ENV[@]}" tmux -S "$nested_socket" "$@"
    }
    if nested_cmd -f /dev/null new-session -d -s dot-tmux-nested \
      'sleep 60' >/dev/null 2>&1; then
      nested_cmd source-file "$tmux_config" >/dev/null 2>&1 || true
      tmux_cmd new-window -d -t dot-tmux-syntax \
        "env TERM=tmux-256color tmux -S '$nested_socket' attach-session -t dot-tmux-nested"
      nested_client=''
      for _ in $(seq 1 40); do
        nested_client=$(nested_cmd list-clients \
          -F '#{client_termname} #{client_termfeatures}' 2>/dev/null)
        [[ -n $nested_client ]] && break
        sleep 0.1
      done
      _assert_contains 'tmux: nested client attaches with a tmux terminal' \
        'tmux-256color ' "$nested_client"
      _assert_contains 'tmux: nested client negotiates extended keys' \
        'extkeys' "$nested_client"
      nested_cmd kill-server >/dev/null 2>&1 || true
    else
      _fail "tmux: nested test server starts"
    fi
    tmux_cmd kill-server >/dev/null 2>&1 || true
  else
    _fail "tmux: test server starts"
  fi
else
  _pass "tmux: binary unavailable, syntax smoke skipped"
fi

if command -v tmux >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
  # The PTY driver starts its own private servers from the same fixture
  # environment, so their hooks and panes stay off live state too.
  _tmux_fixture_env "$source_home" || exit 1
  if pty_output=$("${TMUX_FIXTURE_ENV[@]}" python3 \
    "${BASH_SOURCE[0]%/*}/support/tmux-focus-style.py" \
    --config "$tmux_config" 2>&1); then
    pty_status=0
  else
    pty_status=$?
  fi
  printf '%s\n' "$pty_output"
  _assert_exit "tmux: base PTY focus/style coverage passes" 0 "$pty_status"
  for pty_case in \
    test_focus_hooks_are_client_scoped_and_ignore_control_mode \
    test_styles_follow_each_client_and_child_claim \
    test_terminal_render_paints_the_focused_leaf_night_owl_blue; do
    _assert_contains "tmux: PTY runs $pty_case" "$pty_case" "$pty_output"
  done
else
  _pass "tmux: Python or tmux unavailable, PTY coverage skipped"
fi

_test_summary
