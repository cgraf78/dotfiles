done
_assert_not_contains "tmux boundary routing does not launch unordered background jobs" \
  "run-shell -b '$termnav_hot_path" "$tmux_content"
_assert_contains "tmux Ctrl-Tab keeps multi-window selection native" \
  "#{>:#{session_windows},1}" "$ctrl_tab_config_line"
_assert_contains "tmux Ctrl-Shift-Tab keeps multi-window selection native" \
  "#{>:#{session_windows},1}" "$ctrl_shift_tab_config_line"
_assert_contains "tmux Ctrl-Tab forwards direct nvim/fzf panes" \
  "\"\$send_ctrl_tab\"" "$ctrl_tab_config_line"
_assert_contains "tmux Ctrl-Shift-Tab forwards direct nvim/fzf panes" \
  "\"\$send_ctrl_shift_tab\"" "$ctrl_shift_tab_config_line"
