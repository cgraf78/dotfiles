# Every tracked file, so no directory can drop out of the scan: a worktree
# or clone has .git, an installed home the separate .dotfiles repository.
tmux_tracked() {
  if [[ -e $source_home/.git || -L $source_home/.git ]]; then
    git -C "$source_home" ls-files -z
  else
    git --git-dir="$source_home/.dotfiles" --work-tree="$source_home" ls-files -z
  fi
}
if [[ ! -e $source_home/.git && ! -L $source_home/.git && ! -d $source_home/.dotfiles ]]; then
  # CI always has a checkout, so the scan can never be skipped there.
  if [[ -n ${GITHUB_ACTIONS:-} ]]; then
    _fail 'tmux: the old-mention scan needs a Git checkout under GitHub Actions'
  else
    _pass 'tmux: not a Git checkout, old-mention scan skipped'
  fi
else
  tmux_tracked_list=$(_tmpfile)
  tmux_tracked_lines=$(_tmpfile)
  # Search a finished file, not a `tr | grep -q` pipe: grep -q exits at the
  # first match, and under pipefail a tr still writing then dies of SIGPIPE
  # and fails the check even though the file is listed.
  if ! tmux_tracked >"$tmux_tracked_list"; then
    _fail 'tmux: git ls-files lists the files to scan'
  elif ! tr '\0' '\n' <"$tmux_tracked_list" >"$tmux_tracked_lines" ||
    ! grep -qx '\.config/tmux/tmux\.conf' "$tmux_tracked_lines"; then
    _fail 'tmux: git ls-files lists .config/tmux/tmux.conf'
  else
    tmux_offenders=''
    while IFS= read -r -d '' relative; do
      # This file's allowlist and scan cases spell out what the scan rejects.
      [[ $relative == .local/lib/dotfiles/tests/tmux-test ]] && continue
      path=$source_home/$relative
      # Deletions show until staged; binary files are not text.
      if [[ ! -f $path ]] || ! LC_ALL=C grep -Iq . "$path"; then continue; fi
      while IFS= read -r mention; do
        [[ -n $mention ]] || continue
        allowed=false
        for entry in "${tmux_mention_allowed[@]}"; do
          [[ $relative == "${entry%%:*}" && $mention == *"${entry#*:}"* ]] && allowed=true
        done
        $allowed || tmux_offenders+="$relative: $mention"$'\n'
      done < <(tmux_old_mentions "$path")
    done <"$tmux_tracked_list"
    _assert_eq 'tmux: nothing names a tmux older than the floor' '' "$tmux_offenders"
  fi
fi

