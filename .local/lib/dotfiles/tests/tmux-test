#!/usr/bin/env bash
# tmux-test - dotfiles tmux config and termnav wrapper integration.

set -o pipefail
export NO_COLOR=1

# shellcheck source=helpers.sh
. "${BASH_SOURCE[0]%/*}/helpers.sh"

tmux_config="$HOME/.config/tmux/tmux.conf"
tmux_content=$(cat "$tmux_config")
shdeps_content=$(cat "$HOME/.config/shdeps/10-deps.conf")
# shellcheck disable=SC2016 # testing literal command substitution config.
_assert_contains "tmux prefers zsh for newly restored panes" \
  'shell=$(command -v zsh' "$tmux_content"
# shellcheck disable=SC2088 # tmux expands this literal path in its own shell.
tmux_follow_installed_path='~/.local/bin/tmux-follow-click'
tmux_tool_home="${DOT_TEST_HOST_HOME:-$HOME}"
wezterm_select_pane_executable="${DOT_TEST_TERMNAV_ROOT:+$DOT_TEST_TERMNAV_ROOT/bin/wezterm-select-pane}"
wezterm_select_pane_executable="${wezterm_select_pane_executable:-$tmux_tool_home/.local/bin/wezterm-select-pane}"
# shellcheck disable=SC2088 # tmux expands this literal path in its own shell.
wezterm_switch_tab_path='~/.local/bin/wezterm-switch-tab'
# shellcheck disable=SC2088 # tmux expands this literal path in its own shell.
wezterm_move_tab_path='~/.local/bin/wezterm-move-tab'
# shellcheck disable=SC2088 # tmux expands this literal path in its own shell.
wezterm_select_pane_path='~/.local/bin/wezterm-select-pane'
# shellcheck disable=SC2088 # tmux expands this literal path in its own shell.
termnav_switch_tab_path='~/.local/bin/termnav-switch-tab'
ctrl_tab_config_line=$(printf '%s\n' "$tmux_content" | grep '^bind-key -n C-Tab ' || true)
ctrl_shift_tab_config_line=$(printf '%s\n' "$tmux_content" | grep '^bind-key -n C-BTab ' || true)
move_tab_left_config_line=$(printf '%s\n' "$tmux_content" | grep "^bind-key -n 'M-{' " || true)
move_tab_right_config_line=$(printf '%s\n' "$tmux_content" | grep "^bind-key -n 'M-}' " || true)
vim_navigation_bindings=$(
  printf '%s\n' "$tmux_content" |
    grep -E "^bind-key -n 'C-[hjkl]' " || true
)
foreground_app_detectors=$(
  printf '%s\n' "$tmux_content" |
    grep -E '^is_(vim(_native)?|terminal_app(_native)?|pane_navigation(_native)?)=' || true
)
terminal_app_detector_line=$(printf '%s\n' "$tmux_content" | grep '^is_terminal_app=' || true)
pane_navigation_detector_line=$(printf '%s\n' "$tmux_content" | grep '^is_pane_navigation=' || true)

_assert_executable() {
  local desc="$1" path="$2"
  if [[ -x "$path" ]]; then
    _pass "$desc"
  else
    _fail "$desc (not executable: $path)"
  fi
}

echo "=== tmux config syntax ==="

if command -v tmux >/dev/null 2>&1; then
  syntax_socket_dir=$(_tmpdir)
  syntax_socket="$syntax_socket_dir/tmux.sock"
  tmux -S "$syntax_socket" -f /dev/null new-session -d -s dot-tmux-syntax 'sleep 60'
  syntax_out=$(tmux -S "$syntax_socket" source-file -n "$tmux_config" 2>&1)
  syntax_rc=$?
  native_vim_match=$(tmux -S "$syntax_socket" display-message -p \
    '#{m/r:^g?(view|l?n?vim?x?|fzf)(diff)?$,nvim}')
  native_fzf_match=$(tmux -S "$syntax_socket" display-message -p \
    '#{m/r:^g?(view|l?n?vim?x?|fzf)(diff)?$,fzf}')
  native_shell_match=$(tmux -S "$syntax_socket" display-message -p \
    '#{m/r:^g?(view|l?n?vim?x?|fzf)(diff)?$,bash}')
  native_ssh_match=$(tmux -S "$syntax_socket" display-message -p \
    '#{m/r:^(ssh|mosh|mosh-client|mosh-server|et)$,ssh}')
  native_et_match=$(tmux -S "$syntax_socket" display-message -p \
    '#{m/r:^(ssh|mosh|mosh-client|mosh-server|et)$,et}')
  native_background_ssh_match=$(tmux -S "$syntax_socket" display-message -p \
    '#{m/r:^(ssh|mosh|mosh-client|mosh-server|et)$,bash}')
  native_nested_mouse_match=$(tmux -S "$syntax_socket" display-message -p \
    '#{||:0,#{&&:1,#{m/r:^(tmux|screen)(:.*)?$,tmux: client}}}')
  tmux -S "$syntax_socket" kill-server
  _assert_exit "tmux config dry-run parses" 0 "$syntax_rc"
  _assert_eq "tmux config dry-run is quiet" "" "$syntax_out"
  _assert_eq "tmux native detector matches nvim" "1" "$native_vim_match"
  _assert_eq "tmux native detector matches fzf" "1" "$native_fzf_match"
  _assert_eq "tmux native detector leaves shells at the tmux layer" "0" "$native_shell_match"
  _assert_eq "tmux native detector matches foreground ssh" "1" "$native_ssh_match"
  _assert_eq "tmux native detector matches foreground ET" "1" "$native_et_match"
  _assert_eq "tmux native detector ignores background ssh after shell resumes" \
    "0" "$native_background_ssh_match"
  _assert_eq "tmux native detector matches mouse-aware nested clients" \
    "1" "$native_nested_mouse_match"
else
  echo "  - skipping tmux syntax checks (tmux not installed)"
fi

echo
echo "=== tmux config integration ==="

_assert_contains "tmux uses vi keys in copy mode" \
  "set -g mode-keys vi" "$tmux_content"
_assert_contains "tmux keeps Escape responsive" \
  "set -s escape-time 10" "$tmux_content"
_assert_contains "tmux brightens only inactive pane labels and exposes both targets" \
  "set -g pane-border-format '#{?pane_active,,#[fg=#898989]} #I.#P (#{pane_id})  #{pane_current_command} '" \
  "$tmux_content"
_assert_contains "tmux inactive pane rules stay visually subordinate" \
  "setw -g pane-border-style 'fg=#333333'" \
  "$tmux_content"
_assert_contains "tmux active pane labels retain the active style" \
  "setw -g pane-active-border-style 'fg=cyan,bold'" \
  "$tmux_content"
_assert_contains "tmux advertises OSC-8 hyperlinks and extended keys" \
  "xterm-256color:extkeys:hyperlinks" "$tmux_content"
_assert_contains "tmux forwards Ctrl-click into mouse-aware panes" \
  "bind-key -n C-MouseDown1Pane if-shell -F '#{mouse_any_flag}' 'send-keys -M'" "$tmux_content"
_assert_contains "tmux routes terminal Ctrl-click through installed helper" \
  "$tmux_follow_installed_path --stdin" "$tmux_content"
_assert_contains "tmux passes OSC-8 hyperlink targets to helper" \
  "#{mouse_hyperlink}" "$tmux_content"
_assert_contains "tmux passes pane cwd to helper" \
  "#{pane_current_path}" "$tmux_content"
_assert_contains "tmux passes client tty for browser URLs" \
  "#{client_tty}" "$tmux_content"
_assert_executable "tmux clip paste command is installed" \
  "$tmux_tool_home/.local/bin/tmux-clip-paste"
_assert_executable "tmux WezTerm tab switch helper is installed" \
  "$tmux_tool_home/.local/bin/wezterm-switch-tab"
_assert_executable "tmux WezTerm tab move helper is installed" \
  "$tmux_tool_home/.local/bin/wezterm-move-tab"
_assert_executable "tmux WezTerm pane selection helper is installed" \
  "$wezterm_select_pane_executable"
_assert_contains "tmux Ctrl-c copies and exits copy mode" \
  "bind -T copy-mode-vi C-c send-keys -X copy-pipe-and-cancel" "$tmux_content"
_assert_contains "tmux Ctrl-c records history without requiring a host clipboard" \
  'copy-pipe-and-cancel "clip capture"' "$tmux_content"
_assert_contains "tmux Enter records history through the Ctrl-c copy path" \
  'bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "clip capture"' "$tmux_content"
_assert_contains "tmux Shift-Left extends copy-mode selections by a character" \
  "bind -T copy-mode-vi S-Left if -F '#{selection_active}' 'send-keys -X cursor-left'" "$tmux_content"
_assert_contains "tmux Shift-Right extends copy-mode selections by a character" \
  "bind -T copy-mode-vi S-Right if -F '#{selection_active}' 'send-keys -X cursor-right'" "$tmux_content"
_assert_contains "tmux Shift-Up extends copy-mode selections by a line" \
  "bind -T copy-mode-vi S-Up if -F '#{selection_active}' 'send-keys -X cursor-up'" "$tmux_content"
_assert_contains "tmux Shift-Down extends copy-mode selections by a line" \
  "bind -T copy-mode-vi S-Down if -F '#{selection_active}' 'send-keys -X cursor-down'" "$tmux_content"
_assert_contains "tmux Ctrl-Shift-Left extends copy-mode selections by a word" \
  "bind -T copy-mode-vi C-S-Left if -F '#{selection_active}' 'send-keys -X previous-word'" "$tmux_content"
_assert_contains "tmux Ctrl-Shift-Right extends copy-mode selections by a word" \
  "bind -T copy-mode-vi C-S-Right if -F '#{selection_active}' 'send-keys -X next-word-end'" "$tmux_content"
_assert_contains "tmux modified-arrow bindings anchor new selections" \
  "send-keys -X begin-selection" "$tmux_content"
_assert_contains "tmux publishes copy-mode selections through OSC 52" \
  "set -g set-clipboard on" "$tmux_content"
_assert_contains "tmux Ctrl-v reads local clipboard policy through clip" \
  "clip paste" "$tmux_content"
_assert_contains "tmux Ctrl-v paste path pastes literally" \
  "tmux paste-buffer -p" "$tmux_content"
_assert_not_contains "tmux retires the unused manual session exporter" \
  "tmux-save-session" "$tmux_content"
_assert_not_contains "tmux retires the unused manual session restorer" \
  "tmux-restore-session" "$tmux_content"
_assert_contains "tmux reload removes the retired manual save binding" \
  "unbind S" "$tmux_content"
_assert_contains "tmux reload removes the retired manual restore binding" \
  "unbind R" "$tmux_content"
_assert_eq "tmux plugin manager is installed as a repo dependency" \
  "github:repo" \
  "$(awk '$1 == "tmux-plugins/tpm" { print $2 }' <<<"$shdeps_content")"
_assert_eq "tmux resurrect is installed as a repo dependency" \
  "github:repo" \
  "$(awk '$1 == "tmux-plugins/tmux-resurrect" { print $2 }' <<<"$shdeps_content")"
_assert_eq "tmux continuum is installed as a repo dependency" \
  "github:repo" \
  "$(awk '$1 == "tmux-plugins/tmux-continuum" { print $2 }' <<<"$shdeps_content")"
_assert_contains "tmux points TPM at shdeps-owned plugin checkouts" \
  "set-environment -g TMUX_PLUGIN_MANAGER_PATH '~/.local/share/tmux-plugins/'" \
  "$tmux_content"
tmux_plugins=$(
  awk '/^[[:space:]]*set -g @plugin / { gsub(/'\''/, "", $4); print $4 }' \
    "$tmux_config"
)
_assert_eq "tmux loads persistence plugins in dependency order" \
  $'tmux-plugins/tpm\ntmux-plugins/tmux-resurrect\ntmux-plugins/tmux-continuum' \
  "$tmux_plugins"
_assert_contains "tmux disables continuum restore before plugin loading" \
  "set -g @continuum-restore 'off'" "$tmux_content"
_assert_contains "tmux leaves isolated-server continuum saving inert" \
  "set -g @continuum-save-interval '0'" "$tmux_content"
_assert_contains "tmux gives the default server a five-minute interval" \
  "set -g @tmux-tools-continuum-save-interval '5'" "$tmux_content"
_assert_contains "tmux resets default restore ownership before plugin loading" \
  "set -g @tmux-tools-resurrect-auto-restore 'off'" "$tmux_content"
_assert_contains "tmux keeps resurrect snapshots separate per host" \
  "set -g @resurrect-dir '~/.local/share/tmux/resurrect/\$HOSTNAME'" \
  "$tmux_content"
# shellcheck disable=SC2016 # testing literal tmux config text.
_assert_contains "tmux protects snapshots whenever the server config loads" \
  'chmod 0700 "$base" "$host"' "$tmux_content"
_assert_contains "tmux saves ds identity in each resurrect snapshot" \
  "set -g @resurrect-hook-post-save-layout 'ds resurrect save'" \
  "$tmux_content"
_assert_contains "tmux marks ds restoration before rebuilding panes" \
  "set -g @resurrect-hook-pre-restore-all 'ds resurrect begin'" \
  "$tmux_content"
_assert_contains "tmux restores ds identity after the environment is complete" \
  "set -g @resurrect-hook-post-restore-all 'ds resurrect restore'" \
  "$tmux_content"
_assert_contains "tmux loads TPM after all plugin options" \
  "exec ~/.local/share/tmux-plugins/tpm/tpm" "$tmux_content"
_assert_contains "tmux repairs continuum only for the default server" \
  "run-shell '~/.local/bin/tmux-continuum-default-server'" "$tmux_content"
native_restore_line=$(grep -n "set -g @continuum-restore 'off'" "$tmux_config" |
  cut -d: -f1)
native_interval_line=$(grep -n "set -g @continuum-save-interval '0'" "$tmux_config" |
  cut -d: -f1)
tpm_load_line=$(grep -n 'exec ~/.local/share/tmux-plugins/tpm/tpm' "$tmux_config" |
  cut -d: -f1)
default_owner_line=$(grep -n "run-shell '~/.local/bin/tmux-continuum-default-server'" \
  "$tmux_config" | cut -d: -f1)
if [[ "$native_restore_line" -lt "$tpm_load_line" &&
  "$native_interval_line" -lt "$tpm_load_line" &&
  "$tpm_load_line" -lt "$default_owner_line" ]]; then
  _pass "tmux disables native ownership before assigning the default server"
else
  _fail "tmux disables native ownership before assigning the default server"
fi
_assert_not_contains "tmux does not restart every foreground process" \
  "set -g @resurrect-processes ':all:'" "$tmux_content"
_assert_not_contains "tmux does not persist terminal scrollback by default" \
  "set -g @resurrect-capture-pane-contents 'on'" "$tmux_content"
resurrect_hook="$HOME/.config/shdeps/hooks.d/tmux-plugins/tmux-resurrect.sh"
resurrect_test_home=$(_tmpdir)
HOME="$resurrect_test_home" bash -c 'umask 000; . "$1"; post' _ "$resurrect_hook"
resurrect_base="$resurrect_test_home/.local/share/tmux/resurrect"
resurrect_host="$resurrect_base/$(hostname)"
resurrect_base_mode=$(stat -c '%a' "$resurrect_base" 2>/dev/null ||
  stat -f '%Lp' "$resurrect_base" 2>/dev/null || true)
resurrect_host_mode=$(stat -c '%a' "$resurrect_host" 2>/dev/null ||
  stat -f '%Lp' "$resurrect_host" 2>/dev/null || true)
_assert_eq "tmux protects the resurrect state root" "700" "$resurrect_base_mode"
_assert_eq "tmux protects each host resurrect snapshot" "700" "$resurrect_host_mode"
# shellcheck disable=SC2016 # testing literal tmux config text.
_assert_contains "tmux clipboard history uses tmux-tools handoff path" \
  'clip pick > "$(tmux-clip-paste --path)"' "$tmux_content"
_assert_contains "tmux clipboard history pastes after picker exits" \
  "run-shell tmux-clip-paste" "$tmux_content"
# Termnav owns the helpers' protocol encoding and tests it in its own suite.
# Dotfiles needs only to prove that the configured commands are installed and
# that tmux invokes them with the local routing policy asserted below.
_assert_contains "tmux defines private parent-bubble key for next tab" \
  'set -s user-keys[0] "\033[777001u"' "$tmux_content"
_assert_contains "tmux defines private parent-bubble key for previous tab" \
  'set -s user-keys[1] "\033[777002u"' "$tmux_content"
_assert_contains "tmux defines private parent-bubble key for moving left" \
  'set -s user-keys[2] "\033[777003u"' "$tmux_content"
_assert_contains "tmux defines private parent-bubble key for moving right" \
  'set -s user-keys[3] "\033[777004u"' "$tmux_content"
_assert_contains "tmux defines private parent-pane key for left" \
  'set -s user-keys[4] "\033[777005u"' "$tmux_content"
_assert_contains "tmux defines private parent-pane key for down" \
  'set -s user-keys[5] "\033[777006u"' "$tmux_content"
_assert_contains "tmux defines private parent-pane key for up" \
  'set -s user-keys[6] "\033[777007u"' "$tmux_content"
_assert_contains "tmux defines private parent-pane key for right" \
  'set -s user-keys[7] "\033[777008u"' "$tmux_content"
_assert_contains "tmux detects when its client is another tmux" \
  "is_nested_tmux_client=" "$tmux_content"
_assert_contains "tmux Ctrl-Tab checks session window count before switching" \
  "#{>:#{session_windows},1}" "$tmux_content"
_assert_contains "tmux Ctrl-Tab forwards direct nvim/fzf panes via CSI-u helper" \
  "\"\$send_ctrl_tab\"" "$ctrl_tab_config_line"
_assert_contains "tmux Ctrl-Shift-Tab forwards direct nvim/fzf panes via CSI-u helper" \
  "\"\$send_ctrl_shift_tab\"" "$ctrl_shift_tab_config_line"
_assert_contains "tmux detects remote transports as terminal app-owned" \
  "ssh|mosh|mosh-client|mosh-server|et" "$terminal_app_detector_line"
_assert_contains "tmux foreground app detector uses native pane command metadata" \
  "#{pane_current_command}" "$foreground_app_detectors"
_assert_contains "tmux foreground app detector retains pipeline fallback" \
  "pgid= -o tpgid=" "$foreground_app_detectors"
_assert_contains "tmux Ctrl-Tab evaluates foreground routing as a format" \
  "bind-key -n C-Tab if-shell -F" "$ctrl_tab_config_line"
_assert_contains "tmux Ctrl-Shift-Tab evaluates foreground routing as a format" \
  "bind-key -n C-BTab if-shell -F" "$ctrl_shift_tab_config_line"
_assert_eq "tmux vim navigation evaluates all four routes as formats" \
  "4" "$(grep -c 'if-shell -F' <<<"$vim_navigation_bindings")"
# shellcheck disable=SC2016 # tmux expands this detector name, not the test shell.
_assert_eq "tmux pane navigation uses one shared focus classifier" \
  "4" "$(grep -c '\$is_pane_navigation' <<<"$vim_navigation_bindings")"
_assert_eq "tmux pane navigation checks all four local edges" \
  "4" "$(grep -Ec '#\{pane_at_(left|bottom|top|right)\}' <<<"$vim_navigation_bindings")"
# shellcheck disable=SC2016 # testing literal tmux variable references.
_assert_eq "tmux pane navigation bubbles all four remote edges" \
  "4" "$(grep -c '\$select_parent_pane_' <<<"$vim_navigation_bindings")"
_assert_eq "tmux defines all four parent-pane helper routes" \
  "4" "$(grep -c "$wezterm_select_pane_path --parent" <<<"$tmux_content")"
_assert_contains "tmux pane navigation requires inner mouse focus for transports" \
  "mouse == 1" "$pane_navigation_detector_line"
_assert_contains "tmux pane navigation recognizes nested remote transports" \
  "ssh|mosh|mosh-client|mosh-server|et" "$pane_navigation_detector_line"
_assert_contains "tmux pane navigation recognizes nested multiplexers" \
  "tmux|screen" "$pane_navigation_detector_line"
_assert_contains "tmux foreground app detector matches editors and fzf natively" \
  "view|l?n?vim?x?|fzf" "$foreground_app_detectors"
_assert_contains "tmux foreground app detector matches remote transports natively" \
  "ssh|mosh|mosh-client|mosh-server|et" "$foreground_app_detectors"
foreground_vim_filter=$(
  cat <<'AWK'
$3 == $4 && $1 !~ /^[TXZ]/ && $2 ~ /^g?(view|l?n?vim?x?|fzf)(diff)?$/ { found = 1 }
END { exit !found }
AWK
)
printf 'S+ fd 39056 39056\nS+ fzf 39056 39056\n' |
  awk "$foreground_vim_filter"
pipeline_vim_rc=$?
_assert_exit "tmux process-group fallback matches fzf behind a pipeline producer" \
  0 "$pipeline_vim_rc"
foreground_terminal_filter=$(
  cat <<'AWK'
$1 !~ /^[TXZ]/ && $(NF-1) == $NF && ($2 ~ /^(g?(view|l?n?vim?x?|fzf)(diff)?|ssh|mosh|mosh-client|mosh-server|et)$/ || (mouse == 1 && $2 ~ /^(tmux|screen):?$/)) { found = 1 }
END { exit !found }
AWK
)
printf 'S+ bash 39056 39056\nS+ tmux: client 39056 39056\n' |
  awk -v mouse=1 "$foreground_terminal_filter"
nested_wrapper_rc=$?
_assert_exit "tmux process-group fallback finds a mouse-aware client behind ds" \
  0 "$nested_wrapper_rc"
printf 'S+ bash 39056 39056\nS+ tmux: client 39056 39056\n' |
  awk -v mouse=0 "$foreground_terminal_filter"
non_mouse_wrapper_rc=$?
_assert_exit "tmux process-group fallback leaves non-mouse nested clients at outer layer" \
  1 "$non_mouse_wrapper_rc"
printf 'S+ bash 39056 39056\nS ssh 39100 39056\nS tmux: client 39101 39056\n' |
  awk -v mouse=1 "$foreground_terminal_filter"
background_terminal_rc=$?
_assert_exit "tmux process-group fallback ignores background transports and clients" \
  1 "$background_terminal_rc"
foreground_pane_navigation_filter=$(
  cat <<'AWK'
$1 !~ /^[TXZ]/ && $(NF-1) == $NF && ($2 ~ /^g?(view|l?n?vim?x?|fzf)(diff)?$/ || (mouse == 1 && $2 ~ /^(ssh|mosh|mosh-client|mosh-server|et|tmux|screen):?$/)) { found = 1 }
END { exit !found }
AWK
)
printf 'S+ ssh 39056 39056\n' |
  awk -v mouse=1 "$foreground_pane_navigation_filter"
focused_remote_rc=$?
_assert_exit "tmux pane navigation forwards into a focused remote application" \
  0 "$focused_remote_rc"
printf 'S+ ssh 39056 39056\n' |
  awk -v mouse=0 "$foreground_pane_navigation_filter"
plain_remote_rc=$?
_assert_exit "tmux pane navigation keeps a plain SSH shell at the outer layer" \
  1 "$plain_remote_rc"
printf 'S+ bash 39056 39056\nS tmux: client 39101 39056\n' |
  awk -v mouse=1 "$foreground_pane_navigation_filter"
background_nested_rc=$?
_assert_exit "tmux pane navigation ignores a background nested client" \
  1 "$background_nested_rc"
printf 'S+ htop 39056 39056\n' |
  awk -v mouse=1 "$foreground_pane_navigation_filter"
unrelated_mouse_app_rc=$?
_assert_exit "tmux pane navigation leaves unrelated mouse-aware TUIs at the outer layer" \
  1 "$unrelated_mouse_app_rc"
_assert_eq "tmux terminal app detector uses one combined process-group scan" \
  "1" "$(grep -o 'ps -o' <<<"$terminal_app_detector_line" | wc -l | tr -d ' ')"
_assert_contains "tmux Ctrl-Tab shares pane-navigation focus ownership" \
  "\"\$is_pane_navigation\"" "$ctrl_tab_config_line"
_assert_contains "tmux Ctrl-Shift-Tab shares pane-navigation focus ownership" \
  "\"\$is_pane_navigation\"" "$ctrl_shift_tab_config_line"
_assert_contains "tmux terminal app detector checks mouse-aware nested panes" \
  "#{mouse_any_flag}" "$terminal_app_detector_line"
_assert_contains "tmux Ctrl-Tab forwards CSI-u sequence into nested terminal apps" \
  "send_ctrl_tab=\"send-keys Escape '[9;5u'\"" "$tmux_content"
_assert_contains "tmux Ctrl-Shift-Tab forwards CSI-u sequence into nested terminal apps" \
  "send_ctrl_shift_tab=\"send-keys Escape '[9;6u'\"" "$tmux_content"
_assert_contains "tmux Ctrl-Tab bubbles through helper to avoid nested shell parsing" \
  "$wezterm_switch_tab_path next #{client_tty}" "$tmux_content"
_assert_contains "tmux Ctrl-Tab asks parent tmux when nested client has one window" \
  "$wezterm_switch_tab_path --parent next #{client_tty}" "$tmux_content"
_assert_contains "tmux Alt-Shift-[ forwards direct nvim/fzf panes" \
  "\"\$send_alt_shift_left_bracket\"" "$move_tab_left_config_line"
_assert_contains "tmux Alt-Shift-] forwards direct nvim/fzf panes" \
  "\"\$send_alt_shift_right_bracket\"" "$move_tab_right_config_line"
_assert_contains "tmux Alt-Shift-[ forwards Meta-left-brace sequence" \
  "send_alt_shift_left_bracket=\"send-keys Escape '{'\"" "$tmux_content"
_assert_contains "tmux Alt-Shift-] forwards Meta-right-brace sequence" \
  "send_alt_shift_right_bracket=\"send-keys Escape '}'\"" "$tmux_content"
_assert_contains "tmux Alt-Shift-[ forwards remote transports instead of moving parent tmux" \
  "\"\$is_terminal_app\"" "$move_tab_left_config_line"
_assert_contains "tmux Alt-Shift-] forwards remote transports instead of moving parent tmux" \
  "\"\$is_terminal_app\"" "$move_tab_right_config_line"
_assert_contains "tmux Alt-Shift-[ stops at first tmux window before bubbling" \
