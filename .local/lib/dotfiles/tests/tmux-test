_assert_contains "tmux pane navigation requires inner mouse focus for transports" \
  "mouse == 1" "$pane_navigation_detector_line"
_assert_contains "tmux pane navigation recognizes nested remote transports" \
  "ssh|mosh|mosh-client|mosh-server|et" "$pane_navigation_detector_line"
_assert_contains "tmux pane navigation recognizes nested multiplexers" \
  "tmux|screen" "$pane_navigation_detector_line"
_assert_contains "tmux foreground app detector uses native pane metadata" \
  "#{pane_current_command}" "$foreground_app_detectors"
