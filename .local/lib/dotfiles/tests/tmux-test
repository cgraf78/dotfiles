_assert_not_contains 'tmux: retired parent-loopback user keys stay absent' \
  'user-keys[0]' "$tmux_content"

echo "=== tmux floor ==="

# The floor's one statement is tmux.conf's "# tmux minimum:" marker, directly
# above the guard; everything below derives from it.
tmux_floor=$(_tmux_floor)
_assert_eq 'tmux: tmux.conf states its floor once' 1 \
  "$(grep -c '^# tmux minimum: ' "$tmux_config")"
_assert_eq 'tmux: the floor marker sits directly above the version guard' '%if "#{||:' \
  "$(awk 'found { print substr($0, 1, 10); exit } /^# tmux minimum: / { found = 1 }' "$tmux_config")"
floor_major=${tmux_floor%%.*}
floor_minor=${tmux_floor#*.}
# The canonical vectors, shared verbatim by every repository that checks the
# tmux floor: each version and how it reads (MAJOR.MINOR, newest or
# unknown). Whether each is supported follows from the floor, so the table
# holds no floor; rows at the floor's own edge are generated from it.
tmux_vectors='1.8:1.8 2.9a:2.9 next-2.9:2.9 3.0:3.0 3.1c:3.1 3.2:3.2
3.2a:3.2 3.2-rc3:3.2 next-3.2:3.2 next-3.2-rc:3.2 3.3:3.3 3.3a:3.3 3.3-rc:3.3
next-3.3:3.3 3.4:3.4 3.10:3.10 next-3.10:3.10 master:newest
openbsd-7.6:newest openbsd-7.6-current:newest 3.x:unknown 3.:unknown foo-2.9:unknown :unknown'
if [[ $floor_major =~ ^[0-9]+$ && $floor_minor =~ ^[0-9]+$ ]] && ((floor_minor > 0)); then
  below=$floor_major.$((floor_minor - 1))
  above=$floor_major.$((floor_minor + 1))
  tmux_vectors+=" $below:$below ${below}a:$below $below-rc:$below"
  tmux_vectors+=" next-$below:$below $tmux_floor:$tmux_floor $above:$above"
  tmux_vectors+=" $below-2+builder:$below $tmux_floor-2+builder:$tmux_floor"
  # The next major's first release, which a comparison of the minor alone
  # would refuse.
  next_major=$((floor_major + 1)).0
  tmux_vectors+=" $next_major:$next_major"
else
  _fail "tmux: the floor-edge rows cannot express the floor '$tmux_floor'"
fi
# Print yes or no for each vector, as the floor rule says.
tmux_vector_wants() {
  local vector reads major minor
  for vector in $tmux_vectors; do
    reads=${vector##*:}
    case $reads in
      newest | unknown) echo yes ;;
      *)
        major=${reads%%.*} minor=${reads#*.}
        if ((major > floor_major || (major == floor_major && minor >= floor_minor))); then
          echo yes
        else
          echo no
        fi
        ;;
    esac
  done
}
for vector in $tmux_vectors; do
  version=${vector%:*}
  reads=${vector##*:}
  case $reads in newest | unknown) want=newest ;; *) want="${reads%%.*} ${reads#*.}" ;; esac
