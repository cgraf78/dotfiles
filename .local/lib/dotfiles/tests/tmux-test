#!/usr/bin/env bash
# tmux-test - always-active tmux configuration coverage.

set -o pipefail
export NO_COLOR=1

# shellcheck source=helpers.sh
. "${BASH_SOURCE[0]%/*}/helpers.sh"

source_home=${DOT_TEST_SOURCE_HOME:-$HOME}
tmux_config=$source_home/.config/tmux/tmux.conf
tmux_base=$source_home/.config/tmux/conf.d/10-base.conf
tmux_content=$(<"$tmux_base")
shdeps_content=$(<"$source_home/.config/shdeps/10-deps.conf")
# shellcheck disable=SC2088 # Match the literal path stored in tmux config.
termnav_hot_path='~/.local/bin/termnav navigate'
move_tab_left=$(printf '%s\n' "$tmux_content" | awk "/^bind-key .*-n 'M-\\{' / { print }")
move_tab_right=$(printf '%s\n' "$tmux_content" | awk "/^bind-key .*-n 'M-\\}' / { print }")

echo "=== base tmux policy ==="

# shellcheck disable=SC2016 # Match the literal command substitution in tmux.conf.
_assert_contains "tmux: new panes prefer zsh when available" \
  'shell=$(command -v zsh' "$tmux_content"
_assert_contains "tmux: terminal supports true color" \
  'terminal-overrides' "$tmux_content"
# shellcheck disable=SC2016 # Match the literal HOME reference in the loader.
_assert_contains "tmux: loader reads ordered capability fragments" \
  'source-file -q "$HOME/.config/tmux/conf.d/*.conf"' \
  "$(<"$tmux_config")"
_assert_contains "tmux: base fragment enables mouse mode" \
  'set -g mouse on' "$tmux_content"
# Base recognizes editors as key owners but never runs one: Neovim-specific
# commands belong to the editor overlay.
_assert_not_contains "tmux: base fragment does not invoke Neovim" \
  'termnav nvim' "$tmux_content"
# prefix a in the client's own session makes the pane its window's active
# pane before showing the window, so the window's old active pane is never
# current and keeps its mark (the PTY suite presses it).
_assert_contains "tmux: prefix a selects the pane before its window in its own session" \
  '#{?#{E:@attention_next_here},select-pane -t ' "$tmux_content"
# tmux 3.6b segfaults expanding a session loop's "current session" form,
# #{S:all,current} or #{S/n:all,current}, when the format has no client
# (nobody attached, from a hook or a script); tmux fixed it upstream after
# 3.6b. Print each FILE:LINE whose #{S: or #{S/...: loop has a comma at its
# own brace depth after the modifiers' colon, with continued lines joined and
# #, #} and ## escapes skipped.
# shellcheck disable=SC2016 # An awk program, not shell expansions.
session_loop_commas='
  /\\$/ { joined = joined substr($0, 1, length($0) - 1); next }
  {
    line = joined $0; joined = ""; from = 1
    while ((at = index(substr(line, from), "#{S")) > 0) {
      from += at + 2; p = from; c = substr(line, p, 1)
      if (c == "/") {
        while (p <= length(line) && substr(line, p, 1) != ":") p++
      } else if (c != ":") {
        continue
      }
      p++; depth = 1; commas = 0
      while (p <= length(line) && depth > 0) {
        c = substr(line, p, 1)
        if (substr(line, p, 2) == "#{") { depth++; p += 2; continue }
        if (c == "#") { p += 2; continue }
        if (c == "}") depth--
        else if (c == "," && depth == 1) commas++
        p++
      }
      if (commas) print FILENAME ":" FNR
    }
  }'
session_loop_sample=$(_tmpdir)/session-loop.conf
printf '%s\n' "set -g @ok '#{S:#{?#{session_attached},a,b}}'" \
  "set -g @bad '#{S:#{session_name},x}'" \
  "set -g @sorted '#{S/n:#{?#{session_attached},a,b}} #{SHELL,x}'" \
  "set -g @bad_sorted '#{S/n:#{session_name},x}'" >"$session_loop_sample"
_assert_eq "tmux: the session-loop comma check flags the bad samples only" \
  "$session_loop_sample:2"$'\n'"$session_loop_sample:4" \
  "$(awk "$session_loop_commas" "$session_loop_sample")"
_assert_eq "tmux: no session loop uses the current-session form tmux 3.6b crashes on" \
  "" "$(awk "$session_loop_commas" "$source_home"/.config/tmux/conf.d/*.conf)"
# The pane menu opens above the pointer only while it fits there: an 80x24
# terminal has 23 rows above the status line. Count its rows as tmux draws
# them over a word and a line (no link, not in a mode): hidden items drop
# out, a separator never leads or follows another, and the border adds two.
# 22 rows keeps a row spare. Items may be single- or double-quoted, and the
# count ends with the block's last line.
pane_menu_rows() {
  awk -v q="'" -v dq='\\"' '
    /^%hidden pane_menu_items=/ { on = 1; rows = 2; prev = "none"; next }
    !on { next }
    {
      item = $0
      sub(/^[ \t]+/, "", item)
      if (substr(item, 1, 1) == q) {
        label = substr(item, 2); close_quote = q
      } else if (substr(item, 1, 2) == dq) {
        label = substr(item, 3); close_quote = dq
      } else {
        label = ""; close_quote = ""
      }
      if (close_quote == "") {
      } else if (index(label, close_quote) == 1) {
        if (prev != "none" && prev != "line") { rows++; prev = "line" }
      } else if (index(label, "#{?mouse_hyperlink,") != 1 &&
        index(label, "#{?#{m/r:(copy|view)-mode,") != 1) {
        rows++; prev = "item"
      }
      if (!/\\$/) { print rows; exit }
    }
  ' "$tmux_base"
}
pane_menu_rows=$(pane_menu_rows)
if [[ $pane_menu_rows =~ ^[0-9]+$ ]] && ((pane_menu_rows >= 10 && pane_menu_rows <= 22)); then
  _pass "tmux: the pane menu fits above the pointer in 80x24 ($pane_menu_rows rows)"
else
  _fail "tmux: the pane menu fits above the pointer in 80x24 (counted '${pane_menu_rows}' rows, budget 22)"
fi
pane_menu_sample=$(_tmpdir)/pane-menu.conf
# shellcheck disable=SC1003 # The backslashes are the config's continuations.
printf '%s\n' '%hidden pane_menu_items="\' "  '' \\" "  'One' 1 { a } \\" "  '' \\" \
  "  '#{?mouse_hyperlink,Link,}' h { b } \\" "  \\\"\\\" \\" "  \\\"Two\\\" 2 { c } \\" \
  "  'Last' 3 { d }\"" "  'After the block' 4 { e }" >"$pane_menu_sample"
_assert_eq 'tmux: the pane menu count reads both quotes and stops at the block end' 6 \
  "$(tmux_base=$pane_menu_sample pane_menu_rows)"
_assert_contains "tmux: escape delay stays bounded" \
  'set -s escape-time 10' "$tmux_content"
_assert_contains "tmux: history is retained generously" \
  'set -g history-limit 100000' "$tmux_content"
_assert_contains "tmux: clipboard popup uses the provider command" \
  'clip pick --paste-pane' "$tmux_content"
_assert_contains "tmux: continuum coordination uses the provider command" \
  'tmux-continuum-default-server' "$tmux_content"
_assert_contains "tmux: last-output copy uses the provider command" \
  'tmux-copy-last-output' "$tmux_content"
# The PTY test skips muse and only sees the split race under load, so pin the
# shape of all five task-window entries here: each opens an automatically
# named window in the current directory and splits from the agent pane's start.
_assert_not_contains "tmux: task windows take the command line as %1, not %% (3.8 escapes it)" \
  '"%%"' "$tmux_content"
_assert_eq "tmux: every task window opens unnamed in the current directory" 5 \
  "$(grep -o 'new-window -c "##{pane_current_path}" ;' <<<"$tmux_content" | wc -l | tr -d ' ')"
_assert_eq "tmux: every task window splits from the agent pane's start path" 5 \
  "$(grep -o 'split-window -h -l 40% -c "##{pane_start_path}" ; select-pane -L' <<<"$tmux_content" | wc -l | tr -d ' ')"
_assert_contains "tmux: terminal boundary routing uses Termnav" \
  'termnav navigate' "$tmux_content"
_assert_not_contains "tmux: retired relay command stays absent" \
  'termnav-relay' "$tmux_content"
_assert_not_contains "tmux: retired navigation wrapper stays absent" \
  'termnav-navigate' "$tmux_content"
# Tabs show static dots: no helper, frames, or hook redraws them on a timer.
for retired in term-tab-spinner working-spinner '@term_tab_spinner_frame}'; do
  _assert_not_contains "tmux: retired working spinner stays absent: $retired" \
    "$retired" "$tmux_content"
done

# Every provider command the base fragment binds must come from a base
# dependency: editor and dev hosts layer more deps on top, but a base-only host
# has nothing else to satisfy these keys.
for dependency in tmux cgraf78/tmux-tools cgraf78/termnav \
  laktak/extrakto tmux-plugins/tmux-continuum tmux-plugins/tmux-resurrect \
  tmux-plugins/tpm; do
  if awk -v dependency="$dependency" '$1 == dependency { found=1 }
    END { exit found ? 0 : 1 }' <<<"$shdeps_content"; then
    _pass "tmux: base declares $dependency"
  else
    _fail "tmux: base declares $dependency"
  fi
done
_assert_eq 'tmux: Termnav is a GitHub-owned dependency' github \
  "$(awk '$1 == "cgraf78/termnav" { print $2 }' <<<"$shdeps_content")"
if [[ -n ${DOT_TEST_TERMNAV_ROOT:-} ]]; then
  if [[ -x ${DOT_TEST_TERMNAV_ROOT}/target/release/termnav ]]; then
    _pass 'tmux: candidate termnav is executable'
  else
    _fail 'tmux: candidate termnav is executable'
  fi
fi

_assert_contains 'tmux: focused pane labels use the shared leaf predicate' \
  '@termnav_pane_is_focused_leaf' "$tmux_content"
for hook in client-attached client-focus-in client-focus-out client-detached; do
  _assert_contains "tmux: declares the $hook focus hook" \
    "set-hook -g ${hook}[110]" "$tmux_content"
done
_assert_contains 'tmux: attached clients publish terminal context' \
  'termnav tmux context --tty #{q:client_tty}' "$tmux_content"
_assert_contains 'tmux: control clients are excluded from context publication' \
  '#{==:#{client_control_mode},0}' "$tmux_content"
_assert_not_contains 'tmux: context publication remains ordered' \
  "client-attached[100] 'run-shell -b" "$tmux_content"
_assert_contains 'tmux: context publication is skipped without Termnav' \
  "run-shell 'test ! -x ~/.local/bin/termnav || exec ~/.local/bin/termnav tmux context" "$tmux_content"
_assert_contains 'tmux: focus-in starts the focus watcher' \
  'termnav tmux focus watch' "$tmux_content"
# Notification hooks can expand #{client_*} for another client; only
# #{hook_client} names the client that raised the event, and a hook that
# names none does nothing.
_assert_contains 'tmux: focus hooks name their triggering client' \
  'tmux_focus_client="--client-name #{q:hook_client}"' "$tmux_content"
_assert_contains 'tmux: focus hooks run only for a named client' \
  "tmux_focus_guard='#{!=:#{hook_client},}'" "$tmux_content"
_assert_contains 'tmux: focus-out stops the focus watcher' \
  'termnav tmux focus stop' "$tmux_content"
_assert_contains 'tmux: selection changes repair stale focus state' \
  'termnav tmux focus sync' "$tmux_content"
# The status job reruns at most once a second, so view changes publish their
# session at once. The background job's output and status must be discarded,
# or a failing or older term-pane-state would print into a pane, and ordinary
# navigation with nothing marked must stay process-free.
for hook in session-window-changed window-pane-changed client-focus-in \
  client-focus-out; do
  _assert_contains "tmux: $hook publishes its session at once" \
    "set-hook -g ${hook}[140] \"\$tmux_attention_view\"" "$tmux_content"
done
_assert_contains 'tmux: client-session-changed publishes its new session at once' \
  "set-hook -g client-session-changed[140] \"if-shell -F '#{session_attached}' \\\"\$tmux_attention_run\\\"\"" \
  "$tmux_content"
_assert_contains 'tmux: view-change publishing is backgrounded and silent' \
  "%hidden tmux_attention_run=\"run-shell -b 'term-pane-state --socket #{q:socket_path} --session #{q:session_id} >/dev/null 2>&1 || true'\"" \
  "$tmux_content"
_assert_contains 'tmux: view changes publish only while a pane is marked' \
  "%hidden tmux_attention_view=\"if-shell -F '#{&&:#{session_attached},#{W:#{P:#{?#{E:@pane_marked},1,}}}}' \\\"\$tmux_attention_run\\\"\"" \
  "$tmux_content"
_assert_contains 'tmux: inactive panes keep the Night Owl background' \
  "set -g @termnav_inactive_style 'bg=#010d17'" "$tmux_content"
_assert_contains 'tmux: active panes use the brighter Night Owl background' \
  "set -g window-active-style 'bg=#021c30'" "$tmux_content"
_assert_not_contains 'tmux: focus rendering does not spawn commands' \
  '#(' "$(printf '%s\n' "$tmux_content" | awk '/termnav_pane_is_focused_leaf|window-active-style|pane-active-border-style|pane-border-format/')"

for binding in \
  'bind -T copy-mode-vi C-c send-keys -X copy-pipe-and-cancel' \
  'bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "clip capture --history-only"' \
  "bind -T copy-mode-vi S-Left if -F '#{selection_active}'" \
  "bind -T copy-mode-vi S-Right if -F '#{selection_active}'" \
  "bind -T copy-mode-vi S-Up if -F '#{selection_active}'" \
  "bind -T copy-mode-vi S-Down if -F '#{selection_active}'" \
  "bind -T copy-mode-vi C-S-Left if -F '#{selection_active}'" \
  "bind -T copy-mode-vi C-S-Right if -F '#{selection_active}'"; do
  _assert_contains "tmux: preserves copy-mode binding $binding" \
    "$binding" "$tmux_content"
done
_assert_contains 'tmux: modified copy selections establish an anchor' \
  'send-keys -X begin-selection' "$tmux_content"
_assert_contains 'tmux: publishes copy-mode selections through OSC 52' \
  'set -g set-clipboard on' "$tmux_content"
_assert_contains 'tmux: default copy command records clipboard history' \
  "set -g copy-command 'clip capture --history-only'" "$tmux_content"
# shellcheck disable=SC2016 # Match the literal command substitution in config.
_assert_contains 'tmux: clipboard picker uses the isolated handoff path' \
  'clip pick --paste-pane #{pane_id}' "$tmux_content"
_assert_not_contains 'tmux: cancellation cannot consume an older handoff' \
  'run-shell tmux-clip-paste' "$tmux_content"
_assert_not_contains 'tmux: retired manual session exporter stays absent' \
  'tmux-save-session' "$tmux_content"
_assert_not_contains 'tmux: retired manual session restorer stays absent' \
  'tmux-restore-session' "$tmux_content"
_assert_contains 'tmux: reload removes the retired save key' 'unbind S' "$tmux_content"
# shellcheck disable=SC2016 # Match the literal HOME reference in the binding.
_assert_contains 'tmux: prefix R reloads the loader' \
  'bind -N "Reload the tmux configuration" R source-file "$HOME/.config/tmux/tmux.conf"' "$tmux_content"
_assert_contains 'tmux: extrakto loads only when installed' \
  'test ! -x ~/.local/share/laktak/extrakto/extrakto.tmux ||' "$tmux_content"
_assert_contains 'tmux: extrakto uses atomic stock OSC 52 copying' \
  'set -g @extrakto_clip_mode tmux_osc52' "$tmux_content"
_assert_contains 'tmux: extrakto cycles only atomic copy and buffer modes' \
  "set -g @extrakto_clip_mode_order 'tmux_osc52 buffer'" "$tmux_content"
_assert_contains 'tmux: reload retires the old global-buffer clipboard pipeline' \
  'set -gu @extrakto_clip_tool' "$tmux_content"
_assert_not_contains 'tmux: extrakto never rereads the global buffer for copying' \
  'tmux show-buffer | tmux load-buffer -w -' "$tmux_content"

# Verify the installed upstream public mode with its actual implementation,
# intercepting only the external transport so no host clipboard is touched.
extrakto_source=$(
  _test_use_host_shdeps
  command shdeps dep-file laktak/extrakto extrakto_plugin.py 2>/dev/null
) || extrakto_source=''
if [[ -f "$extrakto_source" ]] && command -v python3 >/dev/null 2>&1; then
  python3 - "$extrakto_source" <<'PY'
import importlib.util
import pathlib
import sys
from unittest.mock import patch

source = pathlib.Path(sys.argv[1])
sys.path.insert(0, str(source.parent))
spec = importlib.util.spec_from_file_location("extrakto_under_test", source)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
plugin = module.ExtraktoPlugin.__new__(module.ExtraktoPlugin)
text = "selected 中;$(literal)\n\n"
for mode, expected in (
    ("tmux_osc52", ["tmux", "set-buffer", "-w", "--", text]),
    ("buffer", ["tmux", "set-buffer", "--", text]),
):
    plugin.clip_mode = mode
    with patch.object(module.subprocess, "run") as transport:
        plugin.copy(text)
        transport.assert_called_once_with(expected, check=True)
PY
  _assert_exit 'extrakto stock copy sends its actual selection without a global reread' 0 "$?"
else
  printf '%s\n' 'SKIP: installed extrakto public-mode check (dependency or Python unavailable)'
fi

plugins=$(awk '/^[[:space:]]*set -g @plugin / { gsub(/'\''/, "", $4); print $4 }' \
  "$tmux_base")
_assert_eq 'tmux: persistence plugins retain dependency order' \
  $'tmux-plugins/tpm\ntmux-plugins/tmux-resurrect\ntmux-plugins/tmux-continuum' \
  "$plugins"
native_restore_line=$(awk "/set -g @continuum-restore 'off'/ { print NR }" "$tmux_base")
native_interval_line=$(awk "/set -g @continuum-save-interval '0'/ { print NR }" "$tmux_base")
tpm_load_line=$(awk '/exec ~\/\.local\/share\/tmux-plugins\/tpm\/tpm/ { print NR }' "$tmux_base")
default_owner_line=$(awk '/tmux-continuum-default-server/ { print NR }' "$tmux_base" | tail -n 1)
if [[ $native_restore_line -lt $tpm_load_line &&
  $native_interval_line -lt $tpm_load_line &&
  $tpm_load_line -lt $default_owner_line ]]; then
  _pass 'tmux: native persistence ownership is disabled before provider activation'
else
  _fail 'tmux: native persistence ownership is disabled before provider activation'
fi
for policy in \
  "set -g @continuum-restore 'off'" \
  "set -g @continuum-save-interval '0'" \
  "set -g @tmux-tools-continuum-save-interval '5'" \
  "set -g @tmux-tools-resurrect-auto-restore 'off'" \
  "set -g @resurrect-dir '~/.local/share/tmux/resurrect/\$HOSTNAME'" \
  "set -g @resurrect-hook-post-save-layout 'ds resurrect save'" \
  "set -g @resurrect-hook-pre-restore-all 'ds resurrect begin'" \
  "set -g @resurrect-hook-post-restore-all 'ds resurrect restore'"; do
  _assert_contains "tmux: preserves persistence policy $policy" \
    "$policy" "$tmux_content"
done
_assert_not_contains 'tmux: does not restart every foreground process' \
  "set -g @resurrect-processes ':all:'" "$tmux_content"
_assert_not_contains 'tmux: does not persist terminal scrollback by default' \
  "set -g @resurrect-capture-pane-contents 'on'" "$tmux_content"
resurrect_home=$(_tmpdir)
HOME=$resurrect_home bash -c 'umask 000; . "$1"; post' _ \
  "$source_home/.config/shdeps/hooks.d/tmux-plugins/tmux-resurrect.sh"
for directory in \
  "$resurrect_home/.local/share/tmux/resurrect" \
  "$resurrect_home/.local/share/tmux/resurrect/$(hostname)"; do
  mode=$(stat -c '%a' "$directory" 2>/dev/null || stat -f '%Lp' "$directory")
  _assert_eq "tmux: protects resurrect directory $directory" 700 "$mode"
done

_assert_eq 'tmux: config helper variables are all %hidden' '' \
  "$(cat "$source_home"/.config/tmux/tmux.conf "$source_home"/.config/tmux/conf.d/*.conf |
    grep -E '^[A-Za-z_][A-Za-z0-9_]*=')"
_assert_contains 'tmux: defines exact router origin metadata' \
  'navigate_origin_args="--client-pid #{client_pid} --client-tty #{q:client_tty} --client-created #{client_created} --client-termtype #{q:client_termtype} --source-socket #{q:socket_path} --source-pane #{pane_id} --source-session #{q:session_id}"' \
  "$tmux_content"
_assert_eq 'tmux: defines router origin metadata once' 1 \
  "$(awk '/^(%hidden )?navigate_origin_args=/ { count++ } END { print count + 0 }' <<<"$tmux_content")"
for direction in left right; do
  _assert_contains "tmux: routes $direction tab movement through Termnav" \
    "$termnav_hot_path tab-move $direction --parent \$navigate_origin_args" \
    "$tmux_content"
done
_assert_not_contains 'tmux: boundary routes stay foreground-ordered' \
  "run-shell -b '$termnav_hot_path" "$tmux_content"
_assert_contains 'tmux: local left tab movement stays native' \
  'swap-window -d -t :-' "$move_tab_left"
_assert_contains 'tmux: local right tab movement stays native' \
  'swap-window -d -t :+' "$move_tab_right"
for retired in termnav-switch-tab wezterm-switch-tab wezterm-move-tab \
  wezterm-select-pane DOT_PARENT_SWITCH_TAB DOT_PARENT_MOVE_TAB \
  DOT_PARENT_SELECT_PANE; do
  _assert_not_contains "tmux: retired route stays absent: $retired" \
    "$retired" "$tmux_content"
done
relay_values=(
  $'\033[777009u'
  $'\033[?2004;0$y'
  $'\033[?2004;1$y'
  $'\033[?2004;2$y'
  $'\033[?2004;3$y'
  $'\033[?2004;4$y'
)
# shellcheck disable=SC2016 # Preserve tmux's literal config escapes.
relay_config_values=(
  '\033[777009u'
  '\033[?2004;0\$y'
  '\033[?2004;1\$y'
  '\033[?2004;2\$y'
  '\033[?2004;3\$y'
  '\033[?2004;4\$y'
)
# shellcheck disable=SC2016 # Preserve tmux's partially escaped display form.
relay_escaped_esc_values=(
  '\033[777009u'
  '\033[?2004;0$y'
  '\033[?2004;1$y'
  '\033[?2004;2$y'
  '\033[?2004;3$y'
