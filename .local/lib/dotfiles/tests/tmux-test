# Nothing names a tmux older than the floor: each file's lines are read with
# comment and roff markers removed and joined, so a mention wrapped across
# lines still reads as one. An allowed mention is history or concerns a tool
# that works under any tmux, keyed on its file and words.
tmux_old_mentions() {
  LC_ALL=C awk -v floor_major="$floor_major" -v floor_minor="$floor_minor" '
    {
      line = $0
      sub(/^[ \t]+/, "", line)
      sub(/^[\/#*!;>-]+/, "", line)
      if (substr(line, 1, 1) == ".") sub(/^\.[A-Za-z]*/, "", line)
      sub(/^[ \t]+/, "", line)
      sub(/[ \t]+$/, "", line)
      text = text " " line
    }
    END {
      lower = tolower(text)
      # "older than" catches the floor stated without the word tmux, which
      # would go stale silently after a bump.
      keys[1] = "tmux"
      keys[2] = "older than"
      for (k = 1; k <= 2; k++) {
        at = 0
        while ((i = index(substr(lower, at + 1), keys[k])) > 0) {
          at += i
          rest = substr(lower, at + length(keys[k]))
          if (substr(rest, 1, 1) == " " || substr(rest, 1, 1) == "-") rest = substr(rest, 2)
          if (substr(rest, 1, 3) == ">= ") rest = substr(rest, 4)
          else if (substr(rest, 1, 2) == ">=") rest = substr(rest, 3)
          else if (substr(rest, 1, 7) == "before ") rest = substr(rest, 8)
          else if (substr(rest, 1, 1) == "v") rest = substr(rest, 2)
          if (!match(rest, /^[0-9]+\.[0-9]+/)) continue
          split(substr(rest, 1, RLENGTH), part, ".")
          if (part[1] + 0 < floor_major + 0 ||
            (part[1] + 0 == floor_major + 0 && part[2] + 0 < floor_minor + 0)) {
            print substr(text, at, 40)
          }
        }
      }
    }' "$@"
}
