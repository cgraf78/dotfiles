# shellcheck disable=SC2016 # tmux expands this variable, not the test shell.
_assert_eq "tmux pane navigation invokes the router only at four edges" "4" \
  "$(grep -c '\$select_parent_pane_' <<<"$vim_navigation_bindings")"
_assert_contains "tmux previous-pane chord forwards into navigation-aware panes" \
