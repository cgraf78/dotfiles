      'muse opencode' "$(window_name "$inline_window")"
    _assert_eq 'tmux: a versioned agent binary is labelled without its version' \
      muse "$(pane_label "$inline_pane")"
    # The binary name changes with every upgrade; any version-like suffix,
    # or none, is still the same agent. A lookalike name is not.
    for binary in muse-bin-R6001 muse-bin; do
      upgraded_pane=$(tmux_cmd new-window -d -P -F '#{pane_id}' \
        -c "$labels_dir/proj-a" "$labels_dir/inline $binary")
      wait_command "$upgraded_pane" "$binary" 0
      _assert_eq "tmux: $binary is still labelled muse" \
        muse "$(window_name "$upgraded_pane")"
    done
    lookalike_pane=$(tmux_cmd new-window -d -P -F '#{pane_id}' \
      -c "$labels_dir/proj-a" "$labels_dir/inline museum")
    wait_command "$lookalike_pane" museum 0
    _assert_eq 'tmux: a name merely starting with an agent is not an agent' \
      proj-a "$(window_name "$lookalike_pane")"
    # Other commands still need the interactive signal to name a window.
    plain_app_window=$(tmux_cmd new-window -d -P -F '#{window_id}' \
      -c "$labels_dir/proj-a" "$labels_dir/inline agentx")
    wait_command "$plain_app_window" agentx 0
    _assert_eq 'tmux: an unknown command without mouse reporting does not name' \
      proj-a "$(window_name "$plain_app_window")"

    # Wrapper processes use the app's own title, unless that title is just
    # tmux's hostname default. Several apps are listed in pane order.
    wrapped_window=$(tmux_cmd new-window -d -P -F '#{window_id}' \
      "$app ssh remote:ds")
    wrapped_pane=$(tmux_cmd display-message -p -t "$wrapped_window" '#{pane_id}')
    default_pane=$(tmux_cmd split-window -d -P -F '#{pane_id}' -t "$wrapped_pane" \
      "$app ssh '$host_short'")
    wait_command "$wrapped_pane" ssh 1
    wait_command "$default_pane" ssh 1
    _assert_eq 'tmux: wrapped apps are named by title, else by command' \
      'remote:ds ssh' "$(window_name "$wrapped_window")"
    _assert_eq 'tmux: wrapped pane label is the app title alone' \
      remote:ds "$(pane_label "$wrapped_pane")"
    _assert_eq 'tmux: wrapped pane with a default title shows its command' \
      ssh "$(pane_label "$default_pane")"

    # Long names are capped so one window cannot crowd the tab bar, and a
    # title that only echoes the pane directory is not repeated.
    long_window=$(tmux_cmd new-window -d -P -F '#{window_id}' \
      "$app ssh $long_title")
    echo_pane=$(tmux_cmd split-window -d -P -F '#{pane_id}' -t "$long_window" \
      -c "$labels_dir/proj-d" "$app agentx proj-d")
    wait_command "$long_window" ssh 1
    wait_command "$echo_pane" agentx 1
    _assert_eq 'tmux: long window names are truncated with an ellipsis' \
      'a-very-long-remote-h…' "$(window_name "$long_window")"
    _assert_eq 'tmux: a title echoing the directory is not repeated' \
      agentx "$(pane_label "$echo_pane")"

    # A title is untrusted text: style directives must render literally rather
    # than restyle the tab bar or border.
    hostile_window=$(tmux_cmd new-window -d -P -F '#{window_id}' \
      "$app ssh '#[fg=red]evil'")
    wait_command "$hostile_window" ssh 1
    _assert_eq 'tmux: window names escape title style directives' \
      '##[fg=red]evil' "$(window_name "$hostile_window")"
    _assert_eq 'tmux: pane labels escape title style directives' \
      '##[fg=red]evil' "$(pane_label "$hostile_window")"

    # Shell widgets such as fzf history search enable mouse reporting while the
    # shell stays in the foreground; that must not rename the tab.
    widget_window=$(tmux_cmd new-window -d -P -F '#{window_id}' \
      -c "$labels_dir/proj-z" "$app zsh")
    wait_command "$widget_window" zsh 1
    _assert_eq 'tmux: a mouse-reporting shell does not name its window' \
      proj-z "$(window_name "$widget_window")"
    _assert_eq 'tmux: a mouse-reporting shell keeps a directory label' \
      "zsh · $labels_dir/proj-z" "$(pane_label "$widget_window")"

    # Home abbreviation compares whole path components, and falls back to the
    # plain path when the server has no HOME.
    tmux_cmd set-environment -g HOME "$labels_dir/h"
    for case in "h:~" "h/sub:~/sub" "hx:$labels_dir/hx"; do
      home_pane=$(tmux_cmd new-window -d -P -F '#{pane_id}' \
        -c "$labels_dir/${case%%:*}" "$shell")
      wait_command "$home_pane" zsh 0
      _assert_eq "tmux: home abbreviation for ${case%%:*}" \
        "${case#*:}" "$(tmux_cmd -u display-message -p -t "$home_pane" '#{E:@pane_dir}')"
    done
    tmux_cmd set-environment -gu HOME
    _assert_eq 'tmux: no HOME leaves directories unabbreviated' \
      "$labels_dir/hx" \
      "$(tmux_cmd -u display-message -p -t "$home_pane" '#{E:@pane_dir}')"
    tmux_cmd set-environment -g HOME "$fixture_home"

    # Tab badges reflect zoom and copy mode for the window's active pane.
    current_format=$(tmux_cmd show-window-options -gv window-status-current-format)
    tmux_cmd resize-pane -Z -t "$shell_pane"
    tmux_cmd copy-mode -t "$shell_pane"
    _assert_contains 'tmux: current tab shows zoom' '[Z]' \
      "$(tmux_cmd -u display-message -p -t "$shell_pane" "$current_format")"
    _assert_contains 'tmux: current tab shows copy mode' '[COPY]' \
      "$(tmux_cmd -u display-message -p -t "$shell_pane" "$current_format")"
    tmux_cmd send-keys -t "$shell_pane" -X cancel
    tmux_cmd clock-mode -t "$shell_pane"
    _assert_not_contains 'tmux: other pane modes are not labelled as copy mode' \
      '[COPY]' "$(tmux_cmd -u display-message -p -t "$shell_pane" "$current_format")"
    tmux_cmd send-keys -t "$shell_pane" q
    tmux_cmd resize-pane -Z -t "$shell_pane"
    tab_now=$(tmux_cmd -u display-message -p -t "$shell_pane" "$current_format")
    _assert_not_contains 'tmux: the zoom badge clears with zoom' '[Z]' "$tab_now"
    _assert_not_contains 'tmux: the copy badge clears with copy mode' '[COPY]' "$tab_now"
    # Dots mark windows that want attention, so a bell does not restyle the
    # tab: tmux's default status format skips a bell style of "default".
    _assert_eq 'tmux: a bell leaves the tab style alone' default \
      "$(tmux_cmd show-window-options -gv window-status-bell-style)"
    _assert_contains 'tmux: the status format skips a default bell style' \
      'window-status-bell-style},default}' \
      "$(tmux_cmd show-options -gv 'status-format[0]')"
    # A pane marked by term-notify-sound shows a dot on its border and its
    # tab, colored by kind. Without an attached client no pane is the focused
    # leaf, so the marker renders for any marked pane here; the PTY suite
    # covers focus. The agent fixture runs a program, not a shell.
    dot_red='#[fg=#ff5370]●' dot_yellow='#[fg=#ffcb6b]●'
    dot_green='#[fg=#22da6e]●' dot_blue='#[fg=#82aaff]●'
    tab_marker() {
      tmux_cmd -u display-message -p -t "$shell_pane" '#{E:@window_marker}'
    }
    for case in "done:$dot_green:#22da6e" "1:$dot_green:#22da6e" \
      "waiting:$dot_yellow:#ffcb6b" "blocked:$dot_red:#ff5370"; do
      kind=${case%%:*} dot=${case#*:} dot=${dot%:*} color=${case##*:}
      tmux_cmd set-option -p -t "$agent_pane" @term_notify_pending "$kind"
      _assert_eq "tmux: a $kind pane marks its tab with one dot on the bar background" \
        "#[bg=#0b2942,nounderscore]$dot#[default]" "$(tab_marker)"
      _assert_eq "tmux: a $kind pane border leads with its dot" \
        "#[fg=$color,bold]●#[fg=#898989,nobold] " \
        "$(tmux_cmd -u display-message -p -t "$agent_pane" '#{E:@pane_pending_marker}')"
    done
    # The dots follow the tab's closing space, so the current tab's highlight
    # covers only its label and badges.
    # One expansion reads the label and the tab together, so automatic window
    # renaming cannot change the name in between.
    tmux_cmd set-option -p -t "$agent_pane" @term_notify_pending 'done'
    # The current tab underlines its label but not the spaces around it.
    for tab_format in window-status-format window-status-current-format; do
      tab_drawn=$(tmux_cmd -u display-message -p -t "$shell_pane" \
        "#I:#W|$(tmux_cmd show-window-options -gv "$tab_format")")
      tab_label=${tab_drawn%%|*}
      [ "$tab_format" = window-status-format ] ||
        tab_label="#[underscore]$tab_label#[nounderscore]"
      _assert_eq "tmux: $tab_format draws its dots after the tab's closing space" \
        " $tab_label $(tab_marker)" "${tab_drawn#*|}"
    done
    tmux_cmd set-option -pu -t "$agent_pane" @term_notify_pending
    _assert_eq 'tmux: tab marker clears with the pane mark' '' "$(tab_marker)"
    # Badges stay inside the highlighted tab, before the dots.
    tmux_cmd set-option -p -t "$agent_pane" @term_notify_pending 'done'
    tmux_cmd resize-pane -Z -t "$shell_pane"
    _assert_contains 'tmux: a zoomed current tab keeps its badge before the dots' \
      " [Z]#[nounderscore] #[bg=#0b2942,nounderscore]$dot_green#[default]" \
      "$(tmux_cmd -u display-message -p -t "$shell_pane" "$current_format")"
    tmux_cmd resize-pane -Z -t "$shell_pane"
    tmux_cmd set-option -pu -t "$agent_pane" @term_notify_pending
    # Waiting and blocked need the agent that set them, so a pane back at its
    # shell hides them; done stays visible there until you look.
    for kind in waiting blocked; do
      tmux_cmd set-option -p -t "$shell_pane" @term_notify_pending "$kind"
      _assert_eq "tmux: a $kind mark on a shell pane shows nothing" '' "$(tab_marker)"
      _assert_eq "tmux: a $kind mark on a shell pane is not pending" 0 \
        "$(tmux_cmd display-message -p -t "$shell_pane" '#{E:@pane_pending}')"
    done
    tmux_cmd set-option -p -t "$shell_pane" @term_notify_pending 'done'
    _assert_eq 'tmux: a done mark on a shell pane stays green' \
      "#[bg=#0b2942,nounderscore]$dot_green#[default]" "$(tab_marker)"
    # A failed long command is red with its exit status, and it outranks
    # other kinds, including panes earlier in pane order; each state present
    # adds its own dot, most severe first.
    tmux_cmd set-option -p -t "$agent_pane" @term_notify_pending waiting
    tmux_cmd set-option -p -t "$shell_pane" @term_notify_exit_status 2
    failure_border=$(tmux_cmd -u display-message -p -t "$shell_pane" '#{E:@pane_pending_marker}')
    _assert_eq 'tmux: a failed command border shows a red dot and its exit code' \
      '#[fg=#ff5370,bold]● exit 2#[fg=#898989,nobold] ' "$failure_border"
    _assert_eq 'tmux: a tab shows each state present, most severe first' \
      "#[bg=#0b2942,nounderscore]$dot_red$dot_yellow#[default]" "$(tab_marker)"
    _assert_eq 'tmux: a failed command counts as failed and pending' 11 \
      "$(tmux_cmd display-message -p -t "$shell_pane" '#{E:@pane_pending}#{E:@pane_failed}')"
    _assert_eq 'tmux: a waiting agent counts as waiting and pending, not failed' 110 \
      "$(tmux_cmd display-message -p -t "$agent_pane" '#{E:@pane_pending}#{E:@pane_waiting}#{E:@pane_failed}')"
    # Exit status only applies to kind done; a blocked agent shows no code.
    tmux_cmd set-option -p -t "$agent_pane" @term_notify_pending blocked
    tmux_cmd set-option -p -t "$agent_pane" @term_notify_exit_status 3
    _assert_not_contains 'tmux: a blocked agent border shows no exit code' 'exit' \
      "$(tmux_cmd -u display-message -p -t "$agent_pane" '#{E:@pane_pending_marker}')"
    tmux_cmd set-option -pu -t "$agent_pane" @term_notify_exit_status
    tmux_cmd set-option -pu -t "$shell_pane" @term_notify_pending
    _assert_eq 'tmux: exit metadata alone does not mark a pane' '' \
      "$(tmux_cmd -u display-message -p -t "$shell_pane" '#{E:@pane_pending_marker}')"
    tmux_cmd set-option -pu -t "$shell_pane" @term_notify_exit_status
    tmux_cmd set-option -pu -t "$agent_pane" @term_notify_pending

    # An agent working on a request (AgentGuard's @term_busy) is blue, in a
    # background tab too, but only while it shows no attention: blue means
    # work you need not look at.
    tmux_cmd set-option -p -t "$agent_pane" @term_busy 1
    _assert_eq 'tmux: busy pane marks its tab blue' \
      "#[bg=#0b2942,nounderscore]$dot_blue#[default]" "$(tab_marker)"
    _assert_contains 'tmux: busy pane marks a background tab too' "$dot_blue" \
      "$(tmux_cmd -u display-message -p -t "$agent_pane" \
        "$(tmux_cmd show-window-options -gv window-status-format)")"
    _assert_eq 'tmux: busy pane border shows a blue dot' \
      '#[fg=#82aaff,bold]●#[fg=#898989,nobold] ' \
      "$(tmux_cmd -u display-message -p -t "$agent_pane" '#{E:@pane_pending_marker}')"
    tmux_cmd set-option -p -t "$agent_pane" @term_notify_pending waiting
    _assert_eq 'tmux: attention replaces the busy dot of the same pane' \
      "#[bg=#0b2942,nounderscore]$dot_yellow#[default]" "$(tab_marker)"
    tmux_cmd set-option -pu -t "$agent_pane" @term_notify_pending
    tmux_cmd set-option -pu -t "$agent_pane" @term_busy
    _assert_eq 'tmux: busy marker clears with the pane mark' '' "$(tab_marker)"
    # A mark left on a pane that is back at a shell prompt (an agent that
    # crashed before its Stop hook) cannot mean work in progress.
    tmux_cmd set-option -p -t "$shell_pane" @term_busy 1
    _assert_eq 'tmux: a busy mark on a shell pane is ignored' '' "$(tab_marker)"
    tmux_cmd set-option -pu -t "$shell_pane" @term_busy

    # The containing window must also represent work and attention behind a
    # nested client, from exactly the leases term-pane-state counts. The
    # freshness window has exact one-second edges, so pin the predicate's
    # clock (a literal has no strftime codes): a live clock can tick between
    # building a lease and drawing it and move an edge case across the edge.
    # One live-clock case below proves the real %s clock afterwards.
    lease_now=1000000000
    tmux_cmd set-option -g @child_clock "$lease_now"
    _assert_eq 'tmux: a pinned lease clock reads back exactly' "$lease_now" \
      "$(tmux_cmd display-message -p '#{E:@child_now}')"
    lease_expiry=$((lease_now + 15))
    child_marker() {
      if [[ -n $2 ]]; then
        tmux_cmd set-option -p -t "$agent_pane" @termnav_child_waiting "$2"
      else
        tmux_cmd set-option -pu -t "$agent_pane" @termnav_child_waiting
      fi
      tmux_cmd set-option -p -t "$agent_pane" @termnav_child_attention "$1"
      tab_marker
    }
    for case in \
      "red green blue|$lease_expiry:2:3:1|" \
      "all four|$lease_expiry:2:3:1|$lease_expiry:1" \
      "red yellow blue|$lease_expiry:2:3:1|$lease_expiry:2" \
      "waiting over pending - failed|$lease_expiry:2:3:1|$lease_expiry:3" \
      "green|$lease_expiry:0:1:0|" \
      "blue|$lease_expiry:1:0:0|" \
      "yellow|$lease_expiry:0:1:0|$lease_expiry:1" \
      "expired|$((lease_now - 1)):2:3:1|$lease_expiry:1" \
      "too far ahead|$((lease_now + 31)):2:3:1|" \
      "at the far edge|$((lease_now + 30)):0:1:0|" \
      "expiring now|$lease_now:0:1:0|" \
      "expired waiting|$lease_expiry:2:3:1|$((lease_now - 1)):1" \
      "failed over pending|$lease_expiry:0:1:2|" \
      "malformed|bad:1:1:1|$lease_expiry:1" \
      "waiting lease alone||$lease_expiry:1"; do
      IFS='|' read -r label attention waiting <<<"$case"
      case $label in
        'red green blue' | 'waiting over pending - failed' | 'expired waiting')
          expected="#[bg=#0b2942,nounderscore]$dot_red$dot_green$dot_blue#[default]"
          ;;
        'all four') expected="#[bg=#0b2942,nounderscore]$dot_red$dot_yellow$dot_green$dot_blue#[default]" ;;
        'red yellow blue') expected="#[bg=#0b2942,nounderscore]$dot_red$dot_yellow$dot_blue#[default]" ;;
        green | 'at the far edge') expected="#[bg=#0b2942,nounderscore]$dot_green#[default]" ;;
        blue) expected="#[bg=#0b2942,nounderscore]$dot_blue#[default]" ;;
        yellow) expected="#[bg=#0b2942,nounderscore]$dot_yellow#[default]" ;;
        *) expected='' ;;
      esac
      if [[ -n $attention ]]; then
        _assert_eq "tmux: nested lease ($label) marks its containing window" \
          "$expected" "$(child_marker "$attention" "$waiting")"
      else
        tmux_cmd set-option -pu -t "$agent_pane" @termnav_child_attention
        tmux_cmd set-option -p -t "$agent_pane" @termnav_child_waiting "$waiting"
        _assert_eq "tmux: nested lease ($label) marks its containing window" \
          "$expected" "$(tab_marker)"
      fi
    done
    tmux_cmd set-option -g @child_clock '%s'
    live_now=$(tmux_cmd display-message -p '#{E:@child_now}')
    # term-pane-state compares leases with date +%s; allow a tick between.
    clock_skew=$(($(date +%s) - ${live_now:-0}))
    if ((clock_skew >= 0 && clock_skew <= 2)); then
      _pass 'tmux: the lease clock is the epoch second'
    else
      _fail "tmux: the lease clock is the epoch second (got '$live_now')"
    fi
    _assert_eq 'tmux: nested lease (live clock) marks its containing window' \
      "#[bg=#0b2942,nounderscore]$dot_yellow#[default]" \
      "$(child_marker "$((live_now + 15)):0:1:0" "$((live_now + 15)):1")"
    tmux_cmd set-option -pu -t "$agent_pane" @termnav_child_attention
    tmux_cmd set-option -pu -t "$agent_pane" @termnav_child_waiting

    # prefix A's end-to-end behavior is pressed through a real client in the
    # PTY suite below: list-keys does not round-trip its shell snippet on
    # every release (tmux 3.4 escapes $ as \$), and a clientless replay
    # cannot show messages on older releases.
    _assert_contains 'tmux: runtime prefix A pastes the last output into the agent' \
      'tmux-copy-last-output --print' "$(printf '%s\n' "$prefix_keys" | awk '$4 == "A"')"
    for hook in pane-focus-in pane-focus-out client-focus-in after-select-pane \
      after-select-window client-session-changed; do
      # Older tmux releases lack some of these hooks (client-focus-in arrived
      # later); probe support rather than failing on a hook tmux cannot run.
      tmux_cmd set-hook -g "${hook}[999999]" 'display-message -p probe' 2>/dev/null
      if ! tmux_cmd show-hooks -g "$hook" 2>/dev/null | grep -Fq '[999999]'; then
        _pass "tmux: $hook unsupported by this tmux, acknowledgement check skipped"
        continue
      fi
      tmux_cmd set-hook -gu "${hook}[999999]"
      _assert_contains "tmux: $hook acknowledges a pending pane" \
        'set-option -pu @term_notify_pending' "$(tmux_cmd show-hooks -g "$hook")"
      _assert_contains "tmux: $hook keeps a sticky kind its agent still owns" \
        '#{&&:#{E:@pane_sticky},#{E:@pane_keeps_sticky}}' "$(tmux_cmd show-hooks -g "$hook")"
      _assert_contains "tmux: $hook clears the acknowledged exit status" \
        'set-option -pu @term_notify_exit_status' "$(tmux_cmd show-hooks -g "$hook")"
    done
    _assert_contains 'tmux: window switches publish attention at once' \
      'term-pane-state --socket #{q:socket_path} --session #{q:session_id}' \
      "$(tmux_cmd show-hooks -g session-window-changed)"
    # A nested layer's lease reaches this terminal at once, and only when
    # its counts change: the hook keys on the lease options' set-option.
    lease_hook=$(tmux_cmd show-hooks -g after-set-option)
    _assert_contains "tmux: a child lease's change publishes its session at once" \
      'term-pane-state --socket #{q:socket_path} --session #{q:session_id}' "$lease_hook"
    _assert_contains 'tmux: only a child lease set-option can publish' \
      '#{m/r:(^| )@termnav_child_(attention|waiting)( |$),#{hook_arguments}}' "$lease_hook"
    _assert_contains 'tmux: a lease renewal with the same counts stays process-free' \
      '#{!=:#{s/^[0-9]+.//:#{@termnav_child_attention}}/#{s/^[0-9]+.//:#{@termnav_child_waiting}},#{@child_lease_seen}}' \
      "$lease_hook"
    # Every NAME=value helper in the base fragment is %hidden: a plain one
    # would be exported into every pane's environment.
    leaked=''
    while IFS= read -r helper; do
      # A hidden variable is found but not shown here.
      [[ -z $(tmux_cmd show-environment -g "$helper" 2>/dev/null) ]] || leaked+=" $helper"
    done < <(sed -nE 's/^%hidden ([A-Za-z_][A-Za-z0-9_]*)=.*/\1/p' "$tmux_base")
    _assert_eq 'tmux: config helper variables stay out of pane environments' '' "$leaked"
    _assert_eq 'tmux: windows rename automatically' on \
      "$(tmux_cmd show-window-options -gv automatic-rename)"
    _assert_eq 'tmux: nested tmux titles its parent pane with host:session' \
      '#{?@hostname_alias,#{@hostname_alias},#{host_short}}:#S' \
      "$(tmux_cmd show-options -gv set-titles-string)"

    # Attach a second configured server's client from inside a pane of the
    # first, the way `ssh host` from a tmux pane nests tmux. The nested client
    # must still negotiate extended keys, or the outer tmux collapses Ctrl-Shift
    # chords to their plain Ctrl form before the nested pane sees them.
    nested_socket=$(_tmux_socket) || exit 1
    CLEANUP_DIRS+=("${nested_socket%/*}")
    nested_cmd() {
      "${TMUX_FIXTURE_ENV[@]}" tmux -S "$nested_socket" "$@"
    }
    if nested_cmd -f /dev/null new-session -d -s dot-tmux-nested \
      'sleep 60' >/dev/null 2>&1; then
      nested_cmd source-file "$tmux_config" >/dev/null 2>&1 || true
      tmux_cmd new-window -d -t dot-tmux-syntax \
        "env TERM=tmux-256color tmux -S '$nested_socket' attach-session -t dot-tmux-nested"
      nested_client=''
      for _ in $(seq 1 40); do
        nested_client=$(nested_cmd list-clients \
          -F '#{client_termname} #{client_termfeatures}' 2>/dev/null)
        [[ -n $nested_client ]] && break
        sleep 0.1
      done
      _assert_contains 'tmux: nested client attaches with a tmux terminal' \
        'tmux-256color ' "$nested_client"
      _assert_contains 'tmux: nested client negotiates extended keys' \
        'extkeys' "$nested_client"
      nested_cmd kill-server >/dev/null 2>&1 || true
    else
      _fail "tmux: nested test server starts"
    fi
    tmux_cmd kill-server >/dev/null 2>&1 || true

    # The leak itself: a server started from a VS Code terminal copies that
    # terminal's BROWSER before any session exists.
    vscode_socket=$(_tmux_socket) || exit 1
    CLEANUP_DIRS+=("${vscode_socket%/*}")
    "${TMUX_FIXTURE_ENV[@]}" BROWSER=/vscode-server/bin/helpers/browser.sh \
      tmux -S "$vscode_socket" -f "$tmux_config" new-session -d 'sleep 60' \
      >/dev/null 2>&1
    _assert_eq "tmux: a server started from VS Code drops VS Code's BROWSER" '' \
      "$("${TMUX_FIXTURE_ENV[@]}" tmux -S "$vscode_socket" \
        show-environment -g BROWSER 2>/dev/null)"
    "${TMUX_FIXTURE_ENV[@]}" tmux -S "$vscode_socket" kill-server \
      >/dev/null 2>&1 || true
  else
    _fail "tmux: test server starts"
  fi
else
  _pass "tmux: binary unavailable, syntax smoke skipped"
fi

if command -v tmux >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
  # The PTY driver starts its own private servers from the same fixture
  # environment, so their hooks and panes stay off live state too.
  _tmux_fixture_env "$source_home" || exit 1
  # clip imports only Dot's public XDG library from the host. All writable
  # clipboard data still belongs to each PTY test's private XDG_DATA_HOME.
  TMUX_FIXTURE_ENV+=(DOT_TEST_HOST_HOME="${DOT_TEST_HOST_HOME:-$HOME}")
  if pty_output=$("${TMUX_FIXTURE_ENV[@]}" python3 \
    "${BASH_SOURCE[0]%/*}/support/tmux-focus-style.py" \
    --config "$tmux_config" --clip "$source_home/.local/bin/clip" \
    --prompt "$source_home/.config/shell/interactive.d/59-prompt.sh" 2>&1); then
    pty_status=0
  else
    pty_status=$?
  fi
  printf '%s\n' "$pty_output"
  _assert_exit "tmux: base PTY focus/style coverage passes" 0 "$pty_status"
  for pty_case in \
    test_focus_hooks_are_client_scoped_and_ignore_control_mode \
    test_styles_follow_each_client_and_child_claim \
    test_terminal_render_paints_the_focused_leaf_night_owl_blue \
    test_pending_panes_are_marked_until_visited \
    test_attention_predicates_keep_the_publisher_invariants \
    test_a_glance_keeps_attention_that_needs_an_action \
    test_sticky_attention_ends_with_its_agent \
    test_prefix_a_visits_pending_panes_in_order \
    test_background_window_agents_mark_their_tab \
    test_another_focused_client_does_not_strand_a_mark \
    test_view_changes_publish_their_session_at_once \
    test_child_lease_changes_publish_their_session_at_once \
    test_nested_attention_reaches_the_terminal_at_once \
    test_prefix_A_pastes_the_last_output_into_the_agent \
    test_clip_copy_reaches_its_client_while_another_is_active \
    test_prefix_g_and_G_open_popups_in_the_pane_directory \
    test_prefix_n_opens_a_task_window \
    test_right_click_opens_the_pane_menu_on_the_pane_clicked \
    test_a_program_using_the_mouse_keeps_the_right_click \
    test_menu_items_grey_out_where_they_cannot_apply \
    test_the_window_menu_acts_on_the_tab_clicked \
    test_option_space_opens_the_command_palette; do
    # unittest prints each case's name, its docstring and then "... ok" or
    # "... skipped 'reason'"; a mention of the name alone proves nothing. A
    # case that writes to stderr while it runs puts that text after the
    # "... " and its result on a later line, so read on to the first line
    # that is a result, and stop at the next case's name.
    pty_result=$(awk -v name="$pty_case" '
      function result(text) {
        if (text ~ /^(ok|FAIL|ERROR|skipped|expected failure|unexpected success)/) {
          print text
          exit
        }
      }
      !found && index($0, name " (") == 1 {
        found = 1
        if (!/ \.\.\. /) next
      }
      !found { next }
      !started && / \.\.\. / { started = 1; sub(/.* \.\.\. /, ""); result($0); next }
      /^test_[A-Za-z0-9_]+ \(__main__\./ { exit }
      started { result($0) }
    ' <<<"$pty_output")
    case $pty_result in
      ok) _pass "tmux: PTY runs $pty_case" ;;
      skipped*)
        # The nested relay needs the real Termnav and tmux-tools. Hosts that
        # install them set DOT_TEST_REQUIRE_TERMNAV=1 so the skip cannot hide.
        if [[ ${DOT_TEST_REQUIRE_TERMNAV:-} == 1 &&
          $pty_case == test_nested_attention_reaches_the_terminal_at_once ]]; then
          _fail "tmux: PTY runs $pty_case (${pty_result#skipped }, but DOT_TEST_REQUIRE_TERMNAV=1)"
        else
          printf 'SKIP: tmux: PTY runs %s (%s)\n' "$pty_case" "${pty_result#skipped }"
        fi
        ;;
      *) _fail "tmux: PTY runs $pty_case (${pty_result:-no result})" ;;
    esac
  done
else
  _pass "tmux: Python or tmux unavailable, PTY coverage skipped"
fi

_test_summary
