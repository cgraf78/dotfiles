#!/usr/bin/env bash
# lua-test — dotfiles consumers of the provider-owned shdeps Lua bootstrap.

set -o pipefail
export NO_COLOR=1

# shellcheck source=.local/lib/dotfiles/tests/helpers.sh
# shellcheck disable=SC1091
. "${BASH_SOURCE[0]%/*}/helpers.sh"

_lua_working_nvim() {
  local candidate

  for candidate in \
    "$HOME/.local/share/neovim/neovim/bin/nvim" \
    "$(command -v nvim 2>/dev/null || true)"; do
    [[ -n "$candidate" && -x "$candidate" ]] || continue

    # Keep this probe aligned with wezterm-test. Alpine can see the
    # bootstrapped glibc-linked nvim binary as executable even though musl
    # cannot run it, so test the binary before using it as a Lua host.
    if _with_timeout 10s "$candidate" --version >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

_lua_run() {
  local script="$1" nvim_bin

  if command -v lua >/dev/null 2>&1; then
    lua "$script"
    return
  fi

  nvim_bin=$(_lua_working_nvim || true)
  if [[ -n "$nvim_bin" && -x "$nvim_bin" ]]; then
    _with_timeout 10s "$nvim_bin" --headless --noplugin -u NONE -i NONE -l "$script" 2>&1
    return
  fi

  printf '%s\n' "lua-test: no Lua runner found" >&2
  return 127
}

echo "=== lua: provider-owned shdeps bootstrap ==="

fixture=$(_tmpdir)/dot-home
script=$(_tmpdir)/shdeps-consumer-test.lua
mkdir -p \
  "$fixture/.config/nvim/lua/config" \
  "$fixture/.config/wezterm" \
  "$fixture/.local/lib/shdeps/shdeps" \
  "$fixture/assets"
cp "$HOME/.config/nvim/lua/config/dot-runtime.lua" \
  "$fixture/.config/nvim/lua/config/dot-runtime.lua"
cp "$HOME/.config/wezterm/termnav-module.lua" \
  "$fixture/.config/wezterm/termnav-module.lua"
printf '%s\n' \
  'return { marker = "link-routes" }' \
  >"$fixture/assets/termnav-link-routes.lua"
printf '%s\n' \
  'return { marker = "public-link-rules" }' \
  >"$fixture/assets/termnav-public-link-rules.lua"

cat >"$fixture/.local/lib/shdeps/shdeps/bootstrap.lua" <<'LUA'
local M = {}

function M.new(options)
  options = options or {}
  return {
    dep_file = function(name, relative_path)
      if name == "cgraf78/termnav" then
        if relative_path == "lib/termnav/wezterm/link-routes.lua" then
          return options.home .. "/assets/termnav-link-routes.lua"
        end
        if relative_path == "lib/termnav/wezterm/public-link-rules.lua" then
          return options.home .. "/assets/termnav-public-link-rules.lua"
        end
      end
      return table.concat({ options.home, name, relative_path }, "|")
    end,
    env = function()
      return { HOME = options.home }
    end,
  }
end

return M
LUA

cat >"$script" <<'LUA'
local home = os.getenv("TEST_HOME")
local watched = {}
package.preload.wezterm = function()
  return {
    add_to_config_reload_watch_list = function(path)
      table.insert(watched, path)
    end,
  }
end

local runtime = dofile(home .. "/.config/nvim/lua/config/dot-runtime.lua")
local api = runtime.shdeps()
print(api.dep_file("cgraf78/tool", "lib/tool/init.lua"))
print(api.env().HOME)

local termnav_loader = dofile(home .. "/.config/wezterm/termnav-module.lua")
local link_routes = termnav_loader.load(
  "missing-link-routes.lua",
  "lib/termnav/wezterm/link-routes.lua"
)
local public_link_rules = termnav_loader.load(
  "missing-public-link-rules.lua",
  "lib/termnav/wezterm/public-link-rules.lua"
)
table.sort(watched)
print(link_routes.marker)
print(public_link_rules.marker)
print(table.concat(watched, "\n"))
LUA

result=$(
  SHDEPS_LUA_DIR="$fixture/.local/lib/shdeps" \
    TEST_HOME="$fixture" \
    _lua_run "$script"
)
expected=$(
  printf '%s\n' \
    "$fixture|cgraf78/tool|lib/tool/init.lua" \
    "$fixture" \
    "link-routes" \
    "public-link-rules" \
    "$fixture/assets/termnav-link-routes.lua" \
    "$fixture/assets/termnav-public-link-rules.lua"
)
_assert_eq "Lua consumers resolve and watch provider assets through shdeps" \
  "$expected" "$result"

_test_summary
