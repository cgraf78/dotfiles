_probe_command() {
  local mode="$1" command_name="$2"
  shift 2
  # shellcheck disable=SC2016 # The inner shell supplies the provider contract.
  env -i "$@" TERMNAV_TEST_FILE_LINK_MODE="$mode" \
    HOME="$HOME" PATH="$alias_probe_bin:/usr/bin:/bin" bash -c '
      termnav_file_links_need_plain_output() {
        [[ "$TERMNAV_TEST_FILE_LINK_MODE" == plain ||
          "${TERMNAV_FILE_LINKS_PLAIN:-}" == 1 ]]
      }
      source "$1"
      shift
      "$@"
    ' _ "$HOME/.config/shell/interactive.d/50-aliases.sh" "$command_name" fixture
}

_probe_prealiased_command() {
  local command_name="$1"
  # shellcheck disable=SC2016 # The inner shell supplies the provider contract.
  env -i HOME="$HOME" PATH="$alias_probe_bin:/usr/bin:/bin" zsh -f -c '
    termnav_file_links_need_plain_output() { return 1; }
    alias ls="ls -G"
    alias rg="rg --hidden"
    source "$1"
    shift
    "$@"
  ' _ "$HOME/.config/shell/interactive.d/50-aliases.sh" "$command_name" fixture
}

