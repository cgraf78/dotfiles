#!/usr/bin/env bash
# wezterm-test - dotfiles WezTerm config and termnav wrapper integration.

set -o pipefail
export NO_COLOR=1

# shellcheck source=helpers.sh
. "${BASH_SOURCE[0]%/*}/helpers.sh"

real_home="$HOME"
config="$HOME/.config/wezterm/wezterm.lua"
link_routes="$HOME/.config/wezterm/link-routes.lua"
public_link_rules="$HOME/.config/wezterm/public-link-rules.lua"
termnav_module="$HOME/.config/wezterm/termnav-module.lua"
content=$(cat "$config")
route_wrapper=$(cat "$link_routes")
public_rule_wrapper=$(cat "$public_link_rules")
termnav_wrapper=$(cat "$termnav_module")
alias_content=$(cat "$HOME/.config/shell/interactive.d/50-aliases.sh")
ripgrep_content=$(cat "$HOME/.config/ripgrep/config")
termnav_shell="$HOME/.config/shell/interactive.d/53-termnav.sh"
termnav_shell_content=$(cat "$termnav_shell")

_wezterm_lua() {
  local code="$1" nvim_bin script

  if command -v lua >/dev/null 2>&1; then
    lua -e "$code"
    return
  fi

  nvim_bin=$(_wezterm_working_nvim || true)
  if [[ -n "$nvim_bin" && -x "$nvim_bin" ]]; then
    script=$(_tmpdir)/wezterm-lua.lua
    printf '%s\n' "$code" >"$script"
    _with_timeout 10s "$nvim_bin" --headless --noplugin -u NONE -i NONE -l "$script" 2>&1
    return
  fi

  printf '%s\n' "wezterm-test: no Lua runner found" >&2
  return 127
}

_wezterm_working_nvim() {
  local candidate

  for candidate in \
    "$real_home/.local/share/neovim/neovim/bin/nvim" \
    "$(command -v nvim 2>/dev/null || true)"; do
    [[ -n "$candidate" && -x "$candidate" ]] || continue

    # Alpine can see the bootstrapped glibc-linked nvim binary as executable
    # even though musl cannot run it. Probe the binary before using it as the
    # Lua host so the suite falls back cleanly instead of reporting a timeout
    # from the dynamic loader.
    if _with_timeout 10s "$candidate" --version >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

_wezterm_has_lua_runner() {
  command -v lua >/dev/null 2>&1 && return 0
  _wezterm_working_nvim >/dev/null
}

echo "=== WezTerm shell integration ownership ==="

_assert_contains "shell integration resolves Termnav through shdeps" \
  "dot_shdeps_dep_source cgraf78/termnav share/termnav/shell.sh" "$termnav_shell_content"
_assert_not_contains "shell integration does not define a new tmux publisher" \
  "_dot_wezterm_publish_tmux_context()" "$termnav_shell_content"
_assert_not_contains "shell integration does not publish raw tmux protocol state" \
  "DOT_TMUX" "$termnav_shell_content"
_assert_not_contains "shell integration carries no obsolete WezTerm cleanup" \
  "_dot_wezterm_retire_legacy_tmux_context" "$termnav_shell_content"

# Shell startup is a recovery boundary. A missing or temporarily unavailable
# shdeps checkout must disable Termnav for that shell without preventing the
# user from reaching a prompt where `dot update` or `dot doctor` can repair it.
termnav_loader_home=$(_tmpdir)
mkdir -p "$termnav_loader_home/.local/lib/dotfiles"
cat >"$termnav_loader_home/.local/lib/dotfiles/shdeps-assets.sh" <<'EOF'
dot_shdeps_dep_source() { return 1; }
EOF

for test_shell in bash zsh; do
  if [[ "$test_shell" == zsh ]] && ! command -v zsh >/dev/null 2>&1; then
    echo "  - skipping Termnav fail-open startup in zsh (zsh unavailable)"
    continue
  fi
  if [[ "$test_shell" == bash ]]; then
    shell_args=(--noprofile --norc)
  else
    shell_args=(-f)
  fi
  # The selected child shell expands TERMNAV_SHELL after receiving its isolated
  # HOME; expanding it in this Bash test runner would defeat the fixture.
  # shellcheck disable=SC2016
  loader_result=$(
    HOME="$termnav_loader_home" TERMNAV_SHELL="$termnav_shell" \
      "$test_shell" "${shell_args[@]}" -c \
      'source "$TERMNAV_SHELL"; printf shell-ready'
  )
  _assert_eq "$test_shell startup survives unavailable Termnav" \
    shell-ready "$loader_result"
done

termnav_policy=$(
  HOME="$termnav_loader_home" XDG_STATE_HOME="$termnav_loader_home/state" \
    bash --noprofile --norc -c \
    'unset TERMNAV_VSCODE_MCP_TOKEN_FILE
     source "$1"; printf "%s\n" "$TERMNAV_VSCODE_MCP_TOKEN_FILE"' \
    bash "$termnav_shell"
)
_assert_eq "shell exports the dotfiles-owned Termnav token location" \
  "$termnav_loader_home/state/dot/vscode-mcp-auth-token" \
  "$termnav_policy"

relative_state_token=$(
  HOME="$termnav_loader_home" XDG_STATE_HOME=relative/state \
    bash --noprofile --norc -c \
    'unset TERMNAV_VSCODE_MCP_TOKEN_FILE
     source "$1"; printf "%s\n" "$TERMNAV_VSCODE_MCP_TOKEN_FILE"' \
    bash "$termnav_shell"
)
_assert_eq "relative XDG state cannot redirect the Termnav token lookup" \
  "$termnav_loader_home/.local/state/dot/vscode-mcp-auth-token" \
  "$relative_state_token"

echo "=== WezTerm mouse and route integration ==="

_assert_contains "ctrl-click opens links through open-uri on mouse up" \
  'action = act.CompleteSelectionOrOpenLinkAtMouseCursor("ClipboardAndPrimarySelection"),' "$content"
_assert_contains "ctrl-click mouse down is swallowed before tmux sees it" \
  "action = act.Nop," "$content"
_assert_contains "shift remains the generic mouse-reporting bypass" \
  'bypass_mouse_reporting_modifiers = "SHIFT",' "$content"
_assert_contains "wezterm handles the standard terminal bell event" \
  'wezterm.on("bell"' "$content"
_assert_contains "wezterm configures bell rendering through platform policy" \
  "audible_bell = audible_bell," "$content"
_assert_contains "wezterm delegates open-uri routing to termnav wrapper" \
  'load_config_module("link-routes.lua")' "$content"
_assert_not_contains "wezterm delegates Termnav user-var routing to its provider" \
  'wezterm.on("user-var-changed"' "$content"
_assert_contains "wezterm key callbacks classify pane ownership once" \
  "termnav_routes.terminal_owner" "$content"
_assert_not_contains "wezterm key callbacks do not repeat nvim classification" \
  "termnav_routes.is_nvim" "$content"
_assert_not_contains "wezterm key callbacks do not repeat tmux classification" \
  "termnav_routes.is_tmux" "$content"
_assert_not_contains "wezterm config does not read termnav protocol vars directly" \
  "get_user_vars().IS_NVIM" "$content"
_assert_not_contains "wezterm config does not read tmux protocol vars directly" \
  "get_user_vars().DOT_TMUX" "$content"
_assert_contains "wezterm delegates public link rules to termnav wrapper" \
  'load_config_module("public-link-rules.lua")' "$content"
_assert_contains "wezterm hyperlink rules load overlay extensions" \
  "hyperlink-rules.d" "$content"
_assert_contains "wezterm hyperlink rule extensions can append rules" \
  "apply_hyperlink_rule_extensions" "$content"
_assert_not_contains "wezterm config carries no legacy tab-switch protocol" \
  "DOT_SWITCH_TAB" "$content"
_assert_not_contains "wezterm config carries no legacy tab-move protocol" \
  "DOT_MOVE_TAB" "$content"
for retired in DOT_PARENT_SWITCH_TAB DOT_PARENT_MOVE_TAB DOT_PARENT_SELECT_PANE \
  777001 777002 777003 777004 777005 777006 777007 777008; do
  _assert_not_contains "wezterm removes retired parent-loopback path: $retired" \
    "$retired" "$content"
done
_assert_contains "termnav wrapper resolver resolves termnav through shdeps" \
  'shdeps.dep_file("cgraf78/termnav"' "$termnav_wrapper"
_assert_contains "link route wrapper loads termnav route module" \
  "lib/termnav/wezterm/link-routes.lua" "$route_wrapper"
_assert_contains "public link wrapper loads termnav public link module" \
  "lib/termnav/wezterm/public-link-rules.lua" "$public_rule_wrapper"

route_copy_home=$(_tmpdir)
public_copy_home=$(_tmpdir)
nvim_key_home=$(_tmpdir)

if _wezterm_has_lua_runner; then
  bell_home=$(_tmpdir)
  cp "$config" "$bell_home/wezterm.lua"
  cp "$link_routes" "$bell_home/link-routes.lua"
  cp "$public_link_rules" "$bell_home/public-link-rules.lua"
  cp "$termnav_module" "$bell_home/termnav-module.lua"
  cat >"$bell_home/termnav-link-routes.lua" <<'LUA'
return {
  new = function()
    return {
      terminal_owner = function()
        return "terminal"
      end,
      setup = function() end,
    }
  end,
}
LUA
  cat >"$bell_home/termnav-public-link-rules.lua" <<'LUA'
return {
  add_public_link_rules = function(rules)
    return rules
  end,
}
LUA

  _wezterm_bell_probe() {
    local target_triple="$1"

    HOME="$bell_home/missing-home" _wezterm_lua "
      local handlers = {}
      local spawned = {}
      local fake_action = {
        DisableDefaultAssignment = { action = 'DisableDefaultAssignment' },
      }
      setmetatable(fake_action, {
        __index = function(_, name)
          return function(value)
            return { action = name, value = value }
          end
        end,
      })
      package.preload.wezterm = function()
        return {
          action = fake_action,
          action_callback = function(fn)
            return fn
          end,
          background_child_process = function(command)
            table.insert(spawned, command)
          end,
          config_dir = '$bell_home',
          default_hyperlink_rules = function()
            return {}
          end,
          font_with_fallback = function(names)
            return names
          end,
          glob = function()
            return {}
          end,
          on = function(name, handler)
            handlers[name] = handler
          end,
          target_triple = '$target_triple',
        }
      end

      local config_table = dofile('$bell_home/wezterm.lua')
      print(config_table.audible_bell)
      print(type(handlers.bell))
      if handlers.bell then
        handlers.bell({}, {})
      end
      print(tostring(#spawned))
      print(spawned[1] and table.concat(spawned[1], '|') or 'none')
    "
  }

  macos_bell_result=$(_wezterm_bell_probe x86_64-apple-darwin)
  _assert_eq "wezterm renders BEL audibly on macOS" \
    "$(printf 'Disabled\nfunction\n1\nafplay|/System/Library/Sounds/Glass.aiff')" \
    "$macos_bell_result"

  linux_bell_result=$(_wezterm_bell_probe x86_64-unknown-linux-gnu)
  _assert_eq "wezterm renders BEL audibly on Linux" \
    "$(printf 'Disabled\nfunction\n1\npaplay|/usr/share/sounds/freedesktop/stereo/bell.oga')" \
    "$linux_bell_result"

  windows_bell_result=$(_wezterm_bell_probe x86_64-pc-windows-msvc)
  _assert_eq "wezterm renders BEL audibly on Windows" \
    "$(printf 'Disabled\nfunction\n1\npowershell.exe|-NoProfile|-NonInteractive|-Command|[System.Media.SystemSounds]::Asterisk.Play()')" \
    "$windows_bell_result"

  unknown_bell_result=$(_wezterm_bell_probe unknown-target)
  _assert_eq "wezterm retains SystemBeep as the unknown-platform fallback" \
    "$(printf 'SystemBeep\nfunction\n0\nnone')" \
    "$unknown_bell_result"

  _wezterm_renderer_probe() {
    local target_triple="$1" adapters="$2"

    HOME="$bell_home/missing-home" _wezterm_lua "
      local fake_action = {
        DisableDefaultAssignment = { action = 'DisableDefaultAssignment' },
      }
      setmetatable(fake_action, {
        __index = function(_, name)
          return function(value)
            return { action = name, value = value }
          end
        end,
      })
      package.preload.wezterm = function()
        return {
          action = fake_action,
          action_callback = function(fn)
            return fn
          end,
          background_child_process = function() end,
          config_dir = '$bell_home',
          default_hyperlink_rules = function()
            return {}
          end,
          font_with_fallback = function(names)
            return names
          end,
          glob = function()
            return {}
          end,
          gui = {
            enumerate_gpus = function()
              return $adapters
            end,
          },
          on = function() end,
          target_triple = '$target_triple',
        }
      end

      local config_table = dofile('$bell_home/wezterm.lua')
      local adapter = config_table.webgpu_preferred_adapter
      print(tostring(config_table.front_end))
      print(tostring(config_table.webgpu_power_preference))
      print(adapter and adapter.backend or 'nil')
      print(adapter and adapter.name or 'nil')
    "
  }

  windows_renderer_result=$(_wezterm_renderer_probe x86_64-pc-windows-msvc \
    "{
      { backend = 'Vulkan', device_type = 'DiscreteGpu', name = 'Quadro Vulkan' },
      { backend = 'Dx12', device_type = 'Cpu', name = 'Basic Renderer' },
      { backend = 'Dx12', device_type = 'DiscreteGpu', name = 'Quadro DX12' },
    }")
  _assert_eq "wezterm prefers the discrete DX12 adapter on Windows" \
    "$(printf 'WebGpu\nHighPerformance\nDx12\nQuadro DX12')" \
    "$windows_renderer_result"

  windows_fallback_result=$(_wezterm_renderer_probe x86_64-pc-windows-msvc \
    "{
      { backend = 'Vulkan', device_type = 'DiscreteGpu', name = 'Quadro Vulkan' },
      { backend = 'Dx12', device_type = 'Cpu', name = 'Basic Renderer' },
    }")
  _assert_eq "wezterm leaves Windows adapter selection open when discrete DX12 is unavailable" \
    "$(printf 'WebGpu\nHighPerformance\nnil\nnil')" \
    "$windows_fallback_result"

  windows_error_result=$(_wezterm_renderer_probe x86_64-pc-windows-msvc \
    "(function() error('enumeration failed') end)()")
  _assert_eq "wezterm leaves Windows adapter selection open when GPU enumeration fails" \
    "$(printf 'WebGpu\nHighPerformance\nnil\nnil')" \
    "$windows_error_result"

  linux_renderer_result=$(_wezterm_renderer_probe x86_64-unknown-linux-gnu "{}")
  _assert_eq "wezterm enables WebGPU without pinning a Linux adapter" \
    "$(printf 'WebGpu\nnil\nnil\nnil')" \
    "$linux_renderer_result"

  macos_renderer_result=$(_wezterm_renderer_probe x86_64-apple-darwin "{}")
  _assert_eq "wezterm retains WebGPU without adapter policy on macOS" \
    "$(printf 'WebGpu\nnil\nnil\nnil')" \
    "$macos_renderer_result"

  cp "$config" "$nvim_key_home/.wezterm.lua"
  cp "$link_routes" "$nvim_key_home/link-routes.lua"
  cp "$public_link_rules" "$nvim_key_home/public-link-rules.lua"
  cp "$termnav_module" "$nvim_key_home/termnav-module.lua"
  cat >"$nvim_key_home/termnav-link-routes.lua" <<'LUA'
return {
  new = function()
    return {
      is_nvim = function(pane)
        return pane.route == "nvim"
      end,
      is_tmux = function(pane)
        return pane.route == "tmux"
      end,
      terminal_owner = function(pane)
        _G.termnav_owner_calls = (_G.termnav_owner_calls or 0) + 1
        return pane.route
      end,
      setup = function() end,
    }
  end,
}
LUA
  cat >"$nvim_key_home/termnav-public-link-rules.lua" <<'LUA'
return {
  add_public_link_rules = function(rules)
    return rules
  end,
}
LUA
  nvim_key_result=$(HOME="$nvim_key_home/missing-home" _wezterm_lua "
    local fake_action = {
      ClearSelection = { action = 'ClearSelection' },
      DisableDefaultAssignment = { action = 'DisableDefaultAssignment' },
      Nop = { action = 'Nop' },
    }
    setmetatable(fake_action, {
      __index = function(_, name)
        return function(value)
          return { action = name, value = value }
        end
      end,
    })
    package.preload.wezterm = function()
      return {
        action = fake_action,
        action_callback = function(fn)
          return fn
        end,
        config_dir = '$nvim_key_home',
        default_hyperlink_rules = function()
          return {}
        end,
        font_with_fallback = function(names)
          return names
        end,
        glob = function()
          return {}
        end,
        on = function() end,
        target_triple = 'x86_64-unknown-linux-gnu',
      }
    end

    local function has_passthrough(keys, key, mods, sent_key, sent_mods)
      for _, item in ipairs(keys) do
        local action = item.action
        local value = type(action) == 'table' and action.value or nil
        if item.key == key
          and item.mods == mods
          and type(action) == 'table'
          and action.action == 'SendKey'
          and value.key == sent_key
          and value.mods == sent_mods
        then
          return true
        end
      end
      return false
    end

    local function has_action(keys, key, mods, action_name)
      for _, item in ipairs(keys) do
        local action = item.action
        if item.key == key
          and item.mods == mods
          and type(action) == 'table'
          and action.action == action_name
        then
          return true
        end
      end
      return false
    end

    local function has_string(keys, key, mods, value)
      for _, item in ipairs(keys) do
        local action = item.action
        if item.key == key
          and item.mods == mods
          and type(action) == 'table'
          and action.action == 'SendString'
          and action.value == value
        then
          return true
        end
      end
      return false
    end

    local function has_callback(keys, key, mods)
      for _, item in ipairs(keys) do
        if item.key == key and item.mods == mods and type(item.action) == 'function' then
          return true
        end
      end
      return false
    end

    local function find_binding(keys, key, mods)
      for _, item in ipairs(keys) do
        if item.key == key and item.mods == mods then
          return item.action
        end
      end
      return nil
    end

    local function visible_controls(value)
      -- Raw ESC bytes can be interpreted by log collectors while reporting a
      -- failed aggregate comparison. Render C0 controls deterministically so
      -- the assertion is portable and its diagnostics identify the exact
      -- sequence instead of changing terminal state.
      return (value:gsub('[%z\1-\31\127]', function(character)
        return string.format('\\\\x%02x', string.byte(character))
      end))
    end

    local config_table = dofile('$nvim_key_home/.wezterm.lua')
    print(tostring(has_passthrough(config_table.keys, '.', 'CTRL', '.', 'CTRL')))
    print(tostring(has_passthrough(config_table.keys, '/', 'CTRL', '/', 'CTRL')))
    print(tostring(has_passthrough(config_table.keys, 'F2', 'NONE', 'F2', nil)))
    print(tostring(has_passthrough(config_table.keys, 'F12', 'NONE', 'F12', nil)))
    print(tostring(has_passthrough(config_table.keys, 'F12', 'SHIFT', 'F12', 'SHIFT')))
    print(tostring(has_passthrough(config_table.keys, 'v', 'CTRL|SHIFT', 'v', 'CTRL|SHIFT')))
    print(tostring(has_passthrough(config_table.keys, 'g', 'CTRL', 'g', 'CTRL')))
    print(tostring(has_passthrough(config_table.keys, 'g', 'CTRL|SHIFT', 'g', 'CTRL|SHIFT')))
    print(tostring(has_string(config_table.keys, 'e', 'CTRL|SHIFT', '\027[101;6u')))
    print(tostring(has_string(config_table.keys, 'm', 'CTRL|SHIFT', '\027[109;6u')))
    print(tostring(has_action(config_table.keys, 'f', 'CTRL|SHIFT', 'DisableDefaultAssignment')))
    print(tostring(has_action(config_table.keys, 'p', 'CTRL|SHIFT', 'DisableDefaultAssignment')))
    print(tostring(has_callback(config_table.keys, 'Tab', 'CTRL')))
    print(tostring(has_callback(config_table.keys, 'Tab', 'CTRL|SHIFT')))
    print(tostring(has_callback(config_table.keys, '{', 'ALT|SHIFT')))
    print(tostring(has_callback(config_table.keys, '}', 'ALT|SHIFT')))
    print(tostring(has_callback(config_table.keys, 'h', 'ALT|SHIFT')))
    print(tostring(has_callback(config_table.keys, 'j', 'ALT|SHIFT')))
    print(tostring(has_callback(config_table.keys, 'k', 'ALT|SHIFT')))
    print(tostring(has_callback(config_table.keys, 'l', 'ALT|SHIFT')))
    -- Ctrl-backslash already has the correct C0 encoding in WezTerm. Keeping
    -- it unbound avoids a client-specific transport path for a local
    -- tmux/Neovim operation.
    print(tostring(find_binding(config_table.keys, string.char(92), 'CTRL') == nil))

    local copy_action = find_binding(config_table.keys, 'c', 'CTRL')
    local paste_action = find_binding(config_table.keys, 'v', 'CTRL')
    local selection = ''
    local performed = {}
    local pane = {}
    local window = {
      get_selection_text_for_pane = function()
        return selection
      end,
      perform_action = function(_, action)
        table.insert(performed, action)
      end,
    }

    copy_action(window, pane)
    print(performed[1].action .. ':' .. performed[1].value.key .. ':' .. performed[1].value.mods)

    selection = 'selected terminal text'
    performed = {}
    copy_action(window, pane)
    print(performed[1].action .. ':' .. performed[1].value .. ',' .. performed[2].action)
    print(paste_action.action .. ':' .. paste_action.value)

    local ctrl_tab = find_binding(config_table.keys, 'Tab', 'CTRL')
    local ctrl_shift_tab = find_binding(config_table.keys, 'Tab', 'CTRL|SHIFT')
    performed = {}
    ctrl_tab(window, { route = 'tmux' })
    ctrl_shift_tab(window, { route = 'tmux' })
    print(performed[1].action .. ':' .. performed[1].value.key .. ':' .. performed[1].value.mods)
    print(performed[2].action .. ':' .. performed[2].value.key .. ':' .. performed[2].value.mods)
    print(tostring(_G.termnav_owner_calls))

    performed = {}
    ctrl_tab(window, { route = 'wezterm' })
    ctrl_shift_tab(window, { route = 'wezterm' })
    print(performed[1].action .. ':' .. performed[1].value)
    print(performed[2].action .. ':' .. performed[2].value)

    local pane_move_left = find_binding(config_table.keys, 'h', 'ALT|SHIFT')
    local pane_move_right = find_binding(config_table.keys, 'l', 'ALT|SHIFT')
    performed = {}
    pane_move_left(window, { route = 'tmux' })
    pane_move_right(window, { route = 'nvim' })
    print(performed[1].action .. ':' .. visible_controls(performed[1].value))
    print(performed[2].action .. ':' .. visible_controls(performed[2].value))

    performed = {}
    pane_move_left(window, { route = 'terminal' })
    print(performed[1].action)
  ")
  expected=$(
    printf '%s\n' \
      true true true true true true true false \
      true true true true true true true true true true true true true \
      'SendKey:c:CTRL' \
      'CopyTo:Clipboard,ClearSelection' \
      'PasteFrom:Clipboard' \
      'SendKey:Tab:CTRL' \
      'SendKey:Tab:CTRL|SHIFT' \
      '2' \
      'ActivateTabRelative:1' \
      'ActivateTabRelative:-1' \
      'SendString:\x1bH' \
      'SendString:\x1bL' \
      'Nop'
  )
  _assert_eq "wezterm preserves terminal chords and owns client clipboard actions" \
    "$expected" "$nvim_key_result"

  cp "$link_routes" "$route_copy_home/link-routes.lua"
  cp "$termnav_module" "$route_copy_home/termnav-module.lua"
  printf '%s\n' "return { copied = true }" >"$route_copy_home/termnav-link-routes.lua"
  route_copy_result=$(HOME="$route_copy_home/missing-home" _wezterm_lua "
    local routes = dofile('$route_copy_home/link-routes.lua')
    print(tostring(routes.copied))
  ")
  _assert_eq "link route wrapper loads copied termnav module without shdeps" \
    "true" "$route_copy_result"

  route_no_debug_result=$(HOME="$route_copy_home/missing-home" _wezterm_lua "
    debug = nil
