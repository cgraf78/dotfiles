#!/usr/bin/env bash
# clip-test - clipboard backend and history behavior.

set -o pipefail
export NO_COLOR=1

# shellcheck source=helpers.sh
. "${BASH_SOURCE[0]%/*}/helpers.sh"

clip="$HOME/.local/bin/clip"
test_root=$(_tmpdir)
backend_bin="$test_root/bin"
runtime_bin=$(_mock_bin)
data_home="$test_root/data"
copy_log="$test_root/copied"
args_log="$test_root/args"
mkdir -p "$backend_bin" "$data_home"

# Keep each backend case independent of clipboard tools installed by the host.
# In particular, macOS provides pbcopy/pbpaste in /usr/bin, which must not win
# while the Wayland, X11, and missing-backend cases are under test.
for tool in awk bash cat chmod cut date head ls mkdir mktemp mv rm sed tail tr wc; do
  ln -s "$(command -v "$tool")" "$runtime_bin/$tool"
done
# clip prefers gawk, whose -b keeps byte semantics where the C locale is UTF-8.
if command -v gawk >/dev/null 2>&1; then
  ln -s "$(command -v gawk)" "$runtime_bin/gawk"
fi
test_path="$backend_bin:$runtime_bin"

# Minimal CI images do not necessarily include diffutils/cmp. Python is an
# existing test prerequisite; compare complete bytes without shell substitution
# so NULs and trailing newlines remain significant. '-' reads piped stdin.
_clip_equal() {
  python3 -c '
import sys
from pathlib import Path

def read(name):
    return sys.stdin.buffer.read() if name == "-" else Path(name).read_bytes()

sys.exit(0 if read(sys.argv[1]) == read(sys.argv[2]) else 1)
' "$1" "$2"
}

echo "=== Clipboard backend selection ==="

cat >"$backend_bin/pbcopy" <<'EOF'
#!/usr/bin/env bash
cat >"$CLIP_TEST_COPY_LOG"
EOF
cat >"$backend_bin/pbpaste" <<'EOF'
#!/usr/bin/env bash
printf '%s' 'macOS clipboard'
EOF
chmod +x "$backend_bin/pbcopy" "$backend_bin/pbpaste"

printf '%s' 'macOS copy' |
  env PATH="$test_path" XDG_DATA_HOME="$data_home" \
    CLIP_TEST_COPY_LOG="$copy_log" "$clip" copy
_assert_file_content "clip copy uses pbcopy on macOS" "macOS copy" "$copy_log"
macos_paste=$(env PATH="$test_path" XDG_DATA_HOME="$data_home" \
  CLIP_TEST_COPY_LOG="$copy_log" "$clip" paste)
_assert_eq "clip paste uses pbpaste on macOS" "macOS clipboard" "$macos_paste"
rm -f "$backend_bin/pbcopy" "$backend_bin/pbpaste" "$copy_log"

cat >"$backend_bin/wl-copy" <<'EOF'
#!/usr/bin/env bash
cat >"$CLIP_TEST_COPY_LOG"
printf '%s\n' "$*" >"$CLIP_TEST_ARGS_LOG"
EOF
cat >"$backend_bin/wl-paste" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >"$CLIP_TEST_ARGS_LOG"
printf '%s' 'wayland clipboard'
EOF
chmod +x "$backend_bin/wl-copy" "$backend_bin/wl-paste"

printf '%s' 'wayland copy' |
  env PATH="$test_path" XDG_DATA_HOME="$data_home" \
    WAYLAND_DISPLAY=wayland-0 CLIP_TEST_COPY_LOG="$copy_log" \
    CLIP_TEST_ARGS_LOG="$args_log" "$clip" copy
_assert_file_content "clip copy uses wl-copy in a Wayland session" \
  "wayland copy" "$copy_log"
_assert_file_content "clip copy does not add unsupported wl-copy arguments" \
  "" "$args_log"

wayland_paste=$(env PATH="$test_path" XDG_DATA_HOME="$data_home" \
  WAYLAND_DISPLAY=wayland-0 CLIP_TEST_COPY_LOG="$copy_log" \
  CLIP_TEST_ARGS_LOG="$args_log" "$clip" paste)
_assert_eq "clip paste reads the Wayland clipboard" \
  "wayland clipboard" "$wayland_paste"
_assert_file_content "clip paste suppresses wl-paste's synthetic trailing newline" \
  "--no-newline" "$args_log"

rm -f "$backend_bin/wl-copy" "$backend_bin/wl-paste"
cat >"$backend_bin/xclip" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >"$CLIP_TEST_ARGS_LOG"
if [[ " $* " == *" -o "* ]]; then
  printf '%s' 'x11 clipboard'
else
  cat >"$CLIP_TEST_COPY_LOG"
fi
EOF
chmod +x "$backend_bin/xclip"

printf '%s' 'x11 copy' |
  env PATH="$test_path" XDG_DATA_HOME="$data_home" \
    DISPLAY=:0 CLIP_TEST_COPY_LOG="$copy_log" CLIP_TEST_ARGS_LOG="$args_log" \
    "$clip" copy
_assert_file_content "clip copy uses xclip in an X11 session" "x11 copy" "$copy_log"
_assert_file_content "clip copy selects the X11 clipboard" \
  "-selection clipboard" "$args_log"

x11_paste=$(env PATH="$test_path" XDG_DATA_HOME="$data_home" \
  DISPLAY=:0 CLIP_TEST_COPY_LOG="$copy_log" CLIP_TEST_ARGS_LOG="$args_log" \
  "$clip" paste)
_assert_eq "clip paste reads the X11 clipboard" "x11 clipboard" "$x11_paste"
_assert_file_content "clip paste selects the X11 clipboard" \
  "-o -selection clipboard" "$args_log"

echo
echo "=== tmux capture behavior ==="

rm -f "$backend_bin/xclip" "$copy_log" "$args_log"
remote_data="$test_root/remote-data"
capture_rc=0
printf '%s' 'remote selection' |
  env PATH="$runtime_bin" XDG_DATA_HOME="$remote_data" "$clip" capture || capture_rc=$?
_assert_exit "clip capture succeeds without a host clipboard backend" 0 "$capture_rc"
remote_history=$(printf '%s\n' "$remote_data/clip"/* | head -1)
_assert_file_content "clip capture preserves remote tmux selections in history" \
  "remote selection" "$remote_history"

cat >"$backend_bin/wl-copy" <<'EOF'
#!/usr/bin/env bash
exit 17
EOF
chmod +x "$backend_bin/wl-copy"
failed_backend_data="$test_root/failed-backend-data"
capture_rc=0
printf '%s' 'selection despite failed backend' |
  env PATH="$test_path" XDG_DATA_HOME="$failed_backend_data" \
    WAYLAND_DISPLAY=wayland-0 "$clip" capture >/dev/null 2>&1 || capture_rc=$?
_assert_exit "clip capture survives a broken optional host backend" 0 "$capture_rc"
failed_backend_history=$(printf '%s\n' "$failed_backend_data/clip"/* | head -1)
_assert_file_content "clip capture records history before an optional backend fails" \
  "selection despite failed backend" "$failed_backend_history"
rm -f "$backend_bin/wl-copy"

copy_rc=0
printf '%s' 'no backend' |
  env PATH="$runtime_bin" XDG_DATA_HOME="$test_root/no-backend-copy" \
    "$clip" copy >/dev/null 2>&1 || copy_rc=$?
_assert_exit "clip copy still reports a missing direct clipboard backend" 1 "$copy_rc"

paste_rc=0
env PATH="$runtime_bin" XDG_DATA_HOME="$test_root/no-backend-paste" \
  "$clip" paste >/dev/null 2>&1 || paste_rc=$?
_assert_exit "clip paste reports when no host clipboard is readable" 1 "$paste_rc"

echo
echo "=== Clipboard fidelity and private publication ==="

cat >"$backend_bin/pbcopy" <<'EOF'
#!/usr/bin/env bash
cat >"$CLIP_TEST_COPY_LOG"
EOF
chmod +x "$backend_bin/pbcopy"
fidelity_data="$test_root/fidelity"
payload="$test_root/payload"
printf 'first\nsecond\n\n' >"$payload"
env PATH="$test_path" XDG_DATA_HOME="$fidelity_data" \
  CLIP_TEST_COPY_LOG="$copy_log" "$clip" copy <"$payload"
_clip_equal "$payload" "$copy_log"
_assert_exit "copy preserves every trailing newline" 0 "$?"
history_files=("$fidelity_data/clip"/*)
_clip_equal "$payload" "${history_files[0]}"
_assert_exit "history preserves every trailing newline" 0 "$?"

binary_data="$test_root/binary"
printf 'before\000after\033]52;c;not-a-command\007\n' >"$payload"
env PATH="$test_path" XDG_DATA_HOME="$binary_data" \
  CLIP_TEST_COPY_LOG="$copy_log" "$clip" capture <"$payload"
_clip_equal "$payload" "$copy_log"
_assert_exit "capture preserves NUL and terminal-control bytes" 0 "$?"
history_files=("$binary_data/clip"/*)
_clip_equal "$payload" "${history_files[0]}"
_assert_exit "history preserves arbitrary bytes" 0 "$?"

private_data="$test_root/private"
(
  umask 000
  printf 'private' | env PATH="$test_path" \
    XDG_DATA_HOME="$private_data" CLIP_TEST_COPY_LOG="$copy_log" "$clip" capture
)
_clip_mode() {
  if stat -c '%a' "$1" 2>/dev/null; then return; fi
  stat -f '%Lp' "$1"
}
_assert_eq "history directory is private under permissive umask" 700 \
  "$(_clip_mode "$private_data/clip")"
history_files=("$private_data/clip"/*)
_assert_eq "history entry is private from creation" 600 \
  "$(_clip_mode "${history_files[0]}")"

unsafe_data="$test_root/unsafe"
mkdir -p "$unsafe_data" "$test_root/elsewhere"
ln -s "$test_root/elsewhere" "$unsafe_data/clip"
printf 'must not escape' | env PATH="$test_path" XDG_DATA_HOME="$unsafe_data" \
  CLIP_TEST_COPY_LOG="$copy_log" "$clip" capture >/dev/null 2>&1
_assert_exit "history refuses a symlink directory" 1 "$?"
escaped_files=("$test_root/elsewhere"/*)
_assert_eq "unsafe history creates no payload outside its directory" \
  "$test_root/elsewhere/*" "${escaped_files[0]}"

empty_data="$test_root/empty"
: >"$payload"
env PATH="$test_path" XDG_DATA_HOME="$empty_data" \
  CLIP_TEST_COPY_LOG="$copy_log" "$clip" capture <"$payload"
history_files=("$empty_data/clip"/*)
_clip_equal "$payload" "${history_files[0]}"
_assert_exit "an empty capture remains an exact history entry" 0 "$?"

# An fzf substitute selects only the first offered opaque ID. Preview/list
# output must escape control bytes, but selecting still returns the originals.
cat >"$backend_bin/fzf" <<'EOF'
#!/usr/bin/env bash
if [[ ${CLIP_TEST_PICK_CANCEL:-0} == 1 ]]; then exit 130; fi
IFS= read -r selected
if [[ -n ${CLIP_TEST_PICK_PREVIEW:-} ]]; then
  for arg in "$@"; do
    if [[ $arg == --preview=* ]]; then
      preview=${arg#--preview=}
      preview=${preview//\{\}/$selected}
      bash -c "$preview" >"$CLIP_TEST_PICK_PREVIEW"
    fi
  done
fi
printf '%s\n' "$selected"
EOF
chmod +x "$backend_bin/fzf"
env PATH="$test_path" XDG_DATA_HOME="$binary_data" "$clip" list >"$test_root/listed"
if LC_ALL=C tr -d '\11\12\15\40-\176' <"$test_root/listed" | _clip_equal - /dev/null; then
  _pass "history list never emits raw terminal-control bytes"
else
  _fail "history list never emits raw terminal-control bytes"
fi
env PATH="$test_path" XDG_DATA_HOME="$binary_data" "$clip" pick >"$test_root/picked"
history_files=("$binary_data/clip"/*)
_clip_equal "${history_files[0]}" "$test_root/picked"
_assert_exit "picker emits original arbitrary bytes" 0 "$?"
env PATH="$test_path" XDG_DATA_HOME="$binary_data" CLIP_TEST_PICK_CANCEL=1 \
  "$clip" pick >"$test_root/cancelled"
_assert_exit "picker preserves cancellation status" 130 "$?"
_assert_eq "cancelled picker emits no payload" 0 "$(wc -c <"$test_root/cancelled" | tr -d ' ')"

# BusyBox configurations can silently ignore sed's unsupported `l` command.
# Model that behavior: a control-safety assertion alone accepts an empty preview.
cat >"$backend_bin/sed" <<'EOF'
#!/usr/bin/env bash
if [[ "$*" == '-n l' ]]; then cat >/dev/null; exit 0; fi
exec "$CLIP_TEST_REAL_SED" "$@"
EOF
chmod +x "$backend_bin/sed"
preview_data="$test_root/preview"
mkdir -p "$preview_data/clip"
printf 'visible unterminated entry' >"$preview_data/clip/plain"
preview_output=$(env PATH="$test_path" XDG_DATA_HOME="$preview_data" \
  CLIP_TEST_REAL_SED="$(command -v sed)" "$clip" list)
_assert_eq "history list preserves visible unterminated text without sed list support" \
  'plain  visible unterminated entry' "$preview_output"
env PATH="$test_path" XDG_DATA_HOME="$preview_data" \
  CLIP_TEST_REAL_SED="$(command -v sed)" CLIP_TEST_PICK_PREVIEW="$test_root/previewed" \
  "$clip" pick >"$test_root/preview-picked"
_assert_file_content "picker preview preserves visible unterminated text without sed list support" \
  'visible unterminated entry' "$test_root/previewed"
_clip_equal "$preview_data/clip/plain" "$test_root/preview-picked"
_assert_exit "safe preview leaves selected bytes unchanged" 0 "$?"
rm -f "$backend_bin/sed"

echo
echo "=== Clipboard failure and targeting boundaries ==="

cat >"$backend_bin/tmux-clip-paste" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >"$CLIP_TEST_HANDOFF_ARGS"
cat >"$CLIP_TEST_HANDOFF"
EOF
chmod +x "$backend_bin/tmux-clip-paste"
env PATH="$test_path" XDG_DATA_HOME="$binary_data" \
  CLIP_TEST_HANDOFF="$test_root/handoff" CLIP_TEST_HANDOFF_ARGS="$args_log" \
  "$clip" pick --publish-pane %7
_clip_equal "${history_files[0]}" "$test_root/handoff"
_assert_exit "picker publishes original bytes through the atomic handoff" 0 "$?"
_assert_file_content "picker pins the originating pane" '--pane %7 --publish' "$args_log"
printf 'previous handoff' >"$test_root/handoff"
env PATH="$test_path" XDG_DATA_HOME="$binary_data" CLIP_TEST_PICK_CANCEL=1 \
  CLIP_TEST_HANDOFF="$test_root/handoff" CLIP_TEST_HANDOFF_ARGS="$args_log" \
  "$clip" pick --publish-pane %7 >/dev/null
_assert_exit "cancelled publication preserves picker status" 130 "$?"
_assert_file_content "cancellation never truncates the prior handoff" \
  'previous handoff' "$test_root/handoff"

cat >"$backend_bin/tmux" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$CLIP_TEST_TMUX_LOG"
case "$1" in
  display-message)
    # tmux 3.2 takes no argument to -c.
    if [[ -n ${CLIP_TEST_NO_C:-} && " $* " == *' -c '* ]]; then exit 1
    elif [[ " $* " != *' -p '* ]]; then exit 0
    else
      printf '%s %s s%s\n' "${CLIP_TEST_PANE:-%7}" "${CLIP_TEST_CLIPBOARD:-on}" \
        "${CLIP_TEST_SEQ:-}"
    fi ;;
  # A client of another session is listed too, and first.
  list-clients) printf '/dev/ttys009\n%s\n' "${CLIP_TEST_CLIENT:-/dev/ttys007}" ;;
  # The newest buffer is first; a later look can see a newer copy.
  list-buffers)
    looks=0
    while IFS= read -r call; do [[ $call != list-buffers* ]] || looks=$((looks + 1)); done \
      <"$CLIP_TEST_TMUX_LOG"
    if ((looks > 1)); then
      printf '%s\nbuffer3:100\n' "${CLIP_TEST_TOP_LATER:-buffer4:100}"
    else printf 'buffer4:100\nbuffer3:100\n'; fi ;;
  load-buffer) cat >"$CLIP_TEST_COPY_LOG" ;;
  *) exit 31 ;;
esac
EOF
chmod +x "$backend_bin/tmux"
printf 'client bytes\n\n' >"$payload"
env PATH="$test_path" XDG_DATA_HOME="$test_root/client-history" \
  CLIP_TEST_TMUX_LOG="$test_root/tmux-log" CLIP_TEST_COPY_LOG="$copy_log" \
  "$clip" copy --client /dev/ttys007 --pane %7 <"$payload"
_assert_exit "explicit client copy succeeds" 0 "$?"
_clip_equal "$payload" "$copy_log"
_assert_exit "explicit client transport preserves exact bytes" 0 "$?"
_assert_contains "explicit client is used for clipboard transport" \
  'load-buffer -w -t /dev/ttys007 -' "$(cat "$test_root/tmux-log")"
rm -f "$test_root/tmux-log" "$copy_log"
env PATH="$test_path" XDG_DATA_HOME="$test_root/client-missing" \
  CLIP_TEST_TMUX_LOG="$test_root/tmux-log" CLIP_TEST_COPY_LOG="$copy_log" \
  CLIP_TEST_CLIENT=/dev/ttys008 \
  "$clip" copy --client /dev/ttys007 --pane %7 <"$payload" >/dev/null 2>&1
_assert_exit "a different attached client never receives the selection" 1 "$?"
if [[ ! -e "$copy_log" ]]; then
  _pass "a missing initiating client triggers no native fallback"
else
  _fail "a missing initiating client triggers no native fallback"
fi

history_files=("$test_root/client-missing/clip"/*)
_clip_equal "$payload" "${history_files[0]}"
_assert_exit "a detached initiating client leaves a recoverable exact selection" 0 "$?"

rm -f "$copy_log"
env PATH="$test_path" XDG_DATA_HOME="$test_root/pane-missing" \
  CLIP_TEST_TMUX_LOG="$test_root/pane-missing-log" CLIP_TEST_COPY_LOG="$copy_log" \
  CLIP_TEST_PANE=%8 "$clip" copy --client /dev/ttys007 --pane %7 <"$payload" \
  >/dev/null 2>&1
_assert_exit "a changed source pane cannot dispatch a stale copy" 1 "$?"
if [[ ! -e "$copy_log" ]]; then
  _pass "stale source copy never touches the workstation clipboard"
else
  _fail "stale source copy never touches the workstation clipboard"
fi

# set-clipboard off keeps a cleaned copy in tmux's buffer, off the
# clipboard, as copy mode's own copies stay.
rm -f "$test_root/tmux-log" "$copy_log"
env PATH="$test_path" XDG_DATA_HOME="$test_root/clipboard-off" \
  CLIP_TEST_TMUX_LOG="$test_root/tmux-log" CLIP_TEST_COPY_LOG="$copy_log" \
  CLIP_TEST_CLIPBOARD=off "$clip" copy --clean --width 40 --client /dev/ttys007 --pane %7 \
  <"$payload"
_clip_equal "$payload" "$copy_log"
_assert_exit "set-clipboard off still fills the tmux buffer" 0 "$?"
_assert_contains "set-clipboard off loads the buffer without -w" \
  'load-buffer -' "$(cat "$test_root/tmux-log")"
_assert_not_contains "set-clipboard off sends nothing to the clipboard" \
  'load-buffer -w' "$(cat "$test_root/tmux-log")"
# A plain client copy, prefix o's, writes the clipboard whatever the option.
rm -f "$test_root/tmux-log" "$copy_log"
env PATH="$test_path" XDG_DATA_HOME="$test_root/clipboard-off" \
  CLIP_TEST_TMUX_LOG="$test_root/tmux-log" CLIP_TEST_COPY_LOG="$copy_log" \
  CLIP_TEST_CLIPBOARD=off "$clip" copy --client /dev/ttys007 --pane %7 <"$payload"
_assert_contains "a plain client copy ignores set-clipboard off" \
  'load-buffer -w -t /dev/ttys007 -' "$(cat "$test_root/tmux-log")"

# A copy overtaken by a newer one (tmux's CLIP_COPY_SEQ moved on) records
# history but publishes nothing; the current one publishes.
rm -f "$copy_log"
env PATH="$test_path" XDG_DATA_HOME="$test_root/overtaken" \
  CLIP_TEST_TMUX_LOG="$test_root/tmux-log" CLIP_TEST_COPY_LOG="$copy_log" \
  CLIP_TEST_SEQ=8 "$clip" copy --seq s7 --client /dev/ttys007 --pane %7 <"$payload"
_assert_exit "an overtaken copy is not an error" 0 "$?"
_assert_file_missing "an overtaken copy does not publish" "$copy_log"
history_files=("$test_root/overtaken/clip"/*)
_clip_equal "$payload" "${history_files[0]}"
_assert_exit "an overtaken copy is still recorded" 0 "$?"
env PATH="$test_path" XDG_DATA_HOME="$test_root/overtaken" \
  CLIP_TEST_TMUX_LOG="$test_root/tmux-log" CLIP_TEST_COPY_LOG="$copy_log" \
  CLIP_TEST_SEQ=8 "$clip" copy --seq s8 --client /dev/ttys007 --pane %7 <"$payload"
_clip_equal "$payload" "$copy_log"
_assert_exit "the newest copy publishes" 0 "$?"
_assert_not_contains "the client is found among all clients, not by display-message -c" \
  'display-message -p -c' "$(cat "$test_root/tmux-log")"
# Any other copy made while this one cleaned adds a newer tmux buffer, and
# wins.
rm -f "$copy_log" "$test_root/tmux-log"
env PATH="$test_path" XDG_DATA_HOME="$test_root/raw-overtaken" \
  CLIP_TEST_TMUX_LOG="$test_root/tmux-log" CLIP_TEST_COPY_LOG="$copy_log" \
  CLIP_TEST_SEQ=8 CLIP_TEST_TOP_LATER=buffer5:101 \
  "$clip" copy --seq s8 --client /dev/ttys007 --pane %7 <"$payload"
_assert_exit "a copy overtaken by a newer buffer is not an error" 0 "$?"
_assert_file_missing "a copy overtaken by a newer buffer does not publish" "$copy_log"
history_files=("$test_root/raw-overtaken/clip"/*)
_clip_equal "$payload" "${history_files[0]}"
_assert_exit "a copy overtaken by a newer buffer is still recorded" 0 "$?"

# An unusable history must not cost a client copy: it publishes unrecorded.
rm -f "$copy_log" "$test_root/tmux-log"
mkdir -p "$test_root/no-history" "$test_root/elsewhere-history"
ln -s "$test_root/elsewhere-history" "$test_root/no-history/clip"
env PATH="$test_path" XDG_DATA_HOME="$test_root/no-history" \
  CLIP_TEST_TMUX_LOG="$test_root/tmux-log" CLIP_TEST_COPY_LOG="$copy_log" \
  "$clip" copy --clean --width 40 --client /dev/ttys007 --pane %7 <"$payload" 2>/dev/null
_assert_exit "a client copy survives an unusable history" 0 "$?"
_clip_equal "$payload" "$copy_log"
_assert_exit "an unusable history publishes the selection as captured" 0 "$?"
_assert_contains "an unusable history is reported to the client" \
  'display-message -c /dev/ttys007 -t %7 clip: history unavailable' "$(cat "$test_root/tmux-log")"
# tmux 3.2 cannot aim a message at a client; the notice still shows.
rm -f "$copy_log" "$test_root/tmux-log"
env PATH="$test_path" XDG_DATA_HOME="$test_root/no-history" CLIP_TEST_NO_C=1 \
  CLIP_TEST_TMUX_LOG="$test_root/tmux-log" CLIP_TEST_COPY_LOG="$copy_log" \
  "$clip" copy --clean --width 40 --client /dev/ttys007 --pane %7 <"$payload" 2>/dev/null
_assert_exit "a client copy works where display-message has no -c" 0 "$?"
_clip_equal "$payload" "$copy_log"
_assert_exit "a client copy publishes where display-message has no -c" 0 "$?"
_assert_contains "without display-message -c the notice goes to the pane's client" \
  'display-message -t %7 clip: history unavailable' "$(cat "$test_root/tmux-log")"

printf 'unchanged workstation clipboard' >"$copy_log"
env PATH="$test_path" XDG_DATA_HOME="$test_root/history-only" \
  CLIP_TEST_COPY_LOG="$copy_log" "$clip" capture --history-only <"$payload"
_assert_exit "history-only capture succeeds" 0 "$?"
_assert_file_content "history-only capture never adds a second clipboard writer" \
  'unchanged workstation clipboard' "$copy_log"
history_files=("$test_root/history-only/clip"/*)
_clip_equal "$payload" "${history_files[0]}"
_assert_exit "history-only capture preserves exact recovery bytes" 0 "$?"

cat >"$backend_bin/pbcopy" <<'EOF'
#!/usr/bin/env bash
cat >/dev/null
exit 17
EOF
chmod +x "$backend_bin/pbcopy"
failed_copy_data="$test_root/failed-copy"
env PATH="$test_path" XDG_DATA_HOME="$failed_copy_data" \
  "$clip" copy <"$payload" >/dev/null 2>&1
_assert_exit "direct copy reports a backend failure" 17 "$?"
history_files=("$failed_copy_data/clip"/*)
_clip_equal "$payload" "${history_files[0]}"
_assert_exit "failed copy retains an exact private recovery entry" 0 "$?"

cat >"$backend_bin/cat" <<'EOF'
#!/usr/bin/env bash
printf 'partial producer output'
exit 23
EOF
chmod +x "$backend_bin/cat"
failed_read_data="$test_root/failed-read"
env PATH="$test_path" XDG_DATA_HOME="$failed_read_data" \
  "$clip" capture <"$payload" >/dev/null 2>&1
_assert_exit "capture reports an interrupted producer" 23 "$?"
rm -f "$backend_bin/cat"
failed_entries=("$failed_read_data/clip"/* "$failed_read_data/clip"/.[!.]*)
_assert_eq "failed producer publishes no partial entry" \
  "$failed_read_data/clip/*" "${failed_entries[0]}"
_assert_eq "failed producer removes its exact temporary file" \
  "$failed_read_data/clip/.[!.]*" "${failed_entries[1]}"

cat >"$backend_bin/mv" <<'EOF'
#!/usr/bin/env bash
exit 29
EOF
chmod +x "$backend_bin/mv"
before_entry="${history_files[0]}"
cp "$before_entry" "$test_root/prior"
env PATH="$test_path" XDG_DATA_HOME="$failed_copy_data" \
  "$clip" capture <"$payload" >/dev/null 2>&1
_assert_exit "capture reports failed publication" 29 "$?"
rm -f "$backend_bin/mv"
_clip_equal "$before_entry" "$test_root/prior"
_assert_exit "failed publication leaves the prior entry intact" 0 "$?"

cat >"$backend_bin/fzf" <<'EOF'
#!/usr/bin/env bash
cat >/dev/null
printf '../../outside\n'
EOF
chmod +x "$backend_bin/fzf"
env PATH="$test_path" XDG_DATA_HOME="$binary_data" \
  "$clip" pick >"$test_root/untrusted-pick"
_assert_exit "picker refuses an arbitrary returned pathname" 1 "$?"
_assert_eq "an untrusted picker result emits no bytes" 0 \
  "$(wc -c <"$test_root/untrusted-pick" | tr -d ' ')"

cat >"$backend_bin/pbpaste" <<'EOF'
#!/usr/bin/env bash
printf 'native\n\n'
exit "${CLIP_TEST_PASTE_STATUS:-0}"
EOF
chmod +x "$backend_bin/pbpaste"
env PATH="$test_path" XDG_DATA_HOME="$test_root/paste-handoff" \
  CLIP_TEST_HANDOFF="$test_root/native-handoff" CLIP_TEST_HANDOFF_ARGS="$args_log" \
  "$clip" paste --publish-pane %7
_assert_exit "native paste supports successful atomic publication" 0 "$?"
printf 'native\n\n' >"$test_root/native-expected"
_clip_equal "$test_root/native-expected" "$test_root/native-handoff"
_assert_exit "native paste handoff preserves trailing newlines" 0 "$?"
env PATH="$test_path" XDG_DATA_HOME="$test_root/paste-handoff" \
  CLIP_TEST_HANDOFF="$test_root/native-handoff" CLIP_TEST_HANDOFF_ARGS="$args_log" \
  CLIP_TEST_PASTE_STATUS=37 "$clip" paste --publish-pane %7 >/dev/null 2>&1
_assert_exit "failed native paste retains backend status" 37 "$?"
_clip_equal "$test_root/native-expected" "$test_root/native-handoff"
_assert_exit "a failed native producer never replaces the prior handoff" 0 "$?"

echo
echo "=== Concurrent history writers and hostile entries ==="
concurrent_data="$test_root/concurrent"
writer_pids=()
for ((writer = 0; writer < 12; writer++)); do
  printf 'writer %s\n\n' "$writer" | env PATH="$runtime_bin" \
    XDG_DATA_HOME="$concurrent_data" "$clip" capture &
  writer_pids+=("$!")
done
writers_ok=0
for writer_pid in "${writer_pids[@]}"; do
  wait "$writer_pid" || writers_ok=1
done
_assert_exit "concurrent history writers all complete" 0 "$writers_ok"
history_files=("$concurrent_data/clip"/*)
_assert_eq "concurrent captures never collide" 12 "${#history_files[@]}"
for ((writer = 0; writer < 12; writer++)); do
  printf 'writer %s\n\n' "$writer" >"$test_root/expected-writer"
  found_writer=0
  for history_file in "${history_files[@]}"; do
    if _clip_equal "$test_root/expected-writer" "$history_file"; then
      found_writer=1
      break
    fi
  done
  _assert_eq "concurrent writer $writer retains its exact payload" 1 "$found_writer"
done
printf 'outside fixture content' >"$test_root/outside-entry"
ln -s "$test_root/outside-entry" "$concurrent_data/clip/untrusted-link"
env PATH="$test_path" XDG_DATA_HOME="$concurrent_data" \
  "$clip" list >"$test_root/list-with-symlink"
if [[ $(cat "$test_root/list-with-symlink") != *'outside fixture content'* ]]; then
  _pass "history listing never follows an entry symlink"
else
  _fail "history listing never follows an entry symlink"
fi
chmod 755 "$concurrent_data/clip"
chmod 644 "${history_files[0]}"
env PATH="$test_path" XDG_DATA_HOME="$concurrent_data" "$clip" list >/dev/null
_assert_eq "reading an older history tightens its directory" 700 \
  "$(_clip_mode "$concurrent_data/clip")"
_assert_eq "reading an older history tightens existing payloads" 600 \
  "$(_clip_mode "${history_files[0]}")"

echo
echo "=== Operation-isolated paste transactions ==="
cat >"$backend_bin/tmux-clip-paste" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >"$CLIP_TEST_HANDOFF_ARGS"
if [[ "$1" == --file ]]; then
  if [[ ${CLIP_TEST_DELIVERY_FAIL:-0} != 0 ]]; then exit 41; fi
  cat "$2" >"$CLIP_TEST_HANDOFF"
  rm -f "$2"
else
  cat >"$CLIP_TEST_HANDOFF"
fi
EOF
cat >"$backend_bin/pbpaste" <<'EOF'
#!/usr/bin/env bash
cat "$CLIP_TEST_NATIVE_FILE"
EOF
chmod +x "$backend_bin/tmux-clip-paste" "$backend_bin/pbpaste"
printf 'first concurrent paste\n\n' >"$test_root/native-one"
printf 'second concurrent paste\n\n' >"$test_root/native-two"
paste_pids=()
for paste_name in one two; do
  env PATH="$test_path" XDG_DATA_HOME="$test_root/isolated-paste" \
    CLIP_TEST_NATIVE_FILE="$test_root/native-$paste_name" \
    CLIP_TEST_HANDOFF="$test_root/delivered-$paste_name" \
    CLIP_TEST_HANDOFF_ARGS="$test_root/delivery-args-$paste_name" \
    "$clip" paste --paste-pane %7 &
  paste_pids+=("$!")
done
paste_status=0
for paste_pid in "${paste_pids[@]}"; do wait "$paste_pid" || paste_status=1; done
_assert_exit "concurrent same-pane paste transactions complete" 0 "$paste_status"
for paste_name in one two; do
  _clip_equal "$test_root/native-$paste_name" "$test_root/delivered-$paste_name"
  _assert_exit "concurrent transaction $paste_name delivers only its own bytes" 0 "$?"
done
if [[ $(cat "$test_root/delivery-args-one") != "$(cat "$test_root/delivery-args-two")" ]]; then
  _pass "same-pane transactions use distinct private handoff paths"
else
  _fail "same-pane transactions use distinct private handoff paths"
fi
env PATH="$test_path" XDG_DATA_HOME="$test_root/failed-delivery" \
  CLIP_TEST_NATIVE_FILE="$test_root/native-one" CLIP_TEST_DELIVERY_FAIL=1 \
  CLIP_TEST_HANDOFF="$test_root/not-delivered" CLIP_TEST_HANDOFF_ARGS="$args_log" \
  "$clip" paste --paste-pane %7 2>"$test_root/delivery-error"
_assert_exit "failed isolated paste preserves helper error status" 41 "$?"
retained_file=$(sed -n 's/^clip: paste failed; private payload retained at: //p' "$test_root/delivery-error")
_clip_equal "$test_root/native-one" "$retained_file"
_assert_exit "failed isolated paste leaves an actionable exact recovery file" 0 "$?"

: >"$payload"
env PATH="$test_path" XDG_DATA_HOME="$test_root/empty-client" \
  CLIP_TEST_TMUX_LOG="$test_root/empty-client-log" CLIP_TEST_COPY_LOG="$copy_log" \
  "$clip" copy --client /dev/ttys007 --pane %7 <"$payload" \
  >/dev/null 2>"$test_root/empty-client-error"
_assert_exit "empty exact-client copy does not falsely claim clipboard clearing" 1 "$?"
history_files=("$test_root/empty-client/clip"/*)
_clip_equal "$payload" "${history_files[0]}"
_assert_exit "unsupported empty client clear still preserves exact history" 0 "$?"

echo
echo "=== Agent transcript cleaning ==="

# Each fixture is a selection copied from an agent pane, named for the pane
# width it was wrapped at (.wN) and, when it starts mid-row, the column of its
# first line (.cN). Most are real Claude Code and Codex captures; the rest are
# shaped like them to reach the edge cases. shell-* fixtures are ordinary
# command output, which cleaning must leave byte for byte.
fixtures="${BASH_SOURCE[0]%/*}/support/clip-clean"
fixture_count=0
for input in "$fixtures"/*.in; do
  name=${input##*/}
  name=${name%.in}
  width=${name#*.w}
  width=${width%%.*}
  clean_args=(--width "$width")
  case $name in *.c[0-9]*) clean_args+=(--column "${name##*.c}") ;; esac
  expected=${input%.in}.out
  case $name in shell-*) expected=$input ;; esac
  env PATH="$runtime_bin" TMPDIR="$test_root" \
    "$clip" clean "${clean_args[@]}" <"$input" >"$test_root/cleaned"
  _assert_exit "clip clean accepts $name" 0 "$?"
  _clip_equal "$expected" "$test_root/cleaned"
  _assert_exit "clip clean gives the expected text for $name" 0 "$?"
  # Rejoined text is already whole, so cleaning it again changes nothing.
  # Tool output is the exception: once its marker is gone, nothing marks its
  # rows as records.
  case $name in
    *-tool*) ;;
    *)
      env PATH="$runtime_bin" TMPDIR="$test_root" \
        "$clip" clean --width "$width" <"$test_root/cleaned" >"$test_root/recleaned"
      _clip_equal "$test_root/cleaned" "$test_root/recleaned"
      _assert_exit "clip clean is idempotent for $name" 0 "$?"
      ;;
  esac
  fixture_count=$((fixture_count + 1))
done
if ((fixture_count >= 10)); then
  _pass "clip clean fixture corpus is present ($fixture_count fixtures)"
else
  _fail "clip clean fixture corpus is present ($fixture_count fixtures)"
fi

# Pairs of real lines of code, commands and records that must stay apart
# even when the first reaches the edge of the pane or comes within a word
# of it, which is how a wrapped row would look.
apart_failures=''
while IFS= read -r pair; do
  first=${pair%% ||| *}
  second=${pair#* ||| }
  for extra in 0 1 3; do
    pair_width=$((${#first} + 2 + extra))
    printf '● Code:\n\n  %s\n  %s\n' "$first" "$second" >"$test_root/pair.in"
    env PATH="$runtime_bin" TMPDIR="$test_root" "$clip" clean --width "$pair_width" \
      <"$test_root/pair.in" >"$test_root/pair.out"
    [[ $(wc -l <"$test_root/pair.out") -eq 4 ]] ||
      apart_failures+="w$pair_width: $first | $second; "
  done
done <"$fixtures/stays-apart.pairs"
_assert_eq "clip clean keeps every pair of code lines apart" '' "$apart_failures"

# Git stores fixtures with LF endings, so give the CRLF case its CRs here.
awk '{ printf "%s\r\n", $0 }' "$fixtures/crlf.w52.in" >"$test_root/crlf.in"
env PATH="$runtime_bin" TMPDIR="$test_root" "$clip" clean --width 52 \
  <"$test_root/crlf.in" >"$test_root/cleaned"
_clip_equal "$fixtures/crlf.w52.out" "$test_root/cleaned"
_assert_exit "clip clean drops CR line endings before judging rows" 0 "$?"

# A reply that was never wrapped, as in a pane wider than any of its rows,
# loses only its markers and margin.
env PATH="$runtime_bin" TMPDIR="$test_root" "$clip" clean --width 200 \
  <"$fixtures/claude-reply.w80.in" >"$test_root/unwrapped"
_assert_eq "clip clean joins no rows of an unwrapped reply" \
  "$(wc -l <"$fixtures/claude-reply.w80.in")" "$(wc -l <"$test_root/unwrapped")"
_assert_eq "clip clean removes the reply marker and margin" \
  'The copy filter has to rejoin paragraphs like this one, which is deliberately' \
  "$(head -n 1 "$test_root/unwrapped")"

printf 'only line' | env PATH="$runtime_bin" TMPDIR="$test_root" \
  "$clip" clean --width 80 >"$test_root/cleaned"
_assert_file_content "clip clean keeps a missing final newline missing" \
  'only line' "$test_root/cleaned"
_assert_eq "clip clean keeps an empty selection empty" 0 \
  "$(env PATH="$runtime_bin" TMPDIR="$test_root" "$clip" clean --width 80 </dev/null |
    wc -c | tr -d ' ')"

for invalid in 'clean' 'clean --width 0' 'clean --width 80 --column x' \
  'copy --width 80' 'copy --clean' 'capture --clean --width 80' \
  'clean --width 80 --clean'; do
  # shellcheck disable=SC2086 # Each case is a deliberately split argument list.
  env PATH="$runtime_bin" "$clip" $invalid </dev/null >/dev/null 2>&1
  _assert_exit "clip rejects: $invalid" 2 "$?"
done

cat >"$backend_bin/pbcopy" <<'EOF'
#!/usr/bin/env bash
cat >"$CLIP_TEST_COPY_LOG"
EOF
chmod +x "$backend_bin/pbcopy"
env PATH="$test_path" XDG_DATA_HOME="$test_root/clean-copy" \
  CLIP_TEST_COPY_LOG="$copy_log" \
  "$clip" copy --clean --width 40 <"$fixtures/emoji.w40.in"
_assert_exit "clip copy --clean succeeds" 0 "$?"
_clip_equal "$fixtures/emoji.w40.out" "$copy_log"
_assert_exit "clip copy --clean publishes the cleaned text" 0 "$?"
history_files=("$test_root/clean-copy/clip"/*)
_clip_equal "$fixtures/emoji.w40.out" "${history_files[0]}"
_assert_exit "clip copy --clean records the cleaned text in history" 0 "$?"
_assert_eq "clip copy --clean leaves no staging files" 1 \
  "$(command ls -A "$test_root/clean-copy/clip" | wc -l | tr -d ' ')"

# Text that cleans to nothing, such as spaces, is copied as captured: tmux
# cannot publish an empty selection.
printf '   ' >"$payload"
env PATH="$test_path" XDG_DATA_HOME="$test_root/clean-blank" \
  CLIP_TEST_COPY_LOG="$copy_log" "$clip" copy --clean --width 40 <"$payload"
_clip_equal "$payload" "$copy_log"
_assert_exit "clip copy --clean keeps a selection that cleans to nothing" 0 "$?"

# A filter failure must never lose the selection: copy it as captured.
cat >"$backend_bin/awk" <<'EOF'
#!/usr/bin/env bash
exit 1
EOF
chmod +x "$backend_bin/awk"
cp "$backend_bin/awk" "$backend_bin/gawk"
env PATH="$test_path" XDG_DATA_HOME="$test_root/clean-failed" \
  CLIP_TEST_COPY_LOG="$copy_log" \
  "$clip" copy --clean --width 40 <"$fixtures/emoji.w40.in" 2>"$test_root/clean-error"
_assert_exit "clip copy --clean still copies when the filter fails" 0 "$?"
_clip_equal "$fixtures/emoji.w40.in" "$copy_log"
_assert_exit "a failed filter copies the selection as captured" 0 "$?"
_assert_contains "a failed filter is reported" 'clean failed' "$(cat "$test_root/clean-error")"
_assert_eq "a failed filter leaves no staging files" 1 \
  "$(command ls -A "$test_root/clean-failed/clip" | wc -l | tr -d ' ')"
rm -f "$backend_bin/awk" "$backend_bin/gawk" "$backend_bin/pbcopy" "$copy_log"

# Privacy upgrades run one chmod over the whole history, under the option
# parsing of BSD, BusyBox and POSIX chmod too (GNU's POSIXLY_CORRECT mode),
# where a `--` after the mode would be taken for a file.
cat >"$backend_bin/chmod" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$1" >>"\$CLIP_TEST_CHMOD_LOG"
exec $(command -v chmod) "\$@"
EOF
"$(command -v chmod)" +x "$backend_bin/chmod"
for entry in one two three; do
  printf '%s' "$entry" | env PATH="$runtime_bin" XDG_DATA_HOME="$test_root/chmod-batch" \
    "$clip" capture --history-only
done
"$(command -v chmod)" 644 "$test_root/chmod-batch/clip"/*
printf 'four' | env PATH="$test_path" XDG_DATA_HOME="$test_root/chmod-batch" \
  POSIXLY_CORRECT=1 CLIP_TEST_CHMOD_LOG="$test_root/chmod-log" \
  "$clip" capture --history-only
_assert_exit "capture succeeds under POSIX chmod parsing" 0 "$?"
_assert_eq "history permissions take one chmod call" \
  "$(printf '700\n600')" "$(cat "$test_root/chmod-log")"
for entry in "$test_root/chmod-batch/clip"/*; do
  _assert_eq "history entry ${entry##*/} is private after the batch" 600 "$(_clip_mode "$entry")"
done
rm -f "$backend_bin/chmod"

echo
echo "=== Empty picker is an expected no-selection outcome ==="
env PATH="$test_path" XDG_DATA_HOME="$test_root/absent-picker" \
  "$clip" pick >"$test_root/no-selection" 2>"$test_root/no-selection-error"
_assert_exit "absent history reports the distinct no-selection status" 3 "$?"
_assert_file_content "absent history emits no selection bytes" '' "$test_root/no-selection"
_assert_file_content "absent history is not displayed as an error" '' "$test_root/no-selection-error"
mkdir -p "$test_root/empty-picker/clip"
env PATH="$test_path" XDG_DATA_HOME="$test_root/empty-picker" \
  "$clip" pick --paste-pane %7 >"$test_root/no-selection" 2>"$test_root/no-selection-error"
_assert_exit "empty history reports the distinct no-selection status" 3 "$?"
_assert_file_content "empty history never emits error text" '' "$test_root/no-selection-error"
mkdir -p "$test_root/invalid-picker"
printf 'invalid directory fixture' >"$test_root/invalid-picker/clip"
env PATH="$test_path" XDG_DATA_HOME="$test_root/invalid-picker" \
  "$clip" pick >"$test_root/no-selection" 2>"$test_root/no-selection-error"
_assert_exit "an invalid history path remains a genuine error" 1 "$?"

_test_summary
