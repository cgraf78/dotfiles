#!/usr/bin/env bash
# agent-rules-adapter-test — dotfiles policy and provider activation boundary.

# shellcheck disable=SC1090,SC1091,SC2016,SC2030,SC2031,SC2088,SC2329
# Doctor rows display targets as literal HOME-relative tilde paths.
set -o pipefail
export NO_COLOR=1

. "${BASH_SOURCE[0]%/*}/helpers.sh"
_test_prefer_system_git || exit 1

source_home=${DOT_TEST_SOURCE_HOME:-$HOME}
test_dot_root=$(_test_dot_root) || exit 1
deps="$source_home/.config/shdeps/10-deps.conf"
hook="$source_home/.local/lib/dotfiles/merge-hooks.d/agent-rules.sh"
doctor_lib="$source_home/.local/lib/dotfiles/doctor.d/lib/agent-rules.sh"
_test_load_dot_merge_api || {
  _fail 'agent rules adapter: standalone dot checkout is available'
  _test_summary
}

if awk '$1 == "cgraf78/agent-rules-sync" && $2 == "github" { found = 1 }
  END { exit !found }' "$deps"; then
  _pass "agent rules ownership: standalone provider is a dependency"
else
  _fail "agent rules ownership: standalone provider is a dependency"
fi

work=$(_tmpdir)
fixture_home="$work/home"
mock_bin="$work/bin"
call_log="$work/agent-rules-sync.log"
manifest_copy="$work/manifest.tsv"
check_reply_file="$work/check.reply"
rule_root="$fixture_home/.config/agent-rules/rules.d"
target_root="$fixture_home/.config/dot/merge-hooks.d/agent-rules/targets.d/80-targets.replace"
playbook_root="$fixture_home/.config/agent-rules/playbooks.d"
manifest="$fixture_home/.local/state/dot/agent-rules-sync-manifest-v1.tsv"
mkdir -p \
  "$mock_bin" \
  "$rule_root" \
  "$target_root" \
  "$playbook_root/alpha" \
  "$playbook_root/zeta"

cat >"$rule_root/000-first.md" <<'EOF'
# First

<!-- agent-rule-id: adapter-first -->

First private policy body.
EOF
cat >"$rule_root/100-last.md" <<'EOF'
# Last

<!-- agent-rule-id: adapter-last -->

Last private policy body.
EOF
cat >"$playbook_root/alpha/one.md" <<'EOF'
# Alpha

<!-- agent-rule-id: adapter-alpha -->
<!-- agent-rule-trigger: Alpha work -->

Alpha private playbook body.
EOF
cat >"$playbook_root/zeta/two.md" <<'EOF'
# Zeta

<!-- agent-rule-id: adapter-zeta -->
<!-- agent-rule-trigger: Zeta work -->

Zeta private playbook body.
EOF
cat >"$target_root/50-native.txt" <<'EOF'
$HOME/.claude/CLAUDE.md
~/.codex/AGENTS.md
$HOME/.claude/CLAUDE.md # duplicate by policy, emitted once
EOF

# Dot's trusted-playbook boundary intentionally accepts only tracked base
# files or exact overlay-authorized links. This fixture models the base case.
git init -q --bare "$fixture_home/.dotfiles"
git --git-dir="$fixture_home/.dotfiles" --work-tree="$fixture_home" add \
  .config/agent-rules/playbooks.d/alpha/one.md \
  .config/agent-rules/playbooks.d/zeta/two.md

cat >"$mock_bin/agent-rules-sync" <<'EOF'
#!/usr/bin/env bash
: "${DOT_TEST_AGENT_RULES_SYNC_LOG:?}"
: "${DOT_TEST_AGENT_RULES_SYNC_MANIFEST_COPY:?}"
printf '%s\n' "$*" >>"$DOT_TEST_AGENT_RULES_SYNC_LOG"
# `check` replays a scripted provider answer: the provider's own suite owns
# drift detection, while this adapter test owns how dotfiles reacts to each
# documented status and state.
if [[ "${1:-}" == check ]]; then
  printf '%b' "${DOT_TEST_AGENT_RULES_SYNC_CHECK_STDOUT:-}"
  printf '%b' "${DOT_TEST_AGENT_RULES_SYNC_CHECK_STDERR:-}" >&2
  exit "${DOT_TEST_AGENT_RULES_SYNC_CHECK_STATUS:-0}"
fi
if [[ "${1:-}" == --manifest && -n "${2:-}" ]]; then
  cp "$2" "$DOT_TEST_AGENT_RULES_SYNC_MANIFEST_COPY"
fi
exit "${DOT_TEST_AGENT_RULES_SYNC_STATUS:-0}"
EOF
chmod +x "$mock_bin/agent-rules-sync"

_run_merge() {
  local path="$1"
  (
    HOME="$fixture_home"
    PATH="$path"
    unset XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME
    export HOME PATH
    export DOT_OVERLAY_MANIFEST="$fixture_home/.local/state/dot/overlay-links"
    export DOT_TEST_AGENT_RULES_SYNC_LOG="$call_log"
    export DOT_TEST_AGENT_RULES_SYNC_MANIFEST_COPY="$manifest_copy"
    # The sourced hook calls these merge-runner callbacks dynamically.
    # shellcheck disable=SC2329
    _log() { :; }
    # shellcheck disable=SC2329
    _warn() { printf '%s\n' "$*" >&2; }
    # shellcheck source=/dev/null
    source "$hook"
    merge
  )
}

_run_installed_check() {
  local path="$1"
  (
    HOME="$fixture_home"
    PATH="$path"
    unset XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME
    export HOME PATH
    export DOT_OVERLAY_MANIFEST="$fixture_home/.local/state/dot/overlay-links"
    export DOT_TEST_AGENT_RULES_SYNC_LOG="$call_log"
    export DOT_TEST_AGENT_RULES_SYNC_MANIFEST_COPY="$manifest_copy"
    _log() { :; }
    _warn() { printf '%s\n' "$*" >&2; }
    source "$hook"
    _dot_agent_rules_check_installed
    status=$?
    printf '%s' "$REPLY" >"$check_reply_file"
    exit "$status"
  )
}

_run_doctor_check() {
  local force_check="${1:-1}"
  (
    HOME="$fixture_home"
    PATH="$mock_bin:/usr/bin:/bin"
    unset XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME
    DOT_TEST_DOT_ROOT="$test_dot_root"
    DOT_TEST_AGENT_RULES_SYNC_LOG="$call_log"
    DOT_TEST_AGENT_RULES_SYNC_MANIFEST_COPY="$manifest_copy"
    export HOME PATH DOT_DOCTOR_RESULT_FILE DOT_TEST_DOT_ROOT
    export DOT_TEST_AGENT_RULES_SYNC_LOG DOT_TEST_AGENT_RULES_SYNC_MANIFEST_COPY
    if [[ "$force_check" == 1 ]]; then
      export DOT_TEST_AGENT_RULES_CHECK=1
    else
      unset DOT_TEST_AGENT_RULES_CHECK
    fi
    _test_load_dot_doctor_api "$source_home"
    source "$doctor_lib"
    [[ "$force_check" == 1 ]] || export DOT_TEST=0
    # Doctor workers run extensions under errexit; so does this one.
    set -e
    DOT_AGENT_RULES_HOOK="$hook" _dr_check_agent_rules
  )
}

: >"$call_log"
_run_merge "$mock_bin:/usr/bin:/bin"

_assert_file_content "agent rules adapter: invokes provider with private manifest" \
  "--manifest $manifest" "$call_log"
_assert_file_exists "agent rules adapter: writes resolved manifest" "$manifest"
_assert_file_content "agent rules adapter: provider observes complete manifest" \
  "$(cat "$manifest")" "$manifest_copy"

expected_manifest=$(_tmpfile)
{
  printf 'version\tagent-rules-sync-manifest-v1\n'
  printf 'rule-root\t%s\n' "$rule_root"
  printf 'playbook-root\t%s\n' "$playbook_root"
  printf 'rule\t%s\n' "$rule_root/000-first.md"
  printf 'rule\t%s\n' "$rule_root/100-last.md"
  printf 'playbook\talpha/one.md\t%s\n' "$playbook_root/alpha/one.md"
  printf 'playbook\tzeta/two.md\t%s\n' "$playbook_root/zeta/two.md"
  printf 'target-file\t%s\n' "$fixture_home/.claude/CLAUDE.md"
  printf 'target-file\t%s\n' "$fixture_home/.codex/AGENTS.md"
} >"$expected_manifest"
_assert_file_content "agent rules adapter: manifest preserves policy order and routes" \
  "$(cat "$expected_manifest")" "$manifest"

manifest_mode=$(stat -c '%a' "$manifest" 2>/dev/null || stat -f '%Lp' "$manifest" 2>/dev/null)
_assert_eq "agent rules adapter: manifest is private" "600" "$manifest_mode"
_assert_not_contains "agent rules adapter: manifest does not copy rule prose" \
  "First private policy body" "$(cat "$manifest")"
_assert_not_contains "agent rules adapter: manifest does not copy playbook prose" \
  "Alpha private playbook body" "$(cat "$manifest")"

# Run the installed check against a scripted provider answer and leave its
# status in $check_status and its reason in $check_reply.
_check_with() {
  local status="$1" stdout="${2:-}" stderr="${3:-}"
  : >"$call_log"
  : >"$check_reply_file"
  DOT_TEST_AGENT_RULES_SYNC_CHECK_STATUS="$status" \
    DOT_TEST_AGENT_RULES_SYNC_CHECK_STDOUT="$stdout" \
    DOT_TEST_AGENT_RULES_SYNC_CHECK_STDERR="$stderr" \
    _run_installed_check "$mock_bin:/usr/bin:/bin"
  check_status=$?
  check_reply=$(<"$check_reply_file")
}
_check_with 0
_assert_exit "agent rules adapter: a current provider check passes" 0 "$check_status"
_assert_eq "agent rules adapter: current check reason" "current" "$check_reply"
_assert_file_content "agent rules adapter: check asks the provider about the installed manifest" \
  "check --manifest $manifest" "$call_log"

_check_with 3 "current\t$fixture_home/.claude/CLAUDE.md\nstale\t$fixture_home/.codex/AGENTS.md\n"
_assert_exit "agent rules adapter: provider drift fails the check" 1 "$check_status"
_assert_eq "agent rules adapter: drift names the first non-current target" \
  "target-stale"$'\t'"$fixture_home/.codex/AGENTS.md" "$check_reply"

_check_with 3 "mode\t$fixture_home/.claude/CLAUDE.md\nmissing\t$fixture_home/.codex/AGENTS.md\n"
_assert_eq "agent rules adapter: drift keeps the provider's state" \
  "target-mode"$'\t'"$fixture_home/.claude/CLAUDE.md" "$check_reply"

_check_with 3 "orphaned\t$fixture_home/.codex/AGENTS.md"
_assert_exit "agent rules adapter: an unknown provider state is still drift" 1 "$check_status"
_assert_eq "agent rules adapter: an unterminated last record is read" \
  "target-orphaned"$'\t'"$fixture_home/.codex/AGENTS.md" "$check_reply"

_check_with 3 "current\t$fixture_home/.claude/CLAUDE.md\n"
_assert_exit "agent rules adapter: drift status without a drifted target fails" 1 "$check_status"
_assert_eq "agent rules adapter: contradictory drift output is a failed check" \
  "check-failed" "$check_reply"

_check_with 1 "" "agent-rules-sync: duplicate agent-rule-id 'x'\nsecond line\n"
_assert_exit "agent rules adapter: provider validation failure fails the check" 1 "$check_status"
_assert_eq "agent rules adapter: validation failure carries the provider error" \
  "check-failed"$'\t'"agent-rules-sync: duplicate agent-rule-id 'x'" "$check_reply"

_check_with 127 "" "agent-rules-sync: unexpected crash\n"
_assert_exit "agent rules adapter: an unknown provider status cannot pass" 1 "$check_status"
_assert_eq "agent rules adapter: an unknown provider status is a failed check" \
  "check-failed"$'\t'"agent-rules-sync: unexpected crash" "$check_reply"

_check_with 2 "" "Usage: agent-rules-sync [--manifest FILE]\n"
_assert_exit "agent rules adapter: a provider without check cannot pass" 1 "$check_status"
_assert_eq "agent rules adapter: a usage status means the provider predates check" \
  "provider-check-unsupported" "$check_reply"
_assert_contains "agent rules adapter: an old provider is confirmed through --help" \
  "--help" "$(cat "$call_log")"

# A launcher Bash cannot parse also exits 2, for --help too; that is broken,
# not merely old, and must not hide behind the rollout skip.
DOT_TEST_AGENT_RULES_SYNC_STATUS=2 _check_with 2
_assert_exit "agent rules adapter: a broken provider launcher cannot pass" 1 "$check_status"
_assert_eq "agent rules adapter: a broken provider launcher is a failed check" \
  "check-failed" "$check_reply"

chmod 644 "$manifest"
_check_with 0
_assert_eq "agent rules adapter: installed check rejects public manifest permissions" \
  "manifest-mode" "$check_reply"
_assert_file_content "agent rules adapter: unsafe manifest is not handed to the provider" \
  "" "$call_log"
chmod 600 "$manifest"

printf '%s\n' '$HOME/.gemini/GEMINI.md' >>"$target_root/50-native.txt"
_check_with 0
_assert_eq "agent rules adapter: installed check rejects source-manifest drift" \
  "manifest-mismatch" "$check_reply"
_assert_file_content "agent rules adapter: a stale manifest is not handed to the provider" \
  "" "$call_log"
sed -i.bak '$d' "$target_root/50-native.txt"
rm -f "$target_root/50-native.txt.bak"
_check_with 0
_assert_eq "agent rules adapter: restored policy matches the manifest" "current" "$check_reply"

export DOT_TEST_AGENT_RULES_SYNC_STATUS=23
set +e
_run_merge "$mock_bin:/usr/bin:/bin"
provider_status=$?
set -e
_assert_exit "agent rules adapter: preserves provider failure" 23 "$provider_status"
unset DOT_TEST_AGENT_RULES_SYNC_STATUS

# A failed trust/discovery pass must neither replace the last good manifest nor
# launch the provider with a partial policy view.
last_good=$(_tmpfile)
cp "$manifest" "$last_good"
rm -f "$playbook_root/alpha/one.md"
: >"$call_log"
if _run_merge "$mock_bin:/usr/bin:/bin" >/dev/null 2>&1; then
  _fail "agent rules adapter: invalid playbook discovery fails before dispatch"
else
  _pass "agent rules adapter: invalid playbook discovery fails before dispatch"
fi
_assert_file_content "agent rules adapter: discovery failure preserves last manifest" \
  "$(cat "$last_good")" "$manifest"
_assert_file_content "agent rules adapter: discovery failure launches no provider" \
  "" "$call_log"

# Partial bootstrap environments can source merge hooks before the dependency
# executable is visible. The next normal dot update will install it before the
# merge phase, so this narrow case remains a safe no-op.
: >"$call_log"
if _run_merge "/usr/bin:/bin"; then
  _pass "agent rules adapter: missing provider is a safe no-op"
else
  _fail "agent rules adapter: missing provider is a safe no-op"
fi
_assert_file_content "agent rules adapter: missing provider launches nothing" \
  "" "$call_log"

cat >"$playbook_root/alpha/one.md" <<'EOF'
# Alpha

<!-- agent-rule-id: adapter-alpha -->
<!-- agent-rule-trigger: Alpha work -->

Alpha private playbook body.
EOF
git --git-dir="$fixture_home/.dotfiles" --work-tree="$fixture_home" add \
  .config/agent-rules/playbooks.d/alpha/one.md
_run_merge "$mock_bin:/usr/bin:/bin"
DOT_DOCTOR_RESULT_FILE="$work/doctor-results.tsv"
export DOT_DOCTOR_RESULT_FILE

# Render one doctor run against a scripted provider check answer.
_doctor_with() {
  local status="$1" stdout="${2:-}" stderr="${3:-}"
  : >"$DOT_DOCTOR_RESULT_FILE"
  : >"$call_log"
  DOT_TEST_AGENT_RULES_SYNC_CHECK_STATUS="$status" \
    DOT_TEST_AGENT_RULES_SYNC_CHECK_STDOUT="$stdout" \
    DOT_TEST_AGENT_RULES_SYNC_CHECK_STDERR="$stderr" \
    _run_doctor_check "${4:-1}"
  doctor_rows=$(cat "$DOT_DOCTOR_RESULT_FILE")
}

_doctor_with 3 "stale\t$fixture_home/.codex/AGENTS.md\n" "" 0
_assert_contains "agent rules doctor: skips disposable non-account homes" \
  $'skip\tgenerated policy check skipped: HOME is not the account home:' \
  "$doctor_rows"
_assert_file_content "agent rules doctor: a skipped home runs no provider check" \
  "" "$call_log"

_doctor_with 3 "stale\t$fixture_home/.codex/AGENTS.md\n"
_assert_contains "agent rules doctor: reports installed drift" \
  $'fail\tgenerated policy target was modified: '"$fixture_home/.codex/AGENTS.md" \
  "$doctor_rows"

# Every provider drift state, known or not, is a failing row naming the file
# with a next step; none may degrade to ok, skip, or a bare detail.
for state in missing stale unmanaged malformed not-file mode orphaned; do
  _doctor_with 3 "$state\t$fixture_home/.codex/AGENTS.md\n"
  _assert_contains "agent rules doctor: a $state target is a failing row" \
    $'fail\tgenerated policy ' "$doctor_rows"
  _assert_contains "agent rules doctor: a $state row names the target" \
    "$fixture_home/.codex/AGENTS.md" "$doctor_rows"
  _assert_contains "agent rules doctor: a $state row has a next step" \
    $'hint\t' "$doctor_rows"
done
_doctor_with 3 "mode\t$fixture_home/.codex/AGENTS.md\n"
_assert_contains "agent rules doctor: a mode drift says permissions are unsafe" \
  "generated policy permissions are unsafe" "$doctor_rows"

_doctor_with 3 "malformed\t$fixture_home/.codex/AGENTS.md\n"
_assert_contains "agent rules doctor: a malformed target names the repair" \
  "fix or remove the unbalanced agent-rules-sync markers" "$doctor_rows"

_doctor_with 3 "orphaned\t$fixture_home/.codex/AGENTS.md\n"
_assert_contains "agent rules doctor: an unknown provider state is drift" \
  $'fail\tgenerated policy target is not current (orphaned): ' "$doctor_rows"

_doctor_with 2 "" "Usage: agent-rules-sync [--manifest FILE]\n"
_assert_contains "agent rules doctor: a provider without check is a skip" \
  $'skip\tgenerated policy check skipped: agent-rules-sync has no \'check\' command' \
  "$doctor_rows"
_assert_contains "agent rules doctor: the skip names the upgrade" \
  "run 'dot update -f' to upgrade agent-rules-sync" "$doctor_rows"
_assert_not_contains "agent rules doctor: a provider without check is not a failure" \
  $'fail\t' "$doctor_rows"

_doctor_with 1 "" "agent-rules-sync: duplicate agent-rule-id 'x'\n"
_assert_contains "agent rules doctor: validation failure shows the provider error" \
  $'fail\tagent rule validation failed\tagent-rules-sync: duplicate agent-rule-id \'x\'' \
  "$doctor_rows"

# Dotfiles-owned manifest problems fail before the provider is asked.
chmod 644 "$manifest"
_doctor_with 0
_assert_contains "agent rules doctor: a public manifest is a failing row" \
  $'fail\tgenerated policy permissions are unsafe' "$doctor_rows"
chmod 600 "$manifest"
printf '%s\n' '$HOME/.gemini/GEMINI.md' >>"$target_root/50-native.txt"
_doctor_with 0
_assert_contains "agent rules doctor: a stale manifest is a failing row" \
  $'fail\tgenerated policy manifest is stale' "$doctor_rows"
sed -i.bak '$d' "$target_root/50-native.txt"
rm -f "$target_root/50-native.txt.bak"
mv "$manifest" "$manifest.away"
_doctor_with 0
_assert_contains "agent rules doctor: a missing manifest is a failing row" \
  $'fail\tgenerated policy manifest is missing' "$doctor_rows"
mv "$manifest.away" "$manifest"

_doctor_with 0
_assert_contains "agent rules doctor: accepts current installed policy" \
  $'ok\tgenerated policy is current' "$doctor_rows"

# Live-target size budget. Read the budget and the warning share from their
# owners so these cases follow any future change to either value.
budget_lib="$source_home/.local/lib/dotfiles/merge-hooks.d/lib/agent-rules-budget.sh"
budget=$(. "$budget_lib" && _dot_agent_rules_budget_bytes && printf '%s' "$REPLY")
warn_percent=$(. "$doctor_lib" && printf '%s' "${_DR_AGENT_RULES_BUDGET_WARN_PERCENT:-}")
_assert_eq "agent rules doctor: the budget is a positive byte count" \
  0 "$([[ $budget =~ ^[1-9][0-9]*$ ]] && echo 0 || echo 1)"
_assert_eq "agent rules doctor: the warning share is a percentage below 100" \
  0 "$([[ $warn_percent =~ ^[1-9][0-9]?$ ]] && echo 0 || echo 1)"
warn_limit=$((budget * warn_percent / 100))
claude_target="$fixture_home/.claude/CLAUDE.md"
codex_target="$fixture_home/.codex/AGENTS.md"
mkdir -p "${claude_target%/*}" "${codex_target%/*}"
_write_bytes() {
  head -c "$2" /dev/zero | tr '\0' x >"$1"
}

rm -rf "$claude_target" "$codex_target"
_doctor_with 0
_assert_not_contains "agent rules doctor: no live target files means no size row" \
  "budget" "$doctor_rows"

_write_bytes "$claude_target" 1000
_doctor_with 0
_assert_contains "agent rules doctor: a small target is within the budget" \
  $'ok\tgenerated policy is within its size budget\tlargest: 1000 / '"$budget bytes" \
  "$doctor_rows"

_write_bytes "$codex_target" "$warn_limit"
_doctor_with 0
_assert_contains "agent rules doctor: a target exactly at the warning line is ok" \
  $'ok\tgenerated policy is within its size budget\tlargest: '"$warn_limit / $budget bytes" \
  "$doctor_rows"

_write_bytes "$codex_target" "$((warn_limit + 1))"
_doctor_with 0
_assert_contains "agent rules doctor: a target past the warning line warns" \
  $'warn\tgenerated policy is near its '"$budget-byte budget" "$doctor_rows"
_assert_contains "agent rules doctor: the near-budget warning names the target" \
  "~/.codex/AGENTS.md: $((warn_limit + 1)) / $budget bytes" "$doctor_rows"
_assert_not_contains "agent rules doctor: a target under the line is not listed" \
  "~/.claude/CLAUDE.md:" "$doctor_rows"
_assert_contains "agent rules doctor: the near-budget warning names the fix" \
  "tighten the always-loaded rules" "$doctor_rows"
_assert_not_contains "agent rules doctor: a near-budget target never fails" \
  $'fail\t' "$doctor_rows"

_write_bytes "$claude_target" "$budget"
_doctor_with 0
_assert_contains "agent rules doctor: a target exactly at the budget is near, not over" \
  $'warn\tgenerated policy is near its '"$budget-byte budget" "$doctor_rows"
_assert_not_contains "agent rules doctor: a target at the budget is not reported over" \
  "exceeds" "$doctor_rows"

_write_bytes "$claude_target" "$((budget + 1))"
_doctor_with 0
_assert_contains "agent rules doctor: a target over the budget says so" \
  $'warn\tgenerated policy exceeds its '"$budget-byte budget" "$doctor_rows"
_assert_contains "agent rules doctor: an over-budget warning lists every large target" \
  "~/.claude/CLAUDE.md: $((budget + 1)) / $budget bytes, 1 over" "$doctor_rows"
_assert_contains "agent rules doctor: an over-budget warning keeps the near target" \
  "~/.codex/AGENTS.md: $((warn_limit + 1)) / $budget bytes" "$doctor_rows"
_assert_not_contains "agent rules doctor: an over-budget target still only warns" \
  $'fail\t' "$doctor_rows"

# A non-file target is the currency check's to report, not a size.
rm -f "$claude_target" "$codex_target"
mkdir -p "$codex_target"
_doctor_with 0
_assert_not_contains "agent rules doctor: a non-file target is not measured" \
  "budget" "$doctor_rows"
rmdir "$codex_target"

# Without a readable hook doctor cannot know the budget; it reports no size.
_write_bytes "$claude_target" "$((budget + 1))"
real_hook=$hook
hook="$work/no-such-hook.sh"
_doctor_with 0
hook=$real_hook
_assert_not_contains "agent rules doctor: an unreadable hook skips the size check" \
  "budget" "$doctor_rows"

mv "$manifest" "$manifest.away"
_doctor_with 0
mv "$manifest.away" "$manifest"
_assert_not_contains "agent rules doctor: a missing manifest reports no size" \
  "budget" "$doctor_rows"

printf '%s\n' '# shellcheck shell=bash' >"$work/old-hook.sh"
hook="$work/old-hook.sh"
_doctor_with 0
hook=$real_hook
_assert_not_contains "agent rules doctor: a hook without the budget helpers reports no size" \
  "budget" "$doctor_rows"
rm -f "$claude_target"

_test_summary
