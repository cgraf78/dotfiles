#!/usr/bin/env bash
# git-credential-github-pat — answer GitHub HTTPS credential requests with the
# account's local token file.
#
# The github-transport merge hook registers this helper only for accounts whose
# policy selects HTTPS. It reads the same `~/.config/gh/github-pat` file that
# `env.d/60-github.sh` exports as GH_TOKEN and the `gh-token` merge hook
# maintains, so one file per account stays the single credential source and
# rotating a token never needs a Git config change.
#
# Protocol: https://git-scm.com/docs/gitcredentials#_custom_helpers. Only `get`
# answers; `store` and `erase` are ignored because the token file, not Git, owns
# the credential. Requests for any other host or protocol get no answer, so
# Git falls through to its normal behavior for them.
set -u

[[ ${1:-} == get ]] || exit 0

protocol=''
host=''
while IFS= read -r line && [[ -n $line ]]; do
  case $line in
    protocol=*) protocol=${line#protocol=} ;;
    host=*) host=${line#host=} ;;
  esac
done
# An explicit default port arrives as `github.com:443`. The hook's `helper =`
# reset already removed every other helper for github.com, so declining it
# would leave Git with nothing but a prompt.
[[ $protocol == https && ($host == github.com || $host == github.com:443) ]] || exit 0

token=''
token_file=$HOME/.config/gh/github-pat
if [[ -r $token_file ]]; then
  IFS= read -r token <"$token_file" || true
fi
token=${token%$'\r'}

if [[ -z $token ]]; then
  # GitHub rejects account passwords for Git, so an interactive prompt could
  # never succeed. `quit` makes Git fail immediately with an authentication
  # error instead of prompting or trying later helpers.
  printf 'git-credential-github-pat: ~/.config/gh/github-pat is missing or empty\n' >&2
  printf 'quit=1\n'
  exit 0
fi

# GitHub ignores the username for token authentication; x-access-token is the
# conventional placeholder that also works for installation tokens.
printf 'username=x-access-token\npassword=%s\n' "$token"
