#!/usr/bin/env bash
# prepare-commit-msg — gate Git sequencer commits that bypass pre-commit.

set -u

_git_path_exists() {
  local path
  path=$(git rev-parse --git-path "$1" 2>/dev/null) || return 1
  [ -e "$path" ]
}

_git_path_dir_exists() {
  local path
  path=$(git rev-parse --git-path "$1" 2>/dev/null) || return 1
  [ -d "$path" ]
}

_generated_revert_message() {
  local msg_file="$1" first_line="" third_line=""
  [ -f "$msg_file" ] || return 1
  first_line=$(sed -n '1p' "$msg_file")
  third_line=$(sed -n '3p' "$msg_file")
  case "$first_line" in
    "Revert \""*)
      case "$third_line" in
        "This reverts commit "*) return 0 ;;
      esac
      ;;
  esac
  return 1
}

# `git cherry-pick`, `git revert`, and conflict-resolved `git rebase
# --continue` create commits through the sequencer without invoking
# `pre-commit`. Run the same readiness gate here only when those states are
# active; ordinary `git commit` and automatic merges are already covered by
# `pre-commit` / `pre-merge-commit`.
if _git_path_exists CHERRY_PICK_HEAD ||
  _git_path_exists REVERT_HEAD ||
  _git_path_dir_exists rebase-merge ||
  _git_path_dir_exists rebase-apply ||
  _generated_revert_message "${1:-}"; then
  _hook_dir=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd) || exit 0
  exec "$_hook_dir/sley-commit-gate"
fi

exit 0
