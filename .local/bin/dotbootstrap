#!/usr/bin/env bash
# Client shortcut for initializing or reconverging this dotfiles checkout.
# Dot owns installation, repository transactions, overlays, dependencies, and
# extension execution; this client binds only its repository URL and branch.

set -euo pipefail
CDPATH=

_usage() {
  cat <<'EOF'
dotbootstrap — initialize or reconfigure this dotfiles client.

Usage:
  dotbootstrap          Reconverge an existing client through dot update.
  dotbootstrap init     Install Dot and initialize this client repository.
  dotbootstrap --help   Show this help and exit.
EOF
}

_require_tool() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'dotbootstrap: required command is unavailable: %s\n' "$1" >&2
    return 1
  }
}

_install_dot() {
  _require_tool curl || return
  curl -fsSL https://raw.githubusercontent.com/cgraf78/dot/main/install.sh |
    bash
}

_initialize_client() {
  local repository=${DOTBOOTSTRAP_DOTFILES_REPO:-git@github.com:cgraf78/dotfiles.git}

  _require_tool git || return
  _require_tool curl || return
  if [[ -n ${DOTFILES_BRANCH:-} ]]; then
    curl -fsSL https://raw.githubusercontent.com/cgraf78/dot/main/install.sh |
      bash -s -- --init --yes --branch "$DOTFILES_BRANCH" "$repository"
  else
    curl -fsSL https://raw.githubusercontent.com/cgraf78/dot/main/install.sh |
      bash -s -- --init --yes "$repository"
  fi
}

case ${1:-} in
  -h | --help | help)
    [[ $# -eq 1 ]] || exit 2
    _usage
    exit 0
    ;;
  init)
    [[ $# -eq 1 ]] || {
      _usage >&2
      exit 2
    }
    _initialize_client
    ;;
  '')
    [[ $# -eq 0 ]] || exit 2
    if ! "$HOME/.local/bin/dot" --version >/dev/null 2>&1; then
      _install_dot
    fi
    "$HOME/.local/bin/dot" update --force
    ;;
  *)
    printf 'dotbootstrap: unknown argument: %s\n\n' "$1" >&2
    _usage >&2
    exit 2
    ;;
esac

touch "$HOME/.dotbootstrap-done"
