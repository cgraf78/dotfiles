#!/usr/bin/env bash
# Dotfiles-owned front door for the generic `hm` binary.
#
# Hive Memory stays vendor-neutral. This launcher only maps AgentGuard's shared
# runtime identity into Hive Memory's environment contract before delegation.

set -euo pipefail

# `dot update` installs the tracked adapter and its declared dependencies as one
# converged unit. A missing helper or provider is therefore a broken install to
# repair, not an alternate runtime mode for this launcher to emulate.
# shellcheck source=../lib/dotfiles/shdeps-assets.sh disable=SC1091
. "${BASH_SOURCE[0]%/*}/../lib/dotfiles/shdeps-assets.sh"
if ! dot_shdeps_dep_source cgraf78/agentguard lib/agentguard/agentguard.sh; then
  printf 'hm launcher: AgentGuard unavailable; run dot update\n' >&2
  exit 127
fi

# Shdeps deliberately installs the real binary behind the tracked public
# launcher. The fixed path is the installation contract; PATH searches and old
# layout fallbacks would only hide a failed convergence.
_hm_core="${HOME:?}/.local/share/cgraf78/hive-memory/hm"
if [[ ! -x "$_hm_core" || -d "$_hm_core" ]]; then
  printf 'hm launcher: real hm not found at %s; run dot update\n' "$_hm_core" >&2
  exit 127
fi

_hm_explicit_agent="${HIVE_MEMORY_AGENT_ID:-}"
_hm_agent=$(agentguard_agent_name)
[[ "$_hm_agent" != unknown ]] || _hm_agent=""
_hm_agent="${_hm_explicit_agent:-$_hm_agent}"

# Human shells retain plain hm behavior. Inside a detected or explicitly named
# agent, preserve caller-supplied Hive values and let AgentGuard remain the sole
# owner of inferred agent and session identity.
if [[ -n "$_hm_agent" ]]; then
  export HIVE_MEMORY_AGENT_ID="${HIVE_MEMORY_AGENT_ID:-$_hm_agent}"
  if [[ -z "${HIVE_MEMORY_SESSION_ID:-}" ]] &&
    _hm_session=$(agentguard_session_id "$_hm_explicit_agent"); then
    export HIVE_MEMORY_SESSION_ID="$_hm_session"
  fi

  if [[ -z "${HIVE_MEMORY_PROJECT:-}" && "${HIVE_MEMORY_PROJECT_INFER:-1}" != 0 ]]; then
    # Gemini exposes a more precise current-project hint than the child cwd.
    # This is Hive context mapping, not duplicated agent/session detection.
    export HIVE_MEMORY_PROJECT="${GEMINI_PROJECT_DIR:-$PWD}"
  fi
fi

# Preserve the public command name in help and error output.
exec -a hm "$_hm_core" "$@"
