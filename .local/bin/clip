#!/usr/bin/env bash
# clip -- persistent clipboard history with fzf picker.
#
# Usage:
#   clip save              snapshot current clipboard to history
#   clip copy [--clean --width N [--column N]] [--client NAME --pane PANE]
#             [< input]    copy stdin to a host/client clipboard + history
#   clip clean --width N [--column N] [< input]
#                          remove an agent TUI's wraps, margins and markers
#   clip capture [--history-only] [< input]
#                          save history; optionally mirror a native clipboard
#   clip paste             print the current host clipboard
#   clip list              show recent entries
#   clip pick [--publish-pane PANE]
#                          fzf picker; stdout or atomic tmux handoff
#   clip clear             clear history

set -euo pipefail

_dot_clip_library_home=${DOT_TEST_HOST_HOME:-${HOME:-}}
_dot_clip_xdg=$_dot_clip_library_home/.local/lib/dot/xdg.sh
[[ -r $_dot_clip_xdg ]] || {
  printf 'clip: standalone Dot public XDG library is unavailable: %s\n' \
    "$_dot_clip_xdg" >&2
  exit 1
}
# shellcheck source=../lib/dot/xdg.sh disable=SC1091
. "$_dot_clip_xdg"
if ! dot_xdg_path data clip; then
  printf 'clip: HOME is not set and XDG_DATA_HOME is not absolute\n' >&2
  exit 1
fi
CLIP_DIR="$REPLY"
unset _dot_clip_library_home _dot_clip_xdg
CLIP_MAX=200
# Agent TUIs wrap their own transcript; this filter undoes it (see the file).
CLIP_CLEAN_AWK=${BASH_SOURCE[0]%/*}/../lib/clip/clean.awk

# Prefer the native backend for the active display. A binary installed on a
# remote or headless host is not enough: selecting it without its display
# socket turns a valid tmux OSC 52 copy into a noisy backend failure.
_clip_cmd() {
  if command -v pbcopy >/dev/null 2>&1; then
    CLIP_CMD=(pbcopy)
  elif [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy >/dev/null 2>&1; then
    CLIP_CMD=(wl-copy)
  elif [[ -n "${DISPLAY:-}" ]] && command -v xclip >/dev/null 2>&1; then
    CLIP_CMD=(xclip -selection clipboard)
  else
    CLIP_CMD=()
  fi
}

_paste_cmd() {
  if command -v pbpaste >/dev/null 2>&1; then
    PASTE_CMD=(pbpaste)
  elif [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-paste >/dev/null 2>&1; then
    PASTE_CMD=(wl-paste --no-newline)
  elif [[ -n "${DISPLAY:-}" ]] && command -v xclip >/dev/null 2>&1; then
    PASTE_CMD=(xclip -o -selection clipboard)
  else
    PASTE_CMD=()
  fi
}

_prune() {
  _entries || return
  local old
  for old in "${ENTRIES[@]:$CLIP_MAX}"; do
    rm -f -- "$CLIP_DIR/$old" || return
  done
}

# Clipboard data must never pass through a shell variable: command substitution
# removes trailing newlines and Bash cannot represent NUL. Private staging also
# prevents pickers from observing an entry before its producer has finished.
capture_file=''
clean_file=''
_cleanup() {
  [[ -z "$capture_file" ]] || rm -f -- "$capture_file"
  [[ -z "$clean_file" ]] || rm -f -- "$clean_file"
}
trap _cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

_history() {
  if [[ -e "$CLIP_DIR" || -L "$CLIP_DIR" ]]; then
    [[ -d "$CLIP_DIR" && ! -L "$CLIP_DIR" && -O "$CLIP_DIR" ]] || {
      echo 'clip: history must be a non-symlink directory owned by this user' >&2
      return 1
    }
  else
    (
      umask 077
      mkdir -p -- "$CLIP_DIR"
    ) || return
  fi
  # Upgrade the privacy of existing installations without changing payloads.
  chmod 700 "$CLIP_DIR" || return
}

_entry() {
  [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ &&
    -f "$CLIP_DIR/$1" && ! -L "$CLIP_DIR/$1" && -O "$CLIP_DIR/$1" ]]
}

_entries() {
  local listing entry
  local -a candidates=()
  ENTRIES=()
  listing=$(
    cd -- "$CLIP_DIR" || exit
    command ls -1t
  ) || return
  while IFS= read -r entry; do
    if _entry "$entry"; then candidates+=("$entry"); fi
  done <<<"$listing"
  ((${#candidates[@]})) || return 0
  # One chmod for the whole history keeps every copy as fast with 200 entries
  # as with one; only a failure needs the pass that tells an entry pruned
  # since the listing from a real error.
  if chmod 600 -- "${candidates[@]/#/$CLIP_DIR/}" 2>/dev/null; then
    ENTRIES=("${candidates[@]}")
    return 0
  fi
  for entry in "${candidates[@]}"; do
    if ! chmod 600 "$CLIP_DIR/$entry" 2>/dev/null; then
      # Concurrent pruning can remove an entry after this list was built.
      [[ -e "$CLIP_DIR/$entry" || -L "$CLIP_DIR/$entry" ]] || continue
      return 1
    fi
    ENTRIES+=("$entry")
  done
}

_temporary() {
  _history || return
  capture_file=$(
    umask 077
    mktemp "$CLIP_DIR/.capture.XXXXXXXXXX"
  )
}

_record() {
  local stamp entry
  stamp=$(date +%Y%m%d-%H%M%S) || return
  entry="$CLIP_DIR/$stamp-$$-${capture_file##*.}"
  # The invocation-unique suffix prevents colliding concurrent writers. Rename
  # within this directory publishes complete bytes without exposing staging.
  mv -- "$capture_file" "$entry" || return
  capture_file=''
  if ! _prune; then
    echo 'clip: warning: selection recorded but history pruning failed' >&2
  fi
}

# Write the cleaned bytes of file $1 to stdout. awk cannot tell whether its
# last line had a newline, so the shell passes that on.
_clean() {
  local last final=0
  last=$(tail -c 1 -- "$1" && printf x) || return
  [[ "$last" != $'\nx' ]] || final=1
  LC_ALL=C awk -v width="$width" -v column="${column:-0}" -v final_newline="$final" \
    -f "$CLIP_CLEAN_AWK" <"$1"
}

# Replace the staged selection with its cleaned text. Any failure here leaves
# the selection as captured: an uncleaned copy beats a lost one. So does text
# that cleans to nothing, such as spaces, which tmux could not publish.
_clean_capture() {
  if clean_file=$(
    umask 077
    mktemp "$CLIP_DIR/.clean.XXXXXXXXXX"
  ) && _clean "$capture_file" >"$clean_file" &&
    [[ -s "$clean_file" || ! -s "$capture_file" ]] &&
    mv -- "$clean_file" "$capture_file"; then
    clean_file=''
    return
  fi
  echo 'clip: clean failed; copying the selection as captured' >&2
  [[ -z "$clean_file" ]] || rm -f -- "$clean_file"
  clean_file=''
}

clip_clean() {
  capture_file=$(
    umask 077
    mktemp "${TMPDIR:-/tmp}/clip-clean.XXXXXXXXXX"
  ) || return
  cat >"$capture_file" || return
  _clean "$capture_file"
}

clip_save() {
  local -a PASTE_CMD
  _paste_cmd
  [[ ${#PASTE_CMD[@]} -gt 0 ]] || {
    echo "error: no clipboard tool found" >&2
    return 1
  }

  _temporary || return
  "${PASTE_CMD[@]}" >"$capture_file" || return
  _record
}

clip_copy() {
  local -a CLIP_CMD
  local has_content=0
  if [[ -n "$client" ]]; then
    CLIP_CMD=(tmux load-buffer -w -t "$client" -)
  else
    _clip_cmd
    [[ ${#CLIP_CMD[@]} -gt 0 ]] || {
      echo "error: no clipboard tool found" >&2
      return 1
    }
  fi
  _temporary || return
  cat >"$capture_file" || return
  if ((clean)); then _clean_capture; fi
  if [[ -s "$capture_file" ]]; then has_content=1; fi
  exec 3<"$capture_file" || return
  _record || return
  # Record before dispatch: a failed clipboard transport must retain a private
  # recovery copy rather than lose the only copy of the user's selection.
  if [[ -n "$client" ]]; then
    # tmux deliberately ignores zero-byte load-buffer input. Report that limit
    # rather than claim the workstation clipboard was cleared when it was not.
    if ((has_content == 0)); then
      echo 'clip: tmux cannot clear an empty client clipboard; empty history retained' >&2
      return 1
    fi
    # Match an exact client name, never a prefix or whichever client happened to
    # be active most recently. Even a vanished client leaves recoverable bytes.
    local actual
    actual=$(tmux display-message -p -c "$client" '#{client_name}') || return
    [[ "$actual" == "$client" ]] || {
      echo 'clip: initiating tmux client is no longer attached' >&2
      return 1
    }
    actual=$(tmux display-message -p -t "$pane" '#{pane_id}') || return
    [[ "$actual" == "$pane" ]] || {
      echo 'clip: source tmux pane is no longer available; history retained' >&2
      return 1
    }
  fi
  "${CLIP_CMD[@]}" <&3
}

# tmux publishes the selection to capable terminals with OSC 52. Capture keeps
# history and mirrors to a native host backend when one exists, but a remote
# host without clipboard utilities is still a successful copy operation.
clip_capture() {
  local -a CLIP_CMD
  CLIP_CMD=()
  # tmux already publishes OSC 52 for copy-pipe. A second asynchronous native
  # writer can finish out of order and overwrite a newer workstation selection.
  ((history_only)) || _clip_cmd
  _temporary || return
  cat >"$capture_file" || return
  exec 3<"$capture_file" || return
  _record || return
  if [[ ${#CLIP_CMD[@]} -gt 0 ]]; then
    if ! "${CLIP_CMD[@]}" <&3; then
      echo "warning: host clipboard copy failed; selection remains in clip history" >&2
    fi
  fi
}

clip_paste() {
  local -a PASTE_CMD
  _paste_cmd
  [[ ${#PASTE_CMD[@]} -gt 0 ]] || {
    echo "error: no clipboard tool found" >&2
    return 1
  }
  if [[ -n "$publish_pane$paste_pane" ]]; then
    _temporary || return
    "${PASTE_CMD[@]}" >"$capture_file" || return
    if [[ -n "$paste_pane" ]]; then
      _deliver
    else
      tmux-clip-paste --pane "$publish_pane" --publish <"$capture_file"
    fi
  else
    "${PASTE_CMD[@]}"
  fi
}

_deliver() {
  local handoff="$capture_file" status
  # Transfer this unique, complete inode to the paste helper. It owns both
  # successful removal and failed-delivery recovery from this point, so an
  # interrupt in this parent must not delete the helper's recovery reference.
  capture_file=''
  if tmux-clip-paste --file "$handoff" --pane "$paste_pane"; then
    return 0
  else
    status=$?
    if [[ -f "$handoff" && ! -L "$handoff" ]]; then
      printf 'clip: paste failed; private payload retained at: %s\n' "$handoff" >&2
    fi
    return "$status"
  fi
}

clip_list() {
  [[ -d "$CLIP_DIR" ]] || {
    echo "no clipboard history"
    return
  }

  _history || return
  _entries || return
  local f preview
  for f in "${ENTRIES[@]:0:20}"; do
    # `cat -vet` escapes control/high bytes without requiring sed's optional
    # list command, which some BusyBox builds silently ignore.
    preview=$(LC_ALL=C head -c 160 "$CLIP_DIR/$f" | LC_ALL=C cat -vet)
    printf '%s  %s\n' "$f" "$preview"
  done
}

clip_pick() {
  # No history is a normal no-selection outcome, distinct from unsafe paths,
  # permissions, or transport failures that terminal bindings must not hide.
  if [[ ! -e "$CLIP_DIR" && ! -L "$CLIP_DIR" ]]; then return 3; fi

  _history || return
  _entries || return
  [[ ${#ENTRIES[@]} -gt 0 ]] || return 3

  local file
  # fzf runs this preview later; expand the environment in its shell, not here.
  # shellcheck disable=SC2016
  file=$(
    printf '%s\n' "${ENTRIES[@]:0:$CLIP_MAX}" |
      CLIP_PICK_DIR="$CLIP_DIR" \
        fzf --height 50% --reverse --prompt="clip> " \
        --preview='LC_ALL=C head -c 16384 "$CLIP_PICK_DIR"/{} | LC_ALL=C cat -vet'
  ) || return

  # Validate the selected opaque ID again: old entries may be pruned while the
  # picker is open, and neither arbitrary paths nor symlinks are selections.
  _entry "$file" || return 1
  if [[ -n "$paste_pane" ]]; then
    # Two pickers in the same pane must never consume one another's selection.
    # A private per-operation file eliminates the shared public handoff name.
    exec 3<"$CLIP_DIR/$file" || return
    _temporary || return
    cat <&3 >"$capture_file" || return
    _deliver
  elif [[ -n "$publish_pane" ]]; then
    tmux-clip-paste --pane "$publish_pane" --publish <"$CLIP_DIR/$file"
  else
    cat "$CLIP_DIR/$file"
  fi
}

clip_clear() {
  [[ -d "$CLIP_DIR" ]] || return 0
  _history || return
  _entries || return
  local entry
  for entry in "${ENTRIES[@]}"; do rm -f -- "$CLIP_DIR/$entry"; done
  echo "clipboard history cleared"
}

command_name="${1:-}"
[[ $# == 0 ]] || shift
client=''
pane=''
publish_pane=''
paste_pane=''
history_only=0
clean=0
width=''
column=''
while (($#)); do
  if [[ "$1" == --history-only ]]; then
    [[ "$command_name" == capture && "$history_only" == 0 ]] || exit 2
    history_only=1
    shift
    continue
  fi
  if [[ "$1" == --clean ]]; then
    [[ "$command_name" == copy && "$clean" == 0 ]] || exit 2
    clean=1
    shift
    continue
  fi
  (($# >= 2)) || {
    echo 'clip: option requires a value' >&2
    exit 2
  }
  case "$1" in
    --client)
      [[ "$command_name" == copy ]] || exit 2
      client="$2"
      ;;
    --pane)
      [[ "$command_name" == copy ]] || exit 2
      pane="$2"
      ;;
    --publish-pane)
      [[ "$command_name" == pick || "$command_name" == paste ]] || exit 2
      publish_pane="$2"
      ;;
    --paste-pane)
      [[ "$command_name" == pick || "$command_name" == paste ]] || exit 2
      paste_pane="$2"
      ;;
    --width)
      [[ "$command_name" == clean || "$command_name" == copy ]] || exit 2
      [[ "$2" =~ ^[1-9][0-9]*$ ]] || exit 2
      width="$2"
      ;;
    --column)
      [[ "$command_name" == clean || "$command_name" == copy ]] || exit 2
      [[ "$2" =~ ^[0-9]+$ ]] || exit 2
      column="$2"
      ;;
    *)
      echo 'clip: unknown option' >&2
      exit 2
      ;;
  esac
  [[ -n "$2" ]] || exit 2
  shift 2
done
for requested_pane in "$pane" "$publish_pane" "$paste_pane"; do
  [[ -z "$requested_pane" || "$requested_pane" =~ ^%[0-9]+$ ]] || exit 2
done
[[ -z "$paste_pane" || -z "$publish_pane" ]] || exit 2
[[ -z "$client" || -n "$pane" ]] || exit 2
# Cleaning needs the width the agent wrapped at; it is meaningless without.
if [[ "$command_name" == clean ]] || ((clean)); then
  [[ -n "$width" ]] || exit 2
else
  [[ -z "$width" && -z "$column" ]] || exit 2
fi
case "$command_name" in
  save) clip_save ;;
  copy) clip_copy ;;
  clean) clip_clean ;;
  capture) clip_capture ;;
  paste) clip_paste ;;
  list) clip_list ;;
  pick) clip_pick ;;
  clear) clip_clear ;;
  *)
    cat >&2 <<'USAGE'
usage: clip {save|copy|clean|capture|paste|list|pick|clear}
  save   snapshot current clipboard to history
  copy   copy stdin to clipboard + history
         --client NAME --pane PANE targets one initiating tmux client
         --clean --width N [--column N] copies the text as clip clean prints it
  clean  print stdin with an agent TUI's layout removed
         --width N (required) rejoins the rows it wrapped at N columns and
         drops its margins, markers and gutter
         --column N gives the column where the first line started
  capture copy stdin when possible, always save to history
         --history-only avoids a duplicate clipboard writer after tmux OSC 52
  paste  print the current host clipboard
         --paste-pane PANE delivers through an isolated private transaction
         --publish-pane PANE atomically prepares a tmux paste handoff
  list   show recent entries
  pick   fzf picker, outputs selection to stdout
         --paste-pane PANE delivers through an isolated private transaction
         --publish-pane PANE atomically prepares a tmux paste handoff
         exits 3 without output when history is absent or empty
  clear  clear history
USAGE
    exit 1
    ;;
esac
