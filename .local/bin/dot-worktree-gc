#!/usr/bin/env bash
# dot-worktree-gc — remove old worktrees whose branches are proven merged.
#
# Thin entry point: reusable implementation lives beside it under
# .local/lib/dotfiles/worktree-gc.sh so the future `dot worktree gc`
# native command can wrap or absorb it. See that file for the stdout
# contract, exit codes, and safety rules.

# The library needs Bash 4 or newer (mapfile, and associative arrays in the
# shared doctor helpers). macOS /bin/bash is 3.2, where it would fail part
# way through with misleading errors, so refuse up front. POSIX syntax, so
# that running it with another shell (zsh, dash) reaches this message too.
case ${BASH_VERSION:-} in
  '' | [0-3].*)
    printf 'dot-worktree-gc: requires Bash 4 or newer (this is %s)\n' \
      "${BASH_VERSION:+Bash }${BASH_VERSION:-not Bash}" >&2
    exit 1
    ;;
esac

set -u

_src=${BASH_SOURCE[0]}
# Run as `bash dot-worktree-gc` from its own directory, or through a link
# whose target has no directory part, the path has no slash for the
# dirname step below to strip; anchor it to the current directory.
case $_src in */*) ;; *) _src=./$_src ;; esac
_depth=0
while [[ -L $_src ]]; do
  _depth=$((_depth + 1))
  if ((_depth > 32)); then
    printf 'dot-worktree-gc: symlink loop resolving entry point\n' >&2
    exit 1
  fi
  _link=$(readlink "$_src")
  case $_link in
    /*) _src=$_link ;;
    *) _src=${_src%/*}/$_link ;;
  esac
done
_libdir=$(cd -- "${_src%/*}/../lib/dotfiles" && pwd -P) || {
  printf 'dot-worktree-gc: cannot locate implementation library\n' >&2
  exit 1
}

# shellcheck source=../lib/dotfiles/worktree-gc.sh
. "$_libdir/worktree-gc.sh" || {
  printf 'dot-worktree-gc: cannot load implementation library\n' >&2
  exit 1
}

worktree_gc_main "$@"
