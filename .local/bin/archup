#!/usr/bin/env bash
# archup - the Arch backend for sysup.
#
# Shared run sequence, systemd handling, and family detection live in
# ~/.local/lib/dot/sysup; this file only supplies the pacman/yay specifics.
set -Eeuo pipefail

# Read by the sysup library sourced below, for messages and the family guard.
# shellcheck disable=SC2034
SYSUP_BACKEND_NAME=archup

_archup_lib_dir() {
  local src="${BASH_SOURCE[0]}"
  (cd "$(dirname "$src")/../lib/dot/sysup" >/dev/null 2>&1 && pwd -P)
}

# shellcheck source=../lib/dot/sysup/common.sh
. "$(_archup_lib_dir)/common.sh"

sysup_backend_usage() {
  cat <<'EOF'
Usage: archup [--check-only] [--no-restart-upgraded-services] [--restart-failed] [--] [extra upgrade args...]

Upgrade an Arch host, rebuilding broken AUR packages when yay is available,
then verify the failure modes most likely to leave services broken after the
upgrade.

Default flow:
  1. sudo credential warmup
  2. yay -Syu --devel or, when yay is not installed: sudo pacman -Syu
  3. rebuild installed AUR packages whose ELF files have missing libraries
  4. restart active systemd services shipped by packages upgraded or rebuilt in this run
  5. report failed systemd units when systemd is available

Options:
EOF
  sysup_usage_common_options
  cat <<'EOF'

Extra arguments are passed through to the selected upgrade command.
EOF
}

foreign_packages() {
  pacman -Qqm | sort
}

aur_rebuild_targets() {
  local pkg

  while IFS= read -r pkg; do
    [[ -n "$pkg" ]] || continue
    yay -Si --aur "$pkg" >/dev/null 2>&1 || continue
    printf '%s\n' "$pkg"
  done
}

# Foreign packages missing from the AUR cannot be rebuilt automatically, so the
# operator has to know they are now their own responsibility.
warn_non_aur_foreign_packages() {
  local pkg found=0

  while IFS= read -r pkg; do
    yay -Si --aur "$pkg" >/dev/null 2>&1 && continue

    if ((found == 0)); then
      sysup_log "foreign packages not found in AUR"
      found=1
    fi

    printf '  %s\n' "$pkg"
  done < <(foreign_packages)
}

# A repository upgrade can bump a shared library past the soname an AUR package
# was built against. The package still looks installed and current, but its
# binaries no longer load, so scan the ones built locally.
scan_foreign_package_libs() {
  local mode="${1:-report}"
  local pkg file desc missing found=0 pkg_printed

  while IFS= read -r pkg; do
    pkg_printed=0

    while IFS= read -r file; do
      [[ -f "$file" ]] || continue

      desc="$(file -b "$file" 2>/dev/null || true)"
      [[ "$desc" == *ELF* ]] || continue

      missing="$(ldd "$file" 2>/dev/null | grep 'not found' || true)"
      [[ -n "$missing" ]] || continue

      if [[ "$mode" == "packages" ]]; then
        if ((pkg_printed == 0)); then
          printf '%s\n' "$pkg"
          pkg_printed=1
        fi
        found=1
        continue
      fi

      if ((pkg_printed == 0)); then
        printf 'broken libraries in %s:\n' "$pkg"
        pkg_printed=1
      fi

      printf '  %s\n' "$file"
      while IFS= read -r line; do
        printf '    %s\n' "$line"
      done <<<"$missing"
      found=1
    done < <(pacman -Qlq "$pkg" 2>/dev/null)
  done < <(foreign_packages)

  ((found == 0))
}

broken_foreign_packages() {
  scan_foreign_package_libs packages || true
}

scan_missing_libs() {
  sysup_log "checking foreign packages for missing shared libraries"

  if scan_foreign_package_libs report; then
    printf 'ok: no missing shared libraries found in foreign packages\n'
    return 0
  fi

  printf '\nerror: at least one foreign package has missing libraries\n' >&2
  return 1
}

# ---------------------------------------------------------------------------
# sysup backend hooks
# ---------------------------------------------------------------------------

sysup_backend_require() {
  sysup_require_family arch || return
  sysup_need_cmds pacman file ldd grep sort
}

sysup_backend_preamble() {
  local -a packages=()

  mapfile -t packages < <(foreign_packages)
  sysup_log "foreign packages (${#packages[@]})"
  if ((${#packages[@]})); then
    printf '  %s\n' "${packages[@]}"
  else
    printf '  (none)\n'
  fi
}

sysup_backend_snapshot() {
  pacman -Q | sort
}

sysup_backend_package_files() {
  pacman -Qlq "$1"
}

sysup_backend_checks() {
  scan_missing_libs
}

sysup_backend_upgrade() {
  local -a extra_args=("$@")
  local -a broken_packages=()
  local -a rebuild_targets=()
  SYSUP_EXTRA_UPGRADED_PACKAGES=()

  if command -v yay >/dev/null 2>&1; then
    yay -Syu --devel "${extra_args[@]+"${extra_args[@]}"}" || return

    mapfile -t broken_packages < <(broken_foreign_packages)
    if ((${#broken_packages[@]} == 0)); then
      sysup_log "no broken foreign package libraries found after upgrade"
      warn_non_aur_foreign_packages
      return
    fi

    mapfile -t rebuild_targets < <(printf '%s\n' "${broken_packages[@]}" | aur_rebuild_targets)
    if ((${#rebuild_targets[@]})); then
      sysup_log "rebuilding broken AUR packages (${#rebuild_targets[@]})"
      printf '  %s\n' "${rebuild_targets[@]}"
      yay -S --aur --rebuild --redownload --answerclean All \
        "${extra_args[@]+"${extra_args[@]}"}" "${rebuild_targets[@]}" || return
      # A rebuild keeps the package version, so the snapshot diff cannot see it.
      SYSUP_EXTRA_UPGRADED_PACKAGES+=("${rebuild_targets[@]}")
    else
      sysup_log "broken foreign packages are not available in AUR"
    fi

    warn_non_aur_foreign_packages
    return
  fi

  sysup_log "yay not found; upgrading repository packages only"
  sysup_run_as_root pacman -Syu "${extra_args[@]+"${extra_args[@]}"}"
}

if [[ "${SYSUP_SOURCE_ONLY:-0}" != 1 ]]; then
  sysup_main "$@"
fi
