#!/usr/bin/env bash
# Keep tmux status refreshes cheap until Continuum may actually need to save.

set -u

last_save=${1:-}
save_interval=${2:-}
save_script=${3:-}
[[ -x "$save_script" ]] || exit 0

# The caller prefixes tmux's q-escaped option expansions with a literal x so
# empty values remain distinct shell arguments.
case "$last_save" in
  x*) last_save=${last_save#x} ;;
  *) exec "$save_script" ;;
esac
case "$save_interval" in
  x*) save_interval=${save_interval#x} ;;
  *) exec "$save_script" ;;
esac

# Disabled sockets render status frequently but can never save.
[[ "$save_interval" != 0 ]] || exit 0

# Continuum remains authoritative for missing, malformed, or unusually large
# state. The gate only handles the ordinary numeric not-due case.
case "$last_save" in
  "" | *[!0-9]*) exec "$save_script" ;;
esac
case "$save_interval" in
  "" | *[!0-9]*) exec "$save_script" ;;
esac
if ((${#last_save} > 10 || ${#save_interval} > 8)); then
  exec "$save_script"
fi

now=$(date +%s 2>/dev/null) || exec "$save_script"
case "$now" in
  "" | *[!0-9]*) exec "$save_script" ;;
esac
if ((${#now} > 10)); then
  exec "$save_script"
fi

last_save=$((10#$last_save))
save_interval=$((10#$save_interval))
now=$((10#$now))
((now < last_save + (save_interval * 60))) && exit 0

exec "$save_script"
