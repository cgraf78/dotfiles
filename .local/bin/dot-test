#!/usr/bin/env bash
# dot-test — run dotfiles test suites.
#
# Auto-discovers and runs all *-test scripts in ~/.local/lib/dot/tests/.
# Runs in parallel by default for faster execution.
#
# Usage:
#   dot-test                  run all tests in parallel
#   dot-test core bootstrap   run named tests only
#   dot-test -s               run sequentially (stream output)
#   dot-test -v               verbose: show all output in parallel mode
#   dot-test -j 4             run up to 4 suites concurrently
#   dot-test -l               list available tests

set -o pipefail

_dot_test_realpath() {
  local path="$1"
  realpath "$path" 2>/dev/null || printf '%s\n' "$path"
}

_dot_test_tree_ok() {
  local root="$1"
  [[ -n "$root" ]] || return 1
  [[ -x "$root/.local/bin/dot-test" ]] || return 1
  [[ -d "$root/.local/lib/dot/tests" ]] || return 1
  [[ -r "$root/.local/lib/dot/core/ui.sh" ]] || return 1
}

_dot_test_parent_home() {
  local path="$1" dir
  [[ -n "$path" ]] || return 1
  dir=$(_dot_test_realpath "$(dirname "$path")")
  _dot_test_realpath "$dir/../.."
}

_dot_test_pwd_home() {
  local dir
  dir=$(_dot_test_realpath "${PWD:-.}")
  while [[ "$dir" != "/" ]]; do
    if _dot_test_tree_ok "$dir"; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir=$(dirname "$dir")
  done
  return 1
}

_dot_test_script_home() {
  local source="${BASH_SOURCE[0]}" resolved
  if [[ "$source" != */* ]]; then
    source=$(command -v "$source" 2>/dev/null || printf '%s\n' "$source")
  fi
  resolved=$(_dot_test_parent_home "$source") || return 1
  _dot_test_tree_ok "$resolved" || return 1
  printf '%s\n' "$resolved"
}

_dot_test_configure_home() {
  local caller_home source_home pwd_home script_home
  caller_home=$(_dot_test_realpath "${HOME:?HOME must be set}")

  if [[ -n "${DOT_TEST_SOURCE_HOME:-}" ]]; then
    source_home=$(_dot_test_realpath "$DOT_TEST_SOURCE_HOME")
  else
    pwd_home=$(_dot_test_pwd_home 2>/dev/null || true)
    script_home=$(_dot_test_script_home 2>/dev/null || true)
    if [[ -n "$pwd_home" && "$pwd_home" != "$caller_home" ]]; then
      source_home="$pwd_home"
    elif [[ -n "$script_home" ]]; then
      source_home="$script_home"
    else
      source_home="$caller_home"
    fi
  fi

  _dot_test_tree_ok "$source_home" || {
    echo "invalid dot-test source home: $source_home" >&2
    exit 2
  }

  export DOT_TEST_HOST_HOME="${DOT_TEST_HOST_HOME:-$caller_home}"
  export DOT_TEST_SOURCE_HOME="$source_home"
  export HOME="$source_home"

  # Worktree runs need the worktree launchers/config first, but tests may still
  # need installed host-only tools such as sley or tmux helpers. Keep the host
  # bin dir as a fallback without creating symlinks inside the worktree.
  PATH="$HOME/.local/bin:$PATH"
  if [[ "$DOT_TEST_HOST_HOME" != "$HOME" ]]; then
    PATH="$PATH:$DOT_TEST_HOST_HOME/.local/bin"
  fi
  export PATH

  if [[ "$DOT_TEST_HOST_HOME" != "$HOME" ]]; then
    : "${MISE_DATA_DIR:=$DOT_TEST_HOST_HOME/.local/share/mise}"
    : "${MISE_STATE_DIR:=$DOT_TEST_HOST_HOME/.local/state/mise}"
    : "${MISE_CACHE_DIR:=$DOT_TEST_HOST_HOME/.cache/mise}"
    export MISE_DATA_DIR MISE_STATE_DIR MISE_CACHE_DIR
  fi
}

_dot_test_configure_home

TESTS_DIR="${DOT_TEST_TESTS_DIR:-${HOME}/.local/lib/dot/tests}"

# shellcheck source=../lib/dot/core/ui.sh
# shellcheck disable=SC1091 # dotfiles runtime library lives under HOME.
. "$HOME/.local/lib/dot/core/ui.sh"

# Classify a finished suite from its exit code and captured output.
#
# A zero exit is NOT sufficient proof of success. Suites do not run under
# `set -e`, so a setup command that errors mid-run (a failed `cd`, `mkdir`,
# fixture build, or an early `return`) lets the suite keep going and exit 0 while
# skipping the assertions that would have caught the problem — a false green.
# Require positive evidence that the suite ran to completion: it either skipped
# (`SKIP:`) or printed its results summary (`Results: N passed, N failed`, which
# `_test_summary` always emits). A 0 exit with neither is an incomplete run and
# is failed. Inspecting the OUTPUT rather than the source keeps this correct
# regardless of which shard file actually calls `_test_summary`.
_classify_suite() {
  local rc="$1" out="$2"
  if [[ "$rc" -ne 0 ]]; then
    printf 'fail\n'
  elif grep -q '^SKIP:' "$out"; then
    printf 'skip\n'
  elif grep -qE 'Results: [0-9]+ passed, [0-9]+ failed' "$out"; then
    printf 'pass\n'
  else
    printf 'incomplete\n'
  fi
}

parallel=true
verbose=false
max_jobs="${DOT_TEST_JOBS:-}"
filter=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -s | --sequential)
      parallel=false
      shift
      ;;
    -v | --verbose)
      verbose=true
      shift
      ;;
    -j | --jobs)
      [[ $# -ge 2 ]] || {
        echo "missing value for $1" >&2
        exit 2
      }
      max_jobs="$2"
      shift 2
      ;;
    --jobs=*)
      max_jobs="${1#*=}"
      shift
      ;;
    -l | --list)
      for f in "$TESTS_DIR"/*-test; do
        [[ -x "$f" ]] && basename "$f" | sed 's/-test$//'
      done
      exit 0
      ;;
    -h | --help)
      sed -n '2,/^$/{ s/^# //; s/^#$//; p; }' "$0"
      exit 0
      ;;
    -*)
      echo "unknown option: $1" >&2
      exit 2
      ;;
    *)
      filter+=("$1")
      shift
      ;;
  esac
done

# Detect gum for styled output. Test suites set NO_COLOR to keep underlying
# tool output deterministic; dot-test owns its own presentation layer, with a
# dedicated escape hatch for plain logs.
_color=true
[[ "${DOT_TEST_NO_COLOR:-0}" = 1 ]] && _color=false
_child_style=0
if { $_color && _dot_ui_has_gum; } || { $_color && [[ -t 1 ]]; }; then
  _child_style=1
fi

_ansi() {
  local color="$1"
  shift
  if $_color; then
    case "$color" in
      bold) printf '\033[1m%s\033[0m\n' "$*" ;;
      *) printf '\033[38;2;%sm%s\033[0m\n' "$(_dot_ui_hex_to_rgb "$(_dot_ui_color_hex "$color")")" "$*" ;;
    esac
  else
    echo "$*"
  fi
}

_styled() {
  local color="$1"
  shift
  if $_color; then
    # Status colors are semantic, not theme colors. Use explicit RGB ANSI so
    # Neovim terminals and external terminals render pass/fail consistently.
    _ansi "$color" "$*"
  else
    echo "$*"
  fi
}

_header() {
  if $_color; then
    _ansi bold "$*"
  else
    echo "$*"
  fi
}

_title() {
  if $_color; then
    _dot_ui_title "$*"
  else
    printf '\n'
    echo "$*"
    printf '\n'
  fi
}

_summary_box() {
  local color="$1"
  shift
  if $_color; then
    echo
    _dot_ui_summary_box "$color" "$*"
  else
    _header "════════════════════════════════"
    _styled "$color" "$*"
    _header "════════════════════════════════"
  fi
}

_mark() {
  local color="$1" glyph="$2" name="$3" elapsed="$4"
  if $_color; then
    # Match `dot doctor`: color only the status glyph, leaving the label and
    # detail text in the terminal default color for easier scanning.
    printf '  '
    printf '\033[38;2;%sm%s\033[0m' "$(_dot_ui_hex_to_rgb "$(_dot_ui_color_hex "$color")")" "$glyph"
    printf ' %s (%s)\n' "$name" "$elapsed"
  else
    printf '  %s %s (%s)\n' "$glyph" "$name" "$elapsed"
  fi
}

_mark_pass() { _mark green "✓" "$1" "$2"; }
_mark_fail() { _mark red "✗" "$1" "$2"; }
_mark_skip() { _mark yellow "○" "$1" "$2"; }

_default_jobs() {
  local n=""
  n=$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)
  if [[ -z "$n" && "$(uname -s)" = "Darwin" ]]; then
    n=$(sysctl -n hw.ncpu 2>/dev/null || true)
  fi
  case "$n" in
    '' | *[!0-9]*) n=4 ;;
  esac
  [[ "$n" -lt 1 ]] && n=1
  printf '%s\n' "$n"
}

# Discover tests
scripts=()
if [[ ${#filter[@]} -gt 0 ]]; then
  declare -A _seen=()
  declare -A _seen_scripts=()
  for name in "${filter[@]}"; do
    [[ -n "${_seen[$name]:-}" ]] && continue
    _seen[$name]=1
    matched=false
    f="$TESTS_DIR/${name}-test"
    if [[ -x "$f" ]]; then
      matched=true
      if [[ -z "${_seen_scripts[$f]:-}" ]]; then
        scripts+=("$f")
        _seen_scripts[$f]=1
      fi
    fi
    for f in "$TESTS_DIR/${name}-"*-test; do
      [[ -x "$f" ]] || continue
      matched=true
      if [[ -z "${_seen_scripts[$f]:-}" ]]; then
        scripts+=("$f")
        _seen_scripts[$f]=1
      fi
    done
    if ! $matched; then
      echo "unknown test: $name (expected $TESTS_DIR/${name}-test or ${name}-*-test)" >&2
      exit 2
    fi
  done
else
  for f in "$TESTS_DIR"/*-test; do
    [[ -x "$f" ]] && scripts+=("$f")
  done

  # Full-suite runs should start broad baseline suites before the many
  # agent-hook shards. With bounded parallelism this keeps long-running suites
  # such as core and sley on the critical path immediately instead of queuing
  # them behind hook shards.
  non_agent_scripts=()
  agent_scripts=()
  for f in "${scripts[@]}"; do
    case "$(basename "$f")" in
      agent-hook-*) agent_scripts+=("$f") ;;
      *) non_agent_scripts+=("$f") ;;
    esac
  done
  scripts=("${non_agent_scripts[@]}" "${agent_scripts[@]}")
fi

if [[ ${#scripts[@]} -eq 0 ]]; then
  echo "no tests found in $TESTS_DIR" >&2
  exit 1
fi

if [[ -z "$max_jobs" ]]; then
  max_jobs=$(_default_jobs)
fi
case "$max_jobs" in
  '' | *[!0-9]*)
    echo "invalid jobs value: $max_jobs" >&2
    exit 2
    ;;
esac
[[ "$max_jobs" -lt 1 ]] && max_jobs=1
[[ "$max_jobs" -gt "${#scripts[@]}" ]] && max_jobs=${#scripts[@]}

# Auto-verbose in CI so test output is visible (folded via ::group::)
[[ -n "${GITHUB_ACTIONS:-}" ]] && verbose=true

passed=0
failed=0
skipped=0
failed_names=()

_run_suite() {
  local detach="$1" name="$2" script="$3" suite_tmpdir="$4"
  local parallel_flag=0 suite_timeout timeout_supervisor
  local suite_cmd=()
  $parallel && parallel_flag=1
  local env_cmd=(
    env
    "TMPDIR=$suite_tmpdir"
    # A suite may run commands before creating its own fixture HOME. Keep
    # launcher caches and other runtime state out of the source checkout even
    # during that setup window.
    "XDG_CACHE_HOME=$suite_tmpdir/xdg-cache"
    "XDG_STATE_HOME=$suite_tmpdir/xdg-state"
    "DOT_TEST=1"
    "DOT_TEST_STYLE=$_child_style"
    "DOT_TEST_JOBS=$max_jobs"
    "DOT_TEST_PARALLEL=$parallel_flag"
  )

  if [[ "$name" == "core-test" ]]; then
    env_cmd+=("DOT_CORE_SKIP_STATIC=1")
  fi

  suite_timeout="${DOT_TEST_SUITE_TIMEOUT_SECONDS:-300}"
  timeout_supervisor="$HOME/.local/lib/dot/tests/timeout.py"
  if ! command -v python3 >/dev/null 2>&1 || [[ ! -f "$timeout_supervisor" ]]; then
    echo "dot-test suite timeout requires python3 and $timeout_supervisor" >&2
    return 127
  fi
  suite_cmd=(python3 "$timeout_supervisor" "$suite_timeout" "${env_cmd[@]}" "$script")

  if $detach && command -v setsid >/dev/null 2>&1; then
    exec setsid "${suite_cmd[@]}"
  elif $detach && command -v python3 >/dev/null 2>&1; then
    # macOS lacks GNU `setsid`, but `dot-test` still needs background suites
    # out of the caller's terminal session. Otherwise any nested tool that
    # reopens `/dev/tty` can intermittently SIGTTIN-suspend the whole runner.
    exec python3 -c '
import os
import sys

os.setsid()
os.execvpe(sys.argv[1], sys.argv[1:], os.environ)
' "${suite_cmd[@]}"
  else
    exec "${suite_cmd[@]}"
  fi
}

_wait_job_bounded() {
  local pid="$1" limit="$2" remaining state
  # SECONDS has integer precision, so a one-second grace period can otherwise
  # expire immediately at a tick boundary before a finished pipe drains.
  remaining=$((limit * 20))

  while kill -0 "$pid" 2>/dev/null; do
    state=$(ps -o stat= -p "$pid" 2>/dev/null) || break
    [[ "$state" =~ ^[[:space:]]*Z ]] && break
    ((remaining > 0)) || return 1
    remaining=$((remaining - 1))
    sleep 0.05
  done
  wait "$pid" 2>/dev/null || true
}

_stop_job() {
  local pid="$1" signal_name="${2:-TERM}"
  kill -"$signal_name" "$pid" 2>/dev/null || true
  _wait_job_bounded "$pid" 3 && return 0
  kill -KILL "$pid" 2>/dev/null || true
  _wait_job_bounded "$pid" 1 || true
}

_cleanup_test_jobs() {
  local pid
  trap - EXIT
  for pid in $(jobs -p); do
    _stop_job "$pid"
  done
  rm -rf "$tmpdir"
}

_prune_stale_test_roots() {
  local parent="$1" now="$2" candidate marker owner_pid started
  for candidate in "$parent"/run.*; do
    [[ -d "$candidate" && ! -L "$candidate" && -O "$candidate" ]] || continue
    marker="$candidate/.dot-test-owner-v2"
    [[ -f "$marker" && -O "$marker" ]] || continue
    IFS=$'\t' read -r owner_pid started <"$marker" || continue
    [[ "$owner_pid" =~ ^[1-9][0-9]{0,9}$ ]] || continue
    kill -0 "$owner_pid" 2>/dev/null && continue
    [[ "$started" =~ ^[1-9][0-9]{0,17}$ ]] || continue
    ((started <= now && now - started > 86400)) || continue
    rm -rf -- "$candidate"
  done
}

_dot_test_tmp_base="${TMPDIR:-/tmp}"
_dot_test_tmp_base="${_dot_test_tmp_base%/}"
[[ -n "$_dot_test_tmp_base" ]] || _dot_test_tmp_base=/
_dot_test_tmp_parent="$_dot_test_tmp_base/dot-test-runs.$EUID"
if ! mkdir -m 700 "$_dot_test_tmp_parent" 2>/dev/null &&
  [[ ! -e "$_dot_test_tmp_parent" ]]; then
  echo "dot-test: could not create temporary root" >&2
  exit 1
fi
if [[ ! -d "$_dot_test_tmp_parent" || -L "$_dot_test_tmp_parent" ||
  ! -O "$_dot_test_tmp_parent" ]]; then
  echo "dot-test: unsafe temporary root: $_dot_test_tmp_parent" >&2
  exit 1
fi
chmod 700 "$_dot_test_tmp_parent" || {
  echo "dot-test: could not secure temporary root" >&2
  exit 1
}
_dot_test_now=$(date +%s) || {
  echo "dot-test: could not read system time" >&2
  exit 1
}
_prune_stale_test_roots "$_dot_test_tmp_parent" "$_dot_test_now"
tmpdir=$(mktemp -d "$_dot_test_tmp_parent/run.XXXXXXXX") || {
  echo "dot-test: could not create temporary directory" >&2
  exit 1
}
trap _cleanup_test_jobs EXIT
if ! printf '%s\t%s\n' "$$" "$_dot_test_now" >"$tmpdir/.dot-test-owner-v2"; then
  echo "dot-test: could not mark temporary directory" >&2
  exit 1
fi

# shellcheck disable=SC2329 # Signal traps invoke this cancellation handler.
_cancel_suite() {
  local signal_name="$1" status="$2" pid
  trap - HUP INT TERM
  if [[ -n "${suite_pid:-}" ]]; then
    _stop_job "$suite_pid" "$signal_name"
  else
    for pid in $(jobs -p); do
      _stop_job "$pid" "$signal_name"
    done
  fi
  if [[ -n "${tee_pid:-}" ]]; then
    _stop_job "$tee_pid"
  fi
  exit "$status"
}

if $parallel; then
  _title "dot test"
  echo ""
  _ansi dim "Running ${#scripts[@]} test suites with up to $max_jobs jobs..."
  echo ""

  _start_script() {
    local script="$1" name suite_tmpdir
    name=$(basename "$script")
    suite_tmpdir="$tmpdir/$name.tmp"
    mkdir -p "$suite_tmpdir"
    (
      suite_pid=""
      trap '_cancel_suite HUP 129' HUP
      trap '_cancel_suite INT 130' INT
      trap '_cancel_suite TERM 143' TERM

      SECONDS=0
      _run_suite true "$name" "$script" "$suite_tmpdir" \
        </dev/null >"$tmpdir/$name.out" 2>&1 &
      suite_pid=$!
      wait "$suite_pid"
      rc=$?
      trap - HUP INT TERM
      echo "$SECONDS" >"$tmpdir/$name.time"
      echo "$rc" >"$tmpdir/$name.rc"
    ) &
  }

  # Monitor completion as tests finish
  completed=0
  running=0
  next=0
  while [[ $completed -lt ${#scripts[@]} ]]; do
    while [[ $running -lt $max_jobs && $next -lt ${#scripts[@]} ]]; do
      _start_script "${scripts[$next]}"
      running=$((running + 1))
      next=$((next + 1))
    done

    for script in "${scripts[@]}"; do
      name=$(basename "$script")
      [[ -f "$tmpdir/$name.done" ]] && continue
      [[ -f "$tmpdir/$name.rc" ]] || continue

      rc=$(cat "$tmpdir/$name.rc")
      elapsed=$(cat "$tmpdir/$name.time")
      case "$(_classify_suite "$rc" "$tmpdir/$name.out")" in
        skip)
          _mark_skip "$name" "${elapsed}s"
          skipped=$((skipped + 1))
          ;;
        pass)
          _mark_pass "$name" "${elapsed}s"
          passed=$((passed + 1))
          ;;
        incomplete)
          _mark_fail "$name" "${elapsed}s"
          echo "  $name: exited 0 without a results summary (incomplete run)" >&2
          failed=$((failed + 1))
          failed_names+=("$name")
          ;;
        *)
          _mark_fail "$name" "${elapsed}s"
          failed=$((failed + 1))
          failed_names+=("$name")
          ;;
      esac
      touch "$tmpdir/$name.done"
      completed=$((completed + 1))
      running=$((running - 1))
    done
    [[ $completed -lt ${#scripts[@]} ]] && sleep 0.2
  done

  # Print output for failed tests (or all if verbose / CI)
  for script in "${scripts[@]}"; do
    name=$(basename "$script")
    rc=$(cat "$tmpdir/$name.rc")
    if [[ "$rc" -ne 0 ]] || $verbose; then
      echo ""
      if [[ -n "${GITHUB_ACTIONS:-}" ]]; then
        echo "::group::$name output"
      else
        _header "── $name output ──"
      fi
      cat "$tmpdir/$name.out"
      [[ -n "${GITHUB_ACTIONS:-}" ]] && echo "::endgroup::"
    fi
  done

else
  _title "dot test"
  echo ""
  _ansi dim "Running ${#scripts[@]} test suites..."

  for script in "${scripts[@]}"; do
    name=$(basename "$script")
    echo ""
    if [[ -n "${GITHUB_ACTIONS:-}" ]]; then
      echo "::group::$name"
    else
      _header "── $name ──"
    fi
    SECONDS=0
    suite_tmpdir="$tmpdir/$name.tmp"
    output_fifo="$suite_tmpdir/output.fifo"
    mkdir -p "$suite_tmpdir"
    mkfifo "$output_fifo"
    tee "$tmpdir/$name.out" <"$output_fifo" &
    tee_pid=$!
    suite_pid=""
    trap '_cancel_suite HUP 129' HUP
    trap '_cancel_suite INT 130' INT
    trap '_cancel_suite TERM 143' TERM
    _run_suite false "$name" "$script" "$suite_tmpdir" \
      </dev/null >"$output_fifo" 2>&1 &
    suite_pid=$!
    wait "$suite_pid"
    rc=$?
    _wait_job_bounded "$tee_pid" 1 || _stop_job "$tee_pid"
    rm -f "$output_fifo"
    trap - HUP INT TERM
    elapsed=$SECONDS
    case "$(_classify_suite "$rc" "$tmpdir/$name.out")" in
      skip)
        _mark_skip "$name" "${elapsed}s"
        skipped=$((skipped + 1))
        ;;
      pass)
        _mark_pass "$name" "${elapsed}s"
        passed=$((passed + 1))
        ;;
      incomplete)
        _mark_fail "$name" "${elapsed}s"
        echo "  $name: exited 0 without a results summary (incomplete run)" >&2
        failed=$((failed + 1))
        failed_names+=("$name")
        ;;
      *)
        _mark_fail "$name" "${elapsed}s"
        failed=$((failed + 1))
        failed_names+=("$name")
        ;;
    esac
    [[ -n "${GITHUB_ACTIONS:-}" ]] && echo "::endgroup::"
  done
fi

# Summary
summary="Suites: $passed passed"
[[ $skipped -gt 0 ]] && summary+=", $skipped skipped"
[[ $failed -gt 0 ]] && summary+=", $failed failed"
summary+=" (${#scripts[@]} total)"
if [[ $failed -gt 0 ]]; then
  _summary_box red "✗ $summary"
  _styled red "Failed: ${failed_names[*]}"
else
  _summary_box green "✓ $summary"
fi
[[ $failed -eq 0 ]]
