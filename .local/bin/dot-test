#!/usr/bin/env bash
# Stable client entry point for the dotfiles-owned test runner.

set -euo pipefail
CDPATH=

dot_test_bin=$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P) || {
  printf 'dot-test: cannot resolve the client bin directory\n' >&2
  exit 1
}
dot_test_runner=$dot_test_bin/../lib/dotfiles/tests/run
if [[ ! -f $dot_test_runner || -L $dot_test_runner || ! -x $dot_test_runner ]]; then
  printf 'dot-test: runner is unavailable: %s\n' "$dot_test_runner" >&2
  exit 1
fi

exec "$dot_test_runner" "$@"
